include "../src/net/interest_math.elisa"

extend NetInterestMath:
    # Charging a plan keeps a client's budget within 0..budget, so per-client
    # queues cannot exceed their allowance.
    def prove_budget(budget: i64, cost: i64) -> i64:
        ensure result >= 0
        ensure result <= budget or budget < 0
        return 0 if budget < 0 or cost < 0
        remaining_after(budget, cost)
