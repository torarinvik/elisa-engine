# R06 bounds comparison: `gaps` reaches `true` only through `agree`, so the
# prover checks that its guards establish both gap facts. A conjunctive guard
# must establish them too.
include "../src/tooling/bounds_compare.elisa"

extend BoundsCompare:
    def prove_conjunct_gaps(below: f32, above: f32) -> bool:
        if below >= ZERO and above >= ZERO:
            return agree(below, above)
        false
