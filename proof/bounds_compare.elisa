# R06 bounds comparison: `within` and `covers` reach `true` only through
# `agree`/`hold`, so the prover checks that their guards establish the window
# and cover facts. A conjunctive guard must establish them too.
include "../src/tooling/bounds_compare.elisa"

extend BoundsCompare:
    def prove_conjunct_window(value: f32, low: f32, high: f32) -> bool:
        if low <= value and value <= high:
            return agree(value, low, high)
        false
