# Laws of the skinned-mesh policy (src/assets/skin_mesh_policy.elisa).
include "../src/assets/skin_mesh_policy.elisa"

module SkinMeshPolicyLaws:
    public:
        def one_influence_set_supported() -> bool:
            ensure result
            SkinMeshPolicy::influence_set_count_ok(1)

        def two_influence_sets_supported() -> bool:
            ensure result
            SkinMeshPolicy::influence_set_count_ok(2)

        def third_influence_set_refused() -> bool:
            ensure not result
            SkinMeshPolicy::influence_set_count_ok(3)

        # A second primitive starts after the first primitive's vertices in
        # the flattened influence arrays, rather than overwriting vertex zero.
        def second_primitive_first_slot(first_vertices: i64) -> i64:
            requires first_vertices >= 1
            requires first_vertices < SkinMeshPolicy::MAX_COUNT
            ensure result == first_vertices * SkinMeshPolicy::INFLUENCES_PER_VERTEX
            SkinMeshPolicy::influence_slot_index(first_vertices, 0, 0)

        def second_primitive_last_slot(first_vertices: i64, vertices: i64) -> i64:
            requires first_vertices >= 1
            requires vertices >= 1
            requires first_vertices < SkinMeshPolicy::MAX_COUNT
            requires vertices < SkinMeshPolicy::MAX_COUNT
            requires first_vertices + vertices < SkinMeshPolicy::MAX_COUNT
            ensure result == (first_vertices + vertices - 1) * SkinMeshPolicy::INFLUENCES_PER_VERTEX + 7
            SkinMeshPolicy::influence_slot_index(first_vertices, vertices - 1, 7)

        # Any accepted span holds at least one whole element.
        def span_holds_element(count: i64, stride: i64, element: i64) -> bool:
            ensure result
            s: i64 = SkinMeshPolicy::strided_span(count, stride, element)
            return s == -1 or s >= element

        # A stride shorter than an element is refused.
        def overlap_refused(count: i64, stride: i64, element: i64) -> i64:
            requires stride < element
            ensure result == -1
            return SkinMeshPolicy::strided_span(count, stride, element)

        # An empty accessor is refused.
        def empty_refused(stride: i64, element: i64) -> i64:
            ensure result == -1
            return SkinMeshPolicy::strided_span(0, stride, element)

        # The index one past the last vertex is refused.
        def index_past_end(vertices: i64) -> bool:
            ensure not result
            return SkinMeshPolicy::index_ok(vertices, vertices)

        # Unsupported component types read as zero bytes (refused).
        def double_refused() -> i64:
            ensure result == 0 or result == 1 or result == 2 or result == 4
            return SkinMeshPolicy::component_bytes(5130)

        # A face seen edge-on still gets the ambient light.
        def edge_on_ambient(ambient: i64) -> i64:
            requires ambient >= 0
            requires ambient <= SkinMeshPolicy::FULL_LIGHT
            ensure result == ambient
            return SkinMeshPolicy::light_level(0, ambient)

        def nonnegative_magnitude(facing: i64) -> i64:
            requires facing >= 0
            requires facing <= SkinMeshPolicy::FULL_LIGHT
            ensure result == facing
            return SkinMeshPolicy::facing_magnitude(facing)

        def nonpositive_magnitude(facing: i64) -> i64:
            requires facing >= 0 - SkinMeshPolicy::FULL_LIGHT
            requires facing <= 0
            ensure result == 0 - facing
            return SkinMeshPolicy::facing_magnitude(facing)

        def opposite_facing(facing: i64) -> i64:
            requires facing >= 0
            requires facing <= SkinMeshPolicy::FULL_LIGHT
            ensure result >= 0 - SkinMeshPolicy::FULL_LIGHT
            ensure result <= 0
            ensure 0 - result == facing
            return 0 - facing

        # Back faces face the light as much as front faces.
        def two_sided(facing: i64) -> bool:
            requires facing >= 0
            requires facing <= SkinMeshPolicy::FULL_LIGHT
            ensure result
            back: i64 = opposite_facing(facing)
            front_level: i64 = nonnegative_magnitude(facing)
            back_level: i64 = nonpositive_magnitude(back)
            return front_level == back_level

        # Full light keeps the base colour; no light is black.
        def full_light_keeps_base(base: i64) -> i64:
            requires base >= 0
            requires base <= 255
            ensure result == base
            return SkinMeshPolicy::shade(base, SkinMeshPolicy::FULL_LIGHT)

        def dark_is_black(base: i64) -> i64:
            requires base >= 0
            requires base <= 255
            ensure result == 0
            return SkinMeshPolicy::shade(base, 0)

        def empty_influence_shape() -> bool:
            ensure result
            SkinMeshPolicy::packed_shape_ok(0, 8, 0)

        def three_vertex_influence_shape() -> bool:
            ensure result
            SkinMeshPolicy::packed_shape_ok(3, 8, 24)

        def truncated_influence_shape() -> bool:
            ensure result == false
            SkinMeshPolicy::packed_shape_ok(3, 8, 23)

        def extra_bind_element_shape() -> bool:
            ensure result == false
            SkinMeshPolicy::packed_shape_ok(1, 16, 17)

        def packed_shape_definition(rows: usize, slots: usize) -> bool:
            ensure result == (slots % 8 == 0 and slots / 8 == rows)
            SkinMeshPolicy::packed_shape_ok(rows, 8, slots)

        def wrong_bind_row_count() -> bool:
            ensure result == false
            SkinMeshPolicy::packed_shape_ok(2, 16, 16)

        def nonempty_rows_without_slots(rows: usize) -> bool:
            requires rows > 0
            ensure result == false
            SkinMeshPolicy::packed_shape_ok(rows, 8, 0)
