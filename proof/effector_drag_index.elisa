include "../src/animation/effector_drag_index.elisa"

extend EffectorDragIndex:
    # valid_chain, slot and link carry their exact rules as their own proved
    # ensures; these wrappers restate the bounds callers rely on.
    def prove_chain_fits_fabrik(length: i64, joints: i64) -> bool:
        ensure not result or length <= 8
        valid_chain(length, joints)

    def prove_short_chain_rejected(length: i64, joints: i64) -> bool:
        requires length < 2
        ensure not result
        valid_chain(length, joints)

    def prove_slot_bounded(joint: i64, axis: i64, joints: i64) -> i64:
        requires joints >= 0
        requires joints <= 256
        ensure result >= -1
        ensure result < 768
        slot(joint, axis, joints)

    def prove_slot_outside(joint: i64, axis: i64, joints: i64) -> i64:
        requires joints >= 0
        requires joints <= 256
        requires joint >= joints
        ensure result == -1
        slot(joint, axis, joints)

    def prove_link_inside(joint: i64, previous: i64, joints: i64) -> bool:
        ensure not result or joint < joints
        link(joint, previous, joints)
