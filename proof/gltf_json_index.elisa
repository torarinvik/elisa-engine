include "../src/assets/gltf_json_index.elisa"

extend GltfJsonIndex:
    def prove_digit_bounded(value: i64, digit: i64) -> i64:
        ensure result >= -1
        ensure result <= 4294967295
        append_digit(value, digit)

    def prove_depth_bounded(depth: i64) -> bool:
        ensure not result or depth <= 64
        ensure not result or depth >= 0
        depth_ok(depth)

    def prove_component_bytes_small(component_type: i64) -> i64:
        ensure result >= 0
        ensure result <= 4
        component_bytes(component_type)

    def prove_span_nonnegative_or_rejected(count: i64, element: i64) -> i64:
        ensure result >= -1
        span(count, element)

    def prove_accessor_inside_view(view_length: i64, accessor_offset: i64, span_bytes: i64) -> i64:
        requires view_length >= 0
        requires view_length <= 4294967295
        requires accessor_offset >= 0
        requires accessor_offset <= 4294967295
        requires span_bytes >= 0
        requires span_bytes <= 4294967295
        ensure result <= view_length - span_bytes or result < 0
        ensure result == accessor_offset or result < 0
        accessor_offset_in_view(view_length, accessor_offset, span_bytes)

    def prove_accessor_sign(view_length: i64, accessor_offset: i64, span_bytes: i64) -> i64:
        requires view_length >= 0
        requires view_length <= 4294967295
        requires accessor_offset >= 0
        requires accessor_offset <= 4294967295
        requires span_bytes >= 0
        requires span_bytes <= 4294967295
        ensure result == -1 or result >= 0
        accessor_offset_in_view(view_length, accessor_offset, span_bytes)
