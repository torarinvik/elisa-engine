            match key:
                KeyboardKeyCode.A: PortableInputCodes::KEY_A
                KeyboardKeyCode.D: PortableInputCodes::KEY_D
                KeyboardKeyCode.E: PortableInputCodes::KEY_E
                KeyboardKeyCode.Q: PortableInputCodes::KEY_Q
                KeyboardKeyCode.R: PortableInputCodes::KEY_R
                KeyboardKeyCode.S: PortableInputCodes::KEY_S
                KeyboardKeyCode.W: PortableInputCodes::KEY_W
                KeyboardKeyCode.P: PortableInputCodes::KEY_P
                KeyboardKeyCode.V: PortableInputCodes::KEY_V
                KeyboardKeyCode.C: PortableInputCodes::KEY_C
                KeyboardKeyCode.X: PortableInputCodes::KEY_X
                KeyboardKeyCode.Z: PortableInputCodes::KEY_Z
                KeyboardKeyCode.Tab: PortableInputCodes::KEY_TAB
                KeyboardKeyCode.Digit1: PortableInputCodes::KEY_DIGIT_1
                KeyboardKeyCode.Digit2: PortableInputCodes::KEY_DIGIT_2
                KeyboardKeyCode.Digit3: PortableInputCodes::KEY_DIGIT_3
                KeyboardKeyCode.H: PortableInputCodes::KEY_H
                KeyboardKeyCode.J: PortableInputCodes::KEY_J
                KeyboardKeyCode.L: PortableInputCodes::KEY_L
                KeyboardKeyCode.Space: PortableInputCodes::KEY_SPACE
                KeyboardKeyCode.Escape: PortableInputCodes::KEY_ESCAPE
                KeyboardKeyCode.LeftShift: PortableInputCodes::KEY_LEFT_SHIFT
                KeyboardKeyCode.RightShift: PortableInputCodes::KEY_RIGHT_SHIFT
                KeyboardKeyCode.LeftControl: PortableInputCodes::KEY_LEFT_CONTROL
                KeyboardKeyCode.RightControl: PortableInputCodes::KEY_RIGHT_CONTROL
                KeyboardKeyCode.ArrowLeft: PortableInputCodes::KEY_ARROW_LEFT
                KeyboardKeyCode.ArrowRight: PortableInputCodes::KEY_ARROW_RIGHT
                KeyboardKeyCode.ArrowUp: PortableInputCodes::KEY_ARROW_UP
                KeyboardKeyCode.ArrowDown: PortableInputCodes::KEY_ARROW_DOWN
                KeyboardKeyCode.B: PortableInputCodes::KEY_B
                KeyboardKeyCode.F: PortableInputCodes::KEY_F
                KeyboardKeyCode.G: PortableInputCodes::KEY_G
                KeyboardKeyCode.I: PortableInputCodes::KEY_I
                KeyboardKeyCode.K: PortableInputCodes::KEY_K
                KeyboardKeyCode.M: PortableInputCodes::KEY_M
                KeyboardKeyCode.N: PortableInputCodes::KEY_N
                KeyboardKeyCode.O: PortableInputCodes::KEY_O
                KeyboardKeyCode.T: PortableInputCodes::KEY_T
                KeyboardKeyCode.U: PortableInputCodes::KEY_U
                KeyboardKeyCode.Y: PortableInputCodes::KEY_Y
                KeyboardKeyCode.Digit0: PortableInputCodes::KEY_DIGIT_0
                KeyboardKeyCode.Digit4: PortableInputCodes::KEY_DIGIT_4
                KeyboardKeyCode.Digit5: PortableInputCodes::KEY_DIGIT_5
                KeyboardKeyCode.Digit6: PortableInputCodes::KEY_DIGIT_6
                KeyboardKeyCode.Digit7: PortableInputCodes::KEY_DIGIT_7
                KeyboardKeyCode.Digit8: PortableInputCodes::KEY_DIGIT_8
                KeyboardKeyCode.Digit9: PortableInputCodes::KEY_DIGIT_9
                KeyboardKeyCode.F1: PortableInputCodes::KEY_F1
                KeyboardKeyCode.F2: PortableInputCodes::KEY_F2
                KeyboardKeyCode.F3: PortableInputCodes::KEY_F3
                KeyboardKeyCode.F4: PortableInputCodes::KEY_F4
