            KEY_F9: i64 = 2056
            KEY_F10: i64 = 2057
            KEY_F11: i64 = 2058
            KEY_F12: i64 = 2059
            KEY_ENTER: i64 = 2060
            KEY_BACKSPACE: i64 = 2061
            KEY_DELETE: i64 = 2062
            KEY_INSERT: i64 = 2063
            KEY_HOME: i64 = 2064
            KEY_END: i64 = 2065
            KEY_PAGE_UP: i64 = 2066
            KEY_PAGE_DOWN: i64 = 2067
            KEY_LEFT_ALT: i64 = 2068
            KEY_RIGHT_ALT: i64 = 2069
            KEY_LEFT_SUPER: i64 = 2070
