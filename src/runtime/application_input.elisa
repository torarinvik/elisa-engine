        @callconv(c)
        extern elisa_application_v1_next_input_event_token() -> i64

        @callconv(c)
        extern elisa_application_v1_set_relative_mouse(enabled: i32) -> i32

        @callconv(c)
        extern elisa_application_v1_relative_mouse() -> i32

        @callconv(c)
        extern elisa_application_v1_next_pointer_event(kind: mutable i32&,
            button: mutable i32&, x: mutable f32&, y: mutable f32&,
            delta_x: mutable f32&, delta_y: mutable f32&,
            buttons: mutable u32&, pressed: mutable i32&) -> i32

    public:
