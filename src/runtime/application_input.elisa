        enum GamepadAxisCode:
            LeftXNegative
            LeftXPositive
            LeftYNegative
            LeftYPositive
            RightXNegative
            RightXPositive
            RightYNegative
            RightYPositive
            LeftTrigger
            RightTrigger

        struct InputEvent:
            kind: mutable InputEventKind
            device: mutable i32
            code: mutable i64
            value: mutable f32
            pressed: mutable bool
            released: mutable bool
            chord_down: mutable bool
            connected: mutable bool
            # Zero for unassigned devices; gamepads use stable one-based
            # connection slots so local players can route controllers.
            device_slot: mutable i32

        struct PointerEvent:
            kind: mutable PointerEventKind
            button: mutable i32
            x: mutable f32
            y: mutable f32
            delta_x: mutable f32
            delta_y: mutable f32
            buttons: mutable u32
            pressed: mutable bool

        def gamepad_button_code(button: GamepadButtonCode) -> i64:
            match button:
                GamepadButtonCode.South: PortableInputCodes::GAMEPAD_BUTTON_SOUTH
                GamepadButtonCode.East: PortableInputCodes::GAMEPAD_BUTTON_EAST
                GamepadButtonCode.West: PortableInputCodes::GAMEPAD_BUTTON_WEST
                GamepadButtonCode.North: PortableInputCodes::GAMEPAD_BUTTON_NORTH
                GamepadButtonCode.Back: PortableInputCodes::GAMEPAD_BUTTON_BACK
                GamepadButtonCode.Guide: PortableInputCodes::GAMEPAD_BUTTON_GUIDE
                GamepadButtonCode.Start: PortableInputCodes::GAMEPAD_BUTTON_START
                GamepadButtonCode.LeftStick: PortableInputCodes::GAMEPAD_BUTTON_LEFT_STICK
                GamepadButtonCode.RightStick: PortableInputCodes::GAMEPAD_BUTTON_RIGHT_STICK
                GamepadButtonCode.LeftShoulder: PortableInputCodes::GAMEPAD_BUTTON_LEFT_SHOULDER
                GamepadButtonCode.RightShoulder: PortableInputCodes::GAMEPAD_BUTTON_RIGHT_SHOULDER
                GamepadButtonCode.DpadUp: PortableInputCodes::GAMEPAD_BUTTON_DPAD_UP
                GamepadButtonCode.DpadDown: PortableInputCodes::GAMEPAD_BUTTON_DPAD_DOWN
                GamepadButtonCode.DpadLeft: PortableInputCodes::GAMEPAD_BUTTON_DPAD_LEFT
                GamepadButtonCode.DpadRight: PortableInputCodes::GAMEPAD_BUTTON_DPAD_RIGHT

