            GAMEPAD_AXIS_RIGHT_X_POSITIVE: i64 = 1106
            GAMEPAD_AXIS_RIGHT_Y_NEGATIVE: i64 = 1107
            GAMEPAD_AXIS_RIGHT_Y_POSITIVE: i64 = 1108
            GAMEPAD_AXIS_LEFT_TRIGGER: i64 = 1109
            GAMEPAD_AXIS_RIGHT_TRIGGER: i64 = 1110
            KEY_A: i64 = 2001
            KEY_D: i64 = 2002
            KEY_E: i64 = 2003
            KEY_Q: i64 = 2004
            KEY_R: i64 = 2005
