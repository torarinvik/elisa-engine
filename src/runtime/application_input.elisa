        def gamepad_axis_code(axis: GamepadAxisCode) -> i64:
            match axis:
                GamepadAxisCode.LeftXNegative: PortableInputCodes::GAMEPAD_AXIS_LEFT_X_NEGATIVE
                GamepadAxisCode.LeftXPositive: PortableInputCodes::GAMEPAD_AXIS_LEFT_X_POSITIVE
                GamepadAxisCode.LeftYNegative: PortableInputCodes::GAMEPAD_AXIS_LEFT_Y_NEGATIVE
                GamepadAxisCode.LeftYPositive: PortableInputCodes::GAMEPAD_AXIS_LEFT_Y_POSITIVE
                GamepadAxisCode.RightXNegative: PortableInputCodes::GAMEPAD_AXIS_RIGHT_X_NEGATIVE
                GamepadAxisCode.RightXPositive: PortableInputCodes::GAMEPAD_AXIS_RIGHT_X_POSITIVE
                GamepadAxisCode.RightYNegative: PortableInputCodes::GAMEPAD_AXIS_RIGHT_Y_NEGATIVE
                GamepadAxisCode.RightYPositive: PortableInputCodes::GAMEPAD_AXIS_RIGHT_Y_POSITIVE
                GamepadAxisCode.LeftTrigger: PortableInputCodes::GAMEPAD_AXIS_LEFT_TRIGGER
                GamepadAxisCode.RightTrigger: PortableInputCodes::GAMEPAD_AXIS_RIGHT_TRIGGER

        # Keyboard, mouse-button, and gamepad transitions retain SDL arrival
        # order; normalized gamepad axes stay within [0, 1].
        def next_input_event(event: mutable InputEvent&) -> bool:
            encoded: i64 = elisa_application_v1_next_input_event_token()
            return false if encoded <= 0
            kind: i32 = (encoded & InputTokenLayout::KIND_MASK).i32()
            event.kind <- InputEventKind.Key if kind == Application::InputTokenKind::KEY
            event.kind <- InputEventKind.MouseButton if kind == Application::InputTokenKind::MOUSE_BUTTON
            event.kind <- InputEventKind.FocusLost if kind == Application::InputTokenKind::FOCUS_LOST
            event.kind <- InputEventKind.Overflow if kind == Application::InputTokenKind::OVERFLOW
            event.kind <- InputEventKind.GamepadButton if kind == Application::InputTokenKind::GAMEPAD_BUTTON
            event.kind <- InputEventKind.GamepadAxis if kind == Application::InputTokenKind::GAMEPAD_AXIS
            event.kind <- InputEventKind.GamepadConnected if kind == Application::InputTokenKind::GAMEPAD_CONNECTED
            event.kind <- InputEventKind.GamepadDisconnected if kind == Application::InputTokenKind::GAMEPAD_DISCONNECTED
            event.device <- ((encoded >> InputTokenLayout::DEVICE_SHIFT) & InputTokenLayout::DEVICE_MASK).i32()
            event.pressed <- ((encoded >> InputTokenLayout::PRESSED_SHIFT) & 1) != 0
            event.released <- ((encoded >> InputTokenLayout::RELEASED_SHIFT) & 1) != 0
            event.device_slot <- ((encoded >> InputTokenLayout::DEVICE_SLOT_SHIFT) & InputTokenLayout::DEVICE_SLOT_MASK).i32()
            event.connected <- true if kind == Application::InputTokenKind::GAMEPAD_CONNECTED else (event.pressed if kind == Application::InputTokenKind::GAMEPAD_DISCONNECTED else false)
            if kind == Application::InputTokenKind::GAMEPAD_AXIS:
                event.code <- (encoded >> InputTokenLayout::AXIS_CODE_SHIFT) & InputTokenLayout::AXIS_CODE_MASK
                event.value <- ((encoded >> InputTokenLayout::PAYLOAD_SHIFT) & InputTokenLayout::AXIS_VALUE_MASK).f32() / InputTokenLayout::AXIS_VALUE_MAX
            else:
                event.code <- (encoded >> InputTokenLayout::PAYLOAD_SHIFT) & InputTokenLayout::DIGITAL_CODE_MASK
                event.value <- 1.0 if event.pressed else 0.0
            event.chord_down <- false
            true

        enum RelativeMouse:
            Enabled
            Disabled
            Unsupported
            NotRunning

        # Mouse-look mode: hides and confines the cursor so motion deltas keep
        # arriving at the window edge. A platform refusal leaves the mode off.
        def set_relative_mouse(enabled: bool) -> RelativeMouse:
            status: i32 = elisa_application_v1_set_relative_mouse(1 if enabled else 0)
            return RelativeMouse.NotRunning if status == NativeStatus::INVALID_STATE or status == NativeStatus::WRONG_THREAD
            return RelativeMouse.Unsupported if status != NativeStatus::OK
            RelativeMouse.Enabled if enabled else RelativeMouse.Disabled

        def relative_mouse() -> bool:
            elisa_application_v1_relative_mouse() == 1

        # Pointer coordinates and deltas stay in logical window units. Editor
        # viewports apply the camera's display scale before ray construction.
        def next_pointer_event(event: mutable PointerEvent&) -> bool:
            kind: mutable i32 = 0
            button: mutable i32 = 0
            x: mutable f32 = 0.0
            y: mutable f32 = 0.0
            delta_x: mutable f32 = 0.0
            delta_y: mutable f32 = 0.0
            buttons: mutable u32 = 0
            pressed: mutable i32 = 0
            status: i32 = elisa_application_v1_next_pointer_event(&kind,
                &button, &x, &y, &delta_x, &delta_y, &buttons, &pressed)
            return false if status <= 0
            event.kind <- PointerEventKind.Motion if kind == PointerEventCode::MOTION
            event.kind <- PointerEventKind.Button if kind == PointerEventCode::BUTTON
            event.kind <- PointerEventKind.Wheel if kind == PointerEventCode::WHEEL
            event.kind <- PointerEventKind.FocusLost if kind == PointerEventCode::FOCUS_LOST
            event.kind <- PointerEventKind.Overflow if kind == PointerEventCode::OVERFLOW
            event.button <- button
            event.x <- x
            event.y <- y
            event.delta_x <- delta_x
            event.delta_y <- delta_y
            event.buttons <- buttons
            event.pressed <- pressed != 0
            true
