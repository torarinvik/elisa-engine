            GAMEPAD_BUTTON_LEFT_STICK: i64 = 1008
            GAMEPAD_BUTTON_RIGHT_STICK: i64 = 1009
            GAMEPAD_BUTTON_LEFT_SHOULDER: i64 = 1010
            GAMEPAD_BUTTON_RIGHT_SHOULDER: i64 = 1011
            GAMEPAD_BUTTON_DPAD_UP: i64 = 1012
            GAMEPAD_BUTTON_DPAD_DOWN: i64 = 1013
            GAMEPAD_BUTTON_DPAD_LEFT: i64 = 1014
            GAMEPAD_BUTTON_DPAD_RIGHT: i64 = 1015
            GAMEPAD_AXIS_LEFT_X_NEGATIVE: i64 = 1101
            GAMEPAD_AXIS_LEFT_X_POSITIVE: i64 = 1102
            GAMEPAD_AXIS_LEFT_Y_NEGATIVE: i64 = 1103
