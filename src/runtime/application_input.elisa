# Portable keyboard, gamepad, and pointer events over the SDL3 application host.
include "./application.elisa"

module ApplicationInput:
    public:
        const API_VERSION: i32 = 1

extend Application:
    private:
        const module InputTokenLayout:
            KIND_MASK: i64 = 15
            DEVICE_SHIFT: i64 = 4
            DEVICE_MASK: i64 = 3
            PAYLOAD_SHIFT: i64 = 6
            AXIS_VALUE_BITS: i64 = 20
            AXIS_VALUE_MASK: i64 = 1048575
            AXIS_VALUE_MAX: f32 = 1048575.0
            AXIS_CODE_SHIFT: i64 = PAYLOAD_SHIFT + AXIS_VALUE_BITS
            AXIS_CODE_MASK: i64 = 4095
            DIGITAL_CODE_MASK: i64 = 4294967295
            PRESSED_SHIFT: i64 = 38
            RELEASED_SHIFT: i64 = 39
            DEVICE_SLOT_SHIFT: i64 = 40
            DEVICE_SLOT_MASK: i64 = 15

        const module InputTokenKind:
            KEY: i32 = 1
            MOUSE_BUTTON: i32 = 2
            FOCUS_LOST: i32 = 3
            OVERFLOW: i32 = 4
            GAMEPAD_BUTTON: i32 = 5
            GAMEPAD_AXIS: i32 = 6
            GAMEPAD_CONNECTED: i32 = 7
            GAMEPAD_DISCONNECTED: i32 = 8

        const module PointerEventCode:
            MOTION: i32 = 1
            BUTTON: i32 = 2
            WHEEL: i32 = 3
            FOCUS_LOST: i32 = 4
            OVERFLOW: i32 = 5

        const module PortableInputCodes:
            GAMEPAD_BUTTON_SOUTH: i64 = 1001
            GAMEPAD_BUTTON_EAST: i64 = 1002
            GAMEPAD_BUTTON_WEST: i64 = 1003
            GAMEPAD_BUTTON_NORTH: i64 = 1004
            GAMEPAD_BUTTON_BACK: i64 = 1005
            GAMEPAD_BUTTON_GUIDE: i64 = 1006
