                KeyboardKeyCode.F10: PortableInputCodes::KEY_F10
                KeyboardKeyCode.F11: PortableInputCodes::KEY_F11
                KeyboardKeyCode.F12: PortableInputCodes::KEY_F12
                KeyboardKeyCode.Enter: PortableInputCodes::KEY_ENTER
                KeyboardKeyCode.Backspace: PortableInputCodes::KEY_BACKSPACE
                KeyboardKeyCode.Delete: PortableInputCodes::KEY_DELETE
                KeyboardKeyCode.Insert: PortableInputCodes::KEY_INSERT
                KeyboardKeyCode.Home: PortableInputCodes::KEY_HOME
                KeyboardKeyCode.End: PortableInputCodes::KEY_END
                KeyboardKeyCode.PageUp: PortableInputCodes::KEY_PAGE_UP
                KeyboardKeyCode.PageDown: PortableInputCodes::KEY_PAGE_DOWN
                KeyboardKeyCode.LeftAlt: PortableInputCodes::KEY_LEFT_ALT
                KeyboardKeyCode.RightAlt: PortableInputCodes::KEY_RIGHT_ALT
                KeyboardKeyCode.LeftSuper: PortableInputCodes::KEY_LEFT_SUPER
                KeyboardKeyCode.RightSuper: PortableInputCodes::KEY_RIGHT_SUPER
                KeyboardKeyCode.CapsLock: PortableInputCodes::KEY_CAPS_LOCK
                KeyboardKeyCode.Minus: PortableInputCodes::KEY_MINUS
                KeyboardKeyCode.Equals: PortableInputCodes::KEY_EQUALS
                KeyboardKeyCode.LeftBracket: PortableInputCodes::KEY_LEFT_BRACKET
                KeyboardKeyCode.RightBracket: PortableInputCodes::KEY_RIGHT_BRACKET
                KeyboardKeyCode.Backslash: PortableInputCodes::KEY_BACKSLASH
                KeyboardKeyCode.Semicolon: PortableInputCodes::KEY_SEMICOLON
