# Durable form of a recorded decision log: a versioned word stream
# (magic, version, seed, count, overflow, entries as tick/site/value, then a
# checksum) that a replay tool can store next to the native replay trace.
# Decoding validates everything before producing a replayer, so a truncated,
# corrupt or foreign stream never starts a replay.
include "./decision_log.elisa"

module RuntimeDecisionLogCodec:
    public:
        const MAGIC: i64 = 4475463
        const VERSION: i64 = 1
        const WORDS: i64 = 774
        const MAX_BYTES: usize = 6192

        enum Decode:
            Ok
            Truncated
            BadMagic
            BadVersion
            BadCount
            BadChecksum

        struct Stream:
            words: mutable i64[774]
            len: mutable i64

        struct Loaded:
            status: Decode
            log: RuntimeDecisionLog::Log

        struct Bytes:
            b: mutable u8[6192]
            len: mutable usize

        def checksum(s: Stream&, upto: i64) -> i64:
            mutable h: i64 = 1469598103
            for i in 0..<774 |h|:
                h <- (h * 31 + s.words[i]) % 1000000007 if i.i64() < upto else h
            h

        def encode(log: RuntimeDecisionLog::Log&) -> Stream:
            mutable s: Stream = Stream{words: zeroed, len: 0}
            s.words[0] <- MAGIC
            s.words[1] <- VERSION
            s.words[2] <- log.seed
            s.words[3] <- log.count
            s.words[4] <- 1 if log.overflow else 0
            for i in 0..<256 |s|:
                if i.i64() < log.count:
                    e: RuntimeDecisionLog::Entry = log.entries[i]
                    s.words[5 + 3 * i] <- e.tick
                    s.words[6 + 3 * i] <- e.site
                    s.words[7 + 3 * i] <- e.value
            n: i64 = 5 + 3 * log.count
            s.words[n.usize()] <- checksum(&s, n)
            s.len <- n + 1
            s

        def fail(status: Decode) -> Loaded:
            Loaded{status: status, log: RuntimeDecisionLog::recorder(0)}

        def decode(s: Stream&) -> Loaded:
            return fail(Decode.Truncated) if s.len < 6 or s.len > WORDS
            return fail(Decode.BadMagic) if s.words[0] != MAGIC
            return fail(Decode.BadVersion) if s.words[1] != VERSION
            count: i64 = s.words[3]
            return fail(Decode.BadCount) if count < 0 or count > RuntimeDecisionLog::CAP or s.words[4] < 0 or s.words[4] > 1
            return fail(Decode.Truncated) if s.len != 6 + 3 * count
            return fail(Decode.BadChecksum) if s.words[(5 + 3 * count).usize()] != checksum(s, 5 + 3 * count)
            mutable rec: RuntimeDecisionLog::Log = RuntimeDecisionLog::recorder(s.words[2])
            for i in 0..<256 |rec|:
                if i.i64() < count:
                    rec.entries[i] <- RuntimeDecisionLog::Entry{tick: s.words[5 + 3 * i], site: s.words[6 + 3 * i], value: s.words[7 + 3 * i]}
            rec.count <- count
            rec.overflow <- s.words[4] == 1
            Loaded{status: Decode.Ok, log: RuntimeDecisionLog::replayer(&rec)}

        # Byte form for storage: 8 little-endian two's-complement bytes per
        # word. unpack returns an empty stream for a partial word.
        def pack(s: Stream&) -> Bytes:
            mutable out: Bytes = Bytes{b: zeroed, len: 0}
            for i in 0..<774 |out|:
                if i.i64() < s.len:
                    w: i64 = s.words[i]
                    for k in 0..<8 |out|:
                        out.b[i * 8 + k] <- ((w >> (8 * k).i64()) & 255).u8()
            out.len <- (s.len * 8).usize()
            out

        def unpack(bytes: Bytes&) -> Stream:
            mutable s: Stream = Stream{words: zeroed, len: 0}
            return s if bytes.len % 8 != 0 or bytes.len > MAX_BYTES
            n: i64 = (bytes.len / 8).i64()
            for i in 0..<774 |s|:
                if i.i64() < n:
                    top: i64 = bytes.b[i * 8 + 7].i64()
                    mutable w: i64 = top - 256 if top >= 128 else top
                    for j in 0..<7 |w|:
                        w <- w * 256 + bytes.b[i * 8 + 6 - j].i64()
                    s.words[i] <- w
            s.len <- n
            s
