# Scoped debug primitives are submitted to the active RenderScene path.
include "./render_scene.elisa"
include "../math/geometry.elisa"

module RenderSceneDebug:
    public:
        const API_VERSION: i32 = 1
        const MAX_COMMANDS: usize = 128
        const LINE_CHUNK: usize = 256
        const LINE_VALUES: usize = 10
        const MAX_BATCH_LINES: usize = 16384

extend RenderScene:
    private:
        struct NativeDebugLineChunk:
            values: f32[RenderSceneDebug::LINE_CHUNK * RenderSceneDebug::LINE_VALUES]
            count: mutable u32
            depth_tested: mutable i32

        @callconv(c)
        extern elisa_render_scene_v1_debug_line_chunk(
            chunk: mutable NativeDebugLineChunk&) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_debug_box(
            min_x: f32, min_y: f32, min_z: f32,
            max_x: f32, max_y: f32, max_z: f32,
            red: f32, green: f32, blue: f32, alpha: f32,
            depth_tested: i32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_debug_line(
            start_x: f32, start_y: f32, start_z: f32,
            end_x: f32, end_y: f32, end_z: f32,
            red: f32, green: f32, blue: f32, alpha: f32,
            depth_tested: i32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_debug_text(
            text: cstr, x: f32, y: f32, z: f32,
            red: f32, green: f32, blue: f32, alpha: f32,
            depth_tested: i32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_debug_flush() -> i32
        @callconv(c)
        extern elisa_render_scene_v1_debug_clear() -> i32

        def depth_value(depth_tested: bool) -> i32:
            1 if depth_tested else 0

    public:
        def debug_box(bounds: Geometry::Bounds3, color: Color,
            depth_tested: bool) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_debug_box(
                bounds.minimum.x, bounds.minimum.y, bounds.minimum.z,
                bounds.maximum.x, bounds.maximum.y, bounds.maximum.z,
                color.red, color.green, color.blue, color.alpha,
                depth_value(depth_tested)))

        def debug_line(start: Geometry::Vec3, end: Geometry::Vec3, color: Color,
            depth_tested: bool) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_debug_line(
                start.x, start.y, start.z, end.x, end.y, end.z,
                color.red, color.green, color.blue, color.alpha,
                depth_value(depth_tested)))

        def debug_text(text: cstr, position: Geometry::Vec3, color: Color,
            depth_tested: bool) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_debug_text(text,
                position.x, position.y, position.z,
                color.red, color.green, color.blue, color.alpha,
                depth_value(depth_tested)))

        struct DebugLineChunk:
            private:
                native: mutable NativeDebugLineChunk

        def DebugLineChunk() -> DebugLineChunk:
            DebugLineChunk{native: zeroed}

        # Queues line records (start xyz, end xyz, rgba per line) for the
        # next flush, 256 lines per native call. Every chunk is checked
        # whole; on an error, the chunks before it stay queued.
        def debug_line_records(records: darray[f64]&, depth_tested: bool,
            chunk: mutable DebugLineChunk&) -> usize error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if records.count % RenderSceneDebug::LINE_VALUES != 0
            lines: usize = records.count / RenderSceneDebug::LINE_VALUES
            raise RenderSceneError.InvalidValue if lines > RenderSceneDebug::MAX_BATCH_LINES
            chunk.native.depth_tested <- depth_value(depth_tested)
            start: mutable usize = 0
            while start < lines:
                take: usize = RenderSceneDebug::LINE_CHUNK if lines - start > RenderSceneDebug::LINE_CHUNK else lines - start
                for v in 0..<take * RenderSceneDebug::LINE_VALUES |chunk, records, start|:
                    chunk.native.values[v] <- records[start * RenderSceneDebug::LINE_VALUES + v].f32()
                chunk.native.count <- take.u32()
                queued: i32 = elisa_render_scene_v1_debug_line_chunk(&chunk.native)
                if queued < 0:
                    try check_status(queued)
                start <- start + take
            lines

        def debug_flush() -> usize error[RenderSceneError]:
            flushed: i32 = elisa_render_scene_v1_debug_flush()
            if flushed < 0:
                try check_status(flushed)
            flushed.usize()

        def debug_clear() -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_debug_clear())
