# Public Elisa scene-rendering surface. Native handles and Wicked types stay
# behind the engine-owned scalar ABI.
include "../math/geometry.elisa"
include "../backend/lighting.elisa"
module RenderScene:
    private:
        const module NativeStatus:
            OK: i32 = 0
            INVALID_ARGUMENT: i32 = -1
            NOT_INITIALIZED: i32 = -2
            ALREADY_INITIALIZED: i32 = -3
            WRONG_THREAD: i32 = -4
            CAPACITY: i32 = -5
            UNKNOWN_HANDLE: i32 = -6
            GENERATION_EXHAUSTED: i32 = -7
            ASSET_LOAD_FAILED: i32 = -9
            BATCH_ACTIVE: i32 = -10
            ASSET_PENDING: i32 = -11
        const module NativeTextureSlot:
            BASE_COLOR: i32 = 0
            NORMAL: i32 = 1
            SURFACE: i32 = 2
            EMISSIVE: i32 = 3
        @callconv(c)
        extern elisa_render_scene_abi_version() -> u32
        @callconv(c)
        extern elisa_render_scene_v1_initialize(width: i32, height: i32, vertical_size: f32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_resize(width: i32, height: i32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_set_camera_render_target(width: i32, height: i32, update_interval: f32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_clear_camera_render_target() -> i32
        @callconv(c)
        extern elisa_render_scene_v1_set_camera_orthographic_height(vertical_size: f32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_set_camera_perspective(vertical_fov_radians: f32,
            near_clip: f32, far_clip: f32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_set_camera_look_at(eye_x: f32, eye_y: f32, eye_z: f32,
            target_x: f32, target_y: f32, target_z: f32, up_x: f32, up_y: f32, up_z: f32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_create_camera(projection: i32, width: i32, height: i32,
            projection_value: f32, near_clip: f32, far_clip: f32) -> i64
        @callconv(c)
        extern elisa_render_scene_v1_update_camera(handle: i64, projection: i32,
            width: i32, height: i32, projection_value: f32, near_clip: f32, far_clip: f32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_activate_camera(handle: i64) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_activate_default_camera() -> i32
        @callconv(c)
        extern elisa_render_scene_v1_destroy_camera(handle: i64) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_create(primitive: i32, px: f32, py: f32, pz: f32,
            qx: f32, qy: f32, qz: f32, qw: f32, sx: f32, sy: f32, sz: f32,
            red: f32, green: f32, blue: f32, alpha: f32) -> i64
        @callconv(c)
        extern elisa_render_scene_v1_create_mesh(package_path: cstr,
            px: f32, py: f32, pz: f32, qx: f32, qy: f32, qz: f32, qw: f32,
            sx: f32, sy: f32, sz: f32, red: f32, green: f32, blue: f32, alpha: f32) -> i64
        @callconv(c)
        extern elisa_render_scene_v1_update_transform(handle: i64, px: f32, py: f32, pz: f32,
            qx: f32, qy: f32, qz: f32, qw: f32, sx: f32, sy: f32, sz: f32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_snapshot_begin(previous_count: u32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_snapshot_stage(existing_handle: i64,
            gameplay_epoch: i64, gameplay_id: i64, render_id: i64,
            mesh_high: u64, mesh_low: u64, material_high: u64, material_low: u64,
            px: f32, py: f32, pz: f32, qx: f32, qy: f32, qz: f32, qw: f32,
            sx: f32, sy: f32, sz: f32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_snapshot_stage_tint(render_id: i64,
            red: f32, green: f32, blue: f32,
            emissive_red: f32, emissive_green: f32, emissive_blue: f32, emissive_strength: f32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_snapshot_retire(handle: i64) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_snapshot_commit() -> i32
        @callconv(c)
        extern elisa_render_scene_v1_snapshot_abort() -> i32
        @callconv(c)
        extern elisa_render_scene_v1_snapshot_result(index: u32) -> i64
        @callconv(c)
        extern elisa_render_scene_v1_play_animation(handle: i64, clip_name: cstr,
            loop: i32, speed: f32, blend_seconds: f32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_stop_animation(handle: i64, blend_seconds: f32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_advance_animation(handle: i64, delta_seconds: f32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_animation_progress(handle: i64) -> f32
        @callconv(c)
        extern elisa_render_scene_v1_set_lit_material(handle: i64, roughness: f32, metallic: f32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_set_texture_uv_transform(handle: i64, scale_u: f32, scale_v: f32, offset_u: f32, offset_v: f32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_set_sun_shadows(enabled: i32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_set_color(handle: i64, red: f32, green: f32, blue: f32, alpha: f32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_set_alpha_mode(handle: i64, mode: i32, cutoff: f32, double_sided: i32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_set_texture(handle: i64, slot: i32, asset_path: cstr) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_set_emissive(handle: i64, red: f32, green: f32,
            blue: f32, strength: f32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_set_environment(
            sun_direction_x: f32, sun_direction_y: f32, sun_direction_z: f32,
            sun_red: f32, sun_green: f32, sun_blue: f32,
            ambient_red: f32, ambient_green: f32, ambient_blue: f32,
            sky_exposure: f32,
            fog_red: f32, fog_green: f32, fog_blue: f32,
            fog_start: f32, fog_density: f32, fog_enabled: i32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_create_light(kind: i32,
            red: f32, green: f32, blue: f32,
            px: f32, py: f32, pz: f32, dx: f32, dy: f32, dz: f32,
            intensity: f32, range: f32, inner_cone: f32, outer_cone: f32,
            casts_shadow: i32) -> i64
        @callconv(c)
        extern elisa_render_scene_v1_update_light(handle: i64, kind: i32,
            red: f32, green: f32, blue: f32,
            px: f32, py: f32, pz: f32, dx: f32, dy: f32, dz: f32,
            intensity: f32, range: f32, inner_cone: f32, outer_cone: f32,
            casts_shadow: i32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_destroy_light(handle: i64) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_set_bloom(enabled: i32, threshold: f32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_set_ambient_occlusion(enabled: i32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_set_ambient_occlusion_settings(range: f32, power: f32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_set_fxaa(enabled: i32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_set_tonemap(tonemap: i32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_set_exposure(exposure: f32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_set_shadow_quality(quality: i32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_set_visible(handle: i64, visible: i32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_create_text(text: cstr, x: f32, y: f32,
            font_size: i32, red: f32, green: f32, blue: f32, alpha: f32) -> i64
        @callconv(c)
        extern elisa_render_scene_v1_set_text(handle: i64, text: cstr) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_set_text_i64(handle: i64, prefix: cstr, value: i64) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_set_text_position(handle: i64, x: f32, y: f32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_set_text_size(handle: i64, font_size: i32) -> i32
        extern elisa_render_scene_v1_set_text_color(handle: i64,
            red: f32, green: f32, blue: f32, alpha: f32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_set_text_visible(handle: i64, visible: i32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_destroy_text(handle: i64) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_create_overlay_panel(x: f32, y: f32,
            width: f32, height: f32, red: f32, green: f32, blue: f32, alpha: f32) -> i64
        @callconv(c)
        extern elisa_render_scene_v1_set_overlay_panel_position(handle: i64, x: f32, y: f32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_set_overlay_panel_size(handle: i64, width: f32, height: f32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_set_overlay_panel_color(handle: i64,
            red: f32, green: f32, blue: f32, alpha: f32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_set_overlay_panel_visible(handle: i64, visible: i32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_destroy_overlay_panel(handle: i64) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_create_electric_arc(width: f32, amplitude: f32, seed: u32) -> i64
        @callconv(c)
        extern elisa_render_scene_v1_update_electric_arc(handle: i64,
            start_x: f32, start_y: f32, start_z: f32,
            end_x: f32, end_y: f32, end_z: f32, phase: f32, visibility: f32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_set_electric_arc_depth_test(handle: i64, enabled: i32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_set_electric_arc_visible(handle: i64, visible: i32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_destroy_electric_arc(handle: i64) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_destroy(handle: i64) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_shutdown() -> i32
        @callconv(c)
        extern elisa_render_scene_v1_instance_count() -> u64
        @callconv(c)
        extern elisa_render_scene_v1_is_initialized() -> i32
        def check_status(status: i32) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if status == NativeStatus::INVALID_ARGUMENT
            raise RenderSceneError.NotInitialized if status == NativeStatus::NOT_INITIALIZED
            raise RenderSceneError.AlreadyInitialized if status == NativeStatus::ALREADY_INITIALIZED
            raise RenderSceneError.WrongThread if status == NativeStatus::WRONG_THREAD
            raise RenderSceneError.Capacity if status == NativeStatus::CAPACITY
            raise RenderSceneError.UnknownHandle if status == NativeStatus::UNKNOWN_HANDLE
            raise RenderSceneError.GenerationExhausted if status == NativeStatus::GENERATION_EXHAUSTED
            raise RenderSceneError.AssetLoadFailure if status == NativeStatus::ASSET_LOAD_FAILED
            raise RenderSceneError.BatchActive if status == NativeStatus::BATCH_ACTIVE
            raise RenderSceneError.AssetPending if status == NativeStatus::ASSET_PENDING
            raise RenderSceneError.BackendFailure if status != NativeStatus::OK
    public:
        const MAX_INSTANCES: usize = 512
        const MAX_ELECTRIC_ARCS: usize = 1024
        const MAX_SNAPSHOT_ENTRIES: usize = 256
        const MAX_OVERLAY_PANELS: usize = 64
        enum Primitive:
            Box
            Sphere
            Plane
        enum TextureSlot:
            BaseColor
            Normal
            Surface
            Emissive
        enum AlphaMode:
            Opaque
            Mask
            Blend
        enum Tonemap:
            Reinhard
            Aces
            Uchimura
        enum ShadowQuality:
            Low
            Medium
            High
        enum CameraProjection:
            Perspective
            Orthographic
        struct Color:
            red: f32
            green: f32
            blue: f32
            alpha: f32
        struct Emission:
            color: Geometry::Vec3
            strength: f32
        struct InstanceHandle:
            private:
                native_value: i64
        struct LightHandle:
            id: i64
        struct CameraHandle:
            private:
                native_value: i64
        struct ElectricArcHandle:
            private:
                native_value: i64
        struct OverlayTextHandle:
            id: i64
        # A generation-checked screen-space rectangle handle. Its integer
        # value is safe to carry in game-owned Elisa state.
        struct OverlayPanelHandle:
            id: i64
        struct ElectricArcBatch:
            private:
                handles: mutable ElectricArcHandle[RenderScene::MAX_ELECTRIC_ARCS]
                count: mutable usize
        # A compact owner-side collection avoids exposing the representation of
        # opaque handles to projects. It is useful for batches such as maze
        # tiles that are created once and shown or hidden as topology changes.
        struct InstanceBatch:
            private:
                handles: mutable InstanceHandle[RenderScene::MAX_INSTANCES]
                count: mutable usize
        error RenderSceneError:
            InvalidValue
            NotInitialized
            AlreadyInitialized
            WrongThread
            Capacity
            UnknownHandle
            GenerationExhausted
            AssetLoadFailure
            BackendFailure
            BatchActive
            # A snapshot row or material names an asset that is still loading.
            AssetPending
        def initialize(width: i32, height: i32, orthographic_height: f32) -> void error[RenderSceneError]:
            raise RenderSceneError.BackendFailure if elisa_render_scene_abi_version() != 1
            try check_status(elisa_render_scene_v1_initialize(width, height, orthographic_height))
        def InstanceBatch() -> InstanceBatch:
            InstanceBatch{handles: zeroed, count: 0}
        def batch_append(batch: mutable InstanceBatch&, handle: InstanceHandle) -> void error[RenderSceneError]:
            raise RenderSceneError.Capacity if batch.count >= MAX_INSTANCES
            batch.handles[batch.count] <- handle
            batch.count <- batch.count + 1
        def batch_get(batch: InstanceBatch&, index: usize) -> InstanceHandle error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if index >= batch.count
            batch.handles[index]
        def ElectricArcBatch() -> ElectricArcBatch:
            ElectricArcBatch{handles: zeroed, count: 0}
        def electric_arc_batch_append(batch: mutable ElectricArcBatch&,
            handle: ElectricArcHandle) -> void error[RenderSceneError]:
            raise RenderSceneError.Capacity if batch.count >= RenderScene::MAX_ELECTRIC_ARCS
            batch.handles[batch.count] <- handle
            batch.count <- batch.count + 1
        def electric_arc_batch_get(batch: ElectricArcBatch&,
            index: usize) -> ElectricArcHandle error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if index >= batch.count
            batch.handles[index]
        def electric_arc_batch_count(batch: ElectricArcBatch&) -> usize:
            batch.count
        def batch_count(batch: InstanceBatch&) -> usize:
            batch.count
        def resize(width: i32, height: i32) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_resize(width, height))
        def set_camera_render_target(width: i32, height: i32, update_interval: f32) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_set_camera_render_target(width, height, update_interval))
        def clear_camera_render_target() -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_clear_camera_render_target())
        def set_camera_orthographic_height(vertical_size: f32) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_set_camera_orthographic_height(vertical_size))
        # Field of view is vertical and measured in radians. Resize preserves
        # this projection and its clipping range until orthographic mode returns.
        def set_camera_perspective(vertical_fov_radians: f32, near_clip: f32,
            far_clip: f32) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_set_camera_perspective(
                vertical_fov_radians, near_clip, far_clip))
        def set_camera_look_at(eye: Geometry::Vec3, target: Geometry::Vec3, up: Geometry::Vec3) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_set_camera_look_at(
                eye.x, eye.y, eye.z, target.x, target.y, target.z, up.x, up.y, up.z))
        def create_camera(projection: CameraProjection, width: i32, height: i32,
            projection_value: f32, near_clip: f32, far_clip: f32) -> CameraHandle error[RenderSceneError]:
            projection_code: i32 = 0 if projection == CameraProjection.Orthographic else 1
            native_value: i64 = elisa_render_scene_v1_create_camera(projection_code, width, height,
                projection_value, near_clip, far_clip)
            if native_value <= 0:
                try check_status(native_value.i32())
                raise RenderSceneError.BackendFailure
            CameraHandle{native_value: native_value}
        def update_camera(handle: CameraHandle, projection: CameraProjection,
            width: i32, height: i32, projection_value: f32, near_clip: f32,
            far_clip: f32) -> void error[RenderSceneError]:
            projection_code: i32 = 0 if projection == CameraProjection.Orthographic else 1
            try check_status(elisa_render_scene_v1_update_camera(handle.native_value, projection_code,
                width, height, projection_value, near_clip, far_clip))
        def activate_camera(handle: CameraHandle) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_activate_camera(handle.native_value))
        def activate_default_camera() -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_activate_default_camera())
        def destroy_camera(handle: CameraHandle) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_destroy_camera(handle.native_value))
        def create(primitive: Primitive, transform: Geometry::Transform, color: Color) -> InstanceHandle error[RenderSceneError]:
            primitive_code: i32 = 1 if primitive == Primitive.Box else (2 if primitive == Primitive.Sphere else (3 if primitive == Primitive.Plane else 0))
            native_value: i64 = elisa_render_scene_v1_create(primitive_code,
                transform.position.x, transform.position.y, transform.position.z,
                transform.rotation.x, transform.rotation.y, transform.rotation.z, transform.rotation.w,
                transform.scale.x, transform.scale.y, transform.scale.z,
                color.red, color.green, color.blue, color.alpha)
            if native_value <= 0:
                try check_status(native_value.i32())
                raise RenderSceneError.BackendFailure
            InstanceHandle{native_value: native_value}
        # Package paths are relative to the project root and refer to bounded
        # engine-cooked geometry, never authoring files such as FBX at runtime.
        def create_mesh(package_path: cstr, transform: Geometry::Transform,
            color: Color) -> InstanceHandle error[RenderSceneError]:
            native_value: i64 = elisa_render_scene_v1_create_mesh(package_path,
                transform.position.x, transform.position.y, transform.position.z,
                transform.rotation.x, transform.rotation.y, transform.rotation.z, transform.rotation.w,
                transform.scale.x, transform.scale.y, transform.scale.z,
                color.red, color.green, color.blue, color.alpha)
            if native_value <= 0:
                try check_status(native_value.i32())
                raise RenderSceneError.BackendFailure
            InstanceHandle{native_value: native_value}
        def update_transform(handle: InstanceHandle, transform: Geometry::Transform) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_update_transform(handle.native_value,
                transform.position.x, transform.position.y, transform.position.z,
                transform.rotation.x, transform.rotation.y, transform.rotation.z, transform.rotation.w,
                transform.scale.x, transform.scale.y, transform.scale.z))
        # Clip names may be the full imported FBX stack name or its final
        # segment (for example, "Walking"). Each instance advances independently.
        def play_animation(handle: InstanceHandle, clip_name: cstr, loop: bool,
            speed: f32, blend_seconds: f32) -> void error[RenderSceneError]:
            loop_value: i32 = 1 if loop else 0
            try check_status(elisa_render_scene_v1_play_animation(handle.native_value,
                clip_name, loop_value, speed, blend_seconds))
        def stop_animation(handle: InstanceHandle, blend_seconds: f32) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_stop_animation(handle.native_value, blend_seconds))
        def advance_animation(handle: InstanceHandle, delta_seconds: f32) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_advance_animation(handle.native_value, delta_seconds))
        def animation_progress(handle: InstanceHandle) -> f32 error[RenderSceneError]:
            value: f32 = elisa_render_scene_v1_animation_progress(handle.native_value)
            if value < 0.0:
                raise RenderSceneError.UnknownHandle
            value
        # Opt into PBR illumination and shadow casting. Scalars multiply surface maps.
        def set_lit_material(handle: InstanceHandle, roughness: f32, metallic: f32) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_set_lit_material(handle.native_value, roughness, metallic))
        def set_texture_uv_transform(handle: InstanceHandle, scale_u: f32, scale_v: f32,
            offset_u: f32, offset_v: f32) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_set_texture_uv_transform(handle.native_value,
                scale_u, scale_v, offset_u, offset_v))
        # Call after set_environment, which creates the directional sun.
        def set_sun_shadows(enabled: bool) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_set_sun_shadows(1 if enabled else 0))
        def set_color(handle: InstanceHandle, color: Color) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_set_color(handle.native_value,
                color.red, color.green, color.blue, color.alpha))
        # Mask keeps the mesh opaque while discarding texels below cutoff, which is
        # suitable for fences and foliage. Blend is sorted transparency.
        def set_alpha_mode(handle: InstanceHandle, mode: AlphaMode, cutoff: f32,
            double_sided: bool) -> void error[RenderSceneError]:
            mode_code: i32 =
                match mode:
                    AlphaMode.Opaque: 0
                    AlphaMode.Mask: 1
                    AlphaMode.Blend: 2
            try check_status(elisa_render_scene_v1_set_alpha_mode(handle.native_value,
                mode_code, cutoff, 1 if double_sided else 0))
        # Paths are project-relative. Surface uses Wicked's RGBA packed surface
        # channels; Normal selects Wicked's normal-map import path.
        # This assigns maps without changing the material's shading model.
        def set_texture(handle: InstanceHandle, slot: RenderScene::TextureSlot,
            asset_path: cstr) -> void error[RenderSceneError]:
            slot_code: i32 =
                match slot:
                    RenderScene::TextureSlot.BaseColor: NativeTextureSlot::BASE_COLOR
                    RenderScene::TextureSlot.Normal: NativeTextureSlot::NORMAL
                    RenderScene::TextureSlot.Surface: NativeTextureSlot::SURFACE
                    RenderScene::TextureSlot.Emissive: NativeTextureSlot::EMISSIVE
            try check_status(elisa_render_scene_v1_set_texture(handle.native_value, slot_code, asset_path))
        # Emission intensity is HDR and can exceed one; the render path's bloom
        # threshold determines how much emitted light spreads into nearby pixels.
        def set_emissive(handle: InstanceHandle, emission: Emission) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_set_emissive(handle.native_value,
                emission.color.x, emission.color.y, emission.color.z, emission.strength))
        # Configures the scene's physical sky and directional sunlight. Elisa
        # owns the environment choice; Wicked entities stay engine-owned.
        def set_environment(environment: Lighting::Environment) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Lighting::environment_valid(environment)
            fog_enabled: i32 = 1 if environment.fog_enabled else 0
            try check_status(elisa_render_scene_v1_set_environment(
                environment.sun_direction.x, environment.sun_direction.y, environment.sun_direction.z,
                environment.sun_color.x, environment.sun_color.y, environment.sun_color.z,
                environment.ambient.x, environment.ambient.y, environment.ambient.z,
                environment.sky_exposure,
                environment.fog_color.x, environment.fog_color.y, environment.fog_color.z,
                environment.fog_start, environment.fog_density, fog_enabled))
        def create_light(light: Lighting::Light) -> LightHandle error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Lighting::light_valid(light)
            kind: i32 = 0 if light.kind == Lighting::LightKind.Directional else (2 if light.kind == Lighting::LightKind.Spot else 1)
            native_value: i64 = elisa_render_scene_v1_create_light(kind,
                light.color.x, light.color.y, light.color.z,
                light.position.x, light.position.y, light.position.z,
                light.direction.x, light.direction.y, light.direction.z,
                light.intensity, light.range, light.inner_cone, light.outer_cone,
                1 if light.casts_shadow else 0)
            if native_value <= 0:
                try check_status(native_value.i32())
                raise RenderSceneError.BackendFailure
            LightHandle{id: native_value}
        def update_light(handle: LightHandle, light: Lighting::Light) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Lighting::light_valid(light)
            kind: i32 = 0 if light.kind == Lighting::LightKind.Directional else (2 if light.kind == Lighting::LightKind.Spot else 1)
            try check_status(elisa_render_scene_v1_update_light(handle.id, kind,
                light.color.x, light.color.y, light.color.z,
                light.position.x, light.position.y, light.position.z,
                light.direction.x, light.direction.y, light.direction.z,
                light.intensity, light.range, light.inner_cone, light.outer_cone,
                1 if light.casts_shadow else 0))
        def destroy_light(handle: LightHandle) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_destroy_light(handle.id))
        def set_bloom(enabled: bool, threshold: f32) -> void error[RenderSceneError]:
            enabled_value: i32 = 1 if enabled else 0
            try check_status(elisa_render_scene_v1_set_bloom(enabled_value, threshold))
        # Screen-space ambient occlusion adds contact shading around feet,
        # fence bases, and other nearby surfaces.
        def set_ambient_occlusion(enabled: bool) -> void error[RenderSceneError]:
            enabled_value: i32 = 1 if enabled else 0
            try check_status(elisa_render_scene_v1_set_ambient_occlusion(enabled_value))
        # Range is measured in world units; power controls contact contrast.
        # Both values are bounded so projects cannot destabilize the renderer.
        def set_ambient_occlusion_settings(range: f32, power: f32) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if range < 0.01 or range > 32.0
            raise RenderSceneError.InvalidValue if power < 0.0 or power > 8.0
            try check_status(elisa_render_scene_v1_set_ambient_occlusion_settings(range, power))
        # FXAA smooths thin geometry edges at the current render resolution.
        def set_fxaa(enabled: bool) -> void error[RenderSceneError]:
            enabled_value: i32 = 1 if enabled else 0
            try check_status(elisa_render_scene_v1_set_fxaa(enabled_value))
        def set_tonemap(tonemap: Tonemap) -> void error[RenderSceneError]:
            tonemap_value: i32 =
                match tonemap:
                    RenderScene::Tonemap.Reinhard: 0
                    RenderScene::Tonemap.Aces: 1
                    RenderScene::Tonemap.Uchimura: 2
            try check_status(elisa_render_scene_v1_set_tonemap(tonemap_value))
        # Exposure is a bounded scene-wide post-process multiplier. Keep it
        # separate from environment sky exposure so authored lighting remains
        # stable while a project tunes final readability.
        def set_exposure(exposure: f32) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if exposure < 0.0 or exposure > 8.0
            try check_status(elisa_render_scene_v1_set_exposure(exposure))
        def set_shadow_quality(quality: ShadowQuality) -> void error[RenderSceneError]:
            quality_value: i32 =
                match quality:
                    RenderScene::ShadowQuality.Low: 0
                    RenderScene::ShadowQuality.Medium: 1
                    RenderScene::ShadowQuality.High: 2
            try check_status(elisa_render_scene_v1_set_shadow_quality(quality_value))
        def set_visible(handle: InstanceHandle, visible: bool) -> void error[RenderSceneError]:
            visible_value: i32 = 1 if visible else 0
            try check_status(elisa_render_scene_v1_set_visible(handle.native_value, visible_value))
        def create_overlay_text(text: cstr, x: f32, y: f32, font_size: i32,
            color: Color) -> OverlayTextHandle error[RenderSceneError]:
            native_value: i64 = elisa_render_scene_v1_create_text(text, x, y, font_size,
                color.red, color.green, color.blue, color.alpha)
            if native_value <= 0:
                try check_status(native_value.i32())
                raise RenderSceneError.BackendFailure
            OverlayTextHandle{id: native_value}
        def set_overlay_text(handle: OverlayTextHandle, text: cstr) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_set_text(handle.id, text))
        def set_overlay_text_i64(handle: OverlayTextHandle, prefix: cstr,
            value: i64) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_set_text_i64(handle.id, prefix, value))
        def set_overlay_text_position(handle: OverlayTextHandle, x: f32,
            y: f32) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_set_text_position(handle.id, x, y))
        def set_overlay_text_size(handle: OverlayTextHandle,
            font_size: i32) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_set_text_size(handle.id, font_size))
        def set_overlay_text_color(handle: OverlayTextHandle,
            color: Color) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_set_text_color(handle.id,
                color.red, color.green, color.blue, color.alpha))
        def set_overlay_text_visible(handle: OverlayTextHandle, visible: bool) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_set_text_visible(
                handle.id, 1 if visible else 0))
        def destroy_overlay_text(handle: OverlayTextHandle) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_destroy_text(handle.id))
        # Position is the panel's upper-left corner in the logical canvas.
        def create_overlay_panel(x: f32, y: f32, width: f32, height: f32,
            color: Color) -> OverlayPanelHandle error[RenderSceneError]:
            native_value: i64 = elisa_render_scene_v1_create_overlay_panel(x, y, width, height,
                color.red, color.green, color.blue, color.alpha)
            if native_value <= 0:
                try check_status(native_value.i32())
                raise RenderSceneError.BackendFailure
            OverlayPanelHandle{id: native_value}
        def set_overlay_panel_position(handle: OverlayPanelHandle, x: f32,
            y: f32) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_set_overlay_panel_position(
                handle.id, x, y))
        def set_overlay_panel_size(handle: OverlayPanelHandle,
            width: f32, height: f32) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_set_overlay_panel_size(
                handle.id, width, height))
        def set_overlay_panel_color(handle: OverlayPanelHandle,
            color: Color) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_set_overlay_panel_color(handle.id,
                color.red, color.green, color.blue, color.alpha))
        def set_overlay_panel_visible(handle: OverlayPanelHandle,
            visible: bool) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_set_overlay_panel_visible(
                handle.id, 1 if visible else 0))
        def destroy_overlay_panel(handle: OverlayPanelHandle) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_destroy_overlay_panel(handle.id))
        # Creates a reusable jagged, additive ribbon. Elisa supplies the live
        # connector endpoints and phase each frame; the engine keeps endpoints
        # pinned while generating the interior flicker and blue halo.
        def create_electric_arc(width: f32, amplitude: f32, seed: u32) -> ElectricArcHandle error[RenderSceneError]:
            native_value: i64 = elisa_render_scene_v1_create_electric_arc(width, amplitude, seed)
            if native_value <= 0:
                try check_status(native_value.i32())
                raise RenderSceneError.BackendFailure
            ElectricArcHandle{native_value: native_value}
        def update_electric_arc(handle: ElectricArcHandle, start: Geometry::Vec3,
            end: Geometry::Vec3, phase: f32, visibility: f32) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_update_electric_arc(handle.native_value,
                start.x, start.y, start.z, end.x, end.y, end.z, phase, visibility))
        def set_electric_arc_depth_test(handle: ElectricArcHandle, enabled: bool) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_set_electric_arc_depth_test(
                handle.native_value, 1 if enabled else 0))
        def set_electric_arc_visible(handle: ElectricArcHandle, visible: bool) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_set_electric_arc_visible(
                handle.native_value, 1 if visible else 0))
        def destroy_electric_arc(handle: ElectricArcHandle) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_destroy_electric_arc(handle.native_value))
        def destroy(handle: InstanceHandle) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_destroy(handle.native_value))
        # Safe to call more than once, including after application shutdown.
        def shutdown() -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_shutdown())
        def instance_count() -> usize:
            elisa_render_scene_v1_instance_count().usize()
        def is_initialized() -> bool:
            elisa_render_scene_v1_is_initialized() != 0
