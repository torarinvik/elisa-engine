# Live render resource totals and per-instance readback for regression checks; no
# native handle or Wicked entity crosses this API.
include "./render_scene.elisa"

extend RenderScene:
    private:
        @callconv(c)
        extern elisa_render_scene_v1_resource_counts(instances: mutable i32&,
            lights: mutable i32&, scene_entities: mutable i32&) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_instance_probe(handle: i64, position: mutable f32[3]&,
            lit: mutable i32&, roughness: mutable f32&, metallic: mutable f32&) -> i32

    public:
        struct ResourceCounts:
            instances: i32
            lights: i32
            scene_entities: i32

        struct InstanceProbe:
            position: Geometry::Vec3
            lit: bool
            roughness: f32
            metallic: f32

        def resource_counts() -> ResourceCounts error[RenderSceneError]:
            instances: mutable i32 = 0
            lights: mutable i32 = 0
            scene_entities: mutable i32 = 0
            try check_status(elisa_render_scene_v1_resource_counts(&instances, &lights, &scene_entities))
            ResourceCounts{instances: instances, lights: lights, scene_entities: scene_entities}

        def probe_instance(handle: InstanceHandle) -> InstanceProbe error[RenderSceneError]:
            position: mutable f32[3] = zeroed
            lit: mutable i32 = 0
            roughness: mutable f32 = 0.0
            metallic: mutable f32 = 0.0
            try check_status(elisa_render_scene_v1_instance_probe(handle.native_value, &position, &lit, &roughness, &metallic))
            InstanceProbe{position: Geometry::Vec3{x: position[0], y: position[1], z: position[2]},
                lit: lit == 1, roughness: roughness, metallic: metallic}
