# Asset registration extension for the persistent native snapshot presenter.
# Kept separate from RenderScene's core public surface to avoid importing
# backend material names into primitive-scene clients.
include "../assets/descriptor.elisa"
include "../backend/material.elisa"
include "./render_scene.elisa"

module SnapshotAssetCapabilities:
    # Snapshot materials support registered textures and one packed Wicked
    # surface map; cooked glTF materials may additionally bind OCCLUSIONMAP.
    public:
        const MATERIAL_TEXTURES_SUPPORTED: bool = true

extend RenderScene:
    private:
        def snapshot_material_textures_supported(material: Material::Material&) -> bool:
            return false if not SnapshotAssetCapabilities::MATERIAL_TEXTURES_SUPPORTED
            return true if not Assets::asset_id_valid(material.metallic_roughness)
            return true if not Assets::asset_id_valid(material.occlusion)
            Assets::same_asset_id(material.metallic_roughness, material.occlusion)

        def snapshot_surface_texture(material: Material::Material&) -> Assets::AssetId:
            return material.metallic_roughness if Assets::asset_id_valid(material.metallic_roughness)
            material.occlusion

        const module NativeAlphaMode:
            OPAQUE: i32 = 0
            MASK: i32 = 1
            BLEND: i32 = 2

        @callconv(c)
        extern elisa_render_scene_v1_register_snapshot_mesh_asset(high: u64, low: u64,
            package_path: cstr) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_unregister_snapshot_mesh_asset(high: u64, low: u64) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_register_snapshot_texture_asset(
            high: u64, low: u64, asset_path: cstr) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_unregister_snapshot_texture_asset(high: u64, low: u64) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_register_snapshot_bundle_texture_asset(
            high: u64, low: u64, bundle_path: cstr, section: cstr) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_register_snapshot_material_asset_with_occlusion(
            high: u64, low: u64,
            base_color_high: u64, base_color_low: u64,
            normal_high: u64, normal_low: u64,
            surface_high: u64, surface_low: u64,
            emissive_high: u64, emissive_low: u64,
            red: f32, green: f32, blue: f32, alpha: f32,
            metallic: f32, roughness: f32, emissive_red: f32, emissive_green: f32,
            emissive_blue: f32, alpha_cutoff: f32, alpha_mode: i32, double_sided: i32,
            occlusion: i32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_register_snapshot_material_asset_with_parameters(
            high: u64, low: u64,
            base_color_high: u64, base_color_low: u64,
            normal_high: u64, normal_low: u64,
            surface_high: u64, surface_low: u64,
            emissive_high: u64, emissive_low: u64,
            red: f32, green: f32, blue: f32, alpha: f32,
            metallic: f32, roughness: f32, normal_scale: f32,
            emissive_red: f32, emissive_green: f32, emissive_blue: f32,
            alpha_cutoff: f32, alpha_mode: i32, double_sided: i32,
            occlusion: i32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_unregister_snapshot_material_asset(high: u64, low: u64) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_stage_snapshot_material_set_slot(slot: u32,
            material_high: u64, material_low: u64) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_register_snapshot_material_set(high: u64, low: u64, count: u32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_unregister_snapshot_material_set(high: u64, low: u64) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_snapshot_mesh_material_count(mesh_high: u64, mesh_low: u64) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_snapshot_mesh_material_name(mesh_high: u64, mesh_low: u64,
            slot: u32, name_bytes: mutable u8&, name_capacity: u32,
            name_length: mutable u32&) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_snapshot_mesh_placement_count(
            mesh_high: u64, mesh_low: u64) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_snapshot_mesh_placement(
            mesh_high: u64, mesh_low: u64, index: u32,
            mesh_index: mutable u32&, node_index: mutable u32&) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_snapshot_mesh_placement_component(
            mesh_high: u64, mesh_low: u64, index: u32, component: u32) -> f32

        @callconv(c)
        extern elisa_render_scene_v1_register_snapshot_mesh_material(mesh_high: u64, mesh_low: u64,
            slot: u32, high: u64, low: u64) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_snapshot_mesh_texture_count(mesh_high: u64, mesh_low: u64) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_register_snapshot_mesh_texture(mesh_high: u64, mesh_low: u64,
            index: u32, high: u64, low: u64) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_register_snapshot_mesh_material_set(mesh_high: u64, mesh_low: u64,
            set_high: u64, set_low: u64, count: u32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_request_snapshot_mesh_asset(high: u64, low: u64,
            package_path: cstr) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_request_snapshot_mesh_asset_with_priority(high: u64, low: u64,
            package_path: cstr, priority: i32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_request_snapshot_bundle_texture_asset(
            high: u64, low: u64, bundle_path: cstr, section: cstr) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_request_snapshot_bundle_texture_asset_with_priority(
            high: u64, low: u64, bundle_path: cstr, section: cstr, priority: i32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_pump_snapshot_assets(budget: u32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_snapshot_asset_state(kind: i32, high: u64, low: u64) -> i32

        const module NativeSnapshotAsset:
            MESH: i32 = 0
            TEXTURE: i32 = 1
            LOADING: i32 = 1
            RESIDENT: i32 = 2

    public:
        # A cooked mesh has at most this many material slots.
        const MAX_SNAPSHOT_MATERIAL_SLOTS: usize = 16
        const MAX_SNAPSHOT_MATERIAL_NAME_BYTES: usize = 256
        const SNAPSHOT_MESH_PLACEMENT_COMPONENTS: usize = 12

        # UTF-8 bytes for one cooked slot name. `length` excludes any terminator;
        # zero means the source name is empty or absent.
        struct SnapshotMeshMaterialName:
            bytes: u8[RenderScene::MAX_SNAPSHOT_MATERIAL_NAME_BYTES]
            length: usize

        def SnapshotMeshMaterialName() -> SnapshotMeshMaterialName:
            SnapshotMeshMaterialName{bytes: zeroed, length: 0}

        # One registered material for each material slot of a multi-material
        # mesh, in slot order.
        struct SnapshotMaterialSet:
            private:
                materials: mutable Assets::AssetId[RenderScene::MAX_SNAPSHOT_MATERIAL_SLOTS]
                count: mutable usize

        def SnapshotMaterialSet() -> SnapshotMaterialSet:
            SnapshotMaterialSet{materials: zeroed, count: 0}

        # Source mesh/node placement metadata retained by the glTF cooker.
        # The renderer still consumes the flattened geometry payload.
        struct SnapshotMeshPlacement:
            mesh_index: mutable u32
            node_index: mutable u32
            transform: mutable f32[RenderScene::SNAPSHOT_MESH_PLACEMENT_COMPONENTS]

        def SnapshotMeshPlacement() -> SnapshotMeshPlacement:
            SnapshotMeshPlacement{mesh_index: 0, node_index: 0, transform: zeroed}

        def snapshot_material_set_append(set: mutable SnapshotMaterialSet&,
            material: Assets::AssetId) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(material)
            raise RenderSceneError.Capacity if set.count >= RenderScene::MAX_SNAPSHOT_MATERIAL_SLOTS
            set.materials[set.count] <- material
            set.count <- set.count + 1

        def snapshot_material_set_count(set: SnapshotMaterialSet&) -> usize:
            set.count

        enum SnapshotAssetKind:
            Mesh
            Texture

        enum SnapshotAssetState:
            Absent
            Loading
            Resident

        # Snapshot IDs resolve to shared cooked geometry and backend-neutral
        # PBR factors. Registration is owner-thread-only and idempotent for an
        # unchanged ID/path or ID/material pair.
        def register_snapshot_mesh_asset(asset: Assets::AssetId,
            package_path: cstr) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(asset)
            try check_status(elisa_render_scene_v1_register_snapshot_mesh_asset(
                asset.high, asset.low, package_path))

        def unregister_snapshot_mesh_asset(asset: Assets::AssetId) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(asset)
            try check_status(elisa_render_scene_v1_unregister_snapshot_mesh_asset(asset.high, asset.low))

        def register_snapshot_texture_asset(asset: Assets::AssetId,
            asset_path: cstr) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(asset)
            try check_status(elisa_render_scene_v1_register_snapshot_texture_asset(
                asset.high, asset.low, asset_path))

        # A PNG, JPEG, or 2D Basis KTX2 section of an ELPK bundle. PNG/JPEG
        # decode during registration; KTX2 stays encoded until material upload.
        def register_snapshot_bundle_texture_asset(asset: Assets::AssetId,
            bundle_path: cstr, section: cstr) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(asset)
            try check_status(elisa_render_scene_v1_register_snapshot_bundle_texture_asset(
                asset.high, asset.low, bundle_path, section))

        def unregister_snapshot_texture_asset(asset: Assets::AssetId) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(asset)
            try check_status(elisa_render_scene_v1_unregister_snapshot_texture_asset(asset.high, asset.low))

        # An occlusion texture turns on Wicked's ambient occlusion from the
        # packed surface map's red channel. It must be the metallic-roughness
        # texture, or stand alone as the surface map. Cooked glTF materials
        # can additionally retain a dedicated occlusion map.
        def register_snapshot_material_asset(asset: Assets::AssetId,
            material: Material::Material&) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(asset)
            raise RenderSceneError.InvalidValue if not Material::material_valid(material)
            raise RenderSceneError.InvalidValue if not snapshot_material_textures_supported(material)
            alpha_mode: i32 =
                match material.alpha_mode:
                    Material::AlphaMode.Opaque: NativeAlphaMode::OPAQUE
                    Material::AlphaMode.Mask: NativeAlphaMode::MASK
                    Material::AlphaMode.Blend: NativeAlphaMode::BLEND
            double_sided: i32 = 1 if material.double_sided else 0
            occluded: i32 = 1 if Assets::asset_id_valid(material.occlusion) else 0
            surface_texture: Assets::AssetId = snapshot_surface_texture(material)
            try check_status(elisa_render_scene_v1_register_snapshot_material_asset_with_parameters(
                asset.high, asset.low,
                material.base_color.high, material.base_color.low,
                material.normal.high, material.normal.low,
                surface_texture.high, surface_texture.low,
                material.emissive.high, material.emissive.low,
                material.base_color_factor[0], material.base_color_factor[1],
                material.base_color_factor[2], material.base_color_factor[3],
                material.metallic_factor, material.roughness_factor, material.normal_scale,
                material.emissive_factor[0], material.emissive_factor[1],
                material.emissive_factor[2], material.alpha_cutoff, alpha_mode, double_sided, occluded))

        def unregister_snapshot_material_asset(asset: Assets::AssetId) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(asset)
            try check_status(elisa_render_scene_v1_unregister_snapshot_material_asset(asset.high, asset.low))

        # A snapshot entry may name a material set where it would name a
        # material. A set draws each subset of a multi-material mesh with its
        # slot's material and must list exactly one material per slot; a
        # single material draws every slot. Sets share the material ID space.
        # Registering a set again with the same materials is a no-op. A
        # listed material can't be unregistered while the set exists, and the
        # set can't be unregistered while an instance draws with it.
        def register_snapshot_material_set(asset: Assets::AssetId,
            set: SnapshotMaterialSet&) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(asset)
            raise RenderSceneError.InvalidValue if set.count == 0
            for slot in 0..<set.count |set|:
                material: Assets::AssetId = set.materials[slot]
                try check_status(elisa_render_scene_v1_stage_snapshot_material_set_slot(
                    slot.u32(), material.high, material.low))
            try check_status(elisa_render_scene_v1_register_snapshot_material_set(
                asset.high, asset.low, set.count.u32()))

        def unregister_snapshot_material_set(asset: Assets::AssetId) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(asset)
            try check_status(elisa_render_scene_v1_unregister_snapshot_material_set(asset.high, asset.low))

        # A cooked mesh carries the glTF factors authored for its material
        # slots: base color, metallic, roughness, emissive, opaque, masked or
        # blended alpha, sidedness, and the bundle images they sample. The
        # count is 0 when its source declared no materials, so the game
        # supplies each slot's material.
        def snapshot_mesh_material_count(mesh: Assets::AssetId) -> u32 error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(mesh)
            count: i32 = elisa_render_scene_v1_snapshot_mesh_material_count(mesh.high, mesh.low)
            if count < 0:
                try check_status(count)
            count.u32()

        # Copies one cooked material-slot name into bounded UTF-8 storage.
        # Packages without authored names return an empty byte sequence.
        def snapshot_mesh_material_name(mesh: Assets::AssetId, slot: u32,
            name: mutable SnapshotMeshMaterialName&) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(mesh)
            bytes: mutable u8[RenderScene::MAX_SNAPSHOT_MATERIAL_NAME_BYTES] = zeroed
            length: mutable u32 = 0
            status: i32 = elisa_render_scene_v1_snapshot_mesh_material_name(
                mesh.high, mesh.low, slot, &bytes[0], RenderScene::MAX_SNAPSHOT_MATERIAL_NAME_BYTES.u32(), &length)
            if status < 0:
                try check_status(status)
            name <- RenderScene::SnapshotMeshMaterialName{bytes: bytes, length: length.usize()}

        # The number of source mesh/node placements retained by a resident
        # cooked mesh. A legacy flattened package reports zero.
        def snapshot_mesh_placement_count(mesh: Assets::AssetId) -> u32 error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(mesh)
            count: i32 = elisa_render_scene_v1_snapshot_mesh_placement_count(mesh.high, mesh.low)
            if count < 0:
                try check_status(count)
            count.u32()

        # Reads one source placement in cooker order. Its transform is the
        # affine world transform baked into the flattened vertex payload.
        def snapshot_mesh_placement(mesh: Assets::AssetId, index: u32,
            placement: mutable SnapshotMeshPlacement&) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(mesh)
            status: i32 = elisa_render_scene_v1_snapshot_mesh_placement(
                mesh.high, mesh.low, index, placement.mesh_index, placement.node_index)
            if status < 0:
                try check_status(status)
            for component in 0..<RenderScene::SNAPSHOT_MESH_PLACEMENT_COMPONENTS |placement|:
                placement.transform[component] <- elisa_render_scene_v1_snapshot_mesh_placement_component(
                    mesh.high, mesh.low, index, component.u32())

        # The number of images a cooked mesh's slot materials sample.
        def snapshot_mesh_texture_count(mesh: Assets::AssetId) -> u32 error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(mesh)
            count: i32 = elisa_render_scene_v1_snapshot_mesh_texture_count(mesh.high, mesh.low)
            if count < 0:
                try check_status(count)
            count.u32()

        # Registers image `index` of a resident cooked mesh as bundle texture
        # `texture`, read from the mesh's own bundle, with the usual no-op and
        # conflict rules. A slot material that samples an image needs it
        # registered first, under exactly one ID.
        def register_snapshot_mesh_texture(mesh: Assets::AssetId, index: u32,
            texture: Assets::AssetId) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(mesh)
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(texture)
            try check_status(elisa_render_scene_v1_register_snapshot_mesh_texture(
                mesh.high, mesh.low, index, texture.high, texture.low))

        # Registers the material cooked for one slot of a resident mesh as an
        # ordinary material, with the usual no-op and conflict rules.
        def register_snapshot_mesh_material(mesh: Assets::AssetId, slot: u32,
            material: Assets::AssetId) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(mesh)
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(material)
            try check_status(elisa_render_scene_v1_register_snapshot_mesh_material(
                mesh.high, mesh.low, slot, material.high, material.low))

        # Registers every cooked slot material of a mesh under the IDs in
        # `materials`, in slot order, and those IDs as material set `set`.
        # The set must list one ID per cooked slot. A failure leaves no
        # material registered that this call created.
        def register_snapshot_mesh_materials(mesh: Assets::AssetId, materials: SnapshotMaterialSet&,
            set: Assets::AssetId) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(mesh)
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(set)
            raise RenderSceneError.InvalidValue if materials.count == 0
            for slot in 0..<materials.count |materials|:
                material: Assets::AssetId = materials.materials[slot]
                try check_status(elisa_render_scene_v1_stage_snapshot_material_set_slot(
                    slot.u32(), material.high, material.low))
            try check_status(elisa_render_scene_v1_register_snapshot_mesh_material_set(
                mesh.high, mesh.low, set.high, set.low, materials.count.u32()))

        # Asynchronous registration. A request returns without file IO; a
        # worker thread resolves the path, checks the bundle's dependencies
        # and reads the asset. Requesting a loading or resident ID again with
        # the same path is a no-op, and requesting a failed one retries it.
        # Unregistering a loading ID cancels it.
        def request_snapshot_mesh_asset(asset: Assets::AssetId,
            package_path: cstr) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(asset)
            try check_status(elisa_render_scene_v1_request_snapshot_mesh_asset(
                asset.high, asset.low, package_path))

        # Larger priorities start first while work is queued. Running jobs
        # finish; requesting a pending ID again updates its queued priority.
        def request_snapshot_mesh_asset_prioritized(asset: Assets::AssetId,
            package_path: cstr, priority: i32) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(asset)
            try check_status(elisa_render_scene_v1_request_snapshot_mesh_asset_with_priority(
                asset.high, asset.low, package_path, priority))

        def request_snapshot_bundle_texture_asset(asset: Assets::AssetId,
            bundle_path: cstr, section: cstr) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(asset)
            try check_status(elisa_render_scene_v1_request_snapshot_bundle_texture_asset(
                asset.high, asset.low, bundle_path, section))

        def request_snapshot_bundle_texture_asset_prioritized(asset: Assets::AssetId,
            bundle_path: cstr, section: cstr, priority: i32) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(asset)
            try check_status(elisa_render_scene_v1_request_snapshot_bundle_texture_asset_with_priority(
                asset.high, asset.low, bundle_path, section, priority))

        # Makes up to `budget` finished loads resident on this thread and
        # returns how many it adopted. Until then a snapshot row naming a
        # loading mesh, or a material naming a loading texture, fails with
        # AssetPending and the previous frame stays live.
        def pump_snapshot_assets(budget: u32) -> u32 error[RenderSceneError]:
            adopted: i32 = elisa_render_scene_v1_pump_snapshot_assets(budget)
            if adopted < 0:
                try check_status(adopted)
            adopted.u32()

        # A failed request raises its failure, AssetLoadFailure or Capacity,
        # until the ID is unregistered or requested again.
        def snapshot_asset_state(kind: SnapshotAssetKind,
            asset: Assets::AssetId) -> SnapshotAssetState error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(asset)
            native_kind: i32 =
                match kind:
                    SnapshotAssetKind.Mesh: NativeSnapshotAsset::MESH
                    SnapshotAssetKind.Texture: NativeSnapshotAsset::TEXTURE
            state: i32 = elisa_render_scene_v1_snapshot_asset_state(native_kind, asset.high, asset.low)
            if state < 0:
                try check_status(state)
            return SnapshotAssetState.Resident if state == NativeSnapshotAsset::RESIDENT
            return SnapshotAssetState.Loading if state == NativeSnapshotAsset::LOADING
            SnapshotAssetState.Absent
