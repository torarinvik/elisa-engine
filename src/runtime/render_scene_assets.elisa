# Asset registration extension for the persistent native snapshot presenter.
# Kept separate from RenderScene's core public surface to avoid importing
# backend material names into primitive-scene clients.
include "../assets/descriptor.elisa"
include "../backend/material.elisa"
include "./render_scene.elisa"

module SnapshotAssetCapabilities:
    # Snapshot materials support registered textures and one packed Wicked
    # surface map; separate occlusion and metallic-roughness maps need cooking.
    public:
        const MATERIAL_TEXTURES_SUPPORTED: bool = true

extend RenderScene:
    private:
        def snapshot_material_textures_supported(material: Material::Material&) -> bool:
            return false if not SnapshotAssetCapabilities::MATERIAL_TEXTURES_SUPPORTED
            return true if not Assets::asset_id_valid(material.metallic_roughness)
            return true if not Assets::asset_id_valid(material.occlusion)
            Assets::same_asset_id(material.metallic_roughness, material.occlusion)

        def snapshot_surface_texture(material: Material::Material&) -> Assets::AssetId:
            return material.metallic_roughness if Assets::asset_id_valid(material.metallic_roughness)
            material.occlusion

        const module NativeAlphaMode:
            OPAQUE: i32 = 0
            MASK: i32 = 1
            BLEND: i32 = 2

        @callconv(c)
        extern elisa_render_scene_v1_register_snapshot_mesh_asset(high: u64, low: u64,
            package_path: cstr) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_unregister_snapshot_mesh_asset(high: u64, low: u64) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_register_snapshot_texture_asset(
            high: u64, low: u64, asset_path: cstr) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_unregister_snapshot_texture_asset(high: u64, low: u64) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_register_snapshot_bundle_texture_asset(
            high: u64, low: u64, bundle_path: cstr, section: cstr) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_register_snapshot_material_asset_with_textures(
            high: u64, low: u64,
            base_color_high: u64, base_color_low: u64,
            normal_high: u64, normal_low: u64,
            surface_high: u64, surface_low: u64,
            emissive_high: u64, emissive_low: u64,
            red: f32, green: f32, blue: f32, alpha: f32,
            metallic: f32, roughness: f32, emissive_red: f32, emissive_green: f32,
            emissive_blue: f32, alpha_cutoff: f32, alpha_mode: i32, double_sided: i32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_unregister_snapshot_material_asset(high: u64, low: u64) -> i32

    public:
        # Snapshot IDs resolve to shared cooked geometry and backend-neutral
        # PBR factors. Registration is owner-thread-only and idempotent for an
        # unchanged ID/path or ID/material pair.
        def register_snapshot_mesh_asset(asset: Assets::AssetId,
            package_path: cstr) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(asset)
            try check_status(elisa_render_scene_v1_register_snapshot_mesh_asset(
                asset.high, asset.low, package_path))

        def unregister_snapshot_mesh_asset(asset: Assets::AssetId) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(asset)
            try check_status(elisa_render_scene_v1_unregister_snapshot_mesh_asset(asset.high, asset.low))

        def register_snapshot_texture_asset(asset: Assets::AssetId,
            asset_path: cstr) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(asset)
            try check_status(elisa_render_scene_v1_register_snapshot_texture_asset(
                asset.high, asset.low, asset_path))

        # A PNG or JPEG section of a cooked ELPK bundle. The section is
        # CRC-checked and its image dimensions bounded at registration; the
        # image decodes when a material that references it registers.
        def register_snapshot_bundle_texture_asset(asset: Assets::AssetId,
            bundle_path: cstr, section: cstr) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(asset)
            try check_status(elisa_render_scene_v1_register_snapshot_bundle_texture_asset(
                asset.high, asset.low, bundle_path, section))

        def unregister_snapshot_texture_asset(asset: Assets::AssetId) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(asset)
            try check_status(elisa_render_scene_v1_unregister_snapshot_texture_asset(asset.high, asset.low))

        def register_snapshot_material_asset(asset: Assets::AssetId,
            material: Material::Material&) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(asset)
            raise RenderSceneError.InvalidValue if not Material::material_valid(material)
            raise RenderSceneError.InvalidValue if not snapshot_material_textures_supported(material)
            alpha_mode: i32 =
                match material.alpha_mode:
                    Material::AlphaMode.Opaque: NativeAlphaMode::OPAQUE
                    Material::AlphaMode.Mask: NativeAlphaMode::MASK
                    Material::AlphaMode.Blend: NativeAlphaMode::BLEND
            double_sided: i32 = 1 if material.double_sided else 0
            surface_texture: Assets::AssetId = snapshot_surface_texture(material)
            try check_status(elisa_render_scene_v1_register_snapshot_material_asset_with_textures(
                asset.high, asset.low,
                material.base_color.high, material.base_color.low,
                material.normal.high, material.normal.low,
                surface_texture.high, surface_texture.low,
                material.emissive.high, material.emissive.low,
                material.base_color_factor[0], material.base_color_factor[1],
                material.base_color_factor[2], material.base_color_factor[3],
                material.metallic_factor, material.roughness_factor,
                material.emissive_factor[0], material.emissive_factor[1],
                material.emissive_factor[2], material.alpha_cutoff, alpha_mode, double_sided))

        def unregister_snapshot_material_asset(asset: Assets::AssetId) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(asset)
            try check_status(elisa_render_scene_v1_unregister_snapshot_material_asset(asset.high, asset.low))
