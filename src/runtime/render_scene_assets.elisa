# Asset registration extension for the persistent native snapshot presenter.
# Kept separate from RenderScene's core public surface to avoid importing
# backend material names into primitive-scene clients.
include "../assets/descriptor.elisa"
include "../backend/material.elisa"
include "./render_scene.elisa"

module SnapshotAssetCapabilities:
    # Texture IDs remain rejected by registration until they resolve to
    # uploaded native resources. This can drive feature negotiation in clients.
    public:
        const MATERIAL_TEXTURES_SUPPORTED: bool = false

extend RenderScene:
    private:
        def snapshot_material_textures_supported(material: Material::Material&) -> bool:
            return true if SnapshotAssetCapabilities::MATERIAL_TEXTURES_SUPPORTED
            base_color_empty: bool = not Assets::asset_id_valid(material.base_color)
            normal_empty: bool = not Assets::asset_id_valid(material.normal)
            surface_empty: bool = not Assets::asset_id_valid(material.metallic_roughness)
            occlusion_empty: bool = not Assets::asset_id_valid(material.occlusion)
            emissive_empty: bool = not Assets::asset_id_valid(material.emissive)
            base_color_empty and normal_empty and surface_empty and occlusion_empty and emissive_empty
            true

        const module NativeAlphaMode:
            OPAQUE: i32 = 0
            MASK: i32 = 1
            BLEND: i32 = 2

        @callconv(c)
        extern elisa_render_scene_v1_register_snapshot_mesh_asset(high: u64, low: u64,
            package_path: cstr) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_unregister_snapshot_mesh_asset(high: u64, low: u64) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_register_snapshot_material_asset(
            high: u64, low: u64, red: f32, green: f32, blue: f32, alpha: f32,
            metallic: f32, roughness: f32, emissive_red: f32, emissive_green: f32,
            emissive_blue: f32, alpha_cutoff: f32, alpha_mode: i32, double_sided: i32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_unregister_snapshot_material_asset(high: u64, low: u64) -> i32

    public:
        # Snapshot IDs resolve to shared cooked geometry and backend-neutral
        # PBR factors. Registration is owner-thread-only and idempotent for an
        # unchanged ID/path or ID/material pair.
        def register_snapshot_mesh_asset(asset: Assets::AssetId,
            package_path: cstr) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(asset)
            try check_status(elisa_render_scene_v1_register_snapshot_mesh_asset(
                asset.high, asset.low, package_path))

        def unregister_snapshot_mesh_asset(asset: Assets::AssetId) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(asset)
            try check_status(elisa_render_scene_v1_unregister_snapshot_mesh_asset(asset.high, asset.low))

        def register_snapshot_material_asset(asset: Assets::AssetId,
            material: Material::Material&) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(asset)
            raise RenderSceneError.InvalidValue if not Material::material_valid(&material)
            raise RenderSceneError.InvalidValue if not snapshot_material_textures_supported(&material)
            alpha_mode: i32 =
                match material.alpha_mode:
                    Material::AlphaMode.Opaque: NativeAlphaMode::OPAQUE
                    Material::AlphaMode.Mask: NativeAlphaMode::MASK
                    Material::AlphaMode.Blend: NativeAlphaMode::BLEND
            double_sided: i32 = 1 if material.double_sided else 0
            try check_status(elisa_render_scene_v1_register_snapshot_material_asset(
                asset.high, asset.low,
                material.base_color_factor[0], material.base_color_factor[1],
                material.base_color_factor[2], material.base_color_factor[3],
                material.metallic_factor, material.roughness_factor,
                material.emissive_factor[0], material.emissive_factor[1],
                material.emissive_factor[2], material.alpha_cutoff, alpha_mode, double_sided))

        def unregister_snapshot_material_asset(asset: Assets::AssetId) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Assets::asset_id_valid(asset)
            try check_status(elisa_render_scene_v1_unregister_snapshot_material_asset(asset.high, asset.low))
