# Review and capture controls extend the public application surface without
# making the core lifecycle module carry optional automation policy.
include "./application.elisa"
include "./application_capture_timing.elisa"

module ApplicationCapture:
    public:
        const API_VERSION: i32 = 1
        const SCREENSHOT_PENDING: i32 = 2
        const SCREENSHOT_COMPLETE: i32 = 0
        const SCREENSHOT_CANCELLED: i32 = 3
        const SCREENSHOT_FAILED: i32 = -1
        const SCREENSHOT_TICKET_NOT_FOUND: i32 = -11
        const SCREENSHOT_DEVICE_LOST: i32 = -12
        const SCREENSHOT_TIMING_UNSUPPORTED: i32 = -10

extend Application:
    private:
        @callconv(c)
        extern elisa_application_v1_environment_value(name: cstr) -> cstr

        @callconv(c)
        extern elisa_application_v1_environment_integer(name: cstr, fallback: i64) -> i64

        @callconv(c)
        extern elisa_application_v1_build_identity() -> i64

        @callconv(c)
        extern elisa_application_v1_save_screenshot(path: cstr) -> i32

        @callconv(c)
        extern elisa_application_v1_request_screenshot(path: cstr, ticket: mutable u64&) -> i32

        @callconv(c)
        extern elisa_application_v1_poll_screenshot(ticket: u64, frame_count: mutable u64&,
            width: mutable u32&, height: mutable u32&) -> i32

        @callconv(c)
        extern elisa_application_v1_cancel_screenshot(ticket: u64) -> i32

        @callconv(c)
        extern elisa_application_v1_screenshot_gpu_ticks(ticket: u64, ticks: mutable u64&,
            frequency: mutable u64&) -> i32

        @callconv(c)
        extern elisa_application_v1_presented_width() -> i64

        @callconv(c)
        extern elisa_application_v1_presented_height() -> i64

        @callconv(c)
        extern elisa_application_v1_read_rgba(out: mutable void&, capacity: i64) -> i64

    public:
        def environment_value(name: cstr) -> cstr:
            elisa_application_v1_environment_value(name)

        def environment_integer(name: cstr, fallback: i64) -> i64:
            elisa_application_v1_environment_integer(name, fallback)

        # Zero identifies a direct native build not made through the project
        # runner; runner-built apps carry a provenance-linked identity.
        def build_identity() -> i64:
            elisa_application_v1_build_identity()

        def save_screenshot(path: cstr) -> bool:
            elisa_application_v1_save_screenshot(path) == Application::NativeStatus::OK

        def request_screenshot(path: cstr, ticket: mutable u64&) -> bool:
            elisa_application_v1_request_screenshot(path, ticket) == Application::NativeStatus::OK

        def poll_screenshot(ticket: u64, frame_count: mutable u64&, width: mutable u32&,
            height: mutable u32&) -> i32:
            elisa_application_v1_poll_screenshot(ticket, frame_count, width, height)

        def cancel_screenshot(ticket: u64) -> bool:
            elisa_application_v1_cancel_screenshot(ticket) == Application::NativeStatus::OK

        # GPU nanoseconds of the copy behind the most recently completed
        # ticket, read back through the capture's own fence; a negative
        # status instead (SCREENSHOT_TIMING_UNSUPPORTED without timestamps).
        def screenshot_gpu_nanoseconds(ticket: u64) -> i64:
            ticks: mutable u64 = 0
            frequency: mutable u64 = 0
            status: i32 = elisa_application_v1_screenshot_gpu_ticks(ticket, &ticks, &frequency)
            return i64(status) if status != Application::NativeStatus::OK
            i64(ApplicationCaptureTiming::ticks_to_nanoseconds(ticks, frequency))

        # Last presented frame as RGBA8, top row first, sized to
        # `presented_width` x `presented_height` (plan M01 backdrop). False
        # before the first frame.
        def read_presented(out: mutable darray[u8]&) -> bool:
            n: i64 = elisa_application_v1_presented_width() * elisa_application_v1_presented_height() * 4
            return false if n <= 0
            out.clear()
            for _ in 0..<n.usize():
                out.push(0)
            elisa_application_v1_read_rgba((&out[0]).cast[mutable void&], n) == n

        def presented_width() -> i64:
            elisa_application_v1_presented_width()

        def presented_height() -> i64:
            elisa_application_v1_presented_height()
