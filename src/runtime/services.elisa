            raise RuntimeServicesError.SessionStopped if not session.application_live
            raise RuntimeServicesError.PhysicsUnavailable if not PhysicsRuntime::service_is_live(session.physics)
            try PhysicsQueries::service_overlap_capsule(session.physics, base, tip, radius, layer_mask)

        def physics_overlap_capsule_all(session: Session&, base: Geometry::Vec3,
            tip: Geometry::Vec3, radius: f32, layer_mask: u32,
            buffer: mutable PhysicsQueries::ShapeHitBuffer&) -> usize error[RuntimeServicesError, PhysicsRuntime::PhysicsError]:
            raise RuntimeServicesError.SessionStopped if not session.application_live
            raise RuntimeServicesError.PhysicsUnavailable if not PhysicsRuntime::service_is_live(session.physics)
            try PhysicsQueries::service_overlap_capsule_all(session.physics, base, tip, radius,
                layer_mask, buffer)

        def physics_poll_contacts(session: Session&, buffer: PhysicsRuntime::ContactBuffer&,
            dropped: mutable u32&) -> usize error[RuntimeServicesError, PhysicsRuntime::PhysicsError]:
            raise RuntimeServicesError.SessionStopped if not session.application_live
            raise RuntimeServicesError.PhysicsUnavailable if not PhysicsRuntime::service_is_live(session.physics)
            try PhysicsRuntime::service_poll_contacts(session.physics, buffer, dropped)

        def physics_set_layer_collision(session: Session&, layer_a: u32,
            layer_b: u32, enabled: bool) -> void error[RuntimeServicesError, PhysicsRuntime::PhysicsError]:
            raise RuntimeServicesError.SessionStopped if not session.application_live
