        def physics_body_destroy(session: Session&, body: PhysicsRuntime::BodyHandle) -> void error[RuntimeServicesError, PhysicsRuntime::PhysicsError]:
            raise RuntimeServicesError.SessionStopped if not session.application_live
            raise RuntimeServicesError.PhysicsUnavailable if not PhysicsRuntime::service_is_live(session.physics)
            try PhysicsRuntime::service_body_destroy(session.physics, body)

        def shutdown(session: mutable Session&) -> bool:
            close_state(session)
