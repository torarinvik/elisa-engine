            direction: Geometry::Vec3, max_distance: f32, radius: f32,
            layer_mask: u32) -> PhysicsQueries::ShapeHit error[RuntimeServicesError, PhysicsRuntime::PhysicsError]:
            raise RuntimeServicesError.SessionStopped if not session.application_live
            raise RuntimeServicesError.PhysicsUnavailable if not PhysicsRuntime::service_is_live(session.physics)
            try PhysicsQueries::service_sphere_cast(session.physics, center, direction,
                max_distance, radius, layer_mask)

        def physics_capsule_cast(session: Session&, base: Geometry::Vec3,
            tip: Geometry::Vec3, direction: Geometry::Vec3, max_distance: f32,
            radius: f32, layer_mask: u32) -> PhysicsQueries::ShapeHit error[RuntimeServicesError, PhysicsRuntime::PhysicsError]:
            raise RuntimeServicesError.SessionStopped if not session.application_live
            raise RuntimeServicesError.PhysicsUnavailable if not PhysicsRuntime::service_is_live(session.physics)
            try PhysicsQueries::service_capsule_cast(session.physics, base, tip, direction,
                max_distance, radius, layer_mask)

        def physics_overlap_sphere(session: Session&, center: Geometry::Vec3,
            radius: f32, layer_mask: u32) -> PhysicsQueries::ShapeHit error[RuntimeServicesError, PhysicsRuntime::PhysicsError]:
            raise RuntimeServicesError.SessionStopped if not session.application_live
            raise RuntimeServicesError.PhysicsUnavailable if not PhysicsRuntime::service_is_live(session.physics)
            try PhysicsQueries::service_overlap_sphere(session.physics, center, radius, layer_mask)

        def physics_overlap_sphere_all(session: Session&, center: Geometry::Vec3,
