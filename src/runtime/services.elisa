# Own the Application host and activate engine-owned service fallbacks selected
# by the validated startup report. Provider-specific handles stay encapsulated.
include "./application.elisa"
include "./clock.elisa"
include "../backend/requirements.elisa"
include "../physics/runtime.elisa"
include "../physics/queries.elisa"
include "../audio/runtime.elisa"

module RuntimeServices:
    public:
        enum OpenStatus:
            Ready
            FallbackRequired
            SessionAlreadyOpen
            ApplicationAlreadyRunning
            InvalidRequirements
            RequirementsUnavailable
            ApplicationInitializationFailed
            ProviderInitializationFailed
            PhysicsInitializationFailed
            AudioConfigurationInvalid
            AudioDeviceUnavailable
            AudioInitializationFailed
            UnsupportedProvider
            RollbackFailed

        error RuntimeServicesError:
            PhysicsUnavailable
            AudioUnavailable
            AudioRecoveryFailed
            SessionStopped
            FrameUnavailable
            ShutdownFailed

        # A frame contributes elapsed time to the fixed simulation clock.
        # Callers execute their validated system plan `steps` times, then use
        # `interpolation` for presentation between committed ticks.
        struct SimulationFrame:
            steps: usize
            tick_count: i64
            interpolation: f32

        # Provider and host ownership stay inside this affine public value.
        affine struct Session:
            private:
                physics: mutable PhysicsRuntime::ServiceState
                simulation_clock: mutable Runtime::StepClock
                audio_live: mutable bool
                audio_provider: mutable Capabilities::BackendFallbackProvider
                application_live: mutable bool

    private:
        enum ActivationStatus:
            Ready
            PhysicsOwnerUnavailable
            PhysicsInitializationFailed
            AudioConfigurationInvalid
            AudioDeviceUnavailable
            AudioInitializationFailed
            UnsupportedProvider

        # Tear down adapters before the host they use. Retain any live flag
        # whose shutdown fails so callers can retry cleanup while its host is
        # still available.
        def close_state(session: mutable Session&) -> bool:
            audio_closed: mutable bool = true
            physics_closed: mutable bool = true
            application_closed: mutable bool = true
            if session.audio_live:
                audio_closed <- catch AudioRuntime::shutdown():
                    ok: true
                    error failure: false
                session.audio_live <- false if audio_closed
                session.audio_provider <- Capabilities::BackendFallbackProvider.None if audio_closed
            if PhysicsRuntime::service_is_live(session.physics):
                physics_closed <- catch PhysicsRuntime::service_shutdown(&session.physics):
                    ok: true
                    error failure: false
            if session.application_live:
                application_closed <- Application::shutdown()
                if application_closed:
                    session.application_live <- false
                    session.audio_live <- false
                    session.audio_provider <- Capabilities::BackendFallbackProvider.None
                    PhysicsRuntime::service_reset(&session.physics)
                    session.simulation_clock <- Runtime::StepClock()
                    return true
            audio_closed and physics_closed and application_closed

        def fallback_is_accepted_by_session(decision: Capabilities::BackendFeatureDecision) -> bool:
            return true if decision.fallback_provider == Capabilities::BackendFallbackProvider.CallerDefined
            if decision.feature == Capabilities::BackendFeature.Physics:
                return decision.fallback_provider == Capabilities::BackendFallbackProvider.JoltPhysics
            if decision.feature == Capabilities::BackendFeature.Audio:
                return decision.fallback_provider == Capabilities::BackendFallbackProvider.MiniaudioSilent or decision.fallback_provider == Capabilities::BackendFallbackProvider.MiniaudioDefault
            false

        def activate_silent_audio(sample_rate: u32, channels: u32) -> ActivationStatus:
            catch AudioRuntime::initialize_silent(sample_rate, channels):
                ok: ActivationStatus.Ready
                AudioRuntime::AudioError.InvalidArgument: ActivationStatus.AudioConfigurationInvalid
                AudioRuntime::AudioError.DeviceUnavailable: ActivationStatus.AudioDeviceUnavailable
                error failure: ActivationStatus.AudioInitializationFailed

        def activate_default_audio(sample_rate: u32, channels: u32) -> ActivationStatus:
            catch AudioRuntime::initialize_default(sample_rate, channels):
                ok: ActivationStatus.Ready
                AudioRuntime::AudioError.InvalidArgument: ActivationStatus.AudioConfigurationInvalid
                AudioRuntime::AudioError.DeviceUnavailable: ActivationStatus.AudioDeviceUnavailable
                error failure: ActivationStatus.AudioInitializationFailed

        def activate_provider(session: mutable Session&,
            decision: Capabilities::BackendFeatureDecision,
            sample_rate: u32, channels: u32) -> ActivationStatus:
            # CallerDefined is owned by gameplay, so preserve its typed report
            # and let the caller initialize it after Session::open returns.
            return ActivationStatus.Ready if decision.fallback_provider == Capabilities::BackendFallbackProvider.CallerDefined
            if decision.feature == Capabilities::BackendFeature.Physics:
                return ActivationStatus.Ready if PhysicsRuntime::service_is_live(session.physics)
                initialized: ActivationStatus = catch PhysicsRuntime::service_initialize(
                    &session.physics):
                    ok: ActivationStatus.Ready
                    PhysicsRuntime::PhysicsError.ApplicationUnavailable: ActivationStatus.PhysicsOwnerUnavailable
                    error failure: ActivationStatus.PhysicsInitializationFailed
                if initialized == ActivationStatus.Ready:
                    return ActivationStatus.Ready
                return initialized
            if decision.feature == Capabilities::BackendFeature.Audio:
                return ActivationStatus.AudioConfigurationInvalid if sample_rate < AudioRuntime::MIN_SAMPLE_RATE_HZ
                requested: ActivationStatus =
                    match decision.fallback_provider:
                        Capabilities::BackendFallbackProvider.MiniaudioSilent:
                            activate_silent_audio(sample_rate, channels)
                        Capabilities::BackendFallbackProvider.MiniaudioDefault:
                            activate_default_audio(sample_rate, channels)
                        _:
                            ActivationStatus.UnsupportedProvider
                # A missing default output device is not a reason to tear the
                # host down and reinitialize it: keep the session live on the
                # silent device, as runtime device loss already does, and
                # record that route so callers and reports can see it.
                default_requested: bool = decision.fallback_provider == Capabilities::BackendFallbackProvider.MiniaudioDefault
                silent_route: bool = default_requested and requested == ActivationStatus.AudioDeviceUnavailable
                status: ActivationStatus = activate_silent_audio(sample_rate, channels) if silent_route else requested
                if status == ActivationStatus.Ready:
                    session.audio_live <- true
                    session.audio_provider <- Capabilities::BackendFallbackProvider.MiniaudioSilent if silent_route else decision.fallback_provider
                return status
            ActivationStatus.UnsupportedProvider

        def open_status_for_activation(status: ActivationStatus) -> OpenStatus:
            match status:
                ActivationStatus.Ready:
                    OpenStatus.Ready
                ActivationStatus.PhysicsOwnerUnavailable:
                    OpenStatus.ProviderInitializationFailed
                ActivationStatus.PhysicsInitializationFailed:
                    OpenStatus.PhysicsInitializationFailed
                ActivationStatus.AudioConfigurationInvalid:
                    OpenStatus.AudioConfigurationInvalid
                ActivationStatus.AudioDeviceUnavailable:
                    OpenStatus.AudioDeviceUnavailable
                ActivationStatus.AudioInitializationFailed:
                    OpenStatus.AudioInitializationFailed
                ActivationStatus.UnsupportedProvider:
                    OpenStatus.UnsupportedProvider

        def require_audio(session: Session&) -> void error[RuntimeServicesError]:
            raise RuntimeServicesError.SessionStopped if not session.application_live
            raise RuntimeServicesError.AudioUnavailable if not session.audio_live

    public:
        # The inert affine value owns no native resources. `open` performs all
        # fallible startup work explicitly, avoiding a fallible affine return.
        def Session() -> Session:
            Session{
                physics: PhysicsRuntime::ServiceState(),
                simulation_clock: Runtime::StepClock(),
                audio_live: false,
                audio_provider: Capabilities::BackendFallbackProvider.None,
                application_live: false,
            }

        def open(session: mutable Session&, config: Application::Config,
            requirements: BackendRequirements::BackendStartupRequirements&,
            audio_sample_rate: u32, audio_channels: u32,
            report: mutable BackendRequirements::BackendRequirementsReport&) -> OpenStatus:
            report <- BackendRequirements::backend_requirements_invalid_report()
            return OpenStatus.SessionAlreadyOpen if session.application_live
            session.audio_live <- false
            session.audio_provider <- Capabilities::BackendFallbackProvider.None

            opened: Application::InitializeStatus = Application::initialize_with_profile_requirements(
                config, requirements, report)
            if opened == Application::InitializeStatus.AlreadyRunning:
                return OpenStatus.ApplicationAlreadyRunning
            if opened == Application::InitializeStatus.InvalidRequirements:
                return OpenStatus.InvalidRequirements
            if opened == Application::InitializeStatus.RequirementsUnavailable:
                return OpenStatus.RequirementsUnavailable
            if opened == Application::InitializeStatus.ShutdownFailed:
                session.application_live <- true
                return OpenStatus.RollbackFailed if not close_state(session)
                return OpenStatus.ApplicationInitializationFailed
            return OpenStatus.ApplicationInitializationFailed if opened != Application::InitializeStatus.Ready and opened != Application::InitializeStatus.FallbackRequired
            session.application_live <- true
            session.simulation_clock <- Runtime::StepClock()

            provider_failure: mutable OpenStatus = OpenStatus.Ready
            for index in 0..<report.services.decision_count |session, audio_sample_rate, audio_channels, provider_failure|:
                if provider_failure == OpenStatus.Ready:
                    decision: Capabilities::BackendFeatureDecision = report.services.decisions[index]
                    if decision.resolution == Capabilities::BackendFeatureResolution.DeclaredFallback:
                        if not fallback_is_accepted_by_session(decision):
                            provider_failure <- OpenStatus.UnsupportedProvider
                        else:
                            activation: ActivationStatus = activate_provider(session, decision,
                                audio_sample_rate, audio_channels)
                            if activation != ActivationStatus.Ready:
                                provider_failure <- open_status_for_activation(activation)

            if provider_failure != OpenStatus.Ready:
                return OpenStatus.RollbackFailed if not close_state(session)
                return provider_failure

            return OpenStatus.FallbackRequired if opened == Application::InitializeStatus.FallbackRequired
            OpenStatus.Ready

        def physics_active(session: Session&) -> bool:
            PhysicsRuntime::service_is_live(session.physics)

        def audio_active(session: Session&) -> bool:
            session.application_live and session.audio_live

        # The provider may change after a default output device is lost. Keep
        # the active route observable instead of leaving the startup report as
        # the only description of audio ownership.
        def audio_provider(session: Session&) -> Capabilities::BackendFallbackProvider:
            session.audio_provider

        def recover_audio_if_needed(session: mutable Session&) -> bool:
            return true if not session.audio_live
            requested: bool = catch AudioRuntime::take_device_recovery_request():
                value: value
                error failure: false
            return true if not requested
            recovered: bool = catch AudioRuntime::recover_with_silent_device():
                ok: true
                error failure: false
            if recovered:
                session.audio_provider <- Capabilities::BackendFallbackProvider.MiniaudioSilent
                return true
            session.audio_live <- false
            session.audio_provider <- Capabilities::BackendFallbackProvider.None
            false

        # Advance the fixed-step clock once per rendered frame. The returned
        # batch is the contract between frame pacing and the game's validated
        # Executor plan: run that plan once for each due tick, then present
        # using the fractional remainder.
        def advance_simulation(session: mutable Session&,
            elapsed_micros: i64) -> SimulationFrame error[RuntimeServicesError, Runtime::ClockError]:
            raise RuntimeServicesError.SessionStopped if not session.application_live
            steps: usize = try Runtime::advance(&session.simulation_clock, elapsed_micros)
            SimulationFrame{
                steps: steps,
                tick_count: session.simulation_clock.tick_count,
                interpolation: Runtime::interpolation_fraction(session.simulation_clock),
            }

        # Route game audio operations through the owner that selected and
        # activated the startup provider. Handles remain opaque values;
        # provider cleanup still occurs before Application shutdown.
        def audio_decode_file(session: Session&, path: cstr) -> AudioRuntime::ClipHandle error[RuntimeServicesError, AudioRuntime::AudioError]:
            try require_audio(session)
            try AudioRuntime::decode_file(path)

        def audio_play(session: Session&, clip: AudioRuntime::ClipHandle,
            looped: bool, bus: AudioRuntime::Bus, gain: f32,
            priority: u32) -> AudioRuntime::VoiceHandle error[RuntimeServicesError, AudioRuntime::AudioError]:
            try require_audio(session)
            try AudioRuntime::play(clip, looped, bus, gain, priority)

        def audio_stop(session: Session&,
            voice: AudioRuntime::VoiceHandle) -> void error[RuntimeServicesError, AudioRuntime::AudioError]:
            try require_audio(session)
            try AudioRuntime::stop(voice)

        def audio_set_voice_spatial(session: Session&, voice: AudioRuntime::VoiceHandle,
            gain: f32, pitch_ratio: f32) -> void error[RuntimeServicesError, AudioRuntime::AudioError]:
            try require_audio(session)
            try AudioRuntime::set_voice_spatial(voice, gain, pitch_ratio)

        def audio_set_bus_gain(session: Session&, bus: AudioRuntime::Bus,
            gain: f32) -> void error[RuntimeServicesError, AudioRuntime::AudioError]:
            try require_audio(session)
            try AudioRuntime::set_bus_gain(bus, gain)

        def audio_active_voice_count(session: Session&) -> usize error[RuntimeServicesError, AudioRuntime::AudioError]:
            # Keep each nested service error intact in the combined public set.
            session_status: i32 = catch require_audio(session):
                value: 0
                RuntimeServicesError.SessionStopped: 1
                RuntimeServicesError.AudioUnavailable: 2
                error failure: 3
            raise RuntimeServicesError.SessionStopped if session_status == 1
            raise RuntimeServicesError.AudioUnavailable if session_status != 0
            AudioRuntime::active_voice_count()

        # Keep the native host lifecycle behind the same owner as its
        # provider fallbacks. These wrappers intentionally preserve the
        # Application statuses while rejecting use after session shutdown.
        def pump(session: mutable Session&) -> Application::PumpStatus error[RuntimeServicesError]:
            raise RuntimeServicesError.SessionStopped if not session.application_live
            status: Application::PumpStatus = Application::pump()
            raise RuntimeServicesError.AudioRecoveryFailed if not recover_audio_if_needed(session)
            status

        def frame_info(session: Session&) -> Application::FrameInfo error[RuntimeServicesError]:
            raise RuntimeServicesError.SessionStopped if not session.application_live
            info: mutable Application::FrameInfo = zeroed
            raise RuntimeServicesError.FrameUnavailable if not Application::frame_info(&info)
            info

        def request_exit(session: Session&) -> bool error[RuntimeServicesError]:
            raise RuntimeServicesError.SessionStopped if not session.application_live
            Application::request_exit()

        def physics_fixed_step(session: mutable Session&, delta_seconds: f32) -> u64 error[RuntimeServicesError, PhysicsRuntime::PhysicsError]:
            raise RuntimeServicesError.SessionStopped if not session.application_live
            raise RuntimeServicesError.PhysicsUnavailable if not PhysicsRuntime::service_is_live(session.physics)
            try PhysicsRuntime::service_fixed_step(&session.physics, delta_seconds)

        def physics_raycast(session: Session&, origin: Geometry::Vec3,
            direction: Geometry::Vec3, max_distance: f32, layer_mask: u32) -> PhysicsRuntime::RayHit error[RuntimeServicesError, PhysicsRuntime::PhysicsError]:
            raise RuntimeServicesError.SessionStopped if not session.application_live
            raise RuntimeServicesError.PhysicsUnavailable if not PhysicsRuntime::service_is_live(session.physics)
            try PhysicsRuntime::service_raycast(session.physics, origin, direction,
                max_distance, layer_mask)

        def physics_raycast_all(session: Session&, origin: Geometry::Vec3,
            direction: Geometry::Vec3, max_distance: f32, layer_mask: u32,
            buffer: mutable PhysicsRuntime::RayHitBuffer&) -> usize error[RuntimeServicesError, PhysicsRuntime::PhysicsError]:
            raise RuntimeServicesError.SessionStopped if not session.application_live
            raise RuntimeServicesError.PhysicsUnavailable if not PhysicsRuntime::service_is_live(session.physics)
            try PhysicsRuntime::service_raycast_all(session.physics, origin, direction,
                max_distance, layer_mask, buffer)

