# Reconcile one checked Elisa frame snapshot with a persistent Wicked scene.
# Handles and the per-presenter ownership table remain private to RenderScene.
include "../backend/render_snapshot.elisa"

extend RenderScene:
    private:
        const module SnapshotLimits:
            MAX_BINDINGS: usize = RenderScene::MAX_SNAPSHOT_ENTRIES
            INVALID_SLOT: usize = MAX_BINDINGS

        struct SnapshotBinding:
            gameplay: World::EntityRef
            render_id: i64
            visual: Assets::VisualAsset
            handle: InstanceHandle

    public:
        affine struct SnapshotPresenter:
            private:
                bindings: mutable SnapshotBinding[SnapshotLimits::MAX_BINDINGS]
                count: mutable usize

        def SnapshotPresenter() -> SnapshotPresenter:
            SnapshotPresenter{bindings: zeroed, count: 0}

        def snapshot_binding_count(presenter: SnapshotPresenter&) -> usize:
            presenter.count

    private:
        def snapshot_binding_slot(presenter: SnapshotPresenter&, render_id: i64) -> usize:
            for index in 0..<presenter.count |slot: usize = SnapshotLimits::INVALID_SLOT| -> slot:
                break index if presenter.bindings[index].render_id == render_id

        def snapshot_retains(snapshot: RenderSnapshot::Snapshot&, binding: SnapshotBinding) -> bool:
            for index in 0..<RenderSnapshot::snapshot_count(snapshot) |retained: bool = false| -> retained:
                entry: RenderSnapshot::Entry = RenderSnapshot::snapshot_entry(snapshot, index)
                same_mesh: bool = Assets::same_asset_id(entry.visual.mesh, binding.visual.mesh)
                same_material: bool = Assets::same_asset_id(entry.visual.material, binding.visual.material)
                retained <- true if entry.render_id == binding.render_id and same_mesh and same_material

        def snapshot_stage_row(entry: RenderSnapshot::Entry, existing_handle: i64) -> i32:
            elisa_render_scene_v1_snapshot_stage(existing_handle,
                entry.gameplay.world_epoch, entry.gameplay.id, entry.render_id,
                entry.visual.mesh.high, entry.visual.mesh.low,
                entry.visual.material.high, entry.visual.material.low,
                entry.transform.position.x, entry.transform.position.y, entry.transform.position.z,
                entry.transform.rotation.x, entry.transform.rotation.y,
                entry.transform.rotation.z, entry.transform.rotation.w,
                entry.transform.scale.x, entry.transform.scale.y, entry.transform.scale.z)

        def snapshot_abort_after(status: i32) -> void error[RenderSceneError]:
            _ = elisa_render_scene_v1_snapshot_abort()
            try check_status(status)

    public:
        # Stage all rows and removals before the native scene changes. Native
        # creation failures discard every newly staged entity and preserve the
        # presenter’s previous frame.
        def sync_snapshot(presenter: mutable SnapshotPresenter&,
            snapshot: RenderSnapshot::Snapshot&) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not RenderSnapshot::snapshot_valid(snapshot)
            raise RenderSceneError.Capacity if RenderSnapshot::snapshot_count(snapshot) > SnapshotLimits::MAX_BINDINGS
            try check_status(elisa_render_scene_v1_snapshot_begin(presenter.count.u32()))

            for index in 0..<RenderSnapshot::snapshot_count(snapshot) |presenter, snapshot|:
                entry: RenderSnapshot::Entry = RenderSnapshot::snapshot_entry(snapshot, index)
                old_slot: usize = snapshot_binding_slot(presenter, entry.render_id)
                existing_handle: mutable i64 = 0
                if old_slot != SnapshotLimits::INVALID_SLOT:
                    old: SnapshotBinding = presenter.bindings[old_slot]
                    same_mesh: bool = Assets::same_asset_id(old.visual.mesh, entry.visual.mesh)
                    same_material: bool = Assets::same_asset_id(old.visual.material, entry.visual.material)
                    if same_mesh and same_material:
                        existing_handle <- old.handle.native_value
                stage_status: i32 = snapshot_stage_row(entry, existing_handle)
                if stage_status != NativeStatus::OK:
                    try snapshot_abort_after(stage_status)

            for index in 0..<presenter.count |presenter, snapshot|:
                old: SnapshotBinding = presenter.bindings[index]
                if not snapshot_retains(snapshot, old):
                    retire_status: i32 = elisa_render_scene_v1_snapshot_retire(old.handle.native_value)
                    if retire_status != NativeStatus::OK:
                        try snapshot_abort_after(retire_status)

            commit_status: i32 = elisa_render_scene_v1_snapshot_commit()
            if commit_status != NativeStatus::OK:
                try snapshot_abort_after(commit_status)

            next_count: usize = RenderSnapshot::snapshot_count(snapshot)
            for index in 0..<next_count |presenter, snapshot|:
                entry: RenderSnapshot::Entry = RenderSnapshot::snapshot_entry(snapshot, index)
                native_handle: i64 = elisa_render_scene_v1_snapshot_result(index.u32())
                raise RenderSceneError.BackendFailure if native_handle <= 0
                presenter.bindings[index] <- SnapshotBinding{
                    gameplay: entry.gameplay,
                    render_id: entry.render_id,
                    visual: entry.visual,
                    handle: InstanceHandle{native_value: native_handle},
                }
            for index in next_count..<presenter.count |presenter|:
                presenter.bindings[index] <- zeroed
            presenter.count <- next_count

        # Clear through the same transaction so a failed native retire leaves
        # both the scene and the caller’s presenter intact.
        def clear_snapshot(presenter: mutable SnapshotPresenter&) -> void error[RenderSceneError]:
            try check_status(elisa_render_scene_v1_snapshot_begin(presenter.count.u32()))
            for index in 0..<presenter.count |presenter|:
                retire_status: i32 = elisa_render_scene_v1_snapshot_retire(presenter.bindings[index].handle.native_value)
                if retire_status != NativeStatus::OK:
                    try snapshot_abort_after(retire_status)
            commit_status: i32 = elisa_render_scene_v1_snapshot_commit()
            if commit_status != NativeStatus::OK:
                try snapshot_abort_after(commit_status)
            for index in 0..<presenter.count |presenter|:
                presenter.bindings[index] <- zeroed
            presenter.count <- 0

module RenderSnapshotScene:
    public:
        def binding_count(presenter: RenderScene::SnapshotPresenter&) -> usize:
            RenderScene::snapshot_binding_count(presenter)

        def sync(presenter: mutable RenderScene::SnapshotPresenter&,
            snapshot: RenderSnapshot::Snapshot&) -> void error[RenderScene::RenderSceneError]:
            try RenderScene::sync_snapshot(presenter, snapshot)

        def clear(presenter: mutable RenderScene::SnapshotPresenter&) -> void error[RenderScene::RenderSceneError]:
            try RenderScene::clear_snapshot(presenter)
