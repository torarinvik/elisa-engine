# Executable half of the schedule. The dependency analysis in schedule.elisa
# says what may run together; this module actually assigns systems to flat
# groups and runs them, recording how often each executed. Groups are built
# greedily in declared order: a system joins the earliest group where it
# conflicts with nothing already there, which preserves the analysis'
# ordering guarantee while exposing the legal concurrency. There is no
# thread pool here; the executor is the serial reference the parallel one
# must match.
include "./schedule.elisa"

module Executor:
    private:
        const module Limits:
            MAX_SYSTEMS: usize = 8
            NO_GROUP: usize = 8

    public:
        error ExecError:
            Capacity
            BadPlan

        struct Plan:
            order: mutable usize[8]
            group: mutable usize[8]
            count: mutable usize
            group_count: mutable usize

        struct Work:
            runs: mutable i64[8]

        # What a dispatched system may touch, plus the executor's own record of
        # the order it ran. Keeping the trace here makes execution observable
        # without the executor knowing anything about the systems.
        struct FrameState:
            visits: mutable i64[8]
            trace: mutable i64[8]
            length: mutable usize

        def frame_state_new() -> FrameState:
            FrameState{visits: zeroed, trace: zeroed, length: 0}

        def Plan() -> Plan:
            Plan{order: zeroed, group: zeroed, count: 0, group_count: 0}

        def Work() -> Work:
            Work{runs: zeroed}

        # Build a plan from an explicit group assignment over systems in
        # declared order. The dependency analysis in schedule.elisa decides
        # which assignment is legal; plan_valid is the guard that a plan a
        # caller supplies has not broken it. Keeping construction and
        # checking separate avoids re-deriving the analysis here.
        def plan_from_groups(groups: usize[8], count: usize) -> Plan error[ExecError]:
            raise ExecError.Capacity if count > Limits::MAX_SYSTEMS
            plan: mutable Plan = Plan{order: zeroed, group: zeroed, count: count, group_count: 0}
            highest: usize =
                for index in 0..<count |top: usize = 0, plan| -> top:
                    plan.order[index] <- index
                    plan.group[index] <- groups[index]
                    top <- groups[index] if groups[index] >= top
            plan.group_count <- highest + 1 if count > 0 else 0
            plan

        # Derive the grouping from the declared read/write sets instead of
        # requiring the caller to supply one. The result is checked by the same
        # plan_valid guard, so a bug in the analysis shows up as a rejected
        # plan rather than a race.
        def plan_auto(systems: Schedule::System[8], count: usize) -> Plan error[ExecError]:
            plan_from_groups(Schedule::assign_groups(systems, count), count)

        # A plan is valid when every group is dense from zero and no group
        # contains a conflicting pair, which is the property a parallel
        # executor would have to preserve.
        def plan_valid(plan: Plan&, systems: Schedule::System[8]) -> bool:
            return false if plan.count > Limits::MAX_SYSTEMS
            for index in 0..<plan.count |plan|:
                return false if plan.group[index] >= plan.group_count
            return false if plan.count > 0 and plan.group_count != max_group(plan) + 1
            groups_ok: bool =
                for left in 0..<plan.count |all_ok: bool = true| -> all_ok:
                    row: bool =
                        for right in 0..<plan.count |row_ok: bool = true| -> row_ok:
                            same: bool = plan.group[left] == plan.group[right]
                            conflicts: bool = left != right and Schedule::systems_conflict(systems[left], systems[right])
                            row_ok <- false if same and conflicts
                    all_ok <- all_ok and row
            groups_ok

        def max_group(plan: Plan&) -> usize:
            for index in 0..<plan.count |highest: usize = 0| -> highest:
                highest <- plan.group[index] if plan.group[index] >= highest

        def plan_run_once(plan: Plan&, work: mutable Work&) -> void error[ExecError]:
            raise ExecError.BadPlan if plan.count > Limits::MAX_SYSTEMS
            for index in 0..<plan.count |work, plan|:
                work.runs[index] <- work.runs[index] + 1

        def plan_run(plan: Plan&, work: mutable Work&, rounds: usize) -> void error[ExecError]:
            for round in 0..<rounds |plan, work|:
                ran: bool =
                    catch plan_run_once(plan, work):
                        ok: true
                        error failure: false
                _ = ran

        # Serial execution order derived from the groups: groups in order, and
        # within a group the systems in declared order. A host or a test can
        # read this without executing anything.
        def plan_sequence(plan: Plan&) -> i64[8]:
            groups: mutable usize[8] = plan.group
            count: mutable usize = plan.count
            group_count: mutable usize = plan.group_count
            sequence: mutable i64[8] = zeroed
            slot: mutable usize = 0
            for group in 0..<group_count |groups, count, group_count, sequence, slot|:
                for index in 0..<count |groups, sequence, slot, group|:
                    if groups[index] == group and slot < 8:
                        sequence[slot] <- index.i64()
                        slot <- slot + 1
            sequence

        # Execute the plan for real: dispatch is called once per system in the
        # sequence above, and the executor records the order it actually ran.
        # Function-value arrays are not supported by the compiler, so a single
        # dispatcher receives the system index rather than one callback per
        # system; that keeps the executor independent of what systems do.
        def plan_execute(plan: Plan&, state: mutable FrameState&, dispatch: fn(mutable FrameState&, usize) -> void) -> void error[ExecError]:
            raise ExecError.BadPlan if plan.count > Limits::MAX_SYSTEMS
            sequence: i64[8] = plan_sequence(plan)
            for slot in 0..<plan.count |state, sequence, dispatch|:
                system: usize = sequence[slot].usize()
                dispatch(state, system)
                if state.length < 8:
                    state.trace[state.length] <- system.i64()
                    state.length <- state.length + 1

        def run_count(work: Work&, system: usize) -> i64:
            return -1 if system >= Limits::MAX_SYSTEMS
            work.runs[system]
