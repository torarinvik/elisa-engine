# Extract bounded render bindings from the checked Elisa world. The render
# snapshot remains a value owned by Elisa; no vendor identity crosses this API.
include "../backend/render_snapshot.elisa"
include "../world/world.elisa"
include "../world/hierarchy.elisa"
include "../world/prefab_world.elisa"
include "../math/geometry.elisa"
include "../assets/descriptor.elisa"

module WorldRendering:
    public:
        const MAX_BINDINGS: usize = 256

        error WorldRenderingError:
            InvalidReference
            InvalidRenderId
            DuplicateRenderId
            Capacity
            InvalidBindings
            InvalidTransform
            SnapshotRejected
            InvalidTint
            UnknownBinding

    private:
        struct BindingRow:
            gameplay: World::EntityRef
            render_id: i64
            visual: Assets::VisualAsset
            local_transform: Geometry::Transform
            tint: RenderSnapshot::Tint

        const module Sentinel:
            INVALID_SLOT: usize = WorldRendering::MAX_BINDINGS
            MAX_RENDER_ID: i64 = 9223372036854775807

        def same_entity(left: World::EntityRef, right: World::EntityRef) -> bool:
            left.world_epoch == right.world_epoch and left.id == right.id

        def binding_slot(bindings: Bindings&, gameplay: World::EntityRef, render_id: i64) -> usize:
            for index in 0..<bindings.count |slot: usize = Sentinel::INVALID_SLOT| -> slot:
                break index if same_entity(bindings.rows[index].gameplay, gameplay) and bindings.rows[index].render_id == render_id

        def bindings_valid(bindings: Bindings&) -> bool:
            return false if bindings.count > WorldRendering::MAX_BINDINGS
            for index in 0..<bindings.count |valid: bool = true| -> valid:
                row: BindingRow = bindings.rows[index]
                valid <- false if row.gameplay.world_epoch <= 0 or row.gameplay.id <= 0 or row.render_id <= 0 or not Assets::visual_asset_valid(row.visual) or not Geometry::transform_is_valid(row.local_transform)
                valid <- false if not RenderSnapshot::tint_valid(row.tint)
                for earlier in 0..<index:
                    valid <- false if bindings.rows[earlier].render_id == row.render_id

        def prune_dead_bindings(world: World::World&, bindings: mutable Bindings&) -> void:
            write: mutable usize = 0
            for read in 0..<bindings.count |world, bindings, write|:
                row: BindingRow = bindings.rows[read]
                if World::world_is_live(world, row.gameplay):
                    bindings.rows[write] <- row
                    write <- write + 1
            for index in write..<bindings.count |bindings|:
                bindings.rows[index] <- zeroed
            bindings.count <- write

        def remove_absent_prefab_rows(bindings: mutable Bindings&, instance: PrefabWorld::Instance&,
            first_id: i64, past_last_id: i64) -> void:
            write: mutable usize = 0
            for read in 0..<bindings.count |bindings, write, first_id, past_last_id, instance|:
                row: BindingRow = bindings.rows[read]
                keep: mutable bool = true
                if row.render_id >= first_id and row.render_id < past_last_id:
                    prefab_slot: usize = (row.render_id - first_id).usize()
                    keep <- PrefabWorld::instance_has_visual_at(instance, prefab_slot)
                if keep:
                    bindings.rows[write] <- row
                    write <- write + 1
            for index in write..<bindings.count |bindings|:
                bindings.rows[index] <- zeroed
            bindings.count <- write

    public:
        affine struct Bindings:
            private:
                rows: mutable BindingRow[WorldRendering::MAX_BINDINGS]
                count: mutable usize

        def Bindings() -> Bindings:
            Bindings{rows: zeroed, count: 0}

        def binding_count(bindings: Bindings&) -> usize:
            bindings.count

        # One gameplay entity may bind several stable render IDs. Rebinding the
        # same pair updates its asset or local attachment transform without
        # growing the bounded table, and keeps its tint. A new binding starts
        # neutral. The entity's world transform stays in World.
        def bind(bindings: mutable Bindings&, world: World::World&, gameplay: World::EntityRef,
            render_id: i64, visual: Assets::VisualAsset,
            local_transform: Geometry::Transform) -> void error[WorldRenderingError]:
            raise WorldRenderingError.InvalidReference if not World::world_is_live(world, gameplay)
            raise WorldRenderingError.InvalidRenderId if render_id <= 0
            raise WorldRenderingError.InvalidBindings if not Assets::visual_asset_valid(visual)
            raise WorldRenderingError.InvalidTransform if not Geometry::transform_is_valid(local_transform)
            slot: usize = binding_slot(bindings, gameplay, render_id)
            if slot < WorldRendering::MAX_BINDINGS:
                bindings.rows[slot].visual <- visual
                bindings.rows[slot].local_transform <- local_transform
                return
            for index in 0..<bindings.count:
                raise WorldRenderingError.DuplicateRenderId if bindings.rows[index].render_id == render_id
            raise WorldRenderingError.Capacity if bindings.count >= WorldRendering::MAX_BINDINGS
            bindings.rows[bindings.count] <- BindingRow{
                gameplay: gameplay,
                render_id: render_id,
                visual: visual,
                local_transform: local_transform,
                tint: RenderSnapshot::tint_neutral(),
            }
            bindings.count <- bindings.count + 1

        # Rebuild one prefab's presentation rows inside a caller-reserved
        # render-ID range. Every authoring slot owns one ID, including slots
        # without visuals, so changing visibility does not renumber later rows.
        def sync_prefab_instance(bindings: mutable Bindings&, world: World::World&,
            instance: PrefabWorld::Instance&, render_id_base: i64) -> void error[WorldRenderingError]:
            raise WorldRenderingError.InvalidBindings if not bindings_valid(bindings)
            raise WorldRenderingError.InvalidReference if not PrefabWorld::valid(instance, world)
            raise WorldRenderingError.InvalidRenderId if render_id_base <= 0 or render_id_base > Sentinel::MAX_RENDER_ID - PrefabWorld::MAX_NODES.i64()
            render_id_end: i64 = render_id_base + PrefabWorld::MAX_NODES.i64()
            stale_count: mutable usize = 0
            for index in 0..<bindings.count:
                row: BindingRow = bindings.rows[index]
                if row.render_id >= render_id_base and row.render_id < render_id_end:
                    prefab_slot: usize = (row.render_id - render_id_base).usize()
                    raise WorldRenderingError.DuplicateRenderId if prefab_slot >= PrefabWorld::instance_binding_count(instance)
                    authoring_id: i64 = PrefabWorld::instance_authoring_id_at(instance, prefab_slot)
                    expected: World::EntityRef = PrefabWorld::instance_reference(instance, authoring_id)
                    raise WorldRenderingError.DuplicateRenderId if not same_entity(row.gameplay, expected)
                    stale_count <- stale_count + 1 if not PrefabWorld::instance_has_visual_at(instance, prefab_slot)
            visible_count: mutable usize = 0
            for index in 0..<PrefabWorld::instance_binding_count(instance) |visible_count|:
                if PrefabWorld::instance_has_visual_at(instance, index):
                    authoring_id: i64 = PrefabWorld::instance_authoring_id_at(instance, index)
                    reference: World::EntityRef = PrefabWorld::instance_reference(instance, authoring_id)
                    visual: Assets::VisualAsset = PrefabWorld::instance_visual_at(instance, index)
                    render_id: i64 = render_id_base + index.i64()
                    raise WorldRenderingError.InvalidReference if not World::world_is_live(world, reference)
                    raise WorldRenderingError.InvalidBindings if not Assets::visual_asset_valid(visual)
                    for row_index in 0..<bindings.count:
                        existing: BindingRow = bindings.rows[row_index]
                        raise WorldRenderingError.DuplicateRenderId if existing.render_id == render_id and not same_entity(existing.gameplay, reference)
                    existing_slot: usize = binding_slot(bindings, reference, render_id)
                    visible_count <- visible_count + 1 if existing_slot == Sentinel::INVALID_SLOT
            final_count: usize = bindings.count - stale_count + visible_count
            raise WorldRenderingError.Capacity if final_count > WorldRendering::MAX_BINDINGS
            remove_absent_prefab_rows(bindings, instance, render_id_base, render_id_end)
            identity: Geometry::Transform = Geometry::transform_identity()
            for index in 0..<PrefabWorld::instance_binding_count(instance):
                if PrefabWorld::instance_has_visual_at(instance, index):
                    authoring_id: i64 = PrefabWorld::instance_authoring_id_at(instance, index)
                    reference: World::EntityRef = PrefabWorld::instance_reference(instance, authoring_id)
                    visual: Assets::VisualAsset = PrefabWorld::instance_visual_at(instance, index)
                    try bind(bindings, world, reference, render_id_base + index.i64(), visual, identity)

        # Presentation-only override for one render ID. It never changes the
        # shared material, so other instances of the same asset are unaffected.
        def set_tint(bindings: mutable Bindings&, gameplay: World::EntityRef, render_id: i64,
            tint: RenderSnapshot::Tint) -> void error[WorldRenderingError]:
            raise WorldRenderingError.InvalidTint if not RenderSnapshot::tint_valid(tint)
            slot: usize = binding_slot(bindings, gameplay, render_id)
            raise WorldRenderingError.UnknownBinding if slot >= bindings.count
            bindings.rows[slot].tint <- tint

        def unbind(bindings: mutable Bindings&, gameplay: World::EntityRef, render_id: i64) -> bool:
            slot: usize = binding_slot(bindings, gameplay, render_id)
            return false if slot >= bindings.count
            for shift in slot..<bindings.count - 1 |bindings|:
                bindings.rows[shift] <- bindings.rows[shift + 1]
            bindings.count <- bindings.count - 1
            bindings.rows[bindings.count] <- zeroed
            true

        # Drop every row, e.g. before rebinding a world swapped in from a save.
        def clear(bindings: mutable Bindings&) -> void:
            for index in 0..<bindings.count |bindings|:
                bindings.rows[index] <- zeroed
            bindings.count <- 0

        # Rebuild into a fresh snapshot after validating the private binding
        # table. Dead or old-world entities are omitted and pruned in place.
        def extract(world: World::World&, bindings: mutable Bindings&,
            snapshot: mutable RenderSnapshot::Snapshot&) -> void error[WorldRenderingError]:
            raise WorldRenderingError.InvalidBindings if not bindings_valid(bindings)
            live_count: mutable usize = 0
            for index in 0..<bindings.count |live_count, world, bindings|:
                live_count <- live_count + 1 if World::world_is_live(world, bindings.rows[index].gameplay)
            raise WorldRenderingError.Capacity if live_count > RenderSnapshot::MAX_ENTRIES
            RenderSnapshot::snapshot_clear(snapshot)
            for index in 0..<bindings.count |world, bindings, snapshot|:
                row: BindingRow = bindings.rows[index]
                if World::world_is_live(world, row.gameplay):
                    transform: mutable Geometry::Transform = Geometry::transform_identity()
                    has_transform: bool = World::world_try_transform(world, row.gameplay, &transform)
                    raise WorldRenderingError.InvalidReference if not has_transform
                    inserted: bool = RenderSnapshot::snapshot_bind_tinted(snapshot,
                        row.gameplay, row.render_id, row.visual,
                        Geometry::transform_compose(transform, row.local_transform), row.tint)
                    raise WorldRenderingError.SnapshotRejected if not inserted
            prune_dead_bindings(world, bindings)

        # Presentation reads the hierarchy's committed interpolation snapshot;
        # it never writes the authoritative World transform or advances the
        # simulation. A dirty or missing hierarchy node is rejected so a
        # render pass cannot publish a mixed-frame pose.
        def extract_hierarchy(world: World::World&, hierarchy: WorldHierarchy::Hierarchy&,
            bindings: mutable Bindings&, alpha: f32,
            snapshot: mutable RenderSnapshot::Snapshot&) -> void error[WorldRenderingError]:
            raise WorldRenderingError.InvalidBindings if not bindings_valid(bindings)
            live_count: mutable usize = 0
            for index in 0..<bindings.count |live_count, world, bindings|:
                live_count <- live_count + 1 if World::world_is_live(world, bindings.rows[index].gameplay)
            raise WorldRenderingError.Capacity if live_count > RenderSnapshot::MAX_ENTRIES
            RenderSnapshot::snapshot_clear(snapshot)
            for index in 0..<bindings.count |world, hierarchy, bindings, snapshot|:
                row: BindingRow = bindings.rows[index]
                if World::world_is_live(world, row.gameplay):
                    authoritative: mutable Geometry::Transform = Geometry::transform_identity()
                    raise WorldRenderingError.InvalidReference if not WorldHierarchy::hierarchy_try_world(
                        hierarchy, row.gameplay.id, &authoritative)
                    sampled: Geometry::Transform = WorldHierarchy::hierarchy_sample(
                        hierarchy, row.gameplay.id, alpha)
                    raise WorldRenderingError.InvalidReference if not Geometry::transform_is_valid(sampled)
                    inserted: bool = RenderSnapshot::snapshot_bind_tinted(snapshot,
                        row.gameplay, row.render_id, row.visual,
                        Geometry::transform_compose(sampled, row.local_transform), row.tint)
                    raise WorldRenderingError.SnapshotRejected if not inserted
            prune_dead_bindings(world, bindings)
