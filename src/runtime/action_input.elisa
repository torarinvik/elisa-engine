# Context-aware action input. Device codes are translated at the boundary;
# gameplay and UI consume stable action IDs and frame transitions.
include "../vendor/elisa_math.elisa"

module ActionInput:
    private:
        const module Limits:
            MAX_BINDINGS: usize = 48
            MAX_ACTIONS: usize = 16
            DEVICE_COUNT: usize = 3

        def device_index(device: Device) -> usize:
            return 0 if device == Device.Keyboard
            return 1 if device == Device.Mouse
            2

        def state_slot(input: Input&, action: i64) -> usize:
            for index in 0..<Limits::MAX_ACTIONS |slot: usize = Limits::MAX_ACTIONS| -> slot:
                break index if input.states[index].live and input.states[index].action == action

        def refresh_action(input: mutable Input&, slot: usize) -> void:
            return if slot >= Limits::MAX_ACTIONS or not input.states[slot].live
            action: i64 = input.states[slot].action
            down: mutable bool = false
            value: mutable f32 = 0.0
            for index in 0..<input.binding_count |input, action|:
                binding: Binding = input.bindings[index]
                if binding.live and binding.action == action and binding.context == input.context:
                    down <- true if input.binding_down[index]
                    magnitude: f32 = ElisaMath::fabsf(input.binding_values[index])
                    value <- input.binding_values[index] if magnitude > ElisaMath::fabsf(value)
            was_down: bool = input.states[slot].down
            input.states[slot].down <- down
            input.states[slot].pressed <- true if down and not was_down
            input.states[slot].released <- true if was_down and not down
            input.states[slot].value <- value

    public:
        enum Device:
            Keyboard
            Mouse
            Gamepad

        enum Context:
            Gameplay
            UI

        struct Binding:
            action: i64
            device: Device
            code: i64
            chord_code: i64
            deadzone: f32
            context: Context
            live: bool

        struct Event:
            device: Device
            code: i64
            value: f32
            pressed: bool
            released: bool
            chord_down: bool

        struct ActionState:
            action: i64
            down: mutable bool
            pressed: mutable bool
            released: mutable bool
            value: mutable f32
            live: mutable bool

        enum InputError:
            InvalidAction
            InvalidCode
            InvalidDeadzone
            Capacity
            DuplicateBinding

        # Non-throwing result for callers that want to build bindings in
        # ordinary loops without threading a fallible call through helpers.
        enum BindResult:
            Bound
            InvalidAction
            InvalidCode
            InvalidDeadzone
            Capacity
            DuplicateBinding

        affine struct Input:
            private:
                bindings: mutable Binding[Limits::MAX_BINDINGS]
                binding_down: mutable bool[Limits::MAX_BINDINGS]
                binding_values: mutable f32[Limits::MAX_BINDINGS]
                source_down: mutable bool[Limits::MAX_BINDINGS]
                source_values: mutable f32[Limits::MAX_BINDINGS]
                chord_down: mutable bool[Limits::MAX_BINDINGS]
                states: mutable ActionState[Limits::MAX_ACTIONS]
                binding_count: mutable usize
                context: mutable Context
                connected: mutable bool[Limits::DEVICE_COUNT]

        def Input() -> Input:
            Input{
                bindings: zeroed,
                binding_down: zeroed,
                binding_values: zeroed,
                source_down: zeroed,
                source_values: zeroed,
                chord_down: zeroed,
                states: zeroed,
                binding_count: 0,
                context: Context.Gameplay,
                connected: [true, true, true],
            }

        def bind_checked(input: mutable Input&, binding: Binding) -> BindResult:
            return BindResult.InvalidAction if binding.action <= 0
            return BindResult.InvalidCode if binding.code <= 0 or binding.chord_code < 0 or binding.chord_code == binding.code
            return BindResult.InvalidDeadzone if binding.deadzone < 0.0 or binding.deadzone >= 1.0
            for index in 0..<input.binding_count:
                existing: Binding = input.bindings[index]
                return BindResult.DuplicateBinding if existing.live and existing.action == binding.action and existing.device == binding.device and existing.code == binding.code and existing.chord_code == binding.chord_code and existing.context == binding.context
            return BindResult.Capacity if input.binding_count >= Limits::MAX_BINDINGS
            # Find all required storage before mutating either table. A full
            # action table must not consume a binding slot on failure.
            slot: mutable usize = state_slot(input, binding.action)
            if slot == Limits::MAX_ACTIONS:
                slot <- for index in 0..<Limits::MAX_ACTIONS |slot: usize = Limits::MAX_ACTIONS, input| -> slot:
                    break index if not input.states[index].live
                return BindResult.Capacity if slot == Limits::MAX_ACTIONS
            input.bindings[input.binding_count] <- binding
            input.binding_count <- input.binding_count + 1
            if input.states[slot].live and input.states[slot].action == binding.action:
                return BindResult.Bound
            else:
                input.states[slot] <- ActionState{action: binding.action, down: false, pressed: false, released: false, value: 0.0, live: true}
            BindResult.Bound

        def bind(input: mutable Input&, binding: Binding) -> void error[InputError]:
            result: BindResult = bind_checked(input, binding)
            raise InputError.InvalidAction if result == BindResult.InvalidAction
            raise InputError.InvalidCode if result == BindResult.InvalidCode
            raise InputError.InvalidDeadzone if result == BindResult.InvalidDeadzone
            raise InputError.Capacity if result == BindResult.Capacity
            raise InputError.DuplicateBinding if result == BindResult.DuplicateBinding

        def set_context(input: mutable Input&, context: Context) -> void:
            input.context <- context
            for index in 0..<input.binding_count |input|:
                input.binding_down[index] <- false
                input.binding_values[index] <- 0.0
                input.source_down[index] <- false
                input.source_values[index] <- 0.0
                input.chord_down[index] <- false
            for index in 0..<Limits::MAX_ACTIONS |input|:
                input.states[index].down <- false if input.states[index].live
                input.states[index].pressed <- false if input.states[index].live
                input.states[index].released <- false if input.states[index].live
                input.states[index].value <- 0.0 if input.states[index].live

        def set_connected(input: mutable Input&, device: Device, connected: bool) -> void:
            input.connected[device_index(device)] <- connected
            if not connected:
                for index in 0..<input.binding_count |input, device|:
                    if input.bindings[index].device == device:
                        input.binding_down[index] <- false
                        input.binding_values[index] <- 0.0
                        input.source_down[index] <- false
                        input.source_values[index] <- 0.0
                        input.chord_down[index] <- false
                for index in 0..<Limits::MAX_ACTIONS |input|:
                    refresh_action(input, index)

        # Clears held state while keeping the device available. Application
        # focus-loss signals can use this without pretending a device detached.
        def clear_device_state(input: mutable Input&, device: Device) -> void:
            for index in 0..<input.binding_count |input, device|:
                if input.bindings[index].device == device:
                    input.binding_down[index] <- false
                    input.binding_values[index] <- 0.0
                    input.source_down[index] <- false
                    input.source_values[index] <- 0.0
                    input.chord_down[index] <- false
            for index in 0..<Limits::MAX_ACTIONS |input|:
                refresh_action(input, index)

        def begin_frame(input: mutable Input&) -> void:
            for index in 0..<Limits::MAX_ACTIONS |input|:
                if input.states[index].live:
                    input.states[index].pressed <- false
                    input.states[index].released <- false

        def apply(input: mutable Input&, event: Event) -> void:
            return if not input.connected[device_index(event.device)]
            for index in 0..<input.binding_count |input, event|:
                binding: Binding = input.bindings[index]
                if binding.live and binding.context == input.context and binding.device == event.device:
                    if binding.code == event.code:
                        magnitude: f32 = event.value if ElisaMath::fabsf(event.value) >= binding.deadzone else 0.0
                        input.source_values[index] <- magnitude if not event.released else 0.0
                        input.source_down[index] <- event.pressed and not event.released and ElisaMath::fabsf(magnitude) > 0.0
                    if binding.chord_code != 0 and binding.chord_code == event.code:
                        input.chord_down[index] <- event.pressed and not event.released and ElisaMath::fabsf(event.value) >= binding.deadzone
                    slot: usize = state_slot(input, binding.action)
                    if slot < Limits::MAX_ACTIONS:
                        chord_active: bool = binding.chord_code == 0 or input.chord_down[index] or event.chord_down
                        active: bool = input.source_down[index] and chord_active
                        input.binding_down[index] <- active
                        input.binding_values[index] <- input.source_values[index] if active else 0.0
                        refresh_action(input, slot)

        def action_down(input: Input&, action: i64) -> bool:
            slot: usize = state_slot(input, action)
            slot < Limits::MAX_ACTIONS and input.states[slot].down

        def action_pressed(input: Input&, action: i64) -> bool:
            slot: usize = state_slot(input, action)
            slot < Limits::MAX_ACTIONS and input.states[slot].pressed

        def action_released(input: Input&, action: i64) -> bool:
            slot: usize = state_slot(input, action)
            slot < Limits::MAX_ACTIONS and input.states[slot].released

        def action_value(input: Input&, action: i64) -> f32:
            slot: usize = state_slot(input, action)
            return 0.0 if slot >= Limits::MAX_ACTIONS
            input.states[slot].value
