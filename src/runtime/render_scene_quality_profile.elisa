# Public Elisa access to the engine's validated, backend-neutral post-process
# quality profile. Unsupported optional upscalers fall back while the rest of
# the profile remains applied by the native adapter.
include "./render_scene.elisa"

module RenderSceneQualityProfile:
    public:
        const API_VERSION: i32 = 1

extend RenderScene:
    private:
        struct NativeQualityProfile:
            tonemap: i32
            upscaler: i32
            render_scale: f32
            bloom_threshold: f32
            bloom: i32
            fxaa: i32
            temporal_aa: i32
            ambient_occlusion: i32
            screen_space_reflections: i32
            fog: i32
            depth_effects: i32

        @callconv(c)
        extern elisa_render_scene_v1_apply_quality_profile_with_shadow(
            profile: mutable NativeQualityProfile&, shadow_quality: i32,
            sun_shadow_receiver_bias: f32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_apply_camera_quality_profile(camera_handle: i64,
            profile: mutable NativeQualityProfile&, shadow_quality: i32,
            sun_shadow_receiver_bias: f32) -> i32

        def native_profile(profile: Quality::Profile) -> NativeQualityProfile:
            tonemap: i32 = 0 if profile.tonemap == Quality::Tonemap.Reinhard else 1 if profile.tonemap == Quality::Tonemap.Aces else 2
            upscaler: i32 = 0 if profile.upscaler == Quality::Upscaler.None else 1 if profile.upscaler == Quality::Upscaler.Fsr1 else 2
            NativeQualityProfile{
                tonemap: tonemap,
                upscaler: upscaler,
                render_scale: profile.render_scale,
                bloom_threshold: profile.bloom_threshold,
                bloom: 1 if profile.bloom else 0,
                fxaa: 1 if profile.fxaa else 0,
                temporal_aa: 1 if profile.temporal_aa else 0,
                ambient_occlusion: 1 if profile.ambient_occlusion else 0,
                screen_space_reflections: 1 if profile.screen_space_reflections else 0,
                fog: 1 if profile.fog else 0,
                depth_effects: 1 if profile.depth_effects else 0,
            }

    public:
        def apply_quality_profile(profile: Quality::Profile&) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Quality::profile_valid(profile)
            native: mutable NativeQualityProfile = native_profile(profile)
            shadow_quality: i32 =
                match profile.shadow_quality:
                    Quality::ShadowQuality.Low: 0
                    Quality::ShadowQuality.Medium: 1
                    Quality::ShadowQuality.High: 2
            try check_status(elisa_render_scene_v1_apply_quality_profile_with_shadow(
                &native, shadow_quality, profile.sun_shadow_receiver_bias))
        def set_camera_quality_profile(handle: CameraHandle,
            profile: Quality::Profile&) -> void error[RenderSceneError]:
            raise RenderSceneError.InvalidValue if not Quality::profile_valid(profile)
            native: mutable NativeQualityProfile = native_profile(profile)
            shadow_quality: i32 =
                match profile.shadow_quality:
                    Quality::ShadowQuality.Low: 0
                    Quality::ShadowQuality.Medium: 1
                    Quality::ShadowQuality.High: 2
            try check_status(elisa_render_scene_v1_apply_camera_quality_profile(
                handle.native_value, &native, shadow_quality, profile.sun_shadow_receiver_bias))
