# Generic, process-level application lifecycle. Platform and renderer types stay
# behind the engine-owned native ABI; game code sees only configuration/status.
include "../backend/requirements.elisa"
module Application:
    private:
        const module NativeStatus:
            OK: i32 = 0
            RUNNING: i32 = 1
            SUSPENDED: i32 = 2
            EXIT_REQUESTED: i32 = 3
            INVALID_ARGUMENT: i32 = -1
            INVALID_STATE: i32 = -2
            WRONG_THREAD: i32 = -4
            PROFILE_UNAVAILABLE: i32 = -6
            SHADER_PATH_INVALID: i32 = -7
            SHADER_MANIFEST_INVALID: i32 = -8
            EMPTY_PROFILE_VALUE: i64 = 0

        const module FallbackProviderCode:
            JOLT_PHYSICS: i32 = 1
            MINIAUDIO_SILENT: i32 = 2
            MINIAUDIO_DEFAULT: i32 = 3

        const module NativeEvents:
            CLOSE_REQUESTED: u32 = 1
            RESIZED: u32 = 2
            FOCUS_GAINED: u32 = 4
            FOCUS_LOST: u32 = 8
            MINIMIZED: u32 = 16
            RESTORED: u32 = 32

        const module NativeWindowFlags:
            WINDOW_FOCUSED: u32 = 1
            WINDOW_MINIMIZED: u32 = 2
            WINDOW_FULLSCREEN: u32 = 4
            WINDOW_SUSPENDED: u32 = 8
            WINDOW_CLOSE_REQUESTED: u32 = 16

        @callconv(c)
        extern elisa_application_abi_version() -> u32

        @callconv(c)
        extern elisa_application_v1_project_title() -> cstr

        @callconv(c)
        extern elisa_application_v1_project_width() -> i32

        @callconv(c)
        extern elisa_application_v1_project_height() -> i32

        @callconv(c)
        extern elisa_application_v1_project_hidden() -> i32

        @callconv(c)
        extern elisa_application_v1_show_error(title: cstr, message: cstr) -> i32

        @callconv(c)
        extern elisa_application_v1_initialize(title: cstr, width: i32, height: i32, hidden: i32) -> i32

        @callconv(c)
        extern elisa_application_v1_backend_profile(capabilities: mutable i64&, optional: mutable i64&,
            max_viewports: mutable i64&, max_workers: mutable i64&, memory_budget: mutable i64&,
            memory_usage: mutable i64&, formats: mutable i64&, graphics_workers: mutable i64&,
            streaming_workers: mutable i64&, service_version: mutable i64&) -> i32

        @callconv(c)
        extern elisa_application_v1_fallback_provider_available(provider: i32) -> i32

        @callconv(c)
        extern elisa_application_v1_pump() -> i32

        @callconv(c)
        extern elisa_application_v1_frame_info(frame_count: mutable u64&, elapsed_nanos: mutable u64&, resize_serial: mutable u64&, logical_width: mutable i32&, logical_height: mutable i32&, pixel_width: mutable i32&, pixel_height: mutable i32&, display_scale: mutable f32&, event_flags: mutable u32&, window_flags: mutable u32&) -> i32

        @callconv(c)
        extern elisa_application_v1_request_exit() -> i32

        @callconv(c)
        extern elisa_application_v1_shutdown() -> i32

        @callconv(c)
        extern elisa_application_v1_frame_count() -> u64

        @callconv(c)
        extern elisa_application_v1_uptime_nanos() -> u64

        @callconv(c)
        extern elisa_application_v1_random_seed() -> u64

    public:
        struct Config:
            title: cstr
            width: i32
            height: i32
            hidden: bool

        struct FrameInfo:
            frame_count: u64
            elapsed_nanos: u64
            resize_serial: u64
            logical_width: i32
            logical_height: i32
            pixel_width: i32
            pixel_height: i32
            display_scale: f32
            event_flags: u32
            window_flags: u32

        enum InitializeStatus:
            Ready
            FallbackRequired
            RequirementsUnavailable
            InvalidRequirements
            InvalidArgument
            AlreadyRunning
            UnsupportedAbi
            BackendUnavailable
            ShaderPathInvalid
            ShaderManifestInvalid
            ShutdownFailed

        enum PumpStatus:
            Running
            Suspended
            ExitRequested
            NotRunning
            WrongThread
            Failed

        error BackendProfileError:
            NotInitialized
            WrongThread
            Unavailable
            Invalid

        def default_config() -> Config:
            Config{
                title: elisa_application_v1_project_title(),
                width: elisa_application_v1_project_width(),
                height: elisa_application_v1_project_height(),
                hidden: elisa_application_v1_project_hidden() != 0,
            }

        def initialize(config: Config) -> InitializeStatus:
            return InitializeStatus.UnsupportedAbi if elisa_application_abi_version() != 1
            hidden: i32 = 1 if config.hidden else 0
            result: i32 = elisa_application_v1_initialize(config.title, config.width, config.height, hidden)
            return InitializeStatus.Ready if result == NativeStatus::OK
            return InitializeStatus.InvalidArgument if result == NativeStatus::INVALID_ARGUMENT
            return InitializeStatus.AlreadyRunning if result == NativeStatus::INVALID_STATE
            return InitializeStatus.ShaderPathInvalid if result == NativeStatus::SHADER_PATH_INVALID
            return InitializeStatus.ShaderManifestInvalid if result == NativeStatus::SHADER_MANIFEST_INVALID
            InitializeStatus.BackendUnavailable

        def shutdown_after_rejection(status: InitializeStatus) -> InitializeStatus:
            return status if shutdown()
            InitializeStatus.ShutdownFailed

        def apply_fallback_provider_availability(
            report: Capabilities::BackendRequirementReport) -> Capabilities::BackendRequirementReport:
            availability: mutable Capabilities::BackendProviderAvailability =
                Capabilities::BackendProviderAvailability{
                    jolt_physics: false,
                    miniaudio_silent: false,
                    miniaudio_default: false,
                    synchronous_upload: false,
                    synchronous_asset_loading: false,
                }
            jolt_checked: mutable bool = false
            jolt_available: mutable bool = false
            silent_checked: mutable bool = false
            silent_available: mutable bool = false
            default_checked: mutable bool = false
            default_available: mutable bool = false
            for index in 0..<report.decision_count |report, availability, jolt_checked, jolt_available, silent_checked, silent_available, default_checked, default_available|:
                decision: Capabilities::BackendFeatureDecision = report.decisions[index]
                if decision.resolution == Capabilities::BackendFeatureResolution.DeclaredFallback:
                    match decision.fallback_provider:
                        Capabilities::BackendFallbackProvider.JoltPhysics:
                            if not jolt_checked:
                                jolt_available <- elisa_application_v1_fallback_provider_available(
                                    FallbackProviderCode::JOLT_PHYSICS) == 1
                                jolt_checked <- true
                            availability.jolt_physics <- jolt_available
                        Capabilities::BackendFallbackProvider.MiniaudioSilent:
                            if not silent_checked:
                                silent_available <- elisa_application_v1_fallback_provider_available(
                                    FallbackProviderCode::MINIAUDIO_SILENT) == 1
                                silent_checked <- true
                            availability.miniaudio_silent <- silent_available
                        Capabilities::BackendFallbackProvider.MiniaudioDefault:
                            if not default_checked:
                                default_available <- elisa_application_v1_fallback_provider_available(
                                    FallbackProviderCode::MINIAUDIO_DEFAULT) == 1
                                default_checked <- true
                            availability.miniaudio_default <- default_available
                            # Probe the silent route so a missing device can
                            # degrade to it instead of rejecting the start.
                            if not default_available:
                                if not silent_checked:
                                    silent_available <- elisa_application_v1_fallback_provider_available(
                                        FallbackProviderCode::MINIAUDIO_SILENT) == 1
                                    silent_checked <- true
                                availability.miniaudio_silent <- silent_available
                        Capabilities::BackendFallbackProvider.SynchronousUpload:
                            continue
                        Capabilities::BackendFallbackProvider.SynchronousAssetLoading:
                            continue
                        _:
                            continue
            Capabilities::backend_requirement_apply_provider_availability(report, availability)

        def apply_profile_provider_availability(
            report: BackendRequirements::BackendRequirementsReport) -> BackendRequirements::BackendRequirementsReport:
            services: Capabilities::BackendRequirementReport =
                apply_fallback_provider_availability(report.services)
            BackendRequirements::backend_requirements_with_services(report, services)

        # Rejected requirements shut down; fallback results keep the host open.
        # `report` is meaningful for Ready,
        # FallbackRequired, RequirementsUnavailable, and InvalidRequirements.
        def initialize_with_requirements(config: Config,
            required: Capabilities::BackendFeature[Capabilities::MAX_BACKEND_FEATURE_REQUIREMENTS],
            count: usize, fallbacks: Capabilities::BackendFallbackProviders, allow_fallback: bool,
            report: mutable Capabilities::BackendRequirementReport&) -> InitializeStatus:
            report <- Capabilities::backend_requirement_invalid_report()
            opened: InitializeStatus = initialize(config)
            return opened if opened != InitializeStatus.Ready
            profile: Capabilities::BackendProfile = catch backend_profile():
                value: value
                error failure: return shutdown_after_rejection(InitializeStatus.BackendUnavailable)
            report <- Capabilities::backend_requirement_report(profile, required, count,
                fallbacks, allow_fallback)
            if report.fallback_count > 0:
                report <- apply_fallback_provider_availability(report)
            match report.state:
                Capabilities::RequirementState.Invalid:
                    shutdown_after_rejection(InitializeStatus.InvalidRequirements)
                Capabilities::RequirementState.Unavailable:
                    shutdown_after_rejection(InitializeStatus.RequirementsUnavailable)
                Capabilities::RequirementState.Fallback:
                    InitializeStatus.FallbackRequired
                Capabilities::RequirementState.Ready:
                    InitializeStatus.Ready

        # Validate the complete renderer/content contract before gameplay. The
        # report carries the selected limit values and texture formats so an
        # allowed downgrade has a concrete value to apply.
        def initialize_with_profile_requirements(config: Config,
            requirements: BackendRequirements::BackendStartupRequirements,
            report: mutable BackendRequirements::BackendRequirementsReport&) -> InitializeStatus:
            report <- BackendRequirements::backend_requirements_invalid_report()
            opened: InitializeStatus = initialize(config)
            return opened if opened != InitializeStatus.Ready
            profile: Capabilities::BackendProfile = catch backend_profile():
                value: value
                error failure: return shutdown_after_rejection(InitializeStatus.BackendUnavailable)
            report <- BackendRequirements::backend_requirements_report(profile, requirements)
            if report.services.fallback_count > 0:
                report <- apply_profile_provider_availability(report)
            match report.state:
                Capabilities::RequirementState.Invalid:
                    shutdown_after_rejection(InitializeStatus.InvalidRequirements)
                Capabilities::RequirementState.Unavailable:
                    shutdown_after_rejection(InitializeStatus.RequirementsUnavailable)
                Capabilities::RequirementState.Fallback:
                    InitializeStatus.FallbackRequired
                Capabilities::RequirementState.Ready:
                    InitializeStatus.Ready

        # This is a startup-time snapshot of the initialized host. Capabilities
        # describe engine-owned services, not every linked vendor feature.
        def backend_profile() -> Capabilities::BackendProfile error[BackendProfileError]:
            capabilities: i64 = NativeStatus::EMPTY_PROFILE_VALUE
            optional: i64 = NativeStatus::EMPTY_PROFILE_VALUE
            max_viewports: i64 = NativeStatus::EMPTY_PROFILE_VALUE
            max_workers: i64 = NativeStatus::EMPTY_PROFILE_VALUE
            memory_budget: i64 = NativeStatus::EMPTY_PROFILE_VALUE
            memory_usage: i64 = NativeStatus::EMPTY_PROFILE_VALUE
            formats: i64 = NativeStatus::EMPTY_PROFILE_VALUE
            graphics_workers: i64 = NativeStatus::EMPTY_PROFILE_VALUE
            streaming_workers: i64 = NativeStatus::EMPTY_PROFILE_VALUE
            service_version: i64 = NativeStatus::EMPTY_PROFILE_VALUE
            status: i32 = elisa_application_v1_backend_profile(&capabilities, &optional,
                &max_viewports, &max_workers, &memory_budget, &memory_usage, &formats,
                &graphics_workers, &streaming_workers, &service_version)
            raise BackendProfileError.NotInitialized if status == NativeStatus::INVALID_STATE
            raise BackendProfileError.WrongThread if status == NativeStatus::WRONG_THREAD
            raise BackendProfileError.Unavailable if status == NativeStatus::PROFILE_UNAVAILABLE
            raise BackendProfileError.Invalid if status != NativeStatus::OK
            profile: Capabilities::BackendProfile = Capabilities::backend_profile_from_native(
                capabilities, optional, max_viewports, max_workers, memory_budget,
                memory_usage, formats, graphics_workers, streaming_workers, service_version)
            raise BackendProfileError.Invalid if not Capabilities::backend_profile_valid(profile)
            profile

        def pump() -> PumpStatus:
            result: i32 = elisa_application_v1_pump()
            return PumpStatus.Running if result == NativeStatus::RUNNING
            return PumpStatus.Suspended if result == NativeStatus::SUSPENDED
            return PumpStatus.ExitRequested if result == NativeStatus::EXIT_REQUESTED
            return PumpStatus.NotRunning if result == NativeStatus::INVALID_STATE
            return PumpStatus.WrongThread if result == NativeStatus::WRONG_THREAD
            PumpStatus.Failed

        # Pending event bits are coalesced until this snapshot is read.
        def frame_info(info: mutable FrameInfo&) -> bool:
            elisa_application_v1_frame_info(&info.frame_count, &info.elapsed_nanos, &info.resize_serial, &info.logical_width, &info.logical_height, &info.pixel_width, &info.pixel_height, &info.display_scale, &info.event_flags, &info.window_flags) == NativeStatus::OK

        def elapsed_seconds(info: FrameInfo&) -> f32:
            info.elapsed_nanos.f32() / 1000000000.0

        def saw_close_request(info: FrameInfo&) -> bool:
            (info.event_flags & NativeEvents::CLOSE_REQUESTED) != 0

        def saw_resize(info: FrameInfo&) -> bool:
            (info.event_flags & NativeEvents::RESIZED) != 0

        def saw_focus_gain(info: FrameInfo&) -> bool:
            (info.event_flags & NativeEvents::FOCUS_GAINED) != 0

        def saw_focus_loss(info: FrameInfo&) -> bool:
            (info.event_flags & NativeEvents::FOCUS_LOST) != 0

        def saw_minimize(info: FrameInfo&) -> bool:
            (info.event_flags & NativeEvents::MINIMIZED) != 0

        def saw_restore(info: FrameInfo&) -> bool:
            (info.event_flags & NativeEvents::RESTORED) != 0

        def is_focused(info: FrameInfo&) -> bool:
            (info.window_flags & NativeWindowFlags::WINDOW_FOCUSED) != 0

        def is_minimized(info: FrameInfo&) -> bool:
            (info.window_flags & NativeWindowFlags::WINDOW_MINIMIZED) != 0

        def is_fullscreen(info: FrameInfo&) -> bool:
            (info.window_flags & NativeWindowFlags::WINDOW_FULLSCREEN) != 0

        def is_suspended(info: FrameInfo&) -> bool:
            (info.window_flags & NativeWindowFlags::WINDOW_SUSPENDED) != 0

        def is_close_requested(info: FrameInfo&) -> bool:
            (info.window_flags & NativeWindowFlags::WINDOW_CLOSE_REQUESTED) != 0

        def request_exit() -> bool:
            elisa_application_v1_request_exit() == NativeStatus::OK

        def shutdown() -> bool:
            elisa_application_v1_shutdown() == NativeStatus::OK

        def frame_count() -> u64:
            elisa_application_v1_frame_count()

        # Monotonic host uptime is useful for bounded startup/load telemetry;
        # it is zero before initialization and after shutdown.
        # A fresh host seed; record it to replay procedural content.
        def random_seed() -> u64:
            elisa_application_v1_random_seed()

        def uptime_nanos() -> u64:
            elisa_application_v1_uptime_nanos()

        # A bounded native error dialog, with stderr-only delivery for hidden
        # applications. Call on the application owner thread, even on startup
        # failure before initialization. Messages are limited to 4096 bytes.
        def show_error(title: cstr, message: cstr) -> bool:
            elisa_application_v1_show_error(title, message) == NativeStatus::OK
