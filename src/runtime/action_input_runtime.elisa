# Connect SDL3-backed application events to the portable Elisa action layer.
include "action_input.elisa"
include "application_input.elisa"

module ActionInputRuntime:
    private:
        def apply_device_event(input: mutable ActionInput::Input&, device: ActionInput::Device,
            event: Application::InputEvent) -> void:
            ActionInput::apply(input, ActionInput::Event{
                device: device,
                code: event.code,
                value: event.value,
                pressed: event.pressed,
                released: event.released,
                chord_down: event.chord_down,
            })

        # A key event reaches layout bindings by its code and physical
        # bindings by `physical_key(physical_code)`.
        def apply_key_event(input: mutable ActionInput::Input&, event: Application::InputEvent) -> void:
            apply_device_event(input, ActionInput::Device.Keyboard, event) if event.code != 0
            if event.physical_code != 0:
                physical: mutable Application::InputEvent = event
                physical.code <- physical_key(event.physical_code)
                apply_device_event(input, ActionInput::Device.Keyboard, physical)

        def clear_transient_state(input: mutable ActionInput::Input&) -> void:
            ActionInput::clear_device_state(input, ActionInput::Device.Keyboard)
            ActionInput::clear_device_state(input, ActionInput::Device.Mouse)
            ActionInput::clear_device_state(input, ActionInput::Device.Gamepad)

    public:
        # Physical key bindings use codes above this base, so a binding to the
        # W position and one to the W character never collide.
        const PHYSICAL_KEY_BASE: i64 = 10000

        # The binding code for the key at a physical position, given the
        # portable code of the key there on a US layout.
        def physical_key(code: i64) -> i64:
            PHYSICAL_KEY_BASE + code

        # Poll once per application frame. Clearing edges before draining keeps
        # every queued transition visible to simulation code for that frame.
        def begin_frame(input: mutable ActionInput::Input&) -> usize:
            ActionInput::begin_frame(input)
            drain_application_events(input)

        def drain_application_events(input: mutable ActionInput::Input&) -> usize:
            count: mutable usize = 0
            event: mutable Application::InputEvent = zeroed
            while Application::next_input_event(&event) |count, event, input|:
                apply_application_event(input, event)
                count <- count + 1
            count

        # Route one portable event to a local player. Keyboard/mouse can be
        # assigned to one player by the caller; gamepad events only reach the
        # player whose stable connection slot matches `gamepad_slot`.
        def apply_player_event(input: mutable ActionInput::Input&,
            event: Application::InputEvent, gamepad_slot: i32,
            include_keyboard: bool) -> void:
            if event.kind == Application::InputEventKind.Key:
                apply_key_event(input, event) if include_keyboard
            elif event.kind == Application::InputEventKind.MouseButton:
                apply_device_event(input, ActionInput::Device.Mouse, event) if include_keyboard
            elif event.kind == Application::InputEventKind.GamepadButton:
                apply_device_event(input, ActionInput::Device.Gamepad, event) if event.device_slot == gamepad_slot
            elif event.kind == Application::InputEventKind.GamepadAxis:
                apply_device_event(input, ActionInput::Device.Gamepad, event) if event.device_slot == gamepad_slot
            elif event.kind == Application::InputEventKind.GamepadConnected:
                ActionInput::set_connected(input, ActionInput::Device.Gamepad, true) if event.device_slot == gamepad_slot
            elif event.kind == Application::InputEventKind.GamepadDisconnected:
                if event.device_slot == gamepad_slot:
                    ActionInput::clear_device_state(input, ActionInput::Device.Gamepad)
                    ActionInput::set_connected(input, ActionInput::Device.Gamepad, false)
            elif event.kind == Application::InputEventKind.FocusLost or event.kind == Application::InputEventKind.Overflow:
                clear_transient_state(input)

        # This translator is public so portable games and tests can share the
        # exact device, focus, overflow, and hotplug behavior.
        def apply_application_event(input: mutable ActionInput::Input&,
            event: Application::InputEvent) -> void:
            match event.kind:
                Application::InputEventKind.Key:
                    apply_key_event(input, event)
                Application::InputEventKind.MouseButton:
                    apply_device_event(input, ActionInput::Device.Mouse, event)
                Application::InputEventKind.GamepadButton:
                    apply_device_event(input, ActionInput::Device.Gamepad, event)
                Application::InputEventKind.GamepadAxis:
                    apply_device_event(input, ActionInput::Device.Gamepad, event)
                Application::InputEventKind.GamepadConnected:
                    ActionInput::set_connected(input, ActionInput::Device.Gamepad, true)
                Application::InputEventKind.GamepadDisconnected:
                    ActionInput::clear_device_state(input, ActionInput::Device.Gamepad)
                    ActionInput::set_connected(input, ActionInput::Device.Gamepad, event.connected)
                Application::InputEventKind.FocusLost:
                    clear_transient_state(input)
                Application::InputEventKind.Overflow:
                    clear_transient_state(input)
