# Byte form of an ActionInputReplay log: "EIR1", a little-endian u32 entry
# count, then 16 bytes per entry (u32 tick, kind, device, flags, context,
# i32 code, i32 quantized value). Decoding validates every field so a
# truncated or edited recording is refused rather than replayed.
include "action_input_replay.elisa"

module ActionInputReplayCodec:
    private:
        const HEADER_BYTES: usize = 8

        def air_kind_byte(kind: ActionInputReplay::Kind) -> i64:
            return 0 if kind == ActionInputReplay::Kind.Input
            return 1 if kind == ActionInputReplay::Kind.Context
            return 2 if kind == ActionInputReplay::Kind.Connect
            3

        def air_kind_of(value: i64) -> ActionInputReplay::Kind:
            return ActionInputReplay::Kind.Input if value == 0
            return ActionInputReplay::Kind.Context if value == 1
            return ActionInputReplay::Kind.Connect if value == 2
            ActionInputReplay::Kind.Disconnect

        def air_device_byte(device: ActionInput::Device) -> i64:
            return 0 if device == ActionInput::Device.Keyboard
            return 1 if device == ActionInput::Device.Mouse
            2

        def air_device_of(value: i64) -> ActionInput::Device:
            return ActionInput::Device.Keyboard if value == 0
            return ActionInput::Device.Mouse if value == 1
            ActionInput::Device.Gamepad

        def air_put_u32(out: mutable Bytes&, offset: usize, value: i64) -> void:
            bits: u64 = value.u64() & 4294967295
            out.data[offset] <- (bits & 255).u8()
            out.data[offset + 1] <- ((bits >> 8) & 255).u8()
            out.data[offset + 2] <- ((bits >> 16) & 255).u8()
            out.data[offset + 3] <- ((bits >> 24) & 255).u8()

        def air_get_u32(data: Bytes&, offset: usize) -> i64:
            data.data[offset].i64() + (data.data[offset + 1].i64() << 8) + (data.data[offset + 2].i64() << 16) + (data.data[offset + 3].i64() << 24)

        def air_get_i32(data: Bytes&, offset: usize) -> i64:
            raw: i64 = air_get_u32(data, offset)
            raw - 4294967296 if raw >= 2147483648 else raw

    public:
        const MAX_BYTES: usize = 16392

        struct Bytes:
            data: mutable u8[16392]
            count: mutable usize

        enum DecodeStatus:
            Ok
            BadMagic
            BadLength
            BadField
            NonMonotonicTick

        def encode(log: ActionInputReplay::Log&) -> Bytes:
            mutable out: Bytes = Bytes{data: zeroed, count: 0}
            out.data[0] <- 69
            out.data[1] <- 73
            out.data[2] <- 82
            out.data[3] <- 49
            air_put_u32(&out, 4, log.count.i64())
            for index in 0..<log.count |out|:
                entry: ActionInputReplay::Entry = log.entries[index]
                base: usize = HEADER_BYTES + index * ActionInputReplay::ENTRY_BYTES
                air_put_u32(&out, base, entry.tick)
                out.data[base + 4] <- air_kind_byte(entry.kind).u8()
                out.data[base + 5] <- air_device_byte(entry.device).u8()
                flags: i64 = (1 if entry.pressed else 0) + (2 if entry.released else 0) + (4 if entry.chord_down else 0)
                out.data[base + 6] <- flags.u8()
                out.data[base + 7] <- (1 if entry.context == ActionInput::Context.UI else 0).u8()
                air_put_u32(&out, base + 8, entry.code)
                air_put_u32(&out, base + 12, entry.value_q)
            out.count <- HEADER_BYTES + log.count * ActionInputReplay::ENTRY_BYTES
            out

        # Fills `log` only when every entry is valid; otherwise `log` is left
        # empty and the status names the first problem.
        def decode(data: Bytes&, log: mutable ActionInputReplay::Log&) -> DecodeStatus:
            log.count <- 0
            log.dropped <- 0
            log.last_tick <- 0
            return DecodeStatus.BadLength if data.count < HEADER_BYTES or data.count > MAX_BYTES
            return DecodeStatus.BadMagic if data.data[0] != 69 or data.data[1] != 73 or data.data[2] != 82 or data.data[3] != 49
            count: i64 = air_get_u32(data, 4)
            return DecodeStatus.BadLength if count > ActionInputReplay::MAX_ENTRIES.i64()
            return DecodeStatus.BadLength if data.count != HEADER_BYTES + count.usize() * ActionInputReplay::ENTRY_BYTES
            mutable status: DecodeStatus = DecodeStatus.Ok
            mutable previous: i64 = 0
            for index in 0..<count.usize() |status, previous, log|:
                if status == DecodeStatus.Ok:
                    base: usize = HEADER_BYTES + index * ActionInputReplay::ENTRY_BYTES
                    tick: i64 = air_get_u32(data, base)
                    kind: i64 = data.data[base + 4].i64()
                    device: i64 = data.data[base + 5].i64()
                    flags: i64 = data.data[base + 6].i64()
                    context: i64 = data.data[base + 7].i64()
                    value_q: i64 = air_get_i32(data, base + 12)
                    bad: bool = kind > 3 or device > 2 or flags > 7 or context > 1 or value_q > 1048576 or value_q < -1048576
                    status <- DecodeStatus.BadField if bad
                    status <- DecodeStatus.NonMonotonicTick if not bad and tick < previous
                    if status == DecodeStatus.Ok:
                        previous <- tick
                        log.entries[index] <- ActionInputReplay::Entry{
                            tick: tick,
                            kind: air_kind_of(kind),
                            device: air_device_of(device),
                            code: air_get_i32(data, base + 8),
                            value_q: value_q,
                            pressed: flags % 2 == 1,
                            released: (flags / 2) % 2 == 1,
                            chord_down: flags / 4 == 1,
                            context: ActionInput::Context.UI if context == 1 else ActionInput::Context.Gameplay,
                        }
            return status if status != DecodeStatus.Ok
            log.count <- count.usize()
            log.last_tick <- previous
            DecodeStatus.Ok
