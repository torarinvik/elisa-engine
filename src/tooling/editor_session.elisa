# Bounded editor session state. Hosts render this value model; selection,
# panel ownership, and edit revisions remain in Elisa so reopening a panel
# cannot create a second authoritative copy of editor state.
include "inspector_view.elisa"
include "asset_browser.elisa"
include "editor.elisa"
include "../ui/widgets.elisa"

module EditorSession:
    public:
        enum Panel:
            Inspector
            Assets

        error SessionError:
            InvalidSession
            FieldUnknown
            FieldInvalid
            FieldRange
            AssetUnknown
            AssetInvalid
            AssetCapacity
            AssetDuplicate
            WidgetCapacity
            WidgetInvalid
            WidgetDuplicate
            HistoryEmpty
            HistoryApply

        struct Session:
            inspector: mutable InspectorView::Model
            assets: mutable AssetBrowser::Browser
            widgets: mutable UiWidgets::Surface
            panel: mutable Panel
            revision: mutable i64
            dirty: mutable bool
            history: mutable Editor::History

        def Session() -> Session:
            Session{
                inspector: InspectorView::Model(),
                assets: AssetBrowser::Browser(),
                widgets: UiWidgets::Surface(),
                panel: Panel.Inspector,
                revision: 0,
                dirty: false,
                history: Editor::History(),
            }

        def session_valid(session: Session&) -> bool:
            return false if not InspectorView::model_valid(&session.inspector)
            return false if not AssetBrowser::browser_valid(&session.assets)
            return false if not UiWidgets::surface_valid(&session.widgets)
            return false if not Editor::history_valid(&session.history)
            session.revision >= 0

        def active_panel(session: Session&) -> Panel:
            session.panel

        def selected_asset(session: Session&) -> usize:
            AssetBrowser::browser_selected(&session.assets)

        def revision(session: Session&) -> i64:
            session.revision

        def dirty(session: Session&) -> bool:
            session.dirty

        def select_panel(session: mutable Session&, panel: Panel) -> void error[SessionError]:
            session.panel <- panel

        private:
            module Changes:
                public:
                    def advance(session: mutable EditorSession::Session&) -> void error[EditorSession::SessionError]:
                        raise EditorSession::SessionError.InvalidSession if not EditorSession::session_valid(session)
                        session.revision <- session.revision + 1
                        session.dirty <- true

                    def map_field_error(code: i32) -> void error[EditorSession::SessionError]:
                        raise EditorSession::SessionError.FieldUnknown if code == 1
                        raise EditorSession::SessionError.FieldInvalid if code == 2
                        raise EditorSession::SessionError.FieldRange if code == 3
                        raise EditorSession::SessionError.HistoryApply if code == 4

                    def map_asset_error(code: i32) -> void error[EditorSession::SessionError]:
                        raise EditorSession::SessionError.AssetCapacity if code == 1
                        raise EditorSession::SessionError.AssetInvalid if code == 2
                        raise EditorSession::SessionError.AssetDuplicate if code == 3
                        raise EditorSession::SessionError.AssetUnknown if code == 4

                    def map_widget_error(code: i32) -> void error[EditorSession::SessionError]:
                        raise EditorSession::SessionError.WidgetCapacity if code == 1
                        raise EditorSession::SessionError.WidgetInvalid if code == 2
                        raise EditorSession::SessionError.WidgetDuplicate if code == 3

        public:
            def apply_field(model: mutable InspectorView::Model&, target: i64, next_value: i64) -> i32:
                result: i32 = catch InspectorView::set_field_value(model, target, next_value):
                    ok: 0
                    InspectorView::FieldError.UnknownTarget: 1
                    InspectorView::FieldError.InvalidField: 2
                    InspectorView::FieldError.OutOfRange: 3
                    error failure: 4
                result

            def edit_field(session: mutable Session&, target: i64, next_value: i64) -> void error[SessionError]:
                raise SessionError.HistoryApply if Editor::history_full(&session.history)
                before: i64 = InspectorView::field_value(&session.inspector, target)
                result: i32 = apply_field(&session.inspector, target, next_value)
                Changes::map_field_error(result)
                raise SessionError.HistoryApply if not Editor::history_push(&session.history, target, before, next_value)
                session.revision <- session.revision + 1
                session.dirty <- true

            def undo_edit(session: mutable Session&) -> void error[SessionError]:
                raise SessionError.HistoryEmpty if not Editor::history_can_undo(&session.history)
                change: Editor::UndoResult = Editor::history_undo(&session.history)
                result: i32 = apply_field(&session.inspector, change.target, change.value)
                Changes::map_field_error(result)
                session.revision <- session.revision + 1
                session.dirty <- true

            def redo_edit(session: mutable Session&) -> void error[SessionError]:
                raise SessionError.HistoryEmpty if not Editor::history_can_redo(&session.history)
                change: Editor::UndoResult = Editor::history_redo(&session.history)
                result: i32 = apply_field(&session.inspector, change.target, change.value)
                Changes::map_field_error(result)
                session.revision <- session.revision + 1
                session.dirty <- true

            def add_asset(session: mutable Session&, id: Assets::AssetId, generation: i64) -> void error[SessionError]:
                result: i32 = catch AssetBrowser::browser_add(&session.assets, id, generation):
                    ok: 0
                    AssetBrowser::BrowserError.Capacity: 1
                    AssetBrowser::BrowserError.InvalidAsset: 2
                    AssetBrowser::BrowserError.DuplicateAsset: 3
                    error failure: 4
                raise SessionError.AssetCapacity if result == 1
                raise SessionError.AssetInvalid if result == 2
                raise SessionError.AssetDuplicate if result == 3
                raise SessionError.AssetUnknown if result == 4
                session.revision <- session.revision + 1
                session.dirty <- true

            def select_asset(session: mutable Session&, index: usize) -> void error[SessionError]:
                result: i32 = catch AssetBrowser::browser_select(&session.assets, index):
                    ok: 0
                    AssetBrowser::BrowserError.UnknownRow: 1
                    error failure: 2
                raise SessionError.AssetUnknown if result != 0

            def mark_asset_loaded(session: mutable Session&, id: Assets::AssetId, generation: i64) -> void error[SessionError]:
                result: i32 = catch AssetBrowser::browser_mark_loaded(&session.assets, id, generation):
                    ok: 0
                    AssetBrowser::BrowserError.UnknownAsset: 1
                    AssetBrowser::BrowserError.InvalidAsset: 2
                    error failure: 3
                raise SessionError.AssetUnknown if result == 1 or result == 3
                raise SessionError.AssetInvalid if result == 2
                session.revision <- session.revision + 1
                session.dirty <- true

            def remove_asset(session: mutable Session&, id: Assets::AssetId) -> void error[SessionError]:
                result: i32 = catch AssetBrowser::browser_remove(&session.assets, id):
                    ok: 0
                    AssetBrowser::BrowserError.UnknownAsset: 1
                    error failure: 2
                raise SessionError.AssetUnknown if result != 0
                session.revision <- session.revision + 1
                session.dirty <- true

            def asset_is_stale(session: Session&, id: Assets::AssetId, generation: i64) -> bool:
                AssetBrowser::browser_is_stale(&session.assets, id, generation)

            def attach_widget(session: mutable Session&, widget: UiWidgets::Widget) -> void error[SessionError]:
                result: i32 = catch UiWidgets::add_widget(&session.widgets, widget):
                    ok: 0
                    UiWidgets::WidgetError.Capacity: 1
                    UiWidgets::WidgetError.InvalidWidget: 2
                    UiWidgets::WidgetError.DuplicateId: 3
                    error failure: 4
                raise SessionError.WidgetCapacity if result == 1
                raise SessionError.WidgetInvalid if result == 2
                raise SessionError.WidgetDuplicate if result == 3
                session.revision <- session.revision + 1
                session.dirty <- true

            def clear_dirty(session: mutable Session&) -> void:
                session.dirty <- false

            def session_commit(session: mutable Session&) -> void error[SessionError]:
                raise SessionError.InvalidSession if not session_valid(session)
                session.dirty <- false
