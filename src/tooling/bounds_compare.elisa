# R06 bounds comparison, scalar and prover-checked: a face agrees when it lies
# within [reference - tolerance, reference + tolerance], and a span covers
# another when it reaches past both of its ends. The prover's float mode is
# syntactic, so `true` is returned only through `agree`/`hold`, whose requires
# the guards must establish (proof/bounds_compare.elisa). NaN fails every
# comparison, so it never agrees or covers.
module BoundsCompare:
    public:
        def agree(value: f32, low: f32, high: f32) -> bool:
            requires low <= value
            requires value <= high
            true

        def hold(outer_low: f32, outer_high: f32, inner_low: f32, inner_high: f32) -> bool:
            requires outer_low <= inner_low
            requires inner_high <= outer_high
            true

        def within(value: f32, low: f32, high: f32) -> bool:
            return false if not (low <= value)
            return false if not (value <= high)
            agree(value, low, high)

        def covers(outer_low: f32, outer_high: f32, inner_low: f32, inner_high: f32) -> bool:
            return false if not (outer_low <= inner_low)
            return false if not (inner_high <= outer_high)
            hold(outer_low, outer_high, inner_low, inner_high)
