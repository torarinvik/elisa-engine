# Retained screen-space composition for a picked world entity. The editor owns
# the native handles; Elisa owns validation, layout, identity text, and visibility.
include "../runtime/render_scene_selection.elisa"
include "../runtime/render_scene_text.elisa"
include "../ui/layout.elisa"
include "../ui/style.elisa"

module WorldSelectionOverlay:
    private:
        const module Layout:
            PANEL_X: i64 = 12
            PANEL_Y: i64 = 12
            PANEL_PADDING: i64 = 8
            PANEL_WIDTH: i64 = 256
            PANEL_HEIGHT: i64 = 140
            ROW_HEIGHT: i64 = 20
            ROW_SPACING: i64 = 2
            TITLE_SIZE: i32 = 14
            VALUE_SIZE: i32 = 12
            MAX_VIEWPORT: i64 = 16384

    public:
        affine struct Canvas:
            private:
                panel: RenderScene::OverlayPanelHandle
                title: RenderScene::OverlayTextHandle
                world: RenderScene::OverlayTextHandle
                entity: RenderScene::OverlayTextHandle
                live: mutable bool

    public:
        def Canvas(panel: RenderScene::OverlayPanelHandle,
            title: RenderScene::OverlayTextHandle,
            world: RenderScene::OverlayTextHandle,
            entity: RenderScene::OverlayTextHandle) -> Canvas:
            Canvas{panel: panel, title: title, world: world, entity: entity, live: true}

    public:
        def canvas_valid(canvas: Canvas&) -> bool:
            canvas.live and canvas.panel.id > 0 and canvas.title.id > 0 and canvas.world.id > 0 and canvas.entity.id > 0 and canvas.title.id != canvas.world.id and canvas.title.id != canvas.entity.id and canvas.world.id != canvas.entity.id

        def canvas_fits_viewport(canvas: Canvas&, width: i64, height: i64) -> bool:
            canvas_valid(canvas) and width >= Layout::PANEL_X + Layout::PANEL_WIDTH and width <= Layout::MAX_VIEWPORT and height >= Layout::PANEL_Y + Layout::PANEL_HEIGHT and height <= Layout::MAX_VIEWPORT

    private:
        module Compose:
            public:
                def color(value: UiStyle::Color&) -> RenderScene::Color:
                    RenderScene::Color{
                        red: value.r.f32() / 255.0,
                        green: value.g.f32() / 255.0,
                        blue: value.b.f32() / 255.0,
                        alpha: value.a.f32() / 255.0,
                    }

                def pick_valid(pick: RenderScene::PickResult) -> bool:
                    pick.gameplay_epoch > 0 and pick.gameplay_id > 0 and pick.distance - pick.distance == 0.0 and pick.distance > 0.0

                def layout() -> UiLayout::Layout:
                    rows: mutable UiLayout::Layout = UiLayout::Layout()
                    root: i64 = UiLayout::layout_add(&rows, -1,
                        UiLayout::Orientation.Vertical, 0,
                        WorldSelectionOverlay::Layout::PANEL_PADDING,
                        WorldSelectionOverlay::Layout::ROW_SPACING)
                    _ = UiLayout::layout_add(&rows, root,
                        UiLayout::Orientation.Horizontal,
                        WorldSelectionOverlay::Layout::ROW_HEIGHT, 0, 0)
                    _ = UiLayout::layout_add(&rows, root,
                        UiLayout::Orientation.Horizontal,
                        WorldSelectionOverlay::Layout::ROW_HEIGHT, 0, 0)
                    _ = UiLayout::layout_add(&rows, root,
                        UiLayout::Orientation.Horizontal,
                        WorldSelectionOverlay::Layout::ROW_HEIGHT, 0, 0)
                    UiLayout::layout_compute(&rows,
                        WorldSelectionOverlay::Layout::PANEL_X,
                        WorldSelectionOverlay::Layout::PANEL_Y,
                        WorldSelectionOverlay::Layout::PANEL_WIDTH,
                        WorldSelectionOverlay::Layout::PANEL_HEIGHT)
                    rows

    public:
        def show(canvas: mutable Canvas&, pick: RenderScene::PickResult,
            viewport_width: i64, viewport_height: i64,
            theme: UiStyle::Theme) -> void error[RenderScene::RenderSceneError]:
            raise RenderScene::RenderSceneError.InvalidValue if not canvas_valid(canvas)
            raise RenderScene::RenderSceneError.InvalidValue if not Compose::pick_valid(pick)
            raise RenderScene::RenderSceneError.InvalidValue if not UiStyle::theme_valid(&theme)
            raise RenderScene::RenderSceneError.InvalidValue if not canvas_fits_viewport(canvas, viewport_width, viewport_height)

            # Keep the composition hidden until all retained elements are
            # updated, so a failed backend call cannot expose mixed identities.
            try RenderScene::set_overlay_panel_visible(canvas.panel, false)
            try RenderScene::set_overlay_text_visible(canvas.title, false)
            try RenderScene::set_overlay_text_visible(canvas.world, false)
            try RenderScene::set_overlay_text_visible(canvas.entity, false)

            layout: mutable UiLayout::Layout = Compose::layout()
            panel_rect: UiLayout::Rect = UiLayout::node_rect(&layout, 0)
            title_rect: UiLayout::Rect = UiLayout::node_rect(&layout, 1)
            world_rect: UiLayout::Rect = UiLayout::node_rect(&layout, 2)
            entity_rect: UiLayout::Rect = UiLayout::node_rect(&layout, 3)
            try RenderScene::set_overlay_panel_position(canvas.panel,
                panel_rect.x.f32(), panel_rect.y.f32())
            try RenderScene::set_overlay_panel_size(canvas.panel,
                panel_rect.width.f32(), panel_rect.height.f32())
            try RenderScene::set_overlay_panel_color(canvas.panel,
                Compose::color(theme.background))
            try RenderScene::set_overlay_text(canvas.title, "WORLD SELECTION")
            try RenderScene::set_overlay_text_position(canvas.title,
                title_rect.x.f32(), title_rect.y.f32())
            try RenderScene::set_overlay_text_size(canvas.title, Layout::TITLE_SIZE)
            try RenderScene::set_overlay_text_color(canvas.title,
                Compose::color(theme.focus))
            try RenderScene::set_overlay_text_alignment(canvas.title,
                RenderScene::OverlayTextAlignment.Left,
                RenderScene::OverlayTextAlignment.Top)
            try RenderScene::set_overlay_text_i64(canvas.world, "world epoch: ",
                pick.gameplay_epoch)
            try RenderScene::set_overlay_text_position(canvas.world,
                world_rect.x.f32(), world_rect.y.f32())
            try RenderScene::set_overlay_text_size(canvas.world, Layout::VALUE_SIZE)
            try RenderScene::set_overlay_text_color(canvas.world,
                Compose::color(theme.text))
            try RenderScene::set_overlay_text_alignment(canvas.world,
                RenderScene::OverlayTextAlignment.Left,
                RenderScene::OverlayTextAlignment.Top)
            try RenderScene::set_overlay_text_i64(canvas.entity, "entity id: ",
                pick.gameplay_id)
            try RenderScene::set_overlay_text_position(canvas.entity,
                entity_rect.x.f32(), entity_rect.y.f32())
            try RenderScene::set_overlay_text_size(canvas.entity, Layout::VALUE_SIZE)
            try RenderScene::set_overlay_text_color(canvas.entity,
                Compose::color(theme.text))
            try RenderScene::set_overlay_text_alignment(canvas.entity,
                RenderScene::OverlayTextAlignment.Left,
                RenderScene::OverlayTextAlignment.Top)
            try RenderScene::set_overlay_text_visible(canvas.title, true)
            try RenderScene::set_overlay_text_visible(canvas.world, true)
            try RenderScene::set_overlay_text_visible(canvas.entity, true)
            try RenderScene::set_overlay_panel_visible(canvas.panel, true)

        def hide(canvas: Canvas&) -> void error[RenderScene::RenderSceneError]:
            raise RenderScene::RenderSceneError.InvalidValue if not canvas_valid(canvas)
            try RenderScene::set_overlay_panel_visible(canvas.panel, false)
            try RenderScene::set_overlay_text_visible(canvas.title, false)
            try RenderScene::set_overlay_text_visible(canvas.world, false)
            try RenderScene::set_overlay_text_visible(canvas.entity, false)

        def destroy(canvas: mutable Canvas&) -> void error[RenderScene::RenderSceneError]:
            raise RenderScene::RenderSceneError.InvalidValue if not canvas_valid(canvas)
            try hide(canvas)
            try RenderScene::destroy_overlay_text(canvas.entity)
            try RenderScene::destroy_overlay_text(canvas.world)
            try RenderScene::destroy_overlay_text(canvas.title)
            try RenderScene::destroy_overlay_panel(canvas.panel)
            canvas.live <- false
