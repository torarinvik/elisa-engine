# Joint motion trails for the overlay (M05): a joint's path over a frame
# window of a frame-major clip, per-segment speed, acceleration at interior
# samples, and heat values against the median so a synthetic spike stands
# out whatever the take's overall pace. Onion ghosts reuse the window rules.
include "../vendor/elisa_math.elisa"
include "./overlay_index.elisa"

module OverlayTrail:
    private:
        def length3(x: f64, y: f64, z: f64) -> f64:
            ElisaMath::sqrt(x * x + y * y + z * z)

        def point(points: darray[f64]&, i: i64, axis: i64) -> f64:
            points[(i * 3 + axis).usize()]

    public:
        # Positions (xyz per sample) of `joint` from `before` frames before
        # `center` to `after` frames after it, clamped to the clip.
        # `positions` is frame-major xyz; a shape mismatch gives no trail.
        def trail(positions: darray[f64]&, frames: i64, joints: i64, joint: i64, center: i64, before: i64, after: i64) -> darray[f64]:
            out: mutable darray[f64] = []
            return out if frames < 1 or frames > OverlayIndex::MAX_FRAMES or joints < 0 or joints > OverlayIndex::MAX_JOINTS
            return out if positions.count.i64() != frames * joints * 3 or joint < 0 or joint >= joints
            first: i64 = OverlayIndex::window_first(center, before, frames)
            last: i64 = OverlayIndex::window_last(center, after, frames)
            return out if last < first
            for f in first.usize()..<(last + 1).usize() |out, positions, frames, joints, joint|:
                for axis in 0..<3 |out, positions, frames, joints, joint, f|:
                    at: i64 = OverlayIndex::slot(f.i64(), joint, axis.i64(), frames, joints)
                    out.push(positions[at.usize()])
            out

        # Speed of each trail segment in units per second.
        def speeds(points: darray[f64]&, fps: f64) -> darray[f64]:
            n: i64 = points.count.i64() / 3
            out: mutable darray[f64] = []
            stop: i64 = n if n > 1 else 1
            for i in 1..<stop.usize() |out, points, fps|:
                j: i64 = i.i64()
                dx: f64 = point(points, j, 0) - point(points, j - 1, 0)
                dy: f64 = point(points, j, 1) - point(points, j - 1, 1)
                dz: f64 = point(points, j, 2) - point(points, j - 1, 2)
                out.push(length3(dx, dy, dz) * fps)
            out

        # Acceleration magnitude at each interior sample (second difference).
        def accelerations(points: darray[f64]&, fps: f64) -> darray[f64]:
            n: i64 = points.count.i64() / 3
            out: mutable darray[f64] = []
            stop: i64 = n - 1 if n > 2 else 1
            for i in 1..<stop.usize() |out, points, fps|:
                j: i64 = i.i64()
                ax: f64 = point(points, j + 1, 0) - 2.0 * point(points, j, 0) + point(points, j - 1, 0)
                ay: f64 = point(points, j + 1, 1) - 2.0 * point(points, j, 1) + point(points, j - 1, 1)
                az: f64 = point(points, j + 1, 2) - 2.0 * point(points, j, 2) + point(points, j - 1, 2)
                out.push(length3(ax, ay, az) * fps * fps)
            out

        # Lower median of `values`, or 0 for none. Counting ranks keeps it
        # allocation-free; trails are at most a few thousand samples.
        def median(values: darray[f64]&) -> f64:
            n: i64 = values.count.i64()
            return 0.0 if n == 0
            k: i64 = (n - 1) / 2
            found: mutable f64 = values[0]
            for i in 0..<values.count |found, values, k|:
                less: mutable i64 = 0
                equal: mutable i64 = 0
                here: f64 = values[i]
                for j in 0..<values.count |less, equal, values, here|:
                    other: f64 = values[j]
                    less <- less + 1 if other < here else less
                    equal <- equal + 1 if other == here else equal
                found <- here if less <= k and less + equal > k else found
            found

        # The heat reference: the lower median of the moving values (those
        # above 0), or 0 when nothing moves. Stillness is left out so a foot
        # that is planted most of the time still has a real swing speed to
        # compare against.
        def moving_median(values: darray[f64]&) -> f64:
            moving: mutable darray[f64] = []
            for i in 0..<values.count |moving, values|:
                v: f64 = values[i]
                if v > 0.0:
                    moving.push(v)
            median(moving)

        # Heat in [0, 1]: each value over `factor` times the moving median,
        # so a value at `factor` references or more is fully hot. Stillness
        # is cold.
        def heat(values: darray[f64]&, factor: f64) -> darray[f64]:
            scale: f64 = moving_median(values) * factor
            out: mutable darray[f64] = []
            for i in 0..<values.count |out, values, scale|:
                v: f64 = values[i]
                h: f64 = v / scale if scale > 0.0 else 0.0
                out.push(1.0 if h > 1.0 else (0.0 if h < 0.0 else h))
            out

        # Indices of values above `factor` times the moving median.
        def spikes(values: darray[f64]&, factor: f64) -> darray[i64]:
            limit: f64 = moving_median(values) * factor
            out: mutable darray[i64] = []
            for i in 0..<values.count |out, values, limit|:
                if values[i] > limit:
                    out.push(i.i64())
            out

        # Colour ramp for a heat value: blue, green, yellow, red at 0, 1/3,
        # 2/3 and 1, as linear RGB.
        def colour(h: f64) -> darray[f64]:
            t: f64 = 1.0 if h > 1.0 else (0.0 if h < 0.0 or h != h else h)
            if t < 1.0 / 3.0:
                a: f64 = t * 3.0
                low: darray[f64] = [0.0, a, 1.0 - a]
                return low
            if t < 2.0 / 3.0:
                b: f64 = t * 3.0 - 1.0
                mid: darray[f64] = [b, 1.0, 0.0]
                return mid
            s: f64 = t * 3.0 - 2.0
            high: darray[f64] = [1.0, 1.0 - s, 0.0]
            high
