# Integer rules for GizmoDisplay, split out so the prover can check them:
# which handles a tool has, how many line records it draws, which highlight
# a handle shows, and which two gizmo axes span a plane handle.
module GizmoDisplayIndex:
    public:
        const TRANSLATE: i64 = 0
        const ROTATE: i64 = 1
        const NORMAL: i64 = 0
        const HOVERED: i64 = 1
        const ACTIVE: i64 = 2
        const MIN_SEGMENTS: i64 = 8
        const MAX_SEGMENTS: i64 = 256
        # A translate axis is a shaft plus a four-line arrowhead; a plane
        # handle is two edges of a small square.
        const ARROW_LINES: i64 = 5
        const PLANE_LINES: i64 = 2

        # Handles of `tool`: translate has the three axes and three planes
        # (Gizmo modes 0-5), rotate the three rings (modes 0-2), else none.
        def handles(tool: i64) -> i64:
            ensure result >= 0
            ensure result <= 6
            ensure tool != 0 or result == 6
            ensure tool != 1 or result == 3
            ensure tool == 0 or tool == 1 or result == 0
            return 6 if tool == TRANSLATE
            return 3 if tool == ROTATE
            0

        # Line records `tool` draws with rings of `segments` lines. Zero for
        # an unknown tool or, for rotate, a segment count outside 8..256.
        def lines(tool: i64, segments: i64) -> i64:
            ensure result >= 0
            ensure result <= 768
            ensure tool != 0 or result == 21
            ensure tool != 1 or segments < 8 or segments > 256 or result == segments * 3
            ensure tool != 1 or segments >= 8 or result == 0
            ensure tool != 1 or segments <= 256 or result == 0
            ensure tool == 0 or tool == 1 or result == 0
            return 3 * ARROW_LINES + 3 * PLANE_LINES if tool == TRANSLATE
            return 0 if tool != ROTATE
            return 0 if segments < MIN_SEGMENTS or segments > MAX_SEGMENTS
            segments * 3

        # Highlight of `handle`: ACTIVE while it is being dragged, HOVERED
        # when only hovered, else NORMAL. Dragging wins over hover, and a
        # handle outside the tool's range is NORMAL.
        def role(handle: i64, hovered: i64, active: i64, count: i64) -> i64:
            ensure result >= 0
            ensure result <= 2
            ensure handle >= 0 or result == 0
            ensure handle < count or result == 0
            ensure handle == hovered or handle == active or result == 0
            ensure handle < 0 or handle >= count or handle != active or result == 2
            ensure handle < 0 or handle >= count or handle != hovered or handle == active or result == 1
            return NORMAL if handle < 0 or handle >= count
            return ACTIVE if handle == active
            return HOVERED if handle == hovered
            NORMAL

        # Gizmo axis along edge 0 or 1 of the plane handle for `mode` (3-5):
        # the two axes other than the plane's normal, lower first. -1 for
        # any other mode or edge.
        def plane_axis(mode: i64, edge: i64) -> i64:
            ensure result >= -1
            ensure result < 3
            ensure mode >= 3 or result == -1
            ensure mode <= 5 or result == -1
            ensure edge == 0 or edge == 1 or result == -1
            ensure result != mode - 3 or result == -1
            ensure mode < 3 or mode > 5 or edge < 0 or edge > 1 or result >= 0
            ensure edge != 0 or result < 2
            ensure edge != 1 or result != 0
            return -1 if mode < 3 or mode > 5 or edge < 0 or edge > 1
            return 1 if edge == 0 and mode == 3
            return 0 if edge == 0
            return 1 if mode == 5
            2
