# Keyframe clip sampling. This is the "sample clips" stage of the plan's
# animation pipeline: a clip holds per-joint keys, sampling interpolates a
# local transform at a tick, and the sampled locals feed the pose evaluator so
# the same composition runs for a keyframe and a cross-fade. A sampler library
# (ozz or any other) would return the same local deltas; the state machine,
# blending, root motion, and IK around it stay engine code.
#
# Keys for each joint occupy one contiguous range in a bounded dynamic buffer.
# The buffer grows only while an asset is loaded; sampling is indexed and never
# allocates. This supports real clips without embedding a large maximum-sized
# key table in every clip value.
include "../math/geometry.elisa"
include "./pose.elisa"
include "./limits.elisa"

module Sampler:
    private:
        const module Tune:
            MAX_JOINTS: usize = AnimationLimits::MAX_JOINTS
            MAX_KEYS: usize = AnimationLimits::MAX_KEYS_PER_CLIP

    public:
        error ClipError:
            Capacity
            InvalidTrack
            InvalidSkeleton

        struct ClipKey:
            tick: i64
            local: Geometry::Transform

        affine struct ClipData:
            private:
                length: i64
                key_counts: mutable usize[Tune::MAX_JOINTS]
                track_starts: mutable usize[Tune::MAX_JOINTS]
                keyframes: mutable darray[ClipKey]
                last_joint: mutable i64

        def ClipData(length: i64) -> ClipData:
            ClipData{
                length: length if length >= 0 else 0,
                key_counts: zeroed,
                track_starts: zeroed,
                keyframes: [],
                last_joint: -1,
            }

        def clip_length(clip: ClipData&) -> i64:
            clip.length

        def clip_valid(clip: ClipData&) -> bool:
            return false if clip.length < 0 or clip.keyframes.count > Tune::MAX_KEYS
            expected_start: mutable usize = 0
            ordered: bool = for joint in 0..<Tune::MAX_JOINTS |ordered: bool = true, expected_start| -> ordered:
                count: usize = clip.key_counts[joint]
                if count > 0:
                    start: usize = clip.track_starts[joint]
                    range_valid: mutable bool = start <= clip.keyframes.count
                    range_valid <- count <= clip.keyframes.count - start if range_valid
                    ordered <- false if start != expected_start or not range_valid
                    if range_valid:
                        track_ordered: bool = for slot in 0..<count |inner: bool = true| -> inner:
                            key: ClipKey = clip.keyframes[start + slot]
                            inner <- false if key.tick < 0 or key.tick > clip.length
                            if slot > 0:
                                previous: ClipKey = clip.keyframes[start + slot - 1]
                                inner <- false if key.tick < previous.tick
                        ordered <- false if not track_ordered
                        expected_start <- expected_start + count
            ordered and expected_start == clip.keyframes.count

        # Keys are appended in non-decreasing tick order; a caller that adds an
        # out-of-order key gets false rather than a silently unsorted track.
        # Tracks must be appended in joint order, keeping every track contiguous.
        def clip_add_key(clip: mutable ClipData&, joint: usize, tick: i64, value: Geometry::Transform) -> bool:
            return false if joint >= Tune::MAX_JOINTS or tick < 0 or tick > clip.length
            count: usize = clip.key_counts[joint]
            return false if clip.keyframes.count >= Tune::MAX_KEYS
            return false if count == 0 and clip.last_joint >= joint.i64()
            return false if count > 0 and clip.last_joint != joint.i64()
            start: usize = clip.keyframes.count if count == 0 else clip.track_starts[joint]
            return false if count > 0 and start + count != clip.keyframes.count
            if count > 0:
                previous: ClipKey = clip.keyframes[start + count - 1]
                return false if tick < previous.tick
            clip.track_starts[joint] <- start
            clip.last_joint <- joint.i64()
            clip.keyframes.push(ClipKey{tick: tick, local: value})
            clip.key_counts[joint] <- count + 1
            true

        def clip_key_count(clip: ClipData&, joint: usize) -> usize:
            return 0 if joint >= Tune::MAX_JOINTS
            clip.key_counts[joint]

        def clip_key_at(clip: ClipData&, joint: usize, slot: usize) -> ClipKey:
            return ClipKey{tick: 0, local: Geometry::transform_identity()} if joint >= Tune::MAX_JOINTS or slot >= clip.key_counts[joint]
            clip.keyframes[clip.track_starts[joint] + slot]

        # Non-erroring sampling used by pose construction: an out-of-range
        # joint or a joint with no keys yields the supplied fallback. Ticks
        # before the first key or after the last hold that key rather than
        # extrapolating.
        def clip_sample_local_or(clip: ClipData&, joint: usize, tick: i64, fallback: Geometry::Transform) -> Geometry::Transform:
            return fallback if joint >= Tune::MAX_JOINTS
            count: usize = clip.key_counts[joint]
            return fallback if count == 0
            first: ClipKey = clip_key_at(clip, joint, 0)
            last: ClipKey = clip_key_at(clip, joint, count - 1)
            return first.local if tick <= first.tick
            return last.local if tick >= last.tick
            low: mutable usize = 0
            high: mutable usize = count - 1
            while low < high |low, high|:
                middle: usize = (low + high + 1) / 2
                middle_key: ClipKey = clip_key_at(clip, joint, middle)
                if middle_key.tick <= tick:
                    low <- middle
                else:
                    high <- middle - 1
            lower: ClipKey = clip_key_at(clip, joint, low)
            upper: ClipKey = clip_key_at(clip, joint, low + 1)
            span: i64 = upper.tick - lower.tick
            weight: f32 = 0.0 if span <= 0 else (tick - lower.tick).f32() / span.f32()
            Pose::transform_lerp(lower.local, upper.local, weight)

        def clip_sample_local(clip: ClipData&, joint: usize, tick: i64, fallback: Geometry::Transform) -> Geometry::Transform error[ClipError]:
            raise ClipError.InvalidTrack if joint >= Tune::MAX_JOINTS
            clip_sample_local_or(clip, joint, tick, fallback)

        def clip_sample_pose(clip: ClipData&, tick: i64, skeleton: Pose::Skeleton&) -> Pose::Pose error[ClipError]:
            raise ClipError.InvalidSkeleton if not Pose::skeleton_valid(skeleton)
            sampled: mutable Pose::Skeleton = Pose::Skeleton()
            for index in 0..<skeleton.count |sampled, clip, skeleton, tick|:
                joint: Pose::Joint = skeleton.joints[index]
                local: Geometry::Transform = clip_sample_local_or(clip, index, tick, joint.local)
                _ = Pose::skeleton_add(&sampled, joint.parent, local)
            evaluated: Pose::Pose = catch Pose::pose_evaluate(&sampled):
                value: value
                error failure: Pose::Pose{models: zeroed, count: 0}
            raise ClipError.InvalidSkeleton if not Pose::pose_valid(&evaluated)
            evaluated
