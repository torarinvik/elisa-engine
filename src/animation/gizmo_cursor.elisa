# Cursor wiring for the gizmo (M04): pointer pixels become normalized device
# points and camera rays (SkeletonPick builds them), and each pointer event
# drives an idle/dragging state machine. Idle, moving hovers the handle under
# the ray; a left press on a handle begins a drag. While dragging, moves
# report the translate delta (translate tool) or ring angle (rotate tool)
# from the press ray, a left release commits and a right press cancels. The
# app applies each report, e.g. through EffectorDrag for an IK effector.
include "./gizmo_display.elisa"
include "./skeleton_pick.elisa"
include "./gizmo_cursor_index.elisa"

module GizmoCursor:
    public:
        struct Cursor:
            state: i64
            hovered: i64
            active: i64
            press: darray[f64]

        struct Report:
            cursor: Cursor
            action: i64
            delta: darray[f64]
            angle: f64

        def Cursor() -> Cursor:
            none: darray[f64] = []
            Cursor{state: GizmoCursorIndex::IDLE, hovered: -1, active: -1, press: none}

        # Normalized device point of pixel (px, py) in a width x height
        # viewport: x right and y up in [-1, 1]. Empty for an empty viewport.
        def ndc(px: f64, py: f64, width: f64, height: f64) -> darray[f64]:
            none: darray[f64] = []
            return none if not (width > 0.0 and height > 0.0)
            out: darray[f64] = [px * 2.0 / width - 1.0, 1.0 - py * 2.0 / height]
            out

        # Feed one cursor event (GizmoCursorIndex codes) with its camera ray.
        # `tool`, `basis`, `origin`, `size` and `tolerance` describe the gizmo
        # as GizmoDisplay::hover takes them.
        def feed(c: Cursor&, tool: i64, basis: darray[f64]&, origin: darray[f64]&, size: f64, tolerance: f64,
            event: i64, ray: darray[f64]&) -> Report:
            zero: darray[f64] = [0.0, 0.0, 0.0]
            mutable hovered: i64 = c.hovered
            if c.state < GizmoCursorIndex::DRAGGING and event != GizmoCursorIndex::NO_EVENT:
                hovered <- GizmoDisplay::hover(tool, basis, origin, size, ray, tolerance)
            state: i64 = GizmoCursorIndex::next(c.state, event, hovered)
            action: i64 = GizmoCursorIndex::action(c.state, event, hovered)
            mutable active: i64 = c.active
            mutable press: darray[f64] = c.press
            if action == GizmoCursorIndex::BEGIN and ray.count == 6:
                active <- hovered
                press <- [ray[0], ray[1], ray[2], ray[3], ray[4], ray[5]]
            mutable delta: darray[f64] = zero
            mutable angle: f64 = 0.0
            if action == GizmoCursorIndex::UPDATE or action == GizmoCursorIndex::COMMIT:
                if tool == GizmoDisplayIndex::TRANSLATE:
                    delta <- Gizmo::translate(active, basis, origin, press, ray)
                else:
                    angle <- Gizmo::rotate(active, basis, origin, press, ray)
            if state < GizmoCursorIndex::DRAGGING and c.state >= GizmoCursorIndex::DRAGGING:
                active <- -1
            Report{cursor: Cursor{state: state, hovered: hovered, active: active, press: press}, action: action, delta: delta, angle: angle}
