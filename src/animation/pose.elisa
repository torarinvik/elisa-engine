# Skeletal pose evaluation. This is the Elisa half of the plan's animation
# pipeline: local-to-model transform evaluation, pose blending, root-motion
# extraction, and a backend-neutral skinning payload. A sampler (ozz or any
# other) only produces the local transforms; the composition order, the blend,
# and the root-motion decision stay engine code. No backend advances a pose.
include "../math/geometry.elisa"
include "../math/rotation.elisa"
include "./ik.elisa"
include "./limits.elisa"

module Pose:
    private:
        const module Tune:
            MAX_JOINTS: usize = AnimationLimits::MAX_JOINTS
            FULL: f32 = 1.0
            NONE: f32 = 0.0

        def lerp_f32(start: f32, finish: f32, weight: f32) -> f32:
            start + (finish - start) * weight

        def lerp_vec3(start: Geometry::Vec3, finish: Geometry::Vec3, weight: f32) -> Geometry::Vec3:
            Geometry::Vec3{
                x: lerp_f32(start.x, finish.x, weight),
                y: lerp_f32(start.y, finish.y, weight),
                z: lerp_f32(start.z, finish.z, weight),
            }

    public:
        error PoseError:
            InvalidSkeleton
            ShapeMismatch
            JointOutOfBounds

        struct Joint:
            parent: i64
            local: Geometry::Transform

        struct Skeleton:
            joints: mutable Joint[Tune::MAX_JOINTS]
            count: mutable usize

        struct Pose:
            models: mutable Geometry::Transform[Tune::MAX_JOINTS]
            count: mutable usize

        def Skeleton() -> Skeleton:
            Skeleton{joints: zeroed, count: 0}

        # Joints are appended in parenting order, so a parent index is always
        # already evaluated when local-to-model evaluation reaches the child.
        def skeleton_add(skeleton: mutable Skeleton&, parent: i64, local: Geometry::Transform) -> bool:
            return false if skeleton.count >= Tune::MAX_JOINTS
            return false if parent < -1 or parent >= skeleton.count.i64()
            skeleton.joints[skeleton.count] <- Joint{parent: parent, local: local}
            skeleton.count <- skeleton.count + 1
            true

        def skeleton_valid(skeleton: Skeleton&) -> bool:
            return false if skeleton.count > Tune::MAX_JOINTS
            ordered: bool = for index in 0..<skeleton.count |ordered: bool = true| -> ordered:
                parent: i64 = skeleton.joints[index].parent
                ordered <- false if parent < -1 or parent >= index.i64()
            ordered

        def skeleton_joint_count(skeleton: Skeleton&) -> usize:
            skeleton.count

        def pose_evaluate(skeleton: Skeleton&) -> Pose error[PoseError]:
            raise PoseError.InvalidSkeleton if not skeleton_valid(skeleton)
            models: mutable Geometry::Transform[Tune::MAX_JOINTS] = zeroed
            for index in 0..<skeleton.count |models, skeleton|:
                parent: i64 = skeleton.joints[index].parent
                local: Geometry::Transform = skeleton.joints[index].local
                composed: Geometry::Transform =
                    local if parent < 0 else Geometry::transform_compose(models[parent.usize()], local)
                models[index] <- composed
            Pose{models: models, count: skeleton.count}

        # One local-transform interpolation, shared by pose blending and clip
        # sampling so a keyframe and a cross-fade use the same shortest-arc
        # rotation blend.
        def transform_lerp(start: Geometry::Transform, finish: Geometry::Transform, weight: f32) -> Geometry::Transform:
            clamped: f32 = Tune::FULL if weight > Tune::FULL else Tune::NONE if weight < Tune::NONE else weight
            Geometry::Transform{
                position: lerp_vec3(start.position, finish.position, clamped),
                rotation: Rotation::slerp(start.rotation, finish.rotation, clamped),
                scale: lerp_vec3(start.scale, finish.scale, clamped),
            }

        def pose_blend(left: Pose&, right: Pose&, weight: f32) -> Pose error[PoseError]:
            raise PoseError.ShapeMismatch if left.count != right.count
            raise PoseError.InvalidSkeleton if left.count > Tune::MAX_JOINTS
            models: mutable Geometry::Transform[Tune::MAX_JOINTS] = zeroed
            for index in 0..<left.count |models, left, right, weight|:
                models[index] <- transform_lerp(left.models[index], right.models[index], weight)
            Pose{models: models, count: left.count}

        def pose_joint_count(pose: Pose&) -> usize:
            pose.count

        def pose_model(pose: Pose&, index: usize) -> Geometry::Transform error[PoseError]:
            raise PoseError.JointOutOfBounds if index >= pose.count
            pose.models[index]

        def pose_root_position(pose: Pose&) -> Geometry::Vec3:
            return Geometry::vec3_zero() if pose.count == 0
            pose.models[0].position

        # Root motion is the delta a character controller consumes; animation
        # drives movement through the movement policy rather than competing
        # with a second controller.
        def pose_root_motion(previous: Pose&, current: Pose&) -> Geometry::Vec3:
            Geometry::vec3_sub(pose_root_position(current), pose_root_position(previous))

        # Backend-neutral skinning payload: one column-major 4x4 per joint in
        # model space. A renderer adapts this layout; it never sees Elisa types.
        def pose_matrix(pose: Pose&, index: usize) -> f32[Geometry::MATRIX_ELEMENTS] error[PoseError]:
            raise PoseError.JointOutOfBounds if index >= pose.count
            Geometry::transform_to_matrix(pose.models[index])

        def pose_valid(pose: Pose&) -> bool:
            return false if pose.count > Tune::MAX_JOINTS
            for index in 0..<pose.count |finite: bool = true| -> finite:
                model: Geometry::Transform = pose.models[index]
                finite <- false if not Geometry::vec3_is_finite(model.position) or not Geometry::vec3_is_finite(model.scale) or not Geometry::quat_is_finite(model.rotation)

        # Two-bone IK correction over a three-joint chain: the root stays put,
        # the middle joint moves to the solved knee, and the end joint lands on
        # the target. This writes model-space translations, which is the final
        # render pose a translation-driven skinning path consumes; recomputing
        # local rotations from the correction is deferred with the rotational
        # rig.
        def pose_correct_two_bone(pose: mutable Pose&, root_index: usize, target: Geometry::Vec3, upper_len: f32, lower_len: f32, bend_axis: Geometry::Vec3) -> bool error[PoseError]:
            raise PoseError.JointOutOfBounds if root_index + 2 >= pose.count
            root: Geometry::Vec3 = pose.models[root_index].position
            knee: Geometry::Vec3 = Ik::two_bone_knee(root, target, upper_len, lower_len, bend_axis)
            # Geometry::Transform holds its fields immutable on purpose, so a joint moves by
            # being replaced whole -- the same way pose_from_skeleton writes `models[index]`.
            knee_joint: Geometry::Transform = pose.models[root_index + 1]
            end_joint: Geometry::Transform = pose.models[root_index + 2]
            pose.models[root_index + 1] <- Geometry::Transform{position: knee, rotation: knee_joint.rotation, scale: knee_joint.scale}
            pose.models[root_index + 2] <- Geometry::Transform{position: target, rotation: end_joint.rotation, scale: end_joint.scale}
            true

        # Rotational correction for an explicitly indexed parent-child limb.
        # Segment lengths come from the current model pose. Unreachable/degenerate
        # targets return false atomically; the end orientation remains captured.
        # Descendants follow the closest corrected ancestor, including toes and
        # auxiliary twist joints. Unrelated branches remain untouched.
        def pose_correct_limb(pose: mutable Pose&, skeleton: Skeleton&, upper: usize, lower: usize, end: usize, target: Geometry::Vec3, bend_axis: Geometry::Vec3) -> bool error[PoseError]:
            raise PoseError.ShapeMismatch if pose.count != skeleton.count
            raise PoseError.InvalidSkeleton if not skeleton_valid(skeleton) or not pose_valid(pose)
            raise PoseError.JointOutOfBounds if upper >= pose.count or lower >= pose.count or end >= pose.count
            return false if skeleton.joints[lower].parent != upper.i64() or skeleton.joints[end].parent != lower.i64()
            return false if not Geometry::vec3_is_finite(target) or not Geometry::vec3_is_finite(bend_axis)
            valid_transforms: bool = for index in 0..<pose.count |valid: bool = true| -> valid:
                valid <- false if not Geometry::transform_is_valid(pose.models[index])
            return false if not valid_transforms
            old_upper: Geometry::Transform = pose.models[upper]
            old_lower: Geometry::Transform = pose.models[lower]
            old_end: Geometry::Transform = pose.models[end]
            first: Geometry::Vec3 = Geometry::vec3_sub(old_lower.position, old_upper.position)
            second: Geometry::Vec3 = Geometry::vec3_sub(old_end.position, old_lower.position)
            a: f32 = Geometry::vec3_length(first)
            b: f32 = Geometry::vec3_length(second)
            distance: f32 = Geometry::vec3_length(Geometry::vec3_sub(target, old_upper.position))
            span: f32 = a - b if a >= b else b - a
            return false if a <= 0.0001 or b <= 0.0001 or distance <= span + 0.0001 or distance >= a + b - 0.0001
            knee: Geometry::Vec3 = Ik::two_bone_knee(old_upper.position, target, a, b, bend_axis)
            upper_delta: Geometry::Quat = Ik::direction_rotation(first, Geometry::vec3_sub(knee, old_upper.position))
            lower_delta: Geometry::Quat = Ik::direction_rotation(second, Geometry::vec3_sub(target, knee))
            new_upper: Geometry::Transform = Geometry::Transform{position: old_upper.position, rotation: Geometry::quat_normalize(Geometry::quat_mul(upper_delta, old_upper.rotation)), scale: old_upper.scale}
            new_lower: Geometry::Transform = Geometry::Transform{position: knee, rotation: Geometry::quat_normalize(Geometry::quat_mul(lower_delta, old_lower.rotation)), scale: old_lower.scale}
            new_end: Geometry::Transform = Geometry::Transform{position: target, rotation: old_end.rotation, scale: old_end.scale}
            for index in 0..<pose.count |pose, skeleton, upper, lower, end, old_upper, old_lower, old_end, new_upper, new_lower, new_end|:
                # The three chain joints are handled after their descendants so
                # each descendant still reads its original model transform.
                if index != upper and index != lower and index != end:
                    ancestor: mutable i64 = skeleton.joints[index].parent
                    for _ in 0..<skeleton.count |ancestor, skeleton, upper, lower, end|:
                        if ancestor >= 0 and ancestor != upper.i64() and ancestor != lower.i64() and ancestor != end.i64():
                            ancestor <- skeleton.joints[ancestor.usize()].parent
                    if ancestor == upper.i64() or ancestor == lower.i64() or ancestor == end.i64():
                        before: Geometry::Transform = old_end if ancestor == end.i64() else old_lower if ancestor == lower.i64() else old_upper
                        after: Geometry::Transform = new_end if ancestor == end.i64() else new_lower if ancestor == lower.i64() else new_upper
                        child: Geometry::Transform = pose.models[index]
                        delta: Geometry::Quat = Geometry::quat_normalize(Geometry::quat_mul(after.rotation, Geometry::quat_conjugate(Geometry::quat_normalize(before.rotation))))
                        relative: Geometry::Vec3 = Geometry::vec3_sub(child.position, before.position)
                        pose.models[index] <- Geometry::Transform{position: Geometry::vec3_add(after.position, Geometry::quat_rotate(delta, relative)), rotation: Geometry::quat_normalize(Geometry::quat_mul(delta, child.rotation)), scale: child.scale}
            pose.models[upper] <- new_upper
            pose.models[lower] <- new_lower
            pose.models[end] <- new_end
            true

        # Model-space orientation control with an independent weight. Connected
        # descendants follow rigidly; unrelated branches and joint origins stay
        # untouched. Invalid requests are rejected before any pose mutation.
        def pose_orient_joint(pose: mutable Pose&, skeleton: Skeleton&, joint: usize,
            target: Geometry::Quat, weight: f32) -> bool error[PoseError]:
            raise PoseError.ShapeMismatch if pose.count != skeleton.count
            raise PoseError.InvalidSkeleton if not skeleton_valid(skeleton) or not pose_valid(pose)
            raise PoseError.JointOutOfBounds if joint >= pose.count
            return false if weight != weight or weight < 0.0 or weight > 1.0
            length: f32 = Geometry::quat_length(target)
            return false if not Geometry::quat_is_finite(target) or length < 0.999 or length > 1.001
            for index in 0..<pose.count:
                model: Geometry::Transform = pose.models[index]
                model_length: f32 = Geometry::quat_length(model.rotation)
                return false if not Geometry::transform_is_valid(model) or model_length < 0.999 or model_length > 1.001 or model_length - model_length != 0.0
            return true if weight == 0.0
            before: Geometry::Transform = pose.models[joint]
            rotation: Geometry::Quat = Rotation::slerp(before.rotation, target, weight)
            delta: Geometry::Quat = Geometry::quat_normalize(Geometry::quat_mul(rotation, Geometry::quat_conjugate(Geometry::quat_normalize(before.rotation))))
            for index in 0..<pose.count |pose|:
                ancestor: mutable i64 = skeleton.joints[index].parent
                while ancestor >= 0 and ancestor.usize() != joint:
                    ancestor <- skeleton.joints[ancestor.usize()].parent
                if ancestor >= 0:
                    child: Geometry::Transform = pose.models[index]
                    relative: Geometry::Vec3 = Geometry::vec3_sub(child.position, before.position)
                    pose.models[index] <- Geometry::Transform{position: Geometry::vec3_add(before.position, Geometry::quat_rotate(delta, relative)), rotation: Geometry::quat_normalize(Geometry::quat_mul(delta, child.rotation)), scale: child.scale}
            pose.models[joint] <- Geometry::Transform{position: before.position, rotation: rotation, scale: before.scale}
            true

        # Stateful variant: memory advances only when the pose solve succeeds.
        # Seed a limb with its mocap bend; reset on a coordinate-space change.
        def pose_correct_limb_stable(pose: mutable Pose&, skeleton: Skeleton&, upper: usize, lower: usize, end: usize, target: Geometry::Vec3, bend_hint: Geometry::Vec3, memory: mutable Ik::BendMemory&) -> bool error[PoseError]:
            raise PoseError.ShapeMismatch if pose.count != skeleton.count
            raise PoseError.InvalidSkeleton if not skeleton_valid(skeleton) or not pose_valid(pose)
            raise PoseError.JointOutOfBounds if upper >= pose.count or lower >= pose.count or end >= pose.count
            return false if not Geometry::vec3_is_finite(target) or not Geometry::vec3_is_finite(bend_hint)
            candidate: mutable Ik::BendMemory = memory
            direction: Geometry::Vec3 = Geometry::vec3_sub(target, pose.models[upper].position)
            bend: Geometry::Vec3 = Ik::stable_bend(&candidate, direction, bend_hint)
            solved: bool = try pose_correct_limb(pose, skeleton, upper, lower, end, target, bend)
            memory <- candidate if solved
            solved

        # Apply after blending. The caller supplies a skinned sole point in the
        # same model space as the pose; this helper does not infer a floor from
        # ankle height or remove intentional positive flight clearance.
        def pose_correct_floor_limb(pose: mutable Pose&, skeleton: Skeleton&, upper: usize, lower: usize, end: usize, sole_point: Geometry::Vec3, floor_height: f32, bend_axis: Geometry::Vec3) -> bool error[PoseError]:
            raise PoseError.ShapeMismatch if pose.count != skeleton.count
            raise PoseError.InvalidSkeleton if not skeleton_valid(skeleton) or not pose_valid(pose)
            raise PoseError.JointOutOfBounds if upper >= pose.count or lower >= pose.count or end >= pose.count
            return false if not Geometry::vec3_is_finite(sole_point) or not Geometry::vec3_is_finite(Geometry::Vec3{x: 0.0, y: floor_height, z: 0.0})
            return true if sole_point.y >= floor_height
            offset: Geometry::Vec3 = Geometry::Vec3{x: 0.0, y: floor_height - sole_point.y, z: 0.0}
            target: Geometry::Vec3 = Geometry::vec3_add(pose.models[end].position, offset)
            try pose_correct_limb(pose, skeleton, upper, lower, end, target, bend_axis)
