# The first checked world keeps identity, liveness, and storage ownership in one
# value.  The registry is deliberately bounded and serial for this milestone;
# later phases can replace the physical stores without changing EntityRef.

include "../entity_id.elisa"
include "./reference.elisa"
include "../math/geometry.elisa"

module World:
    public:
        const MAX_ENTITIES: usize = 256

        # Entity is an upward-composed hierarchy. Callers match the leaf while
        # the world stores a checked reference to the root type.
        enum Entity:
            Unknown

        enum Actor is Entity:
            Player

        enum Enemy is Actor:
            Guard

        enum StaticObject is Entity:
            Structure

        error WorldError:
            EpochExhausted
            IdentityExhausted
            IdentityInvalid
            Capacity
            InvalidKind
            InvalidReference
            StorageMismatch
            InvalidValue

    private:
        const module Bounds:
            WORLD_FIRST_EPOCH: i64 = 1
            WORLD_MAX_EPOCH: i64 = 9223372036854775807
            DEFAULT_ACTOR_HEALTH: i64 = 100
            DEFAULT_ENEMY_THREAT: i64 = 1

        const module Sentinel:
            WORLD_INVALID_SLOT: usize = World::MAX_ENTITIES

        global mutable next_world_epoch: i64 = 0

    public:
        enum StorageKind:
            None
            Actor
            Enemy
            StaticObject

        struct ActorRecord:
            id: i64
            live: mutable bool
            health: i64

        struct EnemyRecord:
            id: i64
            live: mutable bool
            threat: i64

        struct StaticObjectRecord:
            id: i64
            live: mutable bool

        struct RegistryRow:
            id: i64
            kind: Entity
            live: mutable bool
            storage: StorageKind
            transform: mutable Geometry::Transform

    private:
        def entity_storage_kind(kind: Entity) -> StorageKind:
            match kind:
                Actor.Player:
                    StorageKind.Actor
                Enemy.Guard:
                    StorageKind.Enemy
                StaticObject.Structure:
                    StorageKind.StaticObject
                _:
                    StorageKind.None

        def entity_kind_is_spawnable(kind: Entity) -> bool:
            entity_storage_kind(kind) != StorageKind.None

        def next_epoch() -> i64 error[WorldError]:
            if next_world_epoch >= Bounds::WORLD_MAX_EPOCH:
                raise WorldError.EpochExhausted
            if next_world_epoch == 0:
                next_world_epoch <- Bounds::WORLD_FIRST_EPOCH
            else:
                next_world_epoch <- next_world_epoch + 1
            next_world_epoch

        def registry_slot(world: World&, reference: EntityRef) -> usize:
            return Sentinel::WORLD_INVALID_SLOT if not WorldReference::epoch_matches(world.epoch, reference.world_epoch) or reference.id <= EntityId::ENTITY_ID_INVALID
            for index in 0..<world.registry_count |slot: usize = Sentinel::WORLD_INVALID_SLOT| -> slot:
                break index if world.registry[index].live and world.registry[index].id == reference.id

        def free_registry_slot(world: World&) -> usize:
            for index in 0..<world.registry_count |slot: usize = world.registry_count if world.registry_count < World::MAX_ENTITIES else Sentinel::WORLD_INVALID_SLOT| -> slot:
                break index if not world.registry[index].live

        def free_actor_slot(world: World&) -> usize:
            for index in 0..<world.actor_count |slot: usize = world.actor_count if world.actor_count < World::MAX_ENTITIES else Sentinel::WORLD_INVALID_SLOT| -> slot:
                break index if not world.actors[index].live

        def free_enemy_slot(world: World&) -> usize:
            for index in 0..<world.enemy_count |slot: usize = world.enemy_count if world.enemy_count < World::MAX_ENTITIES else Sentinel::WORLD_INVALID_SLOT| -> slot:
                break index if not world.enemies[index].live

        def free_static_object_slot(world: World&) -> usize:
            for index in 0..<world.static_object_count |slot: usize = world.static_object_count if world.static_object_count < World::MAX_ENTITIES else Sentinel::WORLD_INVALID_SLOT| -> slot:
                break index if not world.static_objects[index].live

        def actor_slot(world: World&, id: i64) -> usize:
            for index in 0..<world.actor_count |slot: usize = Sentinel::WORLD_INVALID_SLOT| -> slot:
                break index if world.actors[index].live and world.actors[index].id == id

        def enemy_slot(world: World&, id: i64) -> usize:
            for index in 0..<world.enemy_count |slot: usize = Sentinel::WORLD_INVALID_SLOT| -> slot:
                break index if world.enemies[index].live and world.enemies[index].id == id

        def static_object_slot(world: World&, id: i64) -> usize:
            for index in 0..<world.static_object_count |slot: usize = Sentinel::WORLD_INVALID_SLOT| -> slot:
                break index if world.static_objects[index].live and world.static_objects[index].id == id

        def mark_actor_dead(world: mutable World&, id: i64) -> bool:
            for index in 0..<world.actor_count |condition=false, world| -> condition:
                if world.actors[index].live and world.actors[index].id == id:
                    world.actors[index].live <- false
                    break true

        def mark_enemy_dead(world: mutable World&, id: i64) -> bool:
            for index in 0..<world.enemy_count |condition=false, world| -> condition:
                if world.enemies[index].live and world.enemies[index].id == id:
                    world.enemies[index].live <- false
                    break true

        def mark_static_object_dead(world: mutable World&, id: i64) -> bool:
            for index in 0..<world.static_object_count |condition=false, world| -> condition:
                if world.static_objects[index].live and world.static_objects[index].id == id:
                    world.static_objects[index].live <- false
                    break true

        def live_actor_matches(world: World&, id: i64) -> usize:
            for index in 0..<world.actor_count |matches: usize = 0| -> matches:
                matches <- matches + 1 if world.actors[index].live and world.actors[index].id == id

        def live_enemy_matches(world: World&, id: i64) -> usize:
            for index in 0..<world.enemy_count |matches: usize = 0| -> matches:
                matches <- matches + 1 if world.enemies[index].live and world.enemies[index].id == id

        def live_static_object_matches(world: World&, id: i64) -> usize:
            for index in 0..<world.static_object_count |matches: usize = 0| -> matches:
                matches <- matches + 1 if world.static_objects[index].live and world.static_objects[index].id == id

        def remove_live_id(world: mutable World&, id: i64) -> void:
            slot: usize =
                for index in 0..<world.live_ids_count |found: usize = World::MAX_ENTITIES, world| -> found:
                    found <- index if world.live_ids[index] == id
            return if slot >= world.live_ids_count
            for shift in slot..<world.live_ids_count - 1 |world|:
                world.live_ids[shift] <- world.live_ids[shift + 1]
            world.live_ids_count <- world.live_ids_count - 1

        def compact_registry(world: mutable World&) -> void:
            write: usize =
                for read in 0..<world.registry_count |count: usize = 0, world| -> count:
                    if world.registry[read].live:
                        world.registry[count] <- world.registry[read]
                        count <- count + 1
            for index in write..<world.registry_count |world|:
                world.registry[index].live <- false
            world.registry_count <- write
            world.live_ids_count <- 0
            for index in 0..<world.registry_count |world|:
                if world.registry[index].live:
                    world.live_ids[world.live_ids_count] <- world.registry[index].id
                    world.live_ids_count <- world.live_ids_count + 1

        def compact_actors(world: mutable World&) -> void:
            write: usize =
                for read in 0..<world.actor_count |count: usize = 0, world| -> count:
                    if world.actors[read].live:
                        world.actors[count] <- world.actors[read]
                        count <- count + 1
            for index in write..<world.actor_count |world|:
                world.actors[index].live <- false
            world.actor_count <- write

        def compact_enemies(world: mutable World&) -> void:
            write: usize =
                for read in 0..<world.enemy_count |count: usize = 0, world| -> count:
                    if world.enemies[read].live:
                        world.enemies[count] <- world.enemies[read]
                        count <- count + 1
            for index in write..<world.enemy_count |world|:
                world.enemies[index].live <- false
            world.enemy_count <- write

        def compact_static_objects(world: mutable World&) -> void:
            write: usize =
                for read in 0..<world.static_object_count |count: usize = 0, world| -> count:
                    if world.static_objects[read].live:
                        world.static_objects[count] <- world.static_objects[read]
                        count <- count + 1
            for index in write..<world.static_object_count |world|:
                world.static_objects[index].live <- false
            world.static_object_count <- write

        struct RegistryCheck:
            valid: bool
            live: usize
            actors: usize
            enemies: usize
            static_objects: usize

        def registry_check(world: World&) -> RegistryCheck:
            live: mutable usize = 0
            actors: mutable usize = 0
            enemies: mutable usize = 0
            static_objects: mutable usize = 0
            valid: mutable bool = true
            for index in 0..<world.registry_count |live, actors, enemies, static_objects, valid|:
                row: RegistryRow = world.registry[index]
                if row.live:
                    live <- live + 1
                    valid <- false if row.id <= EntityId::ENTITY_ID_INVALID or row.id > EntityId::entity_id_last_issued(&world.allocator) or not entity_kind_is_spawnable(row.kind)
                    valid <- false if row.storage != entity_storage_kind(row.kind)
                    valid <- false if not Geometry::transform_is_valid(row.transform)
                    if row.storage == StorageKind.Actor:
                        actors <- actors + 1
                        valid <- false if live_actor_matches(world, row.id) != 1
                    elif row.storage == StorageKind.Enemy:
                        enemies <- enemies + 1
                        valid <- false if live_enemy_matches(world, row.id) != 1
                    else:
                        static_objects <- static_objects + 1
                        valid <- false if live_static_object_matches(world, row.id) != 1
                    unique: bool =
                        for earlier in 0..<index |unique: bool = true| -> unique:
                            break false if world.registry[earlier].live and world.registry[earlier].id == row.id
                    valid <- false if not unique
            RegistryCheck{
                valid: valid,
                live: live,
                actors: actors,
                enemies: enemies,
                static_objects: static_objects,
            }

    public:
        struct EntityRef:
            world_epoch: i64
            id: i64

        struct EntityLookup:
            reference: EntityRef
            kind: Entity

        affine struct World:
            private:
                # The allocator is only advanced by world_spawn.  World is affine
                # so callers cannot copy the owner while references remain live.
                allocator: mutable EntityId::EntityIdAllocator
                epoch: i64
                registry: mutable RegistryRow[World::MAX_ENTITIES]
                registry_count: mutable usize
                live_count: mutable usize
                # Compact live-entity column: the ids of live entities in a dense
                # array, so iteration is O(live) rather than O(registry capacity).
                live_ids: mutable i64[World::MAX_ENTITIES]
                live_ids_count: mutable usize
                actors: mutable ActorRecord[World::MAX_ENTITIES]
                actor_count: mutable usize
                enemies: mutable EnemyRecord[World::MAX_ENTITIES]
                enemy_count: mutable usize
                static_objects: mutable StaticObjectRecord[World::MAX_ENTITIES]
                static_object_count: mutable usize

        def World() -> World error[WorldError]:
            epoch: i64 = try next_epoch()
            World{
                allocator: EntityId::EntityIdAllocator(),
                epoch: epoch,
                registry: zeroed,
                registry_count: 0,
                live_count: 0,
                live_ids: zeroed,
                live_ids_count: 0,
                actors: zeroed,
                actor_count: 0,
                enemies: zeroed,
                enemy_count: 0,
                static_objects: zeroed,
                static_object_count: 0,
            }

        def world_spawn(world: mutable World&, kind: Entity) -> EntityRef error[WorldError]:
            raise WorldError.InvalidKind if not entity_kind_is_spawnable(kind)
            registry_index: usize = free_registry_slot(world)
            raise WorldError.Capacity if registry_index == Sentinel::WORLD_INVALID_SLOT
            storage: StorageKind = entity_storage_kind(kind)
            storage_index: mutable usize = free_static_object_slot(world)
            if storage == StorageKind.Actor:
                storage_index <- free_actor_slot(world)
            elif storage == StorageKind.Enemy:
                storage_index <- free_enemy_slot(world)
            raise WorldError.Capacity if storage_index == Sentinel::WORLD_INVALID_SLOT
            allocation_status: i32 =
                catch EntityId::entity_id_allocate(&world.allocator):
                    value: 0
                    error EntityId::EntityIdError.InvalidId: 1
                    error EntityId::EntityIdError.MaxId: 2
            raise WorldError.IdentityInvalid if allocation_status == 1
            raise WorldError.IdentityExhausted if allocation_status == 2
            id: i64 = EntityId::entity_id_last_issued(&world.allocator)
            world.registry[registry_index] <- RegistryRow{
                id: id,
                kind: kind,
                live: true,
                storage: storage,
                transform: Geometry::transform_identity(),
            }
            world.registry_count <- world.registry_count + 1 if registry_index == world.registry_count
            if storage == StorageKind.Actor:
                world.actors[storage_index] <- ActorRecord{id: id, live: true, health: Bounds::DEFAULT_ACTOR_HEALTH}
                world.actor_count <- world.actor_count + 1 if storage_index == world.actor_count
            elif storage == StorageKind.Enemy:
                world.enemies[storage_index] <- EnemyRecord{id: id, live: true, threat: Bounds::DEFAULT_ENEMY_THREAT}
                world.enemy_count <- world.enemy_count + 1 if storage_index == world.enemy_count
            else:
                world.static_objects[storage_index] <- StaticObjectRecord{id: id, live: true}
                world.static_object_count <- world.static_object_count + 1 if storage_index == world.static_object_count
            world.live_count <- world.live_count + 1
            world.live_ids[world.live_ids_count] <- id
            world.live_ids_count <- world.live_ids_count + 1
            EntityRef{world_epoch: world.epoch, id: id}

        def world_last_issued(world: World&) -> i64:
            EntityId::entity_id_last_issued(&world.allocator)

        def world_epoch(world: World&) -> i64:
            world.epoch

        def world_live_count(world: World&) -> usize:
            world.live_count

        def world_registry_count(world: World&) -> usize:
            world.registry_count

        def world_actor_count(world: World&) -> usize:
            world.actor_count

        def world_enemy_count(world: World&) -> usize:
            world.enemy_count

        def world_static_object_count(world: World&) -> usize:
            world.static_object_count

        def world_despawn(world: mutable World&, reference: EntityRef) -> void error[WorldError]:
            index: usize = registry_slot(world, reference)
            raise WorldError.InvalidReference if index == Sentinel::WORLD_INVALID_SLOT
            storage: StorageKind = world.registry[index].storage
            removed: mutable bool = false
            if storage == StorageKind.Actor:
                removed <- mark_actor_dead(world, reference.id)
            elif storage == StorageKind.Enemy:
                removed <- mark_enemy_dead(world, reference.id)
            else:
                removed <- mark_static_object_dead(world, reference.id)
            raise WorldError.InvalidReference if not removed
            world.registry[index].live <- false
            world.registry[index].transform <- zeroed
            world.live_count <- world.live_count - 1
            remove_live_id(world, reference.id)

        def world_try_transform(world: World&, reference: EntityRef,
            transform: mutable Geometry::Transform&) -> bool:
            index: usize = registry_slot(world, reference)
            return false if index == Sentinel::WORLD_INVALID_SLOT
            transform <- world.registry[index].transform
            true

        def world_set_transform(world: mutable World&, reference: EntityRef,
            transform: Geometry::Transform) -> void error[WorldError]:
            raise WorldError.InvalidValue if not Geometry::transform_is_valid(transform)
            index: usize = registry_slot(world, reference)
            raise WorldError.InvalidReference if index == Sentinel::WORLD_INVALID_SLOT
            world.registry[index].transform <- transform

        def world_lookup(world: World&, reference: EntityRef) -> EntityLookup error[WorldError]:
            index: usize = registry_slot(world, reference)
            raise WorldError.InvalidReference if index == Sentinel::WORLD_INVALID_SLOT
            EntityLookup{reference: reference, kind: world.registry[index].kind}

        # Typed snapshots keep storage ownership inside World while giving a
        # system a checked value for its access phase. The registry is checked
        # first, so a dead or wrong-world reference never reaches a column.
        def world_actor_record(world: World&, reference: EntityRef) -> ActorRecord error[WorldError]:
            registry_index: usize = registry_slot(world, reference)
            raise WorldError.InvalidReference if registry_index == Sentinel::WORLD_INVALID_SLOT
            raise WorldError.StorageMismatch if world.registry[registry_index].storage != StorageKind.Actor
            index: usize = actor_slot(world, reference.id)
            raise WorldError.InvalidReference if index == Sentinel::WORLD_INVALID_SLOT
            world.actors[index]

        def world_enemy_record(world: World&, reference: EntityRef) -> EnemyRecord error[WorldError]:
            registry_index: usize = registry_slot(world, reference)
            raise WorldError.InvalidReference if registry_index == Sentinel::WORLD_INVALID_SLOT
            raise WorldError.StorageMismatch if world.registry[registry_index].storage != StorageKind.Enemy
            index: usize = enemy_slot(world, reference.id)
            raise WorldError.InvalidReference if index == Sentinel::WORLD_INVALID_SLOT
            world.enemies[index]

        def world_static_object_record(world: World&, reference: EntityRef) -> StaticObjectRecord error[WorldError]:
            registry_index: usize = registry_slot(world, reference)
            raise WorldError.InvalidReference if registry_index == Sentinel::WORLD_INVALID_SLOT
            raise WorldError.StorageMismatch if world.registry[registry_index].storage != StorageKind.StaticObject
            index: usize = static_object_slot(world, reference.id)
            raise WorldError.InvalidReference if index == Sentinel::WORLD_INVALID_SLOT
            world.static_objects[index]

        def world_actor_set_health(world: mutable World&, reference: EntityRef, health: i64) -> void error[WorldError]:
            raise WorldError.InvalidValue if health < 0
            registry_index: usize = registry_slot(world, reference)
            raise WorldError.InvalidReference if registry_index == Sentinel::WORLD_INVALID_SLOT
            raise WorldError.StorageMismatch if world.registry[registry_index].storage != StorageKind.Actor
            index: usize = actor_slot(world, reference.id)
            raise WorldError.InvalidReference if index == Sentinel::WORLD_INVALID_SLOT
            world.actors[index].health <- health

        def world_enemy_set_threat(world: mutable World&, reference: EntityRef, threat: i64) -> void error[WorldError]:
            raise WorldError.InvalidValue if threat < 0
            registry_index: usize = registry_slot(world, reference)
            raise WorldError.InvalidReference if registry_index == Sentinel::WORLD_INVALID_SLOT
            raise WorldError.StorageMismatch if world.registry[registry_index].storage != StorageKind.Enemy
            index: usize = enemy_slot(world, reference.id)
            raise WorldError.InvalidReference if index == Sentinel::WORLD_INVALID_SLOT
            world.enemies[index].threat <- threat

        def world_is_live(world: World&, reference: EntityRef) -> bool:
            registry_slot(world, reference) != Sentinel::WORLD_INVALID_SLOT

        def world_compact(world: mutable World&) -> void:
            compact_registry(world)
            compact_actors(world)
            compact_enemies(world)
            compact_static_objects(world)

        def world_reference_epoch_matches(world_epoch: i64, reference_epoch: i64) -> bool:
            WorldReference::epoch_matches(world_epoch, reference_epoch)

        # Upward composition: Enemy is an Actor, so a Guard is both an enemy and
        # an actor, while a Player is only an actor. The cases are listed
        # explicitly rather than wildcarded, so adding a descendant forces this
        # case-complete query to be updated instead of silently matching.
        def entity_is_actor(kind: Entity) -> bool:
            match kind:
                Actor.Player:
                    true
                Enemy.Guard:
                    true
                StaticObject.Structure:
                    false
                Entity.Unknown:
                    false

        def entity_is_enemy(kind: Entity) -> bool:
            match kind:
                Actor.Player:
                    false
                Enemy.Guard:
                    true
                StaticObject.Structure:
                    false
                Entity.Unknown:
                    false

        def world_live_ids_count(world: World&) -> usize:
            world.live_ids_count

        # Dense iteration returns a checked world-branded reference instead of
        # making each caller reconstruct provenance from a raw numeric ID.
        def world_live_reference_at(world: World&, index: usize) -> EntityRef error[WorldError]:
            raise WorldError.InvalidReference if not WorldReference::index_valid(index, world.live_ids_count)
            reference: EntityRef = EntityRef{world_epoch: world.epoch, id: world.live_ids[index]}
            raise WorldError.InvalidReference if not world_is_live(world, reference)
            reference

        # The compact column is consistent when it holds exactly the live ids,
        # once each, and nothing else.
        def world_live_column_valid(world: World&) -> bool:
            return false if world.live_ids_count != world.live_count
            for index in 0..<world.live_ids_count |valid: bool = true| -> valid:
                id: i64 = world.live_ids[index]
                valid <- false if not world_is_live(world, EntityRef{world_epoch: world.epoch, id: id})
                unique: bool =
                    for earlier in 0..<index |inner: bool = true| -> inner:
                        inner <- false if world.live_ids[earlier] == id
                valid <- valid and unique
            true

        def world_is_valid(world: World&) -> bool:
            return false if world.epoch < Bounds::WORLD_FIRST_EPOCH or world.registry_count > World::MAX_ENTITIES or world.actor_count > World::MAX_ENTITIES or world.enemy_count > World::MAX_ENTITIES or world.static_object_count > World::MAX_ENTITIES or world.live_count > world.registry_count
            registry: RegistryCheck = registry_check(world)
            return false if not registry.valid
            live_actors: usize =
                for index in 0..<world.actor_count |count: usize = 0| -> count:
                    count <- count + 1 if world.actors[index].live
            live_enemies: usize =
                for index in 0..<world.enemy_count |count: usize = 0| -> count:
                    count <- count + 1 if world.enemies[index].live
            live_static_objects: usize =
                for index in 0..<world.static_object_count |count: usize = 0| -> count:
                    count <- count + 1 if world.static_objects[index].live
            registry.live == world.live_count and registry.actors == live_actors and registry.enemies == live_enemies and registry.static_objects == live_static_objects
