# Runtime phase-access boundary for world systems. Tokens are affine and the
# frame refuses to advance or end while any access is live. Structural access
# is exclusive and is intentionally unavailable during input and render.
include "./access_bounds.elisa"

module WorldAccess:
    public:
        enum Phase:
            Input
            Simulation
            Physics
            Animation
            Render
            Audio

        enum AccessKind:
            Read
            Write
            Structural

        enum AccessError:
            AlreadyActive
            InactiveFrame
            PhaseRegression
            ActiveBorrow
            WrongPhase
            ReadConflict
            WriteConflict
            StructuralConflict
            WrongFrame
            UnknownToken
            IdentityExhausted
            TooManyBorrows

    private:
        const module Limits:
            FRAME_IDENTITY_MAX: i64 = 9223372036854775807

        # Frames begin on the scheduler's owner thread. W07's parallel executor
        # must route identity issuance through its shared atomic identity service.
        global mutable next_frame_identity: i64 = 0

        def issue_frame_identity() -> i64 error[AccessError]:
            can Global.Read, Global.Write:
                raise AccessError.IdentityExhausted if next_frame_identity >= Limits::FRAME_IDENTITY_MAX
                next_frame_identity <- next_frame_identity + 1
                return next_frame_identity

    public:
        affine struct Frame:
            private:
                phase: mutable Phase
                active: mutable bool
                readers: mutable usize
                writer: mutable bool
                structural: mutable bool
                identity: mutable i64
                # Every live token's serial. Release must find and clear its own
                # serial, so a duplicated token cannot be released twice.
                live_serials: mutable i64[WorldAccessBounds::MAX_LIVE_TOKENS]
                next_serial: mutable i64

        affine struct Token:
            private:
                phase: Phase
                kind: AccessKind
                live: mutable bool
                owner_identity: i64
                serial: i64

        def Frame() -> Frame:
            Frame{phase: Phase.Input, active: false, readers: 0, writer: false, structural: false, identity: 0,
                live_serials: zeroed, next_serial: 0}

        def phase_value(phase: Phase) -> usize:
            return 0 if phase == Phase.Input
            return 1 if phase == Phase.Simulation
            return 2 if phase == Phase.Physics
            return 3 if phase == Phase.Animation
            return 4 if phase == Phase.Render
            5

        def free_serial_slot(frame: Frame&) -> usize:
            for slot in 0..<WorldAccessBounds::MAX_LIVE_TOKENS |found: usize = WorldAccessBounds::MAX_LIVE_TOKENS| -> found:
                found <- slot if found == WorldAccessBounds::MAX_LIVE_TOKENS and frame.live_serials[slot] == 0

        def serial_slot(frame: Frame&, serial: i64) -> usize:
            for slot in 0..<WorldAccessBounds::MAX_LIVE_TOKENS |found: usize = WorldAccessBounds::MAX_LIVE_TOKENS| -> found:
                found <- slot if found == WorldAccessBounds::MAX_LIVE_TOKENS and serial != 0 and frame.live_serials[slot] == serial

        def live_token_count(frame: Frame&) -> usize:
            for slot in 0..<WorldAccessBounds::MAX_LIVE_TOKENS |count: usize = 0| -> count:
                count <- count + 1 if frame.live_serials[slot] != 0

        def current_phase(frame: Frame&) -> Phase:
            frame.phase

        def begin_frame(frame: mutable Frame&) -> void error[AccessError]:
            raise AccessError.AlreadyActive if frame.active
            if frame.identity == 0:
                frame.identity <- try issue_frame_identity()
            frame.phase <- Phase.Input
            frame.active <- true
            frame.readers <- 0
            frame.writer <- false
            frame.structural <- false

        def acquire(frame: mutable Frame&, phase: Phase, kind: AccessKind) -> Token error[AccessError]:
            raise AccessError.InactiveFrame if not frame.active
            raise AccessError.PhaseRegression if phase_value(phase) != phase_value(frame.phase)
            open_slot: usize = free_serial_slot(frame)
            raise AccessError.TooManyBorrows if not WorldAccessBounds::serial_slot_usable(open_slot)
            raise AccessError.IdentityExhausted if frame.next_serial >= Limits::FRAME_IDENTITY_MAX
            if kind == AccessKind.Read:
                raise AccessError.ReadConflict if frame.writer or frame.structural
                frame.readers <- frame.readers + 1
            if kind == AccessKind.Write:
                raise AccessError.WriteConflict if frame.writer or frame.structural or frame.readers != 0
                frame.writer <- true
            if kind == AccessKind.Structural:
                raise AccessError.WrongPhase if phase == Phase.Input or phase == Phase.Render
                raise AccessError.StructuralConflict if frame.writer or frame.structural or frame.readers != 0
                frame.structural <- true
            frame.next_serial <- frame.next_serial + 1
            frame.live_serials[open_slot] <- frame.next_serial
            Token{phase: phase, kind: kind, live: true, owner_identity: frame.identity,
                serial: frame.next_serial}

        def release(frame: mutable Frame&, token: mutable Token&) -> void error[AccessError]:
            raise AccessError.InactiveFrame if not frame.active
            raise AccessError.UnknownToken if not token.live
            raise AccessError.WrongFrame if token.owner_identity != frame.identity
            raise AccessError.PhaseRegression if token.phase != frame.phase
            held_slot: usize = serial_slot(frame, token.serial)
            raise AccessError.UnknownToken if not WorldAccessBounds::serial_slot_usable(held_slot)
            frame.live_serials[held_slot] <- 0
            if token.kind == AccessKind.Read:
                frame.readers <- frame.readers - 1
            if token.kind == AccessKind.Write:
                frame.writer <- false
            if token.kind == AccessKind.Structural:
                frame.structural <- false
            token.live <- false

        def advance(frame: mutable Frame&, next: Phase) -> void error[AccessError]:
            raise AccessError.InactiveFrame if not frame.active
            raise AccessError.PhaseRegression if phase_value(next) != phase_value(frame.phase) + 1
            raise AccessError.ActiveBorrow if frame.readers != 0 or frame.writer or frame.structural
            frame.phase <- next

        def can_advance(frame: Frame&, next: Phase) -> bool:
            frame.active and phase_value(next) == phase_value(frame.phase) + 1 and frame.readers == 0 and not frame.writer and not frame.structural

        def end_frame(frame: mutable Frame&) -> void error[AccessError]:
            raise AccessError.InactiveFrame if not frame.active
            raise AccessError.ActiveBorrow if frame.readers != 0 or frame.writer or frame.structural
            frame.active <- false

        def can_end_frame(frame: Frame&) -> bool:
            frame.active and frame.readers == 0 and not frame.writer and not frame.structural

        def frame_active(frame: Frame&) -> bool:
            frame.active

        def frame_live_tokens(frame: Frame&) -> usize:
            live_token_count(frame)

        def token_live(token: Token&) -> bool:
            token.live
