# Reversible world state for prediction and replay. The snapshot contains
# gameplay/storage columns plus the checked transform hierarchy; the allocator
# high-water mark remains owned by World and is never restored backwards.
include "./world.elisa"

module World::Rollback:
    private:
        const module Bounds:
            MAX_ENTITIES: usize = World::MAX_ENTITIES

    public:
        error RollbackError:
            InvalidSnapshot
            WrongWorld

        struct Snapshot:
            epoch: mutable i64
            registry: World::RegistryRow[Bounds::MAX_ENTITIES]
            registry_count: mutable usize
            live_count: mutable usize
            live_ids: i64[Bounds::MAX_ENTITIES]
            live_ids_count: mutable usize
            actors: World::ActorRecord[Bounds::MAX_ENTITIES]
            actor_count: mutable usize
            enemies: World::EnemyRecord[Bounds::MAX_ENTITIES]
            enemy_count: mutable usize
            static_objects: World::StaticObjectRecord[Bounds::MAX_ENTITIES]
            static_object_count: mutable usize
            hierarchy: mutable WorldHierarchy::Snapshot

        def Snapshot() -> Snapshot:
            Snapshot{
                epoch: 0,
                registry: zeroed,
                registry_count: 0,
                live_count: 0,
                live_ids: zeroed,
                live_ids_count: 0,
                actors: zeroed,
                actor_count: 0,
                enemies: zeroed,
                enemy_count: 0,
                static_objects: zeroed,
                static_object_count: 0,
                hierarchy: WorldHierarchy::Snapshot(),
            }

        private:
            def transform_equal(left: Geometry::Transform, right: Geometry::Transform) -> bool:
                left.position.x == right.position.x and left.position.y == right.position.y and left.position.z == right.position.z and left.rotation.x == right.rotation.x and left.rotation.y == right.rotation.y and left.rotation.z == right.rotation.z and left.rotation.w == right.rotation.w and left.scale.x == right.scale.x and left.scale.y == right.scale.y and left.scale.z == right.scale.z

            def storage_matches(kind: World::Entity, storage: World::StorageKind) -> bool:
                match kind:
                    World::Actor.Player:
                        storage == World::StorageKind.Actor
                    World::Enemy.Guard:
                        storage == World::StorageKind.Enemy
                    World::StaticObject.Structure:
                        storage == World::StorageKind.StaticObject
                    _:
                        false

            def registry_matches(snapshot: Snapshot&, id: i64, storage: World::StorageKind) -> usize:
                for index in 0..<snapshot.registry_count |matches: usize = 0| -> matches:
                    row: World::RegistryRow = snapshot.registry[index]
                    matches <- matches + 1 if row.live and row.id == id and row.storage == storage

            def live_registry_count(snapshot: Snapshot&) -> usize:
                for index in 0..<snapshot.registry_count |count: usize = 0| -> count:
                    count <- count + 1 if snapshot.registry[index].live

            def live_actor_count(snapshot: Snapshot&) -> usize:
                for index in 0..<snapshot.actor_count |count: usize = 0| -> count:
                    count <- count + 1 if snapshot.actors[index].live

            def live_enemy_count(snapshot: Snapshot&) -> usize:
                for index in 0..<snapshot.enemy_count |count: usize = 0| -> count:
                    count <- count + 1 if snapshot.enemies[index].live

            def live_static_object_count(snapshot: Snapshot&) -> usize:
                for index in 0..<snapshot.static_object_count |count: usize = 0| -> count:
                    count <- count + 1 if snapshot.static_objects[index].live

        def snapshot_valid(snapshot: Snapshot&) -> bool:
            return false if snapshot.epoch <= 0
            return false if snapshot.registry_count > Bounds::MAX_ENTITIES or snapshot.live_count > snapshot.registry_count
            return false if snapshot.live_ids_count > Bounds::MAX_ENTITIES or snapshot.actor_count > Bounds::MAX_ENTITIES or snapshot.enemy_count > Bounds::MAX_ENTITIES or snapshot.static_object_count > Bounds::MAX_ENTITIES
            return false if not WorldHierarchy::hierarchy_snapshot_valid(snapshot.hierarchy) or snapshot.hierarchy.count != snapshot.live_count
            return false if snapshot.live_ids_count != snapshot.live_count or live_registry_count(snapshot) != snapshot.live_count
            return false if live_actor_count(snapshot) + live_enemy_count(snapshot) + live_static_object_count(snapshot) != snapshot.live_count
            registry_rows_valid: bool =
                for index in 0..<snapshot.registry_count |valid: bool = true| -> valid:
                    row: World::RegistryRow = snapshot.registry[index]
                    if row.live:
                        valid <- false if row.id <= 0 or not storage_matches(row.kind, row.storage)
                        valid <- false if not Geometry::transform_is_valid(row.transform)
                        hierarchy_pose: mutable Geometry::Transform = Geometry::transform_identity()
                        valid <- false if not WorldHierarchy::hierarchy_snapshot_world(snapshot.hierarchy, row.id, &hierarchy_pose) or not transform_equal(row.transform, hierarchy_pose)
                        unique: bool =
                            for earlier in 0..<index |inner: bool = true| -> inner:
                                inner <- false if snapshot.registry[earlier].live and snapshot.registry[earlier].id == row.id
                        valid <- valid and unique
                        valid <- false if registry_matches(snapshot, row.id, row.storage) != 1
            return false if not registry_rows_valid
            live_ids_valid: bool =
                for index in 0..<snapshot.live_ids_count |valid: bool = true| -> valid:
                    id: i64 = snapshot.live_ids[index]
                    valid <- false if id <= 0
                    unique: bool =
                        for earlier in 0..<index |inner: bool = true| -> inner:
                            inner <- false if snapshot.live_ids[earlier] == id
                    valid <- valid and unique
                    actor_matches: usize = registry_matches(snapshot, id, World::StorageKind.Actor)
                    enemy_matches: usize = registry_matches(snapshot, id, World::StorageKind.Enemy)
                    static_matches: usize = registry_matches(snapshot, id, World::StorageKind.StaticObject)
                    valid <- false if actor_matches + enemy_matches + static_matches != 1
            return false if not live_ids_valid
            actors_valid: bool =
                for index in 0..<snapshot.actor_count |valid: bool = true| -> valid:
                    valid <- false if snapshot.actors[index].live and (snapshot.actors[index].id <= 0 or snapshot.actors[index].health < 0 or registry_matches(snapshot, snapshot.actors[index].id, World::StorageKind.Actor) != 1)
            return false if not actors_valid
            enemies_valid: bool =
                for index in 0..<snapshot.enemy_count |valid: bool = true| -> valid:
                    valid <- false if snapshot.enemies[index].live and (snapshot.enemies[index].id <= 0 or snapshot.enemies[index].threat < 0 or registry_matches(snapshot, snapshot.enemies[index].id, World::StorageKind.Enemy) != 1)
            return false if not enemies_valid
            for index in 0..<snapshot.static_object_count |valid: bool = true| -> valid:
                valid <- false if snapshot.static_objects[index].live and (snapshot.static_objects[index].id <= 0 or registry_matches(snapshot, snapshot.static_objects[index].id, World::StorageKind.StaticObject) != 1)

        def capture(world: World::World&) -> Snapshot error[RollbackError]:
            raise RollbackError.InvalidSnapshot if not World::world_is_valid(world)
            raise RollbackError.InvalidSnapshot if not World::world_live_column_valid(world)
            snapshot: mutable Snapshot = Snapshot()
            snapshot.epoch <- world.epoch
            snapshot.registry_count <- world.registry_count
            snapshot.live_count <- world.live_count
            snapshot.live_ids_count <- world.live_ids_count
            snapshot.actor_count <- world.actor_count
            snapshot.enemy_count <- world.enemy_count
            snapshot.static_object_count <- world.static_object_count
            snapshot.hierarchy <- WorldHierarchy::hierarchy_snapshot(&world.hierarchy)
            for index in 0..<Bounds::MAX_ENTITIES |snapshot, world|:
                snapshot.registry[index] <- world.registry[index]
                snapshot.live_ids[index] <- world.live_ids[index]
                snapshot.actors[index] <- world.actors[index]
                snapshot.enemies[index] <- world.enemies[index]
                snapshot.static_objects[index] <- world.static_objects[index]
            snapshot

        def restore(world: mutable World::World&, snapshot: Snapshot&) -> void error[RollbackError]:
            raise RollbackError.InvalidSnapshot if not snapshot_valid(snapshot)
            raise RollbackError.WrongWorld if world.epoch != snapshot.epoch
            for index in 0..<Bounds::MAX_ENTITIES |world, snapshot|:
                world.registry[index] <- snapshot.registry[index]
                world.live_ids[index] <- snapshot.live_ids[index]
                world.actors[index] <- snapshot.actors[index]
                world.enemies[index] <- snapshot.enemies[index]
                world.static_objects[index] <- snapshot.static_objects[index]
            restored_hierarchy: bool = WorldHierarchy::hierarchy_restore(&world.hierarchy, snapshot.hierarchy)
            raise RollbackError.InvalidSnapshot if not restored_hierarchy
            world.registry_count <- snapshot.registry_count
            world.live_count <- snapshot.live_count
            world.live_ids_count <- snapshot.live_ids_count
            world.actor_count <- snapshot.actor_count
            world.enemy_count <- snapshot.enemy_count
            world.static_object_count <- snapshot.static_object_count

        # Replace is the load boundary for a complete in-memory runtime world.
        # Validate and stage the current world first so a rejected replacement
        # cannot leave a partially restored registry or hierarchy behind.
        def replace(world: mutable World::World&, snapshot: Snapshot&) -> bool:
            current: Snapshot = catch capture(world):
                value: value
                error failure: return false
            replaced: bool = catch restore(world, snapshot):
                ok: true
                error failure: false
            return true if replaced
            _ = catch restore(world, &current):
                ok: true
                error failure: false
            false
