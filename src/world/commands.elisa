# Deferred structural mutation. A phase records values only; commit is the one
# boundary that accepts or rejects the complete batch.
include "./hierarchy.elisa"
include "./rollback.elisa"

module WorldCommands:
    public:
        const MAX_COMMANDS: usize = 128

        enum Kind:
            Spawn
            Despawn
            Reparent

        struct Command:
            kind: Kind
            id: i64
            parent: i64
            order: usize

        affine struct Buffer:
            private:
                commands: mutable Command[WorldCommands::MAX_COMMANDS]
                count: mutable usize

        const MAX_WORLD_COMMANDS: usize = 128

        struct WorldCommand:
            kind: Kind
            entity: World::EntityRef
            parent: World::EntityRef
            spawn_kind: World::Entity
            keep_world: bool

        affine struct WorldBuffer:
            private:
                commands: mutable WorldCommand[WorldCommands::MAX_WORLD_COMMANDS]
                count: mutable usize

        def Buffer() -> Buffer:
            Buffer{commands: zeroed, count: 0}

        def WorldBuffer() -> WorldBuffer:
            WorldBuffer{commands: zeroed, count: 0}

        def command_count(buffer: Buffer&) -> usize:
            buffer.count

        def world_command_count(buffer: WorldBuffer&) -> usize:
            buffer.count

        def append(buffer: mutable Buffer&, command: Command) -> bool:
            return false if buffer.count >= WorldCommands::MAX_COMMANDS or command.id <= 0
            buffer.commands[buffer.count] <- command
            buffer.count <- buffer.count + 1
            true

        def spawn(buffer: mutable Buffer&, id: i64) -> bool:
            append(buffer, Command{kind: Kind.Spawn, id: id, parent: 0, order: buffer.count})

        def despawn(buffer: mutable Buffer&, id: i64) -> bool:
            append(buffer, Command{kind: Kind.Despawn, id: id, parent: 0, order: buffer.count})

        def reparent(buffer: mutable Buffer&, id: i64, parent: i64) -> bool:
            return false if parent < 0 or parent == id
            append(buffer, Command{kind: Kind.Reparent, id: id, parent: parent, order: buffer.count})

        def batch_valid(buffer: Buffer&) -> bool:
            for index in 0..<buffer.count |valid: bool = true| -> valid:
                left: Command = buffer.commands[index]
                valid <- false if left.order != index
                duplicate_free: bool =
                    for earlier in 0..<index |inner: bool = true| -> inner:
                        right: Command = buffer.commands[earlier]
                        inner <- false if left.id == right.id
                valid <- valid and duplicate_free

        def spawn_count(buffer: Buffer&) -> usize:
            for index in 0..<buffer.count |spawns: usize = 0| -> spawns:
                spawns <- spawns + 1 if buffer.commands[index].kind == Kind.Spawn

        # Check the executor's free-slot budget before clearing the batch. An
        # allocation failure is therefore an atomic rejection and the caller
        # can retry or report every command without reconstructing the phase.
        def commit_with_capacity(buffer: mutable Buffer&, free_slots: usize) -> bool:
            return false if not batch_valid(buffer) or spawn_count(buffer) > free_slots
            buffer.count <- 0
            true

        def commit(buffer: mutable Buffer&) -> bool:
            commit_with_capacity(buffer, WorldCommands::MAX_COMMANDS)

        def world_spawn(buffer: mutable WorldBuffer&, kind: World::Entity) -> bool:
            return false if kind is World::Entity.Unknown or buffer.count >= WorldCommands::MAX_WORLD_COMMANDS
            buffer.commands[buffer.count] <- WorldCommand{
                kind: Kind.Spawn,
                entity: World::EntityRef{world_epoch: -1, id: -1},
                parent: World::EntityRef{world_epoch: -1, id: -1},
                spawn_kind: kind,
                keep_world: false,
            }
            buffer.count <- buffer.count + 1
            true

        def world_despawn(buffer: mutable WorldBuffer&, entity: World::EntityRef) -> bool:
            return false if entity.world_epoch <= 0 or entity.id <= 0 or buffer.count >= WorldCommands::MAX_WORLD_COMMANDS
            buffer.commands[buffer.count] <- WorldCommand{
                kind: Kind.Despawn,
                entity: entity,
                parent: World::EntityRef{world_epoch: -1, id: -1},
                spawn_kind: World::Entity.Unknown,
                keep_world: false,
            }
            buffer.count <- buffer.count + 1
            true

        def world_reparent(buffer: mutable WorldBuffer&, entity: World::EntityRef,
            parent: World::EntityRef, keep_world: bool) -> bool:
            return false if entity.world_epoch <= 0 or entity.id <= 0 or parent.world_epoch <= 0 or parent.id < WorldHierarchy::ROOT or buffer.count >= WorldCommands::MAX_WORLD_COMMANDS
            buffer.commands[buffer.count] <- WorldCommand{
                kind: Kind.Reparent,
                entity: entity,
                parent: parent,
                spawn_kind: World::Entity.Unknown,
                keep_world: keep_world,
            }
            buffer.count <- buffer.count + 1
            true

        private:
            def world_command_valid(world: World::World&, command: WorldCommand) -> bool:
                match command.kind:
                    Kind.Spawn:
                        not (command.spawn_kind is World::Entity.Unknown) and World::world_live_count(world) < World::MAX_ENTITIES
                    Kind.Despawn:
                        World::world_is_live(world, command.entity)
                    Kind.Reparent:
                        World::world_can_reparent(world, command.entity, command.parent)

            def world_commands_conflict(left: WorldCommand, right: WorldCommand) -> bool:
                left.kind != Kind.Spawn and right.kind != Kind.Spawn and left.entity.world_epoch == right.entity.world_epoch and left.entity.id == right.entity.id

            def world_batch_valid(buffer: WorldBuffer&, world: World::World&) -> bool:
                for index in 0..<buffer.count |valid: bool = true| -> valid:
                    valid <- false if not world_command_valid(world, buffer.commands[index])
                    duplicate_free: bool =
                        for earlier in 0..<index |inner: bool = true| -> inner:
                            inner <- false if world_commands_conflict(buffer.commands[index], buffer.commands[earlier])
                    valid <- valid and duplicate_free

            def restore_world_snapshot(world: mutable World::World&, snapshot: World::Rollback::Snapshot&) -> bool:
                catch World::Rollback::restore(world, snapshot):
                    ok: true
                    error failure: false

            def apply_world_command(world: mutable World::World&, command: WorldCommand) -> bool:
                match command.kind:
                    Kind.Spawn:
                        spawned: World::EntityRef = catch World::world_spawn(world, command.spawn_kind):
                            value: value
                            error failure: World::EntityRef{world_epoch: -1, id: -1}
                        spawned.id > 0
                    Kind.Despawn:
                        removed: bool = catch World::world_despawn(world, command.entity):
                            ok: true
                            error failure: false
                        removed
                    Kind.Reparent:
                        reparented: bool = catch World::world_reparent(world, command.entity, command.parent, command.keep_world):
                            ok: true
                            error failure: false
                        reparented

        public:
            def commit_world(buffer: mutable WorldBuffer&, world: mutable World::World&) -> bool:
                return false if buffer.count > WorldCommands::MAX_WORLD_COMMANDS
                return false if not world_batch_valid(buffer, world)
                snapshot: mutable World::Rollback::Snapshot = catch World::Rollback::capture(world):
                    value: World::Rollback::Snapshot()
                    error failure: return false
                accepted: mutable bool = true
                for index in 0..<buffer.count |accepted|:
                    accepted <- apply_world_command(world, buffer.commands[index]) if accepted
                if not accepted:
                    restored: bool = restore_world_snapshot(world, &snapshot)
                    return false if not restored
                    return false
                buffer.count <- 0
                true

        private:
            def apply_hierarchy_command(hierarchy: mutable WorldHierarchy::Hierarchy&, command: Command) -> bool:
                match command.kind:
                    Kind.Spawn:
                        WorldHierarchy::hierarchy_spawn(hierarchy, command.id, Geometry::transform_identity())
                    Kind.Despawn:
                        WorldHierarchy::hierarchy_remove(hierarchy, command.id)
                    Kind.Reparent:
                        WorldHierarchy::hierarchy_set_parent(hierarchy, command.id, command.parent, false)

        public:
            # A hierarchy snapshot makes the whole phase atomic: a failed
            # parent, cycle, duplicate spawn, or missing despawn restores the
            # exact pre-commit structure and leaves the commands available for
            # correction or retry.
            def commit_hierarchy(buffer: mutable Buffer&, hierarchy: mutable WorldHierarchy::Hierarchy&) -> bool:
                return false if not batch_valid(buffer)
                snapshot: WorldHierarchy::Snapshot = WorldHierarchy::hierarchy_snapshot(hierarchy)
                accepted: mutable bool = true
                for index in 0..<buffer.count |accepted, hierarchy|:
                    accepted <- apply_hierarchy_command(hierarchy, buffer.commands[index]) if accepted
                if not accepted:
                    _ = WorldHierarchy::hierarchy_restore(hierarchy, snapshot)
                    return false
                buffer.count <- 0
                true
