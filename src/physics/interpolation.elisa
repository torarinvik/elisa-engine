# Fixed-step pose publication. Simulation commits complete poses; rendering
# reads an interpolated value and never advances the authoritative tick.
include "../math/geometry.elisa"

module PhysicsInterpolation:
    private:
        const module Limits:
            MIN_ALPHA: f32 = 0.0
            MAX_ALPHA: f32 = 1.0

        def blend(start: f32, finish: f32, alpha: f32) -> f32:
            start + (finish - start) * alpha

        def quat_dot(left: Geometry::Quat, right: Geometry::Quat) -> f32:
            left.x * right.x + left.y * right.y + left.z * right.z + left.w * right.w

        def quat_negate(value: Geometry::Quat) -> Geometry::Quat:
            Geometry::Quat{x: 0.0 - value.x, y: 0.0 - value.y,
                z: 0.0 - value.z, w: 0.0 - value.w}

        # q and -q encode the same orientation. Flip the destination when the
        # dot product is negative so normalized linear interpolation follows
        # the shortest arc instead of rotating almost a full revolution.
        def quat_blend(start: Geometry::Quat, finish: Geometry::Quat, alpha: f32) -> Geometry::Quat:
            endpoint: Geometry::Quat = finish if quat_dot(start, finish) >= 0.0 else quat_negate(finish)
            Geometry::quat_normalize(Geometry::Quat{
                x: blend(start.x, endpoint.x, alpha),
                y: blend(start.y, endpoint.y, alpha),
                z: blend(start.z, endpoint.z, alpha),
                w: blend(start.w, endpoint.w, alpha),
            })

        def transform_blend(start: Geometry::Transform, finish: Geometry::Transform, alpha: f32) -> Geometry::Transform:
            Geometry::Transform{
                position: Geometry::Vec3{
                    x: blend(start.position.x, finish.position.x, alpha),
                    y: blend(start.position.y, finish.position.y, alpha),
                    z: blend(start.position.z, finish.position.z, alpha),
                },
                rotation: quat_blend(start.rotation, finish.rotation, alpha),
                scale: Geometry::Vec3{
                    x: blend(start.scale.x, finish.scale.x, alpha),
                    y: blend(start.scale.y, finish.scale.y, alpha),
                    z: blend(start.scale.z, finish.scale.z, alpha),
                },
            }

    public:
        affine struct Buffer:
            private:
                previous: mutable Geometry::Transform
                current: mutable Geometry::Transform
                tick: mutable i64
                initialized: mutable bool
                teleported: mutable bool

        def Buffer(initial: Geometry::Transform) -> Buffer:
            Buffer{previous: initial, current: initial, tick: 0, initialized: true, teleported: false}

        def commit(buffer: mutable Buffer&, pose: Geometry::Transform, tick: i64, teleport: bool) -> bool:
            return false if tick <= buffer.tick or not Geometry::vec3_is_finite(pose.position) or not Geometry::quat_is_finite(pose.rotation)
            buffer.previous <- buffer.current if not teleport else pose
            buffer.current <- pose
            buffer.tick <- tick
            buffer.teleported <- teleport
            buffer.initialized <- true
            true

        def sample(buffer: Buffer&, alpha: f32) -> Geometry::Transform:
            return buffer.current if not buffer.initialized or buffer.teleported or alpha <= Limits::MIN_ALPHA
            return buffer.current if alpha >= Limits::MAX_ALPHA
            transform_blend(buffer.previous, buffer.current, alpha)

        # Stateless form for owners that keep their snapshots in a larger
        # value. Keeping the buffer fields private prevents backend code from
        # depending on the interpolation representation.
        def sample_pair(previous: Geometry::Transform, current: Geometry::Transform,
            teleported: bool, alpha: f32) -> Geometry::Transform:
            return current if teleported or alpha <= Limits::MIN_ALPHA
            return current if alpha >= Limits::MAX_ALPHA
            transform_blend(previous, current, alpha)

        def last_tick(buffer: Buffer&) -> i64:
            buffer.tick

        def clear_teleport(buffer: mutable Buffer&) -> void:
            buffer.teleported <- false

        def interpolation_valid(buffer: Buffer&) -> bool:
            buffer.initialized and buffer.tick >= 0 and Geometry::vec3_is_finite(buffer.current.position) and Geometry::quat_is_finite(buffer.current.rotation)
