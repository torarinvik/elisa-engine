# Continuous collision for 2D circles against one-sided slanted segments
# (ramps and sloped roofs), complementing the axis-aligned walls and
# platforms in ccd2d.elisa. The solid side is to the right of a -> b, so a
# ramp authored left to right is solid below. A circle whose centre starts in
# front of the segment and would end closer is stopped at the
# contact and its normal speed is reflected with restitution, keeping the
# tangential speed, so a ball rolls on down a slope instead of tunnelling.
# Positions are micrometres (segments up to 10 m keep products in i64).
include "./ccd2d.elisa"

module Physics2dRamp:
    public:
        struct Segment:
            ax_um: i64
            ay_um: i64
            bx_um: i64
            by_um: i64

        struct Contact:
            hit: bool
            t_permille: i64
            # Placement fraction in millionths, so a fast body stops within a
            # micrometre-scale gap rather than a permille of its travel.
            t_ppm: i64
            # Contact normal (any length) pointing from the surface to the circle.
            nx: i64
            ny: i64

        def length_um(s: Segment&) -> i64:
            tx: i64 = s.bx_um - s.ax_um
            ty: i64 = s.by_um - s.ay_um
            Physics2dCircles::isqrt(tx * tx + ty * ty)

        # Signed distance of a point in front of the segment's line, in um.
        def distance_um(s: Segment&, x: i64, y: i64) -> i64:
            l: i64 = length_um(s)
            return 0 if l == 0
            nx: i64 = 0 - (s.by_um - s.ay_um)
            ny: i64 = s.bx_um - s.ax_um
            (nx * (x - s.ax_um) + ny * (y - s.ay_um)) / l

        # The face of the segment: the circle's front side meeting its line
        # within the segment's length.
        def sweep_face(c: Physics2dCircles::Circle&, dx: i64, dy: i64, s: Segment&) -> Contact:
            miss: Contact = Contact{hit: false, t_permille: 1000, t_ppm: 1000000, nx: 0, ny: 0}
            l: i64 = length_um(s)
            return miss if l == 0
            d0: i64 = distance_um(s, c.x_um, c.y_um)
            d1: i64 = distance_um(s, c.x_um + dx, c.y_um + dy)
            # A circle resting in contact (centre in front, within a radius)
            # and still pressing in is stopped at once; one behind is ignored.
            return miss if d0 < 0 or d1 >= c.radius_um or d1 >= d0
            raw: i64 = (d0 - c.radius_um) * 1000000 / (d0 - d1)
            t: i64 = raw if raw > 0 else 0
            px: i64 = c.x_um + dx * t / 1000000
            py: i64 = c.y_um + dy * t / 1000000
            along: i64 = ((s.bx_um - s.ax_um) * (px - s.ax_um) + (s.by_um - s.ay_um) * (py - s.ay_um)) / l
            return miss if along < 0 or along > l
            Contact{hit: true, t_permille: t / 1000, t_ppm: t, nx: 0 - (s.by_um - s.ay_um), ny: s.bx_um - s.ax_um}

        # A rounded end of the segment: the circle's swept disc meeting the
        # point (qx, qy), solved as a quadratic in millimetres (1 mm
        # resolution keeps every product inside i64 for 10 m scenes). Caps
        # are solid from every side, so a body clipping a ramp's tip or
        # grazing its underside corner is stopped.
        def sweep_cap(c: Physics2dCircles::Circle&, dx: i64, dy: i64, qx: i64, qy: i64) -> Contact:
            miss: Contact = Contact{hit: false, t_permille: 1000, t_ppm: 1000000, nx: 0, ny: 0}
            px: i64 = (c.x_um - qx) / 1000
            py: i64 = (c.y_um - qy) / 1000
            mx: i64 = dx / 1000
            my: i64 = dy / 1000
            r: i64 = c.radius_um / 1000
            qa: i64 = mx * mx + my * my
            qb: i64 = px * mx + py * my
            qc: i64 = px * px + py * py - r * r
            return miss if qa == 0 or qb >= 0
            if qc <= 0:
                return Contact{hit: true, t_permille: 0, t_ppm: 0, nx: px, ny: py}
            disc: i64 = qb * qb - qa * qc
            return miss if disc < 0
            num: i64 = 0 - qb - Physics2dCircles::isqrt(disc)
            return miss if num < 0 or num > qa
            t: i64 = num * 1000000 / qa
            Contact{hit: true, t_permille: t / 1000, t_ppm: t, nx: px + mx * t / 1000000, ny: py + my * t / 1000000}

        def earlier(a: Contact, b: Contact) -> Contact:
            return b if not a.hit
            return a if not b.hit
            b if b.t_ppm < a.t_ppm else a

        # The earliest contact with the segment's face or either end cap.
        def sweep(c: Physics2dCircles::Circle&, dx: i64, dy: i64, s: Segment&) -> Contact:
            face: Contact = sweep_face(c, dx, dy, s)
            return face if face.hit
            cap_a: Contact = sweep_cap(c, dx, dy, s.ax_um, s.ay_um)
            cap_b: Contact = sweep_cap(c, dx, dy, s.bx_um, s.by_um)
            earlier(cap_a, cap_b)

        # Reflects the velocity component (um/s) along the contact normal.
        def bounce(c: mutable Physics2dCircles::Circle&, nx: i64, ny: i64, restitution_permille: i64) -> void:
            l: i64 = Physics2dCircles::isqrt(nx * nx + ny * ny)
            if l > 0:
                vn: i64 = (c.vx * nx + c.vy * ny) / l
                if vn < 0:
                    k: i64 = vn * (1000 + restitution_permille) / 1000
                    c.vx <- c.vx - k * nx / l
                    c.vy <- c.vy - k * ny / l

        # A scene's static 2D geometry: walls, platforms and ramps.
        struct Statics:
            walls: Physics2dCcd::Wall[4]
            wall_count: i64
            platforms: Physics2dCcd::Platform[4]
            platform_count: i64
            ramps: Segment[4]
            ramp_count: i64

        def open() -> Statics:
            Statics{walls: zeroed, wall_count: 0, platforms: zeroed, platform_count: 0, ramps: zeroed, ramp_count: 0}

        # Moves `c` through `remaining_ppm` millionths of a `dt_ms` step,
        # stopping at the earliest contact of any kind (walls and platforms
        # reflect their axis, ramps their normal). Returns the millionths
        # still left after a contact, or -1 when the move finished freely.
        def advance(c: mutable Physics2dCircles::Circle&, st: Statics&, dt_ms: i64, remaining_ppm: i64, restitution_permille: i64) -> i64:
            dx: i64 = c.vx * dt_ms / 1000 * remaining_ppm / 1000000
            dy: i64 = c.vy * dt_ms / 1000 * remaining_ppm / 1000000
            mutable best_ppm: i64 = 1000001
            mutable kind: i64 = 0
            mutable normal_x: i64 = 0
            mutable normal_y: i64 = 0
            mutable travel: i64 = 0
            for i in 0..<4 |best_ppm, kind, normal_x, normal_y, travel|:
                if i.i64() < st.wall_count:
                    h: Physics2dCcd::Hit = Physics2dCcd::sweep(c, dx, dy, &st.walls[i])
                    if h.hit and h.t_permille * 1000 < best_ppm:
                        best_ppm <- h.t_permille * 1000
                        kind <- 1
                        travel <- h.travel_um
                if i.i64() < st.platform_count:
                    h: Physics2dCcd::Hit = Physics2dCcd::sweep_platform(c, dx, dy, &st.platforms[i])
                    if h.hit and h.t_permille * 1000 < best_ppm:
                        best_ppm <- h.t_permille * 1000
                        kind <- 2
                        travel <- h.travel_um
                if i.i64() < st.ramp_count:
                    r: Contact = sweep(c, dx, dy, &st.ramps[i])
                    if r.hit and r.t_ppm < best_ppm:
                        best_ppm <- r.t_ppm
                        kind <- 3
                        normal_x <- r.nx
                        normal_y <- r.ny
            if kind == 0:
                c.x_um <- c.x_um + dx
                c.y_um <- c.y_um + dy
                return 0 - 1
            if kind == 1:
                c.x_um <- c.x_um + travel
                c.y_um <- c.y_um + dy * best_ppm / 1000000
                c.vx <- 0 - c.vx * restitution_permille / 1000
            elif kind == 2:
                c.y_um <- c.y_um + travel
                c.x_um <- c.x_um + dx * best_ppm / 1000000
                c.vy <- 0 - c.vy * restitution_permille / 1000
            else:
                c.x_um <- c.x_um + dx * best_ppm / 1000000
                c.y_um <- c.y_um + dy * best_ppm / 1000000
                bounce(c, normal_x, normal_y, restitution_permille)
            remaining_ppm - remaining_ppm * best_ppm / 1000000

        # One semi-implicit step against all static geometry. After a contact
        # the rest of the step continues with the reflected velocity (up to
        # three contacts), so a body resting on a ramp slides instead of
        # sticking. Returns true on any hit.
        def step_statics(c: mutable Physics2dCircles::Circle&, st: Statics&, gravity_um_s2: i64, dt_ms: i64, restitution_permille: i64) -> bool:
            return false if c.mass_g <= 0 or dt_ms <= 0
            c.vy <- c.vy - gravity_um_s2 * dt_ms / 1000
            first: i64 = advance(c, st, dt_ms, 1000000, restitution_permille)
            return false if first < 0
            second: i64 = advance(c, st, dt_ms, first, restitution_permille) if first > 0 else 0 - 1
            _ = advance(c, st, dt_ms, second, restitution_permille) if second > 0 else 0 - 1
            true

        # Step against ramps only.
        def step(c: mutable Physics2dCircles::Circle&, ramps: Segment[4], count: i64, gravity_um_s2: i64, dt_ms: i64, restitution_permille: i64) -> bool:
            st: Statics = Statics{walls: zeroed, wall_count: 0, platforms: zeroed, platform_count: 0, ramps: ramps, ramp_count: count}
            step_statics(c, &st, gravity_um_s2, dt_ms, restitution_permille)
