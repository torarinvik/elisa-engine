# Opt-in Elisa-owned fixed-step physics world backed by the native Jolt host.
include "../math/geometry.elisa"

module PhysicsRuntime:
    private:
        const module Status:
            OK: i32 = 0
            INVALID_ARGUMENT: i32 = -1
            INVALID_STATE: i32 = -2
            WRONG_THREAD: i32 = -3
            CAPACITY: i32 = -4
            INVALID_HANDLE: i32 = -5
            BACKEND_FAILURE: i32 = -6
            STALE_WORLD: i32 = -7
            BODY_STATIC: i32 = 0
            BODY_KINEMATIC: i32 = 1
            BODY_DYNAMIC: i32 = 2

        @callconv(c)
        extern elisa_physics_v1_initialize(world_generation: mutable u64&) -> i32

        @callconv(c)
        extern elisa_physics_v1_create_box(world_generation: u64, kind: i32,
            position_x: f32, position_y: f32, position_z: f32,
            half_x: f32, half_y: f32, half_z: f32, mass: f32,
            slot: mutable u32&, body_generation: mutable u64&) -> i32

        @callconv(c)
        extern elisa_physics_v1_fixed_step(world_generation: u64,
            delta_seconds: f32, tick: mutable u64&) -> i32

        @callconv(c)
        extern elisa_physics_v1_body_position(world_generation: u64, slot: u32,
            body_generation: u64, x: mutable f32&, y: mutable f32&, z: mutable f32&) -> i32

        @callconv(c)
        extern elisa_physics_v1_set_sleeping(world_generation: u64, slot: u32,
            body_generation: u64, sleeping: i32) -> i32

        @callconv(c)
        extern elisa_physics_v1_set_kinematic_target(world_generation: u64, slot: u32,
            body_generation: u64, position_x: f32, position_y: f32, position_z: f32,
            rotation_x: f32, rotation_y: f32, rotation_z: f32, rotation_w: f32) -> i32

        @callconv(c)
        extern elisa_physics_v1_destroy_body(world_generation: u64,
            slot: u32, body_generation: u64) -> i32

        @callconv(c)
        extern elisa_physics_v1_shutdown(world_generation: u64) -> i32

        def check_status(status: i32) -> void error[PhysicsError]:
            raise PhysicsError.InvalidArgument if status == Status::INVALID_ARGUMENT
            raise PhysicsError.ApplicationUnavailable if status == Status::INVALID_STATE
            raise PhysicsError.WrongThread if status == Status::WRONG_THREAD
            raise PhysicsError.Capacity if status == Status::CAPACITY
            raise PhysicsError.InvalidHandle if status == Status::INVALID_HANDLE
            raise PhysicsError.BackendFailure if status == Status::BACKEND_FAILURE
            raise PhysicsError.StaleWorld if status == Status::STALE_WORLD
            raise PhysicsError.BackendFailure if status != Status::OK

        def kind_code(kind: BodyKind) -> i32:
            match kind:
                BodyKind.Static:
                    Status::BODY_STATIC
                BodyKind.Kinematic:
                    Status::BODY_KINEMATIC
                BodyKind.Dynamic:
                    Status::BODY_DYNAMIC

    public:
        enum BodyKind:
            Static
            Kinematic
            Dynamic

        error PhysicsError:
            InvalidArgument
            ApplicationUnavailable
            WrongThread
            Capacity
            InvalidHandle
            StaleWorld
            BackendFailure

        struct BodyDesc:
            kind: BodyKind
            position: Geometry::Vec3
            half_extents: Geometry::Vec3
            mass: f32

        struct BodyHandle:
            private:
                world_generation: u64
                slot: u32
                generation: u64

        affine struct World:
            private:
                generation: u64
                tick: mutable u64
                live: mutable bool

        # A plain owner record for composite affine services such as
        # RuntimeServices::Session. The enclosing affine session owns this
        # value and passes it through the same operations as World.
        struct ServiceState:
            private:
                generation: mutable u64
                tick: mutable u64
                live: mutable bool

        # PhysicsRuntime owns initialization and copies of native-backed
        # handles. Other modules retain this affine pool without exposing or
        # zero-initializing BodyHandle's private generation fields.
        module ServiceBodyHandles:
            public:
                const CAPACITY: usize = 128

                affine struct Pool:
                    private:
                        values: mutable BodyHandle[PhysicsRuntime::ServiceBodyHandles::CAPACITY]
                        live: mutable bool[PhysicsRuntime::ServiceBodyHandles::CAPACITY]

                def Pool() -> Pool:
                    Pool{values: zeroed, live: zeroed}

                def store(handles: mutable Pool&, index: usize,
                    body: BodyHandle) -> bool:
                    return false if index >= PhysicsRuntime::ServiceBodyHandles::CAPACITY
                    handles.values[index] <- body
                    handles.live[index] <- true
                    true

                def get(handles: Pool&, index: usize) -> BodyHandle error[PhysicsRuntime::PhysicsError]:
                    raise PhysicsRuntime::PhysicsError.InvalidHandle if index >= PhysicsRuntime::ServiceBodyHandles::CAPACITY or not handles.live[index]
                    handles.values[index]

                def move(handles: mutable Pool&, source: usize, destination: usize) -> bool:
                    return false if source >= PhysicsRuntime::ServiceBodyHandles::CAPACITY or destination >= PhysicsRuntime::ServiceBodyHandles::CAPACITY or not handles.live[source]
                    handles.values[destination] <- handles.values[source]
                    handles.live[destination] <- true
                    handles.live[source] <- false
                    true

                def clear(handles: mutable Pool&, index: usize) -> void:
                    handles.live[index] <- false if index < PhysicsRuntime::ServiceBodyHandles::CAPACITY

        def ServiceState() -> ServiceState:
            ServiceState{generation: 0, tick: 0, live: false}

        def World() -> World error[PhysicsError]:
            generation: mutable u64 = 0
            status: i32 = elisa_physics_v1_initialize(&generation)
            try check_status(status)
            World{generation: generation, tick: 0, live: true}

        def service_initialize(state: mutable ServiceState&) -> void error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if state.live
            generation: mutable u64 = 0
            try check_status(elisa_physics_v1_initialize(&generation))
            state.generation <- generation
            state.tick <- 0
            state.live <- true

        def service_fixed_step(state: mutable ServiceState&,
            delta_seconds: f32) -> u64 error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if not state.live
            tick: mutable u64 = 0
            try check_status(elisa_physics_v1_fixed_step(state.generation,
                delta_seconds, &tick))
            state.tick <- tick
            tick

        def service_body_create(state: ServiceState&,
            description: BodyDesc) -> BodyHandle error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if not state.live
            slot: mutable u32 = 0
            generation: mutable u64 = 0
            status: i32 = elisa_physics_v1_create_box(state.generation,
                kind_code(description.kind), description.position.x, description.position.y,
                description.position.z, description.half_extents.x, description.half_extents.y,
                description.half_extents.z, description.mass, &slot, &generation)
            try check_status(status)
            BodyHandle{world_generation: state.generation, slot: slot, generation: generation}

        def service_body_position(state: ServiceState&,
            body: BodyHandle) -> Geometry::Vec3 error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if not state.live
            raise PhysicsError.StaleWorld if body.world_generation != state.generation
            x: mutable f32 = 0.0
            y: mutable f32 = 0.0
            z: mutable f32 = 0.0
            status: i32 = elisa_physics_v1_body_position(state.generation,
                body.slot, body.generation, &x, &y, &z)
            try check_status(status)
            Geometry::Vec3{x: x, y: y, z: z}

        def service_body_set_kinematic_target(state: ServiceState&,
            body: BodyHandle, target: Geometry::Transform) -> void error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if not state.live
            raise PhysicsError.StaleWorld if body.world_generation != state.generation
            status: i32 = elisa_physics_v1_set_kinematic_target(state.generation, body.slot,
                body.generation, target.position.x, target.position.y, target.position.z,
                target.rotation.x, target.rotation.y, target.rotation.z, target.rotation.w)
            try check_status(status)

        def service_body_set_sleeping(state: ServiceState&, body: BodyHandle,
            sleeping: bool) -> void error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if not state.live
            raise PhysicsError.StaleWorld if body.world_generation != state.generation
            status: i32 = elisa_physics_v1_set_sleeping(state.generation, body.slot,
                body.generation, 1 if sleeping else 0)
            try check_status(status)

        def service_body_destroy(state: ServiceState&,
            body: BodyHandle) -> void error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if not state.live
            raise PhysicsError.StaleWorld if body.world_generation != state.generation
            status: i32 = elisa_physics_v1_destroy_body(state.generation,
                body.slot, body.generation)
            try check_status(status)

        def service_shutdown(state: mutable ServiceState&) -> void error[PhysicsError]:
            return if not state.live
            try check_status(elisa_physics_v1_shutdown(state.generation))
            state.live <- false

        # Forget the local token after the owning Application has force-closed
        # native providers. No native call is made here.
        def service_reset(state: mutable ServiceState&) -> void:
            state.generation <- 0
            state.tick <- 0
            state.live <- false

        def service_is_live(state: ServiceState&) -> bool:
            state.live

        def fixed_step(world: mutable World&, delta_seconds: f32) -> u64 error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if not world.live
            tick: mutable u64 = 0
            status: i32 = elisa_physics_v1_fixed_step(world.generation, delta_seconds, &tick)
            try check_status(status)
            world.tick <- tick
            tick

        def committed_tick(world: World&) -> u64:
            world.tick

        def body_create(world: World&, description: BodyDesc) -> BodyHandle error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if not world.live
            slot: mutable u32 = 0
            generation: mutable u64 = 0
            status: i32 = elisa_physics_v1_create_box(world.generation,
                kind_code(description.kind), description.position.x, description.position.y,
                description.position.z, description.half_extents.x, description.half_extents.y,
                description.half_extents.z, description.mass, &slot, &generation)
            try check_status(status)
            BodyHandle{world_generation: world.generation, slot: slot, generation: generation}

        def body_position(world: World&, body: BodyHandle) -> Geometry::Vec3 error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if not world.live
            raise PhysicsError.StaleWorld if body.world_generation != world.generation
            x: mutable f32 = 0.0
            y: mutable f32 = 0.0
            z: mutable f32 = 0.0
            status: i32 = elisa_physics_v1_body_position(world.generation,
                body.slot, body.generation, &x, &y, &z)
            try check_status(status)
            Geometry::Vec3{x: x, y: y, z: z}

        def body_set_kinematic_target(world: World&, body: BodyHandle,
            target: Geometry::Transform) -> void error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if not world.live
            raise PhysicsError.StaleWorld if body.world_generation != world.generation
            status: i32 = elisa_physics_v1_set_kinematic_target(world.generation, body.slot,
                body.generation, target.position.x, target.position.y, target.position.z,
                target.rotation.x, target.rotation.y, target.rotation.z, target.rotation.w)
            try check_status(status)

        def body_set_sleeping(world: World&, body: BodyHandle,
            sleeping: bool) -> void error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if not world.live
            raise PhysicsError.StaleWorld if body.world_generation != world.generation
            status: i32 = elisa_physics_v1_set_sleeping(world.generation, body.slot,
                body.generation, 1 if sleeping else 0)
            try check_status(status)

        def body_destroy(world: World&, body: BodyHandle) -> void error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if not world.live
            raise PhysicsError.StaleWorld if body.world_generation != world.generation
            status: i32 = elisa_physics_v1_destroy_body(world.generation,
                body.slot, body.generation)
            try check_status(status)

        def shutdown(world: mutable World&) -> void error[PhysicsError]:
            return if not world.live
            status: i32 = elisa_physics_v1_shutdown(world.generation)
            try check_status(status)
            world.live <- false
