# Opt-in Elisa-owned fixed-step physics world backed by the native Jolt host.
include "../math/geometry.elisa"

module PhysicsRuntime:
    private:
        const module Status:
            OK: i32 = 0
            INVALID_ARGUMENT: i32 = -1
            INVALID_STATE: i32 = -2
            WRONG_THREAD: i32 = -3
            CAPACITY: i32 = -4
            INVALID_HANDLE: i32 = -5
            BACKEND_FAILURE: i32 = -6
            STALE_WORLD: i32 = -7
            SHAPE_IN_USE: i32 = -8
            BODY_NOT_READY: i32 = -9
            ASSET_LOAD_FAILED: i32 = -10
            CONFIGURATION_LOCKED: i32 = -11
            BODY_STATIC: i32 = 0
            BODY_KINEMATIC: i32 = 1
            BODY_DYNAMIC: i32 = 2
            SHAPE_BOX: i32 = 0
            SHAPE_SPHERE: i32 = 1
            SHAPE_CAPSULE: i32 = 2
            MESH_SHAPE_TRIANGLE_MESH: i32 = 3
            MESH_SHAPE_CONVEX_HULL: i32 = 4
            MAX_MESH_VERTICES: usize = 65536
            MAX_MESH_INDICES: usize = 196608

        const CONTACT_ADDED: i32 = 0
        const CONTACT_PERSISTED: i32 = 1
        const CONTACT_REMOVED: i32 = 2

        @callconv(c)
        extern elisa_physics_v1_initialize(world_generation: mutable u64&) -> i32

        @callconv(c)
        extern elisa_physics_v1_create_body(world_generation: u64, kind: i32,
            shape: i32,
            position_x: f32, position_y: f32, position_z: f32,
            rotation_x: f32, rotation_y: f32, rotation_z: f32, rotation_w: f32,
            dimension_x: f32, dimension_y: f32, dimension_z: f32, mass: f32,
            sensor: i32, collision_layer: u32,
            slot: mutable u32&, body_generation: mutable u64&) -> i32

        include "./runtime_reusable_shapes_abi_declarations.inc"

        @callconv(c)
        extern elisa_physics_v1_fixed_step(world_generation: u64,
            delta_seconds: f32, tick: mutable u64&) -> i32

        @callconv(c)
        extern elisa_physics_v1_raycast(world_generation: u64,
            origin_x: f32, origin_y: f32, origin_z: f32,
            direction_x: f32, direction_y: f32, direction_z: f32,
            max_distance: f32, layer_mask: u32,
            entity: mutable u64&, position_x: mutable f32&, position_y: mutable f32&,
            position_z: mutable f32&, normal_x: mutable f32&, normal_y: mutable f32&,
            normal_z: mutable f32&, distance: mutable f32&, hit: mutable i32&) -> i32

        include "./runtime_ray_abi_types.inc"

        @callconv(c)
        extern elisa_physics_v1_raycast_all(world_generation: u64,
            origin_x: f32, origin_y: f32, origin_z: f32,
            direction_x: f32, direction_y: f32, direction_z: f32,
            max_distance: f32, layer_mask: u32,
            buffer: mutable NativeRayHitBuffer&) -> i32

        @callconv(c)
        extern elisa_physics_v1_contact_count(world_generation: u64,
            count: mutable u32&, dropped: mutable u32&) -> i32

        @callconv(c)
        extern elisa_physics_v1_contact_at(world_generation: u64, index: u32,
            entity_a: mutable u64&, entity_b: mutable u64&,
            position_x: mutable f32&, position_y: mutable f32&, position_z: mutable f32&,
            normal_x: mutable f32&, normal_y: mutable f32&, normal_z: mutable f32&,
            penetration_depth: mutable f32&, kind: mutable i32&, trigger: mutable i32&,
            sequence: mutable u64&) -> i32

        @callconv(c)
        extern elisa_physics_v1_clear_contacts(world_generation: u64) -> i32

        @callconv(c)
        extern elisa_physics_v1_body_position(world_generation: u64, slot: u32,
            body_generation: u64, x: mutable f32&, y: mutable f32&, z: mutable f32&) -> i32

        @callconv(c)
        extern elisa_physics_v1_set_sleeping(world_generation: u64, slot: u32,
            body_generation: u64, sleeping: i32) -> i32

        @callconv(c)
        extern elisa_physics_v1_set_kinematic_target(world_generation: u64, slot: u32,
            body_generation: u64, position_x: f32, position_y: f32, position_z: f32,
            rotation_x: f32, rotation_y: f32, rotation_z: f32, rotation_w: f32) -> i32

        @callconv(c)
        extern elisa_physics_v1_destroy_body(world_generation: u64,
            slot: u32, body_generation: u64) -> i32
        @callconv(c)
        extern elisa_physics_v1_shutdown(world_generation: u64) -> i32
        def check_status(status: i32) -> void error[PhysicsError]:
            raise PhysicsError.InvalidArgument if status == Status::INVALID_ARGUMENT
            raise PhysicsError.ApplicationUnavailable if status == Status::INVALID_STATE
            raise PhysicsError.WrongThread if status == Status::WRONG_THREAD
            raise PhysicsError.Capacity if status == Status::CAPACITY
            raise PhysicsError.InvalidHandle if status == Status::INVALID_HANDLE
            raise PhysicsError.BackendFailure if status == Status::BACKEND_FAILURE
            raise PhysicsError.StaleWorld if status == Status::STALE_WORLD
            raise PhysicsError.ShapeInUse if status == Status::SHAPE_IN_USE
            raise PhysicsError.BodyNotReady if status == Status::BODY_NOT_READY
            raise PhysicsError.AssetLoadFailed if status == Status::ASSET_LOAD_FAILED
            raise PhysicsError.ConfigurationLocked if status == Status::CONFIGURATION_LOCKED
            raise PhysicsError.BackendFailure if status != Status::OK
        def kind_code(kind: BodyKind) -> i32:
            match kind:
                BodyKind.Static:
                    Status::BODY_STATIC
                BodyKind.Kinematic:
                    Status::BODY_KINEMATIC
                BodyKind.Dynamic:
                    Status::BODY_DYNAMIC
        def shape_code(shape: BodyShape) -> i32:
            match shape:
                BodyShape.Box:
                    Status::SHAPE_BOX
                BodyShape.Sphere:
                    Status::SHAPE_SPHERE
                BodyShape.Capsule:
                    Status::SHAPE_CAPSULE
        include "./runtime_body_motion_abi.inc"
        include "./runtime_body_material_abi.inc"
        include "./runtime_body_inertia_abi.inc"
        include "./runtime_body_inertia_limits.inc"

    public:
        const MAX_CONTACT_EVENTS: usize = 64
        const MAX_RAY_HITS: usize = 16
        const ALL_LAYERS: u32 = 4294967295

        enum BodyKind:
            Static
            Kinematic
            Dynamic

        enum BodyShape:
            Box
            Sphere
            Capsule

        enum MeshShape:
            ConvexHull
            TriangleMesh


        enum ContactKind:
            Added
            Persisted
            Removed

        struct ContactEvent:
            entity_a: u64
            entity_b: u64
            position: Geometry::Vec3
            normal: Geometry::Vec3
            penetration_depth: f32
            kind: ContactKind
            trigger: bool
            sequence: u64

        struct ContactBuffer:
            events: mutable ContactEvent[64]

        struct RayHit:
            hit: bool
            entity: u64
            position: Geometry::Vec3
            normal: Geometry::Vec3
            distance: f32

        struct RayHitBuffer:
            hits: mutable RayHit[16]
            count: mutable usize

        def ContactBuffer() -> ContactBuffer:
            ContactBuffer{events: zeroed}

        def RayHitBuffer() -> RayHitBuffer:
            RayHitBuffer{hits: zeroed, count: 0}

        error PhysicsError:
            InvalidArgument
            ApplicationUnavailable
            WrongThread
            Capacity
            InvalidHandle
            StaleWorld
            ShapeInUse
            BodyNotReady
            ConfigurationLocked
            AssetLoadFailed
            BackendFailure

        struct BodyDesc:
            kind: BodyKind
            shape: BodyShape
            position: Geometry::Vec3
            rotation: Geometry::Quat
            # Box: half-extents. Sphere: x is radius. Capsule: x is radius,
            # y is the half-height of its straight cylindrical section.
            dimensions: Geometry::Vec3
            mass: f32
            sensor: bool
            collision_layer: u32

        include "./runtime_body_pose_types.inc"
        struct PhysicsMaterial:
            private:
                friction: f32
                restitution: f32

        include "./runtime_body_inertia_types.inc"

        def PhysicsMaterial(friction: f32, restitution: f32) -> PhysicsMaterial error[PhysicsError]:
            raise PhysicsError.InvalidArgument if not finite(friction) or friction < MaterialLimits::MIN_COEFFICIENT or friction > MaterialLimits::MAX_FRICTION or not finite(restitution) or restitution < MaterialLimits::MIN_COEFFICIENT or restitution > MaterialLimits::MAX_RESTITUTION
            PhysicsMaterial{friction: friction, restitution: restitution}

        struct BodyHandle:
            private:
                world_generation: u64
                slot: u32
                generation: u64

        affine struct World:
            private:
                generation: u64
                tick: mutable u64
                live: mutable bool

        # A plain owner record for composite affine services such as
        # RuntimeServices::Session. The enclosing affine session owns this
        # value and passes it through the same operations as World.
        struct ServiceState:
            private:
                generation: mutable u64
                tick: mutable u64
                live: mutable bool

        include "./runtime_layer_collision_api.inc"

        # PhysicsRuntime owns initialization and copies of native-backed
        # handles. Other modules retain this affine pool without exposing or
        # zero-initializing BodyHandle's private generation fields.
        module ServiceBodyHandles:
            public:
                const CAPACITY: usize = 128

                affine struct Pool:
                    private:
                        values: mutable BodyHandle[PhysicsRuntime::ServiceBodyHandles::CAPACITY]
                        live: mutable bool[PhysicsRuntime::ServiceBodyHandles::CAPACITY]

                def Pool() -> Pool:
                    Pool{values: zeroed, live: zeroed}

                def store(handles: mutable Pool&, index: usize,
                    body: BodyHandle) -> bool:
                    return false if index >= PhysicsRuntime::ServiceBodyHandles::CAPACITY
                    handles.values[index] <- body
                    handles.live[index] <- true
                    true

                def get(handles: Pool&, index: usize) -> BodyHandle error[PhysicsRuntime::PhysicsError]:
                    raise PhysicsRuntime::PhysicsError.InvalidHandle if index >= PhysicsRuntime::ServiceBodyHandles::CAPACITY or not handles.live[index]
                    handles.values[index]

                def move(handles: mutable Pool&, source: usize, destination: usize) -> bool:
                    return false if source >= PhysicsRuntime::ServiceBodyHandles::CAPACITY or destination >= PhysicsRuntime::ServiceBodyHandles::CAPACITY or not handles.live[source]
                    handles.values[destination] <- handles.values[source]
                    handles.live[destination] <- true
                    handles.live[source] <- false
                    true

                def clear(handles: mutable Pool&, index: usize) -> void:
                    handles.live[index] <- false if index < PhysicsRuntime::ServiceBodyHandles::CAPACITY

        def ServiceState() -> ServiceState:
            ServiceState{generation: 0, tick: 0, live: false}

        def World() -> World error[PhysicsError]:
            generation: mutable u64 = 0
            status: i32 = elisa_physics_v1_initialize(&generation)
            try check_status(status)
            World{generation: generation, tick: 0, live: true}

        def service_initialize(state: mutable ServiceState&) -> void error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if state.live
            generation: mutable u64 = 0
            try check_status(elisa_physics_v1_initialize(&generation))
            state.generation <- generation
            state.tick <- 0
            state.live <- true

        def service_fixed_step(state: mutable ServiceState&,
            delta_seconds: f32) -> u64 error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if not state.live
            tick: mutable u64 = 0
            try check_status(elisa_physics_v1_fixed_step(state.generation,
                delta_seconds, &tick))
            state.tick <- tick
            tick

        def service_raycast(state: ServiceState&, origin: Geometry::Vec3,
            direction: Geometry::Vec3, max_distance: f32, layer_mask: u32) -> RayHit error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if not state.live
            entity: mutable u64 = 0
            position_x: mutable f32 = 0.0
            position_y: mutable f32 = 0.0
            position_z: mutable f32 = 0.0
            normal_x: mutable f32 = 0.0
            normal_y: mutable f32 = 0.0
            normal_z: mutable f32 = 0.0
            distance: mutable f32 = 0.0
            hit: mutable i32 = 0
            try check_status(elisa_physics_v1_raycast(state.generation,
                origin.x, origin.y, origin.z, direction.x, direction.y, direction.z,
                max_distance, layer_mask, &entity, &position_x, &position_y, &position_z,
                &normal_x, &normal_y, &normal_z, &distance, &hit))
            RayHit{
                hit: hit != 0,
                entity: entity,
                position: Geometry::Vec3{x: position_x, y: position_y, z: position_z},
                normal: Geometry::Vec3{x: normal_x, y: normal_y, z: normal_z},
                distance: distance,
            }

        def service_raycast_all(state: ServiceState&, origin: Geometry::Vec3,
            direction: Geometry::Vec3, max_distance: f32, layer_mask: u32,
            buffer: mutable RayHitBuffer&) -> usize error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if not state.live
            native_buffer: mutable NativeRayHitBuffer = zeroed
            try check_status(elisa_physics_v1_raycast_all(state.generation,
                origin.x, origin.y, origin.z, direction.x, direction.y, direction.z,
                max_distance, layer_mask, &native_buffer))
            count: u32 = native_buffer.count
            raise PhysicsError.Capacity if count > PhysicsRuntime::MAX_RAY_HITS.u32()
            for index in 0..<count.usize() |buffer, native_buffer, index|:
                native_hit: NativeRayHit = native_buffer.hits[index]
                buffer.hits[index] <- RayHit{
                    hit: true,
                    entity: native_hit.entity,
                    position: Geometry::Vec3{x: native_hit.position_x,
                        y: native_hit.position_y, z: native_hit.position_z},
                    normal: Geometry::Vec3{x: native_hit.normal_x,
                        y: native_hit.normal_y, z: native_hit.normal_z},
                    distance: native_hit.distance,
                }
            buffer.count <- count.usize()
            buffer.count

        def service_poll_contacts(state: ServiceState&,
            buffer: ContactBuffer&, dropped: mutable u32&) -> usize error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if not state.live
            count: mutable u32 = 0
            native_dropped: mutable u32 = 0
            try check_status(elisa_physics_v1_contact_count(state.generation,
                &count, &native_dropped))
            raise PhysicsError.Capacity if count > PhysicsRuntime::MAX_CONTACT_EVENTS.u32()
            for index in 0..<count.usize() |buffer, state, index|:
                entity_a: mutable u64 = 0
                entity_b: mutable u64 = 0
                position_x: mutable f32 = 0.0
                position_y: mutable f32 = 0.0
                position_z: mutable f32 = 0.0
                normal_x: mutable f32 = 0.0
                normal_y: mutable f32 = 0.0
                normal_z: mutable f32 = 0.0
                penetration_depth: mutable f32 = 0.0
                kind: mutable i32 = 0
                trigger: mutable i32 = 0
                sequence: mutable u64 = 0
                try check_status(elisa_physics_v1_contact_at(state.generation, index.u32(),
                    &entity_a, &entity_b, &position_x, &position_y, &position_z,
                    &normal_x, &normal_y, &normal_z, &penetration_depth, &kind,
                    &trigger, &sequence))
                contact_kind: ContactKind = ContactKind.Added if kind == PhysicsRuntime::CONTACT_ADDED else ContactKind.Persisted if kind == PhysicsRuntime::CONTACT_PERSISTED else ContactKind.Removed
                buffer.events[index] <- ContactEvent{
                    entity_a: entity_a, entity_b: entity_b,
                    position: Geometry::Vec3{x: position_x, y: position_y, z: position_z},
                    normal: Geometry::Vec3{x: normal_x, y: normal_y, z: normal_z},
                    penetration_depth: penetration_depth, kind: contact_kind,
                    trigger: trigger != 0, sequence: sequence}
            try check_status(elisa_physics_v1_clear_contacts(state.generation))
            dropped <- native_dropped
            count.usize()

        def service_body_position(state: ServiceState&,
            body: BodyHandle) -> Geometry::Vec3 error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if not state.live
            raise PhysicsError.StaleWorld if body.world_generation != state.generation
            x: mutable f32 = 0.0
            y: mutable f32 = 0.0
            z: mutable f32 = 0.0
            status: i32 = elisa_physics_v1_body_position(state.generation,
                body.slot, body.generation, &x, &y, &z)
            try check_status(status)
            Geometry::Vec3{x: x, y: y, z: z}

        def service_body_set_kinematic_target(state: ServiceState&,
            body: BodyHandle, target: Geometry::Transform) -> void error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if not state.live
            raise PhysicsError.StaleWorld if body.world_generation != state.generation
            status: i32 = elisa_physics_v1_set_kinematic_target(state.generation, body.slot,
                body.generation, target.position.x, target.position.y, target.position.z,
                target.rotation.x, target.rotation.y, target.rotation.z, target.rotation.w)
            try check_status(status)

        def service_body_set_sleeping(state: ServiceState&, body: BodyHandle,
            sleeping: bool) -> void error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if not state.live
            raise PhysicsError.StaleWorld if body.world_generation != state.generation
            status: i32 = elisa_physics_v1_set_sleeping(state.generation, body.slot,
                body.generation, 1 if sleeping else 0)
            try check_status(status)

        def service_body_destroy(state: ServiceState&,
            body: BodyHandle) -> void error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if not state.live
            raise PhysicsError.StaleWorld if body.world_generation != state.generation
            status: i32 = elisa_physics_v1_destroy_body(state.generation,
                body.slot, body.generation)
            try check_status(status)

        def service_shutdown(state: mutable ServiceState&) -> void error[PhysicsError]:
            return if not state.live
            try check_status(elisa_physics_v1_shutdown(state.generation))
            state.live <- false

        # Forget the local token after the owning Application has force-closed
        # native providers. No native call is made here.
        def service_reset(state: mutable ServiceState&) -> void:
            state.generation <- 0
            state.tick <- 0
            state.live <- false

        def service_is_live(state: ServiceState&) -> bool:
            state.live

        def service_generation(state: ServiceState&) -> u64 error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if not state.live
            state.generation

        def fixed_step(world: mutable World&, delta_seconds: f32) -> u64 error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if not world.live
            tick: mutable u64 = 0
            status: i32 = elisa_physics_v1_fixed_step(world.generation, delta_seconds, &tick)
            try check_status(status)
            world.tick <- tick
            tick

        def raycast(world: World&, origin: Geometry::Vec3,
            direction: Geometry::Vec3, max_distance: f32, layer_mask: u32) -> RayHit error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if not world.live
            entity: mutable u64 = 0
            position_x: mutable f32 = 0.0
            position_y: mutable f32 = 0.0
            position_z: mutable f32 = 0.0
            normal_x: mutable f32 = 0.0
            normal_y: mutable f32 = 0.0
            normal_z: mutable f32 = 0.0
            distance: mutable f32 = 0.0
            hit: mutable i32 = 0
            try check_status(elisa_physics_v1_raycast(world.generation,
                origin.x, origin.y, origin.z, direction.x, direction.y, direction.z,
                max_distance, layer_mask, &entity, &position_x, &position_y, &position_z,
                &normal_x, &normal_y, &normal_z, &distance, &hit))
            RayHit{
                hit: hit != 0,
                entity: entity,
                position: Geometry::Vec3{x: position_x, y: position_y, z: position_z},
                normal: Geometry::Vec3{x: normal_x, y: normal_y, z: normal_z},
                distance: distance,
            }

        def raycast_all(world: World&, origin: Geometry::Vec3,
            direction: Geometry::Vec3, max_distance: f32, layer_mask: u32,
            buffer: mutable RayHitBuffer&) -> usize error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if not world.live
            native_buffer: mutable NativeRayHitBuffer = zeroed
            try check_status(elisa_physics_v1_raycast_all(world.generation,
                origin.x, origin.y, origin.z, direction.x, direction.y, direction.z,
                max_distance, layer_mask, &native_buffer))
            count: u32 = native_buffer.count
            raise PhysicsError.Capacity if count > PhysicsRuntime::MAX_RAY_HITS.u32()
            for index in 0..<count.usize() |buffer, native_buffer, index|:
                native_hit: NativeRayHit = native_buffer.hits[index]
                buffer.hits[index] <- RayHit{
                    hit: true,
                    entity: native_hit.entity,
                    position: Geometry::Vec3{x: native_hit.position_x,
                        y: native_hit.position_y, z: native_hit.position_z},
                    normal: Geometry::Vec3{x: native_hit.normal_x,
                        y: native_hit.normal_y, z: native_hit.normal_z},
                    distance: native_hit.distance,
                }
            buffer.count <- count.usize()
            buffer.count

        def poll_contacts(world: World&,
            buffer: ContactBuffer&, dropped: mutable u32&) -> usize error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if not world.live
            count: mutable u32 = 0
            native_dropped: mutable u32 = 0
            try check_status(elisa_physics_v1_contact_count(world.generation,
                &count, &native_dropped))
            raise PhysicsError.Capacity if count > PhysicsRuntime::MAX_CONTACT_EVENTS.u32()
            for index in 0..<count.usize() |buffer, world, index|:
                entity_a: mutable u64 = 0
                entity_b: mutable u64 = 0
                position_x: mutable f32 = 0.0
                position_y: mutable f32 = 0.0
                position_z: mutable f32 = 0.0
                normal_x: mutable f32 = 0.0
                normal_y: mutable f32 = 0.0
                normal_z: mutable f32 = 0.0
                penetration_depth: mutable f32 = 0.0
                kind: mutable i32 = 0
                trigger: mutable i32 = 0
                sequence: mutable u64 = 0
                try check_status(elisa_physics_v1_contact_at(world.generation, index.u32(),
                    &entity_a, &entity_b, &position_x, &position_y, &position_z,
                    &normal_x, &normal_y, &normal_z, &penetration_depth, &kind,
                    &trigger, &sequence))
                contact_kind: ContactKind = ContactKind.Added if kind == PhysicsRuntime::CONTACT_ADDED else ContactKind.Persisted if kind == PhysicsRuntime::CONTACT_PERSISTED else ContactKind.Removed
                buffer.events[index] <- ContactEvent{
                    entity_a: entity_a, entity_b: entity_b,
                    position: Geometry::Vec3{x: position_x, y: position_y, z: position_z},
                    normal: Geometry::Vec3{x: normal_x, y: normal_y, z: normal_z},
                    penetration_depth: penetration_depth, kind: contact_kind,
                    trigger: trigger != 0, sequence: sequence}
            try check_status(elisa_physics_v1_clear_contacts(world.generation))
            dropped <- native_dropped
            count.usize()

        def committed_tick(world: World&) -> u64:
            world.tick

        def world_generation(world: World&) -> u64 error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if not world.live
            world.generation

        include "./runtime_body_create_api.inc"

        def body_position(world: World&, body: BodyHandle) -> Geometry::Vec3 error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if not world.live
            raise PhysicsError.StaleWorld if body.world_generation != world.generation
            x: mutable f32 = 0.0
            y: mutable f32 = 0.0
            z: mutable f32 = 0.0
            status: i32 = elisa_physics_v1_body_position(world.generation,
                body.slot, body.generation, &x, &y, &z)
            try check_status(status)
            Geometry::Vec3{x: x, y: y, z: z}

        def body_set_kinematic_target(world: World&, body: BodyHandle,
            target: Geometry::Transform) -> void error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if not world.live
            raise PhysicsError.StaleWorld if body.world_generation != world.generation
            status: i32 = elisa_physics_v1_set_kinematic_target(world.generation, body.slot,
                body.generation, target.position.x, target.position.y, target.position.z,
                target.rotation.x, target.rotation.y, target.rotation.z, target.rotation.w)
            try check_status(status)

        def body_set_sleeping(world: World&, body: BodyHandle,
            sleeping: bool) -> void error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if not world.live
            raise PhysicsError.StaleWorld if body.world_generation != world.generation
            status: i32 = elisa_physics_v1_set_sleeping(world.generation, body.slot,
                body.generation, 1 if sleeping else 0)
            try check_status(status)

        def body_destroy(world: World&, body: BodyHandle) -> void error[PhysicsError]:
            raise PhysicsError.ApplicationUnavailable if not world.live
            raise PhysicsError.StaleWorld if body.world_generation != world.generation
            status: i32 = elisa_physics_v1_destroy_body(world.generation,
                body.slot, body.generation)
            try check_status(status)

        def shutdown(world: mutable World&) -> void error[PhysicsError]:
            return if not world.live
            status: i32 = elisa_physics_v1_shutdown(world.generation)
            try check_status(status)

            world.live <- false

        include "./runtime_reusable_shapes_api.inc"
        include "./runtime_body_motion_api.inc"
        include "./runtime_body_material_api.inc"
        include "./runtime_body_inertia_api.inc"
