# Continuous collision for 2D circles against thin vertical walls, so a fast
# projectile cannot tunnel through a wall thinner than one step's travel.
# The swept test finds the first time in the step (in permille) at which the
# circle's leading edge reaches the wall's near face within its height; the
# step then stops there and reflects with restitution. Integer arithmetic
# keeps the outcome identical on every platform and replay.
include "./circles2d.elisa"

module Physics2dCcd:
    public:
        struct Wall:
            x_um: i64
            thickness_um: i64
            y_min_um: i64
            y_max_um: i64

        # Thin horizontal platform: floor from above, ceiling from below.
        struct Platform:
            y_um: i64
            thickness_um: i64
            x_min_um: i64
            x_max_um: i64

        struct Hit:
            hit: bool
            t_permille: i64
            # Exact horizontal travel to contact, so rounding never leaves a gap.
            travel_um: i64

        def no_hit() -> Hit:
            Hit{hit: false, t_permille: 1000, travel_um: 0}

        # First contact during a straight move of (dx, dy) micrometres.
        def sweep(c: Physics2dCircles::Circle&, dx: i64, dy: i64, w: Wall&) -> Hit:
            return no_hit() if dx == 0 or w.thickness_um < 0
            # Face and leading edge depend on direction of travel.
            face: i64 = w.x_um if dx > 0 else w.x_um + w.thickness_um
            edge: i64 = c.x_um + c.radius_um if dx > 0 else c.x_um - c.radius_um
            gap: i64 = face - edge
            # Already past the face, or moving away from it.
            return no_hit() if (dx > 0 and gap < 0) or (dx < 0 and gap > 0)
            return no_hit() if (dx > 0 and gap > dx) or (dx < 0 and gap < dx)
            t: i64 = gap * 1000 / dx
            y_at: i64 = c.y_um + dy * t / 1000
            return no_hit() if y_at + c.radius_um < w.y_min_um or y_at - c.radius_um > w.y_max_um
            Hit{hit: true, t_permille: t, travel_um: gap}

        # Same test with the axes swapped, for platforms.
        def sweep_platform(c: Physics2dCircles::Circle&, dx: i64, dy: i64, p: Platform&) -> Hit:
            swapped: Physics2dCircles::Circle = Physics2dCircles::Circle{x_um: c.y_um, y_um: c.x_um, vx: c.vy, vy: c.vx, radius_um: c.radius_um, mass_g: c.mass_g}
            as_wall: Wall = Wall{x_um: p.y_um, thickness_um: p.thickness_um, y_min_um: p.x_min_um, y_max_um: p.x_max_um}
            sweep(&swapped, dy, dx, &as_wall)

        # First time in this step (permille) at which two moving circles touch,
        # from their current velocities. Solved in millimetres so the squared
        # terms stay far from i64 overflow; the result is exact to 1 mm.
        def sweep_pair(a: Physics2dCircles::Circle&, b: Physics2dCircles::Circle&, dt_ms: i64) -> Hit:
            return no_hit() if dt_ms <= 0
            px: i64 = (b.x_um - a.x_um) / 1000
            py: i64 = (b.y_um - a.y_um) / 1000
            dx: i64 = (b.vx - a.vx) * dt_ms / 1000000
            dy: i64 = (b.vy - a.vy) * dt_ms / 1000000
            r: i64 = (a.radius_um + b.radius_um) / 1000
            qa: i64 = dx * dx + dy * dy
            qb: i64 = px * dx + py * dy
            qc: i64 = px * px + py * py - r * r
            # Already touching, separating, or not moving relative to each other.
            return no_hit() if qc <= 0 or qb >= 0 or qa == 0
            disc: i64 = qb * qb - qa * qc
            return no_hit() if disc < 0
            # t = (-qb - sqrt(disc)) / qa, with qb the half-coefficient.
            num: i64 = 0 - qb - Physics2dCircles::isqrt(disc)
            return no_hit() if num < 0 or num > qa
            Hit{hit: true, t_permille: num * 1000 / qa, travel_um: 0}

        # Step with CCD against walls and platforms: stops at the earliest
        # contact and reflects the speed along that contact's axis.
        def step_all(c: mutable Physics2dCircles::Circle&, walls: Wall[4], wall_count: i64, platforms: Platform[4], platform_count: i64, gravity_um_s2: i64, dt_ms: i64, restitution_permille: i64) -> bool:
            return false if c.mass_g <= 0 or dt_ms <= 0
            c.vy <- c.vy - gravity_um_s2 * dt_ms / 1000
            dx: i64 = c.vx * dt_ms / 1000
            dy: i64 = c.vy * dt_ms / 1000
            mutable best: Hit = no_hit()
            mutable vertical: bool = false
            for i in 0..<4 |best, vertical|:
                if i.i64() < wall_count:
                    h: Hit = sweep(c, dx, dy, &walls[i])
                    if h.hit and h.t_permille < best.t_permille:
                        best <- h
                        vertical <- false
                if i.i64() < platform_count:
                    h: Hit = sweep_platform(c, dx, dy, &platforms[i])
                    if h.hit and h.t_permille < best.t_permille:
                        best <- h
                        vertical <- true
            if not best.hit:
                c.x_um <- c.x_um + dx
                c.y_um <- c.y_um + dy
            elif vertical:
                c.y_um <- c.y_um + best.travel_um
                c.x_um <- c.x_um + dx * best.t_permille / 1000
                c.vy <- 0 - c.vy * restitution_permille / 1000
            else:
                c.x_um <- c.x_um + best.travel_um
                c.y_um <- c.y_um + dy * best.t_permille / 1000
                c.vx <- 0 - c.vx * restitution_permille / 1000
            best.hit

        # Semi-implicit step with CCD against `walls`: stops at the earliest
        # wall contact and reflects the horizontal speed. Returns true on a hit.
        def step(c: mutable Physics2dCircles::Circle&, walls: Wall[4], count: i64, gravity_um_s2: i64, dt_ms: i64, restitution_permille: i64) -> bool:
            return false if c.mass_g <= 0 or dt_ms <= 0
            c.vy <- c.vy - gravity_um_s2 * dt_ms / 1000
            dx: i64 = c.vx * dt_ms / 1000
            dy: i64 = c.vy * dt_ms / 1000
            mutable best: Hit = no_hit()
            for i in 0..<4 |best|:
                if i.i64() < count:
                    h: Hit = sweep(c, dx, dy, &walls[i])
                    best <- h if h.hit and h.t_permille < best.t_permille
            c.x_um <- c.x_um + (best.travel_um if best.hit else dx)
            c.y_um <- c.y_um + dy * best.t_permille / 1000
            c.vx <- 0 - c.vx * restitution_permille / 1000 if best.hit else c.vx
            best.hit
