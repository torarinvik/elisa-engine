# Public bounded shape queries. Wicked and Jolt intersection records stay
# behind the flat native ABI; callers retain only copied Elisa values.
include "./runtime.elisa"
include "../math/geometry.elisa"

module PhysicsQueries:
    private:
        const module Status:
            OK: i32 = 0
            INVALID_ARGUMENT: i32 = -1
            INVALID_STATE: i32 = -2
            WRONG_THREAD: i32 = -3
            CAPACITY: i32 = -4
            INVALID_HANDLE: i32 = -5
            BACKEND_FAILURE: i32 = -6
            STALE_WORLD: i32 = -7

        struct NativeShapeHit:
            entity: u64
            position_x: f32
            position_y: f32
            position_z: f32
            normal_x: f32
            normal_y: f32
            normal_z: f32
            distance: f32
            penetration_depth: f32

        struct NativeShapeHitBuffer:
            hits: NativeShapeHit[16]
            count: u32

        struct NativeQueryTargets:
            scene_objects: i32
            scene_colliders: i32
            physics_bodies: i32

        def native_query_targets(filter: PhysicsRuntime::PhysicsQueryFilter) -> NativeQueryTargets:
            NativeQueryTargets{
                scene_objects: 1 if filter.scene_objects else 0,
                scene_colliders: 1 if filter.scene_colliders else 0,
                physics_bodies: 1 if filter.physics_bodies else 0,
            }

        @callconv(c)
        extern elisa_physics_v1_sphere_cast_filtered(world_generation: u64,
            center_x: f32, center_y: f32, center_z: f32,
            direction_x: f32, direction_y: f32, direction_z: f32,
            max_distance: f32, radius: f32, layer_mask: u32,
            include_scene_objects: i32, include_scene_colliders: i32,
            include_physics_bodies: i32,
            result: mutable NativeShapeHit&, hit: mutable i32&) -> i32

        @callconv(c)
        extern elisa_physics_v1_capsule_cast_filtered(world_generation: u64,
            base_x: f32, base_y: f32, base_z: f32,
            tip_x: f32, tip_y: f32, tip_z: f32,
            direction_x: f32, direction_y: f32, direction_z: f32,
            max_distance: f32, radius: f32, layer_mask: u32,
            include_scene_objects: i32, include_scene_colliders: i32,
            include_physics_bodies: i32,
            result: mutable NativeShapeHit&, hit: mutable i32&) -> i32

        @callconv(c)
        extern elisa_physics_v1_overlap_sphere_filtered(world_generation: u64,
            center_x: f32, center_y: f32, center_z: f32, radius: f32, layer_mask: u32,
            include_scene_objects: i32, include_scene_colliders: i32,
            include_physics_bodies: i32,
            result: mutable NativeShapeHit&, hit: mutable i32&) -> i32

        @callconv(c)
        extern elisa_physics_v1_overlap_sphere_all_filtered(world_generation: u64,
            center_x: f32, center_y: f32, center_z: f32, radius: f32, layer_mask: u32,
            include_scene_objects: i32, include_scene_colliders: i32,
            include_physics_bodies: i32,
            buffer: mutable NativeShapeHitBuffer&) -> i32

        @callconv(c)
        extern elisa_physics_v1_overlap_capsule_filtered(world_generation: u64,
            base_x: f32, base_y: f32, base_z: f32,
            tip_x: f32, tip_y: f32, tip_z: f32, radius: f32, layer_mask: u32,
            include_scene_objects: i32, include_scene_colliders: i32,
            include_physics_bodies: i32,
            result: mutable NativeShapeHit&, hit: mutable i32&) -> i32

        @callconv(c)
        extern elisa_physics_v1_overlap_capsule_all_filtered(world_generation: u64,
            base_x: f32, base_y: f32, base_z: f32,
            tip_x: f32, tip_y: f32, tip_z: f32, radius: f32, layer_mask: u32,
            include_scene_objects: i32, include_scene_colliders: i32,
            include_physics_bodies: i32,
            buffer: mutable NativeShapeHitBuffer&) -> i32

        def check_status(status: i32) -> void error[PhysicsRuntime::PhysicsError]:
            raise PhysicsRuntime::PhysicsError.InvalidArgument if status == Status::INVALID_ARGUMENT
            raise PhysicsRuntime::PhysicsError.ApplicationUnavailable if status == Status::INVALID_STATE
            raise PhysicsRuntime::PhysicsError.WrongThread if status == Status::WRONG_THREAD
            raise PhysicsRuntime::PhysicsError.Capacity if status == Status::CAPACITY
            raise PhysicsRuntime::PhysicsError.InvalidHandle if status == Status::INVALID_HANDLE
            raise PhysicsRuntime::PhysicsError.BackendFailure if status == Status::BACKEND_FAILURE
            raise PhysicsRuntime::PhysicsError.StaleWorld if status == Status::STALE_WORLD
            raise PhysicsRuntime::PhysicsError.BackendFailure if status != Status::OK

        def shape_hit(native: NativeShapeHit, found: i32) -> ShapeHit:
            ShapeHit{
                hit: found != 0,
                entity: native.entity,
                position: Geometry::Vec3{x: native.position_x, y: native.position_y,
                    z: native.position_z},
                normal: Geometry::Vec3{x: native.normal_x, y: native.normal_y,
                    z: native.normal_z},
                distance: native.distance,
                penetration_depth: native.penetration_depth,
            }

        def copy_buffer(native: NativeShapeHitBuffer,
            buffer: mutable ShapeHitBuffer&) -> usize error[PhysicsRuntime::PhysicsError]:
            count: u32 = native.count
            raise PhysicsRuntime::PhysicsError.Capacity if count > PhysicsQueries::MAX_HITS.u32()
            for index in 0..<count.usize() |buffer, native, index|:
                buffer.hits[index] <- shape_hit(native.hits[index], 1)
            buffer.count <- count.usize()
            buffer.count

        def sphere_cast_generation(generation: u64, center: Geometry::Vec3,
            direction: Geometry::Vec3, max_distance: f32, radius: f32,
            layer_mask: u32, filter: PhysicsRuntime::PhysicsQueryFilter) -> ShapeHit error[PhysicsRuntime::PhysicsError]:
            native: mutable NativeShapeHit = zeroed
            found: mutable i32 = 0
            targets: NativeQueryTargets = native_query_targets(filter)
            try check_status(elisa_physics_v1_sphere_cast_filtered(generation,
                center.x, center.y, center.z, direction.x, direction.y, direction.z,
                max_distance, radius, layer_mask, targets.scene_objects,
                targets.scene_colliders, targets.physics_bodies, &native, &found))
            shape_hit(native, found)

        def capsule_cast_generation(generation: u64, base: Geometry::Vec3,
            tip: Geometry::Vec3, direction: Geometry::Vec3, max_distance: f32,
            radius: f32, layer_mask: u32,
            filter: PhysicsRuntime::PhysicsQueryFilter) -> ShapeHit error[PhysicsRuntime::PhysicsError]:
            native: mutable NativeShapeHit = zeroed
            found: mutable i32 = 0
            targets: NativeQueryTargets = native_query_targets(filter)
            try check_status(elisa_physics_v1_capsule_cast_filtered(generation,
                base.x, base.y, base.z, tip.x, tip.y, tip.z,
                direction.x, direction.y, direction.z, max_distance, radius,
                layer_mask, targets.scene_objects, targets.scene_colliders,
                targets.physics_bodies, &native, &found))
            shape_hit(native, found)

        def overlap_sphere_generation(generation: u64, center: Geometry::Vec3,
            radius: f32, layer_mask: u32,
            filter: PhysicsRuntime::PhysicsQueryFilter) -> ShapeHit error[PhysicsRuntime::PhysicsError]:
            native: mutable NativeShapeHit = zeroed
            found: mutable i32 = 0
            targets: NativeQueryTargets = native_query_targets(filter)
            try check_status(elisa_physics_v1_overlap_sphere_filtered(generation,
                center.x, center.y, center.z, radius, layer_mask, targets.scene_objects,
                targets.scene_colliders, targets.physics_bodies, &native, &found))
            shape_hit(native, found)

        def overlap_sphere_all_generation(generation: u64, center: Geometry::Vec3,
            radius: f32, layer_mask: u32, filter: PhysicsRuntime::PhysicsQueryFilter,
            buffer: mutable ShapeHitBuffer&) -> usize error[PhysicsRuntime::PhysicsError]:
            native: mutable NativeShapeHitBuffer = zeroed
            targets: NativeQueryTargets = native_query_targets(filter)
            try check_status(elisa_physics_v1_overlap_sphere_all_filtered(generation,
                center.x, center.y, center.z, radius, layer_mask, targets.scene_objects,
                targets.scene_colliders, targets.physics_bodies, &native))
            try copy_buffer(native, buffer)

        def overlap_capsule_generation(generation: u64, base: Geometry::Vec3,
            tip: Geometry::Vec3, radius: f32, layer_mask: u32,
            filter: PhysicsRuntime::PhysicsQueryFilter) -> ShapeHit error[PhysicsRuntime::PhysicsError]:
            native: mutable NativeShapeHit = zeroed
            found: mutable i32 = 0
            targets: NativeQueryTargets = native_query_targets(filter)
            try check_status(elisa_physics_v1_overlap_capsule_filtered(generation,
                base.x, base.y, base.z, tip.x, tip.y, tip.z, radius, layer_mask,
                targets.scene_objects, targets.scene_colliders, targets.physics_bodies,
                &native, &found))
            shape_hit(native, found)

        def overlap_capsule_all_generation(generation: u64, base: Geometry::Vec3,
            tip: Geometry::Vec3, radius: f32, layer_mask: u32,
            filter: PhysicsRuntime::PhysicsQueryFilter,
            buffer: mutable ShapeHitBuffer&) -> usize error[PhysicsRuntime::PhysicsError]:
            native: mutable NativeShapeHitBuffer = zeroed
            targets: NativeQueryTargets = native_query_targets(filter)
            try check_status(elisa_physics_v1_overlap_capsule_all_filtered(generation,
                base.x, base.y, base.z, tip.x, tip.y, tip.z, radius, layer_mask,
                targets.scene_objects, targets.scene_colliders, targets.physics_bodies,
                &native))
            try copy_buffer(native, buffer)

    public:
        const MAX_HITS: usize = 16

        struct ShapeHit:
            hit: bool
            entity: u64
            position: Geometry::Vec3
            normal: Geometry::Vec3
            distance: f32
            penetration_depth: f32

        struct ShapeHitBuffer:
            hits: mutable ShapeHit[16]
            count: mutable usize

        def ShapeHitBuffer() -> ShapeHitBuffer:
            ShapeHitBuffer{hits: zeroed, count: 0}

        def sphere_cast(world: PhysicsRuntime::World&, center: Geometry::Vec3,
            direction: Geometry::Vec3, max_distance: f32, radius: f32,
            layer_mask: u32) -> ShapeHit error[PhysicsRuntime::PhysicsError]:
            generation: u64 = try PhysicsRuntime::world_generation(world)
            try sphere_cast_generation(generation, center, direction, max_distance, radius,
                layer_mask, PhysicsRuntime::PhysicsQueryFilter())

        def sphere_cast_filtered(world: PhysicsRuntime::World&, center: Geometry::Vec3,
            direction: Geometry::Vec3, max_distance: f32, radius: f32, layer_mask: u32,
            filter: PhysicsRuntime::PhysicsQueryFilter) -> ShapeHit error[PhysicsRuntime::PhysicsError]:
            generation: u64 = try PhysicsRuntime::world_generation(world)
            try sphere_cast_generation(generation, center, direction, max_distance, radius,
                layer_mask, filter)

        def capsule_cast(world: PhysicsRuntime::World&, base: Geometry::Vec3,
            tip: Geometry::Vec3, direction: Geometry::Vec3, max_distance: f32,
            radius: f32, layer_mask: u32) -> ShapeHit error[PhysicsRuntime::PhysicsError]:
            generation: u64 = try PhysicsRuntime::world_generation(world)
            try capsule_cast_generation(generation, base, tip, direction, max_distance, radius,
                layer_mask, PhysicsRuntime::PhysicsQueryFilter())

        def capsule_cast_filtered(world: PhysicsRuntime::World&, base: Geometry::Vec3,
            tip: Geometry::Vec3, direction: Geometry::Vec3, max_distance: f32,
            radius: f32, layer_mask: u32,
            filter: PhysicsRuntime::PhysicsQueryFilter) -> ShapeHit error[PhysicsRuntime::PhysicsError]:
            generation: u64 = try PhysicsRuntime::world_generation(world)
            try capsule_cast_generation(generation, base, tip, direction, max_distance,
                radius, layer_mask, filter)

        def overlap_sphere(world: PhysicsRuntime::World&, center: Geometry::Vec3,
            radius: f32, layer_mask: u32) -> ShapeHit error[PhysicsRuntime::PhysicsError]:
            generation: u64 = try PhysicsRuntime::world_generation(world)
            try overlap_sphere_generation(generation, center, radius, layer_mask,
                PhysicsRuntime::PhysicsQueryFilter())

        def overlap_sphere_filtered(world: PhysicsRuntime::World&,
            center: Geometry::Vec3, radius: f32, layer_mask: u32,
            filter: PhysicsRuntime::PhysicsQueryFilter) -> ShapeHit error[PhysicsRuntime::PhysicsError]:
            generation: u64 = try PhysicsRuntime::world_generation(world)
            try overlap_sphere_generation(generation, center, radius, layer_mask, filter)

        def overlap_sphere_all(world: PhysicsRuntime::World&, center: Geometry::Vec3,
            radius: f32, layer_mask: u32, buffer: mutable ShapeHitBuffer&) -> usize error[PhysicsRuntime::PhysicsError]:
            generation: u64 = try PhysicsRuntime::world_generation(world)
            try overlap_sphere_all_generation(generation, center, radius, layer_mask,
                PhysicsRuntime::PhysicsQueryFilter(), buffer)

        def overlap_sphere_all_filtered(world: PhysicsRuntime::World&,
            center: Geometry::Vec3, radius: f32, layer_mask: u32,
            filter: PhysicsRuntime::PhysicsQueryFilter,
            buffer: mutable ShapeHitBuffer&) -> usize error[PhysicsRuntime::PhysicsError]:
            generation: u64 = try PhysicsRuntime::world_generation(world)
            try overlap_sphere_all_generation(generation, center, radius, layer_mask,
                filter, buffer)

        def overlap_capsule(world: PhysicsRuntime::World&, base: Geometry::Vec3,
            tip: Geometry::Vec3, radius: f32, layer_mask: u32) -> ShapeHit error[PhysicsRuntime::PhysicsError]:
            generation: u64 = try PhysicsRuntime::world_generation(world)
            try overlap_capsule_generation(generation, base, tip, radius, layer_mask,
                PhysicsRuntime::PhysicsQueryFilter())

        def overlap_capsule_filtered(world: PhysicsRuntime::World&,
            base: Geometry::Vec3, tip: Geometry::Vec3, radius: f32, layer_mask: u32,
            filter: PhysicsRuntime::PhysicsQueryFilter) -> ShapeHit error[PhysicsRuntime::PhysicsError]:
            generation: u64 = try PhysicsRuntime::world_generation(world)
            try overlap_capsule_generation(generation, base, tip, radius, layer_mask, filter)

        def overlap_capsule_all(world: PhysicsRuntime::World&, base: Geometry::Vec3,
            tip: Geometry::Vec3, radius: f32, layer_mask: u32,
            buffer: mutable ShapeHitBuffer&) -> usize error[PhysicsRuntime::PhysicsError]:
            generation: u64 = try PhysicsRuntime::world_generation(world)
            try overlap_capsule_all_generation(generation, base, tip, radius, layer_mask,
                PhysicsRuntime::PhysicsQueryFilter(), buffer)

        def overlap_capsule_all_filtered(world: PhysicsRuntime::World&,
            base: Geometry::Vec3, tip: Geometry::Vec3, radius: f32, layer_mask: u32,
            filter: PhysicsRuntime::PhysicsQueryFilter,
            buffer: mutable ShapeHitBuffer&) -> usize error[PhysicsRuntime::PhysicsError]:
            generation: u64 = try PhysicsRuntime::world_generation(world)
            try overlap_capsule_all_generation(generation, base, tip, radius, layer_mask,
                filter, buffer)

        def service_sphere_cast(state: PhysicsRuntime::ServiceState&, center: Geometry::Vec3,
            direction: Geometry::Vec3, max_distance: f32, radius: f32,
            layer_mask: u32) -> ShapeHit error[PhysicsRuntime::PhysicsError]:
            generation: u64 = try PhysicsRuntime::service_generation(state)
            try sphere_cast_generation(generation, center, direction, max_distance, radius,
                layer_mask, PhysicsRuntime::PhysicsQueryFilter())

        def service_sphere_cast_filtered(state: PhysicsRuntime::ServiceState&,
            center: Geometry::Vec3, direction: Geometry::Vec3, max_distance: f32,
            radius: f32, layer_mask: u32,
            filter: PhysicsRuntime::PhysicsQueryFilter) -> ShapeHit error[PhysicsRuntime::PhysicsError]:
            generation: u64 = try PhysicsRuntime::service_generation(state)
            try sphere_cast_generation(generation, center, direction, max_distance,
                radius, layer_mask, filter)

        def service_capsule_cast(state: PhysicsRuntime::ServiceState&, base: Geometry::Vec3,
            tip: Geometry::Vec3, direction: Geometry::Vec3, max_distance: f32,
            radius: f32, layer_mask: u32) -> ShapeHit error[PhysicsRuntime::PhysicsError]:
            generation: u64 = try PhysicsRuntime::service_generation(state)
            try capsule_cast_generation(generation, base, tip, direction, max_distance, radius,
                layer_mask, PhysicsRuntime::PhysicsQueryFilter())

        def service_capsule_cast_filtered(state: PhysicsRuntime::ServiceState&,
            base: Geometry::Vec3, tip: Geometry::Vec3, direction: Geometry::Vec3,
            max_distance: f32, radius: f32, layer_mask: u32,
            filter: PhysicsRuntime::PhysicsQueryFilter) -> ShapeHit error[PhysicsRuntime::PhysicsError]:
            generation: u64 = try PhysicsRuntime::service_generation(state)
            try capsule_cast_generation(generation, base, tip, direction, max_distance,
                radius, layer_mask, filter)

        def service_overlap_sphere(state: PhysicsRuntime::ServiceState&, center: Geometry::Vec3,
            radius: f32, layer_mask: u32) -> ShapeHit error[PhysicsRuntime::PhysicsError]:
            generation: u64 = try PhysicsRuntime::service_generation(state)
            try overlap_sphere_generation(generation, center, radius, layer_mask,
                PhysicsRuntime::PhysicsQueryFilter())

        def service_overlap_sphere_filtered(state: PhysicsRuntime::ServiceState&,
            center: Geometry::Vec3, radius: f32, layer_mask: u32,
            filter: PhysicsRuntime::PhysicsQueryFilter) -> ShapeHit error[PhysicsRuntime::PhysicsError]:
            generation: u64 = try PhysicsRuntime::service_generation(state)
            try overlap_sphere_generation(generation, center, radius, layer_mask, filter)

        def service_overlap_sphere_all(state: PhysicsRuntime::ServiceState&, center: Geometry::Vec3,
            radius: f32, layer_mask: u32, buffer: mutable ShapeHitBuffer&) -> usize error[PhysicsRuntime::PhysicsError]:
            generation: u64 = try PhysicsRuntime::service_generation(state)
            try overlap_sphere_all_generation(generation, center, radius, layer_mask,
                PhysicsRuntime::PhysicsQueryFilter(), buffer)

        def service_overlap_sphere_all_filtered(state: PhysicsRuntime::ServiceState&,
            center: Geometry::Vec3, radius: f32, layer_mask: u32,
            filter: PhysicsRuntime::PhysicsQueryFilter,
            buffer: mutable ShapeHitBuffer&) -> usize error[PhysicsRuntime::PhysicsError]:
            generation: u64 = try PhysicsRuntime::service_generation(state)
            try overlap_sphere_all_generation(generation, center, radius, layer_mask,
                filter, buffer)

        def service_overlap_capsule(state: PhysicsRuntime::ServiceState&, base: Geometry::Vec3,
            tip: Geometry::Vec3, radius: f32, layer_mask: u32) -> ShapeHit error[PhysicsRuntime::PhysicsError]:
            generation: u64 = try PhysicsRuntime::service_generation(state)
            try overlap_capsule_generation(generation, base, tip, radius, layer_mask,
                PhysicsRuntime::PhysicsQueryFilter())

        def service_overlap_capsule_filtered(state: PhysicsRuntime::ServiceState&,
            base: Geometry::Vec3, tip: Geometry::Vec3, radius: f32, layer_mask: u32,
            filter: PhysicsRuntime::PhysicsQueryFilter) -> ShapeHit error[PhysicsRuntime::PhysicsError]:
            generation: u64 = try PhysicsRuntime::service_generation(state)
            try overlap_capsule_generation(generation, base, tip, radius, layer_mask, filter)

        def service_overlap_capsule_all(state: PhysicsRuntime::ServiceState&, base: Geometry::Vec3,
            tip: Geometry::Vec3, radius: f32, layer_mask: u32,
            buffer: mutable ShapeHitBuffer&) -> usize error[PhysicsRuntime::PhysicsError]:
            generation: u64 = try PhysicsRuntime::service_generation(state)
            try overlap_capsule_all_generation(generation, base, tip, radius, layer_mask,
                PhysicsRuntime::PhysicsQueryFilter(), buffer)

        def service_overlap_capsule_all_filtered(state: PhysicsRuntime::ServiceState&,
            base: Geometry::Vec3, tip: Geometry::Vec3, radius: f32, layer_mask: u32,
            filter: PhysicsRuntime::PhysicsQueryFilter,
            buffer: mutable ShapeHitBuffer&) -> usize error[PhysicsRuntime::PhysicsError]:
            generation: u64 = try PhysicsRuntime::service_generation(state)
            try overlap_capsule_all_generation(generation, base, tip, radius, layer_mask,
                filter, buffer)
