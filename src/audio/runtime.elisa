# Application-owned audio adapter. Handles are bounded opaque identities; the
# miniaudio device, decoder, and voice mixer stay behind the native C ABI.
module AudioRuntime:
    public:
        enum Bus:
            Music
            Effects
            Ui

        error AudioError:
            InvalidArgument
            ApplicationUnavailable
            WrongThread
            DeviceUnavailable
            DecodeFailed
            Capacity
            InvalidHandle
            UnknownStatus

        struct ClipHandle:
            private:
                slot: u32
                generation: u32

        struct VoiceHandle:
            private:
                slot: u32
                generation: u32

    private:
        const module Status:
            OK: i32 = 0
            INVALID_ARGUMENT: i32 = -1
            INVALID_STATE: i32 = -2
            WRONG_THREAD: i32 = -3
            DEVICE_UNAVAILABLE: i32 = -4
            DECODE_FAILED: i32 = -5
            CAPACITY: i32 = -6
            INVALID_HANDLE: i32 = -7
            BUS_MUSIC: i32 = 0
            BUS_SFX: i32 = 1
            BUS_UI: i32 = 2

        @callconv(c)
        extern elisa_audio_v1_initialize_silent(sample_rate: u32, channels: u32) -> i32

        @callconv(c)
        extern elisa_audio_v1_initialize_default(sample_rate: u32, channels: u32) -> i32

        @callconv(c)
        extern elisa_audio_v1_decode_file(path: cstr, slot: mutable u32&, generation: mutable u32&) -> i32

        @callconv(c)
        extern elisa_audio_v1_play(clip_slot: u32, clip_generation: u32, looped: i32,
            bus: i32, gain: f32, priority: u32, slot: mutable u32&, generation: mutable u32&) -> i32

        @callconv(c)
        extern elisa_audio_v1_stop(slot: u32, generation: u32) -> i32

        @callconv(c)
        extern elisa_audio_v1_set_bus_gain(bus: i32, gain: f32) -> i32

        @callconv(c)
        extern elisa_audio_v1_active_voice_count() -> i32

        @callconv(c)
        extern elisa_audio_v1_shutdown() -> i32

        def check_status(status: i32) -> void error[AudioError]:
            raise AudioError.InvalidArgument if status == Status::INVALID_ARGUMENT
            raise AudioError.ApplicationUnavailable if status == Status::INVALID_STATE
            raise AudioError.WrongThread if status == Status::WRONG_THREAD
            raise AudioError.DeviceUnavailable if status == Status::DEVICE_UNAVAILABLE
            raise AudioError.DecodeFailed if status == Status::DECODE_FAILED
            raise AudioError.Capacity if status == Status::CAPACITY
            raise AudioError.InvalidHandle if status == Status::INVALID_HANDLE
            raise AudioError.UnknownStatus if status != Status::OK

        def bus_code(bus: Bus) -> i32:
            match bus:
                Bus.Music:
                    Status::BUS_MUSIC
                Bus.Effects:
                    Status::BUS_SFX
                Bus.Ui:
                    Status::BUS_UI

    public:
        def initialize_silent(sample_rate: u32, channels: u32) -> void error[AudioError]:
            try check_status(elisa_audio_v1_initialize_silent(sample_rate, channels))

        def initialize_default(sample_rate: u32, channels: u32) -> void error[AudioError]:
            try check_status(elisa_audio_v1_initialize_default(sample_rate, channels))

        def decode_file(path: cstr) -> ClipHandle error[AudioError]:
            slot: mutable u32 = 0
            generation: mutable u32 = 0
            try check_status(elisa_audio_v1_decode_file(path, &slot, &generation))
            ClipHandle{slot: slot, generation: generation}

        def play(clip: ClipHandle, looped: bool, bus: Bus, gain: f32,
            priority: u32) -> VoiceHandle error[AudioError]:
            slot: mutable u32 = 0
            generation: mutable u32 = 0
            try check_status(elisa_audio_v1_play(clip.slot, clip.generation,
                1 if looped else 0, bus_code(bus), gain, priority, &slot, &generation))
            VoiceHandle{slot: slot, generation: generation}

        def stop(voice: VoiceHandle) -> void error[AudioError]:
            try check_status(elisa_audio_v1_stop(voice.slot, voice.generation))

        def set_bus_gain(bus: Bus, gain: f32) -> void error[AudioError]:
            try check_status(elisa_audio_v1_set_bus_gain(bus_code(bus), gain))

        def active_voice_count() -> usize error[AudioError]:
            count: i32 = elisa_audio_v1_active_voice_count()
            try check_status(Status::OK if count >= 0 else count)
            count.usize()

        def shutdown() -> void error[AudioError]:
            try check_status(elisa_audio_v1_shutdown())
