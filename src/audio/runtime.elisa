# Application-owned audio adapter. Handles are bounded opaque identities; the
# miniaudio device, decoder, and voice mixer stay behind the native C ABI.
module AudioRuntime:
    public:
        enum Bus:
            Music
            Effects
            Ui

        error AudioError:
            InvalidArgument
            ApplicationUnavailable
            WrongThread
            DeviceUnavailable
            DecodeFailed
            Capacity
            InvalidHandle
            ClipInUse
            StreamEnded
            UnknownStatus

        struct ClipHandle:
            private:
                slot: u32
                generation: u32

        struct VoiceHandle:
            private:
                slot: u32
                generation: u32

        struct StreamHandle:
            private:
                slot: u32
                generation: u32

        enum StreamState:
            Playing
            Finished

        struct StreamStatus:
            state: StreamState
            frames_played: u64
            underrun_frames: u64

        # Opaque handles cannot be zero-initialized or copied element-wise by
        # other modules, so bounded engine-owned tables keep them in this pool.
        module VoiceHandles:
            public:
                const CAPACITY: usize = 32

                affine struct Pool:
                    private:
                        values: mutable VoiceHandle[AudioRuntime::VoiceHandles::CAPACITY]
                        live: mutable bool[AudioRuntime::VoiceHandles::CAPACITY]

                def Pool() -> Pool:
                    Pool{values: zeroed, live: zeroed}

                def store(handles: mutable Pool&, index: usize,
                    voice: VoiceHandle) -> bool:
                    return false if index >= AudioRuntime::VoiceHandles::CAPACITY
                    handles.values[index] <- voice
                    handles.live[index] <- true
                    true

                def get(handles: Pool&, index: usize) -> VoiceHandle error[AudioRuntime::AudioError]:
                    raise AudioRuntime::AudioError.InvalidHandle if index >= AudioRuntime::VoiceHandles::CAPACITY or not handles.live[index]
                    handles.values[index]

                def move(handles: mutable Pool&, source: usize, destination: usize) -> bool:
                    return false if source >= AudioRuntime::VoiceHandles::CAPACITY or destination >= AudioRuntime::VoiceHandles::CAPACITY or not handles.live[source]
                    handles.values[destination] <- handles.values[source]
                    handles.live[destination] <- true
                    handles.live[source] <- false
                    true

                def clear(handles: mutable Pool&, index: usize) -> void:
                    handles.live[index] <- false if index < AudioRuntime::VoiceHandles::CAPACITY

    private:
        const module Limits:
            MIN_SAMPLE_RATE_HZ: u32 = 8000
            MAX_SAMPLE_RATE_HZ: u32 = 192000
            MIN_CHANNEL_COUNT: u32 = 1
            MAX_CHANNEL_COUNT: u32 = 2

        const module Status:
            OK: i32 = 0
            INVALID_ARGUMENT: i32 = -1
            INVALID_STATE: i32 = -2
            WRONG_THREAD: i32 = -3
            DEVICE_UNAVAILABLE: i32 = -4
            DECODE_FAILED: i32 = -5
            CAPACITY: i32 = -6
            INVALID_HANDLE: i32 = -7
            CLIP_IN_USE: i32 = -8
            STREAM_ENDED: i32 = -9
            BUS_MUSIC: i32 = 0
            BUS_SFX: i32 = 1
            BUS_UI: i32 = 2
            DEVICE_RECOVERY_REQUIRED: i32 = 1
            STREAM_FINISHED: i32 = 2
            PROVIDER_DEFAULT: i32 = 2

        @callconv(c)
        extern elisa_audio_v1_initialize_silent(sample_rate: u32, channels: u32) -> i32

        @callconv(c)
        extern elisa_audio_v1_initialize_default(sample_rate: u32, channels: u32) -> i32

        @callconv(c)
        extern elisa_audio_v1_take_device_recovery_request() -> i32

        @callconv(c)
        extern elisa_audio_v1_recover_with_silent_device() -> i32

        @callconv(c)
        extern elisa_audio_v1_decode_file(path: cstr, slot: mutable u32&, generation: mutable u32&) -> i32

        @callconv(c)
        extern elisa_audio_v1_release_clip(slot: u32, generation: u32) -> i32

        @callconv(c)
        extern elisa_audio_v1_play(clip_slot: u32, clip_generation: u32, looped: i32,
            bus: i32, gain: f32, priority: u32, slot: mutable u32&, generation: mutable u32&) -> i32

        @callconv(c)
        extern elisa_audio_v1_stop(slot: u32, generation: u32) -> i32

        @callconv(c)
        extern elisa_audio_v1_set_voice_spatial(slot: u32, generation: u32, gain: f32,
            pitch_ratio: f32) -> i32

        @callconv(c)
        extern elisa_audio_v1_set_bus_gain(bus: i32, gain: f32) -> i32

        @callconv(c)
        extern elisa_audio_v1_active_voice_count() -> i32

        @callconv(c)
        extern elisa_audio_v1_shutdown() -> i32

        @callconv(c)
        extern elisa_audio_v1_set_voice_budget(bus: i32, budget: u32) -> i32

        @callconv(c)
        extern elisa_audio_v1_set_bus_paused(bus: i32, paused: i32) -> i32

        @callconv(c)
        extern elisa_audio_v1_open_stream(path: cstr, looped: i32, bus: i32, gain: f32,
            slot: mutable u32&, generation: mutable u32&) -> i32

        @callconv(c)
        extern elisa_audio_v1_stop_stream(slot: u32, generation: u32) -> i32

        @callconv(c)
        extern elisa_audio_v1_pump_streams() -> i32

        @callconv(c)
        extern elisa_audio_v1_stream_status(slot: u32, generation: u32, state: mutable i32&,
            frames_played: mutable u64&, underrun_frames: mutable u64&) -> i32

        @callconv(c)
        extern elisa_audio_v1_set_stream_gain(slot: u32, generation: u32, gain: f32) -> i32

        @callconv(c)
        extern elisa_audio_v1_seek_stream(slot: u32, generation: u32, frame: u64) -> i32

        @callconv(c)
        extern elisa_audio_v1_stream_position(slot: u32, generation: u32, position: mutable u64&) -> i32

        @callconv(c)
        extern elisa_audio_v1_active_stream_count() -> i32

        @callconv(c)
        extern elisa_audio_v1_contended_callbacks(count: mutable u64&) -> i32

        @callconv(c)
        extern elisa_audio_v1_recover_device(prefer_default: i32) -> i32

        def check_status(status: i32) -> void error[AudioError]:
            raise AudioError.InvalidArgument if status == Status::INVALID_ARGUMENT
            raise AudioError.ApplicationUnavailable if status == Status::INVALID_STATE
            raise AudioError.WrongThread if status == Status::WRONG_THREAD
            raise AudioError.DeviceUnavailable if status == Status::DEVICE_UNAVAILABLE
            raise AudioError.DecodeFailed if status == Status::DECODE_FAILED
            raise AudioError.Capacity if status == Status::CAPACITY
            raise AudioError.InvalidHandle if status == Status::INVALID_HANDLE
            raise AudioError.ClipInUse if status == Status::CLIP_IN_USE
            raise AudioError.StreamEnded if status == Status::STREAM_ENDED
            raise AudioError.UnknownStatus if status != Status::OK

        def bus_code(bus: Bus) -> i32:
            match bus:
                Bus.Music:
                    Status::BUS_MUSIC
                Bus.Effects:
                    Status::BUS_SFX
                Bus.Ui:
                    Status::BUS_UI

    public:
        const MIN_SAMPLE_RATE_HZ: u32 = Limits::MIN_SAMPLE_RATE_HZ
        const MAX_SAMPLE_RATE_HZ: u32 = Limits::MAX_SAMPLE_RATE_HZ
        const MIN_CHANNEL_COUNT: u32 = Limits::MIN_CHANNEL_COUNT
        const MAX_CHANNEL_COUNT: u32 = Limits::MAX_CHANNEL_COUNT
        const MIN_PITCH_RATIO: f32 = 0.5
        const MAX_PITCH_RATIO: f32 = 2.0

        # Invalid sentinels let Elisa-owned state store optional audio handles
        # without exposing their generation fields or relying on zeroed ABI data.
        def empty_clip() -> ClipHandle:
            ClipHandle{slot: 0, generation: 0}

        def empty_voice() -> VoiceHandle:
            VoiceHandle{slot: 0, generation: 0}

        def clip_is_empty(clip: ClipHandle) -> bool:
            clip.slot == 0 and clip.generation == 0

        def voice_is_empty(voice: VoiceHandle) -> bool:
            voice.slot == 0 and voice.generation == 0

        def initialize_silent(sample_rate: u32, channels: u32) -> void error[AudioError]:
            raise AudioError.InvalidArgument if sample_rate < MIN_SAMPLE_RATE_HZ or sample_rate > MAX_SAMPLE_RATE_HZ
            raise AudioError.InvalidArgument if channels < MIN_CHANNEL_COUNT or channels > MAX_CHANNEL_COUNT
            try check_status(elisa_audio_v1_initialize_silent(sample_rate, channels))

        def initialize_default(sample_rate: u32, channels: u32) -> void error[AudioError]:
            raise AudioError.InvalidArgument if sample_rate < MIN_SAMPLE_RATE_HZ or sample_rate > MAX_SAMPLE_RATE_HZ
            raise AudioError.InvalidArgument if channels < MIN_CHANNEL_COUNT or channels > MAX_CHANNEL_COUNT
            try check_status(elisa_audio_v1_initialize_default(sample_rate, channels))

        # Device callbacks only publish a bounded recovery request. The owner
        # thread consumes it and reopens miniaudio on its null fallback.
        def take_device_recovery_request() -> bool error[AudioError]:
            status: i32 = elisa_audio_v1_take_device_recovery_request()
            try check_status(Status::OK if status >= 0 else status)
            status == Status::DEVICE_RECOVERY_REQUIRED

        def recover_with_silent_device() -> void error[AudioError]:
            try check_status(elisa_audio_v1_recover_with_silent_device())

        def decode_file(path: cstr) -> ClipHandle error[AudioError]:
            slot: mutable u32 = 0
            generation: mutable u32 = 0
            try check_status(elisa_audio_v1_decode_file(path, &slot, &generation))
            ClipHandle{slot: slot, generation: generation}

        # A clip owns decoded sample memory. Stop or drain every voice that
        # references it before releasing it; successful release frees that
        # storage and invalidates the handle.
        def release_clip(clip: ClipHandle) -> void error[AudioError]:
            try check_status(elisa_audio_v1_release_clip(clip.slot, clip.generation))

        def play(clip: ClipHandle, looped: bool, bus: Bus, gain: f32,
            priority: u32) -> VoiceHandle error[AudioError]:
            slot: mutable u32 = 0
            generation: mutable u32 = 0
            try check_status(elisa_audio_v1_play(clip.slot, clip.generation,
                1 if looped else 0, bus_code(bus), gain, priority, &slot, &generation))
            VoiceHandle{slot: slot, generation: generation}

        def stop(voice: VoiceHandle) -> void error[AudioError]:
            try check_status(elisa_audio_v1_stop(voice.slot, voice.generation))

        # Apply a spatial mix computed by Elisa policy. The mixer multiplies the
        # voice by `gain` in [0, 1] and resamples it by a Doppler `pitch_ratio`
        # in [0.5, 2]; NaN fails these ordered comparisons and is rejected.
        def set_voice_spatial(voice: VoiceHandle, gain: f32,
            pitch_ratio: f32) -> void error[AudioError]:
            raise AudioError.InvalidArgument if not (gain >= 0.0 and gain <= 1.0)
            raise AudioError.InvalidArgument if not (pitch_ratio >= MIN_PITCH_RATIO and pitch_ratio <= MAX_PITCH_RATIO)
            try check_status(elisa_audio_v1_set_voice_spatial(voice.slot, voice.generation,
                gain, pitch_ratio))

        def set_bus_gain(bus: Bus, gain: f32) -> void error[AudioError]:
            try check_status(elisa_audio_v1_set_bus_gain(bus_code(bus), gain))

        def active_voice_count() -> usize error[AudioError]:
            count: i32 = elisa_audio_v1_active_voice_count()
            try check_status(Status::OK if count >= 0 else count)
            count.usize()

        def shutdown() -> void error[AudioError]:
            try check_status(elisa_audio_v1_shutdown())

        def set_voice_budget(bus: Bus, budget: u32) -> void error[AudioError]:
            try check_status(elisa_audio_v1_set_voice_budget(bus_code(bus), budget))

        # A paused bus holds its voices and streams in place; resuming continues
        # them from the same sample. Other buses keep playing.
        def set_bus_paused(bus: Bus, paused: bool) -> void error[AudioError]:
            try check_status(elisa_audio_v1_set_bus_paused(bus_code(bus), 1 if paused else 0))

        def empty_stream() -> StreamHandle:
            StreamHandle{slot: 0, generation: 0}

        def stream_is_empty(stream: StreamHandle) -> bool:
            stream.slot == 0 and stream.generation == 0

        # Long sources stream from disk through a fixed ring (two slots). The
        # owner decodes in `pump_streams`; the device callback only copies.
        def open_stream(path: cstr, looped: bool, bus: Bus,
            gain: f32) -> StreamHandle error[AudioError]:
            slot: mutable u32 = 0
            generation: mutable u32 = 0
            try check_status(elisa_audio_v1_open_stream(path, 1 if looped else 0, bus_code(bus),
                gain, &slot, &generation))
            StreamHandle{slot: slot, generation: generation}

        # Stopping releases the decoder and the slot at once; the handle is
        # then stale and the slot can be reopened.
        def stop_stream(stream: StreamHandle) -> void error[AudioError]:
            try check_status(elisa_audio_v1_stop_stream(stream.slot, stream.generation))

        # Refill every stream once per frame. DecodeFailed means one decoder
        # failed; that stream finishes with what it had already buffered.
        def pump_streams() -> void error[AudioError]:
            try check_status(elisa_audio_v1_pump_streams())

        def stream_status(stream: StreamHandle) -> StreamStatus error[AudioError]:
            state: mutable i32 = 0
            frames_played: mutable u64 = 0
            underrun_frames: mutable u64 = 0
            try check_status(elisa_audio_v1_stream_status(stream.slot, stream.generation,
                &state, &frames_played, &underrun_frames))
            StreamStatus{
                state: StreamState.Finished if state == Status::STREAM_FINISHED else StreamState.Playing,
                frames_played: frames_played,
                underrun_frames: underrun_frames,
            }

        def set_stream_gain(stream: StreamHandle, gain: f32) -> void error[AudioError]:
            try check_status(elisa_audio_v1_set_stream_gain(stream.slot, stream.generation, gain))

        # Play on from source `frame`, dropping buffered audio. A frame past the
        # end is InvalidArgument; a one-shot stream that already ended is
        # StreamEnded, and must be stopped and opened again.
        def seek_stream(stream: StreamHandle, frame: u64) -> void error[AudioError]:
            try check_status(elisa_audio_v1_seek_stream(stream.slot, stream.generation, frame))

        # The source frame the device plays next; looped streams wrap.
        def stream_position(stream: StreamHandle) -> u64 error[AudioError]:
            position: mutable u64 = 0
            try check_status(elisa_audio_v1_stream_position(stream.slot, stream.generation, &position))
            position

        def active_stream_count() -> usize error[AudioError]:
            count: i32 = elisa_audio_v1_active_stream_count()
            try check_status(Status::OK if count >= 0 else count)
            count.usize()

        # Device callbacks that emitted silence rather than wait for the lock.
        def contended_callbacks() -> u64 error[AudioError]:
            count: mutable u64 = 0
            try check_status(elisa_audio_v1_contended_callbacks(&count))
            count

        # Reopen after device loss; streams keep playing, one-shot voices end.
        # Returns true when the system default output came back.
        def recover_device(prefer_default: bool) -> bool error[AudioError]:
            route: i32 = elisa_audio_v1_recover_device(1 if prefer_default else 0)
            try check_status(Status::OK if route >= 0 else route)
            route == Status::PROVIDER_DEFAULT
