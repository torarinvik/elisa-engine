# Engine-owned spatial audio state. Native mixers consume the bounded source
# snapshot; entity lifetime and attenuation policy remain portable and tested.
include "../math/geometry.elisa"
include "./spatial_scale.elisa"

module SpatialAudio:
    private:
        const module Limits:
            MAX_SOURCES: usize = 32
            SPEED_OF_SOUND: f32 = 343.0

        def source_slot(scene: Scene&, id: i64) -> usize:
            for index in 0..<scene.count |slot: usize = Limits::MAX_SOURCES| -> slot:
                break index if scene.sources[index].live and scene.sources[index].id == id

        def clamp_gain(value: f32) -> f32:
            return 0.0 if value <= 0.0
            return 1.0 if value >= 1.0
            value

        def finite(value: f32) -> bool:
            value - value == 0.0

        # Ordered comparisons reject NaN, and the finite checks keep infinities
        # out of the gain and Doppler math.
        def check_source(source: Source) -> void error[SpatialError]:
            raise SpatialError.InvalidValue if not Geometry::vec3_is_finite(source.position) or not Geometry::vec3_is_finite(source.velocity) or not Geometry::vec3_is_finite(source.forward)
            raise SpatialError.InvalidRange if not finite(source.maximum_distance) or not (source.minimum_distance >= 0.0 and source.maximum_distance > source.minimum_distance)
            raise SpatialError.InvalidCone if not (source.inner_cone_cos >= source.outer_cone_cos and source.inner_cone_cos <= 1.0 and source.outer_cone_cos >= -1.0)
            raise SpatialError.InvalidCone if not (source.outer_cone_gain >= 0.0 and source.outer_cone_gain <= 1.0)
            raise SpatialError.InvalidOcclusion if not (source.occlusion >= 0.0 and source.occlusion <= 1.0)

        def live_source(source: Source) -> Source:
            Source{
                id: source.id,
                position: source.position,
                velocity: source.velocity,
                forward: source.forward,
                minimum_distance: source.minimum_distance,
                maximum_distance: source.maximum_distance,
                inner_cone_cos: source.inner_cone_cos,
                outer_cone_cos: source.outer_cone_cos,
                outer_cone_gain: source.outer_cone_gain,
                occlusion: source.occlusion,
                live: true,
            }

        def attenuation(distance: f32, max_distance: f32) -> f32:
            return 0.0 if max_distance <= 0.0
            return 1.0 if distance <= 0.0
            return 0.0 if distance >= max_distance
            1.0 - distance / max_distance

    public:
        struct Listener:
            position: Geometry::Vec3
            velocity: Geometry::Vec3

        struct Source:
            id: i64
            position: Geometry::Vec3
            velocity: Geometry::Vec3
            forward: Geometry::Vec3
            minimum_distance: f32
            maximum_distance: f32
            inner_cone_cos: f32
            outer_cone_cos: f32
            outer_cone_gain: f32
            occlusion: f32
            live: bool

        enum SpatialError:
            Capacity
            DuplicateSource
            UnknownSource
            InvalidId
            InvalidRange
            InvalidCone
            InvalidOcclusion
            InvalidValue

        affine struct Scene:
            private:
                sources: mutable Source[Limits::MAX_SOURCES]
                count: mutable usize

        const MAX_SOURCES: usize = Limits::MAX_SOURCES

        def Scene() -> Scene:
            Scene{sources: zeroed, count: 0}

        def source_count(scene: Scene&) -> usize:
            scene.count

        def source_attach(scene: mutable Scene&, source: Source) -> void error[SpatialError]:
            raise SpatialError.InvalidId if source.id <= 0
            try check_source(source)
            raise SpatialError.DuplicateSource if source_slot(scene, source.id) < Limits::MAX_SOURCES
            raise SpatialError.Capacity if scene.count >= Limits::MAX_SOURCES
            # Stored sources are always live; a caller-supplied `live: false`
            # must not occupy capacity that lookups can never find again.
            scene.sources[scene.count] <- live_source(source)
            scene.count <- scene.count + 1

        def source_update(scene: mutable Scene&, source: Source) -> void error[SpatialError]:
            slot: usize = source_slot(scene, source.id)
            raise SpatialError.UnknownSource if slot >= Limits::MAX_SOURCES
            try check_source(source)
            scene.sources[slot] <- live_source(source)

        def source_detach(scene: mutable Scene&, id: i64) -> void error[SpatialError]:
            slot: usize = source_slot(scene, id)
            raise SpatialError.UnknownSource if slot >= Limits::MAX_SOURCES
            for shift in slot..<scene.count - 1 |scene|:
                scene.sources[shift] <- scene.sources[shift + 1]
            scene.count <- scene.count - 1

        def source_read(scene: Scene&, id: i64) -> Source error[SpatialError]:
            slot: usize = source_slot(scene, id)
            raise SpatialError.UnknownSource if slot >= Limits::MAX_SOURCES
            scene.sources[slot]

        def distance_gain(source: Source, listener: Listener) -> f32:
            offset: Geometry::Vec3 = Geometry::vec3_sub(source.position, listener.position)
            distance: f32 = Geometry::sqrt_f32(Geometry::vec3_length_squared(offset))
            attenuation(distance, source.maximum_distance) if source.minimum_distance == 0.0 else attenuation(distance - source.minimum_distance, source.maximum_distance - source.minimum_distance)

        def cone_gain(source: Source, listener: Listener) -> f32:
            to_listener: Geometry::Vec3 = Geometry::vec3_sub(listener.position, source.position)
            length: f32 = Geometry::sqrt_f32(Geometry::vec3_length_squared(to_listener))
            return 1.0 if length <= 0.0
            alignment: f32 = Geometry::vec3_dot(source.forward, to_listener) / length
            return 1.0 if alignment >= source.inner_cone_cos
            return source.outer_cone_gain if alignment <= source.outer_cone_cos
            source.outer_cone_gain + (alignment - source.outer_cone_cos) / (source.inner_cone_cos - source.outer_cone_cos) * (1.0 - source.outer_cone_gain)

        def spatial_gain(source: Source, listener: Listener) -> f32:
            clamp_gain(distance_gain(source, listener) * cone_gain(source, listener) * (1.0 - source.occlusion))

        # Scene scale and Doppler policy. Positions and velocities are in scene
        # units; `units_per_meter` converts the physical speed of sound so a
        # 100-units-per-metre scene hears the same pitch shift as a metre scene.
        struct Policy:
            speed_of_sound: f32
            units_per_meter: f32
            doppler_factor: f32

        def default_policy() -> Policy:
            Policy{speed_of_sound: Limits::SPEED_OF_SOUND, units_per_meter: 1.0, doppler_factor: 1.0}

        def policy_valid(policy: Policy) -> bool:
            SpatialScale::policy_valid(policy.speed_of_sound, policy.units_per_meter, policy.doppler_factor)

        # Pitch ratio (c + f*v_l) / (c - f*v_s), where v_s is the source speed
        # toward the listener and v_l the listener speed toward the source, in
        # scene units per second. Clamped to [0.5, 2]; an invalid policy or
        # coincident positions give 1.
        def doppler_ratio_scaled(source: Source, listener: Listener, policy: Policy) -> f32:
            return 1.0 if not policy_valid(policy)
            offset: Geometry::Vec3 = Geometry::vec3_sub(listener.position, source.position)
            length: f32 = Geometry::sqrt_f32(Geometry::vec3_length_squared(offset))
            return 1.0 if not (length > 0.0)
            toward_listener: Geometry::Vec3 = Geometry::vec3_scale(offset, 1.0 / length)
            source_toward: f32 = Geometry::vec3_dot(source.velocity, toward_listener)
            listener_toward: f32 = 0.0 - Geometry::vec3_dot(listener.velocity, toward_listener)
            SpatialScale::ratio(SpatialScale::scene_speed(policy.speed_of_sound, policy.units_per_meter),
                listener_toward, source_toward, policy.doppler_factor)

        # Doppler ratio for a metre-scale scene.
        def doppler_ratio(source: Source, listener: Listener) -> f32:
            doppler_ratio_scaled(source, listener, default_policy())
