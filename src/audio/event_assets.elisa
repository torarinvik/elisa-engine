# Authored sound-event assets. An asset is bounded text, one record per line:
#
#   # comment
#   seed 20260928
#   event <id> <group> <limit> <variants> <cooldown> [weight ...]
#   footstep <event> <stride_mm>
#   impact <event> <threshold_mm> <full_mm>
#   mood <id> <music> <effects> <ui> <ramp_ms>
#   music <cue> <fade_out_ms> <fade_in_ms>
#   anim <animation_event> <sound_event> <gain_permille>
#
# Fields are unsigned decimal numbers separated by spaces or tabs, and `#`
# starts a comment anywhere. Up to four weights follow the cooldown; weights
# left out are zero. A footstep or impact record binds a movement trigger to
# an event defined on an earlier line; an asset has at most one of each.
# A mood record sets one mix mood's bus gains in permille and its ramp; a
# music record sets how long one music cue takes to fade out and in.
# `define_from` checks the whole asset against a scratch board before it
# writes anything to the caller's board and triggers, so a malformed asset
# never leaves a partial event set behind.
# This source intentionally extends the SoundEventAssets module declared by
# event_asset_text.elisa, keeping the proved bounded text reader separate.
include "./events.elisa"
include "./event_asset_text.elisa"
include "./triggers.elisa"
include "./moods.elisa"
include "./music.elisa"
include "./anim_events.elisa"

extend SoundEventAssets:
    public:
        # What an asset binds besides its events: the movement triggers
        # (event 0 means none), the mix moods and the music cues.
        struct Triggers:
            footfalls: mutable AudioTriggers::Footfalls
            impacts: mutable AudioTriggers::Impacts
            moods: mutable AudioMoods::Moods
            cues: mutable AudioMusic::Cues
            anims: mutable AudioAnimEvents::Bindings

        def Triggers() -> Triggers:
            Triggers{footfalls: AudioTriggers::Footfalls(), impacts: AudioTriggers::Impacts(), moods: AudioMoods::Moods(), cues: AudioMusic::Cues(), anims: AudioAnimEvents::Bindings()}

        # Replaces `triggers` with the asset's, or leaves them untouched when
        # the asset is rejected.
        def define_from(board: mutable AudioEvents::Board&, triggers: mutable Triggers&, source: Source&) -> void error[SoundAssetError, AudioEvents::SoundEventError]:
            raise SoundAssetError.Oversize if source.length > MAX_BYTES
            scratch: mutable AudioEvents::Board = AudioEvents::Board()
            scratch_triggers: mutable Triggers = Triggers()
            try define_lines(&scratch, &scratch_triggers, source)
            triggers.footfalls <- AudioTriggers::Footfalls()
            triggers.impacts <- AudioTriggers::Impacts()
            triggers.moods <- AudioMoods::Moods()
            triggers.cues <- AudioMusic::Cues()
            triggers.anims <- AudioAnimEvents::Bindings()
            try define_lines(board, triggers, source)

        # The 1-based line of the first record `define_from` rejects, or 0.
        def failing_line(source: Source&) -> usize:
            return 1 if source.length > MAX_BYTES
            scratch: mutable AudioEvents::Board = AudioEvents::Board()
            scratch_triggers: mutable Triggers = Triggers()
            for line in 0..<MAX_BYTES |start: usize = 0, failed: usize = 0, scratch, scratch_triggers| -> failed:
                if failed == 0 and start < source.length:
                    stop: usize = line_end(source, start)
                    rejected: bool = catch define_line(&scratch, &scratch_triggers, source, start, stop):
                        ok: false
                        error failure: true
                    failed <- line + 1 if rejected
                    start <- stop + 1

    private:
        def define_lines(board: mutable AudioEvents::Board&, triggers: mutable Triggers&, source: Source&) -> void error[SoundAssetError, AudioEvents::SoundEventError]:
            requires source.length <= MAX_BYTES
            for line in 0..<MAX_BYTES |start: usize = 0, board, triggers|:
                if start < source.length:
                    stop: usize = line_end(source, start)
                    try define_line(board, triggers, source, start, stop)
                    start <- stop + 1

        # One line: an empty or comment line defines nothing.
        def define_line(board: mutable AudioEvents::Board&, triggers: mutable Triggers&, source: Source&, start: usize, stop: usize) -> void error[SoundAssetError, AudioEvents::SoundEventError]:
            requires start <= stop and stop <= source.length and source.length <= MAX_BYTES
            word_start: usize = skip_spaces(source, start, stop)
            return if word_start == stop or source.bytes[word_start] == HASH
            word_stop: usize = token_end(source, word_start, stop)
            seed: bool = is_seed(source, word_start, word_stop)
            footstep: bool = is_footstep(source, word_start, word_stop)
            impact: bool = is_impact(source, word_start, word_stop)
            mood: bool = is_mood(source, word_start, word_stop)
            music: bool = is_music(source, word_start, word_stop)
            anim: bool = is_anim(source, word_start, word_stop)
            raise SoundAssetError.UnknownRecord if not seed and not footstep and not impact and not mood and not music and not anim and not is_event(source, word_start, word_stop)
            record: Fields = try read_fields(source, word_stop, stop)
            fields: u64[SoundEventAssets::MAX_FIELDS] = record.values
            count: usize = record.count
            if footstep or impact:
                try define_trigger(board, triggers, impact, fields, count)
            elif mood:
                try define_mood(triggers, fields, count)
            elif music:
                try define_music(triggers, fields, count)
            elif anim:
                try define_anim(board, triggers, fields, count)
            elif seed:
                raise SoundAssetError.FieldCount if count != 1
                AudioEvents::set_seed(board, fields[0])
            else:
                raise SoundAssetError.FieldCount if count < 5
                for index in 0..<MAX_FIELDS |fields|:
                    raise SoundAssetError.NumberTooLarge if index != 4 and fields[index] > MAX_U32
                id: u32 = fields[0].u32()
                try AudioEvents::define(board, AudioEvents::Definition{
                    id: id,
                    group: fields[1].u32(),
                    group_limit: fields[2].u32(),
                    variants: fields[3].u32(),
                    cooldown_ticks: fields[4],
                })
                if count > 5:
                    try AudioEvents::set_weights(board, id, fields[5].u32(), fields[6].u32(), fields[7].u32(), fields[8].u32())

        # A footstep takes an event and a stride; an impact takes an event, the
        # drop first heard and the drop heard at full gain.
        def define_trigger(board: AudioEvents::Board&, triggers: mutable Triggers&, impact: bool, fields: u64[SoundEventAssets::MAX_FIELDS], count: usize) -> void error[SoundAssetError, AudioEvents::SoundEventError]:
            raise SoundAssetError.FieldCount if count != (3 if impact else 2)
            raise SoundAssetError.NumberTooLarge if fields[0] > MAX_U32
            event: u32 = fields[0].u32()
            raise AudioEvents::SoundEventError.UnknownEvent if event == 0 or not AudioEvents::defined(board, event)
            if impact:
                raise SoundAssetError.DuplicateTrigger if triggers.impacts.event != 0
                raise SoundAssetError.InvalidTrigger if not AudioTriggers::impacts_valid(event, fields[1], fields[2])
                triggers.impacts <- AudioTriggers::impacts(event, fields[1], fields[2])
            else:
                raise SoundAssetError.DuplicateTrigger if triggers.footfalls.event != 0
                raise SoundAssetError.InvalidTrigger if not AudioTriggers::footfalls_valid(event, fields[1])
                triggers.footfalls <- AudioTriggers::footfalls(event, fields[1])

        # A mood takes an id, the Music, Effects and Ui gains in permille and
        # the ramp in milliseconds.
        def define_mood(triggers: mutable Triggers&, fields: u64[SoundEventAssets::MAX_FIELDS], count: usize) -> void error[SoundAssetError]:
            raise SoundAssetError.FieldCount if count != 5
            raise SoundAssetError.InvalidMood if not AudioMoods::valid(fields[0], fields[1], fields[2], fields[3], fields[4])
            raise SoundAssetError.DuplicateMood if AudioMoods::defined(&triggers.moods, fields[0])
            value: AudioMoods::Mood = AudioMoods::mood(fields[1], fields[2], fields[3], fields[4])
            triggers.moods <- AudioMoods::with_mood(triggers.moods, fields[0], value)

        # A music record takes a cue id and its fade-out and fade-in in
        # milliseconds.
        def define_music(triggers: mutable Triggers&, fields: u64[SoundEventAssets::MAX_FIELDS], count: usize) -> void error[SoundAssetError]:
            raise SoundAssetError.FieldCount if count != 3
            raise SoundAssetError.InvalidMusic if not AudioMusic::valid(fields[0], fields[1], fields[2])
            raise SoundAssetError.DuplicateMusic if AudioMusic::defined(&triggers.cues, fields[0])
            value: AudioMusic::Cue = AudioMusic::cue(fields[1], fields[2])
            triggers.cues <- AudioMusic::with_cue(triggers.cues, fields[0], value)

        # An anim record binds an animation event id to a sound event defined
        # on an earlier line and the gain, in permille, it sounds at. An
        # animation event has at most one binding, and there are at most four.
        def define_anim(board: AudioEvents::Board&, triggers: mutable Triggers&, fields: u64[SoundEventAssets::MAX_FIELDS], count: usize) -> void error[SoundAssetError, AudioEvents::SoundEventError]:
            raise SoundAssetError.FieldCount if count != 3
            raise SoundAssetError.InvalidAnim if not AudioAnimEvents::valid(fields[0], fields[1], fields[2]) or AudioAnimEvents::full(&triggers.anims)
            raise SoundAssetError.DuplicateAnim if AudioAnimEvents::defined(&triggers.anims, fields[0])
            raise AudioEvents::SoundEventError.UnknownEvent if not AudioEvents::defined(board, fields[1].u32())
            value: AudioAnimEvents::Binding = AudioAnimEvents::binding(fields[0], fields[1], fields[2])
            triggers.anims <- AudioAnimEvents::with_binding(triggers.anims, value)
