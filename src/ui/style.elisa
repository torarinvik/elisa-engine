# Engine-owned UI style: colors and spacing for menu surfaces, separate from
# the menu model (which owns rows, focus, and scrolling) and from host widgets
# (which paint). A host reads a theme and applies it; it never chooses colors.
# The canonical fixture carries the same values so both hosts render one theme.
module UiStyle:
    private:
        const module Bounds:
            CHANNEL_MIN: i64 = 0
            CHANNEL_MAX: i64 = 255
            MAX_PADDING: i64 = 64
            MAX_BORDER: i64 = 16

    public:
        struct Color:
            r: i64
            g: i64
            b: i64
            a: i64

        struct Theme:
            background: Color
            text: Color
            disabled: Color
            focus: Color
            padding: i64
            border: i64

        def Color(r: i64, g: i64, b: i64, a: i64) -> Color:
            Color{r: r, g: g, b: b, a: a}

        def color_valid(color: Color&) -> bool:
            color.r >= Bounds::CHANNEL_MIN and color.r <= Bounds::CHANNEL_MAX and color.g >= Bounds::CHANNEL_MIN and color.g <= Bounds::CHANNEL_MAX and color.b >= Bounds::CHANNEL_MIN and color.b <= Bounds::CHANNEL_MAX and color.a >= Bounds::CHANNEL_MIN and color.a <= Bounds::CHANNEL_MAX

        def theme_default() -> Theme:
            Theme{
                background: Color(15, 15, 20, 255),
                text: Color(230, 230, 235, 255),
                disabled: Color(110, 110, 118, 255),
                focus: Color(255, 196, 64, 255),
                padding: 6,
                border: 1,
            }

        def theme_valid(theme: Theme&) -> bool:
            color_valid(theme.background) and color_valid(theme.text) and color_valid(theme.disabled) and color_valid(theme.focus) and theme.padding >= Bounds::CHANNEL_MIN and theme.padding <= Bounds::MAX_PADDING and theme.border >= Bounds::CHANNEL_MIN and theme.border <= Bounds::MAX_BORDER

        # The label color for one row state: focus wins over the normal color,
        # and a disabled row never shows the focus color.
        def theme_text_color(theme: Theme&, enabled: bool, focused: bool) -> Color:
            return theme.focus if enabled and focused
            theme.disabled if not enabled else theme.text

        def theme_surface_inset(theme: Theme&) -> i64:
            theme.padding + theme.border
