# Elisa-owned menu model: a fixed-height vertical list with focus navigation,
# hit testing, and activation. It carries no text and no rendering; it is the
# layout and interaction half the engine owns, while a host draws each row and
# a font stack measures any label. Disabled items are skipped by focus and
# ignored by a hit test, and activation is an action id the game maps to its own
# flow, so the menu never knows what "start" means.
module Ui:
    private:
        const module Tune:
            MAX_ITEMS: usize = 8
            ROW_HEIGHT: i64 = 20

    public:
        struct Item:
            action: i64
            enabled: bool

        struct Menu:
            items: mutable Item[8]
            count: mutable usize
            focus: mutable i64
            visible: mutable usize
            scroll: mutable i64
            row_height: mutable i64
            x: i64
            y: i64

        def menu_new(x: i64, y: i64) -> Menu:
            Menu{items: zeroed, count: 0, focus: -1, visible: Tune::MAX_ITEMS, scroll: 0, row_height: Tune::ROW_HEIGHT, x: x, y: y}

        def menu_add(menu: mutable Menu&, action: i64, enabled: bool) -> bool:
            return false if menu.count >= Tune::MAX_ITEMS or action <= 0
            duplicate: bool =
                for index in 0..<menu.count |found: bool = false| -> found:
                    found <- true if menu.items[index].action == action
            return false if duplicate
            menu.items[menu.count] <- Item{action: action, enabled: enabled}
            menu.count <- menu.count + 1
            if menu.focus < 0 and enabled:
                menu.focus <- menu.count.i64() - 1
            true

        def item_count(menu: Menu&) -> usize:
            menu.count

        def row_height() -> i64:
            Tune::ROW_HEIGHT

        # Row height is style data the game owns and the host applies, so a
        # denser or larger menu needs no host change.
        def menu_set_row_height(menu: mutable Menu&, height: i64) -> bool:
            return false if height <= 0
            menu.row_height <- height
            true

        def menu_row_height(menu: Menu&) -> i64:
            menu.row_height

        def menu_valid(menu: Menu&) -> bool:
            return false if menu.count > Tune::MAX_ITEMS
            return false if menu.focus < -1 or menu.focus >= menu.count.i64()
            return false if menu.visible == 0 or menu.visible > Tune::MAX_ITEMS
            return false if menu.row_height <= 0
            return false if menu.scroll < 0
            # The visible window always contains the focused row.
            return false if menu.focus >= 0 and (menu.focus < menu.scroll or menu.focus >= menu.scroll + menu.visible.i64())
            # A focused item is always enabled, and action ids are unique.
            for index in 0..<menu.count |valid: bool = true| -> valid:
                valid <- false if menu.items[index].action <= 0
                valid <- false if index.i64() == menu.focus and not menu.items[index].enabled
                unique: bool =
                    for earlier in 0..<index |inner: bool = true| -> inner:
                        inner <- false if menu.items[earlier].action == menu.items[index].action
                valid <- valid and unique
            true

        def item_action(menu: Menu&, index: usize) -> i64:
            return -1 if index >= menu.count
            menu.items[index].action

        def item_enabled(menu: Menu&, index: usize) -> bool:
            false if index >= menu.count else menu.items[index].enabled

        def visible_rows(menu: Menu&) -> usize:
            menu.visible

        def scroll_offset(menu: Menu&) -> i64:
            menu.scroll

        # Keep the focused row inside the visible window, then clamp the window
        # so it never scrolls past the last full page.
        def focus_visible(menu: mutable Menu&) -> void:
            return if menu.focus < 0
            if menu.focus < menu.scroll:
                menu.scroll <- menu.focus
            window_end: i64 = menu.scroll + menu.visible.i64() - 1
            if menu.focus > window_end:
                menu.scroll <- menu.focus - menu.visible.i64() + 1
            highest: i64 = menu.count.i64() - menu.visible.i64()
            return if highest < 0
            if menu.scroll > highest:
                menu.scroll <- highest
            if menu.scroll < 0:
                menu.scroll <- 0

        def menu_set_visible(menu: mutable Menu&, rows: usize) -> bool:
            return false if rows == 0 or rows > Tune::MAX_ITEMS
            menu.visible <- rows
            focus_visible(menu)
            true

        # Action at a visible row (0 is the top of the window), or -1.
        def visible_action(menu: Menu&, row: usize) -> i64:
            return -1 if row >= menu.visible
            index: i64 = menu.scroll + row.i64()
            return -1 if index >= menu.count.i64() or not menu.items[index.usize()].enabled
            menu.items[index.usize()].action

        def focused_action(menu: Menu&) -> i64:
            return -1 if menu.focus < 0 or menu.focus >= menu.count.i64()
            menu.items[menu.focus.usize()].action

        # Focus moves to the nearest enabled item, wrapping around, and is
        # unchanged when nothing is enabled.
        def focus_next(menu: mutable Menu&) -> bool:
            return false if menu.count == 0
            chosen: mutable i64 = -1
            for step in 1..<menu.count.i64() + 1 |menu, chosen|:
                candidate: i64 = (menu.focus + step) % menu.count.i64()
                chosen <- candidate if chosen < 0 and menu.items[candidate.usize()].enabled
            if chosen >= 0:
                menu.focus <- chosen
                focus_visible(menu)
            chosen >= 0

        def focus_previous(menu: mutable Menu&) -> bool:
            return false if menu.count == 0
            chosen: mutable i64 = -1
            for step in 1..<menu.count.i64() + 1 |menu, chosen|:
                candidate: i64 = (menu.focus - step + menu.count.i64() * 2) % menu.count.i64()
                chosen <- candidate if chosen < 0 and menu.items[candidate.usize()].enabled
            if chosen >= 0:
                menu.focus <- chosen
                focus_visible(menu)
            chosen >= 0

        # Pointer hit test: the row under the pointer, or -1 outside the list or
        # over a disabled item.
        def hit_test(menu: Menu&, pointer_y: i64) -> i64:
            relative: i64 = pointer_y - menu.y
            return -1 if relative < 0
            row: i64 = relative / menu.row_height
            return -1 if row >= menu.visible.i64()
            index: i64 = menu.scroll + row
            return -1 if index >= menu.count.i64() or not menu.items[index.usize()].enabled
            index

        # Activating a row focuses it and returns its action id; a disabled row
        # yields -1.
        def activate(menu: mutable Menu&, index: usize) -> i64:
            return -1 if index >= menu.count or not menu.items[index].enabled
            menu.focus <- index.i64()
            focus_visible(menu)
            menu.items[index].action
