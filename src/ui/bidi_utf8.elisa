# Display order for wrapped UTF-8 captions. The overlay renderer draws
# glyphs left to right in byte order and does no bidi of its own, so each
# line (split at '\n') is decoded, put in visual order by UiBidi and encoded
# again. Malformed bytes decode to U+FFFD. A line longer than 64 codepoints
# is left as it is rather than cut.
include "./locale_data.elisa"
include "./bidi.elisa"

module UiBidiUtf8:
    public:
        # Codepoints of bytes [start, stop) of `text`.
        def bidi_utf8_decode(text: UiLocaleData::Utf8&, start: i64, stop: i64) -> UiMessageFormat::Text:
            out: mutable UiMessageFormat::Text = UiMessageFormat::Text{cp: zeroed, len: 0}
            mutable cp: i64 = 0
            mutable pending: i64 = 0
            for i in 0..<256 |out, cp, pending|:
                if i.i64() >= start and i.i64() < stop and out.len < 64:
                    b: i64 = text.bytes[i].i64()
                    if b >= 128 and b < 192 and pending > 0:
                        cp <- cp * 64 + b - 128
                        pending <- pending - 1
                    else:
                        if pending > 0:
                            out.cp[out.len.usize()] <- 65533
                            out.len <- out.len + 1
                        pending <- 0 if b < 128 or b < 192 else (1 if b < 224 else (2 if b < 240 else 3))
                        cp <- b if b < 128 else (65533 if b < 192 else (b - 192 if b < 224 else (b - 224 if b < 240 else b - 240)))
                    if pending == 0 and out.len < 64:
                        out.cp[out.len.usize()] <- cp
                        out.len <- out.len + 1
            if pending > 0 and out.len < 64:
                out.cp[out.len.usize()] <- 65533
                out.len <- out.len + 1
            out

        def bidi_utf8_append(out: mutable UiLocaleData::Utf8&, text: UiLocaleData::Utf8&, start: i64, stop: i64) -> void:
            for i in 0..<256 |out|:
                if i.i64() >= start and i.i64() < stop and out.length < 256u32:
                    out.bytes[out.length.usize()] <- text.bytes[i]
                    out.length <- out.length + 1u32

        def bidi_utf8_lines(text: UiLocaleData::Utf8, rtl_paragraph: bool) -> UiLocaleData::Utf8:
            out: mutable UiLocaleData::Utf8 = UiLocaleData::Utf8()
            mutable start: i64 = 0
            n: i64 = text.length.i64()
            for i in 0..<257 |out, start|:
                at: i64 = i.i64()
                boundary: bool = at == n or (at < n and at < 256 and text.bytes[i.usize() % 256] == 10u8)
                if at <= n and boundary:
                    line: UiMessageFormat::Text = bidi_utf8_decode(&text, start, at)
                    if line.len >= 64:
                        bidi_utf8_append(&out, &text, start, at)
                    else:
                        visual: UiMessageFormat::Text = UiBidi::bidi_visual(&line, rtl_paragraph)
                        encoded: UiLocaleData::Utf8 = UiLocaleData::encode(&visual)
                        bidi_utf8_append(&out, &encoded, 0, encoded.length.i64())
                    if at < n:
                        out.bytes[out.length.usize()] <- 10u8
                        out.length <- out.length + 1u32
                    start <- at + 1
            out
