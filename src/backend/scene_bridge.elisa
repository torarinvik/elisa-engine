# Canonical scene bridge: one Elisa-owned command stream feeds both hosts.
# The Godot and Wicked probes consume the same epoch/entity/transform/viewport
# contract validated here. Neither host may invent gameplay identity.
include "../world/world.elisa"
include "../math/geometry.elisa"
include "../assets/descriptor.elisa"
include "./recording.elisa"

module SceneBridge:
    private:
        const module Limits:
            MANIFEST_VERSION: i64 = 1
            VIEWPORT_WIDTH: i32 = 320
            VIEWPORT_HEIGHT: i32 = 200
            MAX_VIEWPORT_WIDTH: i32 = 8192
            MAX_VIEWPORT_HEIGHT: i32 = 8192
            MAX_SCENE_COMMANDS: usize = 256

        const module Fixture:
            EPOCH: i64 = 7
            OBJECT_ID: i64 = 3
            CAMERA_ID: i64 = 4

    public:
        error BridgeError:
            InvalidEpoch
            IdentityMismatch
            MissingCreate
            MissingUpdate
            MissingDestroy
            UnexpectedCommand
            InvalidViewport
            Capacity

        struct CanonicalScene:
            epoch: i64
            object: World::EntityRef
            camera: World::EntityRef
            object_position: Geometry::Vec3
            camera_position: Geometry::Vec3
            viewport_width: i32
            viewport_height: i32
            saw_create: bool
            saw_update: bool
            saw_destroy: bool

        def manifest_version() -> i64:
            Limits::MANIFEST_VERSION

        def default_viewport_width() -> i32:
            Limits::VIEWPORT_WIDTH

        def default_viewport_height() -> i32:
            Limits::VIEWPORT_HEIGHT

        def viewport_valid(width: i32, height: i32) -> bool:
            width > 0 and height > 0 and width <= Limits::MAX_VIEWPORT_WIDTH and height <= Limits::MAX_VIEWPORT_HEIGHT

        def scene_valid(scene: CanonicalScene&) -> bool:
            return false if scene.epoch <= 0 or scene.object.world_epoch != scene.epoch or scene.camera.world_epoch != scene.epoch
            return false if scene.object.id <= 0 or scene.camera.id <= 0 or scene.object.id == scene.camera.id
            return false if not viewport_valid(scene.viewport_width, scene.viewport_height)
            scene.saw_create and scene.saw_update and scene.saw_destroy

        def scene_lifecycle_complete(scene: CanonicalScene&) -> bool:
            scene.saw_create and scene.saw_update and scene.saw_destroy and scene_valid(scene)

        def scene_object_matches(scene: CanonicalScene&, reference: World::EntityRef) -> bool:
            scene.object.world_epoch == reference.world_epoch and scene.object.id == reference.id

    private:
        module Build:
            private:
                struct LifecycleScan:
                    saw_create: mutable bool
                    saw_update: mutable bool
                    saw_destroy: mutable bool
                    order_ok: mutable bool
                    last_position: mutable Geometry::Vec3

                def refs_equal(left: World::EntityRef, right: World::EntityRef) -> bool:
                    left.world_epoch == right.world_epoch and left.id == right.id

                def ref_valid(reference: World::EntityRef) -> bool:
                    reference.world_epoch > 0 and reference.id > 0

                def command_at(recorder: Backend::SceneRecorder&, index: usize) -> Backend::SceneCommand error[SceneBridge::BridgeError]:
                    catch Backend::recorded_command(recorder, index):
                        value: value
                        error failure: raise SceneBridge::BridgeError.UnexpectedCommand

                def object_command_count(recorder: Backend::SceneRecorder&, object: World::EntityRef) -> usize error[SceneBridge::BridgeError]:
                    for index in 0..<Backend::recorder_command_count(recorder) |count: usize = 0| -> count:
                        command: Backend::SceneCommand = try command_at(recorder, index)
                        count <- count + 1 if command.reference.world_epoch == object.world_epoch and command.reference.id == object.id

                def camera_command_count(recorder: Backend::SceneRecorder&, camera: World::EntityRef) -> usize error[SceneBridge::BridgeError]:
                    for index in 0..<Backend::recorder_command_count(recorder) |count: usize = 0| -> count:
                        command: Backend::SceneCommand = try command_at(recorder, index)
                        count <- count + 1 if command.reference.world_epoch == camera.world_epoch and command.reference.id == camera.id

            public:
                def from_recorder(recorder: Backend::SceneRecorder&, object: World::EntityRef, camera: World::EntityRef, camera_position: Geometry::Vec3, viewport_width: i32, viewport_height: i32) -> SceneBridge::CanonicalScene error[SceneBridge::BridgeError]:
                    raise SceneBridge::BridgeError.InvalidEpoch if not ref_valid(object) or not ref_valid(camera)
                    raise SceneBridge::BridgeError.IdentityMismatch if object.world_epoch != camera.world_epoch or object.id == camera.id
                    raise SceneBridge::BridgeError.InvalidViewport if not SceneBridge::viewport_valid(viewport_width, viewport_height)
                    raise SceneBridge::BridgeError.Capacity if Backend::recorder_command_count(recorder) > SceneBridge::Limits::MAX_SCENE_COMMANDS
                    camera_commands_present: bool =
                        count: usize = try camera_command_count(recorder, camera)
                        count != 0
                    raise SceneBridge::BridgeError.UnexpectedCommand if camera_commands_present
                    object_commands_missing: bool =
                        count: usize = try object_command_count(recorder, object)
                        count < 3
                    raise SceneBridge::BridgeError.MissingCreate if object_commands_missing
                    scan: LifecycleScan =
                        for index in 0..<Backend::recorder_command_count(recorder) |scan: LifecycleScan = LifecycleScan{saw_create: false, saw_update: false, saw_destroy: false, order_ok: true, last_position: Geometry::vec3_zero()}| -> scan:
                            command: Backend::SceneCommand = try command_at(recorder, index)
                            is_object: bool = refs_equal(command.reference, object)
                            scan.order_ok <- false if not is_object
                            if is_object:
                                if command.kind == Backend::SceneCommandKind.Create:
                                    scan.order_ok <- false if scan.saw_create
                                    scan.saw_create <- true
                                    scan.last_position <- command.transform.position
                                if command.kind == Backend::SceneCommandKind.Update:
                                    scan.order_ok <- false if not scan.saw_create or scan.saw_destroy
                                    scan.saw_update <- true
                                    scan.last_position <- command.transform.position
                                if command.kind == Backend::SceneCommandKind.Destroy:
                                    scan.order_ok <- false if not scan.saw_create or scan.saw_destroy
                                    scan.saw_destroy <- true
                    raise SceneBridge::BridgeError.UnexpectedCommand if not scan.order_ok
                    raise SceneBridge::BridgeError.MissingCreate if not scan.saw_create
                    raise SceneBridge::BridgeError.MissingUpdate if not scan.saw_update
                    raise SceneBridge::BridgeError.MissingDestroy if not scan.saw_destroy
                    SceneBridge::CanonicalScene{
                        epoch: object.world_epoch,
                        object: object,
                        camera: camera,
                        object_position: scan.last_position,
                        camera_position: camera_position,
                        viewport_width: viewport_width,
                        viewport_height: viewport_height,
                        saw_create: scan.saw_create,
                        saw_update: scan.saw_update,
                        saw_destroy: scan.saw_destroy,
                    }

    public:
        def scene_from_recorder(recorder: Backend::SceneRecorder&, object: World::EntityRef, camera: World::EntityRef, camera_position: Geometry::Vec3, viewport_width: i32, viewport_height: i32) -> CanonicalScene error[BridgeError]:
            try Build::from_recorder(recorder, object, camera, camera_position, viewport_width, viewport_height)

        def canonical_fixture_epoch() -> i64:
            Fixture::EPOCH

        def canonical_fixture_object() -> World::EntityRef:
            World::EntityRef{world_epoch: canonical_fixture_epoch(), id: Fixture::OBJECT_ID}

        def canonical_fixture_camera() -> World::EntityRef:
            World::EntityRef{world_epoch: canonical_fixture_epoch(), id: Fixture::CAMERA_ID}
