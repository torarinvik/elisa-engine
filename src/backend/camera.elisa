# Backend-neutral cameras and viewports. Projection and picking stay in Elisa;
# Wicked or Godot adapters consume the resulting ray and camera state.
include "../math/geometry.elisa"
include "../vendor/elisa_math.elisa"

module Camera:
    private:
        const module Limits:
            MAX_VIEWPORT: i32 = 16384
            MIN_FOV: f32 = 0.01
            MAX_FOV: f32 = 3.13
            MIN_CLIP: f32 = 0.0001
            FRUSTUM_EPSILON: f32 = 0.00001

    public:
        enum Projection:
            Perspective
            Orthographic

        struct Viewport:
            x: i32
            y: i32
            width: i32
            height: i32
            display_scale: f32

        affine struct State:
            private:
                projection: mutable Projection
                viewport: mutable Viewport
                transform: mutable Geometry::Transform
                fov_radians: mutable f32
                ortho_height: mutable f32
                near_clip: mutable f32
                far_clip: mutable f32

        def State(width: i32, height: i32) -> State:
            State{
                projection: Projection.Perspective,
                viewport: Viewport{x: 0, y: 0, width: width, height: height, display_scale: 1.0},
                transform: Geometry::transform_identity(),
                fov_radians: 1.04719755,
                ortho_height: 10.0,
                near_clip: 0.1,
                far_clip: 1000.0,
            }

        def viewport_valid(viewport: Viewport) -> bool:
            viewport.x >= 0 and viewport.y >= 0 and viewport.width > 0 and viewport.height > 0 and viewport.width <= Limits::MAX_VIEWPORT and viewport.height <= Limits::MAX_VIEWPORT and viewport.display_scale > 0.0

        def state_valid(state: State&) -> bool:
            viewport_valid(state.viewport) and state.near_clip >= Limits::MIN_CLIP and state.far_clip > state.near_clip and state.fov_radians >= Limits::MIN_FOV and state.fov_radians <= Limits::MAX_FOV and state.ortho_height > 0.0

        def resize(state: mutable State&, width: i32, height: i32, display_scale: f32) -> bool:
            next: Viewport = Viewport{x: 0, y: 0, width: width, height: height, display_scale: display_scale}
            return false if not viewport_valid(next)
            state.viewport <- move next
            true

        def set_viewport_region(state: mutable State&, x: i32, y: i32, width: i32, height: i32, framebuffer_width: i32, framebuffer_height: i32, display_scale: f32) -> bool:
            return false if x < 0 or y < 0 or width <= 0 or height <= 0 or framebuffer_width <= 0 or framebuffer_height <= 0
            return false if framebuffer_width > Limits::MAX_VIEWPORT or framebuffer_height > Limits::MAX_VIEWPORT
            return false if width > framebuffer_width or height > framebuffer_height or x > framebuffer_width - width or y > framebuffer_height - height
            next: Viewport = Viewport{x: x, y: y, width: width, height: height, display_scale: display_scale}
            return false if not viewport_valid(next)
            state.viewport <- move next
            true

        # A minimized or occluded SDL window can report a zero pixel extent.
        # Preserve that suspended state without allowing a renderer to build a
        # divide-by-zero projection; the next non-zero resize restores validity.
        def resize_or_suspend(state: mutable State&, width: i32, height: i32, display_scale: f32) -> bool:
            return false if width < 0 or height < 0 or display_scale <= 0.0
            if width == 0 or height == 0:
                state.viewport <- Viewport{x: 0, y: 0, width: 0, height: 0, display_scale: display_scale}
                return true
            resize(state, width, height, display_scale)

        def viewport_suspended(state: State&) -> bool:
            state.viewport.width == 0 or state.viewport.height == 0

        def set_transform(state: mutable State&, transform: Geometry::Transform) -> bool:
            return false if not Geometry::quat_is_finite(transform.rotation) or not Geometry::vec3_is_finite(transform.position)
            state.transform <- transform
            true

        def set_perspective(state: mutable State&, fov_radians: f32, near_clip: f32, far_clip: f32) -> bool:
            return false if fov_radians < Limits::MIN_FOV or fov_radians > Limits::MAX_FOV or near_clip < Limits::MIN_CLIP or far_clip <= near_clip
            state.projection <- Projection.Perspective
            state.fov_radians <- fov_radians
            state.near_clip <- near_clip
            state.far_clip <- far_clip
            true

        def set_orthographic(state: mutable State&, height: f32, near_clip: f32, far_clip: f32) -> bool:
            return false if height <= 0.0 or near_clip < Limits::MIN_CLIP or far_clip <= near_clip
            state.projection <- Projection.Orthographic
            state.ortho_height <- height
            state.near_clip <- near_clip
            state.far_clip <- far_clip
            true

        def ray(state: State&, pixel_x: f32, pixel_y: f32) -> Geometry::Ray3:
            return Geometry::Ray3{origin: state.transform.position, direction: Geometry::Vec3{x: 0.0, y: 0.0, z: -1.0}} if not viewport_valid(state.viewport)
            local_x: f32 = pixel_x - state.viewport.x.f32()
            local_y: f32 = pixel_y - state.viewport.y.f32()
            ndc_x: f32 = local_x / state.viewport.width.f32() * 2.0 - 1.0
            ndc_y: f32 = 1.0 - local_y / state.viewport.height.f32() * 2.0
            aspect: f32 = state.viewport.width.f32() / state.viewport.height.f32()
            local_origin: mutable Geometry::Vec3 = Geometry::vec3_zero()
            local_direction: mutable Geometry::Vec3 = Geometry::Vec3{x: 0.0, y: 0.0, z: -1.0}
            if state.projection == Projection.Perspective:
                half_height: f32 = ElisaMath::tanf(state.fov_radians * 0.5)
                local_direction <- Geometry::vec3_normalize(Geometry::Vec3{x: ndc_x * aspect * half_height, y: ndc_y * half_height, z: -1.0})
            else:
                local_origin <- Geometry::Vec3{x: ndc_x * state.ortho_height * aspect * 0.5, y: ndc_y * state.ortho_height * 0.5, z: 0.0}
            Geometry::Ray3{
                origin: Geometry::transform_apply_point(state.transform, local_origin),
                direction: Geometry::quat_rotate(state.transform.rotation, local_direction),
            }

        private def plane_intersects(bounds: Geometry::Bounds3, normal_x: f32,
                normal_y: f32, normal_z: f32, offset: f32) -> bool:
            support_x: f32 = bounds.maximum.x if normal_x >= 0.0 else bounds.minimum.x
            support_y: f32 = bounds.maximum.y if normal_y >= 0.0 else bounds.minimum.y
            support_z: f32 = bounds.maximum.z if normal_z >= 0.0 else bounds.minimum.z
            normal_x * support_x + normal_y * support_y + normal_z * support_z + offset >= -Limits::FRUSTUM_EPSILON

        # Transform the world AABB into camera space, then test its enclosing
        # camera-space AABB against every projection plane. The enclosing box
        # keeps the result conservative after camera rotation or nonuniform
        # scale: visible geometry is never culled by this policy.
        public def bounds_visible(state: State&, bounds: Geometry::Bounds3) -> bool:
            return false if not state_valid(state) or not Geometry::bounds3_valid(bounds)
            corners: Geometry::Vec3[8] = [
                Geometry::Vec3{x: bounds.minimum.x, y: bounds.minimum.y, z: bounds.minimum.z},
                Geometry::Vec3{x: bounds.maximum.x, y: bounds.minimum.y, z: bounds.minimum.z},
                Geometry::Vec3{x: bounds.minimum.x, y: bounds.maximum.y, z: bounds.minimum.z},
                Geometry::Vec3{x: bounds.maximum.x, y: bounds.maximum.y, z: bounds.minimum.z},
                Geometry::Vec3{x: bounds.minimum.x, y: bounds.minimum.y, z: bounds.maximum.z},
                Geometry::Vec3{x: bounds.maximum.x, y: bounds.minimum.y, z: bounds.maximum.z},
                Geometry::Vec3{x: bounds.minimum.x, y: bounds.maximum.y, z: bounds.maximum.z},
                Geometry::Vec3{x: bounds.maximum.x, y: bounds.maximum.y, z: bounds.maximum.z},
            ]
            local_min: mutable Geometry::Vec3 = Geometry::transform_apply_inverse_point(state.transform, corners[0])
            local_max: mutable Geometry::Vec3 = local_min
            for index in 1..<8 |local_min, local_max|:
                point: Geometry::Vec3 = Geometry::transform_apply_inverse_point(state.transform, corners[index])
                local_min <- Geometry::Vec3{
                    x: point.x if point.x < local_min.x else local_min.x,
                    y: point.y if point.y < local_min.y else local_min.y,
                    z: point.z if point.z < local_min.z else local_min.z,
                }
                local_max <- Geometry::Vec3{
                    x: point.x if point.x > local_max.x else local_max.x,
                    y: point.y if point.y > local_max.y else local_max.y,
                    z: point.z if point.z > local_max.z else local_max.z,
                }
            local_bounds: Geometry::Bounds3 = Geometry::Bounds3{minimum: local_min, maximum: local_max}
            return false if not plane_intersects(local_bounds, 0.0, 0.0, -1.0, -state.near_clip)
            return false if not plane_intersects(local_bounds, 0.0, 0.0, 1.0, state.far_clip)
            if state.projection == Projection.Perspective:
                half_height: f32 = ElisaMath::tanf(state.fov_radians * 0.5)
                half_width: f32 = half_height * state.viewport.width.f32() / state.viewport.height.f32()
                return false if not plane_intersects(local_bounds, 1.0, 0.0, -half_width, 0.0)
                return false if not plane_intersects(local_bounds, -1.0, 0.0, -half_width, 0.0)
                return false if not plane_intersects(local_bounds, 0.0, 1.0, -half_height, 0.0)
                return false if not plane_intersects(local_bounds, 0.0, -1.0, -half_height, 0.0)
            else:
                half_height: f32 = state.ortho_height * 0.5
                half_width: f32 = half_height * state.viewport.width.f32() / state.viewport.height.f32()
                return false if not plane_intersects(local_bounds, 1.0, 0.0, 0.0, half_width)
                return false if not plane_intersects(local_bounds, -1.0, 0.0, 0.0, half_width)
                return false if not plane_intersects(local_bounds, 0.0, 1.0, 0.0, half_height)
                return false if not plane_intersects(local_bounds, 0.0, -1.0, 0.0, half_height)
            true

        def projection(state: State&) -> Projection:
            state.projection

        def viewport(state: State&) -> Viewport:
            state.viewport

        def perspective_fov(state: State&) -> f32:
            state.fov_radians

        def orthographic_height(state: State&) -> f32:
            state.ortho_height

        def near_clip(state: State&) -> f32:
            state.near_clip

        def far_clip(state: State&) -> f32:
            state.far_clip
