# Portable backend selection policy. Profiles describe what a host actually
# supplies; they do not claim that a native library is integrated.
module Capabilities:
    private:
        const module Bounds:
            MAX_FEATURES: usize = 8
            MIN_SERVICE_VERSION: i64 = 1
            CAP_INPUT: i64 = 1
            CAP_RENDERING: i64 = 2
            CAP_PHYSICS: i64 = 4
            CAP_AUDIO: i64 = 8
            CAP_NATIVE_WINDOW: i64 = 16
            CAP_ASYNC_UPLOAD: i64 = 32
            CAP_CALLBACKS: i64 = 64
            CAP_ASSET_LOADING: i64 = 128
            OPTIONAL_RAY_TRACING: i64 = 1
            OPTIONAL_SPARSE_TEXTURES: i64 = 2
            OPTIONAL_MESH_SHADERS: i64 = 4
            FORMAT_RGBA8: i64 = 1
            FORMAT_BC1: i64 = 2
            FORMAT_R16_FLOAT: i64 = 4
            NATIVE_CAPABILITY_BITS: i64 = 255
            NATIVE_OPTIONAL_BITS: i64 = 7
            NATIVE_FORMAT_BITS: i64 = 7

    public:
        enum BackendKind:
            Headless
            Native
            Godot

        enum BackendFeature:
            Input
            Rendering
            Physics
            Audio
            NativeWindow
            AsyncUpload
            Callbacks
            AssetLoading

        enum BackendLimit:
            Entities
            TextureDimension
            UploadBytes
            Workers
            MemoryBytes
            Viewports
            GraphicsWorkers
            StreamingWorkers

        enum BackendOptionalFeature:
            RayTracing
            SparseTextures
            MeshShaders

        enum BackendTextureFormat:
            Rgba8
            Bc1
            R16Float
            Unsupported

        enum RequirementState:
            Ready
            Fallback
            Unavailable
            Invalid

        struct BackendCapabilities:
            input: bool
            rendering: bool
            physics: bool
            audio: bool
            native_window: bool
            async_upload: bool
            callbacks: bool
            asset_loading: bool

        struct BackendOptionalCapabilities:
            ray_tracing: bool
            sparse_textures: bool
            mesh_shaders: bool

        struct BackendLimits:
            max_entities: i64
            max_texture_dimension: i64
            max_upload_bytes: i64
            workers: i64
            memory_budget_bytes: i64
            memory_usage_bytes: i64
            max_viewports: i64
            graphics_workers: i64
            streaming_workers: i64

        struct BackendTextureFormats:
            rgba8: bool
            bc1: bool
            r16_float: bool

        struct TextureFormatDecision:
            state: RequirementState
            format: BackendTextureFormat

        # `first_missing` is meaningful only when state is Unavailable and
        # `missing_count` is nonzero. Counts are over the supplied requirement
        # list, so repeated requirements remain visible to the caller.
        struct BackendRequirementReport:
            state: RequirementState
            first_missing: BackendFeature
            missing_count: usize
            fallback_count: usize

        struct BackendProfile:
            kind: BackendKind
            capabilities: BackendCapabilities
            optional_capabilities: BackendOptionalCapabilities
            limits: BackendLimits
            texture_formats: BackendTextureFormats
            service_version: i64

        def backend_supports(profile: BackendProfile, feature: BackendFeature) -> bool:
            match feature:
                BackendFeature.Input:
                    profile.capabilities.input
                BackendFeature.Rendering:
                    profile.capabilities.rendering
                BackendFeature.Physics:
                    profile.capabilities.physics
                BackendFeature.Audio:
                    profile.capabilities.audio
                BackendFeature.NativeWindow:
                    profile.capabilities.native_window
                BackendFeature.AsyncUpload:
                    profile.capabilities.async_upload
                BackendFeature.Callbacks:
                    profile.capabilities.callbacks
                BackendFeature.AssetLoading:
                    profile.capabilities.asset_loading

        def backend_supports_optional(profile: BackendProfile, feature: BackendOptionalFeature) -> bool:
            match feature:
                BackendOptionalFeature.RayTracing:
                    profile.optional_capabilities.ray_tracing
                BackendOptionalFeature.SparseTextures:
                    profile.optional_capabilities.sparse_textures
                BackendOptionalFeature.MeshShaders:
                    profile.optional_capabilities.mesh_shaders

        def fallback_supports(fallbacks: BackendCapabilities, feature: BackendFeature) -> bool:
            match feature:
                BackendFeature.Input:
                    fallbacks.input
                BackendFeature.Rendering:
                    fallbacks.rendering
                BackendFeature.Physics:
                    fallbacks.physics
                BackendFeature.Audio:
                    fallbacks.audio
                BackendFeature.NativeWindow:
                    fallbacks.native_window
                BackendFeature.AsyncUpload:
                    fallbacks.async_upload
                BackendFeature.Callbacks:
                    fallbacks.callbacks
                BackendFeature.AssetLoading:
                    fallbacks.asset_loading

        # Stable diagnostic codes for the flat C embedding surface. Keep these
        # independent of the compiler's internal enum representation.
        def backend_feature_code(feature: BackendFeature) -> i32:
            match feature:
                BackendFeature.Input:
                    1
                BackendFeature.Rendering:
                    2
                BackendFeature.Physics:
                    3
                BackendFeature.Audio:
                    4
                BackendFeature.NativeWindow:
                    5
                BackendFeature.AsyncUpload:
                    6
                BackendFeature.Callbacks:
                    7
                BackendFeature.AssetLoading:
                    8

        def backend_limit(profile: BackendProfile, limit: BackendLimit) -> i64:
            match limit:
                BackendLimit.Entities:
                    profile.limits.max_entities
                BackendLimit.TextureDimension:
                    profile.limits.max_texture_dimension
                BackendLimit.UploadBytes:
                    profile.limits.max_upload_bytes
                BackendLimit.Workers:
                    profile.limits.workers
                BackendLimit.MemoryBytes:
                    profile.limits.memory_budget_bytes - profile.limits.memory_usage_bytes
                BackendLimit.Viewports:
                    profile.limits.max_viewports
                BackendLimit.GraphicsWorkers:
                    profile.limits.graphics_workers
                BackendLimit.StreamingWorkers:
                    profile.limits.streaming_workers

        def backend_limit_supports(profile: BackendProfile, limit: BackendLimit, requested: i64) -> bool:
            requested > 0 and backend_limit(profile, limit) >= requested

        def backend_profile_valid(profile: BackendProfile) -> bool:
            version_ok: bool = profile.service_version >= Bounds::MIN_SERVICE_VERSION
            entities_ok: bool = profile.limits.max_entities >= 0
            texture_ok: bool = profile.limits.max_texture_dimension >= 0
            upload_ok: bool = profile.limits.max_upload_bytes >= 0
            workers_ok: bool = profile.limits.workers >= 0 and profile.limits.max_viewports >= 0 and profile.limits.graphics_workers >= 0 and profile.limits.streaming_workers >= 0
            memory_ok: bool = profile.limits.memory_budget_bytes > 0 and profile.limits.memory_usage_bytes >= 0 and profile.limits.memory_usage_bytes <= profile.limits.memory_budget_bytes
            formats_ok: bool = profile.capabilities.rendering or (not profile.texture_formats.rgba8 and not profile.texture_formats.bc1 and not profile.texture_formats.r16_float)
            optional_ok: bool = profile.capabilities.rendering or (not profile.optional_capabilities.ray_tracing and not profile.optional_capabilities.sparse_textures and not profile.optional_capabilities.mesh_shaders)
            viewport_ok: bool = not profile.capabilities.rendering or profile.limits.max_viewports > 0
            version_ok and entities_ok and texture_ok and upload_ok and workers_ok and memory_ok and formats_ok and optional_ok and viewport_ok

        # Native ABI v2 reports only values the host can query. Resource-type
        # capacities that the ABI does not measure remain zero (unknown), so
        # they can never accidentally satisfy a limit requirement.
        def backend_profile_from_native(capabilities: i64, optional: i64,
            max_viewports: i64, max_workers: i64, memory_budget: i64, memory_usage: i64,
            formats: i64, graphics_workers: i64, streaming_workers: i64,
            service_version: i64) -> BackendProfile:
            BackendProfile{
                kind: BackendKind.Native,
                capabilities: BackendCapabilities{
                    input: capabilities / Bounds::CAP_INPUT % 2 == 1,
                    rendering: capabilities / Bounds::CAP_RENDERING % 2 == 1,
                    physics: capabilities / Bounds::CAP_PHYSICS % 2 == 1,
                    audio: capabilities / Bounds::CAP_AUDIO % 2 == 1,
                    native_window: capabilities / Bounds::CAP_NATIVE_WINDOW % 2 == 1,
                    async_upload: capabilities / Bounds::CAP_ASYNC_UPLOAD % 2 == 1,
                    callbacks: capabilities / Bounds::CAP_CALLBACKS % 2 == 1,
                    asset_loading: capabilities / Bounds::CAP_ASSET_LOADING % 2 == 1,
                },
                optional_capabilities: BackendOptionalCapabilities{
                    ray_tracing: optional / Bounds::OPTIONAL_RAY_TRACING % 2 == 1,
                    sparse_textures: optional / Bounds::OPTIONAL_SPARSE_TEXTURES % 2 == 1,
                    mesh_shaders: optional / Bounds::OPTIONAL_MESH_SHADERS % 2 == 1,
                },
                limits: BackendLimits{
                    max_entities: 0,
                    max_texture_dimension: 0,
                    max_upload_bytes: 0,
                    workers: max_workers,
                    memory_budget_bytes: memory_budget,
                    memory_usage_bytes: memory_usage,
                    max_viewports: max_viewports,
                    graphics_workers: graphics_workers,
                    streaming_workers: streaming_workers,
                },
                texture_formats: BackendTextureFormats{
                    rgba8: formats / Bounds::FORMAT_RGBA8 % 2 == 1,
                    bc1: formats / Bounds::FORMAT_BC1 % 2 == 1,
                    r16_float: formats / Bounds::FORMAT_R16_FLOAT % 2 == 1,
                },
                service_version: service_version,
            }

        def backend_native_bits_valid(capabilities: i64, optional: i64, formats: i64) -> bool:
            capabilities_ok: bool = capabilities >= 0 and capabilities <= Bounds::NATIVE_CAPABILITY_BITS
            optional_ok: bool = optional >= 0 and optional <= Bounds::NATIVE_OPTIONAL_BITS
            formats_ok: bool = formats >= 0 and formats <= Bounds::NATIVE_FORMAT_BITS
            capabilities_ok and optional_ok and formats_ok

        def backend_format_supported(profile: BackendProfile, format: BackendTextureFormat) -> bool:
            match format:
                BackendTextureFormat.Rgba8:
                    profile.texture_formats.rgba8
                BackendTextureFormat.Bc1:
                    profile.texture_formats.bc1
                BackendTextureFormat.R16Float:
                    profile.texture_formats.r16_float
                BackendTextureFormat.Unsupported:
                    false

        def negotiate_texture_format(profile: BackendProfile, requested: BackendTextureFormat,
            normal_map: bool, has_alpha: bool, allow_fallback: bool) -> TextureFormatDecision:
            invalid: TextureFormatDecision = TextureFormatDecision{
                state: RequirementState.Invalid,
                format: BackendTextureFormat.Unsupported,
            }
            unavailable: TextureFormatDecision = TextureFormatDecision{
                state: RequirementState.Unavailable,
                format: BackendTextureFormat.Unsupported,
            }
            return invalid if not backend_profile_valid(profile) or requested == BackendTextureFormat.Unsupported
            rgba8: bool = backend_format_supported(profile, BackendTextureFormat.Rgba8)
            safe_fallback: TextureFormatDecision = TextureFormatDecision{
                state: RequirementState.Fallback,
                format: BackendTextureFormat.Rgba8,
            }
            if normal_map:
                return TextureFormatDecision{state: RequirementState.Ready, format: BackendTextureFormat.Rgba8} if requested == BackendTextureFormat.Rgba8 and rgba8
                return safe_fallback if allow_fallback and rgba8
                return unavailable
            requested_safe: bool = backend_format_supported(profile, requested) and not (requested == BackendTextureFormat.Bc1 and has_alpha)
            return TextureFormatDecision{state: RequirementState.Ready, format: requested} if requested_safe
            return safe_fallback if allow_fallback and rgba8
            unavailable

        # Limits use the same explicit policy as feature bits: callers can
        # choose a bounded fallback instead of silently accepting a smaller
        # resource than they requested.
        def negotiate_limit(profile: BackendProfile, limit: BackendLimit,
            requested: i64, allow_fallback: bool) -> RequirementState:
            return RequirementState.Invalid if not backend_profile_valid(profile) or requested <= 0
            return RequirementState.Ready if backend_limit(profile, limit) >= requested
            RequirementState.Fallback if allow_fallback else RequirementState.Unavailable

        def backend_requirements_met(profile: BackendProfile, required: BackendFeature[Bounds::MAX_FEATURES], count: usize) -> bool:
            return false if count > Bounds::MAX_FEATURES
            for index in 0..<count |met: bool = true| -> met:
                break false if not backend_supports(profile, required[index])

        def backend_requirement_report(profile: BackendProfile,
            required: BackendFeature[Bounds::MAX_FEATURES], count: usize,
            fallbacks: BackendCapabilities, allow_fallback: bool) -> BackendRequirementReport:
            invalid: BackendRequirementReport = BackendRequirementReport{
                state: RequirementState.Invalid,
                first_missing: BackendFeature.Input,
                missing_count: 0,
                fallback_count: 0,
            }
            return invalid if count > Bounds::MAX_FEATURES or not backend_profile_valid(profile)
            missing_count: mutable usize = 0
            fallback_count: mutable usize = 0
            first_missing: mutable BackendFeature = BackendFeature.Input
            for index in 0..<count |missing_count, fallback_count, first_missing|:
                feature: BackendFeature = required[index]
                if not backend_supports(profile, feature):
                    if allow_fallback and fallback_supports(fallbacks, feature):
                        fallback_count <- fallback_count + 1
                    else:
                        first_missing <- feature if missing_count == 0
                        missing_count <- missing_count + 1
            state: mutable RequirementState = RequirementState.Ready
            if missing_count > 0:
                state <- RequirementState.Unavailable
            else:
                state <- RequirementState.Fallback if fallback_count > 0
            BackendRequirementReport{
                state: state,
                first_missing: first_missing,
                missing_count: missing_count,
                fallback_count: fallback_count,
            }

        def negotiate_requirements(profile: BackendProfile,
            required: BackendFeature[Bounds::MAX_FEATURES], count: usize,
            fallbacks: BackendCapabilities, allow_fallback: bool) -> RequirementState:
            backend_requirement_report(profile, required, count, fallbacks, allow_fallback).state

        def first_missing_requirement(profile: BackendProfile, required: BackendFeature[Bounds::MAX_FEATURES], count: usize) -> BackendFeature:
            no_fallbacks: BackendCapabilities = BackendCapabilities{
                input: false, rendering: false, physics: false, audio: false,
                native_window: false, async_upload: false, callbacks: false, asset_loading: false,
            }
            backend_requirement_report(profile, required, count, no_fallbacks, false).first_missing

        def fallback_requirement_count(profile: BackendProfile,
            required: BackendFeature[Bounds::MAX_FEATURES], count: usize,
            fallbacks: BackendCapabilities) -> usize:
            backend_requirement_report(profile, required, count, fallbacks, true).fallback_count

        def headless_profile() -> BackendProfile:
            BackendProfile{
                kind: BackendKind.Headless,
                capabilities: BackendCapabilities{
                    input: true,
                    rendering: false,
                    physics: false,
                    audio: false,
                    native_window: false,
                    async_upload: false,
                    callbacks: false,
                    asset_loading: false,
                },
                optional_capabilities: BackendOptionalCapabilities{
                    ray_tracing: false,
                    sparse_textures: false,
                    mesh_shaders: false,
                },
                limits: BackendLimits{
                    max_entities: 256,
                    max_texture_dimension: 1,
                    max_upload_bytes: 1048576,
                    workers: 1,
                    memory_budget_bytes: 67108864,
                    memory_usage_bytes: 8388608,
                    max_viewports: 0,
                    graphics_workers: 0,
                    streaming_workers: 0,
                },
                texture_formats: BackendTextureFormats{rgba8: false, bc1: false, r16_float: false},
                service_version: Bounds::MIN_SERVICE_VERSION,
            }
