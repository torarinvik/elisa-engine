# Portable backend selection policy. Profiles describe what a host actually
# supplies; they do not claim that a native library is integrated.
module Capabilities:
    private:
        const module Bounds:
            MAX_FEATURES: usize = 8
            MIN_SERVICE_VERSION: i64 = 1

    public:
        enum BackendKind:
            Headless
            Native
            Godot

        enum BackendFeature:
            Input
            Rendering
            Physics
            Audio
            NativeWindow
            AsyncUpload
            Callbacks
            AssetLoading

        enum BackendLimit:
            Entities
            TextureDimension
            UploadBytes
            Workers

        struct BackendCapabilities:
            input: bool
            rendering: bool
            physics: bool
            audio: bool
            native_window: bool
            async_upload: bool
            callbacks: bool
            asset_loading: bool

        struct BackendLimits:
            max_entities: i64
            max_texture_dimension: i64
            max_upload_bytes: i64
            workers: i64

        struct BackendProfile:
            kind: BackendKind
            capabilities: BackendCapabilities
            limits: BackendLimits
            service_version: i64

        def backend_supports(profile: BackendProfile, feature: BackendFeature) -> bool:
            match feature:
                BackendFeature.Input:
                    profile.capabilities.input
                BackendFeature.Rendering:
                    profile.capabilities.rendering
                BackendFeature.Physics:
                    profile.capabilities.physics
                BackendFeature.Audio:
                    profile.capabilities.audio
                BackendFeature.NativeWindow:
                    profile.capabilities.native_window
                BackendFeature.AsyncUpload:
                    profile.capabilities.async_upload
                BackendFeature.Callbacks:
                    profile.capabilities.callbacks
                BackendFeature.AssetLoading:
                    profile.capabilities.asset_loading

        def backend_limit(profile: BackendProfile, limit: BackendLimit) -> i64:
            match limit:
                BackendLimit.Entities:
                    profile.limits.max_entities
                BackendLimit.TextureDimension:
                    profile.limits.max_texture_dimension
                BackendLimit.UploadBytes:
                    profile.limits.max_upload_bytes
                BackendLimit.Workers:
                    profile.limits.workers

        def backend_limit_supports(profile: BackendProfile, limit: BackendLimit, requested: i64) -> bool:
            requested > 0 and backend_limit(profile, limit) >= requested

        def backend_profile_valid(profile: BackendProfile) -> bool:
            version_ok: bool = profile.service_version >= Bounds::MIN_SERVICE_VERSION
            entities_ok: bool = profile.limits.max_entities > 0
            texture_ok: bool = profile.limits.max_texture_dimension > 0
            upload_ok: bool = profile.limits.max_upload_bytes > 0
            workers_ok: bool = profile.limits.workers > 0
            version_ok and entities_ok and texture_ok and upload_ok and workers_ok

        def backend_requirements_met(profile: BackendProfile, required: BackendFeature[Bounds::MAX_FEATURES], count: usize) -> bool:
            return false if count > Bounds::MAX_FEATURES
            for index in 0..<count |met: bool = true| -> met:
                break false if not backend_supports(profile, required[index])

        def headless_profile() -> BackendProfile:
            BackendProfile{
                kind: BackendKind.Headless,
                capabilities: BackendCapabilities{
                    input: true,
                    rendering: false,
                    physics: false,
                    audio: false,
                    native_window: false,
                    async_upload: false,
                    callbacks: false,
                    asset_loading: false,
                },
                limits: BackendLimits{max_entities: 256, max_texture_dimension: 1, max_upload_bytes: 1048576, workers: 1},
                service_version: Bounds::MIN_SERVICE_VERSION,
            }
