# Per-frame render diagnostics and budget verdicts. Each pass reports CPU and
# optional GPU time plus draw, upload and resource-byte counts; the report
# accumulates them in a fixed shape. A GPU time of Gpu::NONE means the device or
# driver gave none, and the report says so instead of inventing a number: one
# unavailable pass makes the whole frame's GPU total unavailable. Cold frames
# (first use, shader and cache warm-up) are judged against their own budget.
module FrameReport:
    public:
        const module Gpu:
            NONE: i64 = -1

        enum Verdict:
            Within
            OverCpu
            OverGpu
            OverDraws
            OverUploads
            OverResources

        struct Budget:
            cpu_us: i64
            gpu_us: i64
            draws: i64
            upload_bytes: i64
            resource_bytes: i64

        struct Report:
            passes: i64
            cpu_us: i64
            gpu_us: i64
            gpu_known: bool
            draws: i64
            upload_bytes: i64
            resource_bytes: i64
            slowest_pass: i64
            slowest_cpu_us: i64

        def Report() -> Report:
            Report{passes: 0, cpu_us: 0, gpu_us: 0, gpu_known: true, draws: 0, upload_bytes: 0, resource_bytes: 0, slowest_pass: -1, slowest_cpu_us: -1}

        def valid_pass(cpu_us: i64, gpu_us: i64, draws: i64, uploads: i64, bytes: i64) -> bool:
            return false if cpu_us < 0 or draws < 0 or uploads < 0 or bytes < 0
            gpu_us >= Gpu::NONE

        # Adds one pass. Negative counts are refused (the report is returned
        # unchanged) so a bad probe cannot lower a total.
        def record(report: Report, pass_id: i64, cpu_us: i64, gpu_us: i64, draws: i64, uploads: i64, bytes: i64) -> Report:
            return report if not valid_pass(cpu_us, gpu_us, draws, uploads, bytes)
            known: bool = report.gpu_known and gpu_us != Gpu::NONE
            gpu_total: i64 = report.gpu_us + gpu_us if gpu_us != Gpu::NONE else report.gpu_us
            slower: bool = cpu_us > report.slowest_cpu_us
            Report{passes: report.passes + 1, cpu_us: report.cpu_us + cpu_us, gpu_us: gpu_total, gpu_known: known, draws: report.draws + draws, upload_bytes: report.upload_bytes + uploads, resource_bytes: report.resource_bytes + bytes, slowest_pass: pass_id if slower else report.slowest_pass, slowest_cpu_us: cpu_us if slower else report.slowest_cpu_us}

        # Whether the GPU figure was measured. Callers print "unavailable"
        # when false, so logs and Tracy plots never show 0 for "not measured".
        def gpu_measured(report: Report&) -> bool:
            report.gpu_known and report.passes > 0

        # First budget the frame exceeds, in the fixed order cpu, gpu, draws,
        # uploads, resources. An unavailable GPU total is never a failure.
        def judge(report: Report&, budget: Budget&) -> Verdict:
            return Verdict.OverCpu if report.cpu_us > budget.cpu_us
            return Verdict.OverGpu if report.gpu_known and report.gpu_us > budget.gpu_us
            return Verdict.OverDraws if report.draws > budget.draws
            return Verdict.OverUploads if report.upload_bytes > budget.upload_bytes
            return Verdict.OverResources if report.resource_bytes > budget.resource_bytes
            Verdict.Within

        # Frame 0 is cold and uses the looser budget.
        def judge_frame(report: Report&, frame: i64, cold: Budget&, warm: Budget&) -> Verdict:
            return judge(report, cold) if frame <= 0
            judge(report, warm)
