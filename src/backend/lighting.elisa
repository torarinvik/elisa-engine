# Backend-neutral lighting and environment descriptors. Native adapters own
# engine components while gameplay and tools exchange validated values.
include "../math/geometry.elisa"

module Lighting:
    private:
        const module Limits:
            ZERO_VECTOR_SQUARED: f32 = 0.000001
            MAX_FINITE_PARAMETER: f32 = 1000000000000000000000000000000.0
            MIN_SHADOW_RESOLUTION: i32 = 16
            MAX_SHADOW_RESOLUTION: i32 = 2048
            MAX_AREA_LIGHT_DIMENSION: f32 = 1000000.0
            MAX_VOLUMETRIC_BOOST: f32 = 8.0

        def finite(value: f32) -> bool:
            value == value and value >= -Limits::MAX_FINITE_PARAMETER and value <= Limits::MAX_FINITE_PARAMETER

        def shadow_resolution_valid(resolution: i32) -> bool:
            return true if resolution == 0
            return false if resolution < Limits::MIN_SHADOW_RESOLUTION or resolution > Limits::MAX_SHADOW_RESOLUTION
            (resolution & (resolution - 1)) == 0

    public:
        enum LightKind:
            Directional
            Point
            Spot
            Rectangle

        struct Light:
            kind: LightKind
            color: Geometry::Vec3
            position: Geometry::Vec3
            # Ignored for point lights; their direction may be zero.
            direction: Geometry::Vec3
            intensity: f32
            range: f32
            # Used by spot lights; point and directional lights canonicalize both to zero.
            inner_cone: f32
            outer_cone: f32
            casts_shadow: bool
            # 0 selects Wicked's automatic resolution; otherwise a power of two from 16 to 2048.
            shadow_resolution: i32
            # Rectangle lights require positive dimensions; other kinds require both values to be zero.
            rectangle_width: f32
            rectangle_height: f32
            volumetrics_enabled: bool
            # Scales this light's contribution to the volumetric fog pass.
            volumetric_boost: f32

        struct Environment:
            sun_color: Geometry::Vec3
            sun_direction: Geometry::Vec3
            ambient: Geometry::Vec3
            sky_exposure: f32
            fog_color: Geometry::Vec3
            fog_start: f32
            fog_density: f32
            fog_enabled: bool

        def light_valid(light: Light) -> bool:
            return false if not Geometry::vec3_is_finite(light.color) or not Geometry::vec3_is_finite(light.position) or not Geometry::vec3_is_finite(light.direction)
            return false if not finite(light.intensity) or not finite(light.range) or not finite(light.inner_cone) or not finite(light.outer_cone)
            return false if light.color.x < 0.0 or light.color.y < 0.0 or light.color.z < 0.0 or light.intensity < 0.0 or light.range <= 0.0
            return false if light.kind != LightKind.Point and Geometry::vec3_length_squared(light.direction) <= Limits::ZERO_VECTOR_SQUARED
            return false if light.kind == LightKind.Spot and (light.inner_cone < 0.0 or light.outer_cone <= 0.0 or light.inner_cone > light.outer_cone)
            return false if not shadow_resolution_valid(light.shadow_resolution)
            return false if not finite(light.rectangle_width) or not finite(light.rectangle_height)
            return false if light.rectangle_width < 0.0 or light.rectangle_height < 0.0 or light.rectangle_width > Limits::MAX_AREA_LIGHT_DIMENSION or light.rectangle_height > Limits::MAX_AREA_LIGHT_DIMENSION
            return false if light.kind == LightKind.Rectangle and (light.rectangle_width <= 0.0 or light.rectangle_height <= 0.0)
            return false if light.kind != LightKind.Rectangle and (light.rectangle_width != 0.0 or light.rectangle_height != 0.0)
            return false if not finite(light.volumetric_boost) or light.volumetric_boost < 0.0 or light.volumetric_boost > Limits::MAX_VOLUMETRIC_BOOST
            true

        def environment_valid(environment: Environment) -> bool:
            return false if not Geometry::vec3_is_finite(environment.sun_color) or not Geometry::vec3_is_finite(environment.sun_direction)
            return false if not Geometry::vec3_is_finite(environment.ambient) or not Geometry::vec3_is_finite(environment.fog_color)
            return false if environment.sun_color.x < 0.0 or environment.sun_color.y < 0.0 or environment.sun_color.z < 0.0
            return false if environment.ambient.x < 0.0 or environment.ambient.y < 0.0 or environment.ambient.z < 0.0
            return false if not finite(environment.sky_exposure) or not finite(environment.fog_start) or not finite(environment.fog_density)
            return false if environment.sky_exposure < 0.0 or environment.fog_start < 0.0 or environment.fog_density < 0.0
            Geometry::vec3_length_squared(environment.sun_direction) > Limits::ZERO_VECTOR_SQUARED
