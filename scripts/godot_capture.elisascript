# Rendered-output capture and cross-host comparison for the Godot side.
#
# Run with: elisascript scripts/godot_capture.elisascript
#
# This is deliberately separate from scripts/check.elisascript: it needs a
# real display driver, because Godot's --headless mode forces the dummy
# rendering driver and would capture a blank frame by construction. The
# main gate keeps the headless command-lifecycle probe, which stays
# runnable on machines with no window server.
#
# It requires the native frame from scripts/wicked_probe.elisascript; run
# that first. Both hosts consume the same backends/scene_manifest.txt.
#
# The Godot invocations are inlined in main rather than wrapped in a helper:
# the script verifier rejects a second process-spawning helper in one file
# (see docs/adr/0010 for the sibling constraints).

def godot_path() -> sview:
    _ =
        configured: sview = get_environment_or("GODOT_BIN", "")
        if configured != "":
            return configured
        configured

    directories: darray[sview] =
        search_path: sview = get_environment_or("PATH", "")
        split(search_path, ":")

    for directory in directories:
        candidate: sview =
            base: sview = "." if directory == "" else directory
            f"{base}/godot"

        if is_file(path(candidate)) and is_executable(path(candidate)):
            return candidate
    ""

# Status-only process calls discard output. Relay both captured streams so
# tool diagnostics remain visible, including when a child exits unsuccessfully.
def run_visible(program: sview, arguments: darray[sview]) -> i64:
    result: ProcessCapture =
        empty_input: sview = ""
        capture_process_result(executable(program), arguments, empty_input)

    _ = write_stdout(result.stdout)
    _ = write_stderr(result.stderr)
    result.exit_status

def main(arguments: darray[sview]) -> i64:
    if arguments.count != 0:
        eprint("usage: elisascript scripts/godot_capture.elisascript")
        return 2
    root: Path = Script::source_path().parent().parent()
    python: sview = get_environment_or("PYTHON_BIN", "python3")
    compare: sview = str(root.joinpath("scripts/compare_renders.py"))
    manifest: sview = str(root.joinpath("backends/scene_manifest.txt"))
    frame: sview = str(root.joinpath("build/godot-frame.png"))
    rerun: sview = str(root.joinpath("build/godot-frame-rerun.png"))
    native_frame: sview = str(root.joinpath("build/wicked-frame.png"))
    project: sview = str(root.joinpath("backends/godot"))

    godot: sview =
        candidate: sview = godot_path()
        if candidate == "" or not is_file(path(candidate)) or not is_executable(path(candidate)):
            eprint("Install Godot or set GODOT_BIN to its executable path.")
            return 2
        candidate

    # Cook authored assets before the host runs, so the host loads a package
    # rather than the source format.
    _ =
        cook_status: i64 = run_visible(python, [str(root.joinpath("scripts/cook_assets.py")), str(root)])
        if cook_status != 0:
            return cook_status
        cook_status

    first_capture: ProcessCapture =
        empty_input: sview = ""
        capture_process_result(executable(godot), ["--path", project, "--script", "res://capture.gd", "--", manifest, frame], empty_input)
    _ = write_stdout(first_capture.stdout)
    _ = write_stderr(first_capture.stderr)
    if first_capture.exit_status != 0:
        return first_capture.exit_status

    # Determinism: the same scene must capture identical pixels twice.
    _ =
        status: i64 = run_visible(godot, ["--path", project, "--script", "res://capture.gd", "--", manifest, rerun])
        if status != 0:
            return status
        status

    # One verification pass over the frame and its rerun: dimensions,
    # non-blank, determinism, and that the frame encodes the Elisa wall list
    # (ignoring only the cells the manifest declares the object covers).
    # Godot's --headless mode forces the dummy rendering driver, so this
    # runner needs a real display session, unlike the main gate's probe.
    _ =
        status: i64 = run_visible(python, [compare, "verify", frame, rerun, "320", "200", "8", "8", manifest])
        if status != 0:
            return status
        status

    println("Godot frame verified: dimensions, determinism, Elisa topology.")

    # Measured frame time against the fixture budget: median and p95.
    _ =
        status: i64 = run_visible(python, [compare, "perf", str(root.joinpath("build/godot-frame-stats.txt")), manifest])
        if status != 0:
            return status
        status

    println("Godot frame time within budget.")

    if not is_file(path(native_frame)):
        eprint("Native frame missing; run scripts/wicked_probe.elisascript first.")
        return 2

    _ =
        status: i64 = run_visible(python, [compare, "pattern-match", frame, native_frame, "8", "8", f"@{manifest}"])
        if status != 0:
            return status
        status

    println("Godot and Wicked frames agree on scene semantics.")
    0
