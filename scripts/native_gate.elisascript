# Native-first validation composition.
# Modes: quick (policy checks), headless (quick + sanitizer boundary), native
# (headless + the SDL3/Wicked gate). Godot is intentionally not a prerequisite.

def run_visible(stage: sview, program: sview, arguments: darray[sview]) -> i64:
    result: ProcessCapture =
        empty_input: sview = ""
        capture_process_result(executable(program), arguments, empty_input)
    _ = write_stdout(result.stdout)
    _ = write_stderr(result.stderr)
    # Name the failing sub-stage so a nonzero gate never ends in silence.
    if result.exit_status != 0:
        eprint("native gate: stage failed:")
        eprint(stage)
    result.exit_status

def run_native_stage(stage: sview, program: sview, arguments: darray[sview]) -> i64:
    exit_status: i64 = try run_process(executable(program), arguments) else 1
    if exit_status != 0:
        eprint("native gate: stage failed:")
        eprint(stage)
    exit_status

def main(arguments: darray[sview]) -> i64:
    if arguments.count > 1:
        eprint("usage: elisascript scripts/native_gate.elisascript [quick|headless|native]")
        return 2
    mode: sview = "quick" if arguments.count == 0 else arguments[0]
    return 2 if mode != "quick" and mode != "headless" and mode != "native"
    root: Path = Script::source_path().parent().parent()
    report_path: Path = root.joinpath("build/native-gate.json")
    _ = create_directories(root.joinpath("build"))
    _ = write_text(report_path, "{}\n")
    python: sview = get_environment_or("PYTHON_BIN", "python3")
    launcher: sview = get_environment_or("ELISASCRIPT_BIN", "elisascript")
    dependency_check: sview = str(root.joinpath("scripts/check_dependency_manifest.py"))
    dependency_result: ProcessCapture =
        empty_input: sview = ""
        capture_process_result(executable(python), [dependency_check, "--root", str(root)], empty_input)
    _ = write_stdout(dependency_result.stdout)
    _ = write_stderr(dependency_result.stderr)
    dependency_status: i64 = dependency_result.exit_status
    source_result: ProcessCapture =
        empty_input: sview = ""
        capture_process_result(executable(python), [str(root.joinpath("scripts/check_source_length.py"))], empty_input)
    _ = write_stdout(source_result.stdout)
    _ = write_stderr(source_result.stderr)
    source_status: i64 = source_result.exit_status
    hygiene_result: ProcessCapture =
        empty_input: sview = ""
        capture_process_result(executable(python), [str(root.joinpath("scripts/check_module_hygiene.py"))], empty_input)
    _ = write_stdout(hygiene_result.stdout)
    _ = write_stderr(hygiene_result.stderr)
    hygiene_status: i64 = hygiene_result.exit_status
    # -1 is an explicit skip. Zero is pass and positive values are failures.
    headless_status: mutable i64 = -1
    application_status: mutable i64 = -1
    native_status: mutable i64 = -1
    if mode == "headless" or mode == "native":
        headless_result: ProcessCapture =
            empty_input: sview = ""
            capture_process_result(executable(python), [str(root.joinpath("scripts/run_boundary_sanitized.py"))], empty_input)
        _ = write_stdout(headless_result.stdout)
        _ = write_stderr(headless_result.stderr)
        headless_status <- headless_result.exit_status
    if mode == "native":
        native_status <- run_native_stage("build-gate", launcher, [str(root.joinpath("scripts/wicked_probe.elisascript")), "build-gate"])
        smoke_cases: darray[sview] = [
            "physics-pose-inertia-smoke", "physics-material-smoke",
            "physics-ccd3d-smoke", "world-physics-pose-smoke",
            "render-resource-churn-smoke", "cell-streaming-smoke",
            "render-many-instances-smoke", "world-save-physics-smoke",
            "world-physics-cadence-smoke", "world-hierarchy-render-smoke",
            "world-picking-smoke", "bounds-view-smoke",
            "world-audio-physics-smoke", "world-audio-scale-smoke",
            "quality-settings-native-smoke", "physics-primitives-smoke",
            "physics-runtime-query-smoke", "physics-constraints-smoke",
            "physics-interactables-smoke", "character-course-smoke",
            "character-course-relaunch-smoke", "character-course-cells-smoke",
            "physics-collision-layers-smoke",
            "physics-mesh-shapes-smoke", "physics-render-capture-smoke",
            "application-native-smoke", "application-gamepad-rumble-smoke",
            "application-async-capture-smoke",
            "application-error-message-smoke", "application-failure-cleanup-smoke",
        ]
        application_script: sview = str(root.joinpath("scripts/application_native_smoke.py"))
        if native_status == 0:
            application_status <- 0i64
            for smoke_case in smoke_cases:
                if application_status == 0:
                    # The runner enforces this pair and launches each project as a child.
                    if smoke_case != "character-course-relaunch-smoke":
                        if smoke_case == "character-course-smoke":
                            application_status <- run_visible(
                                "character-course-smoke-and-relaunch", python,
                                [application_script, "--only", "character-course-smoke,character-course-relaunch-smoke"])
                        else:
                            application_status <- run_visible(smoke_case, python, [application_script, "--only", smoke_case])
        native_status <- -1i64 if native_status == 0 and application_status > 0
        if native_status == 0 and application_status == 0:
            render_script: sview = str(root.joinpath("scripts/render_scene_native_smoke.py"))
            render_modes: darray[sview] = ["native", "controls", "debug", "render"]
            for render_mode in render_modes:
                if native_status == 0:
                    native_status <- run_visible(render_mode, python, [render_script, "--only", render_mode])
        if native_status == 0:
            native_status <- run_native_stage("frame", launcher, [str(root.joinpath("scripts/wicked_probe.elisascript")), "frame"])
        if native_status == 0:
            native_status <- run_native_stage("rerun", launcher, [str(root.joinpath("scripts/wicked_probe.elisascript")), "rerun"])
        if native_status == 0:
            native_status <- run_native_stage("verify", launcher, [str(root.joinpath("scripts/wicked_probe.elisascript")), "verify"])
    report_result: ProcessCapture =
        empty_input: sview = ""
        capture_process_result(executable(python), [str(root.joinpath("scripts/write_native_gate_report.py")), str(report_path), mode, str(dependency_status), str(source_status), str(hygiene_status), str(headless_status), str(application_status), str(native_status)], empty_input)
    _ = write_stdout(report_result.stdout)
    _ = write_stderr(report_result.stderr)
    status: mutable i64 = dependency_status
    status <- source_status if status == 0 and source_status != 0
    status <- hygiene_status if status == 0 and hygiene_status != 0
    status <- headless_status if status == 0 and headless_status > 0
    status <- application_status if status == 0 and application_status > 0
    status <- native_status if status == 0 and native_status > 0
    return report_result.exit_status if report_result.exit_status != 0
    status
