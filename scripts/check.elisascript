        eprint("Build elisa-proof or set ELISA_PROOF_BIN to its executable path.")
        return 2

    _ = create_directories(root.joinpath("build"))
    # A failed later step must not leave an older success report looking current.
    _ = root.joinpath("build/entity-id-proof.json").unlink()
    _ = root.joinpath("build/world-proof.json").unlink()
    _ = root.joinpath("build/validation.json").unlink()
    test_binary: sview = str(root.joinpath("build/entity-id-test"))
    _ =
        status: i64 = run_visible(compiler, ["-emit", "exe", "-o", test_binary, str(root.joinpath("test/entity_id.elisa"))])
        if status != 0:
            return status
        status
    _ =
        status: i64 = run_visible(test_binary, [])
        if status != 0:
            return status
        status

