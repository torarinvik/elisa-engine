# Keep gate diagnostics line-oriented on the canonical stderr API.
def report_error_line(message: sview) -> void:
    _ = try write_stderr(message) else 0
    _ = try write_stderr("\n") else 0

def tool_path(variable: sview, name: sview) -> sview:
    _ =
        configured: sview = get_environment_or(variable, "")
        if configured != "":
            return configured
        configured
    directories: darray[sview] =
        search_path: sview = get_environment_or("PATH", "")
        split(search_path, ":")
    for directory in directories:
        candidate: sview =
            base: sview = "." if directory == "" else directory
            f"{base}/{name}"
        if is_file(path(candidate)) and is_executable(path(candidate)):
            return candidate
    ""
def run_visible(program: sview, arguments: darray[sview]) -> i64:
    # A spawn that never started (e.g. ENOMEM under swap pressure) is a silent 126: retry, then name the program.
    for attempt in 0..<3:
        result: ProcessCapture =
            empty_input: sview = ""
            capture_process_result(executable(program), arguments, empty_input)
        if result.exit_status != 126 or result.stdout != "" or result.stderr != "":
            _ = write_stdout(result.stdout)
            _ = write_stderr(result.stderr)
            return result.exit_status
    report_error_line("check: could not start:")
    report_error_line(program)
    126
def rejects_owner_violation(compiler: sview, source: sview, output: sview, privacy: bool = false) -> bool:
    # Retry only empty compiler crashes; preserve changed diagnostics as real failures.
    for attempt in 0..<2:
        rejection: ProcessCapture =
            empty_input: sview = ""
            capture_process_result(executable(compiler), ["-emit", "obj", "-o", output, source], empty_input)
        if rejection.exit_status == 0:
            report_error_line("An invalid owner operation was accepted.")
            return false
        return "is private to module" in rejection.stderr if privacy
        return true if "linear value" in rejection.stderr
        return true if "expects " in rejection.stderr and ", got " in rejection.stderr and "&" in rejection.stderr
        if rejection.stderr != "":
            _ = write_stderr(rejection.stderr)
            break
    report_error_line("The negative owner fixture failed for another reason.")
    false
def main(arguments: darray[sview]) -> i64:
    if arguments.count != 0:
        report_error_line("usage: elisascript scripts/check.elisascript")
        return 2
    root: Path = Script::source_path().parent().parent()
    compiler: sview =
        candidate: sview = tool_path("ELISA_COMPILER_BIN", "elisac-stage1")
        if candidate == "" or not is_file(path(candidate)) or not is_executable(path(candidate)):
            report_error_line("Put elisac-stage1 on PATH or set ELISA_COMPILER_BIN to its executable path.")
            return 2
        candidate
    prover: sview =
        configured_prover: sview = get_environment_or("ELISA_PROOF_BIN", "")
        str(root.joinpath("../elisa-engine-proof/build/elisa-proof")) if configured_prover == "" else configured_prover
    if not is_file(path(prover)) or not is_executable(path(prover)):
        report_error_line("Build ../elisa-engine-proof or set ELISA_PROOF_BIN to its executable path.")
        return 2
    _ = create_directories(root.joinpath("build"))
    proofs: darray[sview] = # Every implementation-linked proof in proof/ gates the check.
        entries: darray[sview] = list_directory(root.joinpath("proof"))
        names: mutable darray[sview] = []
        for entry in entries:
            if entry.endswith(".elisa"):
                names.push(entry.removesuffix(".elisa"))
        names
    for name in proofs: # Clear stale reports before checks; f-string locals trap the launcher, so paths are concatenated.
        report_name: sview = name.replace("_", "-")
        _ = root.joinpath("build/" + report_name + "-proof.json").unlink()
    _ = root.joinpath("build/validation.json").unlink()
    python: sview = get_environment_or("PYTHON_BIN", "python3")
    # Parallel, cached compile+run of scripts/gate_tests.json (some tests keep -O0 for the 120-second process limit).
    tests_status: i64 = run_visible(python, [str(root.joinpath("scripts/run_tests.py")), compiler])
    return tests_status if tests_status != 0
    sdl3_test_binary: sview = str(root.joinpath("build/sdl3-test"))
    sdl3_library_dir: sview = get_environment_or("ELISA_SDL3_LIB_DIR", "/opt/homebrew/lib")
    _ =
        status: i64 = run_visible(compiler, ["-emit", "exe", "-o", sdl3_test_binary, "-L", sdl3_library_dir, "-l", "SDL3", str(root.joinpath("test/sdl3.elisa"))])
        if status != 0:
            return status
        status
    _ =
        status: i64 = run_visible(sdl3_test_binary, [])
        if status != 0:
            return status
        status
    print("SDL3 platform probe passed.")
    godot_binary: sview = tool_path("GODOT_BIN", "godot")
    if godot_binary == "" or not is_file(path(godot_binary)) or not is_executable(path(godot_binary)):
        report_error_line("Install Godot or set GODOT_BIN to its executable path.")
        return 2
    godot_project: sview = str(root.joinpath("backends/godot"))
    godot_probe: sview = str(root.joinpath("backends/godot/probe.gd"))
    scene_manifest: sview = str(root.joinpath("backends/scene_manifest.txt"))
    godot_probes: darray[sview] = [godot_probe, str(root.joinpath("backends/godot/lighting_probe.gd")), str(root.joinpath("backends/godot/quality_probe.gd"))]
    for probe in godot_probes:
        status: i64 = run_visible(godot_binary, ["--headless", "--path", godot_project, "--script", probe, "--", scene_manifest] if probe == godot_probe else ["--headless", "--path", godot_project, "--script", probe])
        if status != 0:
            return status
    native_unit_status: i64 = run_visible(get_environment_or("PYTHON_BIN", "python3"), [str(root.joinpath("scripts/native_unit_tests.py"))])
    return native_unit_status if native_unit_status != 0
    interactive_validator_status: i64 = run_visible(get_environment_or("PYTHON_BIN", "python3"), [str(root.joinpath("scripts/test_interactive_macos_app.py"))])
    return interactive_validator_status if interactive_validator_status != 0
    scene_file_status: i64 = run_visible(get_environment_or("PYTHON_BIN", "python3"), [str(root.joinpath("scripts/scene_file.py")), "--self-test"])
    return scene_file_status if scene_file_status != 0
    skin_limit_status: i64 = run_visible(get_environment_or("PYTHON_BIN", "python3"), [str(root.joinpath("scripts/gltf_skin_limit_test.py"))])
    return skin_limit_status if skin_limit_status != 0
    skin_influence_status: i64 = run_visible(get_environment_or("PYTHON_BIN", "python3"), [str(root.joinpath("scripts/glb_skin_influence_smoke.py"))])
    return skin_influence_status if skin_influence_status != 0
    locale_keys_status: i64 = run_visible(get_environment_or("PYTHON_BIN", "python3"), [str(root.joinpath("scripts/locale_keys.py")), "--self-test"])
    return locale_keys_status if locale_keys_status != 0
    smoke_artifacts_status: i64 = run_visible(get_environment_or("PYTHON_BIN", "python3"), [str(root.joinpath("scripts/native_smoke_artifacts.py")), "--self-test"])
    return smoke_artifacts_status if smoke_artifacts_status != 0
    # The Metal viewport bridge (no window) builds through its own link script.
    for viewport_test in ["viewport_render", "viewport_motion"]:
        if run_visible("bash", [str(root.joinpath("scripts/build_viewport_native_test.sh")), viewport_test]) != 0 or run_visible(str(root.joinpath(f"build/{viewport_test}-test")), []) != 0:
            return 1
    for nav_test in ["nav_cook_native", "nav_tiles_native", "nav_tile_stream_native", "nav_tile_routes_native"]:
        if run_visible("bash", [str(root.joinpath("scripts/build_nav_native_test.sh")), nav_test]) != 0 or run_visible(str(root.joinpath(f"build/{nav_test}-test")), []) != 0:
            return 1
    rejection_output: sview = str(root.joinpath("build/ownership-negative.o"))
    for fixture in ["allocator_copy", "world_copy", "recorder_copy", "bridge_copy"]:
        if not rejects_owner_violation(compiler, str(root.joinpath(f"test/negative/{fixture}.elisa")), rejection_output):
            return 1
    for fixture in ["allocator_private_read", "allocator_private_construct", "allocator_private_zeroed", "world_private_write", "recorder_private_read", "bridge_private_write", "queue_private_read"]:
        if not rejects_owner_violation(compiler, str(root.joinpath(f"test/negative/{fixture}.elisa")), rejection_output, true):
            return 1
    # Cached, parallel proofs: unchanged prover + include closure answers from build/proof-cache.
    # The script verifier rejects a main that never captures a process itself, so call it directly.
    proof_run: ProcessCapture =
        empty_input: sview = ""
        capture_process_result(executable(python), [str(root.joinpath("scripts/prove_all.py")), prover], empty_input)
    _ = write_stdout(proof_run.stdout)
    _ = write_stderr(proof_run.stderr)
    if proof_run.exit_status != 0:
        return proof_run.exit_status
    launcher: sview = get_environment_or("ELISASCRIPT_BIN", "elisascript")
    validation_status: i64 = run_visible(python, [str(root.joinpath("scripts/record_validation.py")), str(root), compiler, prover, launcher])
    validation_status
