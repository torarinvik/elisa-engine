# Run with: elisascript scripts/check.elisascript
# Tool arguments are passed directly; no shell command strings are constructed.
def compiler_path() -> sview:
    _ =
        configured: sview = get_environment_or("ELISA_COMPILER_BIN", "")
        if configured != "":
            return configured
        configured

    directories: darray[sview] =
        search_path: sview = get_environment_or("PATH", "")
        split(search_path, ":")

    for directory in directories:
        candidate: sview =
            base: sview = "." if directory == "" else directory
            f"{base}/elisac-stage1"

        if is_file(path(candidate)) and is_executable(path(candidate)):
            return candidate
    ""
def godot_path() -> sview:
    _ =
        configured: sview = get_environment_or("GODOT_BIN", "")
        if configured != "":
            return configured
        configured

    directories: darray[sview] =
        search_path: sview = get_environment_or("PATH", "")
        split(search_path, ":")

    for directory in directories:
        candidate: sview =
            base: sview = "." if directory == "" else directory
            f"{base}/godot"

        if is_file(path(candidate)) and is_executable(path(candidate)):
            return candidate
    ""
# Status-only process calls discard output. Relay both captured streams so tool
# diagnostics remain visible, including when a child exits unsuccessfully.
def run_visible(program: sview, arguments: darray[sview]) -> i64:
    result: ProcessCapture =
        empty_input: sview = ""
        capture_process_result(executable(program), arguments, empty_input)

    _ = write_stdout(result.stdout)
    _ = write_stderr(result.stderr)
    result.exit_status
def rejects_owner_violation(compiler: sview, source: sview, output: sview, privacy: bool = false) -> bool:
    # A compiler crash leaves a nonzero status and an empty diagnostic. Retry
    # only that case once; a changed non-empty diagnostic is not retried, so a
    # real contract change still fails.
    for attempt in 0..<2:
        rejection: ProcessCapture =
            empty_input: sview = ""
            capture_process_result(executable(compiler), ["-emit", "obj", "-o", output, source], empty_input)
        if rejection.exit_status == 0:
            eprint("An invalid owner operation was accepted.")
            return false
        return "is private to module" in rejection.stderr if privacy
        return true if "linear value" in rejection.stderr
        return true if "expects " in rejection.stderr and ", got " in rejection.stderr and "&" in rejection.stderr
        if rejection.stderr != "":
            _ = write_stderr(rejection.stderr)
            break
    eprint("The negative owner fixture failed for another reason.")
    false

def main(arguments: darray[sview]) -> i64:
    if arguments.count != 0:
        eprint("usage: elisascript scripts/check.elisascript")
        return 2
    root: Path = Script::source_path().parent().parent()
    compiler: sview =
        candidate: sview = compiler_path()
        if candidate == "" or not is_file(path(candidate)) or not is_executable(path(candidate)):
            eprint("Put elisac-stage1 on PATH or set ELISA_COMPILER_BIN to its executable path.")
            return 2
        candidate

    prover: sview =
        configured_prover: sview = get_environment_or("ELISA_PROOF_BIN", "")
