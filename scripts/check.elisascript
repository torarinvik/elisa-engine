# Run with: elisascript scripts/check.elisascript
# Tool arguments are passed directly; no shell command strings are constructed.

def compiler_path() -> sview:
    _ =
        configured: sview = get_environment_or("ELISA_COMPILER_BIN", "")
        if configured != "":
            return configured
        configured

    directories: darray[sview] =
        search_path: sview = get_environment_or("PATH", "")
        split(search_path, ":")

    for directory in directories:
        candidate: sview =
            base: sview = "." if directory == "" else directory
            f"{base}/elisac-stage1"

        if is_file(path(candidate)) and is_executable(path(candidate)):
            return candidate
    ""

def godot_path() -> sview:
    _ =
        configured: sview = get_environment_or("GODOT_BIN", "")
        if configured != "":
            return configured
        configured

    directories: darray[sview] =
        search_path: sview = get_environment_or("PATH", "")
        split(search_path, ":")

    for directory in directories:
        candidate: sview =
            base: sview = "." if directory == "" else directory
            f"{base}/godot"

        if is_file(path(candidate)) and is_executable(path(candidate)):
            return candidate
    ""

# Status-only process calls discard output. Relay both captured streams so tool
# diagnostics remain visible, including when a child exits unsuccessfully.
def run_visible(program: sview, arguments: darray[sview]) -> i64:
    result: ProcessCapture =
        empty_input: sview = ""
        capture_process_result(executable(program), arguments, empty_input)

    _ = write_stdout(result.stdout)
    _ = write_stderr(result.stderr)
    result.exit_status


def rejects_ownership_copy(compiler: sview, source: sview, output: sview) -> bool:
    rejection: ProcessCapture =
        empty_input: sview = ""
        capture_process_result(executable(compiler), ["-emit", "obj", "-o", output, source], empty_input)
    if rejection.exit_status == 0:
        eprint("An affine owner was copied without a compiler error.")
        return false
    if not ("linear value" in rejection.stderr):
        _ = write_stderr(rejection.stderr)
        eprint("The negative ownership fixture failed for another reason.")
        return false
    true

def main(arguments: darray[sview]) -> i64:
    if arguments.count != 0:
        eprint("usage: elisascript scripts/check.elisascript")
        return 2
    root: Path = Script::source_path().parent().parent()
    compiler: sview =
        candidate: sview = compiler_path()
        if candidate == "" or not is_file(path(candidate)) or not is_executable(path(candidate)):
            eprint("Put elisac-stage1 on PATH or set ELISA_COMPILER_BIN to its executable path.")
            return 2
        candidate

    prover: sview =
        configured_prover: sview = get_environment_or("ELISA_PROOF_BIN", "")
        str(root.joinpath("../elisa-proof/build/elisa-proof")) if configured_prover == "" else configured_prover

    if not is_file(path(prover)) or not is_executable(path(prover)):
        eprint("Build elisa-proof or set ELISA_PROOF_BIN to its executable path.")
        return 2

    _ = create_directories(root.joinpath("build"))
    # A failed later step must not leave an older success report looking current.
    _ = root.joinpath("build/entity-id-proof.json").unlink()
    _ = root.joinpath("build/world-proof.json").unlink()
    _ = root.joinpath("build/validation.json").unlink()
    test_binary: sview = str(root.joinpath("build/entity-id-test"))
    _ =
        status: i64 = run_visible(compiler, ["-emit", "exe", "-o", test_binary, str(root.joinpath("test/entity_id.elisa"))])
        if status != 0:
            return status
        status

    _ =
        status: i64 = run_visible(test_binary, [])
        if status != 0:
            return status
        status

    println("Entity identity runtime tests passed.")

    world_test_binary: sview = str(root.joinpath("build/world-test"))
