# Saved accessibility settings for the character course: text size, a
# high-contrast HUD, sound captions, reduced motion and the caption language.
# The rebind menu edits them as five rows after the six key slots; a load
# that fails any check keeps defaults. Version 1 saves (no language) load as
# English, and versions 1 and 2 (no motion flag) load with full motion.
module CourseAccess:
    private:
        const module Limits:
            KEY: cstr = "course-access"
            VERSION: i64 = 3
            FIELD_COUNT: usize = 6
            V2_FIELD_COUNT: usize = 5
            V1_FIELD_COUNT: usize = 4
            MIN_SCALE: i64 = 100
            MAX_SCALE: i64 = 150
            SCALE_STEP: i64 = 25
            CAPTION_NANOS: u64 = 2500000000

        def rejected_load(status: LoadStatus) -> LoadResult:
            LoadResult{status: status, settings: defaults()}

        def flag(value: bool) -> i64:
            1 if value else 0

        def color(red: f32, green: f32, blue: f32, alpha: f32) -> RenderScene::Color:
            RenderScene::Color{red: red, green: green, blue: blue, alpha: alpha}

    public:
        const ROW_TEXT_SIZE: i64 = 0
        const ROW_CONTRAST: i64 = 1
        const ROW_CAPTIONS: i64 = 2
        const ROW_MOTION: i64 = 3
        const ROW_LANGUAGE: i64 = 4
        const ROW_COUNT: i64 = 5

        struct Settings:
            text_scale: i64
            high_contrast: bool
            captions: bool
            reduced_motion: bool
            locale: i64

        enum LoadStatus:
            Loaded
            Missing
            Unreadable
            Rejected

        struct LoadResult:
            status: LoadStatus
            settings: Settings

        # The caption line shows the newest sound event until `until_nanos`.
        struct Captions:
            event: u32
            until_nanos: u64

        def defaults() -> Settings:
            Settings{text_scale: Limits::MIN_SCALE, high_contrast: false, captions: false, reduced_motion: false, locale: UiLocale::EN}

        def storage_key() -> cstr:
            Limits::KEY

        def valid(settings: Settings&) -> bool:
            in_range: bool = settings.text_scale >= Limits::MIN_SCALE and settings.text_scale <= Limits::MAX_SCALE
            in_range and (settings.text_scale - Limits::MIN_SCALE) % Limits::SCALE_STEP == 0 and UiLocale::locale_valid(settings.locale)

        # `delta` is -1 or +1 from Left/Right; text size clamps, flags toggle.
        def adjust(settings: Settings, row: i64, delta: i64) -> Settings:
            if row == ROW_TEXT_SIZE:
                next: i64 = settings.text_scale + delta * Limits::SCALE_STEP
                clamped: i64 = Limits::MIN_SCALE if next < Limits::MIN_SCALE else (Limits::MAX_SCALE if next > Limits::MAX_SCALE else next)
                Settings{text_scale: clamped, high_contrast: settings.high_contrast, captions: settings.captions, reduced_motion: settings.reduced_motion, locale: settings.locale}
            elif row == ROW_CONTRAST:
                Settings{text_scale: settings.text_scale, high_contrast: not settings.high_contrast, captions: settings.captions, reduced_motion: settings.reduced_motion, locale: settings.locale}
            elif row == ROW_CAPTIONS:
                Settings{text_scale: settings.text_scale, high_contrast: settings.high_contrast, captions: not settings.captions, reduced_motion: settings.reduced_motion, locale: settings.locale}
            elif row == ROW_MOTION:
                Settings{text_scale: settings.text_scale, high_contrast: settings.high_contrast, captions: settings.captions, reduced_motion: not settings.reduced_motion, locale: settings.locale}
            elif row == ROW_LANGUAGE:
                next_locale: i64 = (settings.locale + delta + UiLocale::LOCALES) % UiLocale::LOCALES
                Settings{text_scale: settings.text_scale, high_contrast: settings.high_contrast, captions: settings.captions, reduced_motion: settings.reduced_motion, locale: next_locale}
            else:
                settings

        def row_name(row: i64) -> cstr:
            if row == ROW_TEXT_SIZE:
                "Text size"
            elif row == ROW_CONTRAST:
                "High contrast"
            elif row == ROW_CAPTIONS:
                "Captions"
            elif row == ROW_MOTION:
                "Reduced motion"
            else:
                "Language"

        def row_value(settings: Settings&, row: i64) -> cstr:
            if row == ROW_TEXT_SIZE:
                if settings.text_scale >= Limits::MAX_SCALE:
                    "< 150% >"
                elif settings.text_scale > Limits::MIN_SCALE:
                    "< 125% >"
                else:
                    "< 100% >"
            elif row == ROW_CONTRAST:
                "< On >" if settings.high_contrast else "< Off >"
            elif row == ROW_CAPTIONS:
                "< On >" if settings.captions else "< Off >"
            elif row == ROW_MOTION:
                "< On >" if settings.reduced_motion else "< Off >"
            else:
                language_name(settings.locale)

        # Each language named in itself, as players look for their own.
        def language_name(locale: i64) -> cstr:
            if locale == UiLocale::NB:
                "< Norsk >"
            elif locale == UiLocale::RU:
                "< Русский >"
            elif locale == UiLocale::AR:
                "< العربية >"
            elif locale == UiLocale::JA:
                "< 日本語 >"
            else:
                "< English >"

        def font_size(settings: Settings&, base: i32) -> i32:
            (base.i64() * settings.text_scale / 100).i32()

        def scaled(settings: Settings&, length: f32) -> f32:
            length * settings.text_scale.f32() / 100.0

        def header_color(settings: Settings&) -> RenderScene::Color:
            color(1.0, 1.0, 1.0, 1.0) if settings.high_contrast else color(0.78, 0.84, 0.9, 1.0)

        def text_color(settings: Settings&) -> RenderScene::Color:
            color(1.0, 1.0, 1.0, 1.0)

        def highlight_color(settings: Settings&) -> RenderScene::Color:
            color(1.0, 1.0, 0.0, 1.0) if settings.high_contrast else color(1.0, 0.85, 0.2, 1.0)

        def caption_color(settings: Settings&) -> RenderScene::Color:
            color(1.0, 1.0, 0.0, 1.0) if settings.high_contrast else color(0.9, 0.95, 1.0, 1.0)

        # An opaque backing behind the HUD in high contrast; hidden otherwise.
        def panel_color(settings: Settings&) -> RenderScene::Color:
            color(0.0, 0.0, 0.0, 0.88)

        def caption_text(event: u32) -> cstr:
            if event == CourseSounds::EVENT_JUMP:
                "[Sound: jump]"
            elif event == CourseSounds::EVENT_LAND:
                "[Sound: landing thud]"
            elif event == CourseSounds::EVENT_WIN:
                "[Sound: victory fanfare]"
            elif event == CourseSounds::EVENT_FALL:
                "[Sound: falling]"
            elif event == CourseSounds::EVENT_STEP:
                "[Sound: footstep]"
            else:
                "[Sound: chime]"

        def Captions() -> Captions:
            Captions{event: 0, until_nanos: 0}

        # Captions follow the game's sound events whether or not an audio
        # device is present; with captions off nothing is shown.
        def caption(captions: Captions, settings: Settings&, event: u32, now_nanos: u64) -> Captions:
            if settings.captions:
                Captions{event: event, until_nanos: now_nanos + Limits::CAPTION_NANOS}
            else:
                captions

        def caption_visible(captions: Captions&, settings: Settings&, now_nanos: u64) -> bool:
            settings.captions and captions.event != 0 and now_nanos < captions.until_nanos

        def encode(settings: Settings&) -> Save::Blob error[Save::SaveError]:
            values: mutable i64[Save::MAX_FIELDS] = zeroed
            values[0] <- Limits::VERSION
            values[1] <- settings.text_scale
            values[2] <- flag(settings.high_contrast)
            values[3] <- flag(settings.captions)
            values[4] <- settings.locale
            values[5] <- flag(settings.reduced_motion)
            try Save::save_write(values, Limits::FIELD_COUNT)

        # This version's exact shape (or version 1's, read as English, or
        # version 2's, read with full motion) with a listed scale, 0/1 flags
        # and a known locale.
        def decode(blob: Save::Blob&) -> LoadResult:
            version: i64 = Save::save_value_or(blob, 0, 0)
            count: usize = Limits::V1_FIELD_COUNT if version == 1 else (Limits::V2_FIELD_COUNT if version == 2 else Limits::FIELD_COUNT)
            readable: bool = catch Save::save_read(blob, count):
                value: value
                error failure: false
            return rejected_load(LoadStatus.Rejected) if not readable
            return rejected_load(LoadStatus.Rejected) if version < 1 or version > Limits::VERSION
            contrast: i64 = Save::save_value_or(blob, 2, -1)
            captions: i64 = Save::save_value_or(blob, 3, -1)
            motion: i64 = Save::save_value_or(blob, 5, -1) if version == Limits::VERSION else 0
            return rejected_load(LoadStatus.Rejected) if contrast < 0 or contrast > 1 or captions < 0 or captions > 1 or motion < 0 or motion > 1
            settings: Settings = Settings{text_scale: Save::save_value_or(blob, 1, 0),
                high_contrast: contrast == 1, captions: captions == 1, reduced_motion: motion == 1,
                locale: UiLocale::EN if version == 1 else Save::save_value_or(blob, 4, -1)}
            return rejected_load(LoadStatus.Rejected) if not valid(&settings)
            LoadResult{status: LoadStatus.Loaded, settings: settings}

        # UserData::initialize remains application-owned.
        def save(settings: Settings&) -> void error[Save::SaveError, UserData::UserDataError]:
            blob: Save::Blob = try encode(settings)
            try UserData::write_blob(Limits::KEY, &blob)

        def load() -> LoadResult:
            blob: mutable Save::Blob = Save::Blob(0)
            read_status: i32 = catch UserData::read_blob(Limits::KEY, &blob):
                ok: 0
                UserData::UserDataError.NotFound: 1
                error failure: 2
            if read_status == 1:
                rejected_load(LoadStatus.Missing)
            elif read_status == 2:
                rejected_load(LoadStatus.Unreadable)
            else:
                decode(&blob)
