# Course sound ownership: streamed music, a looped ambience voice and
# event-triggered effects. AudioEvents decides whether an event plays and
# into which slot; this module owns the native clips, voices and stream and
# releases them all on `stop`. Without an audio route every call is a no-op.
include "./sound_mix.elisa"
include "../../src/audio/events_logged.elisa"
include "../../src/runtime/decision_session_store.elisa"

module CourseSounds:
    public:
        const EVENT_JUMP: u32 = 1
        const EVENT_LAND: u32 = 2
        const EVENT_WIN: u32 = 3
        const EVENT_FALL: u32 = 4
        const EVENT_SAVE: u32 = 5
        const EVENT_STEP: u32 = 6
        # The guide's foot plants are bound to sound events by `anim` records.
        const EVENT_GUIDE_STEP: u32 = 7
        const GUIDE_SOUND_RANGE: f32 = 18.0
        # `track` results, as bits.
        const TRACKED_STEP: u32 = 1
        const TRACKED_LANDING: u32 = 2

        # `start` results. Inactive means the session has no audio route.
        const STARTED: i32 = 0
        const INACTIVE: i32 = 1
        const DEFINITION_FAILED: i32 = 2
        const CLIP_FAILED: i32 = 3
        const MUSIC_FAILED: i32 = 4
        const AMBIENCE_FAILED: i32 = 5

        # `start_injected` swaps one path for a missing file so the lifecycle
        # stress test reaches the real clip and stream failure paths.
        const INJECT_NONE: i32 = 0
        const INJECT_CLIP: i32 = 1
        const INJECT_MUSIC: i32 = 2
        const INJECT_EVENTS: i32 = 3

        # `fire` results: the AudioEvents outcome, or a failure.
        const PLAYED: i32 = 0
        const REPLACED: i32 = 1
        const DUPLICATE: i32 = 2
        const COOLING: i32 = 3
        const SILENT: i32 = 4
        const FIRE_FAILED: i32 = 5

        # Mix moods, authored as `mood` records in sounds/events.sfx: pause
        # ducks the music and the controls menu ducks it further. `mix`
        # ramps to each over its authored time on a millisecond clock that
        # keeps running while the game is paused. The ids are the records'.
        const MOOD_PLAY: i32 = 0
        const MOOD_PAUSED: i32 = 1
        const MOOD_MENU: i32 = 2
        # Music cues, authored as `music` records in sounds/events.sfx: the
        # course loop, and a victory loop the course crossfades to on a win.
        const MUSIC_COURSE: u64 = 0
        const MUSIC_VICTORY: u64 = 1
        # The streams' gain at full cue gain, before the Music bus.
        const MUSIC_VOLUME: f32 = 0.5
        # The ambience keeps a virtual clock: when an event voice steals its
        # native voice, `update` brings it back at the frame it would have
        # reached. RATE matches the course's 48 kHz audio device.
        const RATE: u64 = 48000
        const AMBIENCE_PRIORITY: u32 = 1
        # `reload_events` results, and how often `poll_reload` re-reads the asset.
        const RELOADED: i32 = 0
        const UNCHANGED: i32 = 1
        const REJECTED: i32 = 2
        const RELOAD_POLL_MS: u64 = 500

        affine struct Sounds:
            private:
                live: mutable bool
                jump_a: mutable AudioRuntime::ClipHandle
                jump_b: mutable AudioRuntime::ClipHandle
                land: mutable AudioRuntime::ClipHandle
                win: mutable AudioRuntime::ClipHandle
                fall: mutable AudioRuntime::ClipHandle
                save: mutable AudioRuntime::ClipHandle
                footstep: mutable AudioRuntime::ClipHandle
                wind: mutable AudioRuntime::ClipHandle
                ambience: mutable AudioRuntime::VoiceHandle
                ambience_sound: mutable usize
                ambience_frames: mutable u64
                sounds_virtual: mutable AudioVirtual::Pool
                music: mutable AudioRuntime::StreamHandle
                victory: mutable AudioRuntime::StreamHandle
                score: mutable AudioMusic::Transition
                score_ms: mutable u64
                voices: mutable AudioRuntime::VoiceHandles::Pool
                board: mutable AudioEvents::Board
                triggers: mutable SoundEventAssets::Triggers
                # The last tracked position, for the ground distance walked.
                last_x: mutable f32
                last_z: mutable f32
                tracked: mutable bool
                mix: mutable AudioMixer::Mix
                mood: mutable i32
                last_variant: mutable u32
                # Every started event's outcome, slot and variant (W09).
                decisions: mutable RuntimeDecisionLog::Log
                sealed_chunks: mutable i64
                asset_sum: mutable u64
                asset_checked_ms: mutable u64

        def Sounds() -> Sounds:
            Sounds{
                live: false,
                jump_a: AudioRuntime::empty_clip(),
                jump_b: AudioRuntime::empty_clip(),
                land: AudioRuntime::empty_clip(),
                win: AudioRuntime::empty_clip(),
                fall: AudioRuntime::empty_clip(),
                save: AudioRuntime::empty_clip(),
                footstep: AudioRuntime::empty_clip(),
                wind: AudioRuntime::empty_clip(),
                ambience: AudioRuntime::empty_voice(),
                ambience_sound: AudioVirtual::MAX_SOUNDS,
                ambience_frames: 0,
                sounds_virtual: AudioVirtual::Pool(),
                music: AudioRuntime::empty_stream(),
                victory: AudioRuntime::empty_stream(),
                score: AudioMusic::Transition(),
                score_ms: 0,
                voices: AudioRuntime::VoiceHandles::Pool(),
                board: AudioEvents::Board(),
                triggers: SoundEventAssets::Triggers(),
                last_x: 0.0,
                last_z: 0.0,
                tracked: false,
                mix: CourseSoundMix::settled_mix(),
                mood: MOOD_PLAY,
                last_variant: 0,
                decisions: RuntimeDecisionLog::recorder(0),
                sealed_chunks: 0,
                asset_sum: 0,
                asset_checked_ms: 0,
            }

        def live(sounds: Sounds&) -> bool:
            sounds.live

        # Paths are relative to the working directory: the project folder
        # when run from source, Contents/Resources inside the packaged app.
        def start(sounds: mutable Sounds&, session: RuntimeServices::Session&) -> i32:
            start_injected(sounds, session, INJECT_NONE)

        def start_injected(sounds: mutable Sounds&, session: RuntimeServices::Session&, inject: i32) -> i32:
            return INACTIVE if not RuntimeServices::audio_active(session)
            events_path: cstr = "sounds/missing.sfx" if inject == INJECT_EVENTS else "sounds/events.sfx"
            return DEFINITION_FAILED if not define_events(sounds, events_path)
            sounds.live <- true
            wind_path: cstr = "sounds/missing.wav" if inject == INJECT_CLIP else "sounds/ambience.wav"
            music_path: cstr = "sounds/missing.wav" if inject == INJECT_MUSIC else "sounds/music.wav"
            AudioMusic::reset(&sounds.score, MUSIC_COURSE)
            loaded: bool = catch load_clips(sounds, wind_path):
                ok: true
                error failure: false
            return CLIP_FAILED if not loaded
            sounds.music <- catch AudioRuntime::open_stream(music_path, true, AudioRuntime::Bus.Music, 0.5):
                value: value
                error failure: AudioRuntime::empty_stream()
            return MUSIC_FAILED if AudioRuntime::stream_is_empty(sounds.music)
            sounds.victory <- catch AudioRuntime::open_stream("sounds/music_win.wav", true, AudioRuntime::Bus.Music, 0.0):
                value: value
                error failure: AudioRuntime::empty_stream()
            return MUSIC_FAILED if AudioRuntime::stream_is_empty(sounds.victory)
            sounds.ambience_frames <- catch AudioRuntime::clip_frames(sounds.wind):
                value: value
                error failure: 0
            sounds.ambience_sound <- catch AudioVirtual::add(&sounds.sounds_virtual, AMBIENCE_PRIORITY, true, sounds.ambience_frames, now_ms()):
                value: value
                error failure: AudioVirtual::MAX_SOUNDS
            return AMBIENCE_FAILED if sounds.ambience_sound >= AudioVirtual::MAX_SOUNDS
            AMBIENCE_FAILED if not realize_ambience(sounds, now_ms()) else STARTED

        # Once per frame: a stolen ambience goes virtual and returns at its
        # clock's frame once the Effects budget has room. True while the
        # ambience has a native voice.
        def update(sounds: mutable Sounds&) -> bool:
            return false if not sounds.live
            audible: bool = catch AudioRuntime::voice_frame(sounds.ambience):
                value: true
                error failure: false
            return true if audible
            _ = catch AudioVirtual::virtualized(&sounds.sounds_virtual, sounds.ambience_sound):
                ok: true
                error failure: false
            realize_ambience(sounds, now_ms())

        def ambience_virtual(sounds: Sounds&) -> bool:
            not AudioVirtual::is_real(&sounds.sounds_virtual, sounds.ambience_sound)

        # How far, in frames around the loop, the native ambience is from
        # where its virtual clock says it should be.
        def ambience_drift(sounds: Sounds&) -> u64:
            return RATE if not sounds.live or sounds.ambience_frames == 0
            expected: u64 = AudioVirtual::position(&sounds.sounds_virtual, sounds.ambience_sound, now_ms(), RATE)
            frame: u64 = catch AudioRuntime::voice_frame(sounds.ambience):
                value: value
                error failure: expected + RATE
            length: u64 = sounds.ambience_frames
            ahead: u64 = (frame + length - expected % length) % length
            behind: u64 = length - ahead
            ahead if ahead < behind else behind

        # At most one sound per event per `tick`; the caller passes a counter
        # that only moves forward within one scene.
        def fire(sounds: mutable Sounds&, event: u32, tick: u64) -> i32:
            fire_scaled(sounds, event, tick, AudioTriggers::FULL_PERMILLE)

        # Once per frame after physics: walking on the ground sounds the
        # asset's footstep event and a fall sounds its impact event, louder
        # the further it dropped. Returns TRACKED_* bits for what was heard.
        def track(sounds: mutable Sounds&, grounded: bool, position: Geometry::Vec3, tick: u64) -> u32:
            return 0 if not sounds.live
            dx: f32 = position.x - sounds.last_x
            dz: f32 = position.z - sounds.last_z
            walked: f32 = ElisaMath::sqrtf(dx * dx + dz * dz) if sounds.tracked else 0.0
            sounds.last_x <- position.x
            sounds.last_z <- position.z
            sounds.tracked <- true
            stepped: bool = AudioTriggers::step(&sounds.triggers.footfalls, grounded, AudioTriggers::millimetres(walked))
            gain: u64 = AudioTriggers::land(&sounds.triggers.impacts, grounded, AudioTriggers::height_millimetres(position.y))
            step_heard: bool = stepped and heard_outcome(fire(sounds, sounds.triggers.footfalls.event, tick))
            landing_heard: bool = gain > 0 and heard_outcome(fire_scaled(sounds, sounds.triggers.impacts.event, tick, gain))
            (TRACKED_STEP if step_heard else 0) + (TRACKED_LANDING if landing_heard else 0)

        # `gain_permille` scales the event's volume; 1000 is full.
        def fire_scaled(sounds: mutable Sounds&, event: u32, tick: u64, gain_permille: u64) -> i32:
            fire_scaled_with_spatial(sounds, event, tick, gain_permille,
                1.0, 1.0, false)

        # The variant of the last event that started a voice.
        # Started events recorded through the decision log, across chunks.
        def decisions(sounds: Sounds&) -> i64:
            sounds.sealed_chunks * RuntimeDecisionLog::CAP + sounds.decisions.count

        # Replays the session saved on disk: sound-event choices come from
        # its chunks in order instead of the generator. False if none loads.
        def replay_saved(sounds: mutable Sounds&) -> bool:
            first: RuntimeDecisionLogStore::Read = RuntimeDecisionSessionStore::load_chunk(0)
            return false if first.stored != RuntimeDecisionLogStore::Stored.Ok
            sounds.decisions <- first.loaded.log
            sounds.sealed_chunks <- 0
            true

        # Tick of the first replayed choice that differed, or -1.
        def replay_diverged_at(sounds: Sounds&) -> i64:
            sounds.decisions.diverged_at

        def last_variant(sounds: Sounds&) -> u32:
            sounds.last_variant

        def mood_for(menu_open: bool, paused: bool) -> i32:
            if menu_open:
                MOOD_MENU
            elif paused:
                MOOD_PAUSED
            else:
                MOOD_PLAY

        # The authored gains for `mood`; full gain before the asset loads.
        def mood_snapshot(sounds: Sounds&, mood: i32) -> AudioMixer::Snapshot:
            value: AudioMoods::Mood = AudioMoods::get(&sounds.triggers.moods, CourseSoundMix::mood_slot(mood))
            AudioMixer::snapshot(CourseSoundMix::permille_gain(value.music_permille), CourseSoundMix::permille_gain(value.effects_permille), CourseSoundMix::permille_gain(value.ui_permille))

        # Reads sounds/events.sfx without starting audio, so the mix can be
        # checked on a session without an audio route.
        def define_assets(sounds: mutable Sounds&) -> bool:
            define_events(sounds, "sounds/events.sfx")

        # Hot reload: re-reads `path` and swaps in its events, moods, cues and
        # triggers. A file that is unreadable or invalid leaves everything as
        # it was. Events that survive keep their firing history and live
        # voices, so a reload cannot double-fire a tick; voices of removed
        # events are stopped. The same bytes reload nothing.
        def reload_events(sounds: mutable Sounds&, path: cstr) -> i32:
            source: mutable SoundEventAssets::Source = SoundEventAssets::Source()
            length: usize = catch AudioRuntime::read_asset(path, &source.bytes[0], SoundEventAssets::MAX_BYTES):
                value: value
                error failure: SoundEventAssets::MAX_BYTES + 1
            return REJECTED if length > SoundEventAssets::MAX_BYTES
            source.length <- length
            sum: u64 = asset_sum(&source)
            return UNCHANGED if sum == sounds.asset_sum
            sounds.asset_sum <- sum
            next: mutable AudioEvents::Board = AudioEvents::Board()
            next_triggers: mutable SoundEventAssets::Triggers = SoundEventAssets::Triggers()
            accepted: bool = catch SoundEventAssets::define_from(&next, &next_triggers, &source):
                ok: true
                error failure: false
            return REJECTED if not accepted
            AudioEvents::carry_over(&next, &sounds.board)
            for slot in 0..<AudioEvents::MAX_INSTANCES |sounds, next|:
                if AudioEvents::live(&sounds.board, slot) and not AudioEvents::live(&next, slot):
                    stop_slot(sounds, slot)
            sounds.board <- move next
            sounds.triggers <- move next_triggers
            sounds.tracked <- false
            RELOADED

        # Called every frame; checks the asset at most every RELOAD_POLL_MS.
        def poll_reload(sounds: mutable Sounds&, now_ms: u64) -> i32:
            return UNCHANGED if not sounds.live or now_ms < sounds.asset_checked_ms + RELOAD_POLL_MS
            sounds.asset_checked_ms <- now_ms
            reload_events(sounds, "sounds/events.sfx")

        def mood_ramp_ms(sounds: Sounds&, mood: i32) -> u64:
            AudioMoods::heard_ramp_ms(AudioMoods::get(&sounds.triggers.moods, CourseSoundMix::mood_slot(mood)))

        # Called every frame. A new mood starts a ramp from the gains heard
        # now; an unchanged mood keeps the running ramp. The heard gains go to
        # the buses when audio is live. Returns false if a bus rejected them.
        def mix(sounds: mutable Sounds&, mood: i32, now_ms: u64) -> bool:
            if mood != sounds.mood:
                goal: AudioMixer::Snapshot = mood_snapshot(sounds, mood)
                sounds.mix <- catch AudioMixer::transition(sounds.mix, goal, now_ms, mood_ramp_ms(sounds, mood)):
                    value: value
                    error failure: sounds.mix
                sounds.mood <- mood
            return true if not sounds.live
            heard: AudioMixer::Snapshot = AudioMixer::current(sounds.mix, now_ms)
            CourseSoundMix::apply_gains(heard)

        def heard(sounds: Sounds&, now_ms: u64) -> AudioMixer::Snapshot:
            AudioMixer::current(sounds.mix, now_ms)

        # Game pause holds effects and ambience in place; music and Ui keep playing.
        def set_paused(sounds: Sounds&, paused: bool) -> bool:
            return true if not sounds.live
            catch AudioRuntime::set_bus_paused(AudioRuntime::Bus.Effects, paused):
                ok: true
                error failure: false

        include "./sound_teardown.inc"

        def event_voices(sounds: Sounds&) -> usize:
            AudioEvents::live_count(&sounds.board)

        def music_status(sounds: Sounds&) -> AudioRuntime::StreamStatus:
            empty: AudioRuntime::StreamStatus = AudioRuntime::StreamStatus{state: AudioRuntime::StreamState.Finished, frames_played: 0, underrun_frames: 0}
            return empty if not sounds.live
            catch AudioRuntime::stream_status(sounds.music):
                value: value
                error failure: empty

        # The victory loop's stream status, for the second stream's underruns.
        def victory_status(sounds: Sounds&) -> AudioRuntime::StreamStatus:
            empty: AudioRuntime::StreamStatus = AudioRuntime::StreamStatus{state: AudioRuntime::StreamState.Finished, frames_played: 0, underrun_frames: 0}
            return empty if not sounds.live
            catch AudioRuntime::stream_status(sounds.victory):
                value: value
                error failure: empty

        # Restart rewinds the music to its first frame. Returns false if the
        # stream refused the seek.
        def rewind_music(sounds: Sounds&) -> bool:
            return true if not sounds.live
            catch AudioRuntime::seek_stream(sounds.music, 0):
                ok: true
                error failure: false

        def music_for(won: bool) -> u64:
            MUSIC_VICTORY if won else MUSIC_COURSE

        # Called every frame with the cue the game wants. A new cue fades the
        # old one out and the new one in over their authored times, from its
        # first frame; the fade runs on a millisecond clock that keeps going
        # while paused. Returns false if a stream rejected a seek or gain.
        def play_music(sounds: mutable Sounds&, cue: u64, now_ms: u64) -> bool:
            elapsed: u64 = now_ms - sounds.score_ms if now_ms > sounds.score_ms else 0
            sounds.score_ms <- now_ms
            AudioMusic::advance(&sounds.score, elapsed)
            started: bool = AudioMusic::request(&sounds.score, &sounds.triggers.cues, cue)
            return true if not sounds.live
            rewound: bool = not started or seek_start(cue_stream(sounds, cue))
            rewound and apply_music(sounds)

        # Restart jumps straight back to the course loop from its first frame.
        def restart_music(sounds: mutable Sounds&) -> bool:
            AudioMusic::reset(&sounds.score, MUSIC_COURSE)
            return true if not sounds.live
            rewind_music(sounds) and apply_music(sounds)

        def music_gain_permille(sounds: Sounds&, cue: u64) -> u64:
            AudioMusic::gain_permille(&sounds.score, cue)

        def music_stream(sounds: Sounds&) -> AudioRuntime::StreamHandle:
            sounds.music

        def music_position(sounds: Sounds&) -> u64:
            return 0 if not sounds.live
            catch AudioRuntime::stream_position(sounds.music):
                value: value
                error failure: 0

    private:
        def cue_stream(sounds: Sounds&, cue: u64) -> AudioRuntime::StreamHandle:
            sounds.victory if cue == MUSIC_VICTORY else sounds.music

        def seek_start(stream: AudioRuntime::StreamHandle) -> bool:
            catch AudioRuntime::seek_stream(stream, 0):
                ok: true
                error failure: false

        def apply_music(sounds: Sounds&) -> bool:
            catch set_music_gains(sounds):
                ok: true
                error failure: false

        def set_music_gains(sounds: Sounds&) -> void error[AudioRuntime::AudioError]:
            try AudioRuntime::set_stream_gain(sounds.music, cue_volume(sounds, MUSIC_COURSE))
            try AudioRuntime::set_stream_gain(sounds.victory, cue_volume(sounds, MUSIC_VICTORY))

        def cue_volume(sounds: Sounds&, cue: u64) -> f32:
            MUSIC_VOLUME * AudioMusic::gain_permille(&sounds.score, cue).f32() / 1000.0

        # The events are authored in `sounds/events.sfx`; a missing or
        # malformed file fails the start instead of falling back to code.
        def define_events(sounds: mutable Sounds&, path: cstr) -> bool:
            sounds.board <- AudioEvents::Board()
            sounds.triggers <- SoundEventAssets::Triggers()
            source: mutable SoundEventAssets::Source = SoundEventAssets::Source()
            length: usize = catch AudioRuntime::read_asset(path, &source.bytes[0], SoundEventAssets::MAX_BYTES):
                value: value
                error failure: SoundEventAssets::MAX_BYTES + 1
            return false if length > SoundEventAssets::MAX_BYTES
            source.length <- length
            sounds.asset_sum <- asset_sum(&source)
            catch SoundEventAssets::define_from(&sounds.board, &sounds.triggers, &source):
                ok: true
                error failure: false

        # A checksum that never overflows (0 is reserved for "nothing read").
        def asset_sum(source: SoundEventAssets::Source&) -> u64:
            for at in 0..<source.length |sum: u64 = 1| -> sum:
                sum <- (sum * 31 + source.bytes[at].u64()) % 1000000007

        def load_clips(sounds: mutable Sounds&, wind_path: cstr) -> void error[AudioRuntime::AudioError]:
            sounds.jump_a <- try AudioRuntime::decode_file("sounds/jump_a.wav")
            sounds.jump_b <- try AudioRuntime::decode_file("sounds/jump_b.wav")
            sounds.land <- try AudioRuntime::decode_file("sounds/land.wav")
            sounds.win <- try AudioRuntime::decode_file("sounds/win.wav")
            sounds.fall <- try AudioRuntime::decode_file("sounds/fall.wav")
            sounds.save <- try AudioRuntime::decode_file("sounds/save.wav")
            sounds.footstep <- try AudioRuntime::decode_file("sounds/footstep.wav")
            sounds.wind <- try AudioRuntime::decode_file(wind_path)

        def now_ms() -> u64:
            Application::uptime_nanos() / 1000000

        def realize_ambience(sounds: mutable Sounds&, now: u64) -> bool:
            voice: AudioRuntime::VoiceHandle = catch AudioRuntime::play(sounds.wind, true, AudioRuntime::Bus.Effects, 0.4, AMBIENCE_PRIORITY):
                value: value
                error failure: AudioRuntime::empty_voice()
            return false if AudioRuntime::voice_is_empty(voice)
            sounds.ambience <- voice
            frame: u64 = AudioVirtual::position(&sounds.sounds_virtual, sounds.ambience_sound, now, RATE)
            seeked: bool = catch AudioRuntime::seek_voice(voice, frame):
                ok: true
                error failure: false
            marked: bool = catch AudioVirtual::realized(&sounds.sounds_virtual, sounds.ambience_sound):
                ok: true
                error failure: false
            seeked and marked

        # A clip that never loaded (start failed part-way) needs no release.
        def release(clip: AudioRuntime::ClipHandle) -> bool:
            return true if AudioRuntime::clip_is_empty(clip)
            catch AudioRuntime::release_clip(clip):
                ok: true
                AudioRuntime::AudioError.InvalidHandle: true
                error failure: false

        def event_clip(sounds: Sounds&, event: u32, variant: u32) -> AudioRuntime::ClipHandle:
            if event == CourseSounds::EVENT_JUMP:
                sounds.jump_b if variant == 1 else sounds.jump_a
            elif event == CourseSounds::EVENT_LAND:
                sounds.land
            elif event == CourseSounds::EVENT_WIN:
                sounds.win
            elif event == CourseSounds::EVENT_FALL:
                sounds.fall
            elif event == CourseSounds::EVENT_STEP or event == CourseSounds::EVENT_GUIDE_STEP:
                sounds.footstep
            else:
                sounds.save

        # A one-shot voice may already have ended; its stale handle is fine.
        def heard_outcome(outcome: i32) -> bool:
            outcome == PLAYED or outcome == REPLACED

        def stop_slot(sounds: mutable Sounds&, slot: usize) -> bool:
            voice: AudioRuntime::VoiceHandle = catch AudioRuntime::VoiceHandles::get(&sounds.voices, slot):
                value: value
                error failure: AudioRuntime::empty_voice()
            stopped: mutable bool = true
            if not AudioRuntime::voice_is_empty(voice):
                stopped <- catch AudioRuntime::stop(voice):
                    ok: true
                    AudioRuntime::AudioError.InvalidHandle: true
                    error failure: false
            if stopped:
                AudioRuntime::VoiceHandles::clear(&sounds.voices, slot)
            stopped

        # A stolen or finished voice is already silent; other failures still
        # matter to the owner that is shutting the sound set down.
        def stop_voice(voice: AudioRuntime::VoiceHandle) -> bool:
            return true if AudioRuntime::voice_is_empty(voice)
            catch AudioRuntime::stop(voice):
                ok: true
                AudioRuntime::AudioError.InvalidHandle: true
                error failure: false

        def stop_stream(stream: AudioRuntime::StreamHandle) -> bool:
            return true if AudioRuntime::stream_is_empty(stream)
            catch AudioRuntime::stop_stream(stream):
                ok: true
                AudioRuntime::AudioError.InvalidHandle: true
                error failure: false

include "./sound_spatial.elisa"
