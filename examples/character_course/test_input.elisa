# Narrow test-only bridge for injecting SDL events through the live input path.
module CourseTestInput:
    public:
        enum Key:
            Right
            Left
            Escape
            Space
            Crouch
            Forward
            Pause
            Restart
            Backward

    private:
        const module NativeKey:
            RIGHT: i32 = 1
            LEFT: i32 = 2
            ESCAPE: i32 = 3
            SPACE: i32 = 4
            CROUCH: i32 = 5
            FORWARD: i32 = 6
            PAUSE: i32 = 7
            RESTART: i32 = 8
            BACKWARD: i32 = 9

        @callconv(c)
        extern elisa_application_v1_test_push_key(key: i32, down: i32) -> i32

        @callconv(c)
        extern elisa_application_v1_test_push_focus_lost() -> i32

        @callconv(c)
        extern elisa_application_v1_test_push_focus_gained() -> i32

        @callconv(c)
        extern elisa_application_v1_test_set_window_size(width: i32, height: i32) -> i32

        @callconv(c)
        extern elisa_application_v1_test_trace_cell_memory(warm_gpu: i64, warm_cpu: i64, gpu: i64, cpu: i64)

        def native_key(key: Key) -> i32:
            match key:
                Key.Right: NativeKey::RIGHT
                Key.Left: NativeKey::LEFT
                Key.Escape: NativeKey::ESCAPE
                Key.Space: NativeKey::SPACE
                Key.Crouch: NativeKey::CROUCH
                Key.Forward: NativeKey::FORWARD
                Key.Pause: NativeKey::PAUSE
                Key.Restart: NativeKey::RESTART
                Key.Backward: NativeKey::BACKWARD

    public:
        def push(key: Key, down: bool) -> bool:
            elisa_application_v1_test_push_key(native_key(key), 1 if down else 0) == 0

        def lose_focus() -> bool:
            elisa_application_v1_test_push_focus_lost() == 0

        def regain_focus() -> bool:
            elisa_application_v1_test_push_focus_gained() == 0

        def resize(width: i32, height: i32) -> bool:
            elisa_application_v1_test_set_window_size(width, height) == 0

        def window_matches(width: i32, height: i32) -> bool:
            frame: mutable Application::FrameInfo = zeroed
            Application::frame_info(&frame) and frame.logical_width == width and frame.logical_height == height and frame.pixel_width > 0 and frame.pixel_height > 0

        def trace_cell_memory(warm_gpu: i64, warm_cpu: i64, gpu: i64, cpu: i64) -> void:
            elisa_application_v1_test_trace_cell_memory(warm_gpu, warm_cpu, gpu, cpu)
