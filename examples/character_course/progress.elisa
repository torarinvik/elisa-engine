include "../../src/world/save_migrations.elisa"
include "./state.elisa"
# Durable character-course checkpoints. Fields are explicit codes, whole
# millimetres and counters rather than enum ordinals or native handles, and a
# load is validated completely before the game touches its live character.
module CourseProgress:
    private:
        const module Limits:
            KEY: cstr = "course-checkpoint"
            FIELD_COUNT: usize = 8
            LEGACY_FIELD_COUNT: usize = 6
            CHECK_MODULUS: i64 = 1000000007
            CHECK_FACTOR: i64 = 131
            MILLIMETRES: f64 = 1000.0
            MAX_ABS_X_MM: i64 = 16000
            MIN_Y_MM: i64 = -8000
            MAX_Y_MM: i64 = 16000
            MAX_ABS_Z_MM: i64 = 8000

        def to_millimetres(value: f32) -> i64:
            ElisaMath::round(value.f64() * Limits::MILLIMETRES).i64()

        def from_millimetres(value: i64) -> f32:
            (value.f64() / Limits::MILLIMETRES).f32()

        def mix(acc: i64, value: i64) -> i64:
            ((acc * Limits::CHECK_FACTOR + value) % Limits::CHECK_MODULUS + Limits::CHECK_MODULUS) % Limits::CHECK_MODULUS

        def within(value: i64, low: i64, high: i64) -> bool:
            value >= low and value <= high

    public:
        const SCHEMA: i64 = 2
        const PHASE_PLAYING: i64 = CourseState::PHASE_PLAYING
        const PHASE_PAUSED: i64 = CourseState::PHASE_PAUSED
        const PHASE_WON: i64 = CourseState::PHASE_WON
        const PHASE_FAILED: i64 = CourseState::PHASE_FAILED

        struct Checkpoint:
            phase: i64
            position: Geometry::Vec3
            crouched: bool
            attempts: i64

        enum LoadStatus:
            Loaded
            Missing
            Unreadable
            Rejected

        struct LoadResult:
            status: LoadStatus
            migrated: bool
            checkpoint: Checkpoint

        def checksum(phase: i64, x: i64, y: i64, z: i64, crouched: i64, attempts: i64) -> i64:
            first: i64 = mix(SCHEMA, phase)
            second: i64 = mix(mix(first, x), y)
            mix(mix(mix(second, z), crouched), attempts)

        def key() -> cstr:
            Limits::KEY

        # Writes the current schema (2): a schema marker, the six fields and a
        # checksum over them. Encodes without judging the values so tests can
        # persist records a live game could never produce.
        def encode(checkpoint: Checkpoint&) -> Save::Blob error[Save::SaveError]:
            values: mutable i64[Save::MAX_FIELDS] = zeroed
            values[0] <- SCHEMA
            values[1] <- checkpoint.phase
            values[2] <- to_millimetres(checkpoint.position.x)
            values[3] <- to_millimetres(checkpoint.position.y)
            values[4] <- to_millimetres(checkpoint.position.z)
            values[5] <- 1 if checkpoint.crouched else 0
            values[6] <- checkpoint.attempts
            values[7] <- checksum(values[1], values[2], values[3], values[4], values[5], values[6])
            try Save::save_write(values, Limits::FIELD_COUNT)

        # Schema 1 had no marker or checksum: six bare fields. Kept so tests
        # can persist what an older release wrote.
        def encode_legacy(checkpoint: Checkpoint&) -> Save::Blob error[Save::SaveError]:
            values: mutable i64[Save::MAX_FIELDS] = zeroed
            values[0] <- checkpoint.phase
            values[1] <- to_millimetres(checkpoint.position.x)
            values[2] <- to_millimetres(checkpoint.position.y)
            values[3] <- to_millimetres(checkpoint.position.z)
            values[4] <- 1 if checkpoint.crouched else 0
            values[5] <- checkpoint.attempts
            try Save::save_write(values, Limits::LEGACY_FIELD_COUNT)

        def rejected() -> LoadResult:
            LoadResult{status: LoadStatus.Rejected, migrated: false,
                checkpoint: Checkpoint{phase: PHASE_PLAYING,
                    position: Geometry::vec3_zero(), crouched: false, attempts: 0}}

        # The checkpoint's migration chain. Schema 2 kept the six payload
        # fields unchanged and added the marker and checksum around them, so
        # its step is an identity rescale; later schemas append steps here.
        def checkpoint_chain() -> SaveMigrations::Chain:
            chain: mutable SaveMigrations::Chain = SaveMigrations::Chain()
            _ = SaveMigrations::add(&chain, SaveMigrations::Op.Scale, 0, 1)
            chain

        # Accepts a schema-2 record whose checksum matches, or a schema-1
        # record that migrates on load (`migrated`). Either way the values
        # need a known phase, a position inside the course volume, a boolean
        # crouch flag and a bounded attempt counter.
        def decode(blob: Save::Blob&) -> LoadResult:
            current: bool = catch Save::save_read(blob, Limits::FIELD_COUNT):
                value: value
                error failure: false
            legacy: bool = catch Save::save_read(blob, Limits::LEGACY_FIELD_COUNT):
                value: value
                error failure: false
            return rejected() if not current and not legacy
            base: usize = 1 if current else 0
            return rejected() if current and Save::save_value_or(blob, 0, 0) != SCHEMA
            fields: mutable i64[8] = zeroed
            fields[0] <- Save::save_value_or(blob, base, 0)
            fields[1] <- Save::save_value_or(blob, base + 1, 0)
            fields[2] <- Save::save_value_or(blob, base + 2, 0)
            fields[3] <- Save::save_value_or(blob, base + 3, 0)
            fields[4] <- Save::save_value_or(blob, base + 4, -1)
            fields[5] <- Save::save_value_or(blob, base + 5, -1)
            stored: SaveMigrations::Values = SaveMigrations::Values{version: SCHEMA if current else 1, fields: fields, count: 6}
            chain: SaveMigrations::Chain = checkpoint_chain()
            upgraded: SaveMigrations::Result = SaveMigrations::migrate(&chain, stored)
            accepted: bool = upgraded.outcome == SaveMigrations::Outcome.Migrated or upgraded.outcome == SaveMigrations::Outcome.Current
            return rejected() if not accepted or upgraded.values.count != 6 or upgraded.values.version != SCHEMA
            phase: i64 = upgraded.values.fields[0]
            x: i64 = upgraded.values.fields[1]
            y: i64 = upgraded.values.fields[2]
            z: i64 = upgraded.values.fields[3]
            crouched: i64 = upgraded.values.fields[4]
            attempts: i64 = upgraded.values.fields[5]
            return rejected() if current and Save::save_value_or(blob, 7, -1) != checksum(phase, x, y, z, crouched, attempts)
            return rejected() if not within(phase, PHASE_PLAYING, PHASE_FAILED)
            return rejected() if not within(x, -Limits::MAX_ABS_X_MM, Limits::MAX_ABS_X_MM)
            return rejected() if not within(y, Limits::MIN_Y_MM, Limits::MAX_Y_MM)
            return rejected() if not within(z, -Limits::MAX_ABS_Z_MM, Limits::MAX_ABS_Z_MM)
            return rejected() if not within(crouched, 0, 1)
            return rejected() if not within(attempts, 1, CourseState::MAX_ATTEMPTS)
            LoadResult{status: LoadStatus.Loaded, migrated: not current, checkpoint: Checkpoint{
                phase: phase,
                position: Geometry::Vec3{x: from_millimetres(x),
                    y: from_millimetres(y), z: from_millimetres(z)},
                crouched: crouched == 1,
                attempts: attempts,
            }}

        # UserData::initialize remains application-owned.
        def save(checkpoint: Checkpoint&) -> void error[Save::SaveError, UserData::UserDataError]:
            blob: Save::Blob = try encode(checkpoint)
            try UserData::write_blob(Limits::KEY, &blob)

        def load() -> LoadResult:
            blob: mutable Save::Blob = Save::Blob(0)
            read_status: i32 = catch UserData::read_blob(Limits::KEY, &blob):
                ok: 0
                UserData::UserDataError.NotFound: 1
                error failure: 2
            missing: LoadResult = LoadResult{status: LoadStatus.Missing, migrated: false,
                checkpoint: Checkpoint{phase: PHASE_PLAYING,
                    position: Geometry::vec3_zero(), crouched: false, attempts: 0}}
            if read_status == 1:
                missing
            elif read_status == 2:
                LoadResult{status: LoadStatus.Unreadable, migrated: false, checkpoint: missing.checkpoint}
            else:
                decode(&blob)
