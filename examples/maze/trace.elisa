# Elisa-owned gameplay trace. Scripted input sequences are played through
# the real maze game, so collision, the locked door, hazards, and the win
# condition are exercised by engine rules. Hosts render the resulting
# state; they never re-derive movement.
#
# Two runs are published: the full win path, which test/maze.elisa pins as
# won in ten moves, and a short mid-game snapshot the scene fixture uses so
# every marker (key, door, hazards, goal) is still ahead of the player and
# therefore visible in a captured frame.
include "./game.elisa"

module MazeTrace:
    private:
        const module Script:
            STEPS: usize = 10
            FIXTURE_STEPS: usize = 3

    public:
        struct TraceResult:
            player_x: mutable i64
            player_y: mutable i64
            moves: mutable usize
            won: mutable bool
            steps: mutable usize

        # Five South down the open first column, then five East to the goal
        # via the key cell and the locked door. The column-1 route is the
        # one that avoids the hazard at (2,5); test/maze_game.elisa uses the
        # same path, and this module keeps the two in step.
        def maze_win_script() -> Maze::MazeMove[10]:
            [Maze::MazeMove.South, Maze::MazeMove.South, Maze::MazeMove.South, Maze::MazeMove.South, Maze::MazeMove.South, Maze::MazeMove.East, Maze::MazeMove.East, Maze::MazeMove.East, Maze::MazeMove.East, Maze::MazeMove.East]

        # The first moves of that route: three South, leaving the player at
        # (1,4) with every marker still ahead.
        def maze_fixture_script() -> Maze::MazeMove[10]:
            [Maze::MazeMove.South, Maze::MazeMove.South, Maze::MazeMove.South, Maze::MazeMove.Idle, Maze::MazeMove.Idle, Maze::MazeMove.Idle, Maze::MazeMove.Idle, Maze::MazeMove.Idle, Maze::MazeMove.Idle, Maze::MazeMove.Idle]

        # Three trips onto the hazard at (2,5): South four times down the open
        # first column, then East. Each hit costs a life and resets the player
        # to the start, so the same five moves repeat. The third hit drains the
        # last life and the game reports Lost.
        def maze_lose_script() -> Maze::MazeMove[15]:
            [
                Maze::MazeMove.South, Maze::MazeMove.South, Maze::MazeMove.South, Maze::MazeMove.South, Maze::MazeMove.East,
                Maze::MazeMove.South, Maze::MazeMove.South, Maze::MazeMove.South, Maze::MazeMove.South, Maze::MazeMove.East,
                Maze::MazeMove.South, Maze::MazeMove.South, Maze::MazeMove.South, Maze::MazeMove.South, Maze::MazeMove.East,
            ]

        def maze_play(script: Maze::MazeMove[10], steps: usize) -> TraceResult:
            game: mutable MazeGame::MazeGame = MazeGame::MazeGame()
            MazeGame::game_start(&game)
            # Value blocks thread mutable bindings only, so the read-only
            # script parameter is copied into a mutable local first.
            moves: mutable Maze::MazeMove[10] = script
            taken: usize =
                for index in 0..<steps |count: usize = 0, game, moves| -> count:
                    moved: bool = MazeGame::game_step(&game, moves[index])
                    count <- count + 1 if moved
            TraceResult{
                player_x: game.grid.player_x,
                player_y: game.grid.player_y,
                moves: game.grid.moves,
                won: MazeGame::game_won(&game),
                steps: taken,
            }

        def maze_play_script() -> TraceResult:
            maze_play(maze_win_script(), Script::STEPS)

        def maze_fixture_state() -> TraceResult:
            maze_play(maze_fixture_script(), Script::FIXTURE_STEPS)

        # Portable status code of the mid-game snapshot, so the scene fixture
        # can carry the game's state as data for the hosts to consume.
        # Cue count of the mid-game snapshot: start click plus one step cue per
        # move, the audio the game emitted for the hosts to consume.
        def maze_fixture_cue_count() -> usize:
            game: mutable MazeGame::MazeGame = MazeGame::MazeGame()
            MazeGame::game_start(&game)
            script: mutable Maze::MazeMove[10] = maze_fixture_script()
            processed: usize =
                for index in 0..<Script::FIXTURE_STEPS |count: usize = 0, game, script| -> count:
                    moved: bool = MazeGame::game_step(&game, script[index])
                    count <- count + 1 if moved
            game.cue_count

        def maze_fixture_status() -> i64:
            game: mutable MazeGame::MazeGame = MazeGame::MazeGame()
            MazeGame::game_start(&game)
            script: mutable Maze::MazeMove[10] = maze_fixture_script()
            processed: usize =
                for index in 0..<Script::FIXTURE_STEPS |count: usize = 0, game, script| -> count:
                    moved: bool = MazeGame::game_step(&game, script[index])
                    count <- count + 1 if moved
            MazeGame::game_status_code(game.status)
