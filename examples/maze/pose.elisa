# A two-bone leg in the maze plane. The joint positions come from the engine's
# IK solver, not from authored numbers: the foot hangs below the hip and the
# knee is solved by the law of cosines, so a host that consumes the pose is
# consuming gameplay math. Cell units, not metres, because the maze hosts draw
# on a cell-mapped plane.
include "../../src/animation/ik.elisa"
include "../../src/animation/skin.elisa"

using Pose

module MazePose:
    private:
        const module Tune:
            UPPER: f32 = 0.6
            LOWER: f32 = 0.6
            FOOT_DROP: f32 = 0.9
            TOLERANCE: f32 = 0.002

        def near(value: f32, expected: f32) -> bool:
            difference: f32 = value - expected
            adjusted: f32 = 0.0 - difference if difference < 0.0 else difference
            adjusted < Tune::TOLERANCE

    private:
        # Two independent root joints at (x0,y0) and (x1,y1); used as the bind
        # and current poses for skinning a small quad.
        def two_joint_pose(x0: f32, y0: f32, x1: f32, y1: f32) -> Pose::Pose:
            skeleton: mutable Pose::Skeleton = Pose::skeleton_new()
            _ = Pose::skeleton_add(&skeleton, -1, Geometry::Transform{position: Geometry::Vec3{x: x0, y: y0, z: 0.0}, rotation: Geometry::quat_identity(), scale: Geometry::vec3_one()})
            _ = Pose::skeleton_add(&skeleton, -1, Geometry::Transform{position: Geometry::Vec3{x: x1, y: y1, z: 0.0}, rotation: Geometry::quat_identity(), scale: Geometry::vec3_one()})
            evaluated: Pose::Pose = catch pose_evaluate(&skeleton):
                value: value
                error failure: Pose::Pose{models: zeroed, count: 0}
            evaluated

    public:
        struct LegPose:
            hip_x: f32
            hip_y: f32
            knee_x: f32
            knee_y: f32
            foot_x: f32
            foot_y: f32

        def pose_leg(hip_x: f32, hip_y: f32) -> LegPose:
            hip: Geometry::Vec3 = Geometry::Vec3{x: hip_x, y: hip_y, z: 0.0}
            foot: Geometry::Vec3 = Geometry::Vec3{x: hip_x, y: hip_y - Tune::FOOT_DROP, z: 0.0}
            bend: Geometry::Vec3 = Geometry::Vec3{x: 1.0, y: 0.0, z: 0.0}
            knee: Geometry::Vec3 = Ik::two_bone_knee(hip, foot, Tune::UPPER, Tune::LOWER, bend)
            LegPose{
                hip_x: hip.x,
                hip_y: hip.y,
                knee_x: knee.x,
                knee_y: knee.y,
                foot_x: foot.x,
                foot_y: foot.y,
            }

        def upper_length() -> f32:
            Tune::UPPER

        def lower_length() -> f32:
            Tune::LOWER

        struct QuadPose:
            x0: f32
            y0: f32
            x1: f32
            y1: f32
            x2: f32
            y2: f32
            x3: f32
            y3: f32

        # A small quad around the shin, skinned from the bind (straight) leg to
        # the solved (bent) leg. The host uploads the deformed positions; the
        # engine owns the skinning, so the host only moves vertices.
        def deform_quad(hip_x: f32, hip_y: f32) -> QuadPose:
            leg: LegPose = pose_leg(hip_x, hip_y)
            bind: Pose::Pose = two_joint_pose(hip_x, hip_y, hip_x, hip_y - 0.6)
            current: Pose::Pose = two_joint_pose(hip_x, hip_y, leg.knee_x, leg.knee_y)
            binding: mutable Skin::Binding = Skin::binding_new()
            _ = Skin::binding_add(&binding, 1, 1.0)
            rest0: Geometry::Vec3 = Geometry::Vec3{x: hip_x - 0.1, y: hip_y - 1.1, z: 0.0}
            rest1: Geometry::Vec3 = Geometry::Vec3{x: hip_x + 0.1, y: hip_y - 1.1, z: 0.0}
            rest2: Geometry::Vec3 = Geometry::Vec3{x: hip_x + 0.1, y: hip_y - 0.9, z: 0.0}
            rest3: Geometry::Vec3 = Geometry::Vec3{x: hip_x - 0.1, y: hip_y - 0.9, z: 0.0}
            skinned0: Geometry::Vec3 = Skin::skin_vertex(rest0, &binding, &current, &bind)
            skinned1: Geometry::Vec3 = Skin::skin_vertex(rest1, &binding, &current, &bind)
            skinned2: Geometry::Vec3 = Skin::skin_vertex(rest2, &binding, &current, &bind)
            skinned3: Geometry::Vec3 = Skin::skin_vertex(rest3, &binding, &current, &bind)
            QuadPose{
                x0: skinned0.x, y0: skinned0.y,
                x1: skinned1.x, y1: skinned1.y,
                x2: skinned2.x, y2: skinned2.y,
                x3: skinned3.x, y3: skinned3.y,
            }

        # The solved joints must form two segments of exactly the bone lengths.
        def leg_pose_valid(pose: LegPose&) -> bool:
            upper_dx: f32 = pose.knee_x - pose.hip_x
            upper_dy: f32 = pose.knee_y - pose.hip_y
            lower_dx: f32 = pose.foot_x - pose.knee_x
            lower_dy: f32 = pose.foot_y - pose.knee_y
            upper: f32 = Geometry::sqrt_f32(upper_dx * upper_dx + upper_dy * upper_dy)
            lower: f32 = Geometry::sqrt_f32(lower_dx * lower_dx + lower_dy * lower_dy)
            near(upper, Tune::UPPER) and near(lower, Tune::LOWER)
