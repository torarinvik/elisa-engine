# Finite hidden entry point used by the native gate. Keeping this separate
# from the ordinary app means gameplay has no test-only environment switches.
include "./native_client.elisa"

def main() -> i32 can[Global.Read, Global.Write]:
    can Global.Read, Global.Write:
        first: i32 = MazeNativeClient::run(true, true)
        return first if first != 0
        return MazeNativeClient::run(true, true)
