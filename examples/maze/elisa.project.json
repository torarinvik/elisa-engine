{
  "name": "elisa-maze",
  "main": "native_main.elisa",
  "output": "build/elisa-maze",
  "application": {
    "title": "Elisa Maze",
    "width": 960,
    "height": 720,
    "hidden": false
  },
  "asset_cooks": [
    {
      "importer": "images",
      "output": "assets/maze_textures.elpk",
      "textures": {
        "wallalbedo": "assets/maze_wall.png"
      }
    },
    {
      "importer": "gltf",
      "source": "assets/maze_tile.gltf",
      "asset_path": "assets/maze_tile.gltf",
      "output": "assets/maze_tile.elpk",
      "dependencies": [
        "assets/maze_textures.elpk"
      ]
    }
  ],
  "package": {
    "notices": [
      "third_party/notices/FAudio.txt",
      "third_party/notices/GameNetworkingSockets.txt",
      "third_party/notices/Lua.txt",
      "third_party/notices/MikkTSpace.txt",
      "third_party/notices/SDL3.txt",
      "third_party/notices/WickedEngine.txt",
      "third_party/notices/basisu.txt",
      "third_party/notices/cgltf.txt",
      "third_party/notices/harfbuzz.txt",
      "third_party/notices/meshoptimizer.txt",
      "third_party/notices/miniaudio.txt",
      "third_party/notices/ozz-animation.txt",
      "third_party/notices/recastnavigation.txt",
      "third_party/notices/sources.json",
      "third_party/notices/tracy.txt",
      "third_party/notices/ufbx.txt",
      "third_party/notices/xatlas.txt",
      "third_party/notices/zstd-gpl-alternative.txt",
      "third_party/notices/zstd.txt"
    ]
  }
}
