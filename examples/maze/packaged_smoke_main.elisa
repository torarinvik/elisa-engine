# Finite hidden entry point for the packaged-shader smoke (R13): one host
# lifetime per process, so a cold launch and a warm relaunch are separate
# processes and each reports its own startup hitches.
include "./native_client.elisa"

def main() -> i32 can[Global.Read, Global.Write]:
    can Global.Read, Global.Write:
        return MazeNativeClient::run(true, true)
