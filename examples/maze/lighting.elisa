# Gameplay-owned lighting for the maze sample. The runtime keeps the Wicked
# light handle private and updates it only when the player changes cells.
include "../../src/backend/lighting.elisa"
include "../../src/math/geometry.elisa"
include "../../src/runtime/render_scene.elisa"
include "./layout.elisa"

module MazeLighting:
    private:
        const module Tune:
            PLAYER_LIGHT_HEIGHT: f32 = 1.2
            PLAYER_LIGHT_INTENSITY: f32 = 5.0
            PLAYER_LIGHT_RANGE: f32 = 2.1
            SUN_COLOR_RED: f32 = 0.78
            SUN_COLOR_GREEN: f32 = 0.84
            SUN_COLOR_BLUE: f32 = 1.0
            AMBIENT_RED: f32 = 0.16
            AMBIENT_GREEN: f32 = 0.19
            AMBIENT_BLUE: f32 = 0.25

        def player_light(x: i64, y: i64) -> Lighting::Light:
            position: Geometry::Vec3 = MazeLayout::maze_cell_position(
                x, y, Tune::PLAYER_LIGHT_HEIGHT)
            Lighting::Light{
                kind: Lighting::LightKind.Point,
                color: Geometry::Vec3{x: 1.0, y: 0.72, z: 0.42},
                position: position,
                direction: Geometry::vec3_zero(),
                intensity: Tune::PLAYER_LIGHT_INTENSITY,
                range: Tune::PLAYER_LIGHT_RANGE,
                inner_cone: 0.0,
                outer_cone: 0.0,
                casts_shadow: false,
                shadow_resolution: 0,
                rectangle_width: 0.0,
                rectangle_height: 0.0,
                volumetrics_enabled: false,
                volumetric_boost: 0.0,
            }

    public:
        affine struct Runtime:
            private:
                light: mutable RenderScene::LightHandle
                active: mutable bool

        def Runtime() -> Runtime:
            Runtime{
                light: RenderScene::LightHandle{id: 0},
                active: false,
            }

        def start(runtime: mutable Runtime&, x: i64,
                y: i64) -> void error[RenderScene::RenderSceneError]:
            raise RenderScene::RenderSceneError.AlreadyInitialized if runtime.active
            try RenderScene::set_environment(Lighting::Environment{
                sun_color: Geometry::Vec3{x: Tune::SUN_COLOR_RED,
                    y: Tune::SUN_COLOR_GREEN, z: Tune::SUN_COLOR_BLUE},
                sun_direction: Geometry::Vec3{x: 0.25, y: -1.0, z: 0.35},
                ambient: Geometry::Vec3{x: Tune::AMBIENT_RED,
                    y: Tune::AMBIENT_GREEN, z: Tune::AMBIENT_BLUE},
                sky_exposure: 0.8,
                fog_color: Geometry::Vec3{x: 0.08, y: 0.11, z: 0.16},
                fog_start: 6.0,
                fog_density: 0.012,
                fog_enabled: true,
            })
            runtime.light <- try RenderScene::create_light(player_light(x, y))
            runtime.active <- true

        def follow_player(runtime: mutable Runtime&, x: i64,
                y: i64) -> void error[RenderScene::RenderSceneError]:
            raise RenderScene::RenderSceneError.NotInitialized if not runtime.active
            try RenderScene::update_light(runtime.light, player_light(x, y))

        def shutdown(runtime: mutable Runtime&) -> void error[RenderScene::RenderSceneError]:
            if runtime.active:
                try RenderScene::destroy_light(runtime.light)
                runtime.active <- false
