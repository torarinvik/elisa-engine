# C ABI for embedding the maze game in a host. The host reads device input and
# calls these exports, so live input drives Elisa gameplay instead of only a
# fixture. The archive bundles the Elisa runtime, so the host links one library.
#
# Everything is top-level: a module wrapper around a global plus these exports
# made -emit c-archive omit a nested-module function (see ADR-0012), so the
# export surface stays flat, which emits reliably.
include "./game.elisa"

using Maze
using MazeGame

global mutable embedded_game: MazeGame = MazeGame::MazeGame()
global mutable embedded_session_live: bool = false
global mutable embedded_session_generation: i64 = 0

def capi_start() -> i32:
    MazeGame::game_start(&embedded_game)
    MazeGame::game_status_code(embedded_game.status).i32()

# Direction codes mirror the portable move order the host maps to:
# 0 north, 1 south, 2 west, 3 east.
def capi_move_of(direction: i32) -> Maze::MazeMove:
    return Maze::MazeMove.North if direction == 0
    return Maze::MazeMove.South if direction == 1
    return Maze::MazeMove.West if direction == 2
    return Maze::MazeMove.East if direction == 3
    Maze::MazeMove.Idle

def capi_step(direction: i32) -> i32:
    moved: bool = MazeGame::game_step(&embedded_game, capi_move_of(direction))
    1 if moved else 0

def capi_player_x() -> i32:
    embedded_game.grid.player_x.i32()

def capi_player_y() -> i32:
    embedded_game.grid.player_y.i32()

def capi_status() -> i32:
    MazeGame::game_status_code(embedded_game.status).i32()

def capi_lives() -> i32:
    embedded_game.lives.i32()

# Query surface: an embedder can inspect the world it drives, so it does not
# need the static fixture to render the live game.
def capi_width() -> i32:
    Maze::maze_width().i32()

def capi_height() -> i32:
    Maze::maze_height().i32()

def capi_wall_count() -> i32:
    Maze::maze_wall_count().i32()

def capi_goal_x() -> i32:
    Maze::maze_goal_x().i32()

def capi_goal_y() -> i32:
    Maze::maze_goal_y().i32()

def capi_is_wall(x: i32, y: i32) -> i32:
    1 if Maze::is_wall(x.i64(), y.i64()) else 0

def capi_abi_version() -> i32:
    1

def capi_feature_bits() -> i64:
    # Input, world-query, status, and the generation-checked session are v1.
    31

def capi_session_valid(handle: i64) -> bool:
    embedded_session_live and handle > 0 and handle == embedded_session_generation

def capi_session_create() -> i64:
    return 0 if embedded_session_live or embedded_session_generation == 9223372036854775807
    embedded_session_generation <- embedded_session_generation + 1
    embedded_session_live <- true
    capi_start()
    embedded_session_generation

def capi_session_update(handle: i64, direction: i32) -> i32:
    return -1 if not capi_session_valid(handle)
    capi_step(direction)

def capi_session_query(handle: i64, query: i32) -> i64:
    return -1 if not capi_session_valid(handle)
    return embedded_game.grid.player_x.i64() if query == 0
    return embedded_game.grid.player_y.i64() if query == 1
    return embedded_game.lives.i64() if query == 2
    capi_status().i64() if query == 3 else -2

def capi_session_destroy(handle: i64) -> i32:
    return -1 if not capi_session_valid(handle)
    embedded_session_live <- false
    0

export fn maze_start() -> i32 = capi_start
export fn maze_step(direction: i32) -> i32 = capi_step
export fn maze_player_x() -> i32 = capi_player_x
export fn maze_player_y() -> i32 = capi_player_y
export fn maze_status() -> i32 = capi_status
export fn maze_lives() -> i32 = capi_lives
export fn maze_width() -> i32 = capi_width
export fn maze_height() -> i32 = capi_height
export fn maze_wall_count() -> i32 = capi_wall_count
export fn maze_goal_x() -> i32 = capi_goal_x
export fn maze_goal_y() -> i32 = capi_goal_y
export fn maze_is_wall(x: i32, y: i32) -> i32 = capi_is_wall
export fn maze_abi_version() -> i32 = capi_abi_version
export fn maze_feature_bits() -> i64 = capi_feature_bits
export fn maze_session_create() -> i64 = capi_session_create
export fn maze_session_update(handle: i64, direction: i32) -> i32 = capi_session_update
export fn maze_session_query(handle: i64, query: i32) -> i64 = capi_session_query
export fn maze_session_destroy(handle: i64) -> i32 = capi_session_destroy
