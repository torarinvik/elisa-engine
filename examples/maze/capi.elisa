# C ABI for embedding the maze game in a host. The host reads device input and
# calls these exports, so live input drives Elisa gameplay instead of only a
# fixture. The archive bundles the Elisa runtime, so the host links one library.
#
# Everything is top-level: a module wrapper around a global plus these exports
# made -emit c-archive omit a nested-module function (see ADR-0012), so the
# export surface stays flat, which emits reliably.
include "./game.elisa"
include "../../src/backend/capabilities.elisa"

using Maze
using MazeGame
using Capabilities

const module CapiPolicy:
    PROFILE_READY: i32 = 0
    PROFILE_UNCONFIGURED: i32 = -1
    PROFILE_UNAVAILABLE: i32 = -2
    PROFILE_INVALID: i32 = -3
    START_UNAVAILABLE: i32 = -2
    GAME_FEATURES: i64 = 31
    FEATURE_BACKEND_PROFILE: i64 = 32
    FEATURE_BACKEND_STATUS: i64 = 64

global mutable embedded_game: MazeGame = MazeGame::MazeGame()
global mutable embedded_session_live: bool = false
global mutable embedded_session_generation: i64 = 0
global mutable embedded_backend_profile: BackendProfile = headless_profile()
global mutable embedded_backend_profile_configured: bool = false

def capi_start() -> i32:
    return CapiPolicy::START_UNAVAILABLE if embedded_backend_profile_configured and capi_backend_status() != CapiPolicy::PROFILE_READY
    MazeGame::game_start(&embedded_game)
    MazeGame::game_status_code(embedded_game.status).i32()

# The native host passes the already validated, vendor-free ABI-v2 report.
# Unqueried resource capacities remain unknown in Elisa rather than fabricated.
def capi_backend_configure(capability_bits: i64, optional_bits: i64,
    max_viewports: i64, max_workers: i64, memory_budget_bytes: i64,
    memory_usage_bytes: i64, resource_format_bits: i64,
    graphics_workers: i64, streaming_workers: i64, service_version: i64) -> i32:
    return CapiPolicy::PROFILE_INVALID if embedded_session_live
    return CapiPolicy::PROFILE_INVALID if not backend_native_bits_valid(capability_bits, optional_bits, resource_format_bits)
    candidate: BackendProfile = backend_profile_from_native(capability_bits, optional_bits,
        max_viewports, max_workers, memory_budget_bytes, memory_usage_bytes,
        resource_format_bits, graphics_workers, streaming_workers, service_version)
    return CapiPolicy::PROFILE_INVALID if not backend_profile_valid(candidate)
    embedded_backend_profile <- candidate
    embedded_backend_profile_configured <- true
    CapiPolicy::PROFILE_READY

def capi_backend_status() -> i32:
    return CapiPolicy::PROFILE_UNCONFIGURED if not embedded_backend_profile_configured
    return CapiPolicy::PROFILE_INVALID if not backend_profile_valid(embedded_backend_profile)
    # Requirement negotiation uses the bounded eight-entry contract plus an
    # active count, so retain its fixed buffer shape and consume two entries.
    required: BackendFeature[8] = [BackendFeature.Rendering, BackendFeature.Input, BackendFeature.Input, BackendFeature.Input, BackendFeature.Input, BackendFeature.Input, BackendFeature.Input, BackendFeature.Input]
    no_fallbacks: BackendCapabilities = BackendCapabilities{
        input: false, rendering: false, physics: false, audio: false,
        native_window: false, async_upload: false, callbacks: false, asset_loading: false,
    }
    state: RequirementState = negotiate_requirements(embedded_backend_profile, required, 2, no_fallbacks, false)
    CapiPolicy::PROFILE_READY if state == RequirementState.Ready else CapiPolicy::PROFILE_UNAVAILABLE

# Returns 0 when ready, a stable BackendFeature code (1..8) for the first
# missing required service, or the existing negative profile status otherwise.
def capi_backend_missing_feature() -> i32:
    return CapiPolicy::PROFILE_UNCONFIGURED if not embedded_backend_profile_configured
    return CapiPolicy::PROFILE_INVALID if not backend_profile_valid(embedded_backend_profile)
    required: BackendFeature[8] = [BackendFeature.Rendering, BackendFeature.Input, BackendFeature.Input, BackendFeature.Input, BackendFeature.Input, BackendFeature.Input, BackendFeature.Input, BackendFeature.Input]
    no_fallbacks: BackendCapabilities = BackendCapabilities{
        input: false, rendering: false, physics: false, audio: false,
        native_window: false, async_upload: false, callbacks: false, asset_loading: false,
    }
    report: BackendRequirementReport = backend_requirement_report(embedded_backend_profile, required, 2, no_fallbacks, false)
    return backend_feature_code(report.first_missing) if report.state == RequirementState.Unavailable
    return 0 if report.state == RequirementState.Ready
    CapiPolicy::PROFILE_INVALID

# Direction codes mirror the portable move order the host maps to:
# 0 north, 1 south, 2 west, 3 east.
def capi_move_of(direction: i32) -> Maze::MazeMove:
    return Maze::MazeMove.North if direction == 0
    return Maze::MazeMove.South if direction == 1
    return Maze::MazeMove.West if direction == 2
    return Maze::MazeMove.East if direction == 3
    Maze::MazeMove.Idle

def capi_step(direction: i32) -> i32:
    moved: bool = MazeGame::game_step(&embedded_game, capi_move_of(direction))
    1 if moved else 0

def capi_player_x() -> i32:
    embedded_game.grid.player_x.i32()

def capi_player_y() -> i32:
    embedded_game.grid.player_y.i32()

def capi_status() -> i32:
    MazeGame::game_status_code(embedded_game.status).i32()

def capi_lives() -> i32:
    embedded_game.lives.i32()

# Query surface: an embedder can inspect the world it drives, so it does not
# need the static fixture to render the live game.
def capi_width() -> i32:
    Maze::maze_width().i32()

def capi_height() -> i32:
    Maze::maze_height().i32()

def capi_wall_count() -> i32:
    Maze::maze_wall_count().i32()

def capi_goal_x() -> i32:
    Maze::maze_goal_x().i32()

def capi_goal_y() -> i32:
    Maze::maze_goal_y().i32()

def capi_is_wall(x: i32, y: i32) -> i32:
    1 if Maze::is_wall(x.i64(), y.i64()) else 0

def capi_abi_version() -> i32:
    1

def capi_feature_bits() -> i64:
    CapiPolicy::GAME_FEATURES + CapiPolicy::FEATURE_BACKEND_PROFILE + CapiPolicy::FEATURE_BACKEND_STATUS

def capi_session_valid(handle: i64) -> bool:
    embedded_session_live and handle > 0 and handle == embedded_session_generation

def capi_session_create() -> i64:
    return 0 if embedded_session_live or embedded_session_generation == 9223372036854775807
    return 0 if embedded_backend_profile_configured and capi_backend_status() != CapiPolicy::PROFILE_READY
    embedded_session_generation <- embedded_session_generation + 1
    embedded_session_live <- true
    capi_start()
    embedded_session_generation

def capi_session_update(handle: i64, direction: i32) -> i32:
    return -1 if not capi_session_valid(handle)
    capi_step(direction)

def capi_session_query(handle: i64, query: i32) -> i64:
    return -1 if not capi_session_valid(handle)
    return embedded_game.grid.player_x.i64() if query == 0
    return embedded_game.grid.player_y.i64() if query == 1
    return embedded_game.lives.i64() if query == 2
    capi_status().i64() if query == 3 else -2

def capi_session_destroy(handle: i64) -> i32:
    return -1 if not capi_session_valid(handle)
    embedded_session_live <- false
    0

export fn maze_start() -> i32 = capi_start
export fn maze_step(direction: i32) -> i32 = capi_step
export fn maze_player_x() -> i32 = capi_player_x
export fn maze_player_y() -> i32 = capi_player_y
export fn maze_status() -> i32 = capi_status
export fn maze_lives() -> i32 = capi_lives
export fn maze_width() -> i32 = capi_width
export fn maze_height() -> i32 = capi_height
export fn maze_wall_count() -> i32 = capi_wall_count
export fn maze_goal_x() -> i32 = capi_goal_x
export fn maze_goal_y() -> i32 = capi_goal_y
export fn maze_is_wall(x: i32, y: i32) -> i32 = capi_is_wall
export fn maze_abi_version() -> i32 = capi_abi_version
export fn maze_feature_bits() -> i64 = capi_feature_bits
export fn maze_session_create() -> i64 = capi_session_create
export fn maze_session_update(handle: i64, direction: i32) -> i32 = capi_session_update
export fn maze_session_query(handle: i64, query: i32) -> i64 = capi_session_query
export fn maze_session_destroy(handle: i64) -> i32 = capi_session_destroy
export fn maze_backend_configure(capability_bits: i64, optional_bits: i64, max_viewports: i64, max_workers: i64, memory_budget_bytes: i64, memory_usage_bytes: i64, resource_format_bits: i64, graphics_workers: i64, streaming_workers: i64, service_version: i64) -> i32 = capi_backend_configure
export fn maze_backend_status() -> i32 = capi_backend_status
export fn maze_backend_missing_feature() -> i32 = capi_backend_missing_feature
