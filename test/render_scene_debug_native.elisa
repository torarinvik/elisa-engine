include "../src/runtime/render_scene_debug.elisa"
include "../src/runtime/application_capture.elisa"
include "../src/math/geometry.elisa"
include "../src/animation/overlay_lines.elisa"

module RenderSceneDebugNativeTests:
    private:
        def save_capture(environment_name: cstr) -> bool:
            path: cstr = Application::environment_value(environment_name)
            path != "" and Application::save_screenshot(path)

        # `lines` records around a ring of radius 1.5 at height 0.5, heat
        # rising around the ring so every colour stop shows.
        def ring(lines: i64) -> darray[f64]:
            points: mutable darray[f64] = []
            heat: mutable darray[f64] = []
            for i in 0..<(lines + 1).usize() |points, heat, lines|:
                a: f64 = 6.283185307179586 * i.i64().f64() / lines.f64()
                points.push(1.5 * ElisaMath::cos(a))
                points.push(0.5)
                points.push(1.5 * ElisaMath::sin(a))
                heat.push(i.i64().f64() / lines.f64())
            OverlayLines::trail(points, heat)

        # Batched line records: whole-chunk rejection, the batch capacity and
        # a flush that reports every batched line.
        def exercise_batches() -> i32:
            chunk: mutable RenderScene::DebugLineChunk = RenderScene::DebugLineChunk()
            full: darray[f64] = ring(16384)
            queued: usize = catch RenderScene::debug_line_records(full, true, chunk):
                value: value
                error failure: return 20
            return 21 if queued != 16384
            one: darray[f64] = ring(1)
            over: i32 = catch RenderScene::debug_line_records(one, true, chunk):
                value: 0
                RenderScene::RenderSceneError.Capacity: 1
                error failure: 2
            return 22 if over != 1
            flushed: usize = catch RenderScene::debug_flush():
                value: value
                error failure: return 23
            return 24 if flushed != 16384
            broken: mutable darray[f64] = ring(3)
            broken[14] <- 0.0 / 0.0
            rejected: i32 = catch RenderScene::debug_line_records(broken, false, chunk):
                value: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 25 if rejected != 1
            ragged: darray[f64] = [0.0, 0.0, 0.0]
            uneven: i32 = catch RenderScene::debug_line_records(ragged, false, chunk):
                value: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 26 if uneven != 1
            none: usize = catch RenderScene::debug_flush():
                value: value
                error failure: return 27
            return 28 if none != 0
            0

        # `count` labels "j" plus two digits on a ring; `bad` corrupts one.
        def label_anchors(count: i64) -> darray[f64]:
            out: mutable darray[f64] = []
            for i in 0..<count.usize() |out, count|:
                a: f64 = 6.283185307179586 * i.i64().f64() / count.f64()
                out.push(1.2 * ElisaMath::cos(a))
                out.push(1.0)
                out.push(1.2 * ElisaMath::sin(a))
                out.push(1.0)
                out.push(1.0)
                out.push(0.2)
                out.push(1.0)
            out

        def label_text(count: i64) -> darray[u8]:
            out: mutable darray[u8] = []
            for i in 0..<count.usize() |out|:
                out.push(106.u8())
                out.push((48 + (i.i64() / 10) % 10).u8())
                out.push((48 + i.i64() % 10).u8())
            out

        def label_lengths(count: i64) -> darray[i64]:
            out: mutable darray[i64] = []
            for i in 0..<count.usize() |out|:
                out.push(3)
            out

        def label_status(anchors: darray[f64]&, text: darray[u8]&, lengths: darray[i64]&,
            chunk: mutable RenderScene::DebugTextChunk&) -> i64:
            catch RenderScene::debug_label_records(anchors, text, lengths, true, chunk):
                value: value.i64()
                RenderScene::RenderSceneError.InvalidValue: -1
                RenderScene::RenderSceneError.Capacity: -2
                error failure: -3

        # Batched labels: 200 labels past the 128 command slots, whole-chunk
        # rejection of a zero byte, a bad length or a NaN, and capacity.
        def exercise_labels() -> i32:
            chunk: mutable RenderScene::DebugTextChunk = RenderScene::DebugTextChunk()
            anchors: darray[f64] = label_anchors(200)
            text: darray[u8] = label_text(200)
            lengths: darray[i64] = label_lengths(200)
            return 31 if label_status(anchors, text, lengths, chunk) != 200
            zero: mutable darray[u8] = label_text(200)
            zero[4] <- 0.u8()
            return 32 if label_status(anchors, zero, lengths, chunk) != -1
            long: mutable darray[i64] = label_lengths(200)
            long[0] <- 64
            return 33 if label_status(anchors, text, long, chunk) != -1
            empty: mutable darray[i64] = label_lengths(200)
            empty[0] <- 0
            return 34 if label_status(anchors, text, empty, chunk) != -1
            nan: mutable darray[f64] = label_anchors(200)
            nan[10] <- 0.0 / 0.0
            return 35 if label_status(nan, text, lengths, chunk) != -1
            short: darray[u8] = label_text(199)
            return 36 if label_status(anchors, short, lengths, chunk) != -1
            extra: darray[u8] = label_text(201)
            return 43 if label_status(anchors, extra, lengths, chunk) != -1
            few: darray[f64] = label_anchors(199)
            return 44 if label_status(few, text, lengths, chunk) != -1
            more: darray[f64] = label_anchors(201)
            return 45 if label_status(more, text, lengths, chunk) != -1
            many: darray[f64] = label_anchors(900)
            many_text: darray[u8] = label_text(900)
            many_lengths: darray[i64] = label_lengths(900)
            return 37 if label_status(many, many_text, many_lengths, chunk) != -2
            flushed: usize = catch RenderScene::debug_flush():
                value: value
                error failure: return 38
            return 39 if flushed != 968
            0

    public:
        def exercise() -> i32:
            cleared: i32 = catch RenderScene::debug_clear():
                ok: 0
                error failure: 1
            return 1 if cleared != 0
            return 14 if Application::pump() != Application::PumpStatus.Running
            return 15 if not save_capture("ELISA_DEBUG_DRAW_BASELINE_CAPTURE")
            box_status: i32 = catch RenderScene::debug_box(
                Geometry::Bounds3{
                    minimum: Geometry::Vec3{x: -1.0, y: -1.0, z: -1.0},
                    maximum: Geometry::Vec3{x: 1.0, y: 1.0, z: 1.0},
                }, RenderScene::Color{
                    red: 1.0, green: 1.0, blue: 1.0, alpha: 1.0,
                }, true):
                ok: 0
                error failure: 1
            return 2 if box_status != 0
            line_status: i32 = catch RenderScene::debug_line(
                Geometry::Vec3{x: -2.0, y: 0.0, z: 0.0},
                Geometry::Vec3{x: 2.0, y: 0.0, z: 0.0}, RenderScene::Color{
                    red: 1.0, green: 1.0, blue: 1.0, alpha: 1.0,
                }, false):
                ok: 0
                error failure: 1
            return 3 if line_status != 0
            text_status: i32 = catch RenderScene::debug_text(
                "debug", Geometry::Vec3{x: 0.0, y: 1.0, z: 0.0}, RenderScene::Color{
                    red: 1.0, green: 1.0, blue: 1.0, alpha: 1.0,
                }, true):
                ok: 0
                error failure: 1
            return 4 if text_status != 0
            invalid_box: i32 = catch RenderScene::debug_box(
                Geometry::Bounds3{
                    minimum: Geometry::Vec3{x: 1.0, y: 1.0, z: 1.0},
                    maximum: Geometry::Vec3{x: -1.0, y: 1.0, z: 1.0},
                }, RenderScene::Color{
                    red: 1.0, green: 1.0, blue: 1.0, alpha: 1.0,
                }, true):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 5 if invalid_box != 1
            invalid_position: i32 = catch RenderScene::debug_line(
                Geometry::Vec3{x: 1.0e30, y: 0.0, z: 0.0},
                Geometry::Vec3{x: 1.0, y: 0.0, z: 0.0}, RenderScene::Color{
                    red: 1.0, green: 1.0, blue: 1.0, alpha: 1.0,
                }, false):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 6 if invalid_position != 1
            flushed: usize = catch RenderScene::debug_flush():
                value: value
                error failure: return 7
            return 8 if flushed != 3
            batch_status: i32 = exercise_batches()
            return batch_status if batch_status != 0
            label_result: i32 = exercise_labels()
            return label_result if label_result != 0
            # Wicked rasterises glyphs lazily, so labels drawn for the first
            # time come out blank; one warm-up frame fills the glyph cache.
            warm: mutable RenderScene::DebugTextChunk = RenderScene::DebugTextChunk()
            warm_anchors: darray[f64] = label_anchors(24)
            warm_names: darray[u8] = label_text(24)
            warm_sizes: darray[i64] = label_lengths(24)
            return 41 if label_status(warm_anchors, warm_names, warm_sizes, warm) != 24
            return 42 if Application::pump() != Application::PumpStatus.Running
            auto_line_status: i32 = catch RenderScene::debug_line(
                Geometry::Vec3{x: -1.0, y: 0.0, z: 1.0},
                Geometry::Vec3{x: 1.0, y: 0.0, z: 1.0}, RenderScene::Color{
                    red: 1.0, green: 1.0, blue: 1.0, alpha: 1.0,
                }, true):
                ok: 0
                error failure: 1
            return 9 if auto_line_status != 0
            chunk: mutable RenderScene::DebugLineChunk = RenderScene::DebugLineChunk()
            overlay: darray[f64] = ring(2418)
            overlay_queued: usize = catch RenderScene::debug_line_records(overlay, false, chunk):
                value: value
                error failure: return 29
            return 30 if overlay_queued != 2418
            labels: mutable RenderScene::DebugTextChunk = RenderScene::DebugTextChunk()
            anchors: darray[f64] = label_anchors(24)
            names: darray[u8] = label_text(24)
            sizes: darray[i64] = label_lengths(24)
            return 40 if label_status(anchors, names, sizes, labels) != 24
            return 10 if Application::pump() != Application::PumpStatus.Running
            auto_flushed: usize = catch RenderScene::debug_flush():
                value: value
                error failure: return 11
            return 12 if auto_flushed != 0
            return 16 if not save_capture("ELISA_DEBUG_DRAW_VISIBLE_CAPTURE")
            cleared_after_flush: i32 = catch RenderScene::debug_clear():
                ok: 0
                error failure: 1
            return 13 if cleared_after_flush != 0
            0
