include "../src/nav/crowd.elisa"

def two(ax: i64, ay: i64, bx: i64, by: i64) -> NavCrowd::Crowd:
    NavCrowd::Crowd{xs: [ax, bx, 0, 0, 0, 0, 0, 0], ys: [ay, by, 0, 0, 0, 0, 0, 0], count: 2}

def main() -> i32:
    c: NavCrowd::Crowd = two(0, 0, 6, 0)
    a: NavCrowd::Push = NavCrowd::avoid(&c, 0, 10, 100)
    b: NavCrowd::Push = NavCrowd::avoid(&c, 1, 10, 100)
    # Overlap 4 on x: equal and opposite pushes.
    return 1 if a.dx != -4 or a.dy != 0 or b.dx != 4 or b.dy != 0
    # Diagonal neighbours push along the line between them.
    d: NavCrowd::Crowd = two(0, 0, 3, 4)
    da: NavCrowd::Push = NavCrowd::avoid(&d, 0, 10, 100)
    return 2 if da.dx != -3 or da.dy != -4
    # Beyond the radius nothing happens; a lone agent is not pushed by itself.
    far: NavCrowd::Crowd = two(0, 0, 10, 0)
    return 3 if NavCrowd::avoid(&far, 0, 10, 100).dx != 0
    return 4 if NavCrowd::pair_push(&c, 0, 0, 10).dx != 0
    # Coincident agents split by index and do not stay stacked.
    s: NavCrowd::Crowd = two(5, 5, 5, 5)
    return 5 if NavCrowd::avoid(&s, 0, 10, 100).dx != 10 or NavCrowd::avoid(&s, 1, 10, 100).dx != -10
    # The cap bounds the push per axis.
    return 6 if NavCrowd::avoid(&c, 0, 10, 2).dx != -2 or NavCrowd::avoid(&c, 0, 10, 0).dx != 0
    # Crowd pushes add; a middle agent between two is balanced.
    m: NavCrowd::Crowd = NavCrowd::Crowd{xs: [-6, 0, 6, 0, 0, 0, 0, 0], ys: [0, 0, 0, 0, 0, 0, 0, 0], count: 3}
    return 7 if NavCrowd::avoid(&m, 1, 10, 100).dx != 0
    return 8 if NavCrowd::avoid(&m, 0, 10, 100).dx != -4
    # Bad input is ignored.
    return 9 if NavCrowd::pair_push(&c, 0, 5, 10).dx != 0 or NavCrowd::pair_push(&c, 0, 1, 0).dx != 0
    return 10 if NavCrowd::pair_push(&c, -1, 1, 10).dx != 0
    return 0
