include "../src/backend/requirements.elisa"
using Capabilities
using BackendRequirements

def one_feature(feature: BackendFeature) -> BackendFeature[8]:
    [feature, feature, feature, feature, feature, feature, feature, feature]

def fallback_for(feature: BackendFeature) -> BackendCapabilities:
    match feature:
        BackendFeature.Input:
            BackendCapabilities{input: true, rendering: false, physics: false, audio: false, native_window: false, async_upload: false, callbacks: false, asset_loading: false}
        BackendFeature.Rendering:
            BackendCapabilities{input: false, rendering: true, physics: false, audio: false, native_window: false, async_upload: false, callbacks: false, asset_loading: false}
        BackendFeature.Physics:
            BackendCapabilities{input: false, rendering: false, physics: true, audio: false, native_window: false, async_upload: false, callbacks: false, asset_loading: false}
        BackendFeature.Audio:
            BackendCapabilities{input: false, rendering: false, physics: false, audio: true, native_window: false, async_upload: false, callbacks: false, asset_loading: false}
        BackendFeature.NativeWindow:
            BackendCapabilities{input: false, rendering: false, physics: false, audio: false, native_window: true, async_upload: false, callbacks: false, asset_loading: false}
        BackendFeature.AsyncUpload:
            BackendCapabilities{input: false, rendering: false, physics: false, audio: false, native_window: false, async_upload: true, callbacks: false, asset_loading: false}
        BackendFeature.Callbacks:
            BackendCapabilities{input: false, rendering: false, physics: false, audio: false, native_window: false, async_upload: false, callbacks: true, asset_loading: false}
        BackendFeature.AssetLoading:
            BackendCapabilities{input: false, rendering: false, physics: false, audio: false, native_window: false, async_upload: false, callbacks: false, asset_loading: true}

def fallback_matrix_valid() -> bool:
    no_services: BackendCapabilities = BackendCapabilities{
        input: false, rendering: false, physics: false, audio: false,
        native_window: false, async_upload: false, callbacks: false, asset_loading: false,
    }
    profile: BackendProfile = BackendProfile{
        kind: BackendKind.Native,
        capabilities: no_services,
        optional_capabilities: BackendOptionalCapabilities{ray_tracing: false, sparse_textures: false, mesh_shaders: false},
        limits: BackendLimits{
            max_entities: 1, max_texture_dimension: 1, max_upload_bytes: 1,
            workers: 1, memory_budget_bytes: 1, memory_usage_bytes: 0,
            max_viewports: 0, graphics_workers: 0, streaming_workers: 0,
        },
        texture_formats: BackendTextureFormats{rgba8: false, bc1: false, r16_float: false},
        service_version: 1,
    }
    features: BackendFeature[8] = [BackendFeature.Input, BackendFeature.Rendering, BackendFeature.Physics, BackendFeature.Audio, BackendFeature.NativeWindow, BackendFeature.AsyncUpload, BackendFeature.Callbacks, BackendFeature.AssetLoading]
    for index in 0..<8 |valid: bool = true| -> valid:
        feature: BackendFeature = features[index]
        required: BackendFeature[8] = one_feature(feature)
        fallback: BackendCapabilities = fallback_for(feature)
        report: mutable BackendRequirementReport = backend_requirement_report(profile, required, 1, fallback, true)
        break false if backend_feature_code(feature) != index.i32() + 1
        break false if report.state != RequirementState.Fallback or report.missing_count != 0 or report.fallback_count != 1
        break false if fallback_requirement_count(profile, required, 1, fallback) != 1
        break false if negotiate_requirements(profile, required, 1, fallback, false) != RequirementState.Unavailable
        break false if negotiate_requirements(profile, required, 1, no_services, true) != RequirementState.Unavailable
        report <- backend_requirement_report(profile, required, 1, no_services, true)
        break false if report.state != RequirementState.Unavailable or report.first_missing != feature or report.missing_count != 1 or report.fallback_count != 0

def aggregate_requirements_valid(profile: BackendProfile) -> bool:
    service_fallbacks: BackendCapabilities = BackendCapabilities{
        input: false, rendering: false, physics: false, audio: false,
        native_window: false, async_upload: false, callbacks: false, asset_loading: false,
    }
    optional_fallbacks: BackendOptionalCapabilities = BackendOptionalCapabilities{
        ray_tracing: false, sparse_textures: true, mesh_shaders: false,
    }
    requirements: mutable BackendStartupRequirements = BackendStartupRequirements{
        services: [BackendFeature.Input, BackendFeature.Rendering, BackendFeature.Input,
            BackendFeature.Input, BackendFeature.Input, BackendFeature.Input,
            BackendFeature.Input, BackendFeature.Input],
        service_count: 2,
        service_fallbacks: service_fallbacks,
        allow_service_fallbacks: false,
        optional_features: [BackendOptionalFeature.RayTracing, BackendOptionalFeature.SparseTextures,
            BackendOptionalFeature.RayTracing],
        optional_feature_count: 1,
        optional_fallbacks: optional_fallbacks,
        allow_optional_fallbacks: false,
        limits: [
            BackendLimitRequirement{limit: BackendLimit.Viewports, preferred: 16, minimum: 8},
            BackendLimitRequirement{limit: BackendLimit.Workers, preferred: 16, minimum: 4},
            BackendLimitRequirement{limit: BackendLimit.MemoryBytes, preferred: 536870912, minimum: 134217728},
            BackendLimitRequirement{limit: BackendLimit.Entities, preferred: 1, minimum: 1},
            BackendLimitRequirement{limit: BackendLimit.Viewports, preferred: 1, minimum: 1},
            BackendLimitRequirement{limit: BackendLimit.Viewports, preferred: 1, minimum: 1},
            BackendLimitRequirement{limit: BackendLimit.Viewports, preferred: 1, minimum: 1},
            BackendLimitRequirement{limit: BackendLimit.Viewports, preferred: 1, minimum: 1},
        ],
        limit_count: 3,
        textures: [
            BackendTextureRequirement{requested: BackendTextureFormat.Bc1, normal_map: false, has_alpha: true, allow_fallback: true},
            BackendTextureRequirement{requested: BackendTextureFormat.Rgba8, normal_map: false, has_alpha: false, allow_fallback: false},
            BackendTextureRequirement{requested: BackendTextureFormat.Rgba8, normal_map: false, has_alpha: false, allow_fallback: false},
            BackendTextureRequirement{requested: BackendTextureFormat.Rgba8, normal_map: false, has_alpha: false, allow_fallback: false},
            BackendTextureRequirement{requested: BackendTextureFormat.Rgba8, normal_map: false, has_alpha: false, allow_fallback: false},
            BackendTextureRequirement{requested: BackendTextureFormat.Rgba8, normal_map: false, has_alpha: false, allow_fallback: false},
            BackendTextureRequirement{requested: BackendTextureFormat.Rgba8, normal_map: false, has_alpha: false, allow_fallback: false},
            BackendTextureRequirement{requested: BackendTextureFormat.Rgba8, normal_map: false, has_alpha: false, allow_fallback: false},
        ],
        texture_count: 1,
    }
    report: mutable BackendRequirementsReport = backend_requirements_report(profile, requirements)
    return false if report.state != RequirementState.Fallback
    return false if report.services.state != RequirementState.Ready
    return false if report.optional_features.state != RequirementState.Ready
    return false if report.limits.state != RequirementState.Fallback or report.limits.fallback_count != 1
    return false if report.limits.granted[0] != 16 or report.limits.granted[1] != 12
    return false if report.textures.state != RequirementState.Fallback or report.textures.fallback_count != 1
    return false if report.textures.decisions[0].format != BackendTextureFormat.Rgba8

    requirements.optional_features[0] <- BackendOptionalFeature.SparseTextures
    requirements.allow_optional_fallbacks <- true
    report <- backend_requirements_report(profile, requirements)
    return false if report.state != RequirementState.Fallback
    return false if report.optional_features.state != RequirementState.Fallback or report.optional_features.fallback_count != 1
    return false if report.limits.state != RequirementState.Fallback
    requirements.optional_fallbacks <- BackendOptionalCapabilities{
        ray_tracing: false, sparse_textures: false, mesh_shaders: false,
    }
    report <- backend_requirements_report(profile, requirements)
    return false if report.state != RequirementState.Unavailable
    return false if report.optional_features.first_missing != BackendOptionalFeature.SparseTextures

    requirements.limits[3] <- BackendLimitRequirement{limit: BackendLimit.Entities, preferred: 1, minimum: 1}
    requirements.limit_count <- 4
    report <- backend_requirements_report(profile, requirements)
    return false if report.state != RequirementState.Unavailable
    return false if report.limits.first_missing != BackendLimit.Entities or report.limits.missing_count != 1

    requirements.limit_count <- MAX_BACKEND_LIMIT_REQUIREMENTS + 1
    report <- backend_requirements_report(profile, requirements)
    return false if report.state != RequirementState.Invalid or report.limits.state != RequirementState.Invalid

    requirements.limit_count <- 1
    requirements.limits[0] <- BackendLimitRequirement{limit: BackendLimit.Workers, preferred: 2, minimum: 3}
    report <- backend_requirements_report(profile, requirements)
    return false if report.state != RequirementState.Invalid
    true

def main() -> i32:
    return 41 if not fallback_matrix_valid()
    return 42 if not backend_native_bits_valid(255, 7, 7)
    return 43 if backend_native_bits_valid(256, 0, 0) or backend_native_bits_valid(0, 8, 0) or backend_native_bits_valid(0, 0, 8)
    live_native: BackendProfile = backend_profile_from_native(19, 5, 16, 12, 1073741824, 268435456, 3, 8, 4, 2)
    return 44 if not backend_profile_valid(live_native)
    return 54 if not aggregate_requirements_valid(live_native)
    return 45 if not backend_supports(live_native, BackendFeature.Input) or not backend_supports(live_native, BackendFeature.Rendering)
    return 46 if not backend_supports_optional(live_native, BackendOptionalFeature.RayTracing) or backend_supports_optional(live_native, BackendOptionalFeature.SparseTextures) or not backend_supports_optional(live_native, BackendOptionalFeature.MeshShaders)
    return 47 if not backend_limit_supports(live_native, BackendLimit.Viewports, 16) or not backend_limit_supports(live_native, BackendLimit.GraphicsWorkers, 8) or not backend_limit_supports(live_native, BackendLimit.StreamingWorkers, 4)
    return 48 if negotiate_limit(live_native, BackendLimit.Entities, 1, false) != RequirementState.Unavailable
    no_viewports: BackendProfile = backend_profile_from_native(3, 0, 0, 1, 1024, 0, 1, 1, 1, 2)
    return 49 if backend_profile_valid(no_viewports)
    no_renderer_optional: BackendProfile = BackendProfile{
        kind: BackendKind.Headless,
        capabilities: headless_profile().capabilities,
        optional_capabilities: BackendOptionalCapabilities{ray_tracing: true, sparse_textures: false, mesh_shaders: false},
        limits: headless_profile().limits,
        texture_formats: headless_profile().texture_formats,
        service_version: 1,
    }
    return 50 if backend_profile_valid(no_renderer_optional)
    headless: BackendProfile = headless_profile()
    return 1 if headless.kind != BackendKind.Headless or not backend_profile_valid(headless)
    return 2 if not backend_supports(headless, BackendFeature.Input)
    return 3 if backend_supports(headless, BackendFeature.Rendering)
    return 4 if not backend_limit_supports(headless, BackendLimit.Entities, 64)
    return 5 if backend_limit_supports(headless, BackendLimit.TextureDimension, 2)
    return 18 if negotiate_limit(headless, BackendLimit.Entities, 64, false) != RequirementState.Ready
    return 19 if negotiate_limit(headless, BackendLimit.TextureDimension, 2, false) != RequirementState.Unavailable
    return 20 if negotiate_limit(headless, BackendLimit.TextureDimension, 2, true) != RequirementState.Fallback
    return 21 if negotiate_limit(headless, BackendLimit.TextureDimension, 0, true) != RequirementState.Invalid
    return 25 if negotiate_limit(headless, BackendLimit.MemoryBytes, 58720256, false) != RequirementState.Ready
    return 26 if negotiate_limit(headless, BackendLimit.MemoryBytes, 58720257, true) != RequirementState.Fallback
    invalid_memory: BackendProfile = BackendProfile{
        kind: headless.kind,
        capabilities: headless.capabilities,
        optional_capabilities: headless.optional_capabilities,
        limits: BackendLimits{
            max_entities: headless.limits.max_entities,
            max_texture_dimension: headless.limits.max_texture_dimension,
            max_upload_bytes: headless.limits.max_upload_bytes,
            workers: headless.limits.workers,
            memory_budget_bytes: headless.limits.memory_budget_bytes,
            memory_usage_bytes: headless.limits.memory_budget_bytes + 1,
            max_viewports: headless.limits.max_viewports,
            graphics_workers: headless.limits.graphics_workers,
            streaming_workers: headless.limits.streaming_workers,
        },
        texture_formats: headless.texture_formats,
        service_version: headless.service_version,
    }
    return 27 if backend_profile_valid(invalid_memory)
    return 28 if negotiate_limit(invalid_memory, BackendLimit.MemoryBytes, 1, true) != RequirementState.Invalid

    required: BackendFeature[8] = [BackendFeature.Input, BackendFeature.Rendering, BackendFeature.Physics, BackendFeature.Audio, BackendFeature.NativeWindow, BackendFeature.AsyncUpload, BackendFeature.Callbacks, BackendFeature.AssetLoading]
    return 6 if not backend_requirements_met(headless, required, 1)
    return 7 if backend_requirements_met(headless, required, 2)
    return 8 if backend_requirements_met(headless, required, 9)

    native: BackendProfile = BackendProfile{
        kind: BackendKind.Native,
        capabilities: BackendCapabilities{
            input: true,
            rendering: true,
            physics: true,
            audio: false,
            native_window: true,
            async_upload: true,
            callbacks: true,
            asset_loading: true,
        },
        optional_capabilities: BackendOptionalCapabilities{ray_tracing: true, sparse_textures: false, mesh_shaders: true},
        limits: BackendLimits{
            max_entities: 4096,
            max_texture_dimension: 8192,
            max_upload_bytes: 16777216,
            workers: 4,
            memory_budget_bytes: 268435456,
            memory_usage_bytes: 67108864,
            max_viewports: 16,
            graphics_workers: 8,
            streaming_workers: 4,
        },
        texture_formats: BackendTextureFormats{rgba8: true, bc1: true, r16_float: true},
        service_version: 1,
    }
    return 9 if not backend_requirements_met(native, required, 3)
    return 10 if backend_requirements_met(native, required, 8)
    return 11 if not backend_limit_supports(native, BackendLimit.TextureDimension, 4096)
    return 12 if backend_limit_supports(native, BackendLimit.UploadBytes, 16777217)
    no_fallbacks: BackendCapabilities = BackendCapabilities{
        input: false, rendering: false, physics: false, audio: false,
        native_window: false, async_upload: false, callbacks: false, asset_loading: false,
    }
    silent_audio_fallback: BackendCapabilities = BackendCapabilities{
        input: false, rendering: false, physics: false, audio: true,
        native_window: false, async_upload: false, callbacks: false, asset_loading: false,
    }
    return 13 if negotiate_requirements(native, required, 8, no_fallbacks, false) != RequirementState.Unavailable
    return 14 if first_missing_requirement(native, required, 8) != BackendFeature.Audio
    return 15 if negotiate_requirements(native, required, 8, no_fallbacks, true) != RequirementState.Unavailable
    return 16 if negotiate_requirements(native, required, 8, silent_audio_fallback, true) != RequirementState.Fallback
    return 17 if fallback_requirement_count(native, required, 8, silent_audio_fallback) != 1
    return 39 if fallback_requirement_count(native, required, 8, no_fallbacks) != 0
    return 40 if negotiate_requirements(native, required, 9, silent_audio_fallback, true) != RequirementState.Invalid
    requirement_report: mutable BackendRequirementReport = backend_requirement_report(native, required, 8, silent_audio_fallback, true)
    return 51 if requirement_report.state != RequirementState.Fallback or requirement_report.missing_count != 0 or requirement_report.fallback_count != 1
    requirement_report <- backend_requirement_report(native, required, 8, no_fallbacks, true)
    return 52 if requirement_report.state != RequirementState.Unavailable or requirement_report.first_missing != BackendFeature.Audio or requirement_report.missing_count != 1 or requirement_report.fallback_count != 0
    requirement_report <- backend_requirement_report(native, required, 3, no_fallbacks, true)
    return 53 if requirement_report.state != RequirementState.Ready or requirement_report.missing_count != 0 or requirement_report.fallback_count != 0
    return 22 if negotiate_limit(native, BackendLimit.UploadBytes, 16777216, false) != RequirementState.Ready
    return 23 if negotiate_limit(native, BackendLimit.UploadBytes, 16777217, false) != RequirementState.Unavailable
    return 24 if negotiate_limit(native, BackendLimit.UploadBytes, 16777217, true) != RequirementState.Fallback
    decision: mutable TextureFormatDecision = negotiate_texture_format(native, BackendTextureFormat.Bc1, false, false, false)
    return 29 if decision.state != RequirementState.Ready or decision.format != BackendTextureFormat.Bc1
    decision <- negotiate_texture_format(native, BackendTextureFormat.Bc1, false, true, true)
    return 30 if decision.state != RequirementState.Fallback or decision.format != BackendTextureFormat.Rgba8
    decision <- negotiate_texture_format(native, BackendTextureFormat.Bc1, false, true, false)
    return 31 if decision.state != RequirementState.Unavailable or decision.format != BackendTextureFormat.Unsupported
    decision <- negotiate_texture_format(native, BackendTextureFormat.Bc1, true, false, true)
    return 32 if decision.state != RequirementState.Fallback or decision.format != BackendTextureFormat.Rgba8
    decision <- negotiate_texture_format(native, BackendTextureFormat.R16Float, true, false, true)
    return 33 if decision.state != RequirementState.Fallback or decision.format != BackendTextureFormat.Rgba8
    decision <- negotiate_texture_format(native, BackendTextureFormat.R16Float, false, false, false)
    return 34 if decision.state != RequirementState.Ready or decision.format != BackendTextureFormat.R16Float
    no_rgba: BackendProfile = BackendProfile{
        kind: native.kind,
        capabilities: native.capabilities,
        optional_capabilities: native.optional_capabilities,
        limits: native.limits,
        texture_formats: BackendTextureFormats{rgba8: false, bc1: true, r16_float: true},
        service_version: native.service_version,
    }
    decision <- negotiate_texture_format(no_rgba, BackendTextureFormat.Bc1, true, false, true)
    return 35 if decision.state != RequirementState.Unavailable or decision.format != BackendTextureFormat.Unsupported
    decision <- negotiate_texture_format(native, BackendTextureFormat.Unsupported, false, false, true)
    return 36 if decision.state != RequirementState.Invalid
    decision <- negotiate_texture_format(native, BackendTextureFormat.Rgba8, false, false, false)
    return 37 if decision.state != RequirementState.Ready or decision.format != BackendTextureFormat.Rgba8
    invalid_formats: BackendProfile = BackendProfile{
        kind: headless.kind,
        capabilities: headless.capabilities,
        optional_capabilities: headless.optional_capabilities,
        limits: headless.limits,
        texture_formats: BackendTextureFormats{rgba8: true, bc1: false, r16_float: false},
        service_version: headless.service_version,
    }
    return 38 if backend_profile_valid(invalid_formats)
    0
