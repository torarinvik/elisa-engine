include "../src/world/commands.elisa"

using WorldHierarchy

def main() -> i32:
    buffer: mutable WorldCommands::Buffer = WorldCommands::Buffer()
    return 1 if not WorldCommands::spawn(&buffer, 1)
    return 2 if not WorldCommands::reparent(&buffer, 2, 1)
    return 3 if WorldCommands::command_count(&buffer) != 2 or not WorldCommands::batch_valid(&buffer)
    return 4 if not WorldCommands::commit(&buffer) or WorldCommands::command_count(&buffer) != 0
    return 5 if not WorldCommands::spawn(&buffer, 3) or not WorldCommands::despawn(&buffer, 3)
    return 6 if WorldCommands::batch_valid(&buffer)
    return 8 if WorldCommands::commit(&buffer)
    return 7 if WorldCommands::command_count(&buffer) != 2
    return 9 if WorldCommands::spawn_count(&buffer) != 1
    return 10 if WorldCommands::commit_with_capacity(&buffer, 0)
    return 11 if WorldCommands::command_count(&buffer) != 2
    retry: mutable WorldCommands::Buffer = WorldCommands::Buffer()
    return 12 if not WorldCommands::spawn(&retry, 4)
    return 13 if WorldCommands::commit_with_capacity(&retry, 0)
    return 14 if WorldCommands::command_count(&retry) != 1
    return 15 if not WorldCommands::commit_with_capacity(&retry, 1)
    return 16 if WorldCommands::command_count(&retry) != 0

    hierarchy: mutable WorldHierarchy::Hierarchy = WorldHierarchy::Hierarchy()
    return 17 if not WorldHierarchy::hierarchy_spawn(&hierarchy, 1, Geometry::transform_identity())
    return 18 if not WorldHierarchy::hierarchy_spawn(&hierarchy, 2, Geometry::transform_translate(Geometry::transform_identity(), Geometry::Vec3{x: 2.0, y: 0.0, z: 0.0}))
    WorldHierarchy::hierarchy_update(&hierarchy)
    structural: mutable WorldCommands::Buffer = WorldCommands::Buffer()
    return 19 if not WorldCommands::spawn(&structural, 3)
    return 20 if not WorldCommands::commit_hierarchy(&structural, &hierarchy)
    return 21 if WorldCommands::command_count(&structural) != 0 or WorldHierarchy::hierarchy_count(&hierarchy) != 3
    return 22 if not WorldHierarchy::hierarchy_set_local(&hierarchy, 3, Geometry::transform_translate(Geometry::transform_identity(), Geometry::Vec3{x: 2.0, y: 0.0, z: 0.0}), false)
    WorldHierarchy::hierarchy_update(&hierarchy)
    reparent: mutable WorldCommands::Buffer = WorldCommands::Buffer()
    return 23 if not WorldCommands::reparent(&reparent, 3, 1)
    return 24 if not WorldCommands::commit_hierarchy(&reparent, &hierarchy)
    WorldHierarchy::hierarchy_update(&hierarchy)
    return 25 if WorldHierarchy::hierarchy_world(&hierarchy, 3).position.x != 2.0
    cycle: mutable WorldCommands::Buffer = WorldCommands::Buffer()
    return 26 if not WorldCommands::reparent(&cycle, 1, 3)
    return 27 if WorldCommands::commit_hierarchy(&cycle, &hierarchy)
    return 28 if WorldCommands::command_count(&cycle) != 1
    invalid: mutable WorldCommands::Buffer = WorldCommands::Buffer()
    return 29 if not WorldCommands::reparent(&invalid, 2, 99)
    before_invalid: Geometry::Transform = WorldHierarchy::hierarchy_world(&hierarchy, 2)
    return 30 if WorldCommands::commit_hierarchy(&invalid, &hierarchy)
    return 31 if WorldCommands::command_count(&invalid) != 1
    WorldHierarchy::hierarchy_update(&hierarchy)
    after_invalid: Geometry::Transform = WorldHierarchy::hierarchy_world(&hierarchy, 2)
    return 32 if after_invalid.position.x != before_invalid.position.x
    duplicate: mutable WorldCommands::Buffer = WorldCommands::Buffer()
    return 33 if not WorldCommands::spawn(&duplicate, 1)
    return 34 if WorldCommands::commit_hierarchy(&duplicate, &hierarchy)
    return 35 if WorldCommands::command_count(&duplicate) != 1 or WorldHierarchy::hierarchy_count(&hierarchy) != 3
    remove: mutable WorldCommands::Buffer = WorldCommands::Buffer()
    return 36 if not WorldCommands::despawn(&remove, 3)
    return 37 if not WorldCommands::commit_hierarchy(&remove, &hierarchy)
    return 38 if WorldHierarchy::hierarchy_count(&hierarchy) != 2
    0
