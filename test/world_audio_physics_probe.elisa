# End-to-end WorldAudio occlusion probe. A single session owns Jolt and the
# silent audio route while a static body is inserted and removed across frames.
include "../src/runtime/world_audio.elisa"
include "../src/vendor/elisa_math.elisa"

module WorldAudioPhysicsProbe:
    private:
        const module Tune:
            OCCLUDER_LAYER: u32 = 31
            OCCLUDER_MASK: u32 = 2147483648
            OCCLUDER_HALF_EXTENT: f32 = 0.2
            OCCLUSION_STRENGTH: f32 = 0.65
            FIXED_STEP_SECONDS: f32 = 1.0 / 60.0
            SOURCE_DISTANCE: f32 = 3.0
            OCCLUDER_DISTANCE: f32 = 1.5
            EPSILON: f32 = 0.01

        def pose_at(position: Geometry::Vec3) -> Geometry::Transform:
            Geometry::Transform{
                position: position,
                rotation: Geometry::quat_identity(),
                scale: Geometry::Vec3{x: 1.0, y: 1.0, z: 1.0},
            }

        def settings() -> WorldAudio::EmitterSettings:
            WorldAudio::EmitterSettings{
                local_forward: Geometry::Vec3{x: 0.0, y: 0.0, z: -1.0},
                minimum_distance: 1.0,
                maximum_distance: 10.0,
                inner_cone_cos: -1.0,
                outer_cone_cos: -1.0,
                outer_cone_gain: 1.0,
            }

        def near(left: f32, right: f32) -> bool:
            ElisaMath::fabsf(left - right) <= Tune::EPSILON

        def advance(session: mutable RuntimeServices::Session&) -> bool:
            catch RuntimeServices::physics_fixed_step(session, Tune::FIXED_STEP_SECONDS):
                value: value > 0
                error failure: false

        def update_matches(session: RuntimeServices::Session&, world: World::World&,
            emitters: mutable WorldAudio::Emitters&, entity: World::EntityRef,
            expected: f32) -> bool:
            report: WorldAudio::UpdateReport = catch WorldAudio::update_with_physics(
                session, world, emitters, Tune::FIXED_STEP_SECONDS,
                Tune::OCCLUDER_MASK, Tune::OCCLUSION_STRENGTH):
                value: value
                error failure: return false
            return false if report.updated != 1
            source: SpatialAudio::Source = catch WorldAudio::emitter_source(emitters, entity):
                value: value
                error failure: return false
            near(source.occlusion, expected)

    public:
        def run(session: mutable RuntimeServices::Session&) -> i32:
            world: mutable World::World = catch World::World():
                value: value
                error failure: return 1
            listener: World::EntityRef = catch World::world_spawn(&world, World::Actor.Player):
                value: value
                error failure: return 2
            source_entity: World::EntityRef = catch World::world_spawn(&world, World::StaticObject.Structure):
                value: value
                error failure: return 3
            positioned_listener: bool = catch World::world_set_transform(&world, listener,
                pose_at(Geometry::vec3_zero())):
                ok: true
                error failure: false
            positioned_source: bool = catch World::world_set_transform(&world, source_entity,
                pose_at(Geometry::Vec3{x: 0.0, y: 0.0, z: -Tune::SOURCE_DISTANCE})):
                ok: true
                error failure: false
            return 4 if not positioned_listener or not positioned_source

            clip: AudioRuntime::ClipHandle = catch RuntimeServices::audio_decode_file(
                session, "test/fixtures/audio-smoke.wav"):
                value: value
                error failure: return 5
            voice: AudioRuntime::VoiceHandle = catch RuntimeServices::audio_play(
                session, clip, true, AudioRuntime::Bus.Effects, 1.0, 1):
                value: value
                error failure: return 6
            emitters: mutable WorldAudio::Emitters = WorldAudio::Emitters()
            listening: bool = catch WorldAudio::listen_from(world, &emitters, listener):
                ok: true
                error failure: false
            return 7 if not listening
            attached: bool = catch WorldAudio::attach(session, world, &emitters,
                source_entity, voice, settings()):
                ok: true
                error failure: false
            return 8 if not attached

            obstacle: PhysicsRuntime::BodyHandle = catch RuntimeServices::physics_body_create(
                session, PhysicsRuntime::BodyDesc{
                    kind: PhysicsRuntime::BodyKind.Static,
                    shape: PhysicsRuntime::BodyShape.Box,
                    position: Geometry::Vec3{x: 0.0, y: 0.0, z: -Tune::OCCLUDER_DISTANCE},
                    rotation: Geometry::quat_identity(),
                    dimensions: Geometry::Vec3{x: Tune::OCCLUDER_HALF_EXTENT,
                        y: Tune::OCCLUDER_HALF_EXTENT, z: Tune::OCCLUDER_HALF_EXTENT},
                    mass: 0.0,
                    sensor: false,
                    collision_layer: Tune::OCCLUDER_LAYER,
                    center_of_mass_offset: Geometry::vec3_zero(),
                }):
                value: value
                error failure: return 9
            return 10 if not advance(session)
            return 11 if not update_matches(session, world, emitters, source_entity,
                Tune::OCCLUSION_STRENGTH)

            destroyed: bool = catch RuntimeServices::physics_body_destroy(session, obstacle):
                ok: true
                error failure: false
            return 12 if not destroyed or not advance(session)
            return 13 if not update_matches(session, world, emitters, source_entity, 0.0)
            detached: bool = catch WorldAudio::detach(session, &emitters, source_entity):
                ok: true
                error failure: false
            return 14 if not detached
            0
