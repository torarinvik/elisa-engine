# Verifies pose sync, kinematic targets, and stale-error preservation.
module WorldPhysicsPoseProbe:
    private:
        const module Tune:
            START_HEIGHT: f32 = 8.0
            BODY_HALF_EXTENT: f32 = 0.5
            ROTATION_COMPONENT: f32 = 0.70710677
            ROTATION_DOT_MINIMUM: f32 = 0.999
            KINEMATIC_START_X: f32 = 6.0
            KINEMATIC_START_Y: f32 = 9.0
            KINEMATIC_TARGET_X: f32 = 4.0
            KINEMATIC_TARGET_Y: f32 = 6.0
            HIERARCHY_KINEMATIC_TARGET_X: f32 = 8.0
            HIERARCHY_KINEMATIC_TARGET_Y: f32 = 7.0
            KINEMATIC_TARGET_TOLERANCE: f32 = 0.01
            INTERPOLATION_ALPHA: f32 = 0.5
            VISUAL_ASSET_HIGH: u64 = 7
            VISUAL_MESH_LOW: u64 = 1
            VISUAL_MATERIAL_LOW: u64 = 2
            RENDER_ID: i64 = 301
            UNIT_BOUNDS: f32 = 1.0

        def probe_visual() -> Assets::VisualAsset:
            Assets::VisualAsset{
                mesh: Assets::AssetId{high: Tune::VISUAL_ASSET_HIGH,
                    low: Tune::VISUAL_MESH_LOW},
                material: Assets::AssetId{high: Tune::VISUAL_ASSET_HIGH,
                    low: Tune::VISUAL_MATERIAL_LOW},
                local_bounds: Geometry::Bounds3{
                    minimum: Geometry::Vec3{x: -Tune::UNIT_BOUNDS,
                        y: -Tune::UNIT_BOUNDS, z: -Tune::UNIT_BOUNDS},
                    maximum: Geometry::Vec3{x: Tune::UNIT_BOUNDS,
                        y: Tune::UNIT_BOUNDS, z: Tune::UNIT_BOUNDS},
                },
            }

        def authored_pose() -> Geometry::Transform:
            Geometry::Transform{
                position: Geometry::Vec3{x: 0.0, y: Tune::START_HEIGHT, z: 0.0},
                rotation: Geometry::Quat{
                    x: 0.0, y: 0.0,
                    z: Tune::ROTATION_COMPONENT,
                    w: Tune::ROTATION_COMPONENT},
                scale: Geometry::Vec3{x: 1.5, y: 1.0, z: 0.75},
            }

        def rotations_match(left: Geometry::Quat, right: Geometry::Quat) -> bool:
            dot: f32 = left.x * right.x + left.y * right.y + left.z * right.z + left.w * right.w
            ElisaMath::fabsf(dot) >= Tune::ROTATION_DOT_MINIMUM

    public:
        def run(session: mutable RuntimeServices::Session&,
            config: Application::Config,
            requirements: BackendRequirements::BackendStartupRequirements&,
            report: mutable BackendRequirements::BackendRequirementsReport&) -> i32:
            world: mutable World::World = catch World::World():
                value: value
                error failure: return 1
            entity: World::EntityRef = catch World::world_spawn(&world, World::Actor.Player):
                value: value
                error failure: return 2
            initial: Geometry::Transform = authored_pose()
            world_status: i32 = catch World::world_set_transform(&world, entity, initial):
                ok: 0
                error failure: 1
            return 3 if world_status != 0

            direct_bindings: mutable WorldPhysics::Bindings = WorldPhysics::Bindings()
            direct_bind_status: i32 = catch WorldPhysics::bind(session, &world,
                &direct_bindings, entity, PhysicsRuntime::BodyKind.Dynamic,
                Geometry::Vec3{x: Tune::BODY_HALF_EXTENT, y: Tune::BODY_HALF_EXTENT,
                    z: Tune::BODY_HALF_EXTENT}, 1.0):
                ok: 0
                error failure: 1
            return 4 if direct_bind_status != 0
            initial_body_pose: PhysicsRuntime::BodyPose = catch WorldPhysics::body_pose(
                session, direct_bindings, entity):
                value: value
                error failure: return 5
            return 6 if not rotations_match(initial_body_pose.rotation, initial.rotation)

            direct_step: i32 = catch RuntimeServices::physics_fixed_step(session,
                Runtime::fixed_step_seconds()):
                ok: 0
                error failure: 1
            return 7 if direct_step != 0
            direct_sync: i32 = catch WorldPhysics::sync_world(session, &world, direct_bindings):
                ok: 0
                error failure: 1
            return 8 if direct_sync != 0
            direct_world_pose: mutable Geometry::Transform = Geometry::transform_identity()
            return 9 if not World::world_try_transform(world, entity, &direct_world_pose)
            direct_body_pose: PhysicsRuntime::BodyPose = catch WorldPhysics::body_pose(
                session, direct_bindings, entity):
                value: value
                error failure: return 10
            return 11 if not rotations_match(direct_world_pose.rotation, direct_body_pose.rotation)
            return 12 if direct_world_pose.scale.x != initial.scale.x or direct_world_pose.scale.z != initial.scale.z
            direct_cleanup: i32 = catch WorldPhysics::unbind(session, &direct_bindings, entity):
                ok: 0
                error failure: 1
            return 13 if direct_cleanup != 0 or WorldPhysics::binding_count(direct_bindings) != 0

            hierarchy: mutable WorldHierarchy::Hierarchy = WorldHierarchy::Hierarchy()
            if not WorldHierarchy::hierarchy_spawn(&hierarchy, entity.id, initial):
                return 14
            WorldHierarchy::hierarchy_update(&hierarchy)
            hierarchy_bindings: mutable WorldPhysics::Bindings = WorldPhysics::Bindings()
            hierarchy_bind_status: i32 = catch WorldPhysics::bind_hierarchy(session,
                world, hierarchy, &hierarchy_bindings, entity, PhysicsRuntime::BodyKind.Dynamic,
                Geometry::Vec3{x: Tune::BODY_HALF_EXTENT, y: Tune::BODY_HALF_EXTENT,
                    z: Tune::BODY_HALF_EXTENT}, 1.0):
                ok: 0
                error failure: 1
            return 15 if hierarchy_bind_status != 0
            hierarchy_body_pose: PhysicsRuntime::BodyPose = catch WorldPhysics::body_pose(
                session, hierarchy_bindings, entity):
                value: value
                error failure: return 16
            return 17 if not rotations_match(hierarchy_body_pose.rotation, initial.rotation)

            hierarchy_step: i32 = catch RuntimeServices::physics_fixed_step(session,
                Runtime::fixed_step_seconds()):
                ok: 0
                error failure: 1
            return 18 if hierarchy_step != 0
            hierarchy_sync: i32 = catch WorldPhysics::sync_hierarchy(session,
                &hierarchy, hierarchy_bindings):
                ok: 0
                error failure: 1
            return 19 if hierarchy_sync != 0
            WorldHierarchy::hierarchy_update(&hierarchy)
            hierarchy_world_pose: Geometry::Transform = WorldHierarchy::hierarchy_world(
                hierarchy, entity.id)
            hierarchy_body_pose_after: PhysicsRuntime::BodyPose = catch WorldPhysics::body_pose(
                session, hierarchy_bindings, entity):
                value: value
                error failure: return 20
            return 21 if not rotations_match(hierarchy_world_pose.rotation,
                hierarchy_body_pose_after.rotation)
            hierarchy_cleanup: i32 = catch WorldPhysics::unbind(session,
                &hierarchy_bindings, entity):
                ok: 0
                error failure: 1
            return 22 if hierarchy_cleanup != 0 or WorldPhysics::binding_count(hierarchy_bindings) != 0

            kinematic_entity: World::EntityRef = catch World::world_spawn(
                &world, World::Enemy.Guard):
                value: value
                error failure: return 31
            kinematic_start: Geometry::Transform = Geometry::Transform{
                position: Geometry::Vec3{x: Tune::KINEMATIC_START_X,
                    y: Tune::KINEMATIC_START_Y, z: 0.0},
                rotation: Geometry::quat_identity(),
                scale: Geometry::vec3_one(),
            }
            kinematic_start_status: i32 = catch World::world_set_transform(&world,
                kinematic_entity, kinematic_start):
                ok: 0
                error failure: 1
            return 32 if kinematic_start_status != 0
            kinematic_bindings: mutable WorldPhysics::Bindings = WorldPhysics::Bindings()
            dynamic_bind: i32 = catch WorldPhysics::bind(session, &world,
                &kinematic_bindings, entity, PhysicsRuntime::BodyKind.Dynamic,
                Geometry::Vec3{x: Tune::BODY_HALF_EXTENT, y: Tune::BODY_HALF_EXTENT,
                    z: Tune::BODY_HALF_EXTENT}, 1.0):
                ok: 0
                error failure: 1
            kinematic_bind: i32 = catch WorldPhysics::bind(session, &world,
                &kinematic_bindings, kinematic_entity,
                PhysicsRuntime::BodyKind.Kinematic,
                Geometry::Vec3{x: Tune::BODY_HALF_EXTENT, y: Tune::BODY_HALF_EXTENT,
                    z: Tune::BODY_HALF_EXTENT}, 0.0):
                ok: 0
                error failure: 1
            return 33 if dynamic_bind != 0 or kinematic_bind != 0
            kinematic_target: Geometry::Transform = Geometry::Transform{
                position: Geometry::Vec3{x: Tune::KINEMATIC_TARGET_X,
                    y: Tune::KINEMATIC_TARGET_Y, z: 0.0},
                rotation: Geometry::quat_identity(),
                scale: kinematic_start.scale,
            }
            target_status: i32 = catch World::world_set_transform(&world,
                kinematic_entity, kinematic_target):
                ok: 0
                error failure: 1
            return 34 if target_status != 0
            dynamic_cleanup: i32 = catch WorldPhysics::unbind(session,
                &kinematic_bindings, entity):
                ok: 0
                error failure: 1
            return 35 if dynamic_cleanup != 0 or WorldPhysics::binding_count(kinematic_bindings) != 1
            kinematic_frame: RuntimeServices::SimulationFrame = catch WorldPhysics::advance_and_sync(
                session, &world, kinematic_bindings, Runtime::fixed_step_micros()):
                value: value
                error failure: return 36
            return 37 if kinematic_frame.steps != 1 or kinematic_frame.tick_count != 1
            kinematic_pose: mutable Geometry::Transform = Geometry::transform_identity()
            return 38 if not World::world_try_transform(world, kinematic_entity, &kinematic_pose)
            return 39 if ElisaMath::fabsf(kinematic_pose.position.x - Tune::KINEMATIC_TARGET_X) > Tune::KINEMATIC_TARGET_TOLERANCE
            return 40 if ElisaMath::fabsf(kinematic_pose.position.y - Tune::KINEMATIC_TARGET_Y) > Tune::KINEMATIC_TARGET_TOLERANCE
            kinematic_cleanup: i32 = catch WorldPhysics::unbind(session,
                &kinematic_bindings, kinematic_entity):
                ok: 0
                error failure: 1
            return 41 if kinematic_cleanup != 0

            hierarchy_kinematic_bindings: mutable WorldPhysics::Bindings = WorldPhysics::Bindings()
            hierarchy_kinematic_bind: i32 = catch WorldPhysics::bind_hierarchy(session,
                world, hierarchy, &hierarchy_kinematic_bindings, entity,
                PhysicsRuntime::BodyKind.Kinematic,
                Geometry::Vec3{x: Tune::BODY_HALF_EXTENT, y: Tune::BODY_HALF_EXTENT,
                    z: Tune::BODY_HALF_EXTENT}, 0.0):
                ok: 0
                error failure: 1
            return 42 if hierarchy_kinematic_bind != 0
            prior_hierarchy_pose: Geometry::Transform = WorldHierarchy::hierarchy_world(
                hierarchy, entity.id)
            render_bindings: mutable WorldRendering::Bindings = WorldRendering::Bindings()
            render_bind: i32 = catch WorldRendering::bind(&render_bindings, &world,
                entity, Tune::RENDER_ID, probe_visual(), Geometry::transform_identity()):
                ok: 0
                error failure: 1
            return 49 if render_bind != 0
            hierarchy_target: Geometry::Transform = Geometry::Transform{
                position: Geometry::Vec3{x: Tune::HIERARCHY_KINEMATIC_TARGET_X,
                    y: Tune::HIERARCHY_KINEMATIC_TARGET_Y, z: 0.0},
                rotation: Geometry::quat_identity(),
                scale: initial.scale,
            }
            return 43 if not WorldHierarchy::hierarchy_set_local(
                &hierarchy, entity.id, hierarchy_target, false)
            target_preview: mutable Geometry::Transform = Geometry::transform_identity()
            target_depth: mutable usize = 0
            preview_valid: bool = WorldHierarchy::hierarchy_try_target_world(
                hierarchy, entity.id, &target_preview, &target_depth)
            return 50 if not preview_valid or target_depth != 0
            return 51 if target_preview.position.x != Tune::HIERARCHY_KINEMATIC_TARGET_X or target_preview.position.y != Tune::HIERARCHY_KINEMATIC_TARGET_Y
            return 52 if WorldHierarchy::hierarchy_world(hierarchy, entity.id).position.x != prior_hierarchy_pose.position.x
            hierarchy_kinematic_frame: RuntimeServices::SimulationFrame = catch WorldPhysics::advance_and_sync_hierarchy(
                session, &hierarchy, hierarchy_kinematic_bindings,
                Runtime::fixed_step_micros()):
                value: value
                error failure: return 44
            return 45 if hierarchy_kinematic_frame.steps != 1 or hierarchy_kinematic_frame.tick_count != 2
            hierarchy_kinematic_pose: Geometry::Transform = WorldHierarchy::hierarchy_world(
                hierarchy, entity.id)
            return 46 if ElisaMath::fabsf(hierarchy_kinematic_pose.position.x - Tune::HIERARCHY_KINEMATIC_TARGET_X) > Tune::KINEMATIC_TARGET_TOLERANCE
            return 47 if ElisaMath::fabsf(hierarchy_kinematic_pose.position.y - Tune::HIERARCHY_KINEMATIC_TARGET_Y) > Tune::KINEMATIC_TARGET_TOLERANCE
            expected_sample_x: f32 = (prior_hierarchy_pose.position.x + hierarchy_kinematic_pose.position.x) * Tune::INTERPOLATION_ALPHA
            hierarchy_sample: Geometry::Transform = WorldHierarchy::hierarchy_sample(
                hierarchy, entity.id, Tune::INTERPOLATION_ALPHA)
            return 53 if ElisaMath::fabsf(hierarchy_sample.position.x - expected_sample_x) > Tune::KINEMATIC_TARGET_TOLERANCE
            render_snapshot: mutable RenderSnapshot::Snapshot = RenderSnapshot::Snapshot()
            render_extract: i32 = catch WorldRendering::extract_hierarchy(&world,
                &hierarchy, &render_bindings, Tune::INTERPOLATION_ALPHA,
                &render_snapshot):
                ok: 0
                error failure: 1
            return 54 if render_extract != 0 or RenderSnapshot::snapshot_count(render_snapshot) != 1
            rendered_pose: RenderSnapshot::Entry = RenderSnapshot::snapshot_entry(
                render_snapshot, 0)
            return 55 if ElisaMath::fabsf(rendered_pose.transform.position.x - expected_sample_x) > Tune::KINEMATIC_TARGET_TOLERANCE
            return 56 if WorldHierarchy::hierarchy_world(hierarchy, entity.id).position.x != hierarchy_kinematic_pose.position.x
            return 57 if not WorldRendering::unbind(&render_bindings, entity, Tune::RENDER_ID)
            hierarchy_kinematic_cleanup: i32 = catch WorldPhysics::unbind(session,
                &hierarchy_kinematic_bindings, entity):
                ok: 0
                error failure: 1
            return 48 if hierarchy_kinematic_cleanup != 0

            stale_bindings: mutable WorldPhysics::Bindings = WorldPhysics::Bindings()
            stale_bind: i32 = catch WorldPhysics::bind(session, &world,
                &stale_bindings, entity, PhysicsRuntime::BodyKind.Dynamic,
                Geometry::Vec3{x: Tune::BODY_HALF_EXTENT, y: Tune::BODY_HALF_EXTENT,
                    z: Tune::BODY_HALF_EXTENT}, 1.0):
                ok: 0
                error failure: 1
            return 23 if stale_bind != 0
            stale_session_closed: bool = RuntimeServices::shutdown(session)
            return 24 if not stale_session_closed
            stale_reopened: RuntimeServices::OpenStatus = RuntimeServices::open(session,
                config, requirements, AudioRuntime::MIN_SAMPLE_RATE_HZ,
                AudioRuntime::MIN_CHANNEL_COUNT, report)
            return 25 if stale_reopened != RuntimeServices::OpenStatus.FallbackRequired
            stale_sync_status: i32 = catch WorldPhysics::advance_and_sync(session,
                &world, stale_bindings, Runtime::fixed_step_micros()):
                value: 0
                PhysicsRuntime::PhysicsError.StaleWorld: 1
                WorldPhysics::WorldPhysicsError.SynchronizationFailure: 2
                error failure: 3
            return 26 if stale_sync_status != 1

            hierarchy_stale_bindings: mutable WorldPhysics::Bindings = WorldPhysics::Bindings()
            hierarchy_stale_bind: i32 = catch WorldPhysics::bind_hierarchy(session,
                world, hierarchy, &hierarchy_stale_bindings, entity,
                PhysicsRuntime::BodyKind.Dynamic,
                Geometry::Vec3{x: Tune::BODY_HALF_EXTENT, y: Tune::BODY_HALF_EXTENT,
                    z: Tune::BODY_HALF_EXTENT}, 1.0):
                ok: 0
                error failure: 1
            return 27 if hierarchy_stale_bind != 0
            hierarchy_session_closed: bool = RuntimeServices::shutdown(session)
            return 28 if not hierarchy_session_closed
            hierarchy_reopened: RuntimeServices::OpenStatus = RuntimeServices::open(session,
                config, requirements, AudioRuntime::MIN_SAMPLE_RATE_HZ,
                AudioRuntime::MIN_CHANNEL_COUNT, report)
            return 29 if hierarchy_reopened != RuntimeServices::OpenStatus.FallbackRequired
            hierarchy_stale_status: i32 = catch WorldPhysics::advance_and_sync_hierarchy(
                session, &hierarchy, hierarchy_stale_bindings,
                Runtime::fixed_step_micros()):
                value: 0
                PhysicsRuntime::PhysicsError.StaleWorld: 1
                WorldPhysics::WorldPhysicsError.SynchronizationFailure: 2
                error failure: 3
            return 30 if hierarchy_stale_status != 1

            0
