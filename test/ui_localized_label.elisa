include "../src/ui/localized_label.elisa"

# Latin template "{0} coins left" and an Arabic-script-like template of the
# same shape; the Japanese template has no spaces and full-width glyphs.
def latin(extra: i64) -> UiMessageFormat::Text:
    mutable t: UiMessageFormat::Text = UiMessageFormat::Text()
    UiMessageFormat::push(&t, 123)
    UiMessageFormat::push(&t, 48)
    UiMessageFormat::push(&t, 125)
    for w in 0..<2 + extra:
        UiMessageFormat::push(&t, 32)
        for _ in 0..<5:
            UiMessageFormat::push(&t, 97 if w % 2 == 0 else 1575)
    t

def japanese() -> UiMessageFormat::Text:
    mutable t: UiMessageFormat::Text = UiMessageFormat::Text()
    UiMessageFormat::push(&t, 12354)
    UiMessageFormat::push(&t, 123)
    UiMessageFormat::push(&t, 48)
    UiMessageFormat::push(&t, 125)
    for _ in 0..<6:
        UiMessageFormat::push(&t, 12356)
    t

def main() -> i32:
    mutable out: UiMessageFormat::Text = UiMessageFormat::Text()
    em: i64 = 16
    # English: "12 aaaaa ٱٱٱٱٱ" = 16 + 8 + 40 + 8 + 40 = 112 px on one line.
    t: UiMessageFormat::Text = latin(0)
    return 1 if UiMessageFormat::format(&t, [12, 0, 0, 0], &out) != UiMessageFormat::Result.Ok
    en: UiLocalizedLabel::Label = UiLocalizedLabel::layout(&out, UiLocale::EN, em, 200, 2)
    return 2 if en.lines != 1 or not en.fits or en.line_w[0] != 112 or en.line_x[0] != 0
    # Arabic: same text is placed flush right.
    ar: UiLocalizedLabel::Label = UiLocalizedLabel::layout(&out, UiLocale::AR, em, 200, 2)
    return 3 if ar.line_x[0] != 200 - 112 or not ar.fits
    # A longer Norwegian translation wraps to two lines, reserving its expansion.
    long: UiMessageFormat::Text = latin(3)
    UiMessageFormat::format(&long, [12, 0, 0, 0], &out)
    box: i64 = UiLocaleCatalogue::reserve_width(160, UiLocale::NB)
    nb: UiLocalizedLabel::Label = UiLocalizedLabel::layout(&out, UiLocale::NB, em, box, 2)
    return 4 if box != 208 or nb.lines != 2 or not nb.fits
    # The same text in a one-line box reports that it does not fit.
    tight: UiLocalizedLabel::Label = UiLocalizedLabel::layout(&out, UiLocale::NB, em, box, 1)
    return 5 if tight.fits
    # Japanese: one unbreakable 11-glyph word of full-width advance.
    jt: UiMessageFormat::Text = japanese()
    UiMessageFormat::format(&jt, [7, 0, 0, 0], &out)
    ja: UiLocalizedLabel::Label = UiLocalizedLabel::layout(&out, UiLocale::JA, em, 200, 2)
    return 6 if ja.lines != 1 or ja.line_w[0] != 7 * 16 + 8 or not ja.fits
    narrow: UiLocalizedLabel::Label = UiLocalizedLabel::layout(&out, UiLocale::JA, em, 100, 2)
    return 7 if narrow.fits or narrow.line_w[0] <= 100
    # An overlong right-to-left line still starts at the reading edge.
    rtl_over: UiLocalizedLabel::Label = UiLocalizedLabel::layout(&out, UiLocale::AR, em, 100, 2)
    return 8 if rtl_over.line_x[0] != 0
    return 0
