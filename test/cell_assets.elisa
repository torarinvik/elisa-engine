include "../src/world/cell_asset_world.elisa"

def asset(high: u64, low: u64) -> AssetLoader::RequestKey:
    AssetLoader::RequestKey{id: Assets::AssetId{high: high, low: low}, variant: Assets::ArtifactVariant.Runtime}

def load(ledger: mutable CellAssets::Ledger&, key: AssetLoader::RequestKey, bytes: i64) -> bool:
    return false if not CellAssets::begin_decode(ledger, key)
    return false if not CellAssets::complete_decode(ledger, key, bytes)
    CellAssets::upload_complete(ledger, key)

def manifest_of(first: AssetLoader::RequestKey, first_bytes: i64, second: AssetLoader::RequestKey, second_bytes: i64) -> CellAssets::Manifest:
    manifest: mutable CellAssets::Manifest = CellAssets::Manifest()
    _ = CellAssets::manifest_add(&manifest, first, first_bytes)
    if second_bytes > 0:
        _ = CellAssets::manifest_add(&manifest, second, second_bytes)
    manifest

# Walks x from 0 to 12 and back three times; each step trims, then streams in
# the player's cell with one shared and one cell-unique asset.
def travel(runtime: mutable CellWorld::Runtime&, ledger: mutable CellAssets::Ledger&, world: mutable World::World&, budget: i64) -> i32:
    shared: AssetLoader::RequestKey = asset(9, 9)
    for step in 0..<78 |code: i32 = 0, runtime, ledger, world| -> code:
        if code == 0:
            leg: i64 = step.i64() % 26
            x: i64 = leg if leg <= 12 else 25 - leg
            _ = CellAssetWorld::trim(runtime, ledger, world, x, 1, 1)
            key: WorldStreaming::CellKey = WorldStreaming::CellKey{x: x, y: 1}
            unique: AssetLoader::RequestKey = asset(50, (x + 1).u64())
            if not CellAssets::owns(ledger, key):
                manifest: CellAssets::Manifest = manifest_of(shared, 10, unique, 20)
                code <- 101 if not CellAssetWorld::activate(runtime, ledger, world, key, step.i64() + 1, &manifest, 1)
                if code == 0 and CellAssets::asset_state(ledger, shared) != AssetLoader::RequestState.Resident:
                    code <- 102 if not load(ledger, shared, 10)
                code <- 103 if code == 0 and not load(ledger, unique, 20)
            code <- 104 if code == 0 and not CellAssets::cell_resident(ledger, key)
            code <- 105 if code == 0 and CellAssets::committed_bytes(ledger) > budget
            code <- 106 if code == 0 and CellAssets::resident_bytes(ledger).i64() > budget
            code <- 107 if code == 0 and CellAssets::eviction_count(ledger) != 0
            code <- 108 if code == 0 and not CellAssetWorld::valid(runtime, ledger, world)
            code <- 109 if code == 0 and CellAssets::live_assets(ledger) > 4

def main() -> i32 can[Global.Read, Global.Write]:
    world: mutable World::World = catch World::World():
        value: value
        error failure: return 1
    runtime: mutable CellWorld::Runtime = CellWorld::Runtime(2, 1)
    ledger: mutable CellAssets::Ledger = CellAssets::Ledger(120)
    a: AssetLoader::RequestKey = asset(1, 1)
    b: AssetLoader::RequestKey = asset(1, 2)
    c: AssetLoader::RequestKey = asset(1, 3)
    d: AssetLoader::RequestKey = asset(1, 4)
    e: AssetLoader::RequestKey = asset(1, 5)
    first: WorldStreaming::CellKey = WorldStreaming::CellKey{x: 0, y: 1}
    second: WorldStreaming::CellKey = WorldStreaming::CellKey{x: 1, y: 1}
    third: WorldStreaming::CellKey = WorldStreaming::CellKey{x: 2, y: 1}
    first_assets: CellAssets::Manifest = manifest_of(a, 30, b, 30)
    second_assets: CellAssets::Manifest = manifest_of(b, 30, c, 30)
    return 2 if not CellAssetWorld::activate(&runtime, &ledger, &world, first, 1, &first_assets, 1)
    return 3 if not CellAssetWorld::activate(&runtime, &ledger, &world, second, 1, &second_assets, 1)
    # Shared resource: one request for b, owned by both cells.
    return 4 if CellAssets::refcount(&ledger, b) != 2 or CellAssets::live_assets(&ledger) != 3
    return 5 if CellAssets::committed_bytes(&ledger) != 90 or not CellAssetWorld::valid(&runtime, &ledger, &world)
    return 6 if CellAssetWorld::activate(&runtime, &ledger, &world, first, 1, &first_assets, 1)
    return 7 if CellAssets::refcount(&ledger, a) != 1
    # Duplicate keys in one manifest are rejected before any request.
    duplicate: CellAssets::Manifest = manifest_of(d, 10, d, 10)
    return 8 if CellAssetWorld::activate(&runtime, &ledger, &world, third, 1, &duplicate, 1)
    return 9 if CellAssets::refcount(&ledger, d) != 0 or CellAssets::cancellation_count(&ledger) != 0
    # Budget rejection: 90 + 40 > 120; nothing is requested or spawned.
    too_big: CellAssets::Manifest = manifest_of(e, 40, a, 30)
    live_before: usize = World::world_live_count(&world)
    return 10 if CellAssetWorld::activate(&runtime, &ledger, &world, third, 1, &too_big, 1)
    return 11 if CellAssets::refcount(&ledger, e) != 0 or CellAssets::refcount(&ledger, a) != 1
    return 12 if CellAssets::committed_bytes(&ledger) != 90 or World::world_live_count(&world) != live_before
    # Assets fit but the world rejects (stream budget 2): the asset acquire rolls back.
    fits: CellAssets::Manifest = manifest_of(d, 20, a, 30)
    return 13 if CellAssetWorld::activate(&runtime, &ledger, &world, third, 1, &fits, 1)
    return 14 if CellAssets::refcount(&ledger, d) != 0 or CellAssets::refcount(&ledger, a) != 1
    return 15 if CellAssets::committed_bytes(&ledger) != 90 or CellAssets::cancellation_count(&ledger) != 1
    return 16 if CellAssets::owns(&ledger, third) or World::world_live_count(&world) != live_before
    # Stream every asset in; an oversized decode is refused without changing the budget.
    return 17 if not CellAssets::begin_decode(&ledger, a)
    return 18 if CellAssets::complete_decode(&ledger, a, 61)
    return 19 if CellAssets::committed_bytes(&ledger) != 90
    return 20 if not CellAssets::complete_decode(&ledger, a, 30) or not CellAssets::upload_complete(&ledger, a)
    return 21 if not load(&ledger, b, 30) or not load(&ledger, c, 30)
    return 22 if not CellAssets::cell_resident(&ledger, first) or CellAssets::resident_bytes(&ledger) != 90
    # Unloading the second cell releases c but keeps the shared b resident for the first.
    b_handle: AssetLoader::RequestHandle = CellAssets::handle_of(&ledger, b)
    c_handle: AssetLoader::RequestHandle = CellAssets::handle_of(&ledger, c)
    return 23 if not CellAssetWorld::deactivate(&runtime, &ledger, &world, second)
    return 24 if CellAssets::refcount(&ledger, b) != 1 or CellAssets::loader_state(&ledger, b_handle) != AssetLoader::RequestState.Resident
    return 25 if CellAssets::loader_state(&ledger, c_handle) != AssetLoader::RequestState.Empty or CellAssets::release_count(&ledger) != 1
    return 26 if CellAssets::resident_bytes(&ledger) != 60 or CellAssets::committed_bytes(&ledger) != 60
    return 27 if not CellAssets::cell_resident(&ledger, first) or not CellAssetWorld::valid(&runtime, &ledger, &world)
    # Cancellation mid-decode: unloading a cell whose asset is decoding cancels it.
    return 28 if not CellAssetWorld::activate(&runtime, &ledger, &world, second, 2, &second_assets, 1)
    return 29 if not CellAssets::begin_decode(&ledger, c)
    decoding: AssetLoader::RequestHandle = CellAssets::handle_of(&ledger, c)
    return 30 if decoding.generation == c_handle.generation and decoding.slot == c_handle.slot
    return 31 if not CellAssetWorld::deactivate(&runtime, &ledger, &world, second)
    return 32 if CellAssets::loader_state(&ledger, decoding) != AssetLoader::RequestState.Cancelled or CellAssets::cancellation_count(&ledger) != 2
    return 33 if CellAssets::complete_decode(&ledger, c, 30) or CellAssets::upload_complete(&ledger, c)
    # Cancellation mid-upload as well.
    return 34 if not CellAssetWorld::activate(&runtime, &ledger, &world, second, 3, &second_assets, 1)
    return 35 if not CellAssets::begin_decode(&ledger, c) or not CellAssets::complete_decode(&ledger, c, 25)
    uploading: AssetLoader::RequestHandle = CellAssets::handle_of(&ledger, c)
    return 36 if CellAssets::loader_state(&ledger, uploading) != AssetLoader::RequestState.Uploading
    return 37 if not CellAssetWorld::deactivate(&runtime, &ledger, &world, second)
    return 38 if CellAssets::loader_state(&ledger, uploading) != AssetLoader::RequestState.Cancelled
    return 39 if CellAssets::committed_bytes(&ledger) != 60 or CellAssets::resident_bytes(&ledger) != 60
    # Trimming the first cell releases its last references.
    return 40 if CellAssetWorld::trim(&runtime, &ledger, &world, 10, 1, 1) != 1
    return 41 if CellAssets::live_assets(&ledger) != 0 or CellAssets::committed_bytes(&ledger) != 0 or CellAssets::resident_bytes(&ledger) != 0
    return 42 if World::world_live_count(&world) != 0 or CellWorld::active_count(&runtime) != 0
    return 43 if not CellWorld::destroy(&runtime, &world) or not CellAssets::destroy(&ledger)
    # A loader rejection partway through a manifest drops the references
    # already taken: the 100 MiB entry fits the ledger budget but not the loader.
    big_ledger: mutable CellAssets::Ledger = CellAssets::Ledger(209715200)
    partial: CellAssets::Manifest = manifest_of(a, 10, e, 104857600)
    return 48 if CellAssets::acquire(&big_ledger, first, &partial, 1)
    return 49 if CellAssets::refcount(&big_ledger, a) != 0 or CellAssets::live_assets(&big_ledger) != 0
    return 50 if CellAssets::committed_bytes(&big_ledger) != 0 or CellAssets::cancellation_count(&big_ledger) != 1
    return 51 if CellAssets::owns(&big_ledger, first) or not CellAssets::destroy(&big_ledger)
    # Repeated travel across boundaries stays within budget with no evictions.
    walk_world: mutable World::World = catch World::World():
        value: value
        error failure: return 44
    walk_runtime: mutable CellWorld::Runtime = CellWorld::Runtime(4, 1)
    walk_ledger: mutable CellAssets::Ledger = CellAssets::Ledger(80)
    walked: i32 = travel(&walk_runtime, &walk_ledger, &walk_world, 80)
    return walked if walked != 0
    return 45 if CellAssets::release_count(&walk_ledger) < 30
    return 46 if not CellWorld::destroy(&walk_runtime, &walk_world)
    return 47 if not CellAssets::destroy(&walk_ledger) or CellAssets::live_assets(&walk_ledger) != 0
    0
