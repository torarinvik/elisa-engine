include "../src/physics/runtime.elisa"
include "../src/math/geometry.elisa"

module PhysicsPrimitiveProbe:
    private:
        const module Fixture:
            SPHERE_X: f32 = 8.0
            CAPSULE_X: f32 = 11.0
            ZERO_CAPSULE_X: f32 = 14.0
            SHARED_SPHERE_A_X: f32 = 18.0
            SHARED_SPHERE_B_X: f32 = 21.0
            START_HEIGHT: f32 = 4.0
            DROP_THRESHOLD: f32 = 3.8
            SPHERE_RADIUS: f32 = 0.4
            CAPSULE_RADIUS: f32 = 0.3
            CAPSULE_CYLINDER_HALF_HEIGHT: f32 = 0.4
            FIXED_STEP_SECONDS: f32 = 1.0 / 30.0
            FIXED_STEPS: i32 = 9
            BODY_CAPACITY: usize = 64
            MESH_FLOOR_HALF_EXTENT: f32 = 5.0
            CONVEX_SETTLED_MIN_HEIGHT: f32 = -0.15
            CONVEX_SETTLED_MAX_HEIGHT: f32 = 0.5
            MESH_FIXED_STEPS: i32 = 45
            COMPOUND_BODY_X: f32 = 30.0
            COMPOUND_BODY_Y: f32 = 2.0
            COMPOUND_CHILD_OFFSET: f32 = 1.0
            COMPOUND_RADIUS: f32 = 0.45
            COMPOUND_CHILD_COUNT: usize = 2
            COMPOUND_TOO_MANY_CHILDREN: usize = 17
            COMPOUND_HIT_TOLERANCE: f32 = 0.05

    public:
        def exercise(world: mutable PhysicsRuntime::World&,
            stage: mutable i32&) -> void error[PhysicsRuntime::PhysicsError]:
            invalid_sphere: i32 = catch PhysicsRuntime::body_create(world,
                PhysicsRuntime::BodyDesc{
                    kind: PhysicsRuntime::BodyKind.Dynamic,
                    shape: PhysicsRuntime::BodyShape.Sphere,
                    position: Geometry::Vec3{x: Fixture::SPHERE_X, y: Fixture::START_HEIGHT, z: 0.0},
                    rotation: Geometry::quat_identity(),
                    dimensions: Geometry::Vec3{x: 0.0, y: 0.0, z: 0.0},
                    mass: 1.0,
                    sensor: false,
                    collision_layer: 0,
                }):
                value: 1
                PhysicsRuntime::PhysicsError.InvalidArgument: 0
                error failure: 2
            raise PhysicsRuntime::PhysicsError.BackendFailure if invalid_sphere != 0
            stage <- 1
            sphere: PhysicsRuntime::BodyHandle = try PhysicsRuntime::body_create(world,
                PhysicsRuntime::BodyDesc{
                    kind: PhysicsRuntime::BodyKind.Dynamic,
                    shape: PhysicsRuntime::BodyShape.Sphere,
                    position: Geometry::Vec3{x: Fixture::SPHERE_X, y: Fixture::START_HEIGHT, z: 0.0},
                    rotation: Geometry::quat_identity(),
                    dimensions: Geometry::Vec3{x: Fixture::SPHERE_RADIUS, y: 0.0, z: 0.0},
                    mass: 1.0,
                    sensor: false,
                    collision_layer: 0,
                })
            stage <- 2
            capsule: PhysicsRuntime::BodyHandle = try PhysicsRuntime::body_create(world,
                PhysicsRuntime::BodyDesc{
                    kind: PhysicsRuntime::BodyKind.Dynamic,
                    shape: PhysicsRuntime::BodyShape.Capsule,
                    position: Geometry::Vec3{x: Fixture::CAPSULE_X, y: Fixture::START_HEIGHT, z: 0.0},
                    rotation: Geometry::quat_identity(),
                    dimensions: Geometry::Vec3{x: Fixture::CAPSULE_RADIUS, y: Fixture::CAPSULE_CYLINDER_HALF_HEIGHT, z: 0.0},
                    mass: 1.0,
                    sensor: false,
                    collision_layer: 0,
                })
            zero_capsule: PhysicsRuntime::BodyHandle = try PhysicsRuntime::body_create(world,
                PhysicsRuntime::BodyDesc{
                    kind: PhysicsRuntime::BodyKind.Dynamic,
                    shape: PhysicsRuntime::BodyShape.Capsule,
                    position: Geometry::Vec3{x: Fixture::ZERO_CAPSULE_X, y: Fixture::START_HEIGHT, z: 0.0},
                    rotation: Geometry::quat_identity(),
                    dimensions: Geometry::Vec3{x: Fixture::SPHERE_RADIUS, y: 0.0, z: 0.0},
                    mass: 1.0,
                    sensor: false,
                    collision_layer: 0,
                })
            shared_sphere: PhysicsRuntime::ShapeHandle = try PhysicsRuntime::shape_create(world,
                PhysicsRuntime::BodyShape.Sphere,
                Geometry::Vec3{x: Fixture::SPHERE_RADIUS, y: 0.0, z: 0.0})
            shared_a: PhysicsRuntime::BodyHandle = try PhysicsRuntime::body_create_with_shape(world,
                PhysicsRuntime::BodyInstanceDesc{
                    kind: PhysicsRuntime::BodyKind.Dynamic,
                    position: Geometry::Vec3{x: Fixture::SHARED_SPHERE_A_X, y: Fixture::START_HEIGHT, z: 0.0},
                    rotation: Geometry::quat_identity(),
                    mass: 1.0,
                    sensor: false,
                    collision_layer: 0,
                }, shared_sphere)
            shared_b: PhysicsRuntime::BodyHandle = try PhysicsRuntime::body_create_with_shape(world,
                PhysicsRuntime::BodyInstanceDesc{
                    kind: PhysicsRuntime::BodyKind.Dynamic,
                    position: Geometry::Vec3{x: Fixture::SHARED_SPHERE_B_X, y: Fixture::START_HEIGHT, z: 0.0},
                    rotation: Geometry::quat_identity(),
                    mass: 1.0,
                    sensor: false,
                    collision_layer: 0,
                }, shared_sphere)
            in_use_status: i32 = catch PhysicsRuntime::shape_destroy(world, shared_sphere):
                value: 1
                PhysicsRuntime::PhysicsError.ShapeInUse: 0
                error failure: 2
            raise PhysicsRuntime::PhysicsError.BackendFailure if in_use_status != 0
            tick: mutable u64 = 0
            starting_tick: u64 = PhysicsRuntime::committed_tick(world)
            stage <- 3
            for _ in 0..<Fixture::FIXED_STEPS:
                tick <- try PhysicsRuntime::fixed_step(world, Fixture::FIXED_STEP_SECONDS)
            stage <- 4
            raise PhysicsRuntime::PhysicsError.BackendFailure if tick != starting_tick + 9
            stage <- 5
            sphere_position: Geometry::Vec3 = try PhysicsRuntime::body_position(world, sphere)
            stage <- 6
            capsule_position: Geometry::Vec3 = try PhysicsRuntime::body_position(world, capsule)
            stage <- 7
            zero_capsule_position: Geometry::Vec3 = try PhysicsRuntime::body_position(world, zero_capsule)
            stage <- 8
            raise PhysicsRuntime::PhysicsError.BackendFailure if sphere_position.y >= Fixture::DROP_THRESHOLD
            stage <- 9
            raise PhysicsRuntime::PhysicsError.BackendFailure if capsule_position.y >= Fixture::DROP_THRESHOLD
            stage <- 10
            raise PhysicsRuntime::PhysicsError.BackendFailure if zero_capsule_position.y >= Fixture::DROP_THRESHOLD
            stage <- 11
            shared_a_position: Geometry::Vec3 = try PhysicsRuntime::body_position(world, shared_a)
            shared_b_position: Geometry::Vec3 = try PhysicsRuntime::body_position(world, shared_b)
            raise PhysicsRuntime::PhysicsError.BackendFailure if shared_a_position.y >= Fixture::DROP_THRESHOLD or shared_b_position.y >= Fixture::DROP_THRESHOLD
            try PhysicsRuntime::body_destroy(world, sphere)
            try PhysicsRuntime::body_destroy(world, capsule)
            try PhysicsRuntime::body_destroy(world, zero_capsule)
            try PhysicsRuntime::body_destroy(world, shared_a)
            in_use_after_one: i32 = catch PhysicsRuntime::shape_destroy(world, shared_sphere):
                value: 1
                PhysicsRuntime::PhysicsError.ShapeInUse: 0
                error failure: 2
            raise PhysicsRuntime::PhysicsError.BackendFailure if in_use_after_one != 0
            try PhysicsRuntime::body_destroy(world, shared_b)
            try PhysicsRuntime::shape_destroy(world, shared_sphere)
            stale_shape_status: i32 = catch PhysicsRuntime::body_create_with_shape(world,
                PhysicsRuntime::BodyInstanceDesc{
                    kind: PhysicsRuntime::BodyKind.Dynamic,
                    position: Geometry::Vec3{x: Fixture::SHARED_SPHERE_A_X, y: Fixture::START_HEIGHT, z: 0.0},
                    rotation: Geometry::quat_identity(),
                    mass: 1.0,
                    sensor: false,
                    collision_layer: 0,
                }, shared_sphere):
                value: 1
                PhysicsRuntime::PhysicsError.InvalidHandle: 0
                error failure: 2
            raise PhysicsRuntime::PhysicsError.BackendFailure if stale_shape_status != 0
            try exercise_compound_shapes(world, stage)

        def exercise_compound_shapes(world: mutable PhysicsRuntime::World&,
            stage: mutable i32&) -> void error[PhysicsRuntime::PhysicsError]:
            child_shape: PhysicsRuntime::ShapeHandle = try PhysicsRuntime::shape_create(world,
                PhysicsRuntime::BodyShape.Sphere,
                Geometry::Vec3{x: Fixture::COMPOUND_RADIUS, y: 0.0, z: 0.0})
            children: mutable PhysicsRuntime::CompoundChild[2] = [
                PhysicsRuntime::CompoundChild{
                    shape: child_shape,
                    position: Geometry::Vec3{x: 0.0 - Fixture::COMPOUND_CHILD_OFFSET, y: 0.0, z: 0.0},
                    rotation: Geometry::quat_identity(),
                },
                PhysicsRuntime::CompoundChild{
                    shape: child_shape,
                    position: Geometry::Vec3{x: Fixture::COMPOUND_CHILD_OFFSET, y: 0.0, z: 0.0},
                    rotation: Geometry::quat_identity(),
                },
            ]
            empty_compound: i32 = catch PhysicsRuntime::shape_create_compound(world,
                &children[0], 0):
                value: 1
                PhysicsRuntime::PhysicsError.InvalidArgument: 0
                error failure: 2
            raise PhysicsRuntime::PhysicsError.BackendFailure if empty_compound != 0
            # Reject an excessive count before reading beyond this valid child buffer.
            too_many_status: i32 = catch PhysicsRuntime::shape_create_compound(world,
                &children[0], Fixture::COMPOUND_TOO_MANY_CHILDREN):
                value: 1
                PhysicsRuntime::PhysicsError.InvalidArgument: 0
                error failure: 2
            raise PhysicsRuntime::PhysicsError.BackendFailure if too_many_status != 0
            stage <- 12
            compound: PhysicsRuntime::ShapeHandle = try PhysicsRuntime::shape_create_compound(
                world, &children[0], Fixture::COMPOUND_CHILD_COUNT)
            child_retained: i32 = catch PhysicsRuntime::shape_destroy(world, child_shape):
                value: 1
                PhysicsRuntime::PhysicsError.ShapeInUse: 0
                error failure: 2
            raise PhysicsRuntime::PhysicsError.BackendFailure if child_retained != 0
            nested_children: mutable PhysicsRuntime::CompoundChild[1] = [
                PhysicsRuntime::CompoundChild{
                    shape: compound,
                    position: Geometry::Vec3{x: 0.0, y: 0.0, z: 0.0},
                    rotation: Geometry::quat_identity(),
                },
            ]
            nested_compound: PhysicsRuntime::ShapeHandle = try PhysicsRuntime::shape_create_compound(
                world, &nested_children[0], 1)
            parent_retained: i32 = catch PhysicsRuntime::shape_destroy(world, compound):
                value: 1
                PhysicsRuntime::PhysicsError.ShapeInUse: 0
                error failure: 2
            raise PhysicsRuntime::PhysicsError.BackendFailure if parent_retained != 0
            compound_body: PhysicsRuntime::BodyHandle = try PhysicsRuntime::body_create_with_shape(world,
                PhysicsRuntime::BodyInstanceDesc{
                    kind: PhysicsRuntime::BodyKind.Static,
                    position: Geometry::Vec3{x: Fixture::COMPOUND_BODY_X, y: Fixture::COMPOUND_BODY_Y, z: 0.0},
                    rotation: Geometry::quat_identity(),
                    mass: 0.0,
                    sensor: false,
                    collision_layer: 0,
                }, nested_compound)
            compound_retained: i32 = catch PhysicsRuntime::shape_destroy(world, nested_compound):
                value: 1
                PhysicsRuntime::PhysicsError.ShapeInUse: 0
                error failure: 2
            raise PhysicsRuntime::PhysicsError.BackendFailure if compound_retained != 0
            stage <- 13
            _ = try PhysicsRuntime::fixed_step(world, Fixture::FIXED_STEP_SECONDS)
            left_hit: PhysicsRuntime::RayHit = try PhysicsRuntime::raycast(world,
                Geometry::Vec3{x: Fixture::COMPOUND_BODY_X - 1.0, y: 4.0, z: 0.0},
                Geometry::Vec3{x: 0.0, y: -1.0, z: 0.0}, 4.0, PhysicsRuntime::ALL_LAYERS)
            right_hit: PhysicsRuntime::RayHit = try PhysicsRuntime::raycast(world,
                Geometry::Vec3{x: Fixture::COMPOUND_BODY_X + 1.0, y: 4.0, z: 0.0},
                Geometry::Vec3{x: 0.0, y: -1.0, z: 0.0}, 4.0, PhysicsRuntime::ALL_LAYERS)
            gap_hit: PhysicsRuntime::RayHit = try PhysicsRuntime::raycast(world,
                Geometry::Vec3{x: Fixture::COMPOUND_BODY_X, y: 4.0, z: 0.0},
                Geometry::Vec3{x: 0.0, y: -1.0, z: 0.0}, 4.0, PhysicsRuntime::ALL_LAYERS)
            stage <- 14
            raise PhysicsRuntime::PhysicsError.BackendFailure if not left_hit.hit
            stage <- 15
            raise PhysicsRuntime::PhysicsError.BackendFailure if not right_hit.hit
            stage <- 16
            raise PhysicsRuntime::PhysicsError.BackendFailure if left_hit.entity != right_hit.entity
            stage <- 17
            raise PhysicsRuntime::PhysicsError.BackendFailure if (left_hit.position.x < Fixture::COMPOUND_BODY_X - Fixture::COMPOUND_CHILD_OFFSET - Fixture::COMPOUND_HIT_TOLERANCE or
                left_hit.position.x > Fixture::COMPOUND_BODY_X - Fixture::COMPOUND_CHILD_OFFSET + Fixture::COMPOUND_HIT_TOLERANCE or
                left_hit.position.y < Fixture::COMPOUND_BODY_Y + Fixture::COMPOUND_RADIUS - Fixture::COMPOUND_HIT_TOLERANCE or
                left_hit.position.y > Fixture::COMPOUND_BODY_Y + Fixture::COMPOUND_RADIUS + Fixture::COMPOUND_HIT_TOLERANCE or
                right_hit.position.x < Fixture::COMPOUND_BODY_X + Fixture::COMPOUND_CHILD_OFFSET - Fixture::COMPOUND_HIT_TOLERANCE or
                right_hit.position.x > Fixture::COMPOUND_BODY_X + Fixture::COMPOUND_CHILD_OFFSET + Fixture::COMPOUND_HIT_TOLERANCE or
                right_hit.position.y < Fixture::COMPOUND_BODY_Y + Fixture::COMPOUND_RADIUS - Fixture::COMPOUND_HIT_TOLERANCE or
                right_hit.position.y > Fixture::COMPOUND_BODY_Y + Fixture::COMPOUND_RADIUS + Fixture::COMPOUND_HIT_TOLERANCE)
            stage <- 18
            raise PhysicsRuntime::PhysicsError.BackendFailure if gap_hit.hit
            try PhysicsRuntime::body_destroy(world, compound_body)
            child_still_retained: i32 = catch PhysicsRuntime::shape_destroy(world, child_shape):
                value: 1
                PhysicsRuntime::PhysicsError.ShapeInUse: 0
                error failure: 2
            raise PhysicsRuntime::PhysicsError.BackendFailure if child_still_retained != 0
            try PhysicsRuntime::shape_destroy(world, nested_compound)
            try PhysicsRuntime::shape_destroy(world, compound)
            try PhysicsRuntime::shape_destroy(world, child_shape)
            stage <- 19

        def exercise_capacity(world: mutable PhysicsRuntime::World&) -> void error[PhysicsRuntime::PhysicsError]:
            capacity_shape: PhysicsRuntime::ShapeHandle = try PhysicsRuntime::shape_create(world,
                PhysicsRuntime::BodyShape.Sphere,
                Geometry::Vec3{x: Fixture::SPHERE_RADIUS, y: 0.0, z: 0.0})
            capacity_bodies: mutable PhysicsRuntime::ServiceBodyHandles::Pool =
                PhysicsRuntime::ServiceBodyHandles::Pool()
            for index in 0..<Fixture::BODY_CAPACITY:
                body: PhysicsRuntime::BodyHandle = try PhysicsRuntime::body_create_with_shape(world,
                    PhysicsRuntime::BodyInstanceDesc{
                        kind: PhysicsRuntime::BodyKind.Static,
                        position: Geometry::Vec3{x: 0.0, y: 0.0, z: 0.0},
                        rotation: Geometry::quat_identity(),
                        mass: 0.0,
                        sensor: false,
                        collision_layer: 0,
                    }, capacity_shape)
                stored: bool = PhysicsRuntime::ServiceBodyHandles::store(
                    &capacity_bodies, index, body)
                raise PhysicsRuntime::PhysicsError.BackendFailure if not stored
            exhausted: i32 = catch PhysicsRuntime::body_create_with_shape(world,
                PhysicsRuntime::BodyInstanceDesc{
                    kind: PhysicsRuntime::BodyKind.Static,
                    position: Geometry::Vec3{x: 0.0, y: 0.0, z: 0.0},
                    rotation: Geometry::quat_identity(),
                    mass: 0.0,
                    sensor: false,
                    collision_layer: 0,
                }, capacity_shape):
                value: 1
                PhysicsRuntime::PhysicsError.Capacity: 0
                error failure: 2
            raise PhysicsRuntime::PhysicsError.BackendFailure if exhausted != 0
            for index in 0..<Fixture::BODY_CAPACITY:
                body: PhysicsRuntime::BodyHandle = try PhysicsRuntime::ServiceBodyHandles::get(
                    capacity_bodies, index)
                try PhysicsRuntime::body_destroy(world, body)
            try PhysicsRuntime::shape_destroy(world, capacity_shape)

        def exercise_mesh_shapes(world: mutable PhysicsRuntime::World&,
            stage: mutable i32&) -> void error[PhysicsRuntime::PhysicsError]:
            stage <- 1
            invalid_indices: i32 =
                vertices: Geometry::Vec3[4] = [
                    Geometry::Vec3{x: 0.0, y: 0.0, z: 0.0},
                    Geometry::Vec3{x: 1.0, y: 0.0, z: 0.0},
                    Geometry::Vec3{x: 0.0, y: 0.0, z: 1.0},
                    Geometry::Vec3{x: 1.0, y: 1.0, z: 1.0},
                ]
                indices: u32[3] = [0, 1, 3]
                catch PhysicsRuntime::shape_create_triangle_mesh(world,
                    &vertices[0], 3, &indices[0], 3):
                    value: 1
                    PhysicsRuntime::PhysicsError.InvalidArgument: 0
                    error failure: 2
            raise PhysicsRuntime::PhysicsError.BackendFailure if invalid_indices != 0

            stage <- 2
            floor_shape: PhysicsRuntime::ShapeHandle =
                vertices: mutable Geometry::Vec3[4] = [
                    Geometry::Vec3{x: -Fixture::MESH_FLOOR_HALF_EXTENT, y: 0.0, z: -Fixture::MESH_FLOOR_HALF_EXTENT},
                    Geometry::Vec3{x: Fixture::MESH_FLOOR_HALF_EXTENT, y: 0.0, z: -Fixture::MESH_FLOOR_HALF_EXTENT},
                    Geometry::Vec3{x: Fixture::MESH_FLOOR_HALF_EXTENT, y: 0.0, z: Fixture::MESH_FLOOR_HALF_EXTENT},
                    Geometry::Vec3{x: -Fixture::MESH_FLOOR_HALF_EXTENT, y: 0.0, z: Fixture::MESH_FLOOR_HALF_EXTENT},
                ]
                indices: mutable u32[6] = [0, 2, 1, 0, 3, 2]
                shape: PhysicsRuntime::ShapeHandle = try PhysicsRuntime::shape_create_triangle_mesh(
                    world, &vertices[0], 4, &indices[0], 6)
                # The service owns a copy; changing caller storage must not affect it.
                vertices[0] <- Geometry::Vec3{x: 100.0, y: 100.0, z: 100.0}
                shape

            stage <- 3
            invalid_dynamic_mesh: i32 = catch PhysicsRuntime::body_create_with_shape(world,
                PhysicsRuntime::BodyInstanceDesc{
                    kind: PhysicsRuntime::BodyKind.Dynamic,
                    position: Geometry::Vec3{x: 0.0, y: 0.0, z: 0.0},
                    rotation: Geometry::quat_identity(),
                    mass: 1.0,
                    sensor: false,
                    collision_layer: 0,
                }, floor_shape):
                value: 1
                PhysicsRuntime::PhysicsError.InvalidArgument: 0
                error failure: 2
            raise PhysicsRuntime::PhysicsError.BackendFailure if invalid_dynamic_mesh != 0

            stage <- 31
            static_child: mutable PhysicsRuntime::CompoundChild[1] = [
                PhysicsRuntime::CompoundChild{
                    shape: floor_shape,
                    position: Geometry::Vec3{x: 0.0, y: 0.0, z: 0.0},
                    rotation: Geometry::quat_identity(),
                },
            ]
            static_compound: PhysicsRuntime::ShapeHandle = try PhysicsRuntime::shape_create_compound(
                world, &static_child[0], 1)
            nested_static_child: mutable PhysicsRuntime::CompoundChild[1] = [
                PhysicsRuntime::CompoundChild{
                    shape: static_compound,
                    position: Geometry::Vec3{x: 0.0, y: 0.0, z: 0.0},
                    rotation: Geometry::quat_identity(),
                },
            ]
            nested_static_compound: PhysicsRuntime::ShapeHandle = try PhysicsRuntime::shape_create_compound(
                world, &nested_static_child[0], 1)
            invalid_dynamic_compound: i32 = catch PhysicsRuntime::body_create_with_shape(world,
                PhysicsRuntime::BodyInstanceDesc{
                    kind: PhysicsRuntime::BodyKind.Dynamic,
                    position: Geometry::Vec3{x: 0.0, y: 0.0, z: 0.0},
                    rotation: Geometry::quat_identity(),
                    mass: 1.0,
                    sensor: false,
                    collision_layer: 0,
                }, nested_static_compound):
                value: 1
                PhysicsRuntime::PhysicsError.InvalidArgument: 0
                error failure: 2
            raise PhysicsRuntime::PhysicsError.BackendFailure if invalid_dynamic_compound != 0
            try PhysicsRuntime::shape_destroy(world, nested_static_compound)
            try PhysicsRuntime::shape_destroy(world, static_compound)

            stage <- 4
            floor: PhysicsRuntime::BodyHandle = try PhysicsRuntime::body_create_with_shape(world,
                PhysicsRuntime::BodyInstanceDesc{
                    kind: PhysicsRuntime::BodyKind.Static,
                    position: Geometry::Vec3{x: 0.0, y: 0.0, z: 0.0},
                    rotation: Geometry::quat_identity(),
                    mass: 0.0,
                    sensor: false,
                    collision_layer: 0,
                }, floor_shape)
            stage <- 5
            floor_in_use: i32 = catch PhysicsRuntime::shape_destroy(world, floor_shape):
                value: 1
                PhysicsRuntime::PhysicsError.ShapeInUse: 0
                error failure: 2
            raise PhysicsRuntime::PhysicsError.BackendFailure if floor_in_use != 0

            stage <- 6
            convex_shape: PhysicsRuntime::ShapeHandle =
                vertices: mutable Geometry::Vec3[4] = [
                    Geometry::Vec3{x: -0.5, y: 0.0, z: -0.5},
                    Geometry::Vec3{x: 0.5, y: 0.0, z: -0.5},
                    Geometry::Vec3{x: 0.0, y: 0.0, z: 0.5},
                    Geometry::Vec3{x: 0.0, y: 1.0, z: 0.0},
                ]
                indices: mutable u32[12] = [0, 1, 3, 1, 2, 3, 2, 0, 3, 0, 2, 1]
                shape: PhysicsRuntime::ShapeHandle = try PhysicsRuntime::shape_create_convex_hull(
                    world, &vertices[0], 4, &indices[0], 12)
                vertices[3] <- Geometry::Vec3{x: 0.0, y: 20.0, z: 0.0}
                shape
            stage <- 7
            falling: PhysicsRuntime::BodyHandle = try PhysicsRuntime::body_create_with_shape(world,
                PhysicsRuntime::BodyInstanceDesc{
                    kind: PhysicsRuntime::BodyKind.Dynamic,
                    position: Geometry::Vec3{x: 0.0, y: 4.0, z: 0.0},
                    rotation: Geometry::quat_identity(),
                    mass: 1.0,
                    sensor: false,
                    collision_layer: 0,
                }, convex_shape)
            tick: mutable u64 = 0
            stage <- 8
            for _ in 0..<Fixture::MESH_FIXED_STEPS:
                tick <- try PhysicsRuntime::fixed_step(world, Fixture::FIXED_STEP_SECONDS)
            stage <- 9
            settled: Geometry::Vec3 = try PhysicsRuntime::body_position(world, falling)
            raise PhysicsRuntime::PhysicsError.BackendFailure if settled.y < Fixture::CONVEX_SETTLED_MIN_HEIGHT or settled.y > Fixture::CONVEX_SETTLED_MAX_HEIGHT
            try PhysicsRuntime::body_destroy(world, falling)
            try PhysicsRuntime::body_destroy(world, floor)
            try PhysicsRuntime::shape_destroy(world, convex_shape)
            try PhysicsRuntime::shape_destroy(world, floor_shape)

        def mesh_shapes(world: mutable PhysicsRuntime::World&,
            stage: mutable i32&) -> i32:
            catch exercise_mesh_shapes(world, stage):
                ok: 0
                PhysicsRuntime::PhysicsError.InvalidArgument: 1
                PhysicsRuntime::PhysicsError.ApplicationUnavailable: 2
                PhysicsRuntime::PhysicsError.WrongThread: 3
                PhysicsRuntime::PhysicsError.Capacity: 4
                PhysicsRuntime::PhysicsError.InvalidHandle: 5
                PhysicsRuntime::PhysicsError.StaleWorld: 6
                PhysicsRuntime::PhysicsError.ShapeInUse: 7
                PhysicsRuntime::PhysicsError.BodyNotReady: 8
                PhysicsRuntime::PhysicsError.BackendFailure: 90 + stage
                error failure: 100 + stage

        def capacity(world: mutable PhysicsRuntime::World&) -> i32:
            catch exercise_capacity(world):
                ok: 0
                PhysicsRuntime::PhysicsError.InvalidArgument: 1
                PhysicsRuntime::PhysicsError.ApplicationUnavailable: 2
                PhysicsRuntime::PhysicsError.WrongThread: 3
                PhysicsRuntime::PhysicsError.Capacity: 4
                PhysicsRuntime::PhysicsError.InvalidHandle: 5
                PhysicsRuntime::PhysicsError.StaleWorld: 6
                PhysicsRuntime::PhysicsError.ShapeInUse: 7
                PhysicsRuntime::PhysicsError.BodyNotReady: 8
                PhysicsRuntime::PhysicsError.BackendFailure: 9
                error failure: 10

        def run(world: mutable PhysicsRuntime::World&,
            stage: mutable i32&) -> i32:
            catch exercise(world, stage):
                ok: 0
                PhysicsRuntime::PhysicsError.InvalidArgument: 111 + stage
                PhysicsRuntime::PhysicsError.ApplicationUnavailable: 121 + stage
                PhysicsRuntime::PhysicsError.WrongThread: 131 + stage
                PhysicsRuntime::PhysicsError.Capacity: 141 + stage
                PhysicsRuntime::PhysicsError.InvalidHandle: 151 + stage
                PhysicsRuntime::PhysicsError.StaleWorld: 161 + stage
                PhysicsRuntime::PhysicsError.ShapeInUse: 166 + stage
                PhysicsRuntime::PhysicsError.BodyNotReady: 169 + stage
                PhysicsRuntime::PhysicsError.BackendFailure: 171 + stage
                error failure: 118
