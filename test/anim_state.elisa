include "../src/animation/sampler.elisa"
include "../src/animation/skin.elisa"
include "../src/animation/state.elisa"
include "./anim_assets.elisa"
using Anim
using Ik
using Pose
using Sampler
using Skin
using Geometry

def near(value: f32, expected: f32) -> bool:
    diff: f32 = value - expected
    adjusted: f32 = 0.0 - diff if diff < 0.0 else diff
    adjusted < 0.002

def keyed(x: f32) -> Transform:
    Transform{position: Vec3{x: x, y: 0.0, z: 0.0}, rotation: quat_identity(), scale: vec3_one()}

def clip_tests() -> i32:
    # Clip sampling: two keys ten ticks apart interpolate at the midpoint, a
    # tick outside the range holds the end key rather than extrapolating, and a
    # joint with no keys keeps the skeleton's own local transform.
    clip: mutable ClipData = ClipData(10)
    return 45 if not Sampler::clip_valid(&clip) or Sampler::clip_key_count(&clip, 0) != 0
    return 46 if not Sampler::clip_add_key(&clip, 0, 0, keyed(0.0)) or not Sampler::clip_add_key(&clip, 0, 10, keyed(2.0))
    return 47 if not Sampler::clip_add_key(&clip, 1, 0, keyed(0.0)) or not Sampler::clip_add_key(&clip, 1, 10, keyed(4.0))
    return 48 if Sampler::clip_add_key(&clip, 0, 11, keyed(1.0)) or Sampler::clip_add_key(&clip, 0, 5, keyed(9.0))
    return 49 if Sampler::clip_key_count(&clip, 0) != 2 or Sampler::clip_key_count(&clip, 1) != 2
    midpoint: Transform = catch Sampler::clip_sample_local(&clip, 0, 5, keyed(-1.0)):
        value: value
        error failure: return 50
    return 51 if not near(midpoint.position.x, 1.0)
    held_before: Transform = catch Sampler::clip_sample_local(&clip, 0, -5, keyed(-1.0)):
        value: value
        error failure: return 52
    return 53 if not near(held_before.position.x, 0.0)
    held_after: Transform = catch Sampler::clip_sample_local(&clip, 0, 99, keyed(-1.0)):
        value: value
        error failure: return 54
    return 55 if not near(held_after.position.x, 2.0)
    fallback_local: Transform = catch Sampler::clip_sample_local(&clip, 3, 5, keyed(7.0)):
        value: value
        error failure: return 56
    return 57 if not near(fallback_local.position.x, 7.0)
    bad_joint: i32 = catch Sampler::clip_sample_local(&clip, 80, 5, keyed(0.0)):
        value: 0
        ClipError.InvalidTrack: 1
        error failure: 2
    return 58 if bad_joint != 1
    many_keys: mutable ClipData = ClipData(255)
    inserted_all: bool = for tick in 0..<256 |inserted_all: bool = true, many_keys| -> inserted_all:
        inserted_all <- false if not Sampler::clip_add_key(&many_keys, 0, tick, keyed(tick.f32()))
    return 71 if not inserted_all or Sampler::clip_key_count(&many_keys, 0) != 256 or not Sampler::clip_valid(&many_keys)
    late_key: Transform = catch Sampler::clip_sample_local(&many_keys, 0, 254, keyed(-1.0)):
        value: value
        error failure: return 73
    return 74 if not near(late_key.position.x, 254.0)
    clip_skeleton: mutable Skeleton = Skeleton()
    _ = skeleton_add(&clip_skeleton, -1, keyed(0.0))
    _ = skeleton_add(&clip_skeleton, 0, keyed(0.0))
    _ = skeleton_add(&clip_skeleton, 1, keyed(0.0))
    corrupted_skeleton: mutable Skeleton = Skeleton()
    _ = skeleton_add(&corrupted_skeleton, -1, keyed(0.0))
    _ = skeleton_add(&corrupted_skeleton, 0, keyed(0.0))
    corrupted_skeleton.joints[1] <- Joint{parent: 1, local: keyed(0.0)}
    return 72 if skeleton_valid(&corrupted_skeleton)
    sampled_pose: Pose = catch Sampler::clip_sample_pose(&clip, 5, &clip_skeleton):
        value: value
        error failure: return 59
    return 60 if not pose_valid(&sampled_pose) or not near(sampled_pose.models[1].position.x, 3.0)
    start_pose: Pose = catch Sampler::clip_sample_pose(&clip, 0, &clip_skeleton):
        value: value
        error failure: return 61
    end_pose: Pose = catch Sampler::clip_sample_pose(&clip, 10, &clip_skeleton):
        value: value
        error failure: return 62
    return 63 if not near(pose_root_motion(&start_pose, &end_pose).x, 2.0)
    skinning: i32 = skinning_test()
    return skinning if skinning != 0
    0

def two_roots(x0: f32, y0: f32, x1: f32, y1: f32) -> Pose:
    skeleton: mutable Skeleton = Skeleton()
    _ = skeleton_add(&skeleton, -1, Transform{position: Vec3{x: x0, y: y0, z: 0.0}, rotation: quat_identity(), scale: vec3_one()})
    _ = skeleton_add(&skeleton, -1, Transform{position: Vec3{x: x1, y: y1, z: 0.0}, rotation: quat_identity(), scale: vec3_one()})
    result: Pose = catch pose_evaluate(&skeleton):
        value: value
        error failure: Pose{models: zeroed, count: 0}
    result

def skinning_test() -> i32:
    bind: Pose = two_roots(0.0, 0.0, 1.0, 0.0)
    current: Pose = two_roots(0.0, 0.0, 1.0, 2.0)
    single: mutable Binding = Binding()
    return 64 if not binding_add(&single, 1, 1.0)
    return 65 if not binding_valid(&single, 2) or binding_weight_sum(&single) != 1.0
    moved: Vec3 = skin_vertex(Vec3{x: 0.5, y: 0.0, z: 0.0}, &single, &current, &bind)
    return 66 if not near(moved.x, 0.5) or not near(moved.y, 2.0)
    blended: mutable Binding = Binding()
    _ = binding_add(&blended, 0, 0.5)
    return 67 if not binding_add(&blended, 1, 0.5) or not binding_valid(&blended, 2)
    mixed: Vec3 = skin_vertex(Vec3{x: 0.5, y: 0.0, z: 0.0}, &blended, &current, &bind)
    return 68 if not near(mixed.x, 0.5) or not near(mixed.y, 1.0)
    return 69 if binding_add(&blended, 0, 0.0) or binding_valid(&single, 1)
    return 70 if binding_weight_sum(&blended) != 1.0
    0

def main() -> i32:
    asset_tests: i32 = run_animation_asset_tests()
    return asset_tests if asset_tests != 0
    first_clip: i32 = clip_tests()
    return first_clip if first_clip != 0
    return 1 if Anim::clip_length(Clip.Idle) != 60 or Anim::clip_length(Clip.Walk) != 30
    return 2 if Anim::clip_length(Clip.Win) != 45 or Anim::clip_length(Clip.Hurt) != 20
    state: mutable AnimState = AnimState()
    return 3 if state.clip != Clip.Idle or state.tick != 0 or state.blend != 1.0
    return 4 if not anim_valid(&state)

    anim_play(&state, Clip.Walk)
    return 5 if state.clip != Clip.Walk or state.tick != 0 or state.blend != 0.0
    anim_play(&state, Clip.Walk)
    return 6 if state.tick != 0

    for step in 0..<15 |state|:
        anim_tick(&state)
    return 7 if state.tick != 15 or anim_event_at(&state, 0) != 2
    return 8 if state.blend != 1.0 or not anim_valid(&state)
    return 9 if state.distance != 0.46875

    for step in 0..<15 |state|:
        anim_tick(&state)
    return 10 if state.tick != 0 or anim_event_at(&state, state.event_count - 1) != 1
    return 11 if state.distance != 0.9375

    anim_play(&state, Clip.Idle)
    return 12 if state.clip != Clip.Idle or state.blend_left != 4
    anim_tick(&state)
    return 13 if state.blend != 0.25

    # Two-bone IK: unit segments and a target one unit away give a knee
    # cosine of exactly 0.5 by the law of cosines; farther than reach clamps
    # to a straight limb (cosine -1), and a target at the root folds it
    # (cosine 1).
    one_unit: TwoBoneSolution = two_bone_solve(1.0, 1.0, Vec3{x: 1.0, y: 0.0, z: 0.0})
    return 14 if one_unit.knee_cosine < 0.4999 or one_unit.knee_cosine > 0.5001
    return 15 if not one_unit.reachable or one_unit.collapsed or not two_bone_solution_valid(&one_unit)
    far: TwoBoneSolution = two_bone_solve(1.0, 1.0, Vec3{x: 3.0, y: 0.0, z: 0.0})
    return 16 if far.knee_cosine != -1.0 or far.reachable
    folded: TwoBoneSolution = two_bone_solve(1.0, 1.0, vec3_zero())
    return 17 if folded.knee_cosine != 1.0 or not folded.collapsed
    unused: TwoBoneSolution = two_bone_solve(0.0, 1.0, Vec3{x: 1.0, y: 0.0, z: 0.0})
    return 18 if two_bone_solution_valid(&unused)
    return 19 if aim_cosine(Vec3{x: 1.0, y: 0.0, z: 0.0}, Vec3{x: 2.0, y: 0.0, z: 0.0}) < 0.9999
    return 20 if aim_cosine(Vec3{x: 1.0, y: 0.0, z: 0.0}, Vec3{x: 0.0, y: 1.0, z: 0.0}) != 0.0
    return 21 if aim_cosine(vec3_zero(), Vec3{x: 1.0, y: 0.0, z: 0.0}) != -1.0

    # Knee placement uses the triangle directly, so no inverse trig is needed:
    # a one-unit reach at unit lengths gives projection 0.5 and height
    # sqrt(1 - 0.25).
    bend: Vec3 = Vec3{x: 0.0, y: 0.0, z: 1.0}
    knee: Vec3 = two_bone_knee(vec3_zero(), Vec3{x: 1.0, y: 0.0, z: 0.0}, 1.0, 1.0, bend)
    return 22 if not near(knee.x, 0.5) or not near(knee.z, 0.866)
    straight: Vec3 = two_bone_knee(vec3_zero(), Vec3{x: 5.0, y: 0.0, z: 0.0}, 1.0, 1.0, bend)
    return 23 if not near(straight.x, 1.0) or not near(straight.z, 0.0)
    folded_knee: Vec3 = two_bone_knee(vec3_zero(), vec3_zero(), 1.0, 1.0, bend)
    return 24 if not near(folded_knee.z, 1.0)

    # Local-to-model evaluation: a child one unit along +X under a root moved
    # by 0.4 lands at 1.4; root motion is the difference between two poses.
    chain: mutable Skeleton = Skeleton()
    return 25 if not skeleton_add(&chain, -1, transform_identity())
    return 26 if not skeleton_add(&chain, 0, Transform{position: Vec3{x: 1.0, y: 0.0, z: 0.0}, rotation: quat_identity(), scale: vec3_one()})
    return 27 if not skeleton_add(&chain, 1, Transform{position: Vec3{x: 1.0, y: 0.0, z: 0.0}, rotation: quat_identity(), scale: vec3_one()})
    return 28 if skeleton_add(&chain, 4, transform_identity()) or not skeleton_valid(&chain)
    chain_pose: mutable Pose = catch pose_evaluate(&chain):
        value: value
        error failure: return 29
    return 30 if not pose_valid(&chain_pose) or pose_joint_count(&chain_pose) != 3
    end: Transform = catch pose_model(&chain_pose, 2):
        value: value
        error failure: return 31
    return 32 if not near(end.position.x, 2.0)
    return 33 if not near(pose_root_position(&chain_pose).x, 0.0)
    shifted: mutable Skeleton = Skeleton()
    _ = skeleton_add(&shifted, -1, Transform{position: Vec3{x: 0.4, y: 0.0, z: 0.0}, rotation: quat_identity(), scale: vec3_one()})
    shifted_pose: Pose = catch pose_evaluate(&shifted):
        value: value
        error failure: return 34
    return 35 if not near(pose_root_motion(&chain_pose, &shifted_pose).x, 0.4)

    # Blending a pose with itself must reproduce it; the matrix payload marks
    # successful submission and an out-of-range joint is an explicit error.
    blended: Pose = catch pose_blend(&chain_pose, &chain_pose, 0.5):
        value: value
        error failure: return 36
    blended_end: Transform = catch pose_model(&blended, 2):
        value: value
        error failure: return 37
    return 38 if not near(blended_end.position.x, 2.0)
    matrix: f32[16] = catch pose_matrix(&chain_pose, 0):
        value: value
        error failure: return 39
    return 40 if matrix[15] != 1.0 or not near(matrix[12], 0.0)
    oob: i32 = catch pose_matrix(&chain_pose, 9):
        value: 0
        PoseError.JointOutOfBounds: 1
        error failure: 2
    return 41 if oob != 1

    # IK correction over the chain writes the solved knee into the render pose.
    corrected: bool = catch pose_correct_two_bone(&chain_pose, 0, Vec3{x: 1.0, y: 0.0, z: 0.0}, 1.0, 1.0, bend):
        value: value
        error failure: false
    return 42 if not corrected
    return 43 if not near(chain_pose.models[1].position.z, 0.866)
    return 44 if not near(chain_pose.models[2].position.x, 1.0) or not pose_valid(&chain_pose)
    0
