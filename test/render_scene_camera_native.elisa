module RenderSceneCameraNativeTests:
    private:
        @callconv(c)
        extern elisa_render_scene_v1_test_camera_perspective_matches(width: f32, height: f32,
            fov: f32, near_clip: f32, far_clip: f32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_camera_orthographic_matches(width: f32, height: f32,
            vertical_size: f32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_camera_view_matches(eye_x: f32, eye_y: f32, eye_z: f32,
            target_x: f32, target_y: f32, target_z: f32, up_x: f32, up_y: f32, up_z: f32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_camera_render_target_matches(width: i32, height: i32,
            expected_live: i32) -> i32

        # Points the camera, then checks that Wicked shows the right-handed
        # view: the same eye and direction, with f × up on the frame's right.
        def looks_along(eye: Geometry::Vec3, target: Geometry::Vec3, up: Geometry::Vec3) -> bool:
            pointed: i32 = catch RenderScene::set_camera_look_at(eye, target, up):
                ok: 0
                error failure: 1
            pointed == 0 and elisa_render_scene_v1_test_camera_view_matches(eye.x, eye.y, eye.z,
                target.x, target.y, target.z, up.x, up.y, up.z) != 0

    public:
        def exercise() -> i32:
            camera_height: i32 = catch RenderScene::set_camera_orthographic_height(14.0):
                ok: 0
                error failure: 1
            return 121 if camera_height != 0
            bad_camera_height: i32 = catch RenderScene::set_camera_orthographic_height(0.0):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 122 if bad_camera_height != 1
            excessive_camera_height: i32 = catch RenderScene::set_camera_orthographic_height(1.0e30):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 123 if excessive_camera_height != 1

            perspective_camera: i32 = catch RenderScene::set_camera_perspective(1.0, 0.1, 500.0):
                ok: 0
                error failure: 1
            return 124 if perspective_camera != 0
            perspective_matches: bool = elisa_render_scene_v1_test_camera_perspective_matches(
                320.0, 200.0, 1.0, 0.1, 500.0) != 0
            return 125 if not perspective_matches
            bad_field_of_view: i32 = catch RenderScene::set_camera_perspective(0.0, 0.1, 500.0):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 126 if bad_field_of_view != 1
            bad_clip_range: i32 = catch RenderScene::set_camera_perspective(1.0, 2.0, 1.0):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 127 if bad_clip_range != 1

            perspective_resize: i32 = catch RenderScene::resize(640, 400):
                ok: 0
                error failure: 1
            perspective_resize_matches: bool = elisa_render_scene_v1_test_camera_perspective_matches(
                640.0, 400.0, 1.0, 0.1, 500.0) != 0
            return 128 if perspective_resize != 0 or not perspective_resize_matches
            restore_orthographic: i32 = catch RenderScene::set_camera_orthographic_height(14.0):
                ok: 0
                error failure: 1
            restore_viewport: i32 = catch RenderScene::resize(320, 200):
                ok: 0
                error failure: 1
            orthographic_restored: bool = elisa_render_scene_v1_test_camera_orthographic_matches(
                320.0, 200.0, 14.0) != 0
            return 129 if restore_orthographic != 0 or restore_viewport != 0 or not orthographic_restored

            bad_target: i32 = catch RenderScene::set_camera_render_target(0, 100, 0.0):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 132 if bad_target != 1
            target_status: i32 = catch RenderScene::set_camera_render_target(160, 100, 0.0):
                ok: 0
                error failure: 1
            return 133 if target_status != 0
            return 134 if Application::pump() != Application::PumpStatus.Running
            return 135 if elisa_render_scene_v1_test_camera_render_target_matches(160, 100, 1) != 1
            clear_target: i32 = catch RenderScene::clear_camera_render_target():
                ok: 0
                error failure: 1
            return 136 if clear_target != 0
            return 137 if elisa_render_scene_v1_test_camera_render_target_matches(160, 100, 0) != 1

            # Every component of this look-at is asymmetric, so an unreflected
            # camera would show a different eye, direction or right side.
            tilted: bool = looks_along(Geometry::Vec3{x: 3.0, y: 10.0, z: 8.0},
                Geometry::Vec3{x: 1.0, y: 0.0, z: -2.0}, Geometry::Vec3{x: 0.3, y: 1.0, z: 0.2})
            return 130 if not tilted
            # The smoke camera again, which later groups read their frames from.
            restored: bool = looks_along(Geometry::Vec3{x: 0.0, y: 10.0, z: 8.0},
                Geometry::Vec3{x: 0.0, y: 0.0, z: 0.0}, Geometry::Vec3{x: 0.0, y: 1.0, z: 0.0})
            return 131 if not restored

            invalid_view: i32 = catch RenderScene::create_camera(RenderScene::CameraProjection.Perspective,
                320, 200, 0.0, 0.1, 300.0):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 138 if invalid_view != 1
            secondary: RenderScene::CameraHandle = catch RenderScene::create_camera(
                RenderScene::CameraProjection.Perspective, 640, 400, 0.8, 0.2, 300.0):
                value: value
                error failure: return 139
            activate_secondary: i32 = catch RenderScene::activate_camera(secondary):
                ok: 0
                error failure: 1
            return 140 if activate_secondary != 0 or elisa_render_scene_v1_test_camera_perspective_matches(
                640.0, 400.0, 0.8, 0.2, 300.0) != 1
            update_secondary: i32 = catch RenderScene::update_camera(secondary,
                RenderScene::CameraProjection.Orthographic, 200, 100, 8.0, 0.2, 300.0):
                ok: 0
                error failure: 1
            return 141 if update_secondary != 0 or elisa_render_scene_v1_test_camera_orthographic_matches(
                200.0, 100.0, 8.0) != 1
            reject_active_destroy: i32 = catch RenderScene::destroy_camera(secondary):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 142 if reject_active_destroy != 1
            restore_default: i32 = catch RenderScene::activate_default_camera():
                ok: 0
                error failure: 1
            return 143 if restore_default != 0 or elisa_render_scene_v1_test_camera_orthographic_matches(
                320.0, 200.0, 14.0) != 1
            destroy_secondary: i32 = catch RenderScene::destroy_camera(secondary):
                ok: 0
                error failure: 1
            return 144 if destroy_secondary != 0
            stale_activate: i32 = catch RenderScene::activate_camera(secondary):
                ok: 0
                RenderScene::RenderSceneError.UnknownHandle: 1
                error failure: 2
            return 145 if stale_activate != 1
            0
