# End-to-end application lifecycle smoke: the generated executable entry is
# Elisa main; it imports only the public engine module and owns the loop calls.
include "../src/backend/capabilities.elisa"
using Capabilities

def check_native_profile() -> i32:
    profile: BackendProfile = catch Application::backend_profile():
        value: value
        error failure: return 17
    return 18 if profile.kind != BackendKind.Native
    return 19 if not backend_supports(profile, BackendFeature.Input)
    return 20 if not backend_supports(profile, BackendFeature.Rendering)
    return 21 if not backend_supports(profile, BackendFeature.NativeWindow)
    return 22 if backend_supports(profile, BackendFeature.Physics) or backend_supports(profile, BackendFeature.Audio)
    return 23 if not backend_limit_supports(profile, BackendLimit.Viewports, 1)
    return 24 if profile.limits.memory_usage_bytes > profile.limits.memory_budget_bytes
    0

def check_startup_requirements(config: Application::Config) -> i32:
    required: BackendFeature[Capabilities::MAX_BACKEND_FEATURE_REQUIREMENTS] = [
        BackendFeature.Input, BackendFeature.Rendering, BackendFeature.NativeWindow,
        BackendFeature.Input, BackendFeature.Input, BackendFeature.Input,
        BackendFeature.Input, BackendFeature.Input,
    ]
    no_fallbacks: BackendCapabilities = BackendCapabilities{
        input: false, rendering: false, physics: false, audio: false,
        native_window: false, async_upload: false, callbacks: false, asset_loading: false,
    }
    report: mutable BackendRequirementReport = BackendRequirementReport{
        state: RequirementState.Invalid,
        first_missing: BackendFeature.Input,
        missing_count: 0,
        fallback_count: 0,
    }
    opened: Application::InitializeStatus = Application::initialize_with_requirements(
        config, required, 3, no_fallbacks, false, &report)
    return 27 if opened != Application::InitializeStatus.Ready
    return 28 if report.state != RequirementState.Ready or report.missing_count != 0
    return 29 if not Application::shutdown()

    missing_physics: BackendFeature[Capabilities::MAX_BACKEND_FEATURE_REQUIREMENTS] = [
        BackendFeature.Physics, BackendFeature.Input, BackendFeature.Input,
        BackendFeature.Input, BackendFeature.Input, BackendFeature.Input,
        BackendFeature.Input, BackendFeature.Input,
    ]
    rejected: Application::InitializeStatus = Application::initialize_with_requirements(
        config, missing_physics, 1, no_fallbacks, false, &report)
    return 30 if rejected != Application::InitializeStatus.RequirementsUnavailable
    return 31 if report.state != RequirementState.Unavailable or report.first_missing != BackendFeature.Physics or report.missing_count != 1
    closed_profile: i32 = catch Application::backend_profile():
        value: 1
        Application::BackendProfileError.NotInitialized: 0
        error failure: 2
    return 32 if closed_profile != 0

    audio_required: BackendFeature[Capabilities::MAX_BACKEND_FEATURE_REQUIREMENTS] = [
        BackendFeature.Audio, BackendFeature.Input, BackendFeature.Input,
        BackendFeature.Input, BackendFeature.Input, BackendFeature.Input,
        BackendFeature.Input, BackendFeature.Input,
    ]
    silent_audio_fallback: BackendCapabilities = BackendCapabilities{
        input: false, rendering: false, physics: false, audio: true,
        native_window: false, async_upload: false, callbacks: false, asset_loading: false,
    }
    fallback_status: Application::InitializeStatus = Application::initialize_with_requirements(
        config, audio_required, 1, silent_audio_fallback, true, &report)
    return 33 if fallback_status != Application::InitializeStatus.FallbackRequired
    return 34 if report.state != RequirementState.Fallback or report.fallback_count != 1
    return 35 if not Application::shutdown()

    invalid_count: Application::InitializeStatus = Application::initialize_with_requirements(
        config, required, Capabilities::MAX_BACKEND_FEATURE_REQUIREMENTS + 1,
        no_fallbacks, false, &report)
    return 36 if invalid_count != Application::InitializeStatus.InvalidRequirements
    return 37 if report.state != RequirementState.Invalid
    invalid_profile: i32 = catch Application::backend_profile():
        value: 1
        Application::BackendProfileError.NotInitialized: 0
        error failure: 2
    return 38 if invalid_profile != 0
    0

def main() -> i32:
    config: Application::Config = Application::default_config()
    opened: Application::InitializeStatus = Application::initialize(config)
    return 1 if opened != Application::InitializeStatus.Ready

    return 26 if check_native_profile() != 0

    first_frame: Application::PumpStatus = Application::pump()
    return 2 if first_frame != Application::PumpStatus.Running
    return 3 if Application::frame_count() != 1
    info: mutable Application::FrameInfo = zeroed
    return 9 if not Application::frame_info(&info)
    return 11 if info.frame_count != 1 or info.elapsed_nanos == 0 or Application::elapsed_seconds(info) <= 0.0
    return 12 if info.logical_width != 320 or info.logical_height != 200 or info.pixel_width <= 0 or info.pixel_height <= 0 or info.display_scale <= 0.0
    return 4 if not Application::request_exit()
    exit_state: Application::PumpStatus = Application::pump()
    return 5 if exit_state != Application::PumpStatus.ExitRequested
    return 13 if not Application::frame_info(&info)
    return 14 if not Application::saw_close_request(info) or not Application::is_close_requested(info) or info.frame_count != 1
    return 15 if not Application::frame_info(&info)
    return 16 if Application::saw_close_request(info) or not Application::is_close_requested(info)
    return 6 if not Application::shutdown()
    return 7 if Application::pump() != Application::PumpStatus.NotRunning
    return 8 if Application::frame_count() != 1
    closed_profile: i32 = catch Application::backend_profile():
        value: 1
        Application::BackendProfileError.NotInitialized: 0
        error failure: 2
    return 25 if closed_profile != 0
    return 33 if check_startup_requirements(config) != 0
    0
