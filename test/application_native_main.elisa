# End-to-end application lifecycle smoke: the generated executable entry is
# Elisa main; it imports only the public engine module and owns the loop calls.
# The generic application builder injects src/runtime/public.elisa before this
# entry point, so this smoke exercises the same import surface as a game.
include "./physics_app_probe.elisa"
include "./runtime_services_probe.elisa"
include "./user_data_probe.elisa"
using Capabilities

module NativeApplicationTestProbe:
    public:
        @callconv(c)
        extern elisa_physics_v1_test_fail_next_initialize_after_scene() -> i32

        @callconv(c)
        extern elisa_physics_v1_test_is_clean() -> i32

        @callconv(c)
        extern elisa_audio_v1_test_fail_next_initialize_after_open() -> i32

def check_native_profile() -> i32:
    profile: BackendProfile = catch Application::backend_profile():
        value: value
        error failure: return 17
    return 18 if profile.kind != BackendKind.Native
    return 19 if not backend_supports(profile, BackendFeature.Input)
    return 20 if not backend_supports(profile, BackendFeature.Rendering)
    return 21 if not backend_supports(profile, BackendFeature.NativeWindow)
    return 22 if backend_supports(profile, BackendFeature.Physics) or backend_supports(profile, BackendFeature.Audio)
    return 23 if not backend_limit_supports(profile, BackendLimit.Viewports, 1)
    return 24 if profile.limits.memory_usage_bytes > profile.limits.memory_budget_bytes
    0

def exercise_silent_audio() -> i32 error[AudioRuntime::AudioError]:
    raise AudioRuntime::AudioError.UnknownStatus if not AudioRuntime::clip_is_empty(AudioRuntime::empty_clip())
    raise AudioRuntime::AudioError.UnknownStatus if not AudioRuntime::voice_is_empty(AudioRuntime::empty_voice())
    try AudioRuntime::initialize_silent(8000, 1)
    try AudioRuntime::set_bus_gain(AudioRuntime::Bus.Effects, 0.75)
    empty_clip_result: i32 = catch AudioRuntime::play(AudioRuntime::empty_clip(),
        false, AudioRuntime::Bus.Effects, 1.0, 1):
        value: 0
        AudioRuntime::AudioError.InvalidHandle: 1
        error failure: 2
    raise AudioRuntime::AudioError.UnknownStatus if empty_clip_result != 1
    empty_voice_result: i32 = catch AudioRuntime::stop(AudioRuntime::empty_voice()):
        ok: 0
        AudioRuntime::AudioError.InvalidHandle: 1
        error failure: 2
    raise AudioRuntime::AudioError.UnknownStatus if empty_voice_result != 1
    clip: AudioRuntime::ClipHandle = try AudioRuntime::decode_file("test/fixtures/audio-smoke.wav")
    raise AudioRuntime::AudioError.UnknownStatus if AudioRuntime::clip_is_empty(clip)
    voice: AudioRuntime::VoiceHandle = try AudioRuntime::play(
        clip, true, AudioRuntime::Bus.Effects, 1.0, 1)
    count: usize = try AudioRuntime::active_voice_count()
    raise AudioRuntime::AudioError.UnknownStatus if count != 1
    try AudioRuntime::stop(voice)
    0

def exercise_jolt_physics(world: mutable PhysicsRuntime::World&, stage: mutable i32&) -> i32 error[PhysicsRuntime::PhysicsError]:
    stage <- 1
    ground: PhysicsRuntime::BodyHandle = try PhysicsRuntime::body_create(world,
        PhysicsRuntime::BodyDesc{
            kind: PhysicsRuntime::BodyKind.Static,
            position: Geometry::Vec3{x: 0.0, y: -0.5, z: 0.0},
            half_extents: Geometry::Vec3{x: 5.0, y: 0.5, z: 5.0},
            mass: 0.0,
            sensor: false,
        })
    stage <- 2
    falling: PhysicsRuntime::BodyHandle = try PhysicsRuntime::body_create(world,
        PhysicsRuntime::BodyDesc{
            kind: PhysicsRuntime::BodyKind.Dynamic,
            position: Geometry::Vec3{x: 0.0, y: 2.0, z: 0.0},
            half_extents: Geometry::Vec3{x: 0.5, y: 0.5, z: 0.5},
            mass: 1.0,
            sensor: false,
        })
    stage <- 3
    trigger: PhysicsRuntime::BodyHandle = try PhysicsRuntime::body_create(world,
        PhysicsRuntime::BodyDesc{
            kind: PhysicsRuntime::BodyKind.Static,
            position: Geometry::Vec3{x: 0.0, y: 1.0, z: 0.0},
            half_extents: Geometry::Vec3{x: 1.0, y: 0.75, z: 1.0},
            mass: 0.0,
            sensor: true,
        })
    stage <- 4
    disposable: PhysicsRuntime::BodyHandle = try PhysicsRuntime::body_create(world,
        PhysicsRuntime::BodyDesc{
            kind: PhysicsRuntime::BodyKind.Kinematic,
            position: Geometry::Vec3{x: 3.0, y: 2.0, z: 0.0},
            half_extents: Geometry::Vec3{x: 0.5, y: 0.5, z: 0.5},
            mass: 0.0,
            sensor: false,
        })
    stage <- 5
    target: Geometry::Transform = Geometry::Transform{
        position: Geometry::Vec3{x: 3.0, y: 4.0, z: 0.0},
        rotation: Geometry::quat_identity(),
        scale: Geometry::vec3_one(),
    }
    try PhysicsRuntime::body_set_kinematic_target(world, disposable, target)
    target_position: Geometry::Vec3 = try PhysicsRuntime::body_position(world, disposable)
    raise PhysicsRuntime::PhysicsError.BackendFailure if target_position.y < 3.9
    invalid_target: i32 = catch PhysicsRuntime::body_set_kinematic_target(world, falling, target):
        value: 1
        PhysicsRuntime::PhysicsError.InvalidArgument: 0
        error failure: 2
    raise PhysicsRuntime::PhysicsError.BackendFailure if invalid_target != 0
    try PhysicsRuntime::body_destroy(world, disposable)
    stage <- 6
    stale_body_status: i32 = catch PhysicsRuntime::body_position(world, disposable):
        value: 1
        PhysicsRuntime::PhysicsError.InvalidHandle: 0
        PhysicsRuntime::PhysicsError.InvalidArgument: 11
        PhysicsRuntime::PhysicsError.ApplicationUnavailable: 12
        PhysicsRuntime::PhysicsError.WrongThread: 13
        PhysicsRuntime::PhysicsError.Capacity: 14
        PhysicsRuntime::PhysicsError.StaleWorld: 16
        PhysicsRuntime::PhysicsError.BackendFailure: 17
        error failure: 18
    stage <- 50 + stale_body_status
    raise PhysicsRuntime::PhysicsError.BackendFailure if stale_body_status != 0
    stage <- 6
    initial_position: Geometry::Vec3 = try PhysicsRuntime::body_position(world, falling)
    tick: mutable u64 = 0
    stage <- 7
    tick <- try PhysicsAppProbe::fixed_step_pair(world)
    raise PhysicsRuntime::PhysicsError.BackendFailure if tick != PhysicsAppProbe::PAIR_TICK_COUNT
    stage <- 8
    tick <- try PhysicsRuntime::fixed_step(world, PhysicsAppProbe::FIXED_STEP_SECONDS)
    stage <- 9
    tick <- try PhysicsRuntime::fixed_step(world, PhysicsAppProbe::FIXED_STEP_SECONDS)
    stage <- 10
    tick <- try PhysicsRuntime::fixed_step(world, PhysicsAppProbe::FIXED_STEP_SECONDS)
    stage <- 11
    tick <- try PhysicsRuntime::fixed_step(world, PhysicsAppProbe::FIXED_STEP_SECONDS)
    stage <- 12
    tick <- try PhysicsRuntime::fixed_step(world, PhysicsAppProbe::FIXED_STEP_SECONDS)
    stage <- 13
    tick <- try PhysicsRuntime::fixed_step(world, PhysicsAppProbe::FIXED_STEP_SECONDS)
    stage <- 14
    final_position: Geometry::Vec3 = try PhysicsRuntime::body_position(world, falling)
    contact_buffer: mutable PhysicsRuntime::ContactBuffer = zeroed
    dropped_contacts: mutable u32 = 0
    contact_count: usize = try PhysicsRuntime::poll_contacts(world, &contact_buffer,
        &dropped_contacts)
    saw_added: mutable bool = false
    saw_trigger: mutable bool = false
    for index in 0..<contact_count:
        event: PhysicsRuntime::ContactEvent = contact_buffer.events[index]
        if event.kind == PhysicsRuntime::ContactKind.Added:
            saw_trigger <- true if event.trigger
            saw_added <- true if not event.trigger
    raise PhysicsRuntime::PhysicsError.BackendFailure if contact_count == 0 or not saw_added or not saw_trigger or dropped_contacts != 0
    stage <- 15
    try PhysicsRuntime::body_destroy(world, trigger)
    tick <- try PhysicsRuntime::fixed_step(world, PhysicsAppProbe::FIXED_STEP_SECONDS)
    removed_buffer: mutable PhysicsRuntime::ContactBuffer = zeroed
    removed_dropped: mutable u32 = 0
    removed_count: usize = try PhysicsRuntime::poll_contacts(world, &removed_buffer,
        &removed_dropped)
    saw_removed_trigger: mutable bool = false
    for index in 0..<removed_count:
        event: PhysicsRuntime::ContactEvent = removed_buffer.events[index]
        saw_removed_trigger <- true if event.kind == PhysicsRuntime::ContactKind.Removed and event.trigger
    raise PhysicsRuntime::PhysicsError.BackendFailure if not saw_removed_trigger or removed_dropped != 0
    stage <- 16
    raise PhysicsRuntime::PhysicsError.BackendFailure if tick != 9 or final_position.y >= initial_position.y - 0.05
    stage <- 17
    raise PhysicsRuntime::PhysicsError.BackendFailure if PhysicsRuntime::committed_tick(world) != 9
    _ = ground
    0

def check_startup_requirements(config: Application::Config) -> i32:
    required: BackendFeature[Capabilities::MAX_BACKEND_FEATURE_REQUIREMENTS] = [
        BackendFeature.Input, BackendFeature.Rendering, BackendFeature.NativeWindow,
        BackendFeature.Input, BackendFeature.Input, BackendFeature.Input,
        BackendFeature.Input, BackendFeature.Input,
    ]
    no_fallbacks: BackendFallbackProviders = Capabilities::no_backend_fallback_providers()
    report: mutable BackendRequirementReport = Capabilities::backend_requirement_invalid_report()
    profile_requirements: BackendRequirements::BackendStartupRequirements = BackendRequirements::BackendStartupRequirements{
        services: required,
        service_count: 3,
        service_fallbacks: no_fallbacks,
        allow_service_fallbacks: false,
        optional_features: [BackendOptionalFeature.RayTracing, BackendOptionalFeature.RayTracing, BackendOptionalFeature.RayTracing],
        optional_feature_count: 0,
        optional_fallbacks: BackendOptionalCapabilities{ray_tracing: false, sparse_textures: false, mesh_shaders: false},
        allow_optional_fallbacks: false,
        limits: [
            BackendRequirements::BackendLimitRequirement{limit: BackendLimit.Viewports, preferred: 1, minimum: 1},
            BackendRequirements::BackendLimitRequirement{limit: BackendLimit.Viewports, preferred: 1, minimum: 1},
            BackendRequirements::BackendLimitRequirement{limit: BackendLimit.Viewports, preferred: 1, minimum: 1},
            BackendRequirements::BackendLimitRequirement{limit: BackendLimit.Viewports, preferred: 1, minimum: 1},
            BackendRequirements::BackendLimitRequirement{limit: BackendLimit.Viewports, preferred: 1, minimum: 1},
            BackendRequirements::BackendLimitRequirement{limit: BackendLimit.Viewports, preferred: 1, minimum: 1},
            BackendRequirements::BackendLimitRequirement{limit: BackendLimit.Viewports, preferred: 1, minimum: 1},
            BackendRequirements::BackendLimitRequirement{limit: BackendLimit.Viewports, preferred: 1, minimum: 1},
        ],
        limit_count: 1,
        textures: [
            BackendRequirements::BackendTextureRequirement{requested: BackendTextureFormat.Rgba8, normal_map: false, has_alpha: false, allow_fallback: false},
            BackendRequirements::BackendTextureRequirement{requested: BackendTextureFormat.Rgba8, normal_map: false, has_alpha: false, allow_fallback: false},
            BackendRequirements::BackendTextureRequirement{requested: BackendTextureFormat.Rgba8, normal_map: false, has_alpha: false, allow_fallback: false},
            BackendRequirements::BackendTextureRequirement{requested: BackendTextureFormat.Rgba8, normal_map: false, has_alpha: false, allow_fallback: false},
            BackendRequirements::BackendTextureRequirement{requested: BackendTextureFormat.Rgba8, normal_map: false, has_alpha: false, allow_fallback: false},
            BackendRequirements::BackendTextureRequirement{requested: BackendTextureFormat.Rgba8, normal_map: false, has_alpha: false, allow_fallback: false},
            BackendRequirements::BackendTextureRequirement{requested: BackendTextureFormat.Rgba8, normal_map: false, has_alpha: false, allow_fallback: false},
            BackendRequirements::BackendTextureRequirement{requested: BackendTextureFormat.Rgba8, normal_map: false, has_alpha: false, allow_fallback: false},
        ],
        texture_count: 1,
    }
    profile_report: mutable BackendRequirements::BackendRequirementsReport = zeroed
    profile_opened: Application::InitializeStatus = Application::initialize_with_profile_requirements(
        config, profile_requirements, &profile_report)
    return 39 if profile_opened != Application::InitializeStatus.Ready
    return 40 if profile_report.state != RequirementState.Ready
    return 41 if profile_report.limits.granted[0] <= 0
    return 42 if profile_report.textures.decisions[0].format != BackendTextureFormat.Rgba8
    return 43 if not Application::shutdown()

    fallback_requirements: mutable BackendRequirements::BackendStartupRequirements = profile_requirements
    fallback_requirements.textures[0] <- BackendRequirements::BackendTextureRequirement{
        requested: BackendTextureFormat.Bc1,
        normal_map: true,
        has_alpha: false,
        allow_fallback: true,
    }
    fallback_report: mutable BackendRequirements::BackendRequirementsReport = zeroed
    fallback_opened: Application::InitializeStatus = Application::initialize_with_profile_requirements(
        config, fallback_requirements, &fallback_report)
    return 87 if fallback_opened != Application::InitializeStatus.FallbackRequired
    return 88 if fallback_report.state != RequirementState.Fallback or fallback_report.textures.state != RequirementState.Fallback
    return 89 if fallback_report.textures.fallback_count != 1
    return 90 if fallback_report.textures.decisions[0].state != RequirementState.Fallback or fallback_report.textures.decisions[0].format != BackendTextureFormat.Rgba8
    fallback_profile: BackendProfile = catch Application::backend_profile():
        value: value
        error failure: return 91
    return 92 if fallback_profile.kind != BackendKind.Native
    return 93 if not Application::shutdown()

    opened: Application::InitializeStatus = Application::initialize_with_requirements(
        config, required, 3, no_fallbacks, false, &report)
    return 27 if opened != Application::InitializeStatus.Ready
    return 28 if report.state != RequirementState.Ready or report.missing_count != 0
    return 103 if report.decision_count != 3 or report.decisions[0].feature != BackendFeature.Input or report.decisions[0].resolution != BackendFeatureResolution.Native
    return 29 if not Application::shutdown()

    missing_physics: BackendFeature[Capabilities::MAX_BACKEND_FEATURE_REQUIREMENTS] = [
        BackendFeature.Physics, BackendFeature.Input, BackendFeature.Input,
        BackendFeature.Input, BackendFeature.Input, BackendFeature.Input,
        BackendFeature.Input, BackendFeature.Input,
    ]
    rejected: Application::InitializeStatus = Application::initialize_with_requirements(
        config, missing_physics, 1, no_fallbacks, false, &report)
    return 30 if rejected != Application::InitializeStatus.RequirementsUnavailable
    return 31 if report.state != RequirementState.Unavailable or report.first_missing != BackendFeature.Physics or report.missing_count != 1
    return 104 if report.decisions[0].feature != BackendFeature.Physics or report.decisions[0].resolution != BackendFeatureResolution.Unavailable
    closed_profile: i32 = catch Application::backend_profile():
        value: 1
        Application::BackendProfileError.NotInitialized: 0
        error failure: 2
    return 32 if closed_profile != 0

    physics_profile_fallbacks: BackendFallbackProviders = BackendFallbackProviders{
        input: BackendFallbackProvider.None,
        rendering: BackendFallbackProvider.None,
        physics: BackendFallbackProvider.JoltPhysics,
        audio: BackendFallbackProvider.None,
        native_window: BackendFallbackProvider.None,
        async_upload: BackendFallbackProvider.None,
        callbacks: BackendFallbackProvider.None,
        asset_loading: BackendFallbackProvider.None,
    }
    physics_profile_requirements: mutable BackendRequirements::BackendStartupRequirements = profile_requirements
    physics_profile_requirements.services[3] <- BackendFeature.Physics
    physics_profile_requirements.service_count <- 4
    physics_profile_requirements.service_fallbacks <- physics_profile_fallbacks
    physics_profile_requirements.allow_service_fallbacks <- true
    probe_host: Application::InitializeStatus = Application::initialize(config)
    return 157 if probe_host != Application::InitializeStatus.Ready
    return 158 if NativeApplicationTestProbe::elisa_physics_v1_test_fail_next_initialize_after_scene() != 0
    return 159 if not Application::shutdown()
    physics_probe_report: mutable BackendRequirements::BackendRequirementsReport = zeroed
    physics_probe_status: Application::InitializeStatus = Application::initialize_with_profile_requirements(
        config, physics_profile_requirements, &physics_probe_report)
    return 160 if physics_probe_status != Application::InitializeStatus.RequirementsUnavailable
    return 161 if physics_probe_report.state != RequirementState.Unavailable
    return 162 if physics_probe_report.services.decisions[3].resolution != BackendFeatureResolution.ProviderUnavailable
    return 163 if physics_probe_report.services.decisions[3].fallback_provider != BackendFallbackProvider.JoltPhysics

    physics_fallback: BackendFallbackProviders = BackendFallbackProviders{
        input: BackendFallbackProvider.None,
        rendering: BackendFallbackProvider.None,
        physics: BackendFallbackProvider.JoltPhysics,
        audio: BackendFallbackProvider.None,
        native_window: BackendFallbackProvider.None,
        async_upload: BackendFallbackProvider.None,
        callbacks: BackendFallbackProvider.None,
        asset_loading: BackendFallbackProvider.None,
    }
    physics_fallback_status: Application::InitializeStatus = Application::initialize_with_requirements(
        config, missing_physics, 1, physics_fallback, true, &report)
    return 97 if physics_fallback_status != Application::InitializeStatus.FallbackRequired
    return 105 if report.decisions[0].feature != BackendFeature.Physics or report.decisions[0].resolution != BackendFeatureResolution.DeclaredFallback

    return 145 if NativeApplicationTestProbe::elisa_physics_v1_test_fail_next_initialize_after_scene() != 0
    failed_physics_init: i32 = catch PhysicsRuntime::World():
        value: 0
        PhysicsRuntime::PhysicsError.BackendFailure: 1
        error failure: 2
    return 146 if failed_physics_init != 1
    return 147 if NativeApplicationTestProbe::elisa_physics_v1_test_is_clean() != 1
    return 148 if check_native_profile() != 0
    return 149 if not Application::shutdown()
    closed_after_physics_failure: i32 = catch Application::backend_profile():
        value: 1
        Application::BackendProfileError.NotInitialized: 0
        error failure: 2
    return 150 if closed_after_physics_failure != 0
    physics_retry_status: Application::InitializeStatus = Application::initialize_with_requirements(
        config, missing_physics, 1, physics_fallback, true, &report)
    return 151 if physics_retry_status != Application::InitializeStatus.FallbackRequired
    return 152 if report.decision_count != 1 or report.decisions[0].fallback_provider != BackendFallbackProvider.JoltPhysics
    physics_world: mutable PhysicsRuntime::World = catch PhysicsRuntime::World():
        value: value
        error failure: return 98
    physics_stage: mutable i32 = 0
    physics_result: i32 = catch exercise_jolt_physics(&physics_world, &physics_stage):
        value: value
        PhysicsRuntime::PhysicsError.InvalidArgument: 111 + physics_stage
        PhysicsRuntime::PhysicsError.ApplicationUnavailable: 121 + physics_stage
        PhysicsRuntime::PhysicsError.WrongThread: 131 + physics_stage
        PhysicsRuntime::PhysicsError.Capacity: 141 + physics_stage
        PhysicsRuntime::PhysicsError.InvalidHandle: 151 + physics_stage
        PhysicsRuntime::PhysicsError.StaleWorld: 161 + physics_stage
        PhysicsRuntime::PhysicsError.BackendFailure: 171 + physics_stage
        error failure: 118
    physics_shutdown_ok: bool = Application::shutdown()
    return physics_result if physics_result != 0
    return 101 if not physics_shutdown_ok
    closed_physics_status: i32 = catch PhysicsRuntime::fixed_step(&physics_world,
        PhysicsAppProbe::FIXED_STEP_SECONDS):
        value: 1
        PhysicsRuntime::PhysicsError.ApplicationUnavailable: 0
        error failure: 2
    return 102 if closed_physics_status != 0

    audio_required: BackendFeature[Capabilities::MAX_BACKEND_FEATURE_REQUIREMENTS] = [
        BackendFeature.Audio, BackendFeature.Input, BackendFeature.Input,
        BackendFeature.Input, BackendFeature.Input, BackendFeature.Input,
        BackendFeature.Input, BackendFeature.Input,
    ]
    silent_audio_fallback: BackendFallbackProviders = BackendFallbackProviders{
        input: BackendFallbackProvider.None,
        rendering: BackendFallbackProvider.None,
        physics: BackendFallbackProvider.None,
        audio: BackendFallbackProvider.MiniaudioSilent,
        native_window: BackendFallbackProvider.None,
        async_upload: BackendFallbackProvider.None,
        callbacks: BackendFallbackProvider.None,
        asset_loading: BackendFallbackProvider.None,
    }
    fallback_status: mutable Application::InitializeStatus = Application::initialize_with_requirements(
        config, audio_required, 1, silent_audio_fallback, true, &report)
    if fallback_status != Application::InitializeStatus.FallbackRequired:
        _ = Application::shutdown()
        return 130 if fallback_status == Application::InitializeStatus.Ready
        return 131 if fallback_status == Application::InitializeStatus.RequirementsUnavailable
        return 132 if fallback_status == Application::InitializeStatus.InvalidRequirements
        return 133 if fallback_status == Application::InitializeStatus.InvalidArgument
        return 134 if fallback_status == Application::InitializeStatus.AlreadyRunning
        return 135 if fallback_status == Application::InitializeStatus.UnsupportedAbi
        return 136 if fallback_status == Application::InitializeStatus.BackendUnavailable
        return 137 if fallback_status == Application::InitializeStatus.ShutdownFailed
        return 138
    return 34 if report.state != RequirementState.Fallback or report.fallback_count != 1
    return 106 if report.decisions[0].feature != BackendFeature.Audio or report.decisions[0].resolution != BackendFeatureResolution.DeclaredFallback
    return 139 if report.decisions[0].fallback_provider != BackendFallbackProvider.MiniaudioSilent
    return 164 if NativeApplicationTestProbe::elisa_audio_v1_test_fail_next_initialize_after_open() != 0
    return 165 if not Application::shutdown()
    unavailable_audio_status: Application::InitializeStatus = Application::initialize_with_requirements(
        config, audio_required, 1, silent_audio_fallback, true, &report)
    return 166 if unavailable_audio_status != Application::InitializeStatus.RequirementsUnavailable
    return 167 if report.state != RequirementState.Unavailable or report.missing_count != 1
    return 168 if report.decisions[0].resolution != BackendFeatureResolution.ProviderUnavailable
    return 169 if report.decisions[0].fallback_provider != BackendFallbackProvider.MiniaudioSilent
    fallback_status <- Application::initialize_with_requirements(
        config, audio_required, 1, silent_audio_fallback, true, &report)
    return 170 if fallback_status != Application::InitializeStatus.FallbackRequired
    failed_audio_init: i32 = catch AudioRuntime::initialize_silent(
        AudioRuntime::MIN_SAMPLE_RATE_HZ - 1, AudioRuntime::MIN_CHANNEL_COUNT):
        value: 0
        AudioRuntime::AudioError.InvalidArgument: 1
        error failure: 2
    return 140 if failed_audio_init != 1
    return 153 if NativeApplicationTestProbe::elisa_audio_v1_test_fail_next_initialize_after_open() != 0
    partial_audio_init: i32 = catch AudioRuntime::initialize_silent(
        AudioRuntime::MIN_SAMPLE_RATE_HZ, AudioRuntime::MIN_CHANNEL_COUNT):
        value: 0
        AudioRuntime::AudioError.DeviceUnavailable: 1
        error failure: 2
    return 154 if partial_audio_init != 1
    rolled_back_audio_status: i32 = catch AudioRuntime::active_voice_count():
        value: 1
        AudioRuntime::AudioError.ApplicationUnavailable: 0
        error failure: 2
    return 155 if rolled_back_audio_status != 0
    return 156 if check_native_profile() != 0
    return 141 if not Application::shutdown()
    failed_fallback_profile: i32 = catch Application::backend_profile():
        value: 1
        Application::BackendProfileError.NotInitialized: 0
        error failure: 2
    return 142 if failed_fallback_profile != 0
    fallback_retry: Application::InitializeStatus = Application::initialize_with_requirements(
        config, audio_required, 1, silent_audio_fallback, true, &report)
    return 143 if fallback_retry != Application::InitializeStatus.FallbackRequired
    return 144 if report.decision_count != 1 or report.decisions[0].fallback_provider != BackendFallbackProvider.MiniaudioSilent
    audio_fallback_result: i32 = catch exercise_silent_audio():
        value: value
        error failure: return 94
    return 95 if audio_fallback_result != 0
    return 35 if not Application::shutdown()
    closed_audio_status: i32 = catch AudioRuntime::active_voice_count():
        value: 1
        AudioRuntime::AudioError.ApplicationUnavailable: 0
        error failure: 2
    return 96 if closed_audio_status != 0

    invalid_count: Application::InitializeStatus = Application::initialize_with_requirements(
        config, required, Capabilities::MAX_BACKEND_FEATURE_REQUIREMENTS + 1,
        no_fallbacks, false, &report)
    return 36 if invalid_count != Application::InitializeStatus.InvalidRequirements
    return 37 if report.state != RequirementState.Invalid
    invalid_profile: i32 = catch Application::backend_profile():
        value: 1
        Application::BackendProfileError.NotInitialized: 0
        error failure: 2
    return 38 if invalid_profile != 0
    0

def exercise_application() -> i32:
    config: Application::Config = Application::default_config()
    opened: Application::InitializeStatus = Application::initialize(config)
    return 1 if opened != Application::InitializeStatus.Ready

    return 26 if check_native_profile() != 0

    first_frame: Application::PumpStatus = Application::pump()
    return 2 if first_frame != Application::PumpStatus.Running
    return 3 if Application::frame_count() != 1
    actions: mutable ActionInput::Input = ActionInput::Input()
    escape: ActionInput::Binding = ActionInput::Binding{
        action: 1,
        device: ActionInput::Device.Keyboard,
        code: Application::keyboard_key_code(Application::KeyboardKeyCode.Escape),
        chord_code: 0,
        deadzone: 0.0,
        context: ActionInput::Context.Gameplay,
        live: true,
    }
    return 44 if ActionInput::bind_checked(&actions, escape) != ActionInput::BindResult.Bound
    _ = ActionInputRuntime::begin_frame(&actions)
    return 45 if ActionInput::action_down(&actions, 1)
    info: mutable Application::FrameInfo = zeroed
    return 9 if not Application::frame_info(&info)
    return 11 if info.frame_count != 1 or info.elapsed_nanos == 0 or Application::elapsed_seconds(info) <= 0.0
    return 12 if info.logical_width != 320 or info.logical_height != 200 or info.pixel_width <= 0 or info.pixel_height <= 0 or info.display_scale <= 0.0
    return 4 if not Application::request_exit()
    exit_state: Application::PumpStatus = Application::pump()
    return 5 if exit_state != Application::PumpStatus.ExitRequested
    return 13 if not Application::frame_info(&info)
    return 14 if not Application::saw_close_request(info) or not Application::is_close_requested(info) or info.frame_count != 1
    return 15 if not Application::frame_info(&info)
    return 16 if Application::saw_close_request(info) or not Application::is_close_requested(info)
    return 6 if not Application::shutdown()
    return 7 if Application::pump() != Application::PumpStatus.NotRunning
    return 8 if Application::frame_count() != 1
    closed_profile: i32 = catch Application::backend_profile():
        value: 1
        Application::BackendProfileError.NotInitialized: 0
        error failure: 2
    return 25 if closed_profile != 0
    startup_status: i32 = check_startup_requirements(config)
    return startup_status if startup_status != 0
    services_status: i32 = RuntimeServicesProbe::run()
    return services_status if services_status != 0
    0

# The outer entry owns cleanup for every assertion path in the smoke body.
# This mirrors the host contract: returning early from game code still closes
# runtime services before the native process exits.
def main() -> i32:
    storage_result: i32 = exercise_user_data()
    return 104 + storage_result if storage_result != 0
    result: i32 = exercise_application()
    shutdown_ok: bool = Application::shutdown()
    return 103 if not shutdown_ok
    result
