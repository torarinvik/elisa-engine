include "../src/tooling/inspector.elisa"
include "../src/tooling/debug_geometry.elisa"
include "../src/ui/widgets.elisa"
using World
using Backend
using Geometry
using Assets
using DebugGeometry
using Inspector
using UiWidgets

def widgets_test() -> i32:
    surface: mutable Surface = Surface()
    button: Widget = Widget{id: 1, kind: WidgetKind.Button, x: 10, y: 10, width: 20, height: 20, value: 0, minimum: 0, maximum: 0, enabled: true, visible: true}
    slider: Widget = Widget{id: 2, kind: WidgetKind.Slider, x: 40, y: 10, width: 20, height: 20, value: 5, minimum: 0, maximum: 10, enabled: true, visible: true}
    added: i32 = catch add_widget(&surface, button):
        ok: 0
        WidgetError.Capacity: 1
        WidgetError.InvalidWidget: 2
        WidgetError.DuplicateId: 3
        error failure: 4
    return 22 if added != 0
    added_slider: i32 = catch add_widget(&surface, slider):
        ok: 0
        WidgetError.Capacity: 1
        WidgetError.InvalidWidget: 2
        WidgetError.DuplicateId: 3
        error failure: 4
    return 23 if added_slider != 0 or widget_count(&surface) != 2
    return 24 if hit_test(&surface, 15, 15) != 1 or hit_test(&surface, 100, 100) != -1
    updated: i32 = catch set_value(&surface, 2, 8):
        ok: 0
        WidgetError.UnknownWidget: 1
        WidgetError.Disabled: 2
        WidgetError.OutOfRange: 3
        error failure: 4
    return 25 if updated != 0
    disabled: i32 = catch set_enabled(&surface, 2, false):
        ok: 0
        WidgetError.UnknownWidget: 1
        error failure: 2
    return 26 if disabled != 0
    blocked: i32 = catch set_value(&surface, 2, 9):
        ok: 0
        WidgetError.UnknownWidget: 1
        WidgetError.Disabled: 2
        WidgetError.OutOfRange: 3
        error failure: 4
    return 27 if blocked != 2 or not surface_valid(&surface)
    0

def sample_visual() -> VisualAsset:
    VisualAsset{
        mesh: AssetId{high: 3, low: 1},
        material: AssetId{high: 3, low: 2},
        local_bounds: Bounds3{minimum: Vec3{x: -1.0, y: -1.0, z: -1.0}, maximum: Vec3{x: 1.0, y: 1.0, z: 1.0}},
    }

def main() -> i32:
    widgets: i32 = widgets_test()
    return widgets if widgets != 0
    budget: PerfBudget = default_budget()
    return 1 if not budget_valid(&budget) or budget.max_frame_micros != 16667
    counters: mutable PerfCounters = PerfCounters()
    return 2 if mean_frame_micros(&counters) != 0

    world: mutable World = catch World():
        value: value
        error failure: return 3
    object: EntityRef = catch world_spawn(&world, Actor.Player):
        value: value
        error failure: return 4
    recorder: mutable Backend::SceneRecorder = Backend::SceneRecorder()
    created: i32 = catch submit_create(&recorder, object, transform_identity(), sample_visual()):
        ok: 0
        error failure: 1
    return 5 if created != 0

    view: Snapshot = snapshot_from_world(&world, &recorder, 7, 1500, 0)
    return 6 if not snapshot_valid(&view) or view.live_entities != 1 or view.queued_commands != 1
    return 7 if view.tick != 7 or view.frame_micros != 1500
    return 8 if not snapshot_within_budget(&view, &budget)
    # Submitted bytes are a recorded workload: one command is the fixed size,
    # and the default byte budget covers the full command queue.
    return 15 if view.queued_bytes != 80 or recorder_submitted_bytes(&recorder) != 80
    return 16 if budget.max_queued_bytes != 20480

    tight: PerfBudget = PerfBudget{max_frame_micros: 16667, max_queued_commands: 256, max_queued_bytes: 40, max_live_entities: 256}
    return 17 if not budget_valid(&tight) or snapshot_within_budget(&view, &tight)

    slow: Snapshot = snapshot_from_world(&world, &recorder, 8, 20000, 0)
    return 9 if snapshot_within_budget(&slow, &budget)

    record_frame(&counters, 1500, false)
    record_frame(&counters, 20000, true)
    record_frame(&counters, 1000, false)
    return 10 if counters.frames != 3 or counters.over_budget != 1
    return 11 if mean_frame_micros(&counters) != 7500 or counters.worst_micros != 20000
    return 12 if counters.sample_count != 3

    samples: i64[16] = [1500, 20000, 1000, 1000, 1000, 1000, 1000, 1000, 1000, 1000, 1000, 1000, 1000, 1000, 1000, 1000]
    return 13 if worst_sample(samples, 3) != 20000 or frames_over_budget(samples, 3, 16667) != 1
    return 14 if worst_sample(samples, 0) != 0 or frames_over_budget(samples, 17, 16667) != 0

    # Debug collision geometry: cell boxes, kind counts, and the capacity guard
    # that refuses a full collection instead of dropping geometry silently.
    boxes: mutable Boxes = Boxes()
    return 15 if not boxes_add(&boxes, cell_box(BoxKind.Solid, 1.0, 2.0)) or boxes.count != 1
    solid_box: Box = boxes.entries[0]
    return 16 if solid_box.bounds.minimum.x < 0.699 or solid_box.bounds.minimum.x > 0.701
    return 17 if solid_box.bounds.maximum.x < 1.299 or solid_box.bounds.maximum.x > 1.301
    return 18 if not boxes_valid(&boxes) or box_kind_count(&boxes, BoxKind.Solid) != 1 or box_kind_count(&boxes, BoxKind.Goal) != 0
    return 19 if not boxes_add(&boxes, cell_box(BoxKind.Goal, 0.0, 0.0)) or box_kind_count(&boxes, BoxKind.Goal) != 1
    for index in 2..<box_capacity() |boxes|:
        _ = boxes_add(&boxes, cell_box(BoxKind.Hazard, 0.0, 0.0))
    return 20 if boxes.count != box_capacity() or not boxes_valid(&boxes)
    return 21 if boxes_add(&boxes, cell_box(BoxKind.Hazard, 0.0, 0.0)) or boxes.count != box_capacity()
    0
