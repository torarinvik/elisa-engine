# Native smoke coverage for the public presentation quality controls.
module RenderSceneQualitySettingsNativeTests:
    private:
        const module Limits:
            SETTLE_FRAME_COUNT: i32 = 3
            QUALITY_PROFILE_HIGH: u32 = 0
            QUALITY_PROFILE_MEDIUM: u32 = 1
            QUALITY_PROFILE_LOW: u32 = 2
            QUALITY_PROFILE_COUNT: u32 = 3
            QUALITY_COST_WARMUP_FRAME_COUNT: u32 = 10
            QUALITY_COST_SAMPLE_FRAME_COUNT: u32 = 21

        @callconv(c)
        extern elisa_render_scene_v1_test_postprocess_matches(tonemap: i32, exposure: f32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_ambient_occlusion_matches(range: f32, power: f32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_shadow_quality_matches(quality: i32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_quality_shadow_matches(
            quality: i32, receiver_bias: f32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_quality_profile_matches(
            tonemap: i32, render_scale: f32, bloom_threshold: f32,
            bloom: i32, fxaa: i32, temporal_aa: i32, ambient_occlusion: i32,
            screen_space_reflections: i32, fog: i32, depth_effects: i32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_temporal_history_resources(
            expected_scale: f32, expected_valid: i32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_quality_profile_cost(
            profile_id: u32, warmup_frames: u32, sample_count: u32) -> i32

        def capture_profile(profile: Quality::Profile&, variable: cstr,
            failure_code: i32) -> i32:
            applied: i32 = catch RenderScene::apply_quality_profile(profile):
                ok: 0
                error failure: return failure_code
            return failure_code + 1 if applied != 0
            for frame in 0..<Limits::SETTLE_FRAME_COUNT:
                return failure_code + 2 if Application::pump() != Application::PumpStatus.Running
            capture_path: cstr = Application::environment_value(variable)
            return failure_code + 3 if capture_path != "" and not Application::save_screenshot(capture_path)
            0

        def measure_profile_cost(profile: Quality::Profile&, profile_id: u32,
            failure_code: i32) -> i32:
            applied: i32 = catch RenderScene::apply_quality_profile(profile):
                ok: 0
                error failure: return failure_code
            return failure_code + 1 if applied != 0
            return failure_code + 2 if elisa_render_scene_v1_test_quality_profile_cost(
                profile_id, Limits::QUALITY_COST_WARMUP_FRAME_COUNT,
                Limits::QUALITY_COST_SAMPLE_FRAME_COUNT) != 0
            0

    public:
        def exercise() -> i32:
            tonemap_status: i32 = catch RenderScene::set_tonemap(RenderScene::Tonemap.Uchimura):
                ok: 0
                error failure: 1
            return 110 if tonemap_status != 0 or elisa_render_scene_v1_test_postprocess_matches(2, 1.0) != 1
            exposure_status: i32 = catch RenderScene::set_exposure(0.92):
                ok: 0
                error failure: 1
            return 111 if exposure_status != 0 or elisa_render_scene_v1_test_postprocess_matches(2, 0.92) != 1
            invalid_exposure: i32 = catch RenderScene::set_exposure(8.1):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 112 if invalid_exposure != 1
            ao_status: i32 = catch RenderScene::set_ambient_occlusion_settings(1.25, 0.78):
                ok: 0
                error failure: 1
            return 113 if ao_status != 0 or elisa_render_scene_v1_test_ambient_occlusion_matches(1.25, 0.78) != 1
            invalid_ao: i32 = catch RenderScene::set_ambient_occlusion_settings(0.0, 1.0):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 114 if invalid_ao != 1
            shadow_status: i32 = catch RenderScene::set_shadow_quality(Quality::ShadowQuality.High):
                ok: 0
                error failure: 1
            return 115 if shadow_status != 0 or elisa_render_scene_v1_test_shadow_quality_matches(2) != 1
            profile: mutable Quality::Profile = Quality::Profile()
            profile.tonemap <- Quality::Tonemap.Uchimura
            profile.upscaler <- Quality::Upscaler.None
            profile.render_scale <- 0.75
            profile.bloom_threshold <- 1.4
            profile.bloom <- true
            profile.fxaa <- true
            profile.temporal_aa <- true
            profile.ambient_occlusion <- true
            profile.screen_space_reflections <- true
            profile.fog <- false
            profile.depth_effects <- false
            profile.shadow_quality <- Quality::ShadowQuality.High
            profile.sun_shadow_receiver_bias <- 0.001
            profile_status: i32 = catch RenderScene::apply_quality_profile(&profile):
                ok: 0
                error failure: 1
            postprocess_matches: i32 = elisa_render_scene_v1_test_quality_profile_matches(
                2, 0.75, 1.4, 1, 1, 1, 1, 1, 0, 0)
            shadow_matches: i32 = elisa_render_scene_v1_test_quality_shadow_matches(2, 0.001)
            return 116 if profile_status != 0 or postprocess_matches != 1 or shadow_matches != 1
            profile.sun_shadow_receiver_bias <- 0.02
            invalid_shadow_bias: i32 = catch RenderScene::apply_quality_profile(&profile):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            shadow_unchanged: i32 = elisa_render_scene_v1_test_quality_shadow_matches(2, 0.001)
            return 119 if invalid_shadow_bias != 1 or shadow_unchanged != 1
            profile.sun_shadow_receiver_bias <- 0.001
            profile.upscaler <- Quality::Upscaler.Fsr2
            invalid_temporal_upscaler: i32 = catch RenderScene::apply_quality_profile(&profile):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 118 if invalid_temporal_upscaler != 1
            profile.upscaler <- Quality::Upscaler.None
            fallback_outcome: Quality::ApplyOutcome = catch RenderScene::apply_quality_profile_with_result(&profile):
                outcome: outcome
                error failure: return 120
            return 121 if fallback_outcome != Quality::ApplyOutcome.UpscalerFallback
            return 122 if elisa_render_scene_v1_test_quality_profile_matches(
                2, 0.75, 1.4, 1, 1, 1, 1, 1, 0, 0) != 1
            profile.upscaler <- Quality::Upscaler.None
            profile.render_scale <- 1.1
            invalid_profile: i32 = catch RenderScene::apply_quality_profile(&profile):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 117 if invalid_profile != 1
            0

        def verify_history_transitions() -> i32:
            return 120 if elisa_render_scene_v1_test_temporal_history_resources(0.75, 1) != 1
            profile: mutable Quality::Profile = Quality::Profile()
            profile.tonemap <- Quality::Tonemap.Uchimura
            profile.render_scale <- 0.5
            profile.bloom_threshold <- 1.4
            profile.fxaa <- true
            profile.temporal_aa <- true
            profile.ambient_occlusion <- true
            profile.screen_space_reflections <- true
            profile.fog <- false
            profile.depth_effects <- false
            profile.shadow_quality <- Quality::ShadowQuality.High
            profile.sun_shadow_receiver_bias <- 0.001
            half_scale: i32 = catch RenderScene::apply_quality_profile(&profile):
                ok: 0
                error failure: 1
            return 121 if half_scale != 0 or Application::pump() != Application::PumpStatus.Running
            return 122 if elisa_render_scene_v1_test_temporal_history_resources(0.5, 1) != 1
            profile.temporal_aa <- false
            temporal_disabled: i32 = catch RenderScene::apply_quality_profile(&profile):
                ok: 0
                error failure: 1
            return 123 if temporal_disabled != 0 or Application::pump() != Application::PumpStatus.Running
            return 124 if elisa_render_scene_v1_test_temporal_history_resources(0.5, 0) != 1
            profile.temporal_aa <- true
            profile.render_scale <- 0.75
            temporal_restored: i32 = catch RenderScene::apply_quality_profile(&profile):
                ok: 0
                error failure: 1
            return 125 if temporal_restored != 0 or Application::pump() != Application::PumpStatus.Running
            return 126 if elisa_render_scene_v1_test_temporal_history_resources(0.75, 1) != 1
            high_profile: mutable Quality::Profile = Quality::high()
            high_capture: i32 = capture_profile(&high_profile,
                "ELISA_POSTPROCESS_HIGH_CAPTURE", 127)
            return high_capture if high_capture != 0
            low_profile: mutable Quality::Profile = Quality::low()
            low_capture: i32 = capture_profile(&low_profile,
                "ELISA_POSTPROCESS_LOW_CAPTURE", 131)
            return low_capture if low_capture != 0
            restored_profile: i32 = capture_profile(&profile, "", 135)
            return restored_profile if restored_profile != 0
            return 136 if elisa_render_scene_v1_test_temporal_history_resources(0.75, 1) != 1
            0

        def measure_selected_profile_cost(profile_id: u32) -> i32:
            return 154 if profile_id >= Limits::QUALITY_PROFILE_COUNT
            profile: mutable Quality::Profile = Quality::Profile()
            if profile_id == Limits::QUALITY_PROFILE_HIGH:
                profile <- Quality::high()
            elif profile_id == Limits::QUALITY_PROFILE_LOW:
                profile <- Quality::low()
            measure_profile_cost(&profile, profile_id, 137)
