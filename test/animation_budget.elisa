include "../src/animation/budget.elisa"

def main() -> i32:
    t: AnimationBudget::Tiers = AnimationBudget::Tiers{near: 10, mid: 30, far: 80}
    bad: AnimationBudget::Tiers = AnimationBudget::Tiers{near: 30, mid: 10, far: 80}
    # Stride grows with distance; invalid tiers or distances keep full rate.
    return 1 if AnimationBudget::stride_for(0, &t) != 1 or AnimationBudget::stride_for(10, &t) != 1
    return 2 if AnimationBudget::stride_for(11, &t) != 2 or AnimationBudget::stride_for(30, &t) != 2
    return 3 if AnimationBudget::stride_for(31, &t) != 4 or AnimationBudget::stride_for(81, &t) != 8
    return 4 if AnimationBudget::stride_for(50, &bad) != 1 or AnimationBudget::stride_for(-5, &t) != 1
    # Staggered updates: each character updates once per stride frames, and
    # consecutive ids spread across the frames.
    hits: mutable i64 = 0
    for frame in 0..<8:
        hits <- hits + 1 if AnimationBudget::due(frame.i64(), 3, 4)
    return 5 if hits != 2
    on_zero: mutable i64 = 0
    for id in 0..<8:
        on_zero <- on_zero + 1 if AnimationBudget::due(0, id.i64(), 4)
    return 6 if on_zero != 2
    return 7 if not AnimationBudget::due(5, 1, 1) or AnimationBudget::due(-1, 1, 4) or AnimationBudget::due(0, 0, 16)
    # Costs round up and fall as stride grows.
    return 8 if AnimationBudget::frame_cost(100, 50, 1) != 5000 or AnimationBudget::frame_cost(100, 50, 4) != 1250
    return 9 if AnimationBudget::frame_cost(3, 5, 4) != 4 or AnimationBudget::frame_cost(0, 50, 1) != 0
    # The stride to fit chooses the smallest that meets the budget.
    return 10 if AnimationBudget::stride_to_fit(100, 50, 6000, 1) != 1
    return 11 if AnimationBudget::stride_to_fit(100, 50, 3000, 1) != 2
    return 12 if AnimationBudget::stride_to_fit(100, 50, 1300, 1) != 4
    return 13 if AnimationBudget::stride_to_fit(100, 50, 100, 1) != 8
    return 14 if AnimationBudget::stride_to_fit(100, 50, 6000, 4) != 4
    return 15 if AnimationBudget::stride_to_fit(100, 50, 0, 1) != 8 or AnimationBudget::stride_to_fit(0, 50, 0, 1) != 1
    # Even the maximum stride may not fit; that is reported.
    return 16 if AnimationBudget::fits(100, 50, 100, 8) or not AnimationBudget::fits(100, 50, 700, 8)
    return 0
