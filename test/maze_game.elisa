include "../examples/maze/studio.elisa"
include "../examples/maze/menu.elisa"
using Maze
using MazeGame
using MazeStudio
using MazeMenu
using Ui
using Editor
using Assets
using AssetCatalogue

def main() -> i32:
    game: mutable MazeGame = game_new()
    return 1 if game.lives != 3 or game.has_key or game.cue_count != 0
    return 2 if game.status != GameStatus.Menu or not game_valid(&game)
    early: bool = game_step(&game, MazeMove.East)
    return 3 if early or game.grid.player_x != 1

    game_start(&game)
    return 4 if game.status != GameStatus.Playing or game.cue_count != 1 or cue_at(&game, 0) != 8
    blocked: bool = game_step(&game, MazeMove.West)
    return 5 if blocked or game.grid.player_x != 1 or cue_at(&game, 1) != 2

    game_restart(&game)
    South5: MazeMove[5] = [MazeMove.South, MazeMove.South, MazeMove.South, MazeMove.South, MazeMove.South]
    for step in 0..<5 |game|:
        moved: bool = game_step(&game, South5[step])
        return 6 if not moved
    return 7 if game.grid.player_x != 1 or game.grid.player_y != 6
    to_key: bool = game_step(&game, MazeMove.East)
    return 8 if not to_key or not game.has_key or game.grid.player_x != 2
    return 9 if not game_valid(&game)

    locked: mutable MazeGame = game_new()
    game_start(&locked)
    east3: MazeMove[3] = [MazeMove.East, MazeMove.East, MazeMove.East]
    for step in 0..<3 |locked|:
        moved: bool = game_step(&locked, east3[step])
        return 10 if not moved
    return 11 if locked.grid.player_x != 4 or locked.grid.player_y != 1
    for step in 0..<5 |locked|:
        moved: bool = game_step(&locked, South5[step])
        return 12 if not moved
    return 13 if locked.grid.player_x != 4 or locked.grid.player_y != 6 or locked.has_key
    door_shut: bool = game_step(&locked, MazeMove.East)
    return 14 if door_shut or locked.grid.player_x != 4 or cue_at(&locked, locked.cue_count - 1) != 4

    danger: mutable MazeGame = game_new()
    game_start(&danger)
    east4: MazeMove[4] = [MazeMove.East, MazeMove.East, MazeMove.East, MazeMove.East]
    for step in 0..<4 |danger|:
        moved: bool = game_step(&danger, east4[step])
        return 15 if not moved
    return 16 if danger.grid.player_x != 5 or danger.grid.player_y != 1
    hit: bool = game_step(&danger, MazeMove.South)
    return 17 if not hit or danger.lives != 2 or danger.grid.player_x != 1 or danger.grid.player_y != 1
    return 18 if not game_valid(&danger)

    game_pause(&game)
    return 19 if game.status != GameStatus.Paused
    frozen: bool = game_step(&game, MazeMove.East)
    return 20 if frozen
    game_resume(&game)
    return 21 if game.status != GameStatus.Playing

    finish_east: MazeMove[4] = [MazeMove.East, MazeMove.East, MazeMove.East, MazeMove.East]
    for step in 0..<4 |game|:
        moved: bool = game_step(&game, finish_east[step])
        return 22 if not moved
    return 23 if game.grid.player_x != 6 or not game_won(&game) or game.status != GameStatus.Won
    return 24 if cue_at(&game, game.cue_count - 1) != 6
    after: bool = game_step(&game, MazeMove.West)
    return 25 if after

    game_restart(&game)
    return 26 if game.status != GameStatus.Playing or game.lives != 3 or game.has_key or game_won(&game)

    fog_off: GameSettings = GameSettings{fog: false, audio: true}
    game_apply_settings(&game, fog_off)
    return 27 if game.settings.fog or visible_count(&game) != 64
    fog_on: GameSettings = GameSettings{fog: true, audio: false}
    game_apply_settings(&game, fog_on)
    return 28 if not game.settings.fog or visible_count(&game) != 17
    quiet: usize = game.cue_count
    moved_quiet: bool = game_step(&game, MazeMove.East)
    return 29 if not moved_quiet or game.cue_count != quiet

    # Drain all three lives: the third hazard hit must end the game, not just
    # cost a life, and a lost game refuses input until it is restarted.
    doomed: mutable MazeGame = game_new()
    game_start(&doomed)
    lose: MazeMove[15] = [
        MazeMove.South, MazeMove.South, MazeMove.South, MazeMove.South, MazeMove.East,
        MazeMove.South, MazeMove.South, MazeMove.South, MazeMove.South, MazeMove.East,
        MazeMove.South, MazeMove.South, MazeMove.South, MazeMove.South, MazeMove.East,
    ]
    for step in 0..<15 |doomed|:
        moved: bool = game_step(&doomed, lose[step])
        return 31 if not moved
    return 32 if doomed.lives != 0 or not game_lost(&doomed) or doomed.status != GameStatus.Lost
    return 33 if not game_valid(&doomed)
    after_loss: bool = game_step(&doomed, MazeMove.East)
    return 34 if after_loss
    game_restart(&doomed)
    return 35 if doomed.status != GameStatus.Playing or doomed.lives != 3 or game_lost(&doomed)
    return 36 if not game_valid(&doomed)

    game_quit(&game)
    return 30 if game.status != GameStatus.Exited

    # Play-in-editor: a running game with an undo history over its settings,
    # and asset-catalogue validation that rejects a stale generation.
    studio: mutable Studio = studio_new()
    return 37 if not studio_valid(&studio) or not studio.game.settings.fog or not studio.game.settings.audio
    studio_start(&studio)
    return 38 if studio.game.status != GameStatus.Playing
    fog_off_edit: bool = studio_apply(&studio, false, true)
    return 39 if not fog_off_edit or studio.game.settings.fog or not history_can_undo(&studio.history)
    stepped: bool = studio_step(&studio, MazeMove.East)
    return 40 if not stepped or studio.game.grid.player_x != 2
    reverted: bool = studio_undo(&studio)
    return 41 if not reverted or not studio.game.settings.fog or studio.game.grid.player_x != 2
    reapplied: bool = studio_redo(&studio)
    return 42 if not reapplied or studio.game.settings.fog
    no_change: bool = studio_apply(&studio, false, true)
    return 43 if not no_change
    quiet_edit: bool = studio_apply(&studio, true, false)
    return 44 if not quiet_edit or studio.game.settings.audio or not studio_valid(&studio)
    catalog: mutable Catalogue = catalogue_new()
    tile: AssetId = AssetId{high: 23, low: 1}
    content_one: AssetId = AssetId{high: 40, low: 1}
    content_two: AssetId = AssetId{high: 40, low: 2}
    registered: bool = catch catalogue_register(&catalog, tile, content_one, 128):
        ok: true
        error failure: false
    return 45 if not registered or not catalogue_valid(&catalog) or entry_count(&catalog) != 1
    return 46 if not package_fresh(&catalog, tile, content_one, 0) or package_fresh(&catalog, tile, content_two, 1)
    return 47 if not studio_tile_fresh(&studio, &catalog, content_one, 0)
    recooked: bool = catch catalogue_recook(&catalog, tile, content_two):
        ok: true
        error failure: false
    return 48 if not recooked or lookup_generation(&catalog, tile) != 1
    return 49 if not studio_tile_fresh(&studio, &catalog, content_two, 1) or studio_tile_fresh(&studio, &catalog, content_one, 0)

    # Chunk streaming follows the running game: chunks around the player are
    # resident, the resident count stays within the budget, and a restart leaves
    # the residency coherent.
    stream_game: mutable MazeGame = game_new()
    game_start(&stream_game)
    return 50 if not game_valid(&stream_game) or game_resident_chunks(&stream_game) == 0
    return 51 if not game_chunk_resident(&stream_game, 0, 0)
    return 52 if game_resident_chunks(&stream_game) > 9
    east_stream: bool = game_step(&stream_game, MazeMove.East)
    return 53 if not east_stream or not game_valid(&stream_game)
    return 54 if game_resident_chunks(&stream_game) == 0 or game_resident_chunks(&stream_game) > 9
    game_restart(&stream_game)
    return 55 if not game_valid(&stream_game) or not game_chunk_resident(&stream_game, 0, 0)

    # UI menu model: from the menu, start is offered and the focus lands on it;
    # focus skips disabled rows; activating a row runs the game flow.
    menu_game: mutable MazeGame = game_new()
    menu: mutable Ui::Menu = menu_build(&menu_game)
    return 56 if not Ui::menu_valid(&menu) or item_count(&menu) != action_count()
    return 57 if Ui::focused_action(&menu) != action_start()
    return 58 if Ui::item_enabled(&menu, 1) or Ui::item_enabled(&menu, 2)
    Ui::focus_next(&menu)
    return 59 if Ui::focused_action(&menu) != action_quit()
    menu_activated: bool = menu_activate_row(&menu_game, &menu, 0)
    return 60 if not menu_activated or menu_game.status != GameStatus.Playing
    running_menu: Ui::Menu = menu_build(&menu_game)
    return 61 if Ui::item_enabled(&running_menu, 0) or not Ui::item_enabled(&running_menu, 2)
    quit_row: i64 = Ui::hit_test(&running_menu, 4 * row_height())
    return 62 if quit_row != 4
    quit_done: bool = menu_activate_row(&menu_game, &running_menu, 4)
    return 63 if not quit_done or menu_game.status != GameStatus.Exited
    return 64 if menu_activate_row(&menu_game, &running_menu, 0)
    0
