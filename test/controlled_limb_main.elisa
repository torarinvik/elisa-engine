include "../src/animation/controlled_limb.elisa"

def near(a: f32, b: f32) -> bool:
    difference: f32 = a-b
    difference > -0.0001 and difference < 0.0001

def exercise() -> i32 error[IkFk::BlendError, Pose::PoseError, ConstrainedLimb::SolveError, PoseJointLimits::ConstraintError, JointLimits::LimitError]:
    skeleton: mutable Pose::Skeleton = Pose::Skeleton()
    local: mutable Geometry::Transform = Geometry::transform_identity()
    return 1 if not Pose::skeleton_add(&skeleton,-1,local)
    local.position <- Geometry::Vec3{x: 5.0,y: 0.0,z: 0.0}
    return 1 if not Pose::skeleton_add(&skeleton,-1,local)
    local.position <- Geometry::Vec3{x: 1.0,y: 0.0,z: 0.0}
    return 1 if not Pose::skeleton_add(&skeleton,0,local)
    return 1 if not Pose::skeleton_add(&skeleton,2,local)
    local.position <- Geometry::Vec3{x: 0.25,y: 0.0,z: 0.0}
    return 1 if not Pose::skeleton_add(&skeleton,3,local)
    source: Pose::Pose = try Pose::pose_evaluate(skeleton)
    settings: mutable PoseJointLimits::Constraints = PoseJointLimits::constraints(5)
    settings.enabled[2] <- true
    settings.limits[2] <- JointLimits::SwingTwist{reference: Geometry::quat_identity(),axis: Geometry::Vec3{x: 0.0,y: 0.0,z: 1.0},maximum_swing: 0.0,minimum_twist: -1.570796327,maximum_twist: 0.0}
    memory: mutable Ik::BendMemory = Ik::bend_memory()
    pose: mutable Pose::Pose = source
    target: Geometry::Vec3 = Geometry::Vec3{x: 1.0,y: 1.0,z: 0.0}
    hint: Geometry::Vec3 = Geometry::Vec3{x: 0.0,y: 1.0,z: 0.0}
    turn: Geometry::Quat = Geometry::Quat{x: 0.0,y: 0.0,z: 0.70710678,w: 0.70710678}
    full: ControlledLimb::Result = try ControlledLimb::solve(&pose,skeleton,0,2,3,target,turn,1.0,0.0,hint,&memory,settings,0.0001,32)
    return 2 if not full.converged or full.residual > 0.0001 or not near(pose.models[3].rotation.w,1.0)
    return 3 if not near(Geometry::vec3_distance(pose.models[0].position,pose.models[2].position),1.0) or not near(Geometry::vec3_distance(pose.models[2].position,pose.models[3].position),1.0)
    return 4 if not near(pose.models[1].position.x,5.0)
    pose <- source
    partial: ControlledLimb::Result = try ControlledLimb::solve(&pose,skeleton,0,2,3,target,turn,0.5,0.5,hint,&memory,settings,0.0001,32)
    return 5 if partial.converged or not near(partial.residual,Geometry::vec3_distance(pose.models[3].position,target))
    return 6 if not near(pose.models[4].position.x-pose.models[3].position.x,0.1767767) or not near(pose.models[4].position.y-pose.models[3].position.y,0.1767767)
    offset: Geometry::Vec3 = Geometry::vec3_sub(pose.models[2].position,pose.models[0].position)
    direction: Geometry::Vec3 = Geometry::vec3_normalize(Geometry::vec3_sub(pose.models[3].position,pose.models[0].position))
    planar: Geometry::Vec3 = Geometry::vec3_normalize(Geometry::vec3_sub(offset,Geometry::vec3_scale(direction,Geometry::vec3_dot(offset,direction))))
    return 7 if Geometry::vec3_dot(memory.bend,planar) < 0.9999
    # Orientation-only ignores unreachable position and leaves memory intact.
    pose <- source
    saved: Ik::BendMemory = memory
    inactive: ControlledLimb::Result = try ControlledLimb::solve(&pose,skeleton,0,2,3,Geometry::Vec3{x: 99.0,y: 0.0,z: 0.0},turn,0.0,1.0,hint,&memory,settings,0.0001,32)
    return 8 if inactive.positional_active or inactive.converged or not near(pose.models[4].position.x,2.0) or not near(pose.models[4].position.y,0.25) or Geometry::vec3_distance(memory.bend,saved.bend) > 0.0
    # Wrist hinge limits constrain independent orientation; fingers follow.
    settings.enabled[3] <- true
    settings.limits[3] <- JointLimits::SwingTwist{reference: Geometry::quat_identity(),axis: Geometry::Vec3{x: 0.0,y: 0.0,z: 1.0},maximum_swing: 0.0,minimum_twist: -0.3,maximum_twist: 0.3}
    pose <- source
    wrist: ControlledLimb::Result = try ControlledLimb::solve(&pose,skeleton,0,2,3,target,turn,0.0,1.0,hint,&memory,settings,0.0001,32)
    return 9 if not wrist.limits_encountered or not near(pose.models[3].rotation.z,0.14943813) or not near(pose.models[4].position.y,0.07388005)
    # Invalid wrist limits fail after no published changes, including memory.
    before: Pose::Pose = pose
    settings.limits[3].maximum_twist <- -0.4
    rejected: bool = catch ControlledLimb::solve(&pose,skeleton,0,2,3,target,turn,1.0,1.0,hint,&memory,settings,0.0001,32):
        value: false
        JointLimits::LimitError.InvalidLimit: true
        error failure: false
    return 10 if not rejected or Geometry::vec3_distance(pose.models[4].position,before.models[4].position) > 0.0 or Geometry::vec3_distance(memory.bend,saved.bend) > 0.0
    settings.enabled[3] <- false
    pose <- source
    outside: ControlledLimb::Result = try ControlledLimb::solve(&pose,skeleton,0,2,3,Geometry::Vec3{x: 3.0,y: 0.0,z: 0.0},turn,1.0,0.0,hint,&memory,settings,0.0001,32)
    return 11 if outside.converged or outside.geometric_reach or outside.residual < 0.999 or outside.residual > 1.001
    # At partial weight the source FK can violate the hinge; final projection
    # takes priority and the published lower rotation remains inside it.
    settings.limits[2].maximum_twist <- -0.5
    settings.limits[2].minimum_twist <- -1.570796327
    pose <- source
    bounded: ControlledLimb::Result = try ControlledLimb::solve(&pose,skeleton,0,2,3,target,turn,0.1,0.0,hint,&memory,settings,0.0001,32)
    lower_local: Geometry::Transform = Geometry::transform_apply_inverse(pose.models[0],pose.models[2])
    lower_limit: JointLimits::SwingTwist = settings.limits[2]
    checked: JointLimits::Projection = try JointLimits::project(lower_local.rotation,lower_limit)
    return 12 if checked.twist > -0.4999 or checked.twist < -1.5709 or not bounded.limits_encountered
    return 13 if not near(Geometry::vec3_distance(pose.models[0].position,pose.models[2].position),1.0) or not near(Geometry::vec3_distance(pose.models[2].position,pose.models[3].position),1.0)
    final_pose: Pose::Pose = pose
    final_memory: Ik::BendMemory = memory
    bad_weight: bool = catch ControlledLimb::solve(&pose,skeleton,0,2,3,target,turn,1.1,1.0,hint,&memory,settings,0.0001,32):
        value: false
        IkFk::BlendError.InvalidWeight: true
        error failure: false
    return 14 if not bad_weight or Geometry::vec3_distance(pose.models[4].position,final_pose.models[4].position) > 0.0 or Geometry::vec3_distance(memory.direction,final_memory.direction) > 0.0
    0

def main() -> i32:
    catch exercise():
        value: value
        error failure: 20
