include "../src/world/events.elisa"

def main() -> i32:
    queue: mutable WorldEvents::Queue = WorldEvents::Queue()
    WorldEvents::begin_frame(&queue)
    _ = catch WorldEvents::subscribe(&queue, 7, WorldEvents::Phase.Simulation):
        ok: 0
        error failure: return 1
    _ = catch WorldEvents::emit(&queue, WorldEvents::Event{phase: WorldEvents::Phase.Simulation, kind: WorldEvents::EventKind.Damage, listener_id: 7, entity_id: 42, payload: 3, delivered: false}):
        ok: 0
        error failure: return 2
    return 3 if WorldEvents::event_count(&queue) != 1
    wrong_phase: i32 = catch WorldEvents::dispatch(&queue, WorldEvents::Phase.Simulation):
        value: 1
        WorldEvents::EventError.InvalidPhase: 0
        error failure: 2
    return 4 if wrong_phase != 0
    _ = catch WorldEvents::advance_phase(&queue, WorldEvents::Phase.Simulation):
        ok: 0
        error failure: return 5
    dispatched: usize = catch WorldEvents::dispatch(&queue, WorldEvents::Phase.Simulation):
        value: value
        error failure: return 6
    return 6 if dispatched != 1
    _ = catch WorldEvents::unsubscribe(&queue, 7):
        ok: 0
        error failure: return 7
    _ = catch WorldEvents::advance_phase(&queue, WorldEvents::Phase.Physics):
        ok: 0
        error failure: return 8
    rejected: i32 = catch WorldEvents::emit(&queue, WorldEvents::Event{phase: WorldEvents::Phase.Simulation, kind: WorldEvents::EventKind.Damage, listener_id: 7, entity_id: 42, payload: 4, delivered: false}):
        ok: 0
        WorldEvents::EventError.InvalidPhase: 1
        error failure: 2
    return 9 if rejected != 1
    return 10 if WorldEvents::end_frame(&queue) != 1
    0
