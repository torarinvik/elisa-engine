include "../src/net/session.elisa"
include "../src/net/loopback.elisa"
include "../src/net/peer.elisa"
include "../src/net/recovery.elisa"
include "../src/net/interpolation.elisa"
include "../src/net/reliable.elisa"
using Net
using Session
using Wire
using Loopback
using Peer
using Recovery
using Interp
using Reliable

def sample(owner: Owner, revision: i64, x: i64, y: i64) -> ReplRecord:
    ReplRecord{persistent: 99, x: x, y: y, revision: revision, owner: owner}

def empty_record() -> ReplRecord:
    ReplRecord{persistent: 0, x: 0, y: 0, revision: -1, owner: Owner.Server}

def wire_test() -> i32:
    record: ReplRecord = sample(Owner.Server, 7, 3, 0 - 4)
    frame: u8[33] =
        catch encode(&record):
            value: value
            error failure: zeroed
    restored: ReplRecord =
        catch decode(frame, wire_frame_bytes()):
            value: value
            error failure: empty_record()
    return 40 if restored.persistent != 99 or restored.revision != 7 or restored.owner != Owner.Server
    return 41 if restored.x != 3 or restored.y != 0 - 4
    short: i32 = catch decode(frame, 32):
        value: 1
        WireError.ShortFrame: 0
        error failure: 2
    return 42 if short != 0
    long: i32 = catch decode(frame, 34):
        value: 1
        WireError.LongFrame: 0
        error failure: 2
    return 43 if long != 0
    corrupt: mutable u8[33] = frame
    corrupt[32] <- 9
    bad_owner: i32 = catch decode(corrupt, wire_frame_bytes()):
        value: 1
        WireError.UnknownOwner: 0
        error failure: 2
    return 44 if bad_owner != 0
    invalid: ReplRecord = ReplRecord{persistent: 0, x: 0, y: 0, revision: 0, owner: Owner.Server}
    rejected: i32 = catch encode(&invalid):
        value: 1
        WireError.InvalidRecord: 0
        error failure: 2
    return 45 if rejected != 0
    # A crafted all-zero frame has a valid owner byte but a zero identity, and
    # a frame with an all-ones revision wraps negative; both must be refused at
    # decode rather than entering the world.
    zero_frame: u8[33] = zeroed
    zero_record: i32 = catch decode(zero_frame, wire_frame_bytes()):
        value: 1
        WireError.InvalidRecord: 0
        error failure: 2
    return 46 if zero_record != 0
    huge_revision: mutable u8[33] = frame
    for byte in 24..<32 |huge_revision|:
        huge_revision[byte] <- 255
    overflow_revision: i32 = catch decode(huge_revision, wire_frame_bytes()):
        value: 1
        WireError.InvalidRecord: 0
        error failure: 2
    return 47 if overflow_revision != 0
    # A value too negative to bias is unrepresentable rather than wrapping.
    too_negative: ReplRecord = sample(Owner.Server, 1, 0 - 2000000, 0)
    unrepresentable: i32 = catch encode(&too_negative):
        value: 1
        WireError.Unrepresentable: 0
        error failure: 2
    return 48 if unrepresentable != 0
    # Integer overflow at the boundary: the bias addition on the widest i64
    # values wraps, and a wrap must be refused rather than encoded.
    huge_high: ReplRecord = sample(Owner.Server, 1, 9223372036854775807, 0)
    overflow_high: i32 = catch encode(&huge_high):
        value: 1
        WireError.Unrepresentable: 0
        error failure: 2
    return 49 if overflow_high != 0
    huge_low: ReplRecord = sample(Owner.Server, 1, 0 - 9223372036854775807 - 1, 0)
    overflow_low: i32 = catch encode(&huge_low):
        value: 1
        WireError.Unrepresentable: 0
        error failure: 2
    return 50 if overflow_low != 0
    0

def loopback_test() -> i32:
    link: mutable Link = link_new(2, 1)
    first: ReplRecord = sample(Owner.Server, 1, 10, 0)
    second: ReplRecord = sample(Owner.Server, 2, 20, 0)
    third: ReplRecord = sample(Owner.Server, 3, 30, 0)
    fourth: ReplRecord = sample(Owner.Server, 4, 40, 0)
    early: i32 = catch link_send(&link, &first, 0):
        value: value
        error failure: 99
    second_seq: i32 = catch link_send(&link, &second, 1):
        value: value
        error failure: 99
    third_seq: i32 = catch link_send(&link, &third, 2):
        value: value
        error failure: 99
    fourth_seq: i32 = catch link_send(&link, &fourth, 3):
        value: value
        error failure: 99
    return 50 if early != 0 or second_seq != 1 or third_seq != 2 or fourth_seq != 3
    # Nothing has arrived yet: the link delay holds every packet back.
    too_soon: i32 = catch link_receive(&link, 0):
        value: 1
        LinkError.UnknownPacket: 0
        error failure: 2
    return 51 if too_soon != 0
    # By tick 4 all four have arrived; the loss pattern drops the even
    # sequences, so the newest survivor is revision 4.
    arrived: ReplRecord =
        catch link_receive(&link, 4):
            value: value
            error failure: empty_record()
    return 52 if arrived.revision != 4 or arrived.x != 40
    return 53 if link_delivered(&link) != 2 or link_dropped(&link) != 2
    drained: i32 = catch link_receive(&link, 5):
        value: 1
        LinkError.UnknownPacket: 0
        error failure: 2
    return 54 if drained != 0

    # A reliable link delivers the newest immediately, so loss is what the
    # policy says and not an accident of the double.
    reliable: mutable Link = link_new(0, 0)
    _ = catch link_send(&reliable, &first, 0):
        value: value
        error failure: 99
    _ = catch link_send(&reliable, &fourth, 0):
        value: value
        error failure: 99
    latest: ReplRecord =
        catch link_receive(&reliable, 0):
            value: value
            error failure: empty_record()
    return 55 if latest.revision != 4 or link_dropped(&reliable) != 0
    0

def server_state(rev: i64) -> ReplRecord:
    ReplRecord{persistent: 99, x: rev * 10, y: 0, revision: rev, owner: Owner.Server}

# Two peers over a lossy, delayed link: the client must still converge on the
# server's final state, refuse an unauthorized writer, and ignore stale
# revisions. This is the netcode path end to end at the Elisa layer.
def peer_test() -> i32:
    link: mutable Link = link_new(3, 1)
    for rev in 1..<7 |link|:
        sent: i32 = catch link_send(&link, &server_state(rev.i64()), rev.i64() - 1):
            value: value
            error failure: 99
        return 60 if sent == 99
    client: mutable PeerState = peer_new(Owner.Server)
    for tick in 1..<13 |link, client|:
        received: ReplRecord =
            catch link_receive(&link, tick.i64()):
                value: value
                error failure: ReplRecord{persistent: 0, x: 0, y: 0, revision: 0, owner: Owner.Server}
        if received.persistent == 99:
            outcome: ApplyResult = peer_apply(&client, received, Owner.Server)
            _ = outcome
    return 61 if peer_revision(&client) != 6 or peer_x(&client) != 60
    return 62 if client.applied < 3 or client.rejected != 0
    hostile: ReplRecord = ReplRecord{persistent: 99, x: 999, y: 0, revision: 7, owner: Owner.Client}
    rejected: ApplyResult = peer_apply(&client, hostile, Owner.Server)
    return 63 if rejected != ApplyResult.RejectedAuthority or client.rejected != 1 or peer_x(&client) != 60
    stale: ApplyResult = peer_apply(&client, server_state(5), Owner.Server)
    return 64 if stale != ApplyResult.IgnoredOlder or peer_x(&client) != 60
    0

# Recovery: a contiguous revision keeps the session in sync, a forward jump is
# a gap that blocks application until a snapshot resyncs it, and a stale
# revision is ignored. The high-water mark is never rewound.
def recovery_test() -> i32:
    view: mutable RecoveryView = recovery_new(300)
    return 70 if not recovery_valid(&view) or view.expected != 1 or not view.in_sync
    return 71 if not recovery_observe(&view, 1) or view.expected != 2
    return 72 if not recovery_observe(&view, 2) or not recovery_observe(&view, 3) or view.expected != 4
    return 73 if recovery_observe(&view, 6)
    return 74 if view.in_sync or view.gaps != 1 or view.expected != 4 or view.last_seen != 6
    return 75 if recovery_observe(&view, 4) or recovery_gap_count(&view) != 1
    return 76 if not recovery_resync(&view, 6) or view.expected != 7 or not view.in_sync or view.resyncs != 1
    return 77 if not recovery_observe(&view, 7) or view.expected != 8
    return 78 if recovery_high_water(&view) != 300 or recovery_resync(&view, 5) or not recovery_valid(&view)
    0

# Interpolation: the client renders between the two most recent authority
# snapshots, clamps rather than extrapolating, and refuses a reordered snapshot.
def interp_test() -> i32:
    buffer: mutable Buffer = buffer_new()
    return 80 if not buffer_valid(&buffer) or buffer_count(&buffer) != 0
    first: i32 = catch buffer_push(&buffer, sample(Owner.Server, 1, 0, 0), 10):
        ok: 0
        error failure: 1
    return 81 if first != 0 or buffer_count(&buffer) != 1
    single: ReplRecord = buffer_sample(&buffer, 15)
    return 82 if single.x != 0 or single.revision != 1 or not buffer_is_clamped(&buffer, 15)
    second: i32 = catch buffer_push(&buffer, sample(Owner.Server, 2, 10, 20), 20):
        ok: 0
        error failure: 1
    return 83 if second != 0 or buffer_count(&buffer) != 2
    mid: ReplRecord = buffer_sample(&buffer, 15)
    return 84 if mid.x != 5 or mid.y != 10 or mid.revision != 2 or buffer_is_clamped(&buffer, 15)
    return 85 if buffer_sample(&buffer, 5).x != 0 or not buffer_is_clamped(&buffer, 5)
    return 86 if buffer_sample(&buffer, 25).x != 10 or not buffer_is_clamped(&buffer, 25)
    quarter: ReplRecord = buffer_sample(&buffer, 12)
    return 87 if quarter.x != 2 or quarter.y != 4
    stale: i32 = catch buffer_push(&buffer, sample(Owner.Server, 3, 1, 1), 19):
        ok: 0
        InterpError.OutOfOrder: 1
        error failure: 2
    return 88 if stale != 1
    invalid: i32 = catch buffer_push(&buffer, ReplRecord{persistent: 0, x: 0, y: 0, revision: 0, owner: Owner.Server}, 30):
        ok: 0
        InterpError.InvalidSnapshot: 1
        error failure: 2
    return 89 if invalid != 1 or not buffer_valid(&buffer)
    0

# Fuzz the wire decoder: 256 mutated frames (a valid frame with zero to three
# bytes flipped) must either decode to a valid record or be refused with one of
# the declared errors. Any other outcome fails, and both acceptance and
# rejection must occur so the test exercises both paths.
def fuzz_test() -> i32:
    seed: mutable i64 = 1
    base: ReplRecord = sample(Owner.Client, 12345, 0 - 5, 7)
    valid: u8[33] = catch encode(&base):
        value: value
        error failure: zeroed
    accepted: mutable usize = 0
    rejected: mutable usize = 0
    for round in 0..<256 |seed, accepted, rejected, valid|:
        frame: mutable u8[33] = valid
        seed <- (seed * 1103515245 + 12345) % 2147483648
        mutations: i64 = seed % 4
        for step in 0..<mutations |frame, seed|:
            seed <- (seed * 1103515245 + 12345) % 2147483648
            position: i64 = seed / 65536 % 33
            seed <- (seed * 1103515245 + 12345) % 2147483648
            frame[position.usize()] <- (seed / 65536 % 256).u8()
        outcome: i32 = catch decode(frame, wire_frame_bytes()):
            value: 1
            WireError.ShortFrame: 0
            WireError.LongFrame: 0
            WireError.UnknownOwner: 0
            WireError.Unrepresentable: 0
            WireError.InvalidRecord: 0
            error failure: 2
        return 90 if outcome == 2
        if outcome == 1:
            accepted <- accepted + 1
        if outcome == 0:
            rejected <- rejected + 1
    return 91 if accepted == 0 or rejected == 0 or accepted + rejected != 256
    0

# Reordering: packets sent so that a later revision arrives before an earlier
# one. The peer must still converge on the newest revision and ignore the stale
# one that arrives last, so a reordered link does not corrupt state.
def reorder_test() -> i32:
    link: mutable Link = link_new(0, 0)
    sent_two: i32 = catch link_send(&link, &sample(Owner.Server, 2, 20, 0), 0):
        ok: 0
        error failure: 1
    sent_three: i32 = catch link_send(&link, &sample(Owner.Server, 3, 30, 0), 1):
        ok: 0
        error failure: 1
    sent_one: i32 = catch link_send(&link, &sample(Owner.Server, 1, 10, 0), 2):
        ok: 0
        error failure: 1
    return 100 if sent_one != 0 or sent_two != 0 or sent_three != 0
    client: mutable PeerState = peer_new(Owner.Server)
    for tick in 0..<3 |link, client|:
        received: ReplRecord =
            catch link_receive(&link, tick.i64()):
                value: value
                error failure: ReplRecord{persistent: 0, x: 0, y: 0, revision: 0, owner: Owner.Server}
        if received.persistent == 99:
            outcome: ApplyResult = peer_apply(&client, received, Owner.Server)
            _ = outcome
    return 101 if peer_revision(&client) != 3 or peer_x(&client) != 30
    return 102 if client.ignored == 0 or client.rejected != 0
    0

# Reliable delivery: a sliding window resends the oldest unacknowledged record,
# a gap holds the window until it is filled, and an ack advances the base over
# contiguous acknowledgements only.
def reliable_test() -> i32:
    sender: mutable Sender = sender_new()
    return 110 if not sender_valid(&sender) or sender_outstanding(&sender) != 0 or sender_oldest(&sender) != -1
    seq0: i64 = catch sender_send(&sender, sample(Owner.Server, 1, 10, 0)):
        value: value
        error failure: return 111
    seq1: i64 = catch sender_send(&sender, sample(Owner.Server, 2, 20, 0)):
        value: value
        error failure: return 112
    seq2: i64 = catch sender_send(&sender, sample(Owner.Server, 3, 30, 0)):
        value: value
        error failure: return 113
    return 114 if seq0 != 0 or seq1 != 1 or seq2 != 2 or sender_outstanding(&sender) != 3
    return 115 if not sender_ack(&sender, 0) or not sender_ack(&sender, 1) or sender_oldest(&sender) != 2
    resent: i64 = catch sender_retransmit(&sender):
        value: value
        error failure: return 116
    return 117 if resent != 2 or sender.retransmits != 1 or sender_outstanding(&sender) != 1
    return 118 if sender_ack(&sender, 0) or not sender_ack(&sender, 2)
    none: i64 = catch sender_retransmit(&sender):
        value: 0
        ReliableError.UnknownSequence: 1
        error failure: 2
    return 119 if none != 1 or not sender_valid(&sender)
    0

def reliable_gap_test() -> i32:
    gap: mutable Sender = sender_new()
    first: i64 = catch sender_send(&gap, sample(Owner.Server, 1, 10, 0)):
        value: value
        error failure: return 120
    second: i64 = catch sender_send(&gap, sample(Owner.Server, 2, 20, 0)):
        value: value
        error failure: return 121
    return 122 if first != 0 or second != 1
    return 123 if not sender_ack(&gap, 1) or gap.base != 0
    return 124 if not sender_ack(&gap, 0) or gap.base != 2 or not sender_valid(&gap)
    0

# Reliable delivery end to end: four revisions are sent through a link that
# drops every second frame; the window retransmits the oldest until each is
# acknowledged, and the peer converges on the last revision with the window
# empty. Retransmissions must actually occur, or loss was not recovered.
def reliable_link_test() -> i32:
    link: mutable Link = link_new(2, 0)
    sender: mutable Sender = sender_new()
    for revision in 1..<5 |sender|:
        seq: i64 = catch sender_send(&sender, sample(Owner.Server, revision.i64(), revision.i64() * 10, 0)):
            value: value
            error failure: return 130
    return 131 if sender_outstanding(&sender) != 4
    client: mutable PeerState = peer_new(Owner.Server)
    for tick in 0..<24 |link, sender, client|:
        if sender_outstanding(&sender) > 0:
            resent: i64 = catch sender_retransmit(&sender):
                value: value
                error failure: 0 - 1
            record: ReplRecord =
                catch sender_record(&sender, resent):
                    value: value
                    error failure: sample(Owner.Server, 1, 10, 0)
            sent: usize = catch link_send(&link, &record, tick.i64()):
                value: value
                error failure: 99
            return 132 if sent == 99
        received: ReplRecord =
            catch link_receive(&link, tick.i64()):
                value: value
                error failure: ReplRecord{persistent: 0, x: 0, y: 0, revision: 0, owner: Owner.Server}
        if received.persistent == 99:
            outcome: ApplyResult = peer_apply(&client, received, Owner.Server)
            acked: bool = sender_ack(&sender, received.revision - 1)
            _ = outcome
            _ = acked
    return 133 if peer_revision(&client) != 4 or peer_x(&client) != 40
    return 134 if sender_outstanding(&sender) != 0 or sender.retransmits == 0 or not sender_valid(&sender)
    0

# Model-based convergence fuzz: revisions sent through a link are delivered
# under loss and delay profiles, and the peer must never regress and must end at
# the highest delivered revision. It exercises the netcode across profiles
# rather than one hand-picked setting.
def convergence_profile(loss_every: usize, delay: i64, revisions: usize) -> i32:
    link: mutable Link = link_new(loss_every, delay)
    for index in 0..<revisions |link|:
        sent: i32 = catch link_send(&link, &sample(Owner.Server, index.i64() + 1, (index.i64() + 1) * 10, 0), index.i64()):
            ok: 0
            error failure: 1
        return 150 if sent != 0
    highest: mutable i64 = 0
    for index in 0..<revisions |highest|:
        highest <- index.i64() + 1 if should_deliver(index, loss_every)
    client: mutable PeerState = peer_new(Owner.Server)
    previous: mutable i64 = 0
    for tick in 0..<revisions.i64() + delay + 2 |link, client, previous|:
        received: ReplRecord =
            catch link_receive(&link, tick):
                value: value
                error failure: ReplRecord{persistent: 0, x: 0, y: 0, revision: 0, owner: Owner.Server}
        if received.persistent == 99:
            outcome: ApplyResult = peer_apply(&client, received, Owner.Server)
            return 151 if peer_revision(&client) < previous
            previous <- peer_revision(&client)
    return 152 if peer_revision(&client) != highest
    return 153 if client.rejected != 0
    0

def convergence_fuzz() -> i32:
    for loss in 2..<5:
        for delay in 0..<3:
            result: i32 = convergence_profile(loss.usize(), delay.i64(), 6)
            return result if result != 0
    no_loss: i32 = convergence_profile(0, 0, 6)
    return 154 if no_loss != 0
    0

def main() -> i32:
    session: mutable NetSession = session_new()
    return 1 if not session_valid(&session) or session_live(&session)
    return 2 if session_open(&session) == false or session.stage != SessionStage.Handshake
    return 3 if session_begin_live(&session)
    return 4 if not session_admit(&session, 11) or not session_admit(&session, 11)
    return 5 if not client_known(&session, 11) or client_known(&session, 0)
    return 6 if not session_admit(&session, 12) or session.client_count != 2
    return 7 if not session_begin_live(&session) or not session_live(&session)

    return 8 if not session_grant(&session, 99, Owner.Client) or not owns_identity(&session, 99)
    return 9 if session_grant(&session, 100, Owner.Server) or owns_identity(&session, 100)
    return 10 if session_grant(&session, 0, Owner.Client)

    return 11 if not session_set_profile(&session, 4, 2) or not degraded_ok(&session)
    return 12 if session_set_profile(&session, 2, 9)
    return 13 if not session_set_profile(&session, 2, 1) or degraded_ok(&session)

    return 14 if not session_drop(&session, 11) or session.client_count != 1
    return 15 if session.stage != SessionStage.Recovering or session.reconnects != 1
    return 16 if session_live(&session) or not session_recover(&session) or not session_live(&session)
    return 17 if session_drop(&session, 77)

    session_close(&session)
    return 18 if session.stage != SessionStage.Closed or session_live(&session)

    wired: i32 = wire_test()
    return wired if wired != 0
    looped: i32 = loopback_test()
    return looped if looped != 0
    peers: i32 = peer_test()
    return peers if peers != 0
    recovered: i32 = recovery_test()
    return recovered if recovered != 0
    interpolated: i32 = interp_test()
    return interpolated if interpolated != 0
    fuzzed: i32 = fuzz_test()
    return fuzzed if fuzzed != 0
    reordered: i32 = reorder_test()
    return reordered if reordered != 0
    reliable: i32 = reliable_test()
    return reliable if reliable != 0
    gap_reliable: i32 = reliable_gap_test()
    return gap_reliable if gap_reliable != 0
    loss_recovered: i32 = reliable_link_test()
    return loss_recovered if loss_recovered != 0
    converged: i32 = convergence_fuzz()
    return converged if converged != 0
    0
