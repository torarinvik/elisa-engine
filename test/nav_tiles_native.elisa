# N02 tile streaming through the Elisa wrappers: a 40 m corridor cooked in
# 64-voxel (6.4 m) tiles routes end to end; unloading a middle tile makes
# the goal unreachable, unloading the goal's tile leaves it off the mesh,
# and loading either back restores the full route. Repeated loads/unloads, tiles outside the grid, a baked (not
# cooked) mesh and an unloaded mesh are refused. Linked against the
# navigation service by scripts/build_nav_native_test.sh.
include "../src/nav/tiles.elisa"

def v(x: f32, y: f32, z: f32) -> Geometry::Vec3:
    Geometry::Vec3{x: x, y: y, z: z}

def stage_code() -> i32:
    catch NavMesh::begin():
        value: floor_code()
        error failure: 1

def floor_code() -> i32:
    catch NavMesh::add_box(v(20.0, -0.1, 0.0), v(20.0, 0.1, 1.5)):
        value: 0
        error failure: 1

def cooked() -> NavMesh::Handle:
    catch NavCook::cook(NavMesh::default_profile(), 64, 7001):
        value: value.handle
        error failure: NavMesh::empty_handle()

def baked() -> NavMesh::Handle:
    catch NavMesh::bake(NavMesh::default_profile()):
        value: value
        error failure: NavMesh::empty_handle()

# 0 Found, 1 Unreachable, 2 OffMesh, 3 Truncated, 9 raised.
def route_code(handle: NavMesh::Handle) -> i32:
    catch NavMesh::find_route(handle, v(1.0, 0.0, 0.0), v(39.0, 0.0, 0.0), v(1.0, 1.0, 1.0)):
        value: status_code(value.status)
        error failure: 9

def status_code(status: NavRoute::Status) -> i32:
    if status == NavRoute::Status.Found:
        0
    elif status == NavRoute::Status.Unreachable:
        1
    elif status == NavRoute::Status.OffMesh:
        2
    else:
        3

# 0 loaded, 1 unloaded, 10 stale, 11 no tile, 12 other.
def loaded_code(handle: NavMesh::Handle, tx: u32) -> i32:
    catch NavTiles::loaded(handle, tx, 0):
        value: 1 if not value else 0
        NavTiles::NavTileError.Stale: 10
        NavTiles::NavTileError.NoTile: 11
        error failure: 12

def unload_code(handle: NavMesh::Handle, tx: u32) -> i32:
    catch NavTiles::unload_tile(handle, tx, 0):
        value: 0
        NavTiles::NavTileError.Stale: 10
        NavTiles::NavTileError.NoTile: 11
        error failure: 12

def load_code(handle: NavMesh::Handle, tx: u32) -> i32:
    catch NavTiles::load_tile(handle, tx, 0):
        value: 0
        NavTiles::NavTileError.Stale: 10
        NavTiles::NavTileError.NoTile: 11
        error failure: 12

def drop_code(handle: NavMesh::Handle) -> i32:
    catch NavMesh::unload(handle):
        value: 0
        error failure: 1

def empty_info() -> NavCook::Info:
    NavCook::Info{tiles_x: 0, tiles_z: 0, tiles: 0, polygons: 0, bytes: 0, digest: 0}

def grid() -> NavCook::Info:
    catch NavCook::info():
        value: value
        error failure: empty_info()

def main() -> i32:
    NavCook::cache_clear()
    return 1 if stage_code() != 0
    mesh: NavMesh::Handle = cooked()
    return 2 if not NavMesh::live(mesh)
    info: NavCook::Info = grid()
    return 3 if info.tiles_x < 3 or info.tiles_z != 1
    middle: u32 = info.tiles_x / 2
    return 4 if route_code(mesh) != 0 or loaded_code(mesh, middle) != 0
    return 5 if unload_code(mesh, middle) != 0 or loaded_code(mesh, middle) != 1
    # The goal's tile is still loaded, so the cut leaves it unreachable.
    return 6 if route_code(mesh) != 1
    return 7 if unload_code(mesh, middle) != 11
    return 8 if load_code(mesh, middle) != 0 or loaded_code(mesh, middle) != 0
    return 9 if route_code(mesh) != 0 or load_code(mesh, middle) != 11
    # Unloading the goal's own tile leaves the goal off the mesh.
    last: u32 = info.tiles_x - 1
    return 10 if unload_code(mesh, last) != 0 or route_code(mesh) != 2
    return 11 if load_code(mesh, last) != 0 or route_code(mesh) != 0
    return 12 if loaded_code(mesh, info.tiles_x) != 11 or unload_code(mesh, info.tiles_x + 5) != 11
    plain: NavMesh::Handle = baked()
    return 13 if not NavMesh::live(plain) or unload_code(plain, 0) != 10
    return 14 if drop_code(mesh) != 0 or unload_code(mesh, middle) != 10 or loaded_code(mesh, 0) != 10
    return 15 if drop_code(plain) != 0 or NavMesh::live_count() != 0
    0
