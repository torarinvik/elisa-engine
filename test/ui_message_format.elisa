include "../src/ui/message_format.elisa"

def text(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> UiMessageFormat::Text:
    # Up to six codepoints; 0 ends the text early.
    mutable t: UiMessageFormat::Text = UiMessageFormat::Text()
    UiMessageFormat::push(&t, a) if a != 0
    UiMessageFormat::push(&t, b) if b != 0 and a != 0
    UiMessageFormat::push(&t, c) if c != 0 and b != 0 and a != 0
    UiMessageFormat::push(&t, d) if d != 0 and c != 0 and b != 0 and a != 0
    UiMessageFormat::push(&t, e) if e != 0 and d != 0 and c != 0 and b != 0 and a != 0
    UiMessageFormat::push(&t, f) if f != 0 and e != 0 and d != 0 and c != 0 and b != 0 and a != 0
    t

def same(t: UiMessageFormat::Text&, a: i64, b: i64, c: i64, d: i64) -> bool:
    n: i64 = 4 if d != 0 else (3 if c != 0 else (2 if b != 0 else (1 if a != 0 else 0)))
    return false if t.len != n
    return false if n > 0 and t.cp[0] != a
    return false if n > 1 and t.cp[1] != b
    return false if n > 2 and t.cp[2] != c
    return false if n > 3 and t.cp[3] != d
    true

def main() -> i32:
    mutable out: UiMessageFormat::Text = UiMessageFormat::Text()
    # "x{0}y" with 42 -> "x42y"; "{1}{0}" reorders arguments for a translation.
    t1: UiMessageFormat::Text = text(120, 123, 48, 125, 121, 0)
    return 1 if UiMessageFormat::format(&t1, [42, 0, 0, 0], &out) != UiMessageFormat::Result.Ok or not same(&out, 120, 52, 50, 121)
    t2: UiMessageFormat::Text = text(123, 49, 125, 123, 48, 125)
    return 2 if UiMessageFormat::format(&t2, [7, 0 - 3, 0, 0], &out) != UiMessageFormat::Result.Ok or not same(&out, 45, 51, 55, 0)
    # Malformed and out-of-range placeholders are rejected.
    t3: UiMessageFormat::Text = text(123, 52, 125, 0, 0, 0)
    return 3 if UiMessageFormat::format(&t3, [0, 0, 0, 0], &out) != UiMessageFormat::Result.BadPlaceholder
    t4: UiMessageFormat::Text = text(97, 123, 48, 0, 0, 0)
    return 4 if UiMessageFormat::format(&t4, [0, 0, 0, 0], &out) != UiMessageFormat::Result.BadPlaceholder
    t5: UiMessageFormat::Text = text(97, 125, 0, 0, 0, 0)
    return 5 if UiMessageFormat::format(&t5, [0, 0, 0, 0], &out) != UiMessageFormat::Result.BadPlaceholder
    # A result longer than the buffer overflows instead of truncating silently.
    mutable long: UiMessageFormat::Text = UiMessageFormat::Text()
    for _ in 0..<21:
        UiMessageFormat::push(&long, 123)
        UiMessageFormat::push(&long, 48)
        UiMessageFormat::push(&long, 125)
    return 6 if UiMessageFormat::format(&long, [12345, 0, 0, 0], &out) != UiMessageFormat::Result.Overflow
    # Plurals: Russian one/few/many forms pick by category; missing forms use OTHER.
    mutable p: UiMessageFormat::Plural = UiMessageFormat::Plural()
    UiMessageFormat::author(&p, UiLocale::ONE, text(123, 48, 125, 97, 0, 0))
    UiMessageFormat::author(&p, UiLocale::FEW, text(123, 48, 125, 98, 0, 0))
    UiMessageFormat::author(&p, UiLocale::OTHER, text(123, 48, 125, 99, 0, 0))
    return 7 if UiMessageFormat::format_plural(&p, UiLocale::RU, 21, &out) != UiMessageFormat::Result.Ok or not same(&out, 50, 49, 97, 0)
    return 8 if UiMessageFormat::format_plural(&p, UiLocale::RU, 3, &out) != UiMessageFormat::Result.Ok or not same(&out, 51, 98, 0, 0)
    return 9 if UiMessageFormat::pick(&p, UiLocale::RU, 5) != UiLocale::OTHER
    return 10 if UiMessageFormat::format_plural(&p, UiLocale::EN, 1, &out) != UiMessageFormat::Result.Ok or not same(&out, 49, 97, 0, 0)
    return 11 if UiMessageFormat::format_plural(&p, UiLocale::JA, 1, &out) != UiMessageFormat::Result.Ok or not same(&out, 49, 99, 0, 0)
    empty: UiMessageFormat::Plural = UiMessageFormat::Plural()
    return 12 if UiMessageFormat::format_plural(&empty, UiLocale::EN, 1, &out) != UiMessageFormat::Result.BadPlaceholder
    return 13 if UiMessageFormat::author(&p, 6, t1)
    return 0
