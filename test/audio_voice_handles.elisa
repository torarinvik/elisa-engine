include "../src/audio/runtime.elisa"

def is_live(handles: AudioRuntime::VoiceHandles::Pool&, slot: usize) -> bool:
    catch AudioRuntime::VoiceHandles::get(handles, slot):
        value: true
        error failure: false

def main() -> i32:
    handles: mutable AudioRuntime::VoiceHandles::Pool = AudioRuntime::VoiceHandles::Pool()
    voice: AudioRuntime::VoiceHandle = AudioRuntime::empty_voice()
    return 1 if not AudioRuntime::VoiceHandles::store(&handles, 1, voice)
    return 2 if not AudioRuntime::VoiceHandles::store(&handles, 2, voice)

    # A failed move into a live slot preserves both owners.
    return 3 if AudioRuntime::VoiceHandles::move(&handles, 1, 2)
    return 4 if not is_live(&handles, 1) or not is_live(&handles, 2)

    # Moving into an empty slot transfers liveness, and a self-move is a no-op.
    return 5 if not AudioRuntime::VoiceHandles::move(&handles, 1, 3)
    return 6 if is_live(&handles, 1) or not is_live(&handles, 3)
    return 7 if not AudioRuntime::VoiceHandles::move(&handles, 3, 3)
    return 8 if not is_live(&handles, 3)

    return 9 if AudioRuntime::VoiceHandles::move(&handles, 3, AudioRuntime::VoiceHandles::CAPACITY)
    return 10 if AudioRuntime::VoiceHandles::move(&handles, 0, 3)
    0
