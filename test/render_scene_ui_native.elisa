include "../src/runtime/ui_renderer.elisa"
include "../src/runtime/render_scene_image.elisa"

module RenderSceneUiNativeTests:
    private:
        struct Fixture:
            menu: mutable Ui::Menu
            theme: UiStyle::Theme
            canvas: mutable UiRenderer::MenuCanvas

        def create_fixture() -> Fixture error[RenderScene::RenderSceneError]:
            menu: mutable Ui::Menu = Ui::Menu(24, 36)
            for index in 0..<18 |menu|:
                enabled: bool = index != 1
                label: cstr = "START" if index == 0 else "LOCKED" if index == 1 else "SETTING"
                _ = Ui::menu_add_labeled(&menu, index.i64() + 1, enabled, label)
            _ = Ui::menu_set_visible(&menu, 2)
            theme: UiStyle::Theme = UiStyle::theme_default()
            background: RenderScene::OverlayPanelHandle = try RenderScene::create_overlay_panel(
                24.0, 36.0, 160.0, 40.0,
                RenderScene::Color{red: 0.0, green: 0.0, blue: 0.0, alpha: 1.0})
            focus: RenderScene::OverlayPanelHandle = try RenderScene::create_overlay_panel(
                24.0, 36.0, 160.0, 20.0,
                RenderScene::Color{red: 1.0, green: 0.5, blue: 0.0, alpha: 0.2})
            canvas: mutable UiRenderer::MenuCanvas = UiRenderer::MenuCanvas(background, focus)
            for index in 0..<18 |canvas|:
                label: RenderScene::OverlayTextHandle = try RenderScene::create_overlay_text(
                    "SETTING", 30.0, 36.0 + index.f32() * 20.0, 14,
                    RenderScene::Color{red: 1.0, green: 1.0, blue: 1.0, alpha: 1.0})
                _ = UiRenderer::menu_canvas_add_label(&canvas, label)
            try UiRenderer::sync_menu(&canvas, &menu, &theme, 160, 14)
            Fixture{menu: menu, theme: theme, canvas: canvas}

        def review_focus_and_scroll(fixture: mutable Fixture&) -> i32:
            _warm_metrics: RenderSceneText::OverlayTextMetrics = catch RenderScene::measure_overlay_text("ELISA UI", 12):
                value: value
                error failure: return 18
            same_frame_metrics: RenderSceneText::OverlayTextMetrics = catch RenderScene::measure_overlay_text("ELISA UI", 12):
                value: value
                error failure: return 29
            return 30 if same_frame_metrics.ready
            for frame in 0..<3:
                return 18 if Application::pump() != Application::PumpStatus.Running
            text_small: RenderSceneText::OverlayTextMetrics = catch RenderScene::measure_overlay_text("ELISA UI", 12):
                value: value
                error failure: return 13
            return 14 if not text_small.ready or text_small.width <= 0.0 or text_small.height <= 0.0
            measured_run: mutable UiText::Run = UiText::Run()
            return 27 if not UiRenderer::wrapped_run_add_measured_word(&measured_run,
                "ELISA", text_small)
            return 28 if UiText::word_label(measured_run, 0) != "ELISA" or UiText::word_width(measured_run, 0).f32() < text_small.width
            _warm_large: RenderSceneText::OverlayTextMetrics = catch RenderScene::measure_overlay_text("ELISA UI", 24):
                value: value
                error failure: return 19
            for frame in 0..<3:
                return 20 if Application::pump() != Application::PumpStatus.Running
            text_large: RenderSceneText::OverlayTextMetrics = catch RenderScene::measure_overlay_text("ELISA UI", 24):
                value: value
                error failure: return 15
            return 16 if not text_large.ready or text_large.width <= text_small.width or text_large.height <= text_small.height
            invalid_measure_size: i32 = catch RenderScene::measure_overlay_text("ELISA UI", 7):
                value: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 17 if invalid_measure_size != 1
            return 1 if not UiRenderer::menu_canvas_valid(&fixture.canvas, &fixture.menu)
            return 2 if UiRenderer::menu_canvas_label_count(&fixture.canvas) != 18
            return 3 if not Ui::focus_next(&fixture.menu) or fixture.menu.focus != 2 or fixture.menu.scroll != 1
            scrolled: i32 = catch UiRenderer::sync_menu(&fixture.canvas,
                &fixture.menu, &fixture.theme, 160, 14):
                ok: 0
                error failure: 4
            return 5 if scrolled != 0
            # Repositioning and restyling the retained view must be reflected
            # without recreating its native handles.
            fixture.menu.y <- 100
            fixture.theme.background <- UiStyle::Color(90, 8, 8, 255)
            moved: i32 = catch UiRenderer::sync_menu(&fixture.canvas,
                &fixture.menu, &fixture.theme, 280, 14):
                ok: 0
                error failure: 6
            return 7 if moved != 0
            # A full settings page also fits inside the renderer's bounded
            # layout and retains one label per item.
            _ = Ui::menu_set_visible(&fixture.menu, 18)
            full_page: i32 = catch UiRenderer::sync_menu(&fixture.canvas,
                &fixture.menu, &fixture.theme, 280, 14):
                ok: 0
                error failure: 8
            return 9 if full_page != 0
            # A clip that cuts the page keeps only whole rows and hides the
            # panels entirely when nothing of the menu is inside.
            clipped: i32 = catch UiRenderer::sync_menu_clipped(&fixture.canvas,
                &fixture.menu, &fixture.theme, 280, 14, UiClip::box(0, 100, 400, 50)):
                ok: 0
                error failure: 30
            return 31 if clipped != 0
            outside: i32 = catch UiRenderer::sync_menu_clipped(&fixture.canvas,
                &fixture.menu, &fixture.theme, 280, 14, UiClip::box(2000, 2000, 10, 10)):
                ok: 0
                error failure: 32
            return 33 if outside != 0
            for frame in 0..<3:
                return 12 if Application::pump() != Application::PumpStatus.Running
            invalid: i32 = catch UiRenderer::sync_menu(&fixture.canvas,
                &fixture.menu, &fixture.theme, 160, 32):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 10
            return 11 if invalid != 1
            run: mutable UiText::Run = UiText::Run()
            _ = UiText::run_add_labeled_word(&run, 50, "ELECTRIC")
            _ = UiText::run_add_labeled_word(&run, 40, "FENCE")
            _ = UiText::run_add_labeled_word(&run, 30, "MAZE")
            _ = UiText::run_add_labeled_word(&run, 35, "ROUTE")
            wrapped: UiText::Wrapped = UiText::wrap(run, 90, 8)
            return 21 if not UiText::wrapped_matches_run(&wrapped, run)
            return 22 if wrapped.line_count != 3 or UiText::line_start(wrapped, 1) != 1 or UiText::line_start(wrapped, 2) != 3
            word_canvas: mutable UiRenderer::WrappedCanvas = UiRenderer::WrappedCanvas()
            for index in 0..<UiRenderer::menu_canvas_label_count(&fixture.canvas) |word_canvas, fixture|:
                _ = UiRenderer::wrapped_canvas_add_label(&word_canvas,
                    fixture.canvas.labels[index])
            wrapped_sync: i32 = catch UiRenderer::sync_wrapped(&word_canvas,
                run, fixture.theme, 32, 40, 90, 12, 18, 8):
                ok: 0
                error failure: 23
            return 24 if wrapped_sync != 0
            empty_run: UiText::Run = UiText::Run()
            empty_sync: i32 = catch UiRenderer::sync_wrapped(&word_canvas,
                empty_run, fixture.theme, 32, 40, 90, 12, 18, 8):
                ok: 0
                error failure: 25
            return 26 if empty_sync != 0
            0

        def destroy_fixture(fixture: mutable Fixture&) -> i32:
            for index in 0..<UiRenderer::menu_canvas_label_count(&fixture.canvas):
                label: RenderScene::OverlayTextHandle = fixture.canvas.labels[index]
                destroyed: i32 = catch RenderScene::destroy_overlay_text(label):
                    ok: 0
                    error failure: 1
                return 8 if destroyed != 0
            focus_destroyed: i32 = catch RenderScene::destroy_overlay_panel(fixture.canvas.focus_band):
                ok: 0
                error failure: 1
            return 9 if focus_destroyed != 0
            background_destroyed: i32 = catch RenderScene::destroy_overlay_panel(fixture.canvas.background):
                ok: 0
                error failure: 1
            return 10 if background_destroyed != 0
            0

    public:
        def exercise_viewport_overlays() -> i32:
            camera: RenderScene::CameraHandle = catch RenderScene::create_camera(
                RenderScene::CameraProjection.Perspective, 160, 200,
                0.7853982, 0.1, 100.0):
                value: value
                error failure: return 30
            panel: RenderScene::OverlayPanelHandle = catch RenderScene::create_overlay_panel(
                12.0, 12.0, 100.0, 32.0,
                RenderScene::Color{red: 0.0, green: 0.1, blue: 0.3, alpha: 0.8}):
                value: value
                error failure: return 31
            label: RenderScene::OverlayTextHandle = catch RenderScene::create_overlay_text(
                "PLAYER TWO", 20.0, 20.0, 14,
                RenderScene::Color{red: 1.0, green: 1.0, blue: 1.0, alpha: 1.0}):
                value: value
                error failure: return 32
            image: RenderScene::OverlayImageHandle = catch RenderScene::create_overlay_image(
                "test/fixtures/glyph_atlas.png", 40.0, 20.0, 24.0, 24.0):
                value: value
                error failure: return 33
            before_viewport: i32 = catch RenderScene::set_overlay_text_camera(label, camera):
                ok: 0
                RenderScene::RenderSceneError.BackendFailure: 1
                error failure: 2
            return 34 if before_viewport != 1
            viewport: i32 = catch RenderScene::set_camera_viewport(camera,
                160, 0, 160, 200, 0.0):
                ok: 0
                error failure: 3
            return 35 if viewport != 0
            panel_camera: i32 = catch RenderScene::set_overlay_panel_camera(panel, camera):
                ok: 0
                error failure: 4
            return 36 if panel_camera != 0
            text_camera: i32 = catch RenderScene::set_overlay_text_camera(label, camera):
                ok: 0
                error failure: 5
            return 37 if text_camera != 0
            image_camera: i32 = catch RenderScene::set_overlay_image_camera(image, camera):
                ok: 0
                error failure: 5
            return 38 if image_camera != 0
            pumped: mutable i32 = 0
            for frame in 0..<2:
                pumped <- 1 if Application::pump() != Application::PumpStatus.Running
            return 39 if pumped != 0

            # Moving one widget back to the primary path must be reversible.
            cleared_panel_owner: i32 = catch RenderScene::clear_overlay_panel_camera(panel):
                ok: 0
                error failure: 46
            return 47 if cleared_panel_owner != 0
            cleared_text_owner: i32 = catch RenderScene::clear_overlay_text_camera(label):
                ok: 0
                error failure: 48
            return 49 if cleared_text_owner != 0
            cleared_image_owner: i32 = catch RenderScene::clear_overlay_image_camera(image):
                ok: 0
                error failure: 50
            return 51 if cleared_image_owner != 0
            reattached_panel: i32 = catch RenderScene::set_overlay_panel_camera(panel, camera):
                ok: 0
                error failure: 52
            return 53 if reattached_panel != 0
            reattached_text: i32 = catch RenderScene::set_overlay_text_camera(label, camera):
                ok: 0
                error failure: 54
            return 55 if reattached_text != 0
            reattached_image: i32 = catch RenderScene::set_overlay_image_camera(image, camera):
                ok: 0
                error failure: 56
            return 57 if reattached_image != 0
            pumped_after_rebind: mutable i32 = 0
            for frame in 0..<2:
                pumped_after_rebind <- 1 if Application::pump() != Application::PumpStatus.Running
            return 58 if pumped_after_rebind != 0

            # The game destroys a secondary path when returning to solo and
            # creates it again on the next race. Widgets must survive that
            # transition, not retain the destroyed RenderPath pointer.
            cleared: i32 = catch RenderScene::clear_camera_viewport(camera):
                ok: 0
                error failure: 59
            return 40 if cleared != 0
            restored_viewport: i32 = catch RenderScene::set_camera_viewport(camera,
                160, 0, 160, 200, 0.0):
                ok: 0
                error failure: 60
            return 61 if restored_viewport != 0
            restored_panel: i32 = catch RenderScene::set_overlay_panel_camera(panel, camera):
                ok: 0
                error failure: 62
            return 63 if restored_panel != 0
            restored_text: i32 = catch RenderScene::set_overlay_text_camera(label, camera):
                ok: 0
                error failure: 64
            return 65 if restored_text != 0
            restored_image: i32 = catch RenderScene::set_overlay_image_camera(image, camera):
                ok: 0
                error failure: 66
            return 67 if restored_image != 0
            pumped_after_viewport_recreate: mutable i32 = 0
            for frame in 0..<2:
                pumped_after_viewport_recreate <- 1 if Application::pump() != Application::PumpStatus.Running
            return 68 if pumped_after_viewport_recreate != 0
            cleared_again: i32 = catch RenderScene::clear_camera_viewport(camera):
                ok: 0
                error failure: 69
            return 70 if cleared_again != 0
            destroyed_image: i32 = catch RenderScene::destroy_overlay_image(image):
                ok: 0
                error failure: 8
            return 41 if destroyed_image != 0
            destroyed_text: i32 = catch RenderScene::destroy_overlay_text(label):
                ok: 0
                error failure: 7
            return 42 if destroyed_text != 0
            destroyed_panel: i32 = catch RenderScene::destroy_overlay_panel(panel):
                ok: 0
                error failure: 8
            return 43 if destroyed_panel != 0
            destroyed_camera: i32 = catch RenderScene::destroy_camera(camera):
                ok: 0
                error failure: 9
            return 44 if destroyed_camera != 0
            0

        def exercise() -> i32:
            viewport_status: i32 = exercise_viewport_overlays()
            return 45 + viewport_status if viewport_status != 0
            fixture: mutable Fixture = catch create_fixture():
                value: value
                error failure: return 11
            focus_status: i32 = review_focus_and_scroll(&fixture)
            return 12 + focus_status if focus_status != 0
            destroy_status: i32 = destroy_fixture(&fixture)
            return 26 + destroy_status if destroy_status != 0
            0
