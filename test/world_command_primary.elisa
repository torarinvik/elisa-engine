include "../src/world/commands.elisa"

def main() -> i32 can[Global.Read, Global.Write]:
    can Global.Read, Global.Write:
        world: mutable World::World = catch World::World():
            value: value
            error failure: return 1
        parent: World::EntityRef = catch World::world_spawn(&world, World::Actor.Player):
            value: value
            error failure: return 2
        child: World::EntityRef = catch World::world_spawn(&world, World::Enemy.Guard):
            value: value
            error failure: return 3
        identity: Geometry::Transform = Geometry::transform_identity()
        parent_pose: Geometry::Transform = Geometry::transform_translate(
            identity, Geometry::Vec3{x: 5.0, y: 0.0, z: 0.0})
        child_pose: Geometry::Transform = Geometry::transform_translate(
            identity, Geometry::Vec3{x: 2.0, y: 0.0, z: 0.0})
        parent_status: bool = catch World::world_set_transform(&world, parent, parent_pose):
            ok: true
            error failure: false
        child_status: bool = catch World::world_set_transform(&world, child, child_pose):
            ok: true
            error failure: false
        return 4 if not parent_status or not child_status

        reparent: mutable WorldCommands::WorldBuffer = WorldCommands::WorldBuffer()
        return 27 if not WorldCommands::world_reparent(&reparent, child, parent, false)
        return 5 if not WorldCommands::commit_world(&reparent, &world)
        return 6 if not World::world_is_valid(&world)
        return 7 if WorldCommands::world_command_count(&reparent) != 0
        moved: mutable Geometry::Transform = Geometry::transform_identity()
        return 8 if not World::world_try_transform(&world, child, &moved) or moved.position.x != 7.0
        return 9 if World::world_hierarchy_count(&world) != World::world_live_count(&world)

        cycle: mutable WorldCommands::WorldBuffer = WorldCommands::WorldBuffer()
        return 11 if not WorldCommands::world_reparent(&cycle, parent, child, false)
        return 12 if WorldCommands::commit_world(&cycle, &world)
        return 13 if WorldCommands::world_command_count(&cycle) != 1 or not World::world_is_valid(&world)
        spawn: mutable WorldCommands::WorldBuffer = WorldCommands::WorldBuffer()
        return 28 if not WorldCommands::world_spawn(&spawn, World::StaticObject.Structure)
        return 29 if WorldCommands::world_command_count(&spawn) != 1
        return 30 if not WorldCommands::commit_world(&spawn, &world)
        return 10 if World::world_live_count(&world) != 3

        duplicate: mutable WorldCommands::WorldBuffer = WorldCommands::WorldBuffer()
        return 31 if not WorldCommands::world_despawn(&duplicate, child)
        return 32 if not WorldCommands::world_despawn(&duplicate, child)
        return 33 if WorldCommands::commit_world(&duplicate, &world)
        return 14 if WorldCommands::world_command_count(&duplicate) != 2 or World::world_live_count(&world) != 3

        wrong_epoch: World::EntityRef = World::EntityRef{world_epoch: World::world_epoch(&world) + 1, id: child.id}
        invalid_despawn: mutable WorldCommands::WorldBuffer = WorldCommands::WorldBuffer()
        return 15 if not WorldCommands::world_despawn(&invalid_despawn, wrong_epoch)
        return 16 if WorldCommands::commit_world(&invalid_despawn, &world)
        return 17 if WorldCommands::world_command_count(&invalid_despawn) != 1 or World::world_live_count(&world) != 3

        valid_despawn: mutable WorldCommands::WorldBuffer = WorldCommands::WorldBuffer()
        return 18 if not WorldCommands::world_despawn(&valid_despawn, child)
        return 19 if not WorldCommands::commit_world(&valid_despawn, &world)
        return 20 if World::world_live_count(&world) != 2 or not World::world_is_valid(&world)

        mixed: mutable WorldCommands::WorldBuffer = WorldCommands::WorldBuffer()
        return 21 if not WorldCommands::world_spawn(&mixed, World::Actor.Player)
        invalid_child: World::EntityRef = World::EntityRef{world_epoch: World::world_epoch(&world) + 1, id: parent.id}
        return 22 if not WorldCommands::world_reparent(&mixed, invalid_child, parent, false)
        return 23 if WorldCommands::commit_world(&mixed, &world)
        return 24 if WorldCommands::world_command_count(&mixed) != 2
        return 25 if World::world_live_count(&world) != 2
        return 26 if not World::world_is_valid(&world)

        near_capacity: mutable World::World = catch World::World():
            value: value
            error failure: return 34
        for step in 0..<(World::MAX_ENTITIES - 1) |near_capacity|:
            _ = catch World::world_spawn(&near_capacity, World::Actor.Player):
                value: 0
                error failure: return 35
        capacity_revision: i64 = World::world_structure_revision(&near_capacity)
        capacity_last_id: i64 = World::world_last_issued(&near_capacity)
        capacity_batch: mutable WorldCommands::WorldBuffer = WorldCommands::WorldBuffer()
        return 36 if not WorldCommands::world_spawn(&capacity_batch, World::Enemy.Guard)
        return 37 if not WorldCommands::world_spawn(&capacity_batch, World::StaticObject.Structure)
        rejected_capacity_batch: bool = WorldCommands::commit_world(&capacity_batch, &near_capacity)
        return 38 if rejected_capacity_batch
        return 39 if WorldCommands::world_command_count(&capacity_batch) != 2
        return 40 if World::world_live_count(&near_capacity) != World::MAX_ENTITIES - 1
        return 41 if World::world_last_issued(&near_capacity) != capacity_last_id
        return 42 if World::world_structure_revision(&near_capacity) != capacity_revision
        return 43 if not World::world_is_valid(&near_capacity)
        return 0
