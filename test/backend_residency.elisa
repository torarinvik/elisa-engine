include "../src/backend/residency.elisa"

def main() -> i32:
    return 1 if BackendResidency::mip_bytes(4096, 0) != 4096 or BackendResidency::mip_bytes(4096, 2) != 256 or BackendResidency::mip_bytes(8, 5) != 1
    p: BackendResidency::Pool = BackendResidency::make(6000)
    a: i64 = BackendResidency::add(&p, 4096, 4)
    b: i64 = BackendResidency::add(&p, 4096, 4)
    return 2 if a != 0 or b != 1
    # Only the coarsest mip (64 bytes) of each is resident at first.
    return 3 if BackendResidency::total(&p) != 128 or p.resident[0] != 3
    # Bad registrations are refused.
    return 4 if BackendResidency::add(&p, 0, 3) != -1 or BackendResidency::add(&p, 100, 0) != -1 or BackendResidency::add(&p, 100, 7) != -1
    # Demand for full detail streams in one mip per frame.
    BackendResidency::want(&p, 0, 0)
    sent: i64 = BackendResidency::step(&p, 100000)
    return 5 if sent != 256 or p.resident[0] != 2
    BackendResidency::step(&p, 100000)
    return 6 if p.resident[0] != 1 or BackendResidency::total(&p) != 64 + 256 + 1024 + 64
    # Upload budget bounds a frame: the 4096-byte mip 0 does not fit in 500.
    return 7 if BackendResidency::step(&p, 500) != 0 or p.resident[0] != 1
    return 8 if BackendResidency::step(&p, 4096) != 4096 or p.resident[0] != 0
    # Total 4096+1024+256+64 + 64 = 5504 within the 6000 budget.
    return 9 if BackendResidency::total(&p) != 5504
    # A second hungry texture cannot exceed the budget; its coarsest stays.
    BackendResidency::want(&p, 1, 0)
    for n in 0..<5:
        BackendResidency::step(&p, 100000)
    return 10 if BackendResidency::total(&p) > 6000 or p.resident[1] > 3
    # Losing demand on texture 0 evicts its surplus detail when over budget.
    BackendResidency::want(&p, 0, 3)
    tight: BackendResidency::Pool = BackendResidency::make(1500)
    BackendResidency::add(&tight, 4096, 4)
    BackendResidency::want(&tight, 0, 0)
    BackendResidency::step(&tight, 100000)
    BackendResidency::step(&tight, 100000)
    return 11 if BackendResidency::total(&tight) != 64 + 256 + 1024
    # Shrinking demand evicts only when over budget; the coarsest never goes.
    BackendResidency::want(&tight, 0, 5)
    return 12 if tight.wanted[0] != 3
    small: BackendResidency::Pool = BackendResidency::make(100)
    return 13 if BackendResidency::add(&small, 4096, 4) != 0 or BackendResidency::add(&small, 4096, 4) != -1
    return 14 if BackendResidency::want(&small, 3, 0)
    return 0
