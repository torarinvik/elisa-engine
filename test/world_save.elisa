include "../src/world/world_save.elisa"

def near(a: f32, b: f32) -> bool:
    d: f32 = a - b
    d < 0.001 and d > -0.001

def reseal(bytes: mutable u8&, length: usize):
    mutable hash: u64 = 2166136261
    for index in 16..<length |hash, bytes|:
        hash <- ((hash ^ bytes[index].u64()) * 16777619) & 4294967295
    bytes[12] <- (hash & 255).u8()
    bytes[13] <- ((hash >> 8) & 255).u8()
    bytes[14] <- ((hash >> 16) & 255).u8()
    bytes[15] <- ((hash >> 24) & 255).u8()

def main() -> i32 can[Global.Read, Global.Write]:
    can Global.Read, Global.Write:
        world: mutable World::World = catch World::World():
            value: value
            error failure: return 1
        player: World::EntityRef = catch World::world_spawn(&world, World::Actor.Player):
            value: value
            error failure: return 2
        guard: World::EntityRef = catch World::world_spawn(&world, World::Enemy.Guard):
            value: value
            error failure: return 2
        crate: World::EntityRef = catch World::world_spawn(&world, World::StaticObject.Structure):
            value: value
            error failure: return 2
        identity: Geometry::Transform = Geometry::transform_identity()
        ok1: bool = catch World::world_set_transform(&world, player, Geometry::transform_translate(identity, Geometry::Vec3{x: 5.0, y: 1.0, z: 0.0})):
            ok: true
            error failure: false
        ok2: bool = catch World::world_set_transform(&world, guard, Geometry::transform_translate(identity, Geometry::Vec3{x: 7.0, y: 0.0, z: -2.0})):
            ok: true
            error failure: false
        ok3: bool = catch World::world_reparent(&world, guard, player, true):
            ok: true
            error failure: false
        ok4: bool = catch World::world_actor_set_health(&world, player, 42):
            ok: true
            error failure: false
        ok5: bool = catch World::world_enemy_set_threat(&world, guard, 7):
            ok: true
            error failure: false
        return 3 if not ok1 or not ok2 or not ok3 or not ok4 or not ok5
        # A despawned entity leaves no record.
        ghost: World::EntityRef = catch World::world_spawn(&world, World::StaticObject.Structure):
            value: value
            error failure: return 4
        gone: bool = catch World::world_despawn(&world, ghost):
            ok: true
            error failure: false
        return 4 if not gone

        bytes: mutable u8[World::SaveGame::MAX_BYTES] = zeroed
        length: usize = catch World::SaveGame::save_world(&world, &bytes[0], World::SaveGame::MAX_BYTES):
            value: value
            error failure: 0
        return 5 if length != 16 + 3 * 56
        small: usize = catch World::SaveGame::save_world(&world, &bytes[0], 100):
            value: value
            error failure: 0
        return 6 if small != 0

        loaded: mutable World::World = catch World::World():
            value: value
            error failure: return 7
        restored: bool = catch World::SaveGame::load_world(&loaded, &bytes[0], length):
            ok: true
            error failure: false
        return 7 if not restored
        # Loading twice into the same staging world is refused.
        again: bool = catch World::SaveGame::load_world(&loaded, &bytes[0], length):
            ok: true
            error failure: false
        return 7 if again or World::world_live_count(&loaded) != 3
        return 8 if World::world_live_count(&loaded) != 3 or World::world_epoch(&loaded) == World::world_epoch(&world)
        return 9 if World::world_actor_count(&loaded) != 1 or World::world_enemy_count(&loaded) != 1 or World::world_static_object_count(&loaded) != 1
        mutable new_player: World::EntityRef = World::EntityRef{world_epoch: 0, id: 0}
        mutable new_guard: World::EntityRef = World::EntityRef{world_epoch: 0, id: 0}
        for index in 0..<World::world_live_ids_count(&loaded) |loaded, new_player, new_guard|:
            reference: World::EntityRef = catch World::world_live_reference_at(&loaded, index):
                value: value
                error failure: World::EntityRef{world_epoch: 0, id: 0}
            found: World::EntityLookup = catch World::world_lookup(&loaded, reference):
                value: value
                error failure: World::EntityLookup{reference: reference, kind: World::Entity.Unknown}
            new_player <- reference if found.kind == World::Actor.Player else new_player
            new_guard <- reference if found.kind == World::Enemy.Guard else new_guard
        return 10 if new_player.id == 0 or new_guard.id == 0
        pose: mutable Geometry::Transform = Geometry::transform_identity()
        return 11 if not World::world_try_transform(&loaded, new_guard, &pose) or not near(pose.position.x, 7.0) or not near(pose.position.z, -2.0)
        # The guard is still the player's child: the reverse link would cycle.
        return 12 if World::world_can_reparent(&loaded, new_player, new_guard)
        hero: World::ActorRecord = catch World::world_actor_record(&loaded, new_player):
            value: value
            error failure: return 13
        foe: World::EnemyRecord = catch World::world_enemy_record(&loaded, new_guard):
            value: value
            error failure: return 13
        return 13 if hero.health != 42 or foe.threat != 7

        # A flipped byte fails the checksum; a new version, a truncated payload
        # and a checksummed parent cycle are all rejected, and the live world
        # is untouched.
        bytes[40] <- bytes[40] ^ 1u8
        stage1: mutable World::World = catch World::World():
            value: value
            error failure: return 14
        corrupt: i32 = catch World::SaveGame::load_world(&stage1, &bytes[0], length):
            ok: 0
            error failure: 14
        bytes[40] <- bytes[40] ^ 1u8
        return 14 if corrupt == 0
        bytes[4] <- 2u8
        newer: i32 = catch World::SaveGame::check_world_save(&bytes[0], length):
            value: 0
            error failure: 15
        bytes[4] <- 1u8
        return 15 if newer == 0
        short: i32 = catch World::SaveGame::check_world_save(&bytes[0], length - 1):
            value: 0
            error failure: 16
        return 16 if short == 0
        # Records 1 and 2 (player, guard) point at each other.
        bytes[20] <- 2u8
        reseal(&bytes[0], length)
        stage2: mutable World::World = catch World::World():
            value: value
            error failure: return 17
        cycle: i32 = catch World::SaveGame::load_world(&stage2, &bytes[0], length):
            ok: 0
            error failure: 17
        return 17 if cycle == 0 or World::world_live_count(&world) != 3
        bytes[20] <- 0u8
        reseal(&bytes[0], length)
        # An older version, an oversized length and a record count larger than
        # the payload (resealed, so only the count is wrong) are rejected.
        bytes[4] <- 0u8
        older: i32 = catch World::SaveGame::check_world_save(&bytes[0], length):
            value: 0
            error failure: 18
        bytes[4] <- 1u8
        return 18 if older == 0
        oversized: i32 = catch World::SaveGame::check_world_save(&bytes[0], World::SaveGame::MAX_BYTES + 1):
            value: 0
            error failure: 19
        return 19 if oversized == 0
        bytes[8] <- 4u8
        reseal(&bytes[0], length)
        inflated: i32 = catch World::SaveGame::check_world_save(&bytes[0], length):
            value: 0
            error failure: 20
        return 20 if inflated == 0
        bytes[8] <- 3u8
        reseal(&bytes[0], length)
        intact: i32 = catch World::SaveGame::check_world_save(&bytes[0], length):
            value: 0
            error failure: 21
        return 21 if intact != 0
        return 0
