# Native smoke coverage for the public Wicked emitter and decal bridge.
include "../src/runtime/world_effects.elisa"
extend RenderScene:
    public:
        def native_smoke_emitter_handle(handle: EmitterHandle) -> i64:
            handle.native_value
        def native_smoke_decal_handle(handle: DecalHandle) -> i64:
            handle.native_value

module RenderSceneEffectsNativeTests:
    private:
        const MAX_PARTICLES: u32 = 128
        const COUNT: f32 = 12.0
        const LIFETIME: f32 = 2.5
        const SIZE: f32 = 0.75
        const RANGE: f32 = 3.0
        const SLOPE_BLEND: f32 = 1.25

        @callconv(c)
        extern elisa_render_scene_v1_test_effect_emitter(handle: i64,
            max_particles: u32, count: f32, lifetime: f32, size: f32,
            velocity_x: f32, velocity_y: f32, velocity_z: f32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_effect_decal(handle: i64,
            red: f32, green: f32, blue: f32, alpha: f32,
            range: f32, slope_blend: f32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_effect_position(handle: i64,
            px: f32, py: f32, pz: f32) -> i32

    public:
        def exercise() -> i32:
            position: Geometry::Vec3 = Geometry::Vec3{x: 2.0, y: 3.0, z: -1.0}
            velocity: Geometry::Vec3 = Geometry::Vec3{x: 0.0, y: 4.0, z: 1.0}
            color: RenderScene::Color = RenderScene::Color{red: 0.7, green: 0.2, blue: 0.9, alpha: 0.5}
            emitter: RenderScene::EmitterHandle = catch RenderScene::create_emitter(
                RenderScene::Emitter(position, MAX_PARTICLES, COUNT, LIFETIME, SIZE, velocity)):
                value: value
                error failure: return 1
            raw_emitter: i64 = RenderScene::native_smoke_emitter_handle(emitter)
            return 2 if elisa_render_scene_v1_test_effect_emitter(raw_emitter,
                MAX_PARTICLES, COUNT, LIFETIME, SIZE, velocity.x, velocity.y, velocity.z) != 1
            invalid_tick: i32 = catch RenderScene::tick_emitter(emitter, -1.0):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 3 if invalid_tick != 1
            ticked: i32 = catch RenderScene::tick_emitter(emitter, 1.0 / 60.0):
                ok: 0
                error failure: 1
            return 4 if ticked != 0

            decal: RenderScene::DecalHandle = catch RenderScene::create_decal(
                RenderScene::Decal(position, color, RANGE, SLOPE_BLEND)):
                value: value
                error failure: return 5
            raw_decal: i64 = RenderScene::native_smoke_decal_handle(decal)
            return 6 if elisa_render_scene_v1_test_effect_decal(raw_decal,
                color.red, color.green, color.blue, color.alpha, RANGE, SLOPE_BLEND) != 1
            invalid_update: i32 = catch RenderScene::update_decal(decal,
                RenderScene::Decal(position, color, 0.0, SLOPE_BLEND)):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 7 if invalid_update != 1
            updated_color: RenderScene::Color = RenderScene::Color{red: 0.1, green: 0.8, blue: 0.4, alpha: 1.0}
            updated: i32 = catch RenderScene::update_decal(decal,
                RenderScene::Decal(position, updated_color, 4.0, 0.5)):
                ok: 0
                error failure: 1
            return 8 if updated != 0 or elisa_render_scene_v1_test_effect_decal(raw_decal,
                updated_color.red, updated_color.green, updated_color.blue, updated_color.alpha, 4.0, 0.5) != 1
            destroyed_decal: i32 = catch RenderScene::destroy_decal(decal):
                ok: 0
                error failure: 1
            return 9 if destroyed_decal != 0
            stale_decal: i32 = catch RenderScene::destroy_decal(decal):
                ok: 0
                RenderScene::RenderSceneError.UnknownHandle: 1
                error failure: 2
            return 10 if stale_decal != 1
            destroyed_emitter: i32 = catch RenderScene::destroy_emitter(emitter):
                ok: 0
                error failure: 1
            return 11 if destroyed_emitter != 0

            world: World::World = catch World::World():
                value: value
                error failure: return 12
            entity: World::EntityRef = catch World::world_spawn(&world, World::Actor.Player):
                value: value
                error failure: return 13
            initial_transform: i32 = catch World::world_set_transform(&world, entity, Geometry::Transform{
                position: Geometry::Vec3{x: 1.0, y: 2.0, z: 3.0},
                rotation: Geometry::quat_identity(),
                scale: Geometry::vec3_one(),
            }):
                ok: 0
                error failure: 1
            return 14 if initial_transform != 0
            effects: WorldEffects::Effects = WorldEffects::Effects()
            attached_emitter: i32 = catch WorldEffects::spawn_emitter(&world, &effects, entity,
                RenderScene::Emitter(Geometry::vec3_zero(), 32, 4.0, 1.0, 0.5,
                    Geometry::Vec3{x: 0.0, y: 1.0, z: 0.0})):
                ok: 0
                error failure: return 15
            return 16 if attached_emitter != 0 or WorldEffects::binding_count(&effects) != 1
            attached_decal: i32 = catch WorldEffects::spawn_decal(&world, &effects, entity,
                RenderScene::Decal(Geometry::vec3_zero(), color, 2.0, 0.25)):
                ok: 0
                error failure: return 17
            return 18 if attached_decal != 0 or WorldEffects::binding_count(&effects) != 1
            scale_status: i32 = catch WorldEffects::set_time_scale(&effects, entity, 0.5):
                ok: 0
                error failure: 1
            return 19 if scale_status != 0
            moved_transform: i32 = catch World::world_set_transform(&world, entity, Geometry::Transform{
                position: Geometry::Vec3{x: 4.0, y: 5.0, z: 6.0},
                rotation: Geometry::quat_identity(),
                scale: Geometry::vec3_one(),
            }):
                ok: 0
                error failure: 1
            return 20 if moved_transform != 0
            report: WorldEffects::UpdateReport = catch WorldEffects::update(&world, &effects, 0.5):
                value: value
                error failure: return 21
            emitter_after_move: RenderScene::EmitterHandle = catch WorldEffects::emitter_handle(&effects, entity):
                value: value
                error failure: return 22
            raw_emitter_after_move: i64 = RenderScene::native_smoke_emitter_handle(emitter_after_move)
            return 23 if report.updated != 1 or elisa_render_scene_v1_test_effect_position(
                raw_emitter_after_move, 4.0, 5.0, 6.0) != 1
            despawn_status: i32 = catch World::world_despawn(&world, entity):
                ok: 0
                error failure: 1
            return 24 if despawn_status != 0
            despawn_report: WorldEffects::UpdateReport = catch WorldEffects::update(&world, &effects, 0.1):
                value: value
                error failure: return 25
            return 26 if despawn_report.detached_despawned != 1 or WorldEffects::binding_count(&effects) != 0
            0
