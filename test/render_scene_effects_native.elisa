# Native smoke coverage for the public Wicked emitter and decal bridge.
include "../src/runtime/world_effects.elisa"
extend RenderScene:
    public:
        def native_smoke_emitter_handle(handle: EmitterHandle) -> i64:
            handle.native_value
        def native_smoke_emitter_from_handle(handle: i64) -> EmitterHandle:
            EmitterHandle{native_value: handle}
        def native_smoke_decal_handle(handle: DecalHandle) -> i64:
            handle.native_value

module RenderSceneEffectsNativeTests:
    private:
        const MAX_PARTICLES: u32 = 128
        const COUNT: f32 = 12.0
        const LIFETIME: f32 = 2.5
        const SIZE: f32 = 0.75
        const RANGE: f32 = 3.0
        const SLOPE_BLEND: f32 = 1.25

        @callconv(c)
        extern elisa_render_scene_v1_test_effect_emitter(handle: i64,
            max_particles: u32, count: f32, lifetime: f32, size: f32,
            velocity_x: f32, velocity_y: f32, velocity_z: f32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_effect_decal(handle: i64,
            qx: f32, qy: f32, qz: f32, qw: f32,
            red: f32, green: f32, blue: f32, alpha: f32,
            range: f32, slope_blend: f32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_effect_position(handle: i64,
            px: f32, py: f32, pz: f32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_effect_component_count(kind: i32) -> i32

    public:
        def native_effect_baseline_is_empty() -> bool:
            elisa_render_scene_v1_test_effect_component_count(0) == 0 and elisa_render_scene_v1_test_effect_component_count(1) == 0

        def native_effect_counts_are(emitters: i32, decals: i32) -> bool:
            elisa_render_scene_v1_test_effect_component_count(0) == emitters and elisa_render_scene_v1_test_effect_component_count(1) == decals

        def exercise() -> i32:
            position: Geometry::Vec3 = Geometry::Vec3{x: 2.0, y: 3.0, z: -1.0}
            velocity: Geometry::Vec3 = Geometry::Vec3{x: 0.0, y: 4.0, z: 1.0}
            identity_rotation: Geometry::Quat = Geometry::quat_identity()
            updated_rotation: Geometry::Quat = Geometry::Quat{x: 0.0, y: 1.0, z: 0.0, w: 0.0}
            color: RenderScene::Color = RenderScene::Color{red: 0.7, green: 0.2, blue: 0.9, alpha: 0.5}
            emitter: RenderScene::EmitterHandle = catch RenderScene::create_emitter(
                RenderScene::Emitter(position, MAX_PARTICLES, COUNT, LIFETIME, SIZE, velocity)):
                value: value
                error failure: return 1
            raw_emitter: i64 = RenderScene::native_smoke_emitter_handle(emitter)
            return 2 if elisa_render_scene_v1_test_effect_emitter(raw_emitter,
                MAX_PARTICLES, COUNT, LIFETIME, SIZE, velocity.x, velocity.y, velocity.z) != 1
            invalid_tick: i32 = catch RenderScene::tick_emitter(emitter, -1.0):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 3 if invalid_tick != 1
            ticked: i32 = catch RenderScene::tick_emitter(emitter, 1.0 / 60.0):
                ok: 0
                error failure: 1
            return 4 if ticked != 0

            decal: RenderScene::DecalHandle = catch RenderScene::create_decal(
                RenderScene::Decal(position, identity_rotation, color, RANGE, SLOPE_BLEND)):
                value: value
                error failure: return 5
            raw_decal: i64 = RenderScene::native_smoke_decal_handle(decal)
            return 6 if elisa_render_scene_v1_test_effect_decal(raw_decal,
                identity_rotation.x, identity_rotation.y, identity_rotation.z, identity_rotation.w,
                color.red, color.green, color.blue, color.alpha, RANGE, SLOPE_BLEND) != 1
            invalid_update: i32 = catch RenderScene::update_decal(decal,
                RenderScene::Decal(position, identity_rotation, color, 0.0, SLOPE_BLEND)):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 7 if invalid_update != 1
            updated_color: RenderScene::Color = RenderScene::Color{red: 0.1, green: 0.8, blue: 0.4, alpha: 1.0}
            updated: i32 = catch RenderScene::update_decal(decal,
                RenderScene::Decal(position, updated_rotation, updated_color, 4.0, 0.5)):
                ok: 0
                error failure: 1
            return 8 if updated != 0 or elisa_render_scene_v1_test_effect_decal(raw_decal,
                updated_rotation.x, updated_rotation.y, updated_rotation.z, updated_rotation.w,
                updated_color.red, updated_color.green, updated_color.blue, updated_color.alpha, 4.0, 0.5) != 1
            destroyed_decal: i32 = catch RenderScene::destroy_decal(decal):
                ok: 0
                error failure: 1
            return 9 if destroyed_decal != 0
            stale_decal: i32 = catch RenderScene::destroy_decal(decal):
                ok: 0
                RenderScene::RenderSceneError.UnknownHandle: 1
                error failure: 2
            return 10 if stale_decal != 1
            destroyed_emitter: i32 = catch RenderScene::destroy_emitter(emitter):
                ok: 0
                error failure: 1
            return 11 if destroyed_emitter != 0
            return 27 if not native_effect_baseline_is_empty()

            pool: mutable i64[RenderSceneEffects::MAX_EFFECTS] = zeroed
            for index in 0..<RenderSceneEffects::MAX_EFFECTS |pool|:
                pooled: RenderScene::EmitterHandle = catch RenderScene::create_emitter(
                    RenderScene::Emitter(position, MAX_PARTICLES, COUNT, LIFETIME, SIZE, velocity)):
                    value: value
                    error failure: return 28
                pool[index] <- RenderScene::native_smoke_emitter_handle(pooled)
            capacity_result: i32 = catch RenderScene::create_emitter(
                RenderScene::Emitter(position, MAX_PARTICLES, COUNT, LIFETIME, SIZE, velocity)):
                value: 0
                RenderScene::RenderSceneError.Capacity: 1
                error failure: 2
            return 29 if capacity_result != 1
            for index in 0..<RenderSceneEffects::MAX_EFFECTS |pool|:
                _ = catch RenderScene::destroy_emitter(
                    RenderScene::native_smoke_emitter_from_handle(pool[index])):
                    ok: 0
                    error failure: return 30
            stale_before_reuse: i32 = catch RenderScene::tick_emitter(
                RenderScene::native_smoke_emitter_from_handle(pool[0]), 0.1):
                ok: 0
                RenderScene::RenderSceneError.UnknownHandle: 1
                error failure: 2
            return 31 if stale_before_reuse != 1
            reused: RenderScene::EmitterHandle = catch RenderScene::create_emitter(
                RenderScene::Emitter(position, MAX_PARTICLES, COUNT, LIFETIME, SIZE, velocity)):
                value: value
                error failure: return 32
            stale_after_reuse: i32 = catch RenderScene::tick_emitter(
                RenderScene::native_smoke_emitter_from_handle(pool[0]), 0.1):
                ok: 0
                RenderScene::RenderSceneError.UnknownHandle: 1
                error failure: 2
            return 33 if stale_after_reuse != 1
            _ = catch RenderScene::destroy_emitter(reused):
                ok: 0
                error failure: return 34
            return 35 if not native_effect_baseline_is_empty()

            world: World::World = catch World::World():
                value: value
                error failure: return 12
            entity: World::EntityRef = catch World::world_spawn(&world, World::Actor.Player):
                value: value
                error failure: return 13
            initial_transform: i32 = catch World::world_set_transform(&world, entity, Geometry::Transform{
                position: Geometry::Vec3{x: 1.0, y: 2.0, z: 3.0},
                rotation: Geometry::quat_identity(),
                scale: Geometry::vec3_one(),
            }):
                ok: 0
                error failure: 1
            return 14 if initial_transform != 0
            effects: WorldEffects::Effects = WorldEffects::Effects()
            attached_emitter: i32 = catch WorldEffects::spawn_emitter(&world, &effects, entity,
                RenderScene::Emitter(Geometry::vec3_zero(), 32, 4.0, 1.0, 0.5,
                    Geometry::Vec3{x: 0.0, y: 1.0, z: 0.0})):
                ok: 0
                error failure: return 15
            return 16 if attached_emitter != 0 or WorldEffects::binding_count(&effects) != 1
            attached_decal: i32 = catch WorldEffects::spawn_decal(&world, &effects, entity,
                RenderScene::Decal(Geometry::vec3_zero(), identity_rotation, color, 2.0, 0.25)):
                ok: 0
                error failure: return 17
            return 18 if attached_decal != 0 or WorldEffects::binding_count(&effects) != 1
            scale_status: i32 = catch WorldEffects::set_time_scale(&effects, entity, 0.5):
                ok: 0
                error failure: 1
            return 19 if scale_status != 0
            moved_transform: i32 = catch World::world_set_transform(&world, entity, Geometry::Transform{
                position: Geometry::Vec3{x: 4.0, y: 5.0, z: 6.0},
                rotation: Geometry::quat_identity(),
                scale: Geometry::vec3_one(),
            }):
                ok: 0
                error failure: 1
            return 20 if moved_transform != 0
            report: WorldEffects::UpdateReport = catch WorldEffects::update(&world, &effects, 0.5):
                value: value
                error failure: return 21
            emitter_after_move: RenderScene::EmitterHandle = catch WorldEffects::emitter_handle(&effects, entity):
                value: value
                error failure: return 22
            raw_emitter_after_move: i64 = RenderScene::native_smoke_emitter_handle(emitter_after_move)
            return 23 if report.updated != 1 or elisa_render_scene_v1_test_effect_position(
                raw_emitter_after_move, 4.0, 5.0, 6.0) != 1
            despawn_status: i32 = catch World::world_despawn(&world, entity):
                ok: 0
                error failure: 1
            return 24 if despawn_status != 0
            despawn_report: WorldEffects::UpdateReport = catch WorldEffects::update(&world, &effects, 0.1):
                value: value
                error failure: return 25
            return 26 if despawn_report.detached_despawned != 1 or WorldEffects::binding_count(&effects) != 0

            0

module WorldEffectEventNativeTests:
    private:
        const LISTENER_ID: i64 = 73
        const PROFILE_ID: i64 = 91
        const DECAL_PROFILE_ID: i64 = 92
        const TRANSIENT_PROFILE_ID: i64 = 93
        const PROFILE_PARTICLES: u32 = 48
        const PROFILE_COUNT: f32 = 9.0
        const PROFILE_LIFETIME: f32 = 2.0
        const PROFILE_SIZE: f32 = 0.6

        @callconv(c)
        extern elisa_render_scene_v1_test_effect_emitter(handle: i64,
            max_particles: u32, count: f32, lifetime: f32, size: f32,
            velocity_x: f32, velocity_y: f32, velocity_z: f32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_effect_decal(handle: i64,
            qx: f32, qy: f32, qz: f32, qw: f32,
            red: f32, green: f32, blue: f32, alpha: f32,
            range: f32, slope_blend: f32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_effect_position(handle: i64,
            px: f32, py: f32, pz: f32) -> i32

        struct EventSpawnOutcome:
            code: i32
            report: WorldEffects::EventSpawnReport

        # Each spawn failure maps to its own code. Returning from a typed arm
        # beside `value: value` makes the stage1 backend decline the caller.
        def spawn_events(effects: mutable WorldEffects::Effects&, queue: WorldEvents::Queue&,
            catalog: WorldEffectAssets::Catalog&, dispatched: usize) -> EventSpawnOutcome:
            none: WorldEffects::EventSpawnReport = WorldEffects::EventSpawnReport{scanned: 0, spawned: 0}
            catch WorldEffects::spawn_dispatched_events(effects, queue, WorldEvents::Phase.Simulation, catalog, dispatched):
                value: EventSpawnOutcome{code: 0, report: value}
                WorldEffects::WorldEffectsError.EntityAlreadyAttached: EventSpawnOutcome{code: 123, report: none}
                WorldEffects::WorldEffectsError.Capacity: EventSpawnOutcome{code: 124, report: none}
                WorldEffects::WorldEffectsError.BindingTableCorrupt: EventSpawnOutcome{code: 125, report: none}
                WorldEvents::EventError.InactiveFrame: EventSpawnOutcome{code: 126, report: none}
                WorldEvents::EventError.InvalidPhase: EventSpawnOutcome{code: 127, report: none}
                WorldEvents::EventError.InvalidIndex: EventSpawnOutcome{code: 128, report: none}
                WorldEffectAssets::CatalogError.NotFound: EventSpawnOutcome{code: 129, report: none}
                RenderScene::RenderSceneError.InvalidValue: EventSpawnOutcome{code: 141, report: none}
                RenderScene::RenderSceneError.NotInitialized: EventSpawnOutcome{code: 142, report: none}
                RenderScene::RenderSceneError.Capacity: EventSpawnOutcome{code: 143, report: none}
                RenderScene::RenderSceneError.UnknownHandle: EventSpawnOutcome{code: 144, report: none}
                RenderScene::RenderSceneError.BackendFailure: EventSpawnOutcome{code: 145, report: none}
                error failure: EventSpawnOutcome{code: 120, report: none}

    public:
        def exercise() -> i32:
            identity_rotation: Geometry::Quat = Geometry::quat_identity()
            profile_decal_rotation: Geometry::Quat = Geometry::Quat{
                x: 0.0, y: 1.0, z: 0.0, w: 0.0,
            }
            world: mutable World::World = catch World::World():
                value: value
                error failure: return 1
            entity: World::EntityRef = catch World::world_spawn(&world, World::Enemy.Guard):
                value: value
                error failure: return 2
            _ = catch World::world_set_transform(&world, entity, Geometry::Transform{
                position: Geometry::Vec3{x: 8.0, y: 2.0, z: -4.0},
                rotation: Geometry::quat_identity(),
                scale: Geometry::vec3_one(),
            }):
                ok: 0
                error failure: return 3
            decal_entity: World::EntityRef = catch World::world_spawn(&world, World::Enemy.Guard):
                value: value
                error failure: return 42
            decal_position: Geometry::Vec3 = Geometry::Vec3{x: -3.0, y: 1.0, z: 5.0}
            _ = catch World::world_set_transform(&world, decal_entity, Geometry::Transform{
                position: decal_position,
                rotation: Geometry::quat_identity(),
                scale: Geometry::vec3_one(),
            }):
                ok: 0
                error failure: return 43
            transient_entity: World::EntityRef = catch World::world_spawn(&world, World::Enemy.Guard):
                value: value
                error failure: return 54
            transient_position: Geometry::Vec3 = Geometry::Vec3{x: 5.0, y: 0.5, z: 7.0}
            _ = catch World::world_set_transform(&world, transient_entity, Geometry::Transform{
                position: transient_position,
                rotation: Geometry::quat_identity(),
                scale: Geometry::vec3_one(),
            }):
                ok: 0
                error failure: return 55
            velocity: Geometry::Vec3 = Geometry::Vec3{x: 0.0, y: 4.0, z: 1.0}
            decal_color: RenderScene::Color = RenderScene::Color{
                red: 0.3, green: 0.6, blue: 0.9, alpha: 0.7,
            }
            catalog: mutable WorldEffectAssets::Catalog = WorldEffectAssets::Catalog()
            authored_emitter: WorldEffectAssets::EffectDefinition = WorldEffectAssets::emitter_definition(
                PROFILE_ID, RenderScene::Emitter(Geometry::vec3_zero(), PROFILE_PARTICLES,
                    PROFILE_COUNT, PROFILE_LIFETIME, PROFILE_SIZE, velocity), 0.75, 0.0,
                WorldEffectAssets::RetriggerPolicy.Reject)
            _ = catch WorldEffectAssets::register(&catalog, authored_emitter):
                ok: 0
                error failure: return 4
            duplicate_profile: i32 = catch WorldEffectAssets::register(&catalog, authored_emitter):
                ok: 0
                WorldEffectAssets::CatalogError.DuplicateId: 1
                error failure: 2
            return 5 if duplicate_profile != 1 or WorldEffectAssets::profile_count(&catalog) != 1
            authored_decal: WorldEffectAssets::EffectDefinition = WorldEffectAssets::decal_definition(
                DECAL_PROFILE_ID, RenderScene::Decal(Geometry::vec3_zero(), profile_decal_rotation, decal_color, 3.5, 0.5), 0.4, 0.05,
                WorldEffectAssets::RetriggerPolicy.Reject)
            _ = catch WorldEffectAssets::register(&catalog, authored_decal):
                ok: 0
                error failure: return 44
            transient_profile: WorldEffectAssets::EffectDefinition = WorldEffectAssets::emitter_definition(
                TRANSIENT_PROFILE_ID, RenderScene::Emitter(Geometry::vec3_zero(), PROFILE_PARTICLES,
                    PROFILE_COUNT, PROFILE_LIFETIME, PROFILE_SIZE, velocity), 0.75, 0.1,
                WorldEffectAssets::RetriggerPolicy.Replace)
            _ = catch WorldEffectAssets::register(&catalog, transient_profile):
                ok: 0
                error failure: return 56
            return 45 if WorldEffectAssets::profile_count(&catalog) != 3
            invalid_duration_profile: WorldEffectAssets::EffectDefinition = WorldEffectAssets::decal_definition(
                94, RenderScene::Decal(Geometry::vec3_zero(), identity_rotation, decal_color, 1.0, 0.0), 1.0, -0.1,
                WorldEffectAssets::RetriggerPolicy.Reject)
            invalid_duration: i32 = catch WorldEffectAssets::register(&catalog, invalid_duration_profile):
                ok: 0
                WorldEffectAssets::CatalogError.InvalidDefinition: 1
                error failure: 2
            return 65 if invalid_duration != 1 or WorldEffectAssets::profile_count(&catalog) != 3
            effects: mutable WorldEffects::Effects = WorldEffects::Effects()
            return 39 if WorldEffects::binding_count(&effects) != 0
            queue: mutable WorldEvents::Queue = WorldEvents::Queue()
            _ = catch WorldEvents::begin_frame(&queue):
                ok: 0
                error failure: return 6
            _ = catch WorldEvents::subscribe(&queue, LISTENER_ID, WorldEvents::Phase.Simulation):
                ok: 0
                error failure: return 7
            _ = catch WorldEvents::emit_world(&queue, &world, WorldEvents::Event{
                phase: WorldEvents::Phase.Simulation,
                kind: WorldEvents::EventKind.Spawn,
                listener_id: LISTENER_ID,
                entity: entity,
                position: Geometry::vec3_zero(),
                payload: PROFILE_ID,
                delivered: false,
            }):
                ok: 0
                error failure: return 8
            _ = catch WorldEvents::emit_world(&queue, &world, WorldEvents::Event{
                phase: WorldEvents::Phase.Simulation,
                kind: WorldEvents::EventKind.Damage,
                listener_id: 0,
                entity: entity,
                position: Geometry::vec3_zero(),
                payload: 999,
                delivered: false,
            }):
                ok: 0
                error failure: return 9
            _ = catch WorldEvents::emit_world(&queue, &world, WorldEvents::Event{
                phase: WorldEvents::Phase.Simulation,
                kind: WorldEvents::EventKind.Spawn,
                listener_id: LISTENER_ID,
                entity: decal_entity,
                position: Geometry::vec3_zero(),
                payload: DECAL_PROFILE_ID,
                delivered: false,
            }):
                ok: 0
                error failure: return 46
            for _ in 0..<2:
                _ = catch WorldEvents::emit_world(&queue, &world, WorldEvents::Event{
                    phase: WorldEvents::Phase.Simulation,
                    kind: WorldEvents::EventKind.Spawn,
                    listener_id: LISTENER_ID,
                    entity: transient_entity,
                    position: Geometry::vec3_zero(),
                    payload: TRANSIENT_PROFILE_ID,
                    delivered: false,
                }):
                    ok: 0
                    error failure: return 57
            _ = catch WorldEvents::advance_phase(&queue, WorldEvents::Phase.Simulation):
                ok: 0
                error failure: return 10
            dispatched: usize = catch WorldEvents::dispatch(&queue, WorldEvents::Phase.Simulation):
                value: value
                error failure: return 11
            dispatched_spawn: WorldEvents::Event = catch WorldEvents::dispatched_event_at(
                &queue, WorldEvents::Phase.Simulation, 0):
                value: value
                error failure: return 27
            dispatched_damage: WorldEvents::Event = catch WorldEvents::dispatched_event_at(
                &queue, WorldEvents::Phase.Simulation, 1):
                value: value
                error failure: return 40
            dispatched_decal: WorldEvents::Event = catch WorldEvents::dispatched_event_at(
                &queue, WorldEvents::Phase.Simulation, 2):
                value: value
                error failure: return 47
            return 41 if dispatched_damage.kind != WorldEvents::EventKind.Damage or dispatched_damage.payload != 999
            return 48 if dispatched_decal.entity.id != decal_entity.id or dispatched_decal.position.x != decal_position.x or dispatched_decal.position.y != decal_position.y or dispatched_decal.position.z != decal_position.z
            return 28 if dispatched_spawn.entity.id != entity.id or dispatched_spawn.entity.world_epoch != entity.world_epoch
            return 37 if dispatched_spawn.position.x != 8.0 or dispatched_spawn.position.y != 2.0 or dispatched_spawn.position.z != -4.0
            return 29 if not World::world_is_live(world, dispatched_spawn.entity)
            resolved_profile: WorldEffectAssets::EffectDefinition = catch WorldEffectAssets::get(
                catalog, PROFILE_ID):
                value: value
                error failure: return 30
            return 31 if resolved_profile.id != PROFILE_ID or resolved_profile.kind != WorldEffectAssets::DefinitionKind.Emitter or resolved_profile.time_scale != 0.75
            return 38 if resolved_profile.emitter.max_particles != PROFILE_PARTICLES or resolved_profile.emitter.count != PROFILE_COUNT or resolved_profile.emitter.lifetime != PROFILE_LIFETIME or resolved_profile.emitter.size != PROFILE_SIZE or resolved_profile.emitter.velocity.x != velocity.x or resolved_profile.emitter.velocity.y != velocity.y or resolved_profile.emitter.velocity.z != velocity.z
            spawn_outcome: EventSpawnOutcome = spawn_events(&effects, &queue, &catalog, dispatched)
            return spawn_outcome.code if spawn_outcome.code != 0
            event_report: WorldEffects::EventSpawnReport = spawn_outcome.report
            return 13 if dispatched != 5 or event_report.scanned != 5 or event_report.spawned != 4 or WorldEffects::binding_count(&effects) != 3
            emitter: RenderScene::EmitterHandle = catch WorldEffects::emitter_handle(&effects, entity):
                value: value
                error failure: return 14
            handle: i64 = RenderScene::native_smoke_emitter_handle(emitter)
            return 15 if elisa_render_scene_v1_test_effect_emitter(handle, PROFILE_PARTICLES,
                PROFILE_COUNT, PROFILE_LIFETIME, PROFILE_SIZE, velocity.x, velocity.y, velocity.z) != 1 or elisa_render_scene_v1_test_effect_position(handle, 8.0, 2.0, -4.0) != 1
            decal: RenderScene::DecalHandle = catch WorldEffects::decal_handle(&effects, decal_entity):
                value: value
                error failure: return 49
            decal_handle: i64 = RenderScene::native_smoke_decal_handle(decal)
            return 50 if elisa_render_scene_v1_test_effect_decal(decal_handle,
                profile_decal_rotation.x, profile_decal_rotation.y,
                profile_decal_rotation.z, profile_decal_rotation.w,
                decal_color.red, decal_color.green, decal_color.blue, decal_color.alpha, 3.5, 0.5) != 1
            return 51 if elisa_render_scene_v1_test_effect_position(decal_handle,
                decal_position.x, decal_position.y, decal_position.z) != 1
            transient_emitter: RenderScene::EmitterHandle = catch WorldEffects::emitter_handle(&effects, transient_entity):
                value: value
                error failure: return 58
            transient_handle: i64 = RenderScene::native_smoke_emitter_handle(transient_emitter)
            return 59 if elisa_render_scene_v1_test_effect_position(transient_handle,
                transient_position.x, transient_position.y, transient_position.z) != 1
            return 60 if not RenderSceneEffectsNativeTests::native_effect_counts_are(2, 1)
            duplicate_spawn: i32 = catch WorldEffects::spawn_dispatched_events(&effects,
                &queue, WorldEvents::Phase.Simulation, &catalog, dispatched):
                value: 0
                WorldEffects::WorldEffectsError.EntityAlreadyAttached: 1
                error failure: 2
            return 16 if duplicate_spawn != 1
            _ = WorldEvents::end_frame(&queue)
            expiry: WorldEffects::UpdateReport = catch WorldEffects::update(&world, &effects, 0.2):
                value: value
                error failure: return 61
            return 62 if expiry.expired != 2 or expiry.updated != 1 or WorldEffects::binding_count(&effects) != 1
            return 63 if not RenderSceneEffectsNativeTests::native_effect_counts_are(1, 0)
            _ = catch World::world_despawn(&world, entity):
                ok: 0
                error failure: return 17
            _ = catch World::world_despawn(&world, decal_entity):
                ok: 0
                error failure: return 52
            _ = catch World::world_despawn(&world, transient_entity):
                ok: 0
                error failure: return 64
            cleanup: WorldEffects::UpdateReport = catch WorldEffects::update(&world, &effects, 0.1):
                value: value
                error failure: return 18
            return 19 if cleanup.detached_despawned != 1 or WorldEffects::binding_count(&effects) != 0
            return 53 if not RenderSceneEffectsNativeTests::native_effect_baseline_is_empty()
            0
