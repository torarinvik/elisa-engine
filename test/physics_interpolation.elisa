include "../src/physics/interpolation.elisa"

def main() -> i32:
    identity: Geometry::Transform = Geometry::transform_identity()
    buffer: mutable PhysicsInterpolation::Buffer = PhysicsInterpolation::Buffer(identity)
    moved: Geometry::Transform = Geometry::transform_translate(identity, Geometry::Vec3{x: 10.0, y: 0.0, z: 0.0})
    return 1 if not PhysicsInterpolation::commit(&buffer, moved, 1, false)
    halfway: Geometry::Transform = PhysicsInterpolation::sample(&buffer, 0.5)
    return 2 if halfway.position.x < 4.99 or halfway.position.x > 5.01
    return 3 if PhysicsInterpolation::commit(&buffer, identity, 1, false)
    return 4 if PhysicsInterpolation::commit(&buffer, identity, 2, true) == false
    teleported: Geometry::Transform = PhysicsInterpolation::sample(&buffer, 0.5)
    return 5 if teleported.position.x != 0.0
    PhysicsInterpolation::clear_teleport(&buffer)
    return 6 if PhysicsInterpolation::last_tick(&buffer) != 2 or not PhysicsInterpolation::interpolation_valid(&buffer)

    slow: mutable PhysicsInterpolation::Buffer = PhysicsInterpolation::Buffer(identity)
    fast: mutable PhysicsInterpolation::Buffer = PhysicsInterpolation::Buffer(identity)
    for tick in 3..<6 |slow, fast, tick|:
        pose: Geometry::Transform = Geometry::transform_translate(identity,
            Geometry::Vec3{x: tick.f32(), y: 0.0, z: 0.0})
        return 7 if not PhysicsInterpolation::commit(&slow, pose, tick.i64(), false)
        return 8 if not PhysicsInterpolation::commit(&fast, pose, tick.i64(), false)
        for frame in 0..<30 |slow, frame|:
            _ = PhysicsInterpolation::sample(&slow, (frame % 10).f32() / 10.0)
        for frame in 0..<120 |fast, frame|:
            _ = PhysicsInterpolation::sample(&fast, (frame % 20).f32() / 20.0)
    return 9 if PhysicsInterpolation::last_tick(&slow) != 5 or PhysicsInterpolation::last_tick(&fast) != 5
    return 10 if PhysicsInterpolation::sample(&slow, 1.0).position.x != PhysicsInterpolation::sample(&fast, 1.0).position.x
    0
