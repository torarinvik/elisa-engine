include "../src/backend/fake_bridge.elisa"
using FakeBridge

def main() -> i32:
    bridge: mutable Bridge = bridge_new()
    failed: i32 = catch resource_create(&bridge, true):
        value: 1
        BridgeError.CreateFailed: 0
        error failure: 1
    return 1 if failed != 0
    created_after_failure: ResourceHandle = catch resource_create(&bridge, false):
        value: value
        error failure: ResourceHandle{slot: 16, generation: 0}
    return 2 if not resource_is_live(&bridge, created_after_failure)

    empty: i32 = catch upload_submit(&bridge, created_after_failure, 0):
        value: 1
        BridgeError.EmptyUpload: 0
        error failure: 2
    return 3 if empty != 0
    upload: UploadTicket = catch upload_submit(&bridge, created_after_failure, 64):
        value: value
        error failure: UploadTicket{slot: 16, generation: 0}
    return 4 if not upload_is_pending(&bridge, upload)

    blocked_destroy: i32 = catch resource_destroy(&bridge, created_after_failure):
        ok: 1
        BridgeError.UploadPending: 0
        error failure: 2
    return 5 if blocked_destroy != 0 or not resource_is_live(&bridge, created_after_failure)

    completed: i32 = catch upload_complete(&bridge, upload):
        ok: 0
        error failure: 1
    return 6 if completed != 0 or upload_is_pending(&bridge, upload)
    repeated: i32 = catch upload_complete(&bridge, upload):
        ok: 1
        BridgeError.InvalidUpload: 0
        error failure: 2
    return 7 if repeated != 0

    callback: CallbackHandle = catch callback_register(&bridge):
        value: value
        error failure: CallbackHandle{slot: 16, generation: 0}
    callback_started: i32 = catch callback_begin(&bridge, callback):
        ok: 0
        error failure: 1
    return 8 if callback_started != 0
    blocked_unregister: i32 = catch callback_unregister(&bridge, callback):
        ok: 1
        BridgeError.CallbackInFlight: 0
        error failure: 2
    return 9 if blocked_unregister != 0 or not callback_is_registered(&bridge, callback)
    callback_finished: i32 = catch callback_end(&bridge, callback):
        ok: 0
        error failure: 1
    return 10 if callback_finished != 0
    unregistered: i32 = catch callback_unregister(&bridge, callback):
        ok: 0
        error failure: 1
    return 11 if unregistered != 0 or callback_is_registered(&bridge, callback)

    destroyed: i32 = catch resource_destroy(&bridge, created_after_failure):
        ok: 0
        error failure: 1
    return 12 if destroyed != 0 or resource_is_live(&bridge, created_after_failure)
    reused: ResourceHandle = catch resource_create(&bridge, false):
        value: value
        error failure: ResourceHandle{slot: 16, generation: 0}
    return 13 if reused.slot != created_after_failure.slot or reused.generation == created_after_failure.generation
    stale: i32 = catch upload_submit(&bridge, created_after_failure, 4):
        value: 1
        BridgeError.InvalidResource: 0
        error failure: 2
    return 14 if stale != 0
    reused_destroyed: i32 = catch resource_destroy(&bridge, reused):
        ok: 0
        error failure: 1
    return 15 if reused_destroyed != 0

    # Stale handles are rejected once a slot has been reused with a new
    # generation: an old callback or upload ticket must not act on the new
    # object that now occupies the slot.
    fresh_callback: CallbackHandle = catch callback_register(&bridge):
        value: value
        error failure: return 16
    stale_callback: i32 = catch callback_begin(&bridge, callback):
        value: 0
        BridgeError.InvalidCallback: 1
        error failure: 2
    return 17 if stale_callback != 1 or not callback_is_registered(&bridge, fresh_callback)
    premature_end: i32 = catch callback_end(&bridge, fresh_callback):
        ok: 0
        BridgeError.CallbackAlreadyUnregistered: 1
        error failure: 2
    return 18 if premature_end != 1
    upload_resource: ResourceHandle = catch resource_create(&bridge, false):
        value: value
        error failure: return 19
    fresh_upload: i32 = catch upload_submit(&bridge, upload_resource, 8):
        value: 0
        error failure: 1
    return 20 if fresh_upload != 0
    stale_upload: i32 = catch upload_complete(&bridge, upload):
        ok: 0
        BridgeError.InvalidUpload: 1
        error failure: 2
    return 21 if stale_upload != 1

    capacity: i32 = capacity_test()
    return capacity if capacity != 0
    0

# Capacity and oversized inputs, tested on a fresh bridge so the linear
# lifecycle above is not disturbed.
def capacity_test() -> i32:
    bridge: mutable Bridge = bridge_new()
    target: ResourceHandle = catch resource_create(&bridge, false):
        value: value
        error failure: return 30
    for index in 0..<15 |bridge|:
        extra: ResourceHandle = catch resource_create(&bridge, false):
            value: value
            error failure: return 31
    resource_overflow: i32 = catch resource_create(&bridge, false):
        value: 0
        BridgeError.Capacity: 1
        error failure: 2
    return 32 if resource_overflow != 1
    for index in 0..<16 |bridge, target|:
        ticket: UploadTicket = catch upload_submit(&bridge, target, 4):
            value: value
            error failure: return 33
    upload_overflow: i32 = catch upload_submit(&bridge, target, 4):
        value: 0
        BridgeError.Capacity: 1
        error failure: 2
    return 34 if upload_overflow != 1
    oversize: i32 = catch upload_submit(&bridge, target, 1048577):
        value: 0
        BridgeError.OversizedUpload: 1
        BridgeError.Capacity: 2
        error failure: 3
    return 35 if oversize != 1
    for index in 0..<16 |bridge|:
        registered: CallbackHandle = catch callback_register(&bridge):
            value: value
            error failure: return 36
    callback_overflow: i32 = catch callback_register(&bridge):
        value: 0
        BridgeError.Capacity: 1
        error failure: 2
    return 37 if callback_overflow != 1
    0
