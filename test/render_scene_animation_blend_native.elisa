# Native coverage for smoother clip transitions: a speed change keeps the
# cycle's phase, a re-requested clip keeps running, a phase-matched switch
# starts where the old cycle was, and an eased crossfade weights the new
# pose with a smoothstep instead of a straight line.
include "../src/runtime/application.elisa"
include "../src/runtime/render_scene_animation_blend.elisa"

module RenderSceneAnimationBlendNativeTests:
    private:
        const CLIP: cstr = "lift"
        const NEXT_CLIP: cstr = "drop"
        const FADE: f32 = 0.4

        @callconv(c)
        extern elisa_render_scene_v1_test_animation_blend_weight(
            handle: i64) -> f32
        @callconv(c)
        extern elisa_render_scene_v1_test_animation_joint_y(
            handle: i64, joint_index: u32, expected_y: f32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_test_morph_transition_weights(
            handle: i64, first_weight: f32, second_weight: f32) -> i32

        def near(value: f32, expected: f32) -> bool:
            value > expected - 0.002 and value < expected + 0.002

        def progress(handle: RenderScene::InstanceHandle) -> f32:
            catch RenderScene::animation_progress(handle):
                value: value
                error failure: -1.0

        def advance(handle: RenderScene::InstanceHandle, seconds: f32) -> bool:
            catch RenderScene::advance_animation(handle, seconds):
                ok: true
                error failure: false

        def play(handle: RenderScene::InstanceHandle, clip: cstr, blend: f32,
            transition: RenderScene::AnimationTransition) -> bool:
            catch RenderScene::play_animation_blended(handle, clip, true, 1.0, blend, transition):
                ok: true
                error failure: false

        def plain() -> RenderScene::AnimationTransition:
            RenderScene::AnimationTransition{eased: false, phase_matched: false,
                continue_same_clip: false}

        def phase_matched_linear() -> RenderScene::AnimationTransition:
            RenderScene::AnimationTransition{eased: false, phase_matched: true,
                continue_same_clip: false}

        def retime(handle: RenderScene::InstanceHandle, speed: f32) -> i32:
            catch RenderScene::set_animation_speed(handle, speed):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2

        def phase_checks(rig: RenderScene::InstanceHandle) -> i32:
            raw_rig: i64 = RenderScene::native_smoke_handle(rig)
            started: bool = catch RenderScene::play_animation(rig, CLIP, true, 1.0, 0.0):
                ok: true
                error failure: false
            return 2 if not started
            return 3 if not advance(rig, 0.5) or not near(progress(rig), 0.5)
            # Retiming keeps the phase; the faster cadence shows on the next advance.
            return 4 if retime(rig, 2.0) != 0 or not near(progress(rig), 0.5)
            return 5 if not advance(rig, 0.2) or not near(progress(rig), 0.9)
            # A re-requested clip keeps running and starts no fade.
            return 6 if not play(rig, CLIP, FADE, RenderScene::locomotion_transition()) or not near(progress(rig), 0.9)
            return 7 if elisa_render_scene_v1_test_animation_blend_weight(raw_rig) >= 0.0
            0

        def fade_checks(rig: RenderScene::InstanceHandle) -> i32:
            raw_rig: i64 = RenderScene::native_smoke_handle(rig)
            # Begin both clips at a known phase, despite the cadence change in
            # the preceding test.
            return 8 if not play(rig, CLIP, 0.0, plain()) or not near(progress(rig), 0.0)
            return 9 if not advance(rig, 0.25)
            # At phase .35, lift is y=1.35 and drop is y=3.70. A smoothstep
            # fade at .25 duration weighs the new pose by .15625.
            eased: RenderScene::AnimationTransition = RenderScene::AnimationTransition{
                eased: true, phase_matched: true, continue_same_clip: false}
            return 10 if not play(rig, NEXT_CLIP, FADE, eased) or not near(progress(rig), 0.25)
            return 11 if not near(elisa_render_scene_v1_test_animation_blend_weight(raw_rig), 0.0)
            return 12 if elisa_render_scene_v1_test_animation_joint_y(raw_rig, 3, 1.25) == 0
            return 13 if not advance(rig, 0.1) or not near(elisa_render_scene_v1_test_animation_blend_weight(raw_rig), 0.15625)
            # The blended local joint translation is 1.35 + (3.70 - 1.35) * 0.15625.
            return 14 if elisa_render_scene_v1_test_animation_joint_y(raw_rig, 3, 1.7171875) == 0
            return 15 if not advance(rig, 0.3) or elisa_render_scene_v1_test_animation_blend_weight(raw_rig) >= 0.0
            # Restart lift and compare a phase-matched linear fade between the
            # same distinct authored clips; at phase .35 its pose is y=1.9375.
            return 16 if not play(rig, CLIP, 0.0, plain()) or not near(progress(rig), 0.0)
            return 17 if not advance(rig, 0.25) or not play(rig, NEXT_CLIP, FADE, phase_matched_linear())
            return 18 if not advance(rig, 0.1) or not near(elisa_render_scene_v1_test_animation_blend_weight(raw_rig), 0.25)
            return 19 if elisa_render_scene_v1_test_animation_joint_y(raw_rig, 3, 1.9375) == 0
            # Interrupt the visible mixture with a shorter fade. Its first
            # pose must be continuous, and the remaining .3 seconds survive.
            return 23 if not play(rig, CLIP, 0.08, plain())
            return 24 if elisa_render_scene_v1_test_animation_joint_y(raw_rig, 3, 1.9375) == 0
            return 25 if not advance(rig, 0.15)
            return 26 if not near(elisa_render_scene_v1_test_animation_blend_weight(raw_rig), 0.5)
            return 27 if elisa_render_scene_v1_test_animation_joint_y(raw_rig, 3, 1.54375) == 0
            return 28 if not advance(rig, 0.15)
            return 29 if elisa_render_scene_v1_test_animation_joint_y(raw_rig, 3, 1.3) == 0
            0

        def morph_interruption_checks() -> i32:
            morph: RenderScene::InstanceHandle = catch RenderScene::create_mesh(
                "build/cooked/subsets/morph-transition-panel.pkg", Geometry::transform_identity(),
                RenderScene::Color{red: 0.8, green: 0.8, blue: 0.8, alpha: 1.0}):
                value: value
                error failure: return 30
            raw_morph: i64 = RenderScene::native_smoke_handle(morph)
            return 31 if not play(morph, "weights", 0.0, plain())
            return 32 if elisa_render_scene_v1_test_morph_transition_weights(
                raw_morph, 0.0, 0.2) != 1
            return 33 if not advance(morph, 0.25)
            # Both clips keep advancing during a fade: the source reaches .35,
            # the destination reaches .9, and the new clip contributes one
            # quarter of the visible mixture.
            return 34 if not play(morph, "weights-return", FADE, plain())
            return 35 if not advance(morph, 0.1)
            return 36 if not near(elisa_render_scene_v1_test_animation_blend_weight(raw_morph), 0.25)
            return 37 if elisa_render_scene_v1_test_morph_transition_weights(
                raw_morph, 0.4875, 0.2) != 1
            # Interrupt back to the first clip. The visible morph mixture must
            # remain continuous and the original .3 seconds must be preserved.
            return 38 if not play(morph, "weights", 0.08, plain())
            return 39 if elisa_render_scene_v1_test_morph_transition_weights(
                raw_morph, 0.4875, 0.2) != 1
            return 40 if not advance(morph, 0.15)
            return 41 if not near(elisa_render_scene_v1_test_animation_blend_weight(raw_morph), 0.5)
            return 42 if elisa_render_scene_v1_test_morph_transition_weights(
                raw_morph, 0.31875, 0.2) != 1
            return 43 if not advance(morph, 0.15)
            return 44 if elisa_render_scene_v1_test_animation_blend_weight(raw_morph) >= 0.0
            return 45 if elisa_render_scene_v1_test_morph_transition_weights(
                raw_morph, 0.3, 0.2) != 1
            destroyed: bool = catch RenderScene::destroy(morph):
                ok: true
                error failure: false
            return 46 if not destroyed
            0

    public:
        def exercise(box: RenderScene::InstanceHandle) -> i32:
            rig: RenderScene::InstanceHandle = catch RenderScene::create_mesh(
                "build/cooked/subsets/morphed-skinned.pkg", Geometry::transform_identity(),
                RenderScene::Color{red: 0.8, green: 0.8, blue: 0.8, alpha: 1.0}):
                value: value
                error failure: return 1
            phase_status: i32 = phase_checks(rig)
            return phase_status if phase_status != 0
            fade_status: i32 = fade_checks(rig)
            return fade_status if fade_status != 0
            morph_status: i32 = morph_interruption_checks()
            return morph_status if morph_status != 0
            # Reverse speeds are accepted within the same bounded range.
            return 20 if retime(rig, -1.0) != 0
            return 21 if retime(rig, -17.0) != 1
            return 22 if retime(box, 1.0) != 1
            destroyed: bool = catch RenderScene::destroy(rig):
                ok: true
                error failure: false
            return 23 if not destroyed
            0
