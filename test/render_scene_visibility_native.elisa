# Native smoke coverage for public draw-distance, LOD, layer, and occlusion policy.
module RenderSceneVisibilityNativeTests:
    private:
        const DRAW_DISTANCE: f32 = 24.0
        const LOD_BIAS: f32 = 1.5
        const LAYER_MASK: u32 = 64

        @callconv(c)
        extern elisa_render_scene_v1_test_visibility_policy(handle: i64,
            draw_distance: f32, lod_bias: f32, layer_mask: u32,
            renderable: i32, occlusion_culling: i32) -> i32

    public:
        def hide_instance(handle: RenderScene::InstanceHandle) -> i32:
            catch RenderScene::set_visible(handle, false):
                ok: 0
                error failure: 1

        def show_instance(handle: RenderScene::InstanceHandle) -> i32:
            catch RenderScene::set_visible(handle, true):
                ok: 0
                error failure: 1

        def exercise(handle: RenderScene::InstanceHandle) -> i32:
            policy: RenderScene::VisibilityPolicy = RenderScene::VisibilityPolicy(
                DRAW_DISTANCE, LOD_BIAS, LAYER_MASK, false)
            status: i32 = catch RenderScene::set_visibility(handle, policy):
                ok: 0
                error failure: 1
            return 1 if status != 0
            raw_handle: i64 = RenderScene::native_smoke_handle(handle)
            return 2 if elisa_render_scene_v1_test_visibility_policy(raw_handle,
                DRAW_DISTANCE, LOD_BIAS, LAYER_MASK, 0, 0) != 1

            invalid_distance: i32 = catch RenderScene::set_visibility(handle,
                RenderScene::VisibilityPolicy(0.0, LOD_BIAS, LAYER_MASK, true)):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 3 if invalid_distance != 1

            occlusion_status: i32 = catch RenderScene::set_occlusion_culling(true):
                ok: 0
                error failure: 1
            return 4 if occlusion_status != 0
            return 5 if elisa_render_scene_v1_test_visibility_policy(raw_handle,
                DRAW_DISTANCE, LOD_BIAS, LAYER_MASK, 0, 1) != 1

            restore_status: i32 = catch RenderScene::set_visibility(handle,
                RenderScene::VisibilityPolicy(1000.0, 0.0, 4294967295, true)):
                ok: 0
                error failure: 1
            return 6 if restore_status != 0
            disable_occlusion: i32 = catch RenderScene::set_occlusion_culling(false):
                ok: 0
                error failure: 1
            return 7 if disable_occlusion != 0
            return 8 if elisa_render_scene_v1_test_visibility_policy(raw_handle,
                1000.0, 0.0, 4294967295, 1, 0) != 1
            0

        def restore_hidden_instances(box: RenderScene::InstanceHandle,
            sphere: RenderScene::InstanceHandle,
            floor: RenderScene::InstanceHandle) -> i32:
            return 9 if show_instance(box) != 0
            return 10 if show_instance(sphere) != 0
            return 11 if show_instance(floor) != 0
            0
