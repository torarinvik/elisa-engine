include "../src/backend/render_resources.elisa"

def main() -> i32:
    registry: mutable RenderResources::Registry = RenderResources::Registry()
    mesh: Assets::AssetId = Assets::AssetId{high: 1, low: 10}
    material: Assets::AssetId = Assets::AssetId{high: 1, low: 11}
    transform: Geometry::Transform = Geometry::transform_identity()
    invalid_transform: Geometry::Transform = Geometry::Transform{
        position: Geometry::vec3_zero(),
        rotation: Geometry::quat_identity(),
        scale: Geometry::Vec3{x: 0.0, y: 1.0, z: 1.0},
    }
    invalid_create: i32 = catch RenderResources::create(&registry, mesh, material, invalid_transform, 1):
        value: 0
        RenderResources::RenderError.InvalidTransform: 1
        error failure: 2
    return 1 if invalid_create != 1 or RenderResources::instance_count(&registry) != 0
    first: RenderResources::InstanceHandle = catch RenderResources::create(&registry, mesh, material, transform, 1):
        value: value
        error failure: return 2
    second: RenderResources::InstanceHandle = catch RenderResources::create(&registry, mesh, material, transform, 2):
        value: value
        error failure: return 3
    return 4 if RenderResources::shared_mesh_count(&registry, mesh) != 2 or RenderResources::instance_count(&registry) != 2
    moved: Geometry::Transform = Geometry::transform_translate(transform, Geometry::Vec3{x: 4.0, y: 0.0, z: 0.0})
    rejected_transform: i32 = catch RenderResources::update_transform(&registry, first, invalid_transform):
        ok: 0
        RenderResources::RenderError.InvalidTransform: 1
        error failure: 2
    return 5 if rejected_transform != 1
    _ = catch RenderResources::update_transform(&registry, first, moved):
        ok: 0
        error failure: return 6
    one: RenderResources::InstanceState = catch RenderResources::read(&registry, first):
        value: value
        error failure: return 7
    two: RenderResources::InstanceState = catch RenderResources::read(&registry, second):
        value: value
        error failure: return 8
    return 9 if one.transform.position.x != 4.0 or two.transform.position.x != 0.0
    updates: RenderResources::InstanceUpdate[RenderResources::MAX_INSTANCE_UPDATES] = zeroed
    updates[0] <- RenderResources::InstanceUpdate{
        handle: second,
        transform: Geometry::transform_translate(transform, Geometry::Vec3{x: -3.0, y: 0.0, z: 0.0}),
        layer: 4,
        visible: false,
    }
    updates[1] <- RenderResources::InstanceUpdate{
        handle: first,
        transform: moved,
        layer: 2,
        visible: true,
    }
    _ = catch RenderResources::update_batch(&registry, &updates, 2):
        ok: 0
        error failure: return 10
    updated_second: RenderResources::InstanceState = catch RenderResources::read(&registry, second):
        value: value
        error failure: return 11
    return 12 if updated_second.transform.position.x != -3.0 or updated_second.layer != 4 or updated_second.visible
    prior_first: RenderResources::InstanceState = catch RenderResources::read(&registry, first):
        value: value
        error failure: return 13
    updates[0] <- RenderResources::InstanceUpdate{
        handle: second,
        transform: Geometry::transform_translate(transform, Geometry::Vec3{x: 12.0, y: 0.0, z: 0.0}),
        layer: 9,
        visible: true,
    }
    updates[1] <- RenderResources::InstanceUpdate{
        handle: first,
        transform: invalid_transform,
        layer: 8,
        visible: false,
    }
    rejected_batch: i32 = catch RenderResources::update_batch(&registry, &updates, 2):
        ok: 0
        RenderResources::RenderError.InvalidTransform: 1
        error failure: 2
    return 14 if rejected_batch != 1
    unchanged_second: RenderResources::InstanceState = catch RenderResources::read(&registry, second):
        value: value
        error failure: return 15
    unchanged_first: RenderResources::InstanceState = catch RenderResources::read(&registry, first):
        value: value
        error failure: return 16
    return 17 if unchanged_second.transform.position.x != updated_second.transform.position.x or unchanged_second.layer != updated_second.layer or unchanged_second.visible != updated_second.visible
    return 18 if unchanged_first.transform.position.x != prior_first.transform.position.x
    updates[1].handle <- second
    updates[1].transform <- moved
    duplicate: i32 = catch RenderResources::update_batch(&registry, &updates, 2):
        ok: 0
        RenderResources::RenderError.DuplicateUpdate: 1
        error failure: 2
    return 19 if duplicate != 1
    _ = catch RenderResources::destroy(&registry, first):
        ok: 0
        error failure: return 20
    return 21 if RenderResources::shared_mesh_count(&registry, mesh) != 1 or not RenderResources::registry_valid(&registry)
    stale: i32 = catch RenderResources::set_visible(&registry, first, false):
        ok: 0
        RenderResources::RenderError.UnknownInstance: 1
        error failure: 2
    return 22 if stale != 1
    0
