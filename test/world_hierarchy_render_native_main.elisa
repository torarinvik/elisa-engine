# Drives a kinematic Jolt body through the public fixed-step session, samples
# the hierarchy pose, then submits that exact pose to a live Wicked frame.
include "../src/runtime/public.elisa"
include "./world_hierarchy_render_probe.elisa"

module WorldHierarchyRenderNative:
    private:
        const module Tune:
            WIDTH: i32 = 320
            HEIGHT: i32 = 200
            RENDER_ID: i64 = 301
            BODY_HALF_EXTENT: f32 = 0.5
            INTERPOLATION_ALPHA: f32 = 0.5
            EXPECTED_SAMPLE_X: f32 = 2.0
            EXPECTED_TARGET_X: f32 = 4.0
            EXPECTED_HITCH_X: f32 = 14.0
            POSITION_TOLERANCE: f32 = 0.01

        def visual() -> Assets::VisualAsset:
            Assets::VisualAsset{
                mesh: Assets::AssetId{high: 7, low: 1},
                material: Assets::AssetId{high: 7, low: 2},
                local_bounds: Geometry::Bounds3{
                    minimum: Geometry::Vec3{x: -1.0, y: -1.0, z: -1.0},
                    maximum: Geometry::Vec3{x: 1.0, y: 1.0, z: 1.0},
                },
            }

        def requirements() -> BackendRequirements::BackendStartupRequirements:
            value: mutable BackendRequirements::BackendStartupRequirements = zeroed
            value.services[0] <- Capabilities::BackendFeature.Rendering
            value.services[1] <- Capabilities::BackendFeature.NativeWindow
            value.services[2] <- Capabilities::BackendFeature.Physics
            value.service_count <- 3
            value.service_fallbacks <- Capabilities::BackendFallbackProviders{
                input: Capabilities::BackendFallbackProvider.None,
                rendering: Capabilities::BackendFallbackProvider.None,
                physics: Capabilities::BackendFallbackProvider.JoltPhysics,
                audio: Capabilities::BackendFallbackProvider.None,
                native_window: Capabilities::BackendFallbackProvider.None,
                async_upload: Capabilities::BackendFallbackProvider.None,
                callbacks: Capabilities::BackendFallbackProvider.None,
                asset_loading: Capabilities::BackendFallbackProvider.None,
            }
            value.allow_service_fallbacks <- true
            value

        def exercise(session: mutable RuntimeServices::Session&) -> i32:
            world: mutable World::World = catch World::World():
                value: value
                error failure: return 1
            previous: Geometry::Transform = Geometry::Transform{
                position: Geometry::Vec3{x: 0.0, y: 4.0, z: 0.0},
                rotation: Geometry::quat_identity(),
                scale: Geometry::Vec3{x: 1.5, y: 1.0, z: 0.75},
            }
            gameplay: World::EntityRef = catch World::world_spawn(
                &world, World::Actor.Player):
                value: value
                error failure: return 2
            world_pose_status: i32 = catch World::world_set_transform(
                &world, gameplay, previous):
                ok: 0
                error failure: 1
            return 3 if world_pose_status != 0

            hierarchy: mutable WorldHierarchy::Hierarchy = WorldHierarchy::Hierarchy()
            return 4 if not WorldHierarchy::hierarchy_spawn(
                &hierarchy, gameplay.id, previous)
            WorldHierarchy::hierarchy_update(&hierarchy)

            physics_bindings: mutable WorldPhysics::Bindings = WorldPhysics::Bindings()
            physics_bind_status: i32 = catch WorldPhysics::bind_hierarchy(session,
                &world, &hierarchy, &physics_bindings, gameplay,
                PhysicsRuntime::BodyKind.Kinematic,
                Geometry::Vec3{x: Tune::BODY_HALF_EXTENT,
                    y: Tune::BODY_HALF_EXTENT, z: Tune::BODY_HALF_EXTENT}, 0.0):
                ok: 0
                error failure: 1
            return 5 if physics_bind_status != 0

            pose_before_pause: PhysicsRuntime::BodyPose = catch WorldPhysics::body_pose(
                session, physics_bindings, gameplay):
                value: value
                error failure: return 60
            pause_set: bool = catch RuntimeServices::set_simulation_paused(session, true):
                ok: true
                RuntimeServices::RuntimeServicesError.SessionStopped: false
                error failure: false
            return 61 if not pause_set or not RuntimeServices::simulation_paused(session)
            paused_frame: RuntimeServices::SimulationFrame = catch RuntimeServices::advance_simulation(
                session, Runtime::fixed_step_micros() * 100):
                value: value
                error failure: return 62
            return 63 if (paused_frame.steps != 0 or paused_frame.tick_count != 0 or
                not paused_frame.paused)
            pose_while_paused: PhysicsRuntime::BodyPose = catch WorldPhysics::body_pose(
                session, physics_bindings, gameplay):
                value: value
                error failure: return 64
            return 65 if (pose_while_paused.position.x != pose_before_pause.position.x or
                pose_while_paused.position.y != pose_before_pause.position.y or
                pose_while_paused.position.z != pose_before_pause.position.z)
            resume_set: bool = catch RuntimeServices::set_simulation_paused(session, false):
                ok: true
                RuntimeServices::RuntimeServicesError.SessionStopped: false
                error failure: false
            return 66 if not resume_set or RuntimeServices::simulation_paused(session)

            render_bindings: mutable WorldRendering::Bindings = WorldRendering::Bindings()
            render_bind_status: i32 = catch WorldRendering::bind(&render_bindings,
                &world, gameplay, Tune::RENDER_ID, visual(),
                Geometry::transform_identity()):
                ok: 0
                error failure: 1
            return 6 if render_bind_status != 0

            target: Geometry::Transform = Geometry::Transform{
                position: Geometry::Vec3{x: Tune::EXPECTED_TARGET_X, y: 4.0, z: 0.0},
                rotation: Geometry::quat_identity(),
                scale: previous.scale,
            }
            return 7 if not WorldHierarchy::hierarchy_set_local(
                &hierarchy, gameplay.id, target, false)
            staged_target: mutable Geometry::Transform = Geometry::transform_identity()
            staged_depth: mutable usize = 0
            return 8 if not WorldHierarchy::hierarchy_try_target_world(
                hierarchy, gameplay.id, &staged_target, &staged_depth)
            return 9 if staged_target.position.x != Tune::EXPECTED_TARGET_X
            authoritative_before: Geometry::Transform = WorldHierarchy::hierarchy_world(
                hierarchy, gameplay.id)
            return 10 if authoritative_before.position.x != previous.position.x

            frame: RuntimeServices::SimulationFrame = catch WorldPhysics::advance_and_sync_hierarchy(
                session, &hierarchy, physics_bindings, Runtime::fixed_step_micros()):
                value: value
                error failure: return 11
            return 12 if frame.steps != 1 or frame.tick_count != 1

            authoritative_after: Geometry::Transform = WorldHierarchy::hierarchy_world(
                hierarchy, gameplay.id)
            return 13 if ElisaMath::fabsf(authoritative_after.position.x -
                Tune::EXPECTED_TARGET_X) > Tune::POSITION_TOLERANCE
            snapshot: mutable RenderSnapshot::Snapshot = RenderSnapshot::Snapshot()
            extract_status: i32 = catch WorldRendering::extract_hierarchy(&world,
                &hierarchy, &render_bindings, Tune::INTERPOLATION_ALPHA, &snapshot):
                ok: 0
                error failure: 1
            return 14 if extract_status != 0 or RenderSnapshot::snapshot_count(snapshot) != 1
            entry: RenderSnapshot::Entry = RenderSnapshot::snapshot_entry(snapshot, 0)
            return 15 if ElisaMath::fabsf(entry.transform.position.x -
                Tune::EXPECTED_SAMPLE_X) > Tune::POSITION_TOLERANCE
            render_status: i32 = WorldHierarchyRenderProbe::render(
                previous, entry.transform, gameplay)
            return render_status if render_status != 0

            teleport_target: Geometry::Transform = Geometry::Transform{
                position: Geometry::Vec3{x: 12.0, y: 4.0, z: 0.0},
                rotation: Geometry::quat_identity(),
                scale: previous.scale,
            }
            return 70 if not WorldHierarchy::hierarchy_set_local(
                &hierarchy, gameplay.id, teleport_target, true)
            teleport_frame: RuntimeServices::SimulationFrame = catch WorldPhysics::advance_and_sync_hierarchy(
                session, &hierarchy, physics_bindings, Runtime::fixed_step_micros()):
                value: value
                error failure: return 71
            return 72 if teleport_frame.steps != 1 or teleport_frame.tick_count != 2
            teleported_pose: Geometry::Transform = WorldHierarchy::hierarchy_sample(
                hierarchy, gameplay.id, Tune::INTERPOLATION_ALPHA)
            return 73 if ElisaMath::fabsf(teleported_pose.position.x -
                teleport_target.position.x) > Tune::POSITION_TOLERANCE
            teleport_snapshot: mutable RenderSnapshot::Snapshot = RenderSnapshot::Snapshot()
            teleport_extract: i32 = catch WorldRendering::extract_hierarchy(&world,
                &hierarchy, &render_bindings, Tune::INTERPOLATION_ALPHA,
                &teleport_snapshot):
                ok: 0
                error failure: 1
            return 74 if teleport_extract != 0 or RenderSnapshot::snapshot_count(
                teleport_snapshot) != 1
            teleport_entry: RenderSnapshot::Entry = RenderSnapshot::snapshot_entry(
                teleport_snapshot, 0)
            return 75 if ElisaMath::fabsf(teleport_entry.transform.position.x -
                teleport_target.position.x) > Tune::POSITION_TOLERANCE

            hitch_target: Geometry::Transform = Geometry::Transform{
                position: Geometry::Vec3{x: Tune::EXPECTED_HITCH_X, y: 4.0, z: 0.0},
                rotation: Geometry::quat_identity(),
                scale: previous.scale,
            }
            return 76 if not WorldHierarchy::hierarchy_set_local(
                &hierarchy, gameplay.id, hitch_target, false)
            hitch_frame: RuntimeServices::SimulationFrame = catch WorldPhysics::advance_and_sync_hierarchy(
                session, &hierarchy, physics_bindings,
                Runtime::fixed_step_micros() * 100):
                value: value
                error failure: return 77
            return 78 if (hitch_frame.steps != Runtime::max_catch_up_steps() or
                hitch_frame.tick_count != 6)
            hitch_pose: Geometry::Transform = WorldHierarchy::hierarchy_world(
                hierarchy, gameplay.id)
            return 79 if ElisaMath::fabsf(hitch_pose.position.x -
                Tune::EXPECTED_HITCH_X) > Tune::POSITION_TOLERANCE

            render_unbind: bool = WorldRendering::unbind(&render_bindings,
                gameplay, Tune::RENDER_ID)
            physics_unbind: bool = catch WorldPhysics::unbind(session,
                &physics_bindings, gameplay):
                ok: true
                error failure: false
            return 16 if not render_unbind or not physics_unbind
            0

        def execute() -> i32:
            config: Application::Config = Application::Config{
                title: "Elisa Session Physics Hierarchy Render Smoke",
                width: Tune::WIDTH,
                height: Tune::HEIGHT,
                hidden: true,
            }
            startup: mutable BackendRequirements::BackendStartupRequirements = requirements()
            report: mutable BackendRequirements::BackendRequirementsReport =
                BackendRequirements::backend_requirements_invalid_report()
            session: mutable RuntimeServices::Session = RuntimeServices::Session()
            opened: RuntimeServices::OpenStatus = RuntimeServices::open(&session,
                config, &startup, AudioRuntime::MIN_SAMPLE_RATE_HZ,
                AudioRuntime::MIN_CHANNEL_COUNT, &report)
            if (opened != RuntimeServices::OpenStatus.Ready and
                opened != RuntimeServices::OpenStatus.FallbackRequired):
                _ = RuntimeServices::shutdown(&session)
                return 20
            result: i32 = exercise(&session)
            closed: bool = RuntimeServices::shutdown(&session)
            return result if result != 0
            return 21 if not closed
            0

    public:
        def run() -> i32:
            WorldHierarchyRenderNative::execute()

def main() -> i32:
    WorldHierarchyRenderNative::run()
