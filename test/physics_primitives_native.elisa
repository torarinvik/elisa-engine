include "../src/runtime/application.elisa"
include "../src/physics/runtime.elisa"
include "./physics_primitives_probe.elisa"

module PhysicsPrimitivesNative:
    private:
        const module Window:
            WIDTH: i32 = 320
            HEIGHT: i32 = 240

    public:
        def verify_recovery() -> i32:
            recovered_world: mutable PhysicsRuntime::World = catch PhysicsRuntime::World():
                value: value
                error failure: return 6
            recovered_body: PhysicsRuntime::BodyHandle = catch PhysicsRuntime::body_create(recovered_world,
                PhysicsRuntime::BodyDesc{
                    kind: PhysicsRuntime::BodyKind.Static,
                    shape: PhysicsRuntime::BodyShape.Box,
                    position: Geometry::Vec3{x: 0.0, y: 0.0, z: 0.0},
                    dimensions: Geometry::Vec3{x: 0.5, y: 0.5, z: 0.5},
                    mass: 0.0,
                    sensor: false,
                    collision_layer: 0,
                }):
                value: value
                error failure: return 7
            recovered_destroy: i32 = catch PhysicsRuntime::body_destroy(recovered_world, recovered_body):
                ok: 0
                error failure: 1
            recovered_closed: bool = catch PhysicsRuntime::shutdown(&recovered_world):
                ok: true
                error failure: false
            return 8 if recovered_destroy != 0
            return 10 if not recovered_closed
            0

        def run() -> i32:
            config: Application::Config = Application::Config{
                title: "Elisa Physics Primitive Smoke",
                width: Window::WIDTH,
                height: Window::HEIGHT,
                hidden: true,
            }
            return 1 if Application::initialize(config) != Application::InitializeStatus.Ready
            world: mutable PhysicsRuntime::World = catch PhysicsRuntime::World():
                value: value
                error failure: return 2
            stage: mutable i32 = 0
            result: i32 = PhysicsPrimitiveProbe::run(&world, &stage)
            mesh_result: mutable i32 = 0
            capacity_result: mutable i32 = 0
            if result == 0:
                mesh_result <- PhysicsPrimitiveProbe::mesh_shapes(&world, &stage)
                if mesh_result == 0:
                    capacity_result <- PhysicsPrimitiveProbe::capacity(&world)
            world_closed: bool = catch PhysicsRuntime::shutdown(&world):
                ok: true
                error failure: false
            recovery_result: i32 = verify_recovery()
            application_closed: bool = Application::shutdown()
            return result if result != 0
            return 30 + mesh_result if mesh_result != 0
            return 5 if capacity_result != 0
            return 3 if not world_closed
            return recovery_result if recovery_result != 0
            return 4 if not application_closed
            0

def main() -> i32:
    PhysicsPrimitivesNative::run()
