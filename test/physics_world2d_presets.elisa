include "../src/physics/world2d_presets.elisa"

def tower() -> Physics2dCircles::Circle[32]:
    mutable b: Physics2dCircles::Circle[32] = zeroed
    for i in 0..<5 |b|:
        b[i] <- Physics2dCircles::Circle{x_um: 0, y_um: 150000 + 260000 * i.i64(), vx: 0, vy: 0, radius_um: 100000, mass_g: 100}
    b

# Settles a five-ball stack for 3 s of 16 ms frames; returns the worst
# overlap over the last second and the top ball's height.
def settle(preset: Physics2dPresets::Preset) -> i64[3]:
    open_scene: Physics2dRamp::Statics = Physics2dRamp::open()
    mutable b: Physics2dCircles::Circle[32] = tower()
    mutable worst: i64 = 0
    mutable steps: i64 = 0
    for f in 0..<188 |b, worst, steps|:
        r: Physics2dPresets::FrameReport = Physics2dPresets::step_frame(&b, 5, preset, 16, 9810000, 0, 200, &open_scene)
        steps <- steps + r.substeps
        o: i64 = Physics2dPresets::max_overlap_um(&b, 5, 0)
        worst <- o if f >= 125 and o > worst else worst
    [worst, b[4].y_um, steps]

def main() -> i32:
    fast: i64[3] = settle(Physics2dPresets::fast())
    balanced: i64[3] = settle(Physics2dPresets::balanced())
    stable: i64[3] = settle(Physics2dPresets::stable())
    return 1 if fast[2] != 188 or balanced[2] != 376 or stable[2] != 752
    # Measured worst settled overlaps (23, 10, 4 mm) as regression budgets.
    return 2 if fast[0] > 30000
    return 3 if balanced[0] > 12000
    return 4 if stable[0] > 6000
    return 5 if not (stable[0] < balanced[0] and balanced[0] < fast[0])
    # Every tower stands near its ideal 0.9 m top.
    return 6 if fast[1] < 840000 or stable[1] < 860000
    # A 100 ms hitch is clamped to the budget and the rest reported dropped.
    open_scene: Physics2dRamp::Statics = Physics2dRamp::open()
    mutable b: Physics2dCircles::Circle[32] = tower()
    hitch: Physics2dPresets::FrameReport = Physics2dPresets::step_frame(&b, 5, Physics2dPresets::stable(), 100, 9810000, 0, 200, &open_scene)
    return 7 if hitch.substeps != 8 or hitch.dropped_ms != 68
    # A 10 ms frame under balanced runs 8 + 2.
    short: Physics2dPresets::FrameReport = Physics2dPresets::step_frame(&b, 5, Physics2dPresets::balanced(), 10, 9810000, 0, 200, &open_scene)
    return 8 if short.substeps != 2 or short.dropped_ms != 0
    # Relaxation separates an overlapping pair and lifts it out of the ground
    # without touching velocity; zero passes move nothing.
    mutable pair: Physics2dCircles::Circle[32] = zeroed
    pair[0] <- Physics2dCircles::Circle{x_um: 0, y_um: 50000, vx: 0, vy: 7, radius_um: 100000, mass_g: 100}
    pair[1] <- Physics2dCircles::Circle{x_um: 0, y_um: 150000, vx: 0, vy: 0, radius_um: 100000, mass_g: 100}
    return 9 if Physics2dPresets::relax(&pair, 2, 0, 0, &open_scene) != 0 or pair[0].y_um != 50000
    Physics2dPresets::relax(&pair, 2, 0, 8, &open_scene)
    return 10 if Physics2dPresets::max_overlap_um(&pair, 2, 0) > 1000 or pair[0].y_um < 100000 or pair[0].vy != 7
    # Relaxation keeps bodies out of statics: a pair squeezed against a wall
    # (x 1.0..1.1 m) is pushed back out rather than into it, and a ball
    # pressed into a ramp face leaves along its normal.
    mutable walled: Physics2dRamp::Statics = Physics2dRamp::open()
    walled.walls[0] <- Physics2dCcd::Wall{x_um: 1000000, thickness_um: 100000, y_min_um: 0, y_max_um: 2000000}
    walled.wall_count <- 1
    mutable squeeze: Physics2dCircles::Circle[32] = zeroed
    squeeze[0] <- Physics2dCircles::Circle{x_um: 760000, y_um: 500000, vx: 0, vy: 0, radius_um: 100000, mass_g: 100}
    squeeze[1] <- Physics2dCircles::Circle{x_um: 940000, y_um: 500000, vx: 0, vy: 0, radius_um: 100000, mass_g: 100}
    Physics2dPresets::relax(&squeeze, 2, 0, 8, &walled)
    return 11 if squeeze[1].x_um > 900000 or squeeze[0].x_um > squeeze[1].x_um - 190000
    mutable ramped: Physics2dRamp::Statics = Physics2dRamp::open()
    ramped.ramps[0] <- Physics2dRamp::Segment{ax_um: 0, ay_um: 0, bx_um: 2000000, by_um: 2000000}
    ramped.ramp_count <- 1
    mutable c: Physics2dCircles::Circle = Physics2dCircles::Circle{x_um: 1000000, y_um: 1050000, vx: 0, vy: 0, radius_um: 100000, mass_g: 100}
    return 12 if Physics2dPresets::push_out(&c, &ramped) != 1
    gap: i64 = Physics2dRamp::distance_um(&ramped.ramps[0], c.x_um, c.y_um)
    return 13 if gap < 99000 or gap > 101000
    return 0
