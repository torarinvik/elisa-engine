include "../src/tooling/transactions.elisa"

def make(doc: EditTransactions::Doc, history: mutable EditTransactions::History&, id: i64, parent: i64, group: i64) -> EditTransactions::Applied:
    EditTransactions::apply(doc, history, EditTransactions::Kind.Create, id, parent, group)

def main() -> i32:
    history: mutable EditTransactions::History = EditTransactions::History()
    root: EditTransactions::Applied = make(EditTransactions::Doc(), &history, 0, 15, 1)
    child: EditTransactions::Applied = make(root.doc, &history, 1, 0, 2)
    leaf: EditTransactions::Applied = make(child.doc, &history, 2, 1, 3)
    return 1 if not root.ok or not child.ok or not leaf.ok
    doc: EditTransactions::Doc = leaf.doc
    return 2 if EditTransactions::parent_of(&doc, 2) != 1 or EditTransactions::parent_of(&doc, 0) != 15
    # Failed commands change neither the document nor the history.
    before: i64 = history.position
    dup: EditTransactions::Applied = make(doc, &history, 2, 0, 4)
    orphan: EditTransactions::Applied = make(doc, &history, 3, 9, 4)
    parented: EditTransactions::Applied = EditTransactions::apply(doc, &history, EditTransactions::Kind.Delete, 1, 15, 4)
    cycle: EditTransactions::Applied = EditTransactions::apply(doc, &history, EditTransactions::Kind.Reparent, 0, 2, 4)
    self: EditTransactions::Applied = EditTransactions::apply(doc, &history, EditTransactions::Kind.Reparent, 1, 1, 4)
    range: EditTransactions::Applied = make(doc, &history, 99, 15, 4)
    return 3 if dup.ok or orphan.ok or parented.ok or cycle.ok or self.ok or range.ok
    return 4 if history.position != before or dup.doc.alive != doc.alive or cycle.doc.parents != doc.parents
    # A multi-object action shares a group and undoes as a unit.
    moved: EditTransactions::Applied = EditTransactions::apply(doc, &history, EditTransactions::Kind.Reparent, 2, 0, 5)
    sibling: EditTransactions::Applied = make(moved.doc, &history, 3, 0, 5)
    return 5 if not moved.ok or not sibling.ok or EditTransactions::parent_of(&sibling.doc, 2) != 0
    undone: EditTransactions::Applied = EditTransactions::undo(sibling.doc, &history)
    return 6 if not undone.ok or EditTransactions::is_alive(&undone.doc, 3) or EditTransactions::parent_of(&undone.doc, 2) != 1
    return 7 if not EditTransactions::redoable(&history) or history.position != 3
    redone: EditTransactions::Applied = EditTransactions::redo(undone.doc, &history)
    return 8 if not redone.ok or not EditTransactions::is_alive(&redone.doc, 3) or EditTransactions::parent_of(&redone.doc, 2) != 0
    # Delete restores its old parent on undo; a new edit drops the redo tail.
    gone: EditTransactions::Applied = EditTransactions::apply(redone.doc, &history, EditTransactions::Kind.Delete, 3, 15, 6)
    return 9 if not gone.ok or EditTransactions::is_alive(&gone.doc, 3)
    back: EditTransactions::Applied = EditTransactions::undo(gone.doc, &history)
    return 10 if not back.ok or EditTransactions::parent_of(&back.doc, 3) != 0
    branch: EditTransactions::Applied = make(back.doc, &history, 4, 0, 7)
    return 11 if not branch.ok or EditTransactions::redoable(&history)
    # Undo against a document edited outside the history changes nothing.
    stale: EditTransactions::Applied = EditTransactions::undo(EditTransactions::Doc(), &history)
    return 12 if stale.ok or stale.doc.alive != 0
    # Bounded: a full history refuses new edits.
    small: mutable EditTransactions::History = EditTransactions::History()
    current: mutable EditTransactions::Doc = EditTransactions::Doc()
    accepted: mutable i64 = 0
    for id in 0..<15 |small, current, accepted|:
        step: EditTransactions::Applied = make(current, &small, id, 15, id + 1)
        current <- step.doc
        accepted <- accepted + 1 if step.ok else accepted
    return 13 if accepted != 15
    for turn in 0..<9 |small, current, accepted|:
        step: EditTransactions::Applied = EditTransactions::apply(current, &small, EditTransactions::Kind.Reparent, 1, 0 if turn % 2 == 0 else 15, 20 + turn)
        current <- step.doc
        accepted <- accepted + 1 if step.ok else accepted
    return 14 if accepted != 24 or small.position != 24
    full: EditTransactions::Applied = EditTransactions::apply(current, &small, EditTransactions::Kind.Reparent, 1, 0, 40)
    return 15 if full.ok or small.position != 24 or full.doc.parents != current.parents
    0
