# Native A03 coverage for snapshot textures read from ELPK bundle sections.
# scripts/bundle_texture_fixtures.py writes the bundles under build/cooked.
include "../src/runtime/render_scene_assets.elisa"

module RenderSceneBundleTextureNativeTests:
    private:
        @callconv(c)
        extern elisa_render_scene_v1_test_snapshot_material_texture_size(
            material_high: u64, material_low: u64, slot: i32, width: u32, height: u32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_snapshot_bundle_texture_source_bytes() -> u64

        const module Ids:
            TEXTURES: u64 = 910
            MATERIALS: u64 = 911

        def texture_id(low: u64) -> Assets::AssetId:
            Assets::AssetId{high: Ids::TEXTURES, low: low}

        def register(low: u64, bundle: cstr, section: cstr) -> i32:
            catch RenderScene::register_snapshot_bundle_texture_asset(texture_id(low), bundle, section):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                RenderScene::RenderSceneError.AssetLoadFailure: 2
                RenderScene::RenderSceneError.Capacity: 3
                error failure: 4

        def register_material(low: u64, texture_low: u64) -> i32:
            material: mutable Material::Material = Material::Material()
            material.base_color <- texture_id(texture_low)
            catch RenderScene::register_snapshot_material_asset(
                Assets::AssetId{high: Ids::MATERIALS, low: low}, &material):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                RenderScene::RenderSceneError.AssetLoadFailure: 2
                error failure: 4

        def unregister_texture(low: u64) -> i32:
            catch RenderScene::unregister_snapshot_texture_asset(texture_id(low)):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 4

        def unregister_material(low: u64) -> i32:
            catch RenderScene::unregister_snapshot_material_asset(
                Assets::AssetId{high: Ids::MATERIALS, low: low}):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 4

        def base_color_size(material_low: u64, width: u32, height: u32) -> bool:
            elisa_render_scene_v1_test_snapshot_material_texture_size(
                Ids::MATERIALS, material_low, 0, width, height) == 1

        # Every one of these must fail before any bytes are retained.
        def rejected_registrations() -> i32:
            bundle: cstr = "build/cooked/render-scene-textures.elpk"
            return 20 if register(3, bundle, "missing") != 2
            return 21 if register(3, bundle, "ktx") != 2
            return 22 if register(3, bundle, "huge") != 2
            return 23 if register(3, "build/cooked/render-scene-textures-corrupt.elpk", "albedo") != 2
            return 24 if register(3, "../build/cooked/render-scene-textures.elpk", "albedo") != 2
            return 25 if register(3, "/etc/passwd", "albedo") != 2
            return 26 if register(3, "build/cooked/render-scene-textures-link.elpk", "albedo") != 2
            return 27 if register(3, "examples/maze/assets/maze_tile.elpk", "mesh") != 2
            return 28 if register(3, bundle, "Albedo") != 1
            return 29 if register(3, bundle, "") != 1
            return 30 if register(3, bundle, "sixteen_bytes_12") != 1
            0

    public:
        def exercise() -> i32:
            bundle: cstr = "build/cooked/render-scene-textures.elpk"
            return 1 if elisa_render_scene_v1_test_snapshot_bundle_texture_source_bytes() != 0
            return 2 if register(1, bundle, "albedo") != 0
            albedo_bytes: u64 = elisa_render_scene_v1_test_snapshot_bundle_texture_source_bytes()
            return 3 if albedo_bytes == 0 or albedo_bytes > 4096
            return 4 if register(1, bundle, "albedo") != 0
            return 5 if elisa_render_scene_v1_test_snapshot_bundle_texture_source_bytes() != albedo_bytes
            return 6 if register(1, bundle, "photo") != 1
            path_texture: i32 = catch RenderScene::register_snapshot_texture_asset(texture_id(1), bundle):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 7 if path_texture != 1
            return 8 if register(2, bundle, "photo") != 0
            return 9 if elisa_render_scene_v1_test_snapshot_bundle_texture_source_bytes() <= albedo_bytes

            return 10 if register_material(1, 1) != 0 or not base_color_size(1, 16, 8)
            return 11 if register_material(2, 2) != 0 or not base_color_size(2, 24, 12)
            retained: u64 = elisa_render_scene_v1_test_snapshot_bundle_texture_source_bytes()
            rejected: i32 = rejected_registrations()
            return rejected if rejected != 0
            return 12 if elisa_render_scene_v1_test_snapshot_bundle_texture_source_bytes() != retained

            # The checked PNG decoder rejects this truncated image before
            # retaining a texture slot.
            return 13 if register(4, bundle, "truncated") != 2
            return 15 if unregister_texture(1) != 1

            return 16 if unregister_material(1) != 0 or unregister_texture(1) != 0
            # A freed ID may name different bytes; the material must see the new image.
            return 17 if register(1, bundle, "photo") != 0
            return 18 if register_material(1, 1) != 0 or not base_color_size(1, 24, 12)
            return 19 if unregister_material(1) != 0 or unregister_material(2) != 0
            return 31 if unregister_texture(1) != 0 or unregister_texture(2) != 0 or unregister_texture(4) != 4
            return 32 if elisa_render_scene_v1_test_snapshot_bundle_texture_source_bytes() != 0
            0
