# Native smoke coverage for the public double-buffered animation submission.
include "../src/runtime/render_scene_imported_scene.elisa"
extend RenderScene:
    public:
        # C smoke probes accept the raw i64 ABI handle. Keep the conversion in
        # this test-only extension so normal application code still sees the
        # opaque InstanceHandle wrapper.
        def native_smoke_handle(handle: InstanceHandle) -> i64:
            handle.native_value

module RenderSceneAnimationSubmissionNativeTests:
    private:
        const SHIFT_X: f32 = 2.0
        const OTHER_SHIFT_X: f32 = -2.0
        const ZERO_MORPH: f32 = 0.0
        const TIP_CLUSTER: u32 = 1
        const INVERSE_BIND_TRANSLATION_ROW: u32 = 3
        const INVERSE_BIND_X_COLUMN: u32 = 0
        const INVERSE_BIND_Y_COLUMN: u32 = 1
        const EXPECTED_WICKED_INVERSE_BIND_X: f32 = 2.0
        const EXPECTED_WICKED_INVERSE_BIND_Y: f32 = -1.0
        const SEPARATE_ROOT_WICKED_Z: f32 = -0.5
        const ANIMATION_STATE_MATCH_ALL: i32 = 31
        const ANIMATION_STATE_ERROR_BASE: i32 = 40

        @callconv(c)
        extern elisa_render_scene_v1_test_animation_submission(handle: i64,
            expected_x: f32, expected_morph: f32, expected_pending: i32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_animation_instances(
            first_handle: i64, first_x: f32,
            second_handle: i64, second_x: f32,
            expected_pending: i32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_inverse_bind(handle: i64,
            cluster: u32, row: u32, column: u32, expected: f32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_skin_mesh_relative_root(
            handle: i64, expected_world_z: f32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_multi_skin_layout(
            handle: i64) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_mixed_skin_layout(
            handle: i64) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_morph_animation_weights(
            handle: i64, first_weight: f32, second_weight: f32) -> i32

    public:
        def exercise() -> i32:
            mesh: RenderScene::InstanceHandle = catch RenderScene::create_mesh(
                "build/cooked/subsets/morphed-skinned.pkg", Geometry::transform_identity(),
                RenderScene::Color{red: 0.8, green: 0.8, blue: 0.8, alpha: 1.0}):
                value: value
                error failure: return 1
            return 23 if elisa_render_scene_v1_test_inverse_bind(RenderScene::native_smoke_handle(mesh), TIP_CLUSTER,
                INVERSE_BIND_TRANSLATION_ROW, INVERSE_BIND_X_COLUMN,
                EXPECTED_WICKED_INVERSE_BIND_X) != 1
            return 24 if elisa_render_scene_v1_test_inverse_bind(RenderScene::native_smoke_handle(mesh), TIP_CLUSTER,
                INVERSE_BIND_TRANSLATION_ROW, INVERSE_BIND_Y_COLUMN,
                EXPECTED_WICKED_INVERSE_BIND_Y) != 1
            second_mesh: RenderScene::InstanceHandle = catch RenderScene::create_mesh(
                "build/cooked/subsets/morphed-skinned.pkg", Geometry::transform_identity(),
                RenderScene::Color{red: 0.7, green: 0.7, blue: 0.9, alpha: 1.0}):
                value: value
                error failure: return 10
            pose: mutable RenderScene::AnimationPose = RenderScene::AnimationPose()
            shifted: Geometry::Transform = Geometry::Transform{
                position: Geometry::Vec3{x: SHIFT_X, y: 0.0, z: 0.0},
                rotation: Geometry::quat_identity(),
                scale: Geometry::vec3_one(),
            }
            invalid_bone: i32 = catch RenderScene::set_bone_transform(&pose,
                RenderSceneAnimationSubmission::MAX_BONES, shifted):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 2 if invalid_bone != 1
            invalid_morph: i32 = catch RenderScene::set_morph_weight(&pose,
                RenderSceneAnimationSubmission::MAX_MORPHS, 0.5):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 8 if invalid_morph != 1
            invalid_weight: i32 = catch RenderScene::set_morph_weight(&pose, 0, 1.1):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 9 if invalid_weight != 1
            set_bone: i32 = catch RenderScene::set_bone_transform(&pose, 0, shifted):
                ok: 0
                error failure: 1
            return 3 if set_bone != 0
            second_pose: mutable RenderScene::AnimationPose = RenderScene::AnimationPose()
            second_shifted: Geometry::Transform = Geometry::Transform{
                position: Geometry::Vec3{x: OTHER_SHIFT_X, y: 0.0, z: 0.0},
                rotation: Geometry::quat_identity(),
                scale: Geometry::vec3_one(),
            }
            second_set_bone: i32 = catch RenderScene::set_bone_transform(&second_pose, 0, second_shifted):
                ok: 0
                error failure: 1
            return 11 if second_set_bone != 0
            set_morph: i32 = catch RenderScene::set_morph_weight(&pose, 0, ZERO_MORPH):
                ok: 0
                error failure: 1
            return 17 if set_morph != 0
            set_second_bone: i32 = catch RenderScene::set_bone_transform(&pose, 1,
                Geometry::transform_identity()):
                ok: 0
                error failure: 1
            return 21 if set_second_bone != 0
            second_set_morph: i32 = catch RenderScene::set_morph_weight(&second_pose, 0, ZERO_MORPH):
                ok: 0
                error failure: 1
            return 18 if second_set_morph != 0
            second_set_second_bone: i32 = catch RenderScene::set_bone_transform(&second_pose, 1,
                Geometry::transform_identity()):
                ok: 0
                error failure: 1
            return 22 if second_set_second_bone != 0
            submit: i32 = catch RenderScene::submit_animation_pose(mesh, &pose):
                ok: 0
                error failure: 1
            return 4 if submit != 0
            animation_state: i32 = elisa_render_scene_v1_test_animation_submission(
                RenderScene::native_smoke_handle(mesh), SHIFT_X, ZERO_MORPH, 1)
            return ANIMATION_STATE_ERROR_BASE + animation_state if animation_state != ANIMATION_STATE_MATCH_ALL
            second_submit: i32 = catch RenderScene::submit_animation_pose(second_mesh, &second_pose):
                ok: 0
                error failure: 1
            return 12 if second_submit != 0
            return 13 if Application::pump() != Application::PumpStatus.Running
            return 14 if elisa_render_scene_v1_test_animation_instances(
                RenderScene::native_smoke_handle(mesh), SHIFT_X,
                RenderScene::native_smoke_handle(second_mesh), OTHER_SHIFT_X, 1) != 1
            duplicate_submit: i32 = catch RenderScene::submit_animation_pose(mesh, &pose):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 5 if duplicate_submit != 1
            completed: i32 = catch RenderScene::complete_animation_pose(mesh):
                ok: 0
                error failure: 1
            completed_state: i32 = elisa_render_scene_v1_test_animation_submission(
                RenderScene::native_smoke_handle(mesh), SHIFT_X, ZERO_MORPH, 0)
            return 6 if completed != 0 or completed_state != ANIMATION_STATE_MATCH_ALL
            repeated_complete: i32 = catch RenderScene::complete_animation_pose(mesh):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 7 if repeated_complete != 1
            second_completed: i32 = catch RenderScene::complete_animation_pose(second_mesh):
                ok: 0
                error failure: 1
            return 15 if second_completed != 0 or elisa_render_scene_v1_test_animation_instances(
                RenderScene::native_smoke_handle(mesh), SHIFT_X,
                RenderScene::native_smoke_handle(second_mesh), OTHER_SHIFT_X, 0) != 1
            second_destroyed: i32 = catch RenderScene::destroy(second_mesh):
                ok: 0
                error failure: 1
            return 16 if second_destroyed != 0
            destroyed: i32 = catch RenderScene::destroy(mesh):
                ok: 0
                error failure: 1
            return 8 if destroyed != 0
            separate_root: RenderScene::InstanceHandle = catch RenderScene::create_mesh(
                "build/cooked/subsets/separate-root-skinned.pkg", Geometry::transform_identity(),
                RenderScene::Color{red: 0.8, green: 0.8, blue: 0.8, alpha: 1.0}):
                value: value
                error failure: return 25
            return 26 if Application::pump() != Application::PumpStatus.Running
            return 27 if elisa_render_scene_v1_test_skin_mesh_relative_root(
                RenderScene::native_smoke_handle(separate_root), SEPARATE_ROOT_WICKED_Z) != 1
            separate_destroyed: i32 = catch RenderScene::destroy(separate_root):
                ok: 0
                error failure: 1
            return 28 if separate_destroyed != 0
            multi_skin: RenderScene::InstanceHandle = catch RenderScene::create_mesh(
                "build/cooked/subsets/multi-skin-panel.pkg", Geometry::transform_identity(),
                RenderScene::Color{red: 0.8, green: 0.8, blue: 0.8, alpha: 1.0}):
                value: value
                error failure: return 29
            return 30 if Application::pump() != Application::PumpStatus.Running
            return 31 if elisa_render_scene_v1_test_multi_skin_layout(RenderScene::native_smoke_handle(multi_skin)) != 1
            multi_skin_destroyed: i32 = catch RenderScene::destroy(multi_skin):
                ok: 0
                error failure: 1
            return 32 if multi_skin_destroyed != 0
            mixed_skin: RenderScene::InstanceHandle = catch RenderScene::create_mesh(
                "build/cooked/subsets/mixed-skin-panel.pkg", Geometry::transform_identity(),
                RenderScene::Color{red: 0.8, green: 0.8, blue: 0.8, alpha: 1.0}):
                value: value
                error failure: return 33
            return 34 if Application::pump() != Application::PumpStatus.Running
            return 35 if elisa_render_scene_v1_test_mixed_skin_layout(RenderScene::native_smoke_handle(mixed_skin)) != 1
            mixed_skin_destroyed: i32 = catch RenderScene::destroy(mixed_skin):
                ok: 0
                error failure: 1
            return 36 if mixed_skin_destroyed != 0
            morph_animation: RenderScene::InstanceHandle = catch RenderScene::create_mesh(
                "build/cooked/subsets/animated-morph-panel.pkg", Geometry::transform_identity(),
                RenderScene::Color{red: 0.8, green: 0.8, blue: 0.8, alpha: 1.0}):
                value: value
                error failure: return 37
            play_morph: i32 = catch RenderScene::play_animation(morph_animation, "weights", true, 1.0, 0.0):
                ok: 0
                error failure: 1
            return 38 if play_morph != 0 or elisa_render_scene_v1_test_morph_animation_weights(
                RenderScene::native_smoke_handle(morph_animation), 0.0, 0.2) != 1
            advance_morph: i32 = catch RenderScene::advance_animation(morph_animation, 0.5):
                ok: 0
                error failure: 1
            return 39 if advance_morph != 0 or elisa_render_scene_v1_test_morph_animation_weights(
                RenderScene::native_smoke_handle(morph_animation), 0.5, 0.2) != 1
            stop_morph: i32 = catch RenderScene::stop_animation(morph_animation, 0.0):
                ok: 0
                error failure: 1
            return 40 if stop_morph != 0 or elisa_render_scene_v1_test_morph_animation_weights(
                RenderScene::native_smoke_handle(morph_animation), 0.4, 0.2) != 1
            morph_destroyed: i32 = catch RenderScene::destroy(morph_animation):
                ok: 0
                error failure: 1
            return 41 if morph_destroyed != 0
            0

module RenderSceneImportedSceneNativeTests:
    private:
        @callconv(c)
        extern elisa_render_scene_v1_test_mesh_has_uv1(handle: i64) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_imported_mesh_visible(
            handle: i64, index: u32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_imported_mesh_position(
            handle: i64, index: u32,
            px: f32, py: f32, pz: f32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_imported_light_casts_shadow(
            handle: i64, index: u32) -> i32

    public:
        def exercise_uv1() -> i32:
            uv1_mesh: RenderScene::InstanceHandle = catch RenderScene::create_mesh(
                "build/cooked/subsets/uv1.pkg",
                Geometry::Transform{position: Geometry::Vec3{x: 20.0, y: 0.0, z: 0.0},
                    rotation: Geometry::quat_identity(), scale: Geometry::vec3_one()},
                RenderScene::Color{red: 1.0, green: 1.0, blue: 1.0, alpha: 1.0}):
                value: value
                error failure: return 80
            return 81 if elisa_render_scene_v1_test_mesh_has_uv1(
                RenderScene::native_smoke_handle(uv1_mesh)) != 1
            destroyed: i32 = catch RenderScene::destroy(uv1_mesh):
                ok: 0
                error failure: 1
            return 82 if destroyed != 0 or RenderScene::instance_count() != 4
            0

        def exercise() -> i32:
            hierarchy_mesh: RenderScene::InstanceHandle = catch RenderScene::create_mesh(
                "build/cooked/subsets/hierarchy.elpk", Geometry::transform_identity(),
                RenderScene::Color{red: 0.8, green: 0.2, blue: 0.1, alpha: 1.0}):
                value: value
                error failure: return 6
            hierarchy: RenderScene::ImportedScene = catch RenderScene::imported_scene(hierarchy_mesh):
                value: value
                error failure: return 7
            return 8 if hierarchy.mesh_count != 4 or hierarchy.camera_count != 0 or hierarchy.light_count != 0
            imported_child: RenderScene::ImportedMeshHandle = catch RenderScene::imported_mesh(
                hierarchy_mesh, 1):
                value: value
                error failure: return 9
            hidden_child: i32 = catch RenderScene::set_imported_mesh_visible(imported_child, false):
                ok: 0
                error failure: 1
            return 10 if hidden_child != 0 or elisa_render_scene_v1_test_imported_mesh_visible(
                RenderScene::native_smoke_handle(hierarchy_mesh), 1) != 0
            shown_child: i32 = catch RenderScene::set_imported_mesh_visible(imported_child, true):
                ok: 0
                error failure: 1
            return 11 if shown_child != 0 or elisa_render_scene_v1_test_imported_mesh_visible(
                RenderScene::native_smoke_handle(hierarchy_mesh), 1) != 1
            moved_child: i32 = catch RenderScene::update_imported_mesh_transform(imported_child,
                Geometry::Transform{
                    position: Geometry::Vec3{x: 0.25, y: 0.5, z: -0.75},
                    rotation: Geometry::quat_identity(),
                    scale: Geometry::vec3_one(),
                }):
                ok: 0
                error failure: 1
            return 12 if moved_child != 0 or elisa_render_scene_v1_test_imported_mesh_position(
                RenderScene::native_smoke_handle(hierarchy_mesh), 1, 0.25, 0.5, -0.75) != 1
            invalid_mesh: i32 = catch RenderScene::imported_mesh(hierarchy_mesh, hierarchy.mesh_count):
                value: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 13 if invalid_mesh != 1
            hierarchy_destroyed: i32 = catch RenderScene::destroy(hierarchy_mesh):
                ok: 0
                error failure: 14
            stale_child: i32 = catch RenderScene::set_imported_mesh_visible(imported_child, false):
                ok: 0
                RenderScene::RenderSceneError.UnknownHandle: 1
                error failure: 2
            return 15 if hierarchy_destroyed != 0 or stale_child != 1
            imported_mesh: RenderScene::InstanceHandle = catch RenderScene::create_mesh(
                "build/cooked/subsets/scene-metadata.pkg", Geometry::transform_identity(),
                RenderScene::Color{red: 0.2, green: 0.4, blue: 0.8, alpha: 1.0}):
                value: value
                error failure: return 16
            imported: RenderScene::ImportedScene = catch RenderScene::imported_scene(imported_mesh):
                value: value
                error failure: return 17
            imported_valid: bool = imported.mesh_count == 1 and imported.camera_count == 2 and imported.light_count == 2
            return 18 if RenderScene::instance_count() != 5 or not imported_valid
            light: RenderScene::ImportedLightHandle = catch RenderScene::imported_light(imported_mesh, 0):
                value: value
                error failure: return 19
            initial_light_shadow: i32 = elisa_render_scene_v1_test_imported_light_casts_shadow(
                RenderScene::native_smoke_handle(imported_mesh), 0)
            return 20 if initial_light_shadow != 0
            enabled_light_shadow: i32 = catch RenderScene::set_imported_light_cast_shadow(light, true):
                ok: 0
                error failure: 1
            return 21 if enabled_light_shadow != 0 or elisa_render_scene_v1_test_imported_light_casts_shadow(
                RenderScene::native_smoke_handle(imported_mesh), 0) != 1
            disabled_light_shadow: i32 = catch RenderScene::set_imported_light_cast_shadow(light, false):
                ok: 0
                error failure: 1
            return 22 if disabled_light_shadow != 0 or elisa_render_scene_v1_test_imported_light_casts_shadow(
                RenderScene::native_smoke_handle(imported_mesh), 0) != 0
            camera: RenderScene::ImportedCameraHandle = catch RenderScene::imported_camera(
                imported_mesh, 1):
                value: value
                error failure: return 23
            activated: i32 = catch RenderScene::activate_imported_camera(camera):
                ok: 0
                error failure: 1
            return 24 if activated != 0
            invalid_camera: i32 = catch RenderScene::imported_camera(imported_mesh, imported.camera_count):
                value: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 25 if invalid_camera != 1
            _ = catch RenderScene::activate_default_camera():
                ok: 0
                error failure: return 26
            destroyed: i32 = catch RenderScene::destroy(imported_mesh):
                ok: 0
                error failure: 27
            stale_camera: i32 = catch RenderScene::activate_imported_camera(camera):
                ok: 0
                RenderScene::RenderSceneError.UnknownHandle: 1
                error failure: 2
            stale_light: i32 = catch RenderScene::set_imported_light_cast_shadow(light, true):
                ok: 0
                RenderScene::RenderSceneError.UnknownHandle: 1
                error failure: 2
            return 28 if destroyed != 0 or stale_camera != 1 or stale_light != 1 or RenderScene::instance_count() != 4
            0
