include "../src/runtime/schedule.elisa"
include "../src/runtime/executor.elisa"
using Schedule
using Executor

def gameplay() -> System:
    with_write(with_read(system_empty(0), Resource.Transforms), Resource.Bodies)

def physics() -> System:
    with_write(with_read(system_empty(1), Resource.Bodies), Resource.Transforms)

def render() -> System:
    with_write(with_read(system_empty(2), Resource.Transforms), Resource.Commands)

def audio() -> System:
    with_read(system_empty(3), Resource.Transforms)

def dispatch(state: mutable FrameState&, system: usize) -> void:
    state.visits[system] <- state.visits[system] + 1

def main() -> i32:
    return 1 if resource_count() != 4 or resource_index(Resource.Cues) != 3
    play: System = gameplay()
    phys: System = physics()
    draw: System = render()
    sound: System = audio()
    return 2 if not systems_conflict(&play, &phys)
    return 3 if not systems_conflict(&phys, &draw) or not systems_conflict(&phys, &sound)
    return 4 if systems_conflict(&draw, &sound) or not can_run_together(&draw, &sound)
    return 5 if not can_run_together(&play, &draw) or systems_conflict(&play, &sound)
    return 6 if can_run_together(&play, &phys)

    systems: System[8] = [play, phys, draw, sound, gameplay(), gameplay(), gameplay(), gameplay()]
    return 7 if parallel_pair_count(systems, 4) != 3
    return 8 if parallel_pair_count(systems, 9) != 0

    good: usize[8] = [0, 1, 2, 3, 0, 0, 0, 0]
    return 9 if not schedule_respects(good, systems, 4)
    bad: usize[8] = [1, 0, 2, 3, 0, 0, 0, 0]
    return 10 if schedule_respects(bad, systems, 4)
    swapped_readers: usize[8] = [0, 1, 3, 2, 0, 0, 0, 0]
    return 11 if not schedule_respects(swapped_readers, systems, 4)
    return 12 if schedule_respects(good, systems, 9)

    # Legal plan: each writer alone, the two readers together.
    legal: usize[8] = [0, 1, 2, 2, 0, 0, 0, 0]
    plan: Plan =
        catch plan_from_groups(legal, 4):
            value: value
            error failure: Plan()
    return 13 if plan.count != 4 or plan.group_count != 3
    return 14 if plan.group[0] != 0 or plan.group[1] != 1
    return 15 if plan.group[2] != 2 or plan.group[3] != 2
    return 16 if not plan_valid(&plan, systems)
    # Illegal plan: gameplay and physics both write Transforms, so they must
    # not share a group.
    illegal: usize[8] = [0, 0, 1, 1, 0, 0, 0, 0]
    bad_plan: Plan =
        catch plan_from_groups(illegal, 4):
            value: value
            error failure: Plan()
    return 21 if plan_valid(&bad_plan, systems)

    # Grouping changes execution order, and the executor runs systems for real.
    # Here the two readers share group 1 while physics is deferred to group 2,
    # so the serial order is 0, 2, 3, 1 rather than the declared 0, 1, 2, 3.
    grouped: usize[8] = [0, 2, 1, 1, 0, 0, 0, 0]
    grouped_plan: Plan =
        catch plan_from_groups(grouped, 4):
            value: value
            error failure: Plan()
    return 22 if not plan_valid(&grouped_plan, systems)
    seq: i64[8] = plan_sequence(&grouped_plan)
    return 23 if seq[0] != 0 or seq[1] != 2 or seq[2] != 3 or seq[3] != 1
    state: mutable FrameState = FrameState()
    dispatched: i32 =
        catch plan_execute(&grouped_plan, &state, dispatch):
            ok: 0
            error failure: 1
    return 24 if dispatched != 0
    return 25 if state.trace[0] != 0 or state.trace[1] != 2 or state.trace[2] != 3 or state.trace[3] != 1
    return 26 if state.visits[0] != 1 or state.visits[1] != 1 or state.visits[2] != 1 or state.visits[3] != 1
    return 27 if state.length != 4
    work: mutable Work = Work()
    ran: i32 =
        catch plan_run(&plan, &work, 3):
            ok: 0
            error failure: 1
    return 17 if ran != 0
    return 18 if run_count(&work, 0) != 3 or run_count(&work, 1) != 3
    return 19 if run_count(&work, 2) != 3 or run_count(&work, 3) != 3
    return 20 if run_count(&work, 7) != 0

    # The analysis derives the grouping: both readers join the first wave and
    # the two writers are ordered, giving two waves and the same serial order
    # the hand-built grouped plan produced.
    auto: Plan =
        catch plan_auto(systems, 4):
            value: value
            error failure: Plan()
    return 28 if not plan_valid(&auto, systems) or auto.group_count != 2
    return 29 if auto.group[0] != 0 or auto.group[1] != 1
    return 30 if auto.group[2] != 0 or auto.group[3] != 0
    auto_seq: i64[8] = plan_sequence(&auto)
    return 31 if auto_seq[0] != 0 or auto_seq[1] != 2 or auto_seq[2] != 3 or auto_seq[3] != 1
    auto_state: mutable FrameState = FrameState()
    auto_run: i32 =
        catch plan_execute(&auto, &auto_state, dispatch):
            ok: 0
            error failure: 1
    return 32 if auto_run != 0 or auto_state.visits[1] != 1 or auto_state.length != 4
    derived: usize[8] = assign_groups(systems, 4)
    return 33 if wave_count(derived, 4) != 2 or wave_count(derived, 9) != 0
    return 34 if wave_count(derived, 0) != 0
    0
