include "./render_scene_art_material_native.elisa"

module RenderSceneEnvironmentNativeTests:
    private:
        @callconv(c)
        extern elisa_render_scene_v1_test_environment_matches() -> i32
        @callconv(c)
        extern elisa_render_scene_v1_test_sun_shadows_match(enabled: i32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_test_sun_cascade_distances_match(
            near_end: f32, middle_end: f32, far_end: f32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_test_sun_shadow_bias_matches(expected_bias: f32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_test_sky_map_matches(
            width: u32, height: u32, rotation_radians: f32) -> i32
        @callconv(c)
        extern elisa_render_scene_v1_test_sky_map_cleared() -> i32

    public:
        def exercise() -> i32:
            invalid_environment: i32 = catch RenderScene::set_environment(Lighting::Environment{
                sun_color: Geometry::Vec3{x: 1.0, y: 1.0, z: 1.0},
                sun_direction: Geometry::vec3_zero(),
                ambient: Geometry::Vec3{x: 0.2, y: 0.2, z: 0.2},
                sky_exposure: 1.0,
                fog_color: Geometry::vec3_zero(),
                fog_start: 100.0,
                fog_density: 0.0,
                fog_enabled: false,
            }):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 40 if invalid_environment != 1
            configured_bias_before_sun: i32 = catch RenderScene::set_sun_shadow_bias(0.0005):
                ok: 0
                error failure: 1
            return 59 if configured_bias_before_sun != 0
            environment_status: i32 = catch RenderScene::set_environment(Lighting::Environment{
                sun_color: Geometry::Vec3{x: 0.82, y: 0.88, z: 1.0},
                sun_direction: Geometry::Vec3{x: -0.2, y: -1.0, z: 0.1},
                ambient: Geometry::Vec3{x: 0.14, y: 0.18, z: 0.25},
                sky_exposure: 1.25,
                fog_color: Geometry::Vec3{x: 0.04, y: 0.06, z: 0.1},
                fog_start: 12.0,
                fog_density: 0.02,
                fog_enabled: true,
            }):
                ok: 0
                error failure: 1
            return 41 if environment_status != 0
            return 42 if elisa_render_scene_v1_test_environment_matches() != 1
            return 60 if elisa_render_scene_v1_test_sun_shadow_bias_matches(0.0005) != 1
            invalid_cascade_order: i32 = catch RenderScene::set_sun_cascade_distances(
                100.0, 50.0, 400.0):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 47 if invalid_cascade_order != 1
            cascade_past_far_clip: i32 = catch RenderScene::set_sun_cascade_distances(
                10.0, 100.0, 1200.0):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 48 if cascade_past_far_clip != 1
            cascade_status: i32 = catch RenderScene::set_sun_cascade_distances(
                10.0, 100.0, 400.0):
                ok: 0
                error failure: 1
            return 49 if (cascade_status != 0 or
                elisa_render_scene_v1_test_sun_cascade_distances_match(10.0, 100.0, 400.0) != 1)
            invalid_shadow_bias: i32 = catch RenderScene::set_sun_shadow_bias(0.02):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 57 if invalid_shadow_bias != 1
            shadow_bias_status: i32 = catch RenderScene::set_sun_shadow_bias(0.001):
                ok: 0
                error failure: 1
            return 58 if (shadow_bias_status != 0 or
                elisa_render_scene_v1_test_sun_shadow_bias_matches(0.001) != 1)
            invalid_sky_path: i32 = catch RenderScene::set_sky_map("../outside.png", 0.5):
                ok: 0
                RenderScene::RenderSceneError.AssetLoadFailure: 1
                error failure: 2
            return 50 if invalid_sky_path != 1
            invalid_sky_shape: i32 = catch RenderScene::set_sky_map(
                "test/fixtures/sky_square.png", 0.5):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 51 if invalid_sky_shape != 1
            sky_status: i32 = catch RenderScene::set_sky_map("test/fixtures/sky_latlong.png", 0.5):
                ok: 0
                error failure: 1
            return 52 if sky_status != 0
            return 53 if elisa_render_scene_v1_test_sky_map_matches(8, 4, 0.5) != 1
            return 54 if Application::pump() != Application::PumpStatus.Running
            _ = catch RenderScene::clear_sky_map():
                ok: 0
                error failure: return 55
            return 56 if elisa_render_scene_v1_test_sky_map_cleared() != 1
            _ = catch RenderScene::set_sun_shadows(false):
                ok: 0
                error failure: return 43
            return 44 if elisa_render_scene_v1_test_sun_shadows_match(0) != 1
            _ = catch RenderScene::set_sun_shadows(true):
                ok: 0
                error failure: return 45
            return 46 if elisa_render_scene_v1_test_sun_shadows_match(1) != 1
            art_material: i32 = RenderSceneArtMaterialNativeTests::exercise()
            return art_material if art_material != 0
            0
