include "./render_scene_art_material_native.elisa"

module RenderSceneEnvironmentNativeTests:
    private:
        @callconv(c)
        extern elisa_render_scene_v1_test_environment_matches() -> i32
        @callconv(c)
        extern elisa_render_scene_v1_test_sun_shadows_match(enabled: i32) -> i32

    public:
        def exercise() -> i32:
            invalid_environment: i32 = catch RenderScene::set_environment(Lighting::Environment{
                sun_color: Geometry::Vec3{x: 1.0, y: 1.0, z: 1.0},
                sun_direction: Geometry::vec3_zero(),
                ambient: Geometry::Vec3{x: 0.2, y: 0.2, z: 0.2},
                sky_exposure: 1.0,
                fog_color: Geometry::vec3_zero(),
                fog_start: 100.0,
                fog_density: 0.0,
                fog_enabled: false,
            }):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 40 if invalid_environment != 1
            environment_status: i32 = catch RenderScene::set_environment(Lighting::Environment{
                sun_color: Geometry::Vec3{x: 0.82, y: 0.88, z: 1.0},
                sun_direction: Geometry::Vec3{x: -0.2, y: -1.0, z: 0.1},
                ambient: Geometry::Vec3{x: 0.14, y: 0.18, z: 0.25},
                sky_exposure: 1.25,
                fog_color: Geometry::Vec3{x: 0.04, y: 0.06, z: 0.1},
                fog_start: 12.0,
                fog_density: 0.02,
                fog_enabled: true,
            }):
                ok: 0
                error failure: 1
            return 41 if environment_status != 0
            return 42 if elisa_render_scene_v1_test_environment_matches() != 1
            _ = catch RenderScene::set_sun_shadows(false):
                ok: 0
                error failure: return 43
            return 44 if elisa_render_scene_v1_test_sun_shadows_match(0) != 1
            _ = catch RenderScene::set_sun_shadows(true):
                ok: 0
                error failure: return 45
            return 46 if elisa_render_scene_v1_test_sun_shadows_match(1) != 1
            art_material: i32 = RenderSceneArtMaterialNativeTests::exercise()
            return art_material if art_material != 0
            0
