include "../src/math/geometry.elisa"
using Geometry

def main() -> i32:
    origin: Vec3 = vec3_zero()
    unit: Vec3 = vec3_one()
    return 1 if vec3_dot(origin, unit) != 0.0 or vec3_length_squared(unit) != 3.0

    displacement: Vec3 = Vec3{x: 2.0, y: -3.0, z: 4.0}
    position: Vec3 = vec3_add(unit, displacement)
    return 2 if position.x != 3.0 or position.y != -2.0 or position.z != 5.0
    recovered: Vec3 = vec3_sub(position, displacement)
    return 3 if recovered.x != unit.x or recovered.y != unit.y or recovered.z != unit.z

    transform: Transform = transform_translate(transform_identity(), displacement)
    return 4 if transform.position.z != displacement.z or transform.rotation.w != 1.0 or transform.scale.x != 1.0

    bounds: Bounds3 = Bounds3{minimum: Vec3{x: -1.0, y: -1.0, z: -1.0}, maximum: Vec3{x: 1.0, y: 1.0, z: 1.0}}
    touching: Bounds3 = Bounds3{minimum: Vec3{x: 1.0, y: 0.0, z: 0.0}, maximum: Vec3{x: 2.0, y: 1.0, z: 1.0}}
    separated: Bounds3 = Bounds3{minimum: Vec3{x: 2.0, y: 0.0, z: 0.0}, maximum: Vec3{x: 3.0, y: 1.0, z: 1.0}}
    reversed: Bounds3 = Bounds3{minimum: unit, maximum: origin}
    return 5 if not bounds3_contains(bounds, origin) or not bounds3_overlaps(bounds, touching)
    return 6 if bounds3_overlaps(bounds, separated) or bounds3_valid(reversed) or bounds3_contains(reversed, origin)

    ray: Ray3 = Ray3{origin: origin, direction: Vec3{x: 0.0, y: 0.0, z: -1.0}}
    hit: Vec3 = ray3_at(ray, 5.0)
    return 7 if hit.x != 0.0 or hit.y != 0.0 or hit.z != -5.0

    # Newton square root, then the length operations built on it.
    return 8 if sqrt_f32(4.0) < 1.999 or sqrt_f32(4.0) > 2.001 or sqrt_f32(0.0) != 0.0
    three_four: Vec3 = Vec3{x: 3.0, y: 4.0, z: 0.0}
    return 9 if vec3_length(three_four) < 4.999 or vec3_length(three_four) > 5.001
    unit_vector: Vec3 = vec3_normalize(three_four)
    return 10 if unit_vector.x < 0.599 or unit_vector.x > 0.601 or unit_vector.y < 0.799 or unit_vector.y > 0.801
    # A zero-length vector has no direction; normalizing yields zero, not NaN.
    return 11 if vec3_length(vec3_normalize(vec3_zero())) != 0.0
    return 12 if vec3_distance(three_four, three_four) != 0.0
    return 13 if vec3_dot_normalized(Vec3{x: 1.0, y: 0.0, z: 0.0}, Vec3{x: 0.0, y: 1.0, z: 0.0}) != 0.0
    0
