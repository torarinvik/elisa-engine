include "../src/math/geometry.elisa"
using Geometry

def main() -> i32:
    origin: Vec3 = vec3_zero()
    unit: Vec3 = vec3_one()
    return 1 if vec3_dot(origin, unit) != 0.0 or vec3_length_squared(unit) != 3.0

    displacement: Vec3 = Vec3{x: 2.0, y: -3.0, z: 4.0}
    position: Vec3 = vec3_add(unit, displacement)
    return 2 if position.x != 3.0 or position.y != -2.0 or position.z != 5.0
    recovered: Vec3 = vec3_sub(position, displacement)
    return 3 if recovered.x != unit.x or recovered.y != unit.y or recovered.z != unit.z

    transform: Transform = transform_translate(transform_identity(), displacement)
    return 4 if transform.position.z != displacement.z or transform.rotation.w != 1.0 or transform.scale.x != 1.0

    bounds: Bounds3 = Bounds3{minimum: Vec3{x: -1.0, y: -1.0, z: -1.0}, maximum: Vec3{x: 1.0, y: 1.0, z: 1.0}}
    touching: Bounds3 = Bounds3{minimum: Vec3{x: 1.0, y: 0.0, z: 0.0}, maximum: Vec3{x: 2.0, y: 1.0, z: 1.0}}
    separated: Bounds3 = Bounds3{minimum: Vec3{x: 2.0, y: 0.0, z: 0.0}, maximum: Vec3{x: 3.0, y: 1.0, z: 1.0}}
    reversed: Bounds3 = Bounds3{minimum: unit, maximum: origin}
    return 5 if not bounds3_contains(bounds, origin) or not bounds3_overlaps(bounds, touching)
    return 6 if bounds3_overlaps(bounds, separated) or bounds3_valid(reversed) or bounds3_contains(reversed, origin)

    ray: Ray3 = Ray3{origin: origin, direction: Vec3{x: 0.0, y: 0.0, z: -1.0}}
    hit: Vec3 = ray3_at(ray, 5.0)
    return 7 if hit.x != 0.0 or hit.y != 0.0 or hit.z != -5.0

    # Standard-library square root, then the length operations built on it.
    return 8 if sqrt_f32(4.0) < 1.999 or sqrt_f32(4.0) > 2.001 or sqrt_f32(0.0) != 0.0
    # Extreme magnitudes did not converge in the previous fixed 24 iterations.
    return 26 if sqrt_f32(-4.0) != 0.0
    large_root: f32 = sqrt_f32(1.0e30)
    return 27 if large_root < 0.999e15 or large_root > 1.001e15
    small_root: f32 = sqrt_f32(1.0e-30)
    return 28 if small_root < 0.999e-15 or small_root > 1.001e-15
    three_four: Vec3 = Vec3{x: 3.0, y: 4.0, z: 0.0}
    return 9 if vec3_length(three_four) < 4.999 or vec3_length(three_four) > 5.001
    unit_vector: Vec3 = vec3_normalize(three_four)
    return 10 if unit_vector.x < 0.599 or unit_vector.x > 0.601 or unit_vector.y < 0.799 or unit_vector.y > 0.801
    # A zero-length vector has no direction; normalizing yields zero, not NaN.
    return 11 if vec3_length(vec3_normalize(vec3_zero())) != 0.0
    return 12 if vec3_distance(three_four, three_four) != 0.0
    return 13 if vec3_dot_normalized(Vec3{x: 1.0, y: 0.0, z: 0.0}, Vec3{x: 0.0, y: 1.0, z: 0.0}) != 0.0

    # Quaternion transforms: a 90-degree turn about +Y takes +X to -Z and +Z
    # to +X in the engine's right-handed frame, and composition places a child
    # inside its parent's rotation and translation.
    half: f32 = 0.70710678
    y90: Quat = Quat{x: 0.0, y: half, z: 0.0, w: half}
    turned: Vec3 = quat_rotate(y90, Vec3{x: 1.0, y: 0.0, z: 0.0})
    return 14 if turned.x < -0.001 or turned.x > 0.001 or turned.z < -1.001 or turned.z > -0.999
    pointed: Vec3 = quat_rotate(y90, Vec3{x: 0.0, y: 0.0, z: 1.0})
    return 15 if pointed.x < 0.999 or pointed.z < -0.001 or pointed.z > 0.001
    parent: Transform = Transform{position: Vec3{x: 1.0, y: 0.0, z: 0.0}, rotation: y90, scale: vec3_one()}
    child: Transform = Transform{position: Vec3{x: 1.0, y: 0.0, z: 0.0}, rotation: quat_identity(), scale: vec3_one()}
    composed: Transform = transform_compose(parent, child)
    return 16 if composed.position.x < 0.999 or composed.position.x > 1.001 or composed.position.z < -1.001 or composed.position.z > -0.999
    identity_matrix: f32[16] = transform_to_matrix(transform_identity())
    return 17 if identity_matrix[0] != 1.0 or identity_matrix[5] != 1.0 or identity_matrix[10] != 1.0 or identity_matrix[15] != 1.0
    parent_matrix: f32[16] = transform_to_matrix(parent)
    return 18 if parent_matrix[2] < -1.001 or parent_matrix[2] > -0.999 or parent_matrix[8] < 0.999 or parent_matrix[8] > 1.001
    return 19 if parent_matrix[12] < 0.999 or parent_matrix[12] > 1.001
    return 20 if quat_normalize(Quat{x: 0.0, y: 0.0, z: 0.0, w: 0.0}).w != 1.0

    # Proximity protocol: three unrelated shapes share one distance query, and
    # a generic takes two different implementing types in the same call.
    near_point: Vec3 = Vec3{x: 2.0, y: 0.0, z: 0.0}
    return 21 if not within_radius(near_point, origin, 2.5) or within_radius(near_point, origin, 1.5)
    far_box: Bounds3 = Bounds3{minimum: Vec3{x: 3.0, y: -1.0, z: -1.0}, maximum: Vec3{x: 4.0, y: 1.0, z: 1.0}}
    return 22 if not within_radius(far_box, origin, 3.5) or within_radius(far_box, origin, 2.5)
    return 23 if bounds3_distance(far_box, origin) < 2.999 or bounds3_distance(far_box, origin) > 3.001
    return 24 if not within_radius(ray, Vec3{x: 0.0, y: 1.0, z: 0.0}, 1.5)
    return 25 if nearest_distance(far_box, near_point, origin) < 1.999 or nearest_distance(far_box, near_point, origin) > 2.001
    positive_scale: Vec3 = Vec3{x: 2.0, y: 3.0, z: 4.0}
    reflected_scale: Vec3 = Vec3{x: -2.0, y: 3.0, z: 4.0}
    two_axis_reflection: Vec3 = Vec3{x: -2.0, y: -3.0, z: 4.0}
    return 29 if tangent_parity_for_transform(positive_scale, 1.0) != -1.0
    return 30 if tangent_parity_for_transform(reflected_scale, 1.0) != 1.0
    return 31 if tangent_parity_for_transform(two_axis_reflection, 1.0) != -1.0
    return 32 if tangent_parity_for_transform(positive_scale, -1.0) != 1.0
    return 33 if tangent_parity_for_transform(Vec3{x: 0.0, y: 1.0, z: 1.0}, 1.0) != 0.0
    return 34 if tangent_parity_for_transform(positive_scale, 0.0) != 0.0
    0
