include "../src/backend/recovery.elisa"

def main() -> i32:
    r: BackendRecovery::Recovery = BackendRecovery::make()
    return 1 if not BackendRecovery::can_render(&r) or not BackendRecovery::handle_valid(&r, 0)
    # Upload failures degrade but keep rendering; a good frame recovers.
    BackendRecovery::report(&r, BackendRecovery::Failure.UploadFailed)
    return 2 if r.state != BackendRecovery::State.Degraded or not BackendRecovery::can_render(&r) or r.degraded_events != 1
    BackendRecovery::report(&r, BackendRecovery::Failure.ResizeFailed)
    BackendRecovery::frame_ok(&r)
    return 3 if r.state != BackendRecovery::State.Running or r.degraded_events != 2
    # Swapchain loss stops rendering; the epoch is unchanged and no rebuild.
    BackendRecovery::report(&r, BackendRecovery::Failure.SwapchainLost)
    return 4 if r.state != BackendRecovery::State.Recovering or BackendRecovery::can_render(&r) or r.epoch != 0 or r.rebuild_pending
    return 5 if not BackendRecovery::tick(&r)
    BackendRecovery::attempt(&r, true)
    return 6 if r.state != BackendRecovery::State.Running
    # Device loss bumps the epoch, invalidating old handles, and asks for a rebuild.
    BackendRecovery::report(&r, BackendRecovery::Failure.DeviceLost)
    return 7 if r.epoch != 1 or BackendRecovery::handle_valid(&r, 0) or not r.rebuild_pending
    # The first failed attempt waits exactly 2 frames; attempts during the
    # cooldown cannot succeed early or consume another retry.
    return 8 if not BackendRecovery::tick(&r)
    BackendRecovery::attempt(&r, false)
    return 9 if r.attempts != 1 or r.wait_frames != 2 or BackendRecovery::tick(&r) or r.wait_frames != 1
    BackendRecovery::attempt(&r, true)
    return 10 if r.state != BackendRecovery::State.Recovering or r.attempts != 1 or r.wait_frames != 1
    BackendRecovery::report(&r, BackendRecovery::Failure.DeviceLost)
    return 11 if r.epoch != 1 or r.attempts != 1 or r.wait_frames != 1
    return 12 if not BackendRecovery::tick(&r) or r.wait_frames != 0
    BackendRecovery::attempt(&r, false)
    return 13 if r.attempts != 2 or r.wait_frames != 4 or r.state != BackendRecovery::State.Recovering
    BackendRecovery::attempt(&r, false)
    return 14 if r.attempts != 2 or r.wait_frames != 4
    return 15 if BackendRecovery::tick(&r) or r.wait_frames != 3
    return 16 if BackendRecovery::tick(&r) or r.wait_frames != 2
    return 17 if BackendRecovery::tick(&r) or r.wait_frames != 1
    return 18 if not BackendRecovery::tick(&r) or r.wait_frames != 0
    # Success clears the pending rebuild; new handles use the new epoch.
    BackendRecovery::attempt(&r, true)
    return 19 if r.state != BackendRecovery::State.Running or r.rebuild_pending or not BackendRecovery::handle_valid(&r, 1)
    # A device loss during a swapchain recovery still bumps the epoch once.
    BackendRecovery::report(&r, BackendRecovery::Failure.SwapchainLost)
    BackendRecovery::report(&r, BackendRecovery::Failure.DeviceLost)
    return 20 if r.epoch != 2 or not r.rebuild_pending
    # A second swapchain report while recovering does not reset progress.
    BackendRecovery::attempt(&r, false)
    BackendRecovery::report(&r, BackendRecovery::Failure.SwapchainLost)
    return 21 if r.attempts != 1 or r.wait_frames != 2
    # Out of attempts: retries remain cooldown-gated and Failed is final.
    return 22 if BackendRecovery::tick(&r) or r.wait_frames != 1
    return 23 if not BackendRecovery::tick(&r) or r.wait_frames != 0
    BackendRecovery::attempt(&r, false)
    for n in 0..<4:
        BackendRecovery::tick(&r)
    BackendRecovery::attempt(&r, false)
    return 24 if r.state != BackendRecovery::State.Failed or BackendRecovery::can_render(&r) or BackendRecovery::handle_valid(&r, 2)
    BackendRecovery::report(&r, BackendRecovery::Failure.DeviceLost)
    BackendRecovery::attempt(&r, true)
    return 25 if r.state != BackendRecovery::State.Failed or r.epoch != 2 or BackendRecovery::tick(&r)
    return 0
