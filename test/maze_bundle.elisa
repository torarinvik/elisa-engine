include "../examples/maze/bundle.elisa"
include "../src/assets/package.elisa"
using Assets
using Geometry
using Capabilities
using Net
using AssetPackage
using MazeBundle

def native_profile() -> BackendProfile:
    BackendProfile{
        kind: BackendKind.Native,
        capabilities: BackendCapabilities{
            input: true,
            rendering: true,
            physics: false,
            audio: true,
            native_window: true,
            async_upload: false,
            callbacks: false,
            asset_loading: true,
        },
        optional_capabilities: BackendOptionalCapabilities{ray_tracing: false, sparse_textures: false, mesh_shaders: false},
        limits: BackendLimits{
            max_entities: 4096,
            max_texture_dimension: 8192,
            max_upload_bytes: 16777216,
            workers: 4,
            memory_budget_bytes: 536870912,
            memory_usage_bytes: 0,
            max_viewports: 1,
            graphics_workers: 1,
            streaming_workers: 1,
        },
        texture_formats: BackendTextureFormats{rgba8: true, bc1: true, r16_float: false},
        service_version: 1,
    }

def main() -> i32:
    return 1 if bundle_version() != 1 or required_feature_count() != 2
    bounds: Bounds3 = Bounds3{minimum: Vec3{x: -1.0, y: -1.0, z: -1.0}, maximum: Vec3{x: 1.0, y: 1.0, z: 1.0}}
    mesh: SourceAsset = SourceAsset{id: AssetId{high: 11, low: 19}, path: "models/wall.gltf", format: SourceFormat.Gltf}
    material: SourceAsset = SourceAsset{id: AssetId{high: 11, low: 20}, path: "models/wall.png", format: SourceFormat.Png}
    cooked: CookedPackage = catch cook_package(mesh, material, bounds):
        value: value
        error failure: return 2
    det: Determinism = Determinism{solver: 7, build: 21}
    bundle: Bundle = Bundle{
        version: bundle_version(),
        mesh: cooked.mesh,
        material: cooked.material,
        content: cooked.content,
        epoch: 7,
        object_id: 3,
        camera_id: 4,
        viewport_width: 320,
        viewport_height: 200,
        required: default_required(),
        scope: det,
        host_scope: det,
        max_frame_micros: 16667,
    }
    return 3 if not bundle_valid(&bundle)
    return 4 if not package_content_matches(&cooked, bundle.mesh, bundle.material)
    return 5 if not bundle_shippable(&bundle, native_profile())

    headless: BackendProfile = headless_profile()
    return 6 if bundle_shippable(&bundle, headless)

    drifted: Bundle = Bundle{
        version: bundle.version,
        mesh: bundle.mesh,
        material: bundle.material,
        content: bundle.content,
        epoch: bundle.epoch,
        object_id: bundle.object_id,
        camera_id: bundle.camera_id,
        viewport_width: bundle.viewport_width,
        viewport_height: bundle.viewport_height,
        required: bundle.required,
        scope: bundle.scope,
        host_scope: Determinism{solver: 8, build: 21},
        max_frame_micros: bundle.max_frame_micros,
    }
    return 7 if bundle_shippable(&drifted, native_profile())

    blown: Bundle = Bundle{
        version: bundle.version,
        mesh: bundle.mesh,
        material: bundle.material,
        content: bundle.content,
        epoch: bundle.epoch,
        object_id: bundle.object_id,
        camera_id: bundle.camera_id,
        viewport_width: bundle.viewport_width,
        viewport_height: bundle.viewport_height,
        required: bundle.required,
        scope: bundle.scope,
        host_scope: bundle.host_scope,
        max_frame_micros: 20000,
    }
    return 8 if bundle_valid(&blown) or bundle_shippable(&blown, native_profile())

    aliased: Bundle = Bundle{
        version: bundle.version,
        mesh: bundle.mesh,
        material: bundle.mesh,
        content: bundle.content,
        epoch: bundle.epoch,
        object_id: bundle.object_id,
        camera_id: bundle.camera_id,
        viewport_width: bundle.viewport_width,
        viewport_height: bundle.viewport_height,
        required: bundle.required,
        scope: bundle.scope,
        host_scope: bundle.host_scope,
        max_frame_micros: bundle.max_frame_micros,
    }
    return 9 if bundle_valid(&aliased)
    0
