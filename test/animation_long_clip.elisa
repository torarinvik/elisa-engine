include "../src/animation/pose_override.elisa"

@link_name("clock_gettime_nsec_np")
extern c_clock_ns(clock: i32) -> u64 can[Blocking.IO]
@link_name("putchar")
extern c_putchar(c: i32) -> i32 can[Blocking.IO]

# The stage1 backend declines f-strings here, so digits go out one by one.
def print_label_number(value: i64):
    for c in "scrub p95 us: ":
        _ = c_putchar(c.i32())
    mutable digits: darray[i32] = []
    mutable rest: i64 = value
    digits.push((rest % 10).i32())
    rest <- rest / 10
    while rest > 0:
        digits.push((rest % 10).i32())
        rest <- rest / 10
    for k in 0..<digits.count:
        _ = c_putchar(48 + digits[digits.count - 1 - k])
    _ = c_putchar(10)

def near(a: f32, b: f32) -> bool:
    d: f32 = a - b
    d < 0.0001 and d > -0.0001

def same(a: Geometry::Transform, b: Geometry::Transform) -> bool:
    near(a.position.x, b.position.x) and near(a.position.y, b.position.y) and near(a.position.z, b.position.z) and near(a.rotation.x, b.rotation.x) and near(a.rotation.y, b.rotation.y) and near(a.rotation.z, b.rotation.z) and near(a.rotation.w, b.rotation.w) and near(a.scale.x, b.scale.x)

def moved(x: f32) -> Geometry::Transform:
    Geometry::Transform{position: Geometry::Vec3{x: x, y: 0.0, z: 0.0}, rotation: Geometry::quat_identity(), scale: Geometry::vec3_one()}

def capacity_code(bones: usize, frames: usize, rate: f32) -> i32:
    catch LongClip::create(bones, frames, rate):
        value: 0
        LongClip::ClipError.BoneCapacity: 1
        LongClip::ClipError.FrameCapacity: 2
        LongClip::ClipError.SampleCapacity: 3
        LongClip::ClipError.BadRate: 4
        error failure: 9

def make(bones: usize, frames: usize) -> LongClip::Clip:
    clip: LongClip::Clip = catch LongClip::create(bones, frames, 120.0):
        value: value
        error failure: LongClip::Clip()
    return move clip

def rig_add_code(rig: mutable PoseOverride::Rig&, parent: i64) -> i32:
    catch PoseOverride::rig_add(rig, parent, Geometry::transform_identity()):
        value: 0
        PoseOverride::OverrideError.BoneCapacity: 1
        PoseOverride::OverrideError.InvalidParent: 2
        error failure: 9

def storage() -> i32:
    return 1 if capacity_code(70, 10000, 120.0) != 0
    return 2 if capacity_code(0, 10, 120.0) != 1 or capacity_code(257, 10, 120.0) != 1
    return 3 if capacity_code(70, 0, 120.0) != 2 or capacity_code(1, 1048577, 120.0) != 2
    return 4 if capacity_code(256, 1048576, 120.0) != 3
    return 5 if capacity_code(70, 10, 0.0) != 4 or capacity_code(70, 10, 0.0 / 0.0) != 4
    mutable clip: LongClip::Clip = make(70, 10000)
    return 6 if LongClip::bone_count(&clip) != 70 or LongClip::frame_count(&clip) != 10000
    return 7 if not same(LongClip::local(&clip, 9999, 69), Geometry::transform_identity())
    return 8 if not LongClip::set_local(&clip, 5000, 3, moved(2.0)) or not LongClip::set_local(&clip, 5001, 3, moved(4.0))
    return 9 if LongClip::set_local(&clip, 10000, 3, moved(1.0)) or LongClip::set_local(&clip, 0, 70, moved(1.0)) or LongClip::set_local(&clip, 0, 0, moved(0.0 / 0.0))
    # Halfway between frames 5000 and 5001.
    return 10 if not near(LongClip::sample(&clip, 5000.5 / 120.0, 3).position.x, 3.0)
    return 11 if not same(LongClip::sample(&clip, 5000.0 / 120.0, 3), moved(2.0))
    # Neighbours untouched; times outside hold the ends.
    return 12 if not same(LongClip::sample(&clip, 5000.5 / 120.0, 4), Geometry::transform_identity())
    return 13 if not same(LongClip::sample(&clip, -3.0, 3), Geometry::transform_identity()) or not same(LongClip::sample(&clip, 1000.0, 3), Geometry::transform_identity())
    mutable pose: darray[Geometry::Transform] = []
    return 14 if LongClip::sample_pose(&clip, 5001.0 / 120.0, &pose) != 70 or not same(pose[3], moved(4.0))
    0

def overrides() -> i32:
    mutable rig: PoseOverride::Rig = PoseOverride::Rig()
    return 20 if rig_add_code(&rig, -1) != 0 or rig_add_code(&rig, 0) != 0 or rig_add_code(&rig, 1) != 0
    return 21 if rig_add_code(&rig, 3) != 2 or rig_add_code(&rig, -2) != 2
    mutable clip: LongClip::Clip = make(3, 4)
    _ = LongClip::set_local(&clip, 1, 1, moved(1.0))
    _ = LongClip::set_local(&clip, 2, 1, moved(3.0))
    mutable held: PoseOverride::Overrides = PoseOverride::overrides(&rig)
    mutable playback: darray[Geometry::Transform] = []
    mutable mixed: darray[Geometry::Transform] = []
    t: f32 = 1.5 / 120.0
    count: usize = catch PoseOverride::evaluate(&rig, &held, &clip, t, &playback):
        value: value
        error failure: 0
    return 22 if count != 3 or not near(playback[2].position.x, 2.0)
    # Seeding from playback then overriding everything: no pop.
    seeded: bool = catch PoseOverride::seed_from_clip(&held, &clip, t):
        value: value
        error failure: false
    return 23 if not seeded or not PoseOverride::is_overridden(&held, 2)
    _ = catch PoseOverride::evaluate(&rig, &held, &clip, t, &mixed):
        value: value
        error failure: 0
    for b in 0..<3:
        return 24 if not same(mixed[b], playback[b])
    # A live override on bone 1 moves bone 2 through the hierarchy.
    return 25 if not PoseOverride::set_override(&held, 1, moved(10.0))
    _ = catch PoseOverride::evaluate(&rig, &held, &clip, t, &mixed):
        value: value
        error failure: 0
    return 26 if not near(mixed[2].position.x, 10.0) or not near(mixed[1].position.x, 10.0)
    # Back to playback, again without a pop.
    PoseOverride::clear_all(&held)
    _ = catch PoseOverride::evaluate(&rig, &held, &clip, t, &mixed):
        value: value
        error failure: 0
    for b in 0..<3:
        return 27 if not same(mixed[b], playback[b])
    # No clip: rest pose for bones not overridden.
    _ = PoseOverride::set_override(&held, 0, moved(5.0))
    rest_count: usize = catch PoseOverride::evaluate_rest(&rig, &held, &mixed):
        value: value
        error failure: 0
    return 28 if rest_count != 3 or not near(mixed[2].position.x, 5.0)
    # Shape mismatches are typed.
    wrong: LongClip::Clip = make(4, 4)
    shape: i32 = catch PoseOverride::evaluate(&rig, &held, &wrong, 0.0, &mixed):
        value: 0
        PoseOverride::OverrideError.ShapeMismatch: 1
        error failure: 2
    return 29 if shape != 1
    return 30 if PoseOverride::set_override(&held, 3, moved(1.0))
    # A 256-bone rig fits, the 257th bone does not.
    mutable big: PoseOverride::Rig = PoseOverride::Rig()
    for b in 0..<256:
        return 31 if rig_add_code(&big, -1) != 0
    return 32 if rig_add_code(&big, -1) != 1
    0

# Random-access scrubbing of a 10,000-frame x 70-bone take: 2,000 full-pose
# samples at pseudo-random times. Returns the p95 in microseconds.
def scrub_p95_us() -> i64:
    mutable clip: LongClip::Clip = make(70, 10000)
    for f in 0..<10000:
        _ = LongClip::set_local(&clip, f, 0, moved(f.f32()))
    mutable pose: darray[Geometry::Transform] = []
    mutable times: darray[i64] = []
    mutable seed: u64 = 12345
    for i in 0..<2000:
        seed <- seed * 6364136223846793005 + 1442695040888963407
        frame: f32 = ((seed >> 33) % 999900).f32() / 100.0
        start: u64 = c_clock_ns(4)
        _ = LongClip::sample_pose(&clip, frame / 120.0, &pose)
        stop: u64 = c_clock_ns(4)
        times.push((stop - start).i64())
        return -1 if not near(pose[0].position.x, frame) and (frame - pose[0].position.x > 0.01 or pose[0].position.x - frame > 0.01)
    # Insertion sort; 2,000 entries.
    for i in 1..<times.count:
        mutable j: usize = i
        while j > 0 and times[j - 1] > times[j]:
            held: i64 = times[j]
            times[j] <- times[j - 1]
            times[j - 1] <- held
            j <- j - 1
    times[1900] / 1000

def main() -> i32:
    status: i32 = storage()
    return status if status != 0
    live: i32 = overrides()
    return live if live != 0
    p95: i64 = scrub_p95_us()
    return 40 if p95 < 0
    print_label_number(p95)
    # A full 70-bone pose must sample well inside one 120 Hz frame.
    return 41 if p95 > 2000
    0
