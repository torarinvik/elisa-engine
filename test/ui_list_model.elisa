include "../src/ui/list_model.elisa"

def main() -> i32:
    mutable l: UiListModel::List = UiListModel::new_list()
    for k in 0..<64:
        return 1 if not UiListModel::push(&l, 100 + k.i64())
    return 2 if UiListModel::push(&l, 999) or UiListModel::push(&l, 100) or l.count != 64
    # Window is bounded by the viewport.
    return 3 if UiListModel::window_count(&l, 8) != 8 or UiListModel::window_first(&l, 8) != 0
    return 4 if not UiListModel::focus(&l, 130) or UiListModel::focus(&l, 5)
    return 5 if not UiListModel::reveal_focus(&l, 8) or l.scroll != 23
    return 6 if UiListModel::window_first(&l, 8) != 23
    # Reorder: focus follows the row by id.
    return 7 if not UiListModel::move(&l, 30, 2) or l.ids[2] != 130 or l.ids[3] != 102 or l.ids[30] != 129
    return 8 if UiListModel::index_of(&l, 130) != 2 or l.focus_id != 130
    return 9 if UiListModel::move(&l, 2, 64) or UiListModel::move(&l, 2, 0 - 1)
    return 10 if not UiListModel::move(&l, 2, 40) or l.ids[40] != 130 or l.ids[2] != 102
    # Removing the focused row moves focus to its successor, then predecessor at the end.
    return 11 if not UiListModel::remove(&l, 130) or l.count != 63 or l.focus_id != l.ids[40]
    return 12 if UiListModel::index_of(&l, l.focus_id) < 0
    return 13 if UiListModel::remove(&l, 130)
    return 14 if not UiListModel::focus(&l, l.ids[62]) or not UiListModel::remove(&l, l.ids[62]) or l.focus_id != l.ids[61]
    # Removing an unfocused row leaves focus alone and scroll clamped.
    keep: i64 = l.focus_id
    return 15 if not UiListModel::remove(&l, 100) or l.focus_id != keep
    # Draining the list clears focus.
    mutable s: UiListModel::List = UiListModel::new_list()
    return 16 if not UiListModel::push(&s, 7) or not UiListModel::focus(&s, 7) or not UiListModel::remove(&s, 7)
    return 17 if s.focus_id != 0 - 1 or s.count != 0 or UiListModel::window_count(&s, 8) != 0
    return 0
