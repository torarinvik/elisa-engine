include "../src/runtime/world_rendering.elisa"

module WorldRenderingValidation:
    private:
        def sample_visual(mesh_low: u64) -> Assets::VisualAsset:
            Assets::VisualAsset{
                mesh: Assets::AssetId{high: 7, low: mesh_low},
                material: Assets::AssetId{high: 7, low: 90},
                local_bounds: Geometry::Bounds3{
                    minimum: Geometry::Vec3{x: -1.0, y: -1.0, z: -1.0},
                    maximum: Geometry::Vec3{x: 1.0, y: 1.0, z: 1.0},
                },
            }

        def quotient(numerator: f32, denominator: f32) -> f32:
            numerator / denominator

        def color_tint(red: f32, green: f32, blue: f32) -> RenderSnapshot::Tint:
            RenderSnapshot::Tint{
                color: Geometry::Vec3{x: red, y: green, z: blue},
                emissive: Geometry::Vec3{x: 1.0, y: 1.0, z: 1.0},
                emissive_strength: 1.0,
            }

        def tint_code(bindings: mutable WorldRendering::Bindings&, gameplay: World::EntityRef,
            render_id: i64, tint: RenderSnapshot::Tint) -> i32:
            catch WorldRendering::set_tint(bindings, gameplay, render_id, tint):
                ok: 0
                WorldRendering::WorldRenderingError.InvalidTint: 1
                WorldRendering::WorldRenderingError.UnknownBinding: 2
                error failure: 3

    public:
        def run() -> i32:
            world: mutable World::World = catch World::World():
                value: value
                error failure: return 1
            other_world: mutable World::World = catch World::World():
                value: value
                error failure: return 2
            player: World::EntityRef = catch World::world_spawn(&world, World::Actor.Player):
                value: value
                error failure: return 3
            guard: World::EntityRef = catch World::world_spawn(&world, World::Enemy.Guard):
                value: value
                error failure: return 4
            foreign: World::EntityRef = catch World::world_spawn(&other_world, World::Actor.Player):
                value: value
                error failure: return 5
            initial_transform: mutable Geometry::Transform = Geometry::transform_identity()
            return 22 if not World::world_try_transform(&world, player, &initial_transform)
            return 23 if initial_transform.position.x != 0.0 or initial_transform.position.y != 0.0 or initial_transform.position.z != 0.0 or initial_transform.scale.x != 1.0 or initial_transform.scale.y != 1.0 or initial_transform.scale.z != 1.0

            bindings: mutable WorldRendering::Bindings = WorldRendering::Bindings()
            identity: Geometry::Transform = Geometry::transform_identity()
            local_offset: Geometry::Transform = Geometry::transform_translate(identity, Geometry::Vec3{x: 0.0, y: 0.5, z: 0.0})
            visual: Assets::VisualAsset = sample_visual(1)
            first: i32 = catch WorldRendering::bind(&bindings, &world, player, 101, visual, identity):
                ok: 0
                error failure: 1
            second: i32 = catch WorldRendering::bind(&bindings, &world, player, 102, visual, local_offset):
                ok: 0
                error failure: 1
            third: i32 = catch WorldRendering::bind(&bindings, &world, guard, 103, visual, identity):
                ok: 0
                error failure: 1
            return 6 if first != 0 or second != 0 or third != 0 or WorldRendering::binding_count(bindings) != 3

            updated: Geometry::Transform = Geometry::transform_translate(identity, Geometry::Vec3{x: 2.0, y: 0.0, z: 1.0})
            updated_visual: Assets::VisualAsset = sample_visual(2)
            transform_status: i32 = catch World::world_set_transform(&world, player, updated):
                ok: 0
                error failure: 1
            update_status: i32 = catch WorldRendering::bind(&bindings, &world, player, 101, updated_visual, identity):
                ok: 0
                error failure: 1
            duplicate: i32 = catch WorldRendering::bind(&bindings, &world, guard, 101, visual, identity):
                ok: 0
                WorldRendering::WorldRenderingError.DuplicateRenderId: 1
                error failure: 2
            invalid_reference: i32 = catch WorldRendering::bind(&bindings, &world, foreign, 104, visual, identity):
                ok: 0
                WorldRendering::WorldRenderingError.InvalidReference: 1
                error failure: 2
            invalid_id: i32 = catch WorldRendering::bind(&bindings, &world, player, 0, visual, identity):
                ok: 0
                WorldRendering::WorldRenderingError.InvalidRenderId: 1
                error failure: 2
            invalid_transform: Geometry::Transform = Geometry::Transform{
                position: Geometry::vec3_zero(),
                rotation: Geometry::quat_identity(),
                scale: Geometry::Vec3{x: 1.0, y: 0.0, z: 1.0},
            }
            rejected_transform: i32 = catch World::world_set_transform(&world, player, invalid_transform):
                ok: 0
                World::WorldError.InvalidValue: 1
                error failure: 2
            invalid_local_transform: i32 = catch WorldRendering::bind(&bindings, &world, player, 105, visual, invalid_transform):
                ok: 0
                WorldRendering::WorldRenderingError.InvalidTransform: 1
                error failure: 2
            foreign_transform: i32 = catch World::world_set_transform(&world, foreign, identity):
                ok: 0
                World::WorldError.InvalidReference: 1
                error failure: 2
            return 7 if transform_status != 0 or update_status != 0 or duplicate != 1 or invalid_reference != 1 or invalid_id != 1
            return 21 if rejected_transform != 1 or foreign_transform != 1 or invalid_local_transform != 1 or not World::world_is_valid(&world)
            return 8 if WorldRendering::binding_count(bindings) != 3

            snapshot: mutable RenderSnapshot::Snapshot = RenderSnapshot::Snapshot()
            extract_status: i32 = catch WorldRendering::extract(&world, &bindings, &snapshot):
                ok: 0
                error failure: 1
            return 9 if extract_status != 0 or RenderSnapshot::snapshot_count(snapshot) != 3 or not RenderSnapshot::snapshot_valid(snapshot)
            moved_entry: RenderSnapshot::Entry = RenderSnapshot::snapshot_entry(snapshot, 0)
            return 10 if moved_entry.gameplay.id != player.id or moved_entry.transform.position.x != 2.0 or moved_entry.transform.position.z != 1.0 or moved_entry.visual.mesh.low != 2
            fanout_entry: RenderSnapshot::Entry = RenderSnapshot::snapshot_entry(snapshot, 1)
            return 24 if fanout_entry.gameplay.id != player.id or fanout_entry.transform.position.x != 2.0 or fanout_entry.transform.position.y != 0.5 or fanout_entry.transform.position.z != 1.0

            # A tint belongs to one render ID, survives rebinding, and reaches
            # the snapshot; invalid or unknown overrides leave it unchanged.
            return 25 if not RenderSnapshot::tint_is_neutral(moved_entry.tint) or not RenderSnapshot::tint_is_neutral(fanout_entry.tint)
            highlight: RenderSnapshot::Tint = RenderSnapshot::Tint{
                color: Geometry::Vec3{x: 1.5, y: 1.25, z: 0.5},
                emissive: Geometry::Vec3{x: 1.0, y: 0.5, z: 0.25},
                emissive_strength: 4.0,
            }
            tinted: i32 = tint_code(&bindings, player, 102, highlight)
            rebound: i32 = catch WorldRendering::bind(&bindings, &world, player, 102, visual, local_offset):
                ok: 0
                error failure: 1
            return 26 if tinted != 0 or rebound != 0
            nan: f32 = quotient(0.0, 0.0)
            infinity: f32 = quotient(1.0, 0.0)
            return 27 if tint_code(&bindings, player, 102, color_tint(nan, 1.0, 1.0)) != 1 or tint_code(&bindings, player, 102, color_tint(1.0, infinity, 1.0)) != 1
            return 28 if tint_code(&bindings, player, 102, color_tint(-0.5, 1.0, 1.0)) != 1 or tint_code(&bindings, player, 102, color_tint(1.0, 1.0, 4.5)) != 1
            bright_emissive: RenderSnapshot::Tint = RenderSnapshot::Tint{color: highlight.color, emissive: Geometry::Vec3{x: 1.5, y: 0.0, z: 0.0}, emissive_strength: 1.0}
            over_strength: RenderSnapshot::Tint = RenderSnapshot::Tint{color: highlight.color, emissive: highlight.emissive, emissive_strength: 65.0}
            nan_strength: RenderSnapshot::Tint = RenderSnapshot::Tint{color: highlight.color, emissive: highlight.emissive, emissive_strength: nan}
            return 29 if tint_code(&bindings, player, 102, bright_emissive) != 1 or tint_code(&bindings, player, 102, over_strength) != 1 or tint_code(&bindings, player, 102, nan_strength) != 1
            return 30 if tint_code(&bindings, guard, 102, highlight) != 2 or tint_code(&bindings, player, 999, highlight) != 2
            tinted_extract: i32 = catch WorldRendering::extract(&world, &bindings, &snapshot):
                ok: 0
                error failure: 1
            tinted_entry: RenderSnapshot::Entry = RenderSnapshot::snapshot_entry(snapshot, 1)
            untinted_entry: RenderSnapshot::Entry = RenderSnapshot::snapshot_entry(snapshot, 0)
            return 31 if tinted_extract != 0 or tinted_entry.render_id != 102 or tinted_entry.tint.color.x != 1.5 or tinted_entry.tint.emissive.z != 0.25 or tinted_entry.tint.emissive_strength != 4.0
            return 32 if not RenderSnapshot::tint_is_neutral(untinted_entry.tint) or not RenderSnapshot::snapshot_valid(snapshot)

            despawn_guard: i32 = catch World::world_despawn(&world, guard):
                ok: 0
                error failure: 1
            return 11 if despawn_guard != 0
            prune_status: i32 = catch WorldRendering::extract(&world, &bindings, &snapshot):
                ok: 0
                error failure: 1
            return 12 if prune_status != 0
            return 19 if WorldRendering::binding_count(bindings) != 2
            return 20 if RenderSnapshot::snapshot_count(snapshot) != 2
            return 13 if not WorldRendering::unbind(&bindings, player, 102) or WorldRendering::binding_count(bindings) != 1

            replaced_world_status: i32 = catch WorldRendering::extract(&other_world, &bindings, &snapshot):
                ok: 0
                error failure: 1
            return 14 if replaced_world_status != 0 or WorldRendering::binding_count(bindings) != 0 or RenderSnapshot::snapshot_count(snapshot) != 0

            full_bindings: mutable WorldRendering::Bindings = WorldRendering::Bindings()
            for index in 0..<WorldRendering::MAX_BINDINGS |full_bindings, world, player, identity|:
                render_id: i64 = 1000 + index.i64()
                bind_status: i32 = catch WorldRendering::bind(&full_bindings, &world, player, render_id, visual, identity):
                    ok: 0
                    error failure: 1
                return 15 if bind_status != 0
            return 16 if WorldRendering::binding_count(full_bindings) != WorldRendering::MAX_BINDINGS
            full_rejected: i32 = catch WorldRendering::bind(&full_bindings, &world, player, 9999, visual, identity):
                ok: 0
                WorldRendering::WorldRenderingError.Capacity: 1
                error failure: 2
            return 17 if full_rejected != 1 or WorldRendering::binding_count(full_bindings) != WorldRendering::MAX_BINDINGS

            full_snapshot: mutable RenderSnapshot::Snapshot = RenderSnapshot::Snapshot()
            full_extract: i32 = catch WorldRendering::extract(&world, &full_bindings, &full_snapshot):
                ok: 0
                error failure: 1
            return 18 if full_extract != 0 or RenderSnapshot::snapshot_count(full_snapshot) != WorldRendering::MAX_BINDINGS
            0
