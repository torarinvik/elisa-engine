include "../src/backend/material.elisa"
include "../src/backend/lighting.elisa"

def main() -> i32:
    material: mutable Material::Material = Material::Material()
    return 1 if not Material::material_valid(&material)
    base: Assets::AssetId = Assets::AssetId{high: 4, low: 1}
    normal: Assets::AssetId = Assets::AssetId{high: 4, low: 2}
    return 2 if not Material::set_texture(&material, Material::TextureSlot.BaseColor, base)
    return 3 if not Material::set_texture(&material, Material::TextureSlot.Normal, normal)
    return 4 if Material::texture(&material, Material::TextureSlot.Normal).low != 2
    return 5 if not Material::set_factors(&material, 0.8, 0.4, 0.6)
    material.alpha_mode <- Material::AlphaMode.Mask
    return 6 if not Material::material_valid(&material)
    invalid: Assets::AssetId = Assets::AssetId{high: 0, low: 0}
    return 7 if Material::set_texture(&material, Material::TextureSlot.Emissive, invalid)
    return 8 if Material::set_factors(&material, 2.0, 0.4, 0.5)
    light: Lighting::Light = Lighting::Light{
        kind: Lighting::LightKind.Directional,
        color: Geometry::Vec3{x: 1.0, y: 0.9, z: 0.8},
        position: Geometry::Vec3{x: 4.0, y: 2.0, z: -3.0},
        direction: Geometry::Vec3{x: -0.3, y: -1.0, z: 0.2},
        intensity: 2.0,
        range: 50.0,
        inner_cone: 0.0,
        outer_cone: 0.7,
        casts_shadow: true,
    }
    return 9 if not Lighting::light_valid(light)
    light.range <- 0.0
    return 10 if Lighting::light_valid(light)
    environment: Lighting::Environment = Lighting::Environment{
        sun_color: Geometry::Vec3{x: 1.0, y: 0.95, z: 0.8},
        sun_direction: Geometry::Vec3{x: -0.2, y: -1.0, z: 0.1},
        ambient: Geometry::Vec3{x: 0.2, y: 0.25, z: 0.3},
        sky_exposure: 1.0,
        fog_color: Geometry::Vec3{x: 0.4, y: 0.5, z: 0.6},
        fog_start: 10.0,
        fog_density: 0.02,
        fog_enabled: true,
    }
    return 11 if not Lighting::environment_valid(environment)
    environment.sun_direction <- Geometry::vec3_zero()
    return 12 if Lighting::environment_valid(environment)
    0
