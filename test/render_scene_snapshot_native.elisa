# Native integration coverage for cooked snapshot assets and transactional
# reconciliation. Kept separate from the general scene smoke to keep each test
# focused and its local setup private.
include "../src/runtime/render_scene.elisa"
include "../src/runtime/render_scene_assets.elisa"
include "../src/runtime/render_snapshot_scene.elisa"
include "../src/runtime/world_rendering.elisa"
include "../src/world/world.elisa"
include "../src/math/geometry.elisa"

module RenderSceneSnapshotNativeTests:
    private:
        const module Stress:
            INSTANCE_COUNT: usize = 200
            RENDER_ID_BASE: i64 = 10000
            LAST_INDEX: usize = 199
            INITIAL_NATIVE_INSTANCE_COUNT: u64 = 3
            BATCH_ENVELOPE_CALLS: u64 = 2
            POSITION_SPACING: f32 = 3.0
            CHANGED_FIRST_POSITION_X: f32 = -7.0

        @callconv(c)
        extern elisa_render_scene_v1_test_snapshot_fail_after_creates(created_count: i32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_snapshot_identity_matches(gameplay_epoch: i64, gameplay_id: i64,
            render_id: i64, mesh_high: u64, mesh_low: u64, material_high: u64, material_low: u64) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_snapshot_instance_resources(render_id: i64,
            vertex_count: u64, index_count: u64, red: f32, green: f32, blue: f32, alpha: f32,
            metallic: f32, roughness: f32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_snapshot_material_texture(
            material_high: u64, material_low: u64, slot: i32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_snapshot_meshes_shared(first_render_id: i64,
            second_render_id: i64) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_snapshot_shared_mesh_count() -> u64

        @callconv(c)
        extern elisa_render_scene_v1_test_snapshot_position_x(render_id: i64, expected_x: f32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_snapshot_last_transaction_api_calls() -> u64

        @callconv(c)
        extern elisa_render_scene_v1_test_object_count() -> u64

        def sync_snapshot(presenter: mutable RenderScene::SnapshotPresenter&,
            snapshot: RenderSnapshot::Snapshot&) -> i32:
            catch RenderSnapshotScene::sync(presenter, snapshot):
                ok: 0
                error failure: 1

        def bind_world_render(bindings: mutable WorldRendering::Bindings&,
            world: mutable World::World&, gameplay: World::EntityRef,
            render_id: i64, visual: Assets::VisualAsset,
            local_transform: Geometry::Transform) -> i32:
            catch WorldRendering::bind(bindings, world, gameplay, render_id, visual, local_transform):
                ok: 0
                error failure: 1

        def render_visual(asset_key: u64) -> Assets::VisualAsset:
            Assets::VisualAsset{
                mesh: Assets::AssetId{high: 700, low: asset_key},
                material: Assets::AssetId{high: 800, low: 1},
                local_bounds: Geometry::Bounds3{
                    minimum: Geometry::Vec3{x: -1.0, y: -1.0, z: -1.0},
                    maximum: Geometry::Vec3{x: 1.0, y: 1.0, z: 1.0},
                },
            }

        def extract_world_render(world: World::World&, bindings: mutable WorldRendering::Bindings&,
            snapshot: mutable RenderSnapshot::Snapshot&) -> i32:
            catch WorldRendering::extract(world, bindings, snapshot):
                ok: 0
                error failure: 1

        def register_test_mesh(asset_key: u64) -> i32:
            catch RenderScene::register_snapshot_mesh_asset(
                Assets::AssetId{high: 700, low: asset_key}, "build/cooked/render-scene-triangle.pkg"):
                ok: 0
                error failure: 1

        def register_test_snapshot_assets() -> i32:
            return 1 if register_test_mesh(701) != 0
            return 2 if register_test_mesh(703) != 0
            return 3 if register_test_mesh(702) != 0
            return 4 if register_test_mesh(9701) != 0
            return 5 if register_test_mesh(704) != 0
            return 6 if register_test_mesh(705) != 0
            material: Material::Material = Material::Material{
                base_color: Assets::AssetId{high: 0, low: 0},
                normal: Assets::AssetId{high: 0, low: 0},
                metallic_roughness: Assets::AssetId{high: 0, low: 0},
                occlusion: Assets::AssetId{high: 0, low: 0},
                emissive: Assets::AssetId{high: 0, low: 0},
                base_color_factor: [0.25, 0.5, 0.75, 1.0],
                metallic_factor: 0.4,
                roughness_factor: 0.6,
                emissive_factor: [0.0, 0.0, 0.0],
                alpha_cutoff: 0.5,
                alpha_mode: Material::AlphaMode.Opaque,
                double_sided: false,
            }
            material_registration: i32 = catch RenderScene::register_snapshot_material_asset(
                Assets::AssetId{high: 800, low: 1}, &material):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                RenderScene::RenderSceneError.AssetLoadFailure: 7
                RenderScene::RenderSceneError.BackendFailure: 8
                error failure: 9
            textured_material: Material::Material = Material::Material{
                base_color: Assets::AssetId{high: 900, low: 1},
                normal: Assets::AssetId{high: 0, low: 0},
                metallic_roughness: Assets::AssetId{high: 0, low: 0},
                occlusion: Assets::AssetId{high: 0, low: 0},
                emissive: Assets::AssetId{high: 0, low: 0},
                base_color_factor: [1.0, 1.0, 1.0, 1.0],
                metallic_factor: 0.0,
                roughness_factor: 1.0,
                emissive_factor: [0.0, 0.0, 0.0],
                alpha_cutoff: 0.5,
                alpha_mode: Material::AlphaMode.Opaque,
                double_sided: false,
            }
            split_surface_material: mutable Material::Material = Material::Material()
            split_surface_material.metallic_roughness <- Assets::AssetId{high: 901, low: 1}
            split_surface_material.occlusion <- Assets::AssetId{high: 902, low: 1}
            split_surface_registration: i32 = catch RenderScene::register_snapshot_material_asset(
                Assets::AssetId{high: 800, low: 3}, &split_surface_material):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 13 if split_surface_registration != 1
            unregistered_texture_material: i32 = catch RenderScene::register_snapshot_material_asset(
                Assets::AssetId{high: 800, low: 2}, &textured_material):
                ok: 0
                RenderScene::RenderSceneError.AssetLoadFailure: 7
                error failure: 2
            return 8 if unregistered_texture_material != 7
            registered_texture: bool = catch RenderScene::register_snapshot_texture_asset(
                Assets::AssetId{high: 900, low: 1}, "build/cooked/render-scene-normal.png"):
                ok: true
                error failure: false
            return 9 if not registered_texture
            textured_registration: bool = catch RenderScene::register_snapshot_material_asset(
                Assets::AssetId{high: 800, low: 2}, &textured_material):
                ok: true
                error failure: false
            return 10 if not textured_registration
            return 11 if elisa_render_scene_v1_test_snapshot_material_texture(800, 2, 0) == 0
            live_texture_unregister: i32 = catch RenderScene::unregister_snapshot_texture_asset(
                Assets::AssetId{high: 900, low: 1}):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 12 if live_texture_unregister != 1
            0

        def unregister_test_snapshot_assets() -> i32:
            mesh_ids: u64[6] = [701, 703, 702, 9701, 704, 705]
            for index in 0..<6 |mesh_ids|:
                removed: bool = catch RenderScene::unregister_snapshot_mesh_asset(
                    Assets::AssetId{high: 700, low: mesh_ids[index]}):
                    ok: true
                    error failure: false
                return 1 if not removed
            removed_material: bool = catch RenderScene::unregister_snapshot_material_asset(
                Assets::AssetId{high: 800, low: 1}):
                ok: true
                error failure: false
            return 2 if not removed_material
            removed_textured_material: bool = catch RenderScene::unregister_snapshot_material_asset(
                Assets::AssetId{high: 800, low: 2}):
                ok: true
                error failure: false
            return 3 if not removed_textured_material
            removed_texture: bool = catch RenderScene::unregister_snapshot_texture_asset(
                Assets::AssetId{high: 900, low: 1}):
                ok: true
                error failure: false
            return 4 if not removed_texture
            0

    public:
        def exercise() -> i32:
            asset_setup: i32 = register_test_snapshot_assets()
            return 30 + asset_setup if asset_setup != 0
            world: mutable World::World = catch World::World():
                value: value
                error failure: return 40
            gameplay_a: World::EntityRef = catch World::world_spawn(&world, World::Actor.Player):
                value: value
                error failure: return 40
            gameplay_b: World::EntityRef = catch World::world_spawn(&world, World::Enemy.Guard):
                value: value
                error failure: return 40
            player_transform: Geometry::Transform = Geometry::Transform{
                position: Geometry::Vec3{x: 1.0, y: 0.0, z: 0.0},
                rotation: Geometry::quat_identity(),
                scale: Geometry::Vec3{x: 1.0, y: 1.0, z: 1.0},
            }
            guard_transform: Geometry::Transform = Geometry::Transform{
                position: Geometry::Vec3{x: -1.0, y: 0.0, z: 0.0},
                rotation: Geometry::quat_identity(),
                scale: Geometry::Vec3{x: 0.75, y: 0.75, z: 0.75},
            }
            player_status: bool = catch World::world_set_transform(&world, gameplay_a, player_transform):
                ok: true
                error failure: false
            guard_status: bool = catch World::world_set_transform(&world, gameplay_b, guard_transform):
                ok: true
                error failure: false
            return 41 if not player_status or not guard_status

            snapshot: mutable RenderSnapshot::Snapshot = RenderSnapshot::Snapshot()
            presenter: mutable RenderScene::SnapshotPresenter = RenderScene::SnapshotPresenter()
            bindings: mutable WorldRendering::Bindings = WorldRendering::Bindings()
            local_offset: Geometry::Transform = Geometry::transform_translate(
                Geometry::transform_identity(), Geometry::Vec3{x: 0.0, y: 0.25, z: 0.0})
            return 42 if bind_world_render(&bindings, world, gameplay_a, 701,
                render_visual(701), Geometry::transform_identity()) != 0
            return 43 if bind_world_render(&bindings, world, gameplay_a, 703,
                render_visual(701), local_offset) != 0
            return 44 if bind_world_render(&bindings, world, gameplay_b, 702,
                render_visual(702), Geometry::transform_identity()) != 0
            return 45 if extract_world_render(world, &bindings, &snapshot) != 0
            return 46 if RenderSnapshot::snapshot_count(snapshot) != 3
            return 47 if sync_snapshot(&presenter, snapshot) != 0
            return 48 if RenderSnapshotScene::binding_count(presenter) != 3 or RenderScene::instance_count() != 6
            return 76 if elisa_render_scene_v1_test_snapshot_shared_mesh_count() != 2
            return 77 if elisa_render_scene_v1_test_snapshot_meshes_shared(701, 703) == 0
            return 49 if elisa_render_scene_v1_test_snapshot_instance_resources(
                702, 3, 3, 0.25, 0.5, 0.75, 1.0, 0.4, 0.6) == 0
            live_mesh_unregister: i32 = catch RenderScene::unregister_snapshot_mesh_asset(
                Assets::AssetId{high: 700, low: 702}):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 50 if live_mesh_unregister != 1
            live_material_unregister: i32 = catch RenderScene::unregister_snapshot_material_asset(
                Assets::AssetId{high: 800, low: 1}):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 2
            return 51 if live_material_unregister != 1
            return 52 if extract_world_render(world, &bindings, &snapshot) != 0
            return 53 if sync_snapshot(&presenter, snapshot) != 0
            return 54 if RenderSnapshotScene::binding_count(presenter) != 3 or RenderScene::instance_count() != 6

            moved_transform: Geometry::Transform = Geometry::transform_translate(player_transform,
                Geometry::Vec3{x: 0.5, y: 0.0, z: 0.0})
            moved_player: bool = catch World::world_set_transform(&world, gameplay_a, moved_transform):
                ok: true
                error failure: false
            return 55 if not moved_player
            return 56 if bind_world_render(&bindings, world, gameplay_a, 701,
                render_visual(9701), Geometry::transform_identity()) != 0
            return 57 if bind_world_render(&bindings, world, gameplay_a, 704,
                render_visual(704), local_offset) != 0
            return 58 if bind_world_render(&bindings, world, gameplay_a, 705,
                render_visual(705), Geometry::transform_identity()) != 0
            extracted_rows: i32 = extract_world_render(world, &bindings, &snapshot)
            return 59 if extracted_rows != 0 or RenderSnapshot::snapshot_count(snapshot) != 5
            return 60 if elisa_render_scene_v1_test_snapshot_fail_after_creates(1) != 0
            objects_before_failure: u64 = elisa_render_scene_v1_test_object_count()
            failed_sync: i32 = sync_snapshot(&presenter, snapshot)
            batch_rolled_back: bool = failed_sync == 1 and RenderSnapshotScene::binding_count(presenter) == 3 and RenderScene::instance_count() == 6 and elisa_render_scene_v1_test_object_count() == objects_before_failure
            return 61 if not batch_rolled_back
            return 78 if elisa_render_scene_v1_test_snapshot_shared_mesh_count() != 2
            return 62 if elisa_render_scene_v1_test_snapshot_identity_matches(
                gameplay_a.world_epoch, gameplay_a.id, 701, 700, 701, 800, 1) == 0
            return 63 if elisa_render_scene_v1_test_snapshot_identity_matches(
                gameplay_a.world_epoch, gameplay_a.id, 701, 700, 9701, 800, 1) != 0
            return 64 if sync_snapshot(&presenter, snapshot) != 0
            return 65 if RenderSnapshotScene::binding_count(presenter) != 5 or RenderScene::instance_count() != 8
            return 66 if elisa_render_scene_v1_test_object_count() != objects_before_failure + 2
            return 79 if elisa_render_scene_v1_test_snapshot_shared_mesh_count() != 5
            return 82 if elisa_render_scene_v1_test_snapshot_instance_resources(
                703, 3, 3, 0.25, 0.5, 0.75, 1.0, 0.4, 0.6) == 0
            return 67 if elisa_render_scene_v1_test_snapshot_identity_matches(
                gameplay_a.world_epoch, gameplay_a.id, 701, 700, 9701, 800, 1) == 0

            stable_transform: Geometry::Transform = Geometry::transform_translate(moved_transform,
                Geometry::Vec3{x: 0.25, y: 0.0, z: 0.0})
            stable_update: bool = catch World::world_set_transform(&world, gameplay_a, stable_transform):
                ok: true
                error failure: false
            stable_binding: i32 = bind_world_render(&bindings, world, gameplay_a, 701,
                render_visual(9701), Geometry::transform_identity())
            stable_extraction: i32 = extract_world_render(world, &bindings, &snapshot)
            stable_sync: i32 = sync_snapshot(&presenter, snapshot)
            return 68 if not stable_update or stable_binding != 0 or stable_extraction != 0 or stable_sync != 0
            return 69 if RenderSnapshotScene::binding_count(presenter) != 5 or RenderScene::instance_count() != 8
            despawn_b: bool = catch World::world_despawn(&world, gameplay_b):
                ok: true
                error failure: false
            after_b_extract: i32 = extract_world_render(world, &bindings, &snapshot)
            after_b_sync: i32 = sync_snapshot(&presenter, snapshot)
            return 70 if not despawn_b or after_b_extract != 0 or after_b_sync != 0
            return 71 if RenderSnapshot::snapshot_count(snapshot) != 4 or RenderSnapshotScene::binding_count(presenter) != 4 or RenderScene::instance_count() != 7
            return 80 if elisa_render_scene_v1_test_snapshot_shared_mesh_count() != 4
            despawn_a: bool = catch World::world_despawn(&world, gameplay_a):
                ok: true
                error failure: false
            after_a_extract: i32 = extract_world_render(world, &bindings, &snapshot)
            after_a_sync: i32 = sync_snapshot(&presenter, snapshot)
            return 72 if not despawn_a or after_a_extract != 0 or after_a_sync != 0
            return 73 if RenderSnapshotScene::binding_count(presenter) != 0 or RenderScene::instance_count() != 3
            return 81 if elisa_render_scene_v1_test_snapshot_shared_mesh_count() != 0
            return 75 if elisa_render_scene_v1_test_snapshot_identity_matches(
                gameplay_a.world_epoch, gameplay_a.id, 701, 700, 9701, 800, 1) != 0

            stress_references: mutable World::EntityRef[Stress::INSTANCE_COUNT] = zeroed
            for index in 0..<Stress::INSTANCE_COUNT |world, bindings, stress_references|:
                gameplay: World::EntityRef = catch World::world_spawn(&world, World::Actor.Player):
                    value: value
                    error failure: return 83
                stress_references[index] <- gameplay
                transform: Geometry::Transform = Geometry::Transform{
                    position: Geometry::Vec3{x: index.f32() * Stress::POSITION_SPACING, y: 0.0, z: 0.0},
                    rotation: Geometry::quat_identity(),
                    scale: Geometry::Vec3{x: 1.0, y: 1.0, z: 1.0},
                }
                moved: bool = catch World::world_set_transform(&world, gameplay, transform):
                    ok: true
                    error failure: false
                return 84 if not moved
                return 85 if bind_world_render(&bindings, world, gameplay,
                    Stress::RENDER_ID_BASE + index.i64(), render_visual(701),
                    Geometry::transform_identity()) != 0

            stress_extraction: i32 = extract_world_render(world, &bindings, &snapshot)
            stress_sync: i32 = sync_snapshot(&presenter, snapshot)
            return 86 if stress_extraction != 0 or stress_sync != 0
            stress_counts_valid: bool = RenderSnapshot::snapshot_count(snapshot) == Stress::INSTANCE_COUNT and RenderSnapshotScene::binding_count(presenter) == Stress::INSTANCE_COUNT and RenderScene::instance_count() == Stress::INITIAL_NATIVE_INSTANCE_COUNT + Stress::INSTANCE_COUNT.u64()
            return 87 if not stress_counts_valid
            return 94 if elisa_render_scene_v1_test_snapshot_last_transaction_api_calls() != Stress::INSTANCE_COUNT.u64() + Stress::BATCH_ENVELOPE_CALLS
            return 88 if elisa_render_scene_v1_test_snapshot_shared_mesh_count() != 1
            stress_pair_shared: bool = elisa_render_scene_v1_test_snapshot_meshes_shared(
                Stress::RENDER_ID_BASE, Stress::RENDER_ID_BASE + Stress::LAST_INDEX.i64()) != 0
            return 89 if not stress_pair_shared

            changed_transform: Geometry::Transform = Geometry::Transform{
                position: Geometry::Vec3{x: Stress::CHANGED_FIRST_POSITION_X, y: 0.0, z: 0.0},
                rotation: Geometry::quat_identity(),
                scale: Geometry::Vec3{x: 1.0, y: 1.0, z: 1.0},
            }
            changed: bool = catch World::world_set_transform(&world, stress_references[0], changed_transform):
                ok: true
                error failure: false
            return 90 if not changed
            changed_extraction: i32 = extract_world_render(world, &bindings, &snapshot)
            changed_sync: i32 = sync_snapshot(&presenter, snapshot)
            return 91 if changed_extraction != 0 or changed_sync != 0
            first_position_valid: bool = elisa_render_scene_v1_test_snapshot_position_x(
                Stress::RENDER_ID_BASE, Stress::CHANGED_FIRST_POSITION_X) != 0
            last_position_valid: bool = elisa_render_scene_v1_test_snapshot_position_x(
                Stress::RENDER_ID_BASE + Stress::LAST_INDEX.i64(),
                Stress::LAST_INDEX.f32() * Stress::POSITION_SPACING) != 0
            stress_mesh_retained: bool = elisa_render_scene_v1_test_snapshot_shared_mesh_count() == 1
            return 92 if not first_position_valid or not last_position_valid or not stress_mesh_retained

            cleared: bool = catch RenderSnapshotScene::clear(&presenter):
                ok: true
                error failure: false
            return 93 if not cleared or RenderScene::instance_count() != 3 or elisa_render_scene_v1_test_snapshot_shared_mesh_count() != 0
            return 74 if unregister_test_snapshot_assets() != 0
            0
