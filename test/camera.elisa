include "../src/backend/camera.elisa"

def main() -> i32:
    camera: mutable Camera::State = Camera::State(320, 200)
    return 1 if not Camera::state_valid(&camera)
    return 2 if not Camera::set_perspective(&camera, 1.0, 0.1, 500.0)
    perspective: Geometry::Ray3 = Camera::ray(&camera, 160.0, 100.0)
    return 3 if perspective.direction.z >= -0.99 or perspective.origin.z != 0.0
    moved: Geometry::Transform = Geometry::transform_translate(Geometry::transform_identity(), Geometry::Vec3{x: 2.0, y: 3.0, z: 4.0})
    return 4 if not Camera::set_transform(&camera, moved)
    return 5 if not Camera::resize(&camera, 640, 480, 2.0)
    return 6 if Camera::viewport(&camera).display_scale != 2.0
    return 7 if not Camera::resize_or_suspend(&camera, 0, 0, 2.0) or not Camera::viewport_suspended(&camera)
    return 8 if Camera::state_valid(&camera)
    return 9 if not Camera::resize_or_suspend(&camera, 640, 480, 2.0) or Camera::viewport_suspended(&camera)
    return 10 if not Camera::state_valid(&camera)
    return 14 if not Camera::set_viewport_region(&camera, 320, 0, 320, 480, 640, 480, 2.0)
    split_view_ray: Geometry::Ray3 = Camera::ray(&camera, 480.0, 240.0)
    return 15 if split_view_ray.direction.z >= -0.99
    return 16 if Camera::viewport(&camera).x != 320 or Camera::viewport(&camera).width != 320
    return 17 if Camera::set_viewport_region(&camera, 400, 0, 320, 480, 640, 480, 2.0)
    return 18 if not Camera::resize(&camera, 640, 480, 2.0)
    return 11 if not Camera::set_orthographic(&camera, 10.0, 0.1, 100.0)
    orthographic: Geometry::Ray3 = Camera::ray(&camera, 320.0, 240.0)
    return 12 if orthographic.origin.x != 2.0 or orthographic.origin.y != 3.0 or orthographic.origin.z != 4.0
    return 13 if orthographic.direction.z >= -0.99
    visible: Geometry::Bounds3 = Geometry::Bounds3{
        minimum: Geometry::Vec3{x: -1.0, y: -1.0, z: -5.0},
        maximum: Geometry::Vec3{x: 1.0, y: 1.0, z: -3.0},
    }
    return 19 if not Camera::bounds_visible(&camera, visible)
    outside: Geometry::Bounds3 = Geometry::Bounds3{
        minimum: Geometry::Vec3{x: 100.0, y: -1.0, z: -5.0},
        maximum: Geometry::Vec3{x: 101.0, y: 1.0, z: -3.0},
    }
    return 20 if Camera::bounds_visible(&camera, outside)
    moved_visible: Geometry::Bounds3 = Geometry::Bounds3{
        minimum: Geometry::Vec3{x: 1.0, y: 2.0, z: -1.0},
        maximum: Geometry::Vec3{x: 3.0, y: 4.0, z: 1.0},
    }
    return 21 if not Camera::bounds_visible(&camera, moved_visible)
    return 22 if Camera::bounds_visible(&camera, Geometry::Bounds3{
        minimum: Geometry::Vec3{x: 2.0, y: 3.0, z: 100.0},
        maximum: Geometry::Vec3{x: 3.0, y: 4.0, z: 101.0},
    })
    return 23 if not Camera::set_perspective(&camera, 1.0, 0.1, 500.0)
    rotated: Geometry::Transform = Geometry::Transform{
        position: Geometry::vec3_zero(),
        rotation: Geometry::Quat{x: 0.0, y: 0.70710677, z: 0.0, w: 0.70710677},
        scale: Geometry::Vec3{x: 2.0, y: 1.0, z: 0.5},
    }
    return 24 if not Camera::set_transform(&camera, rotated)
    return 25 if not Camera::bounds_visible(&camera, Geometry::Bounds3{
        minimum: Geometry::Vec3{x: -6.0, y: -1.0, z: -1.0},
        maximum: Geometry::Vec3{x: -4.0, y: 1.0, z: 1.0},
    })
    return 26 if Camera::bounds_visible(&camera, Geometry::Bounds3{
        minimum: Geometry::Vec3{x: 4.0, y: -1.0, z: -1.0},
        maximum: Geometry::Vec3{x: 6.0, y: 1.0, z: 1.0},
    })
    0
