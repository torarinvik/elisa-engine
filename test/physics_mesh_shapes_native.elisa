include "../src/runtime/application.elisa"
include "../src/physics/runtime.elisa"

module PhysicsMeshShapesNative:
    private:
        const module Window:
            WIDTH: i32 = 320
            HEIGHT: i32 = 240

    public:
        @callconv(c)
        extern elisa_physics_v1_test_shape_cache_counts(hits: mutable u64&,
            misses: mutable u64&) -> i32
        @callconv(c)
        extern elisa_physics_v1_test_corrupt_shape_cache() -> i32

        def run() -> i32:
            config: Application::Config = Application::Config{
                title: "Elisa Physics Mesh Shapes",
                width: Window::WIDTH,
                height: Window::HEIGHT,
                hidden: true,
            }
            return 1 if Application::initialize(config) != Application::InitializeStatus.Ready
            world: mutable PhysicsRuntime::World = catch PhysicsRuntime::World():
                value: value
                error failure: return 2
            scale: Geometry::Vec3 = Geometry::Vec3{x: 1.0, y: 1.0, z: 1.0}
            missing_asset: i32 = catch PhysicsRuntime::mesh_shape_create(&world,
                PhysicsRuntime::MeshShape.ConvexHull, "test/fixtures/not-found.pkg", scale):
                ok: 0
                PhysicsRuntime::PhysicsError.AssetLoadFailed: 1
                error failure: 2
            return 15 if missing_asset != 1
            invalid_scale: i32 = catch PhysicsRuntime::mesh_shape_create(&world,
                PhysicsRuntime::MeshShape.ConvexHull, "test/fixtures/physics-tetra-convex.elpk",
                Geometry::Vec3{x: 0.0, y: 1.0, z: 1.0}):
                ok: 0
                PhysicsRuntime::PhysicsError.InvalidArgument: 1
                error failure: 2
            return 16 if invalid_scale != 1
            mismatched_collision_kind: i32 = catch PhysicsRuntime::mesh_shape_create(&world,
                PhysicsRuntime::MeshShape.ConvexHull,
                "test/fixtures/physics-tetra-triangle.elpk", scale):
                ok: 0
                PhysicsRuntime::PhysicsError.InvalidArgument: 1
                error failure: 2
            return 17 if mismatched_collision_kind != 1
            hull: PhysicsRuntime::ShapeHandle = catch PhysicsRuntime::mesh_shape_create(&world,
                PhysicsRuntime::MeshShape.ConvexHull, "test/fixtures/physics-tetra-convex.elpk", scale):
                value: value
                error failure: return 3
            triangle_mesh: PhysicsRuntime::ShapeHandle = catch PhysicsRuntime::mesh_shape_create(&world,
                PhysicsRuntime::MeshShape.TriangleMesh,
                "test/fixtures/physics-tetra-triangle.elpk", scale):
                value: value
                error failure: return 4
            legacy_hull: PhysicsRuntime::ShapeHandle = catch PhysicsRuntime::mesh_shape_create(&world,
                PhysicsRuntime::MeshShape.ConvexHull, "test/fixtures/physics-tetra.pkg", scale):
                value: value
                error failure: return 25
            corrupt_status: i32 = elisa_physics_v1_test_corrupt_shape_cache()
            return 23 if corrupt_status != 0
            recovered_hull: PhysicsRuntime::ShapeHandle = catch PhysicsRuntime::mesh_shape_create(&world,
                PhysicsRuntime::MeshShape.ConvexHull, "test/fixtures/physics-tetra-convex.elpk", scale):
                value: value
                error failure: return 18
            cached_hull: PhysicsRuntime::ShapeHandle = catch PhysicsRuntime::mesh_shape_create(&world,
                PhysicsRuntime::MeshShape.ConvexHull, "test/fixtures/physics-tetra-convex.elpk", scale):
                value: value
                error failure: return 24
            recovered_legacy_hull: PhysicsRuntime::ShapeHandle = catch PhysicsRuntime::mesh_shape_create(&world,
                PhysicsRuntime::MeshShape.ConvexHull, "test/fixtures/physics-tetra.pkg", scale):
                value: value
                error failure: return 26
            cached_legacy_hull: PhysicsRuntime::ShapeHandle = catch PhysicsRuntime::mesh_shape_create(&world,
                PhysicsRuntime::MeshShape.ConvexHull, "test/fixtures/physics-tetra.pkg", scale):
                value: value
                error failure: return 27
            cache_hits: mutable u64 = 0
            cache_misses: mutable u64 = 0
            cache_status: i32 = elisa_physics_v1_test_shape_cache_counts(&cache_hits, &cache_misses)
            return 19 if cache_status != 0 or cache_hits != 2 or cache_misses != 5
            hull_body: PhysicsRuntime::BodyHandle = catch PhysicsRuntime::body_create_with_shape(&world,
                PhysicsRuntime::BodyInstanceDesc{
                    kind: PhysicsRuntime::BodyKind.Dynamic,
                    position: Geometry::Vec3{x: 3.0, y: 2.0, z: 0.0},
                    rotation: Geometry::quat_identity(),
                    mass: 1.0,
                    sensor: false,
                    collision_layer: 0,
                    center_of_mass_offset: Geometry::vec3_zero(),
                }, hull):
                value: value
                error failure: return 5
            triangle_body: PhysicsRuntime::BodyHandle = catch PhysicsRuntime::body_create_with_shape(&world,
                PhysicsRuntime::BodyInstanceDesc{
                    kind: PhysicsRuntime::BodyKind.Static,
                    position: Geometry::Vec3{x: 0.0, y: 0.0, z: 0.0},
                    rotation: Geometry::quat_identity(),
                    mass: 0.0,
                    sensor: false,
                    collision_layer: 0,
                    center_of_mass_offset: Geometry::vec3_zero(),
                }, triangle_mesh):
                value: value
                error failure: return 6
            cached_hull_body: PhysicsRuntime::BodyHandle = catch PhysicsRuntime::body_create_with_shape(&world,
                PhysicsRuntime::BodyInstanceDesc{
                    kind: PhysicsRuntime::BodyKind.Static,
                    position: Geometry::Vec3{x: -3.0, y: 0.0, z: 0.0},
                    rotation: Geometry::quat_identity(),
                    mass: 0.0,
                    sensor: false,
                    collision_layer: 0,
                    center_of_mass_offset: Geometry::vec3_zero(),
                }, cached_hull):
                value: value
                error failure: return 20
            cached_legacy_body: PhysicsRuntime::BodyHandle = catch PhysicsRuntime::body_create_with_shape(&world,
                PhysicsRuntime::BodyInstanceDesc{
                    kind: PhysicsRuntime::BodyKind.Static,
                    position: Geometry::Vec3{x: 7.0, y: 0.0, z: 0.0},
                    rotation: Geometry::quat_identity(),
                    mass: 0.0,
                    sensor: false,
                    collision_layer: 0,
                    center_of_mass_offset: Geometry::vec3_zero(),
                }, cached_legacy_hull):
                value: value
                error failure: return 28
            rejected_dynamic: i32 = catch PhysicsRuntime::body_create_with_shape(&world,
                PhysicsRuntime::BodyInstanceDesc{
                    kind: PhysicsRuntime::BodyKind.Dynamic,
                    position: Geometry::Vec3{x: 6.0, y: 2.0, z: 0.0},
                    rotation: Geometry::quat_identity(),
                    mass: 1.0,
                    sensor: false,
                    collision_layer: 0,
                    center_of_mass_offset: Geometry::vec3_zero(),
                }, triangle_mesh):
                ok: 0
                PhysicsRuntime::PhysicsError.InvalidArgument: 1
                error failure: 2
            return 7 if rejected_dynamic != 1
            _tick: u64 = catch PhysicsRuntime::fixed_step(&world, 1.0 / 60.0):
                value: value
                error failure: return 8
            hit: PhysicsRuntime::RayHit = catch PhysicsRuntime::raycast(world,
                Geometry::Vec3{x: 0.1, y: 3.0, z: 0.1},
                Geometry::Vec3{x: 0.0, y: -1.0, z: 0.0}, 5.0,
                PhysicsRuntime::ALL_LAYERS):
                value: value
                error failure: return 9
            ray_hit: bool = hit.hit
            cached_hit: PhysicsRuntime::RayHit = catch PhysicsRuntime::raycast(world,
                Geometry::Vec3{x: -2.9, y: 3.0, z: 0.1},
                Geometry::Vec3{x: 0.0, y: -1.0, z: 0.0}, 5.0,
                PhysicsRuntime::ALL_LAYERS):
                value: value
                error failure: return 21
            cached_ray_hit: bool = cached_hit.hit
            cached_legacy_hit: PhysicsRuntime::RayHit = catch PhysicsRuntime::raycast(world,
                Geometry::Vec3{x: 7.1, y: 3.0, z: 0.1},
                Geometry::Vec3{x: 0.0, y: -1.0, z: 0.0}, 5.0,
                PhysicsRuntime::ALL_LAYERS):
                value: value
                error failure: return 29
            cached_legacy_ray_hit: bool = cached_legacy_hit.hit
            triangle_body_destroyed: i32 = catch PhysicsRuntime::body_destroy(world, triangle_body):
                ok: 0
                error failure: 1
            cached_hull_body_destroyed: i32 = catch PhysicsRuntime::body_destroy(world, cached_hull_body):
                ok: 0
                error failure: 1
            cached_legacy_body_destroyed: i32 = catch PhysicsRuntime::body_destroy(world, cached_legacy_body):
                ok: 0
                error failure: 1
            hull_body_destroyed: i32 = catch PhysicsRuntime::body_destroy(world, hull_body):
                ok: 0
                error failure: 1
            triangle_shape_destroyed: i32 = catch PhysicsRuntime::shape_destroy(world, triangle_mesh):
                ok: 0
                error failure: 1
            hull_shape_destroyed: i32 = catch PhysicsRuntime::shape_destroy(world, hull):
                ok: 0
                error failure: 1
            cached_hull_shape_destroyed: i32 = catch PhysicsRuntime::shape_destroy(world, cached_hull):
                ok: 0
                error failure: 1
            recovered_hull_shape_destroyed: i32 = catch PhysicsRuntime::shape_destroy(world, recovered_hull):
                ok: 0
                error failure: 1
            cached_legacy_shape_destroyed: i32 = catch PhysicsRuntime::shape_destroy(world, cached_legacy_hull):
                ok: 0
                error failure: 1
            recovered_legacy_shape_destroyed: i32 = catch PhysicsRuntime::shape_destroy(world, recovered_legacy_hull):
                ok: 0
                error failure: 1
            legacy_shape_destroyed: i32 = catch PhysicsRuntime::shape_destroy(world, legacy_hull):
                ok: 0
                error failure: 1
            return 13 if triangle_body_destroyed != 0 or hull_body_destroyed != 0 or cached_hull_body_destroyed != 0 or cached_legacy_body_destroyed != 0
            return 14 if triangle_shape_destroyed != 0 or hull_shape_destroyed != 0 or cached_hull_shape_destroyed != 0 or recovered_hull_shape_destroyed != 0 or cached_legacy_shape_destroyed != 0 or recovered_legacy_shape_destroyed != 0 or legacy_shape_destroyed != 0
            closed: i32 = catch PhysicsRuntime::shutdown(&world):
                ok: 0
                error failure: 1
            application_closed: bool = Application::shutdown()
            return 10 if not ray_hit
            return 22 if not cached_ray_hit
            return 30 if not cached_legacy_ray_hit
            return 11 if closed != 0
            return 12 if not application_closed
            0

def main() -> i32:
    PhysicsMeshShapesNative::run()
