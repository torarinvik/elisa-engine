                RenderGraph::Lifetime.Transient, false)):
            ok: 0
            error failure: return 123
        _ = catch RenderGraph::add_pass(&graph, 10):
            ok: 0
            error failure: return 124
        _ = catch RenderGraph::add_pass(&graph, 20):
            ok: 0
            error failure: return 125
        _ = catch RenderGraph::read(&graph, 10, 2):
            ok: 0
            error failure: return 126
        _ = catch RenderGraph::write(&graph, 10, 3):
            ok: 0
            error failure: return 127
        _ = catch RenderGraph::read(&graph, 20, 1):
            ok: 0
            error failure: return 128
        _ = catch RenderGraph::write(&graph, 20, 4):
            ok: 0
            error failure: return 129
