    def exercise_saturation() -> i32:
        frame_before_saturation: u64 = elisa_render_scene_v1_last_frame_hash()
        return 246 if frame_before_saturation == 0
        return 237 if RenderGraphSaturationTests::configure(2.1) != RenderGraphRuntime::CONFIGURE_INVALID_PLAN
        return 238 if not RenderGraphSaturationTests::native_rejects_bad_saturation()
        return 239 if RenderGraphSaturationTests::configure(0.0) != SUCCESS
        return 240 if Application::pump() != Application::PumpStatus.Running
        return 241 if RenderGraphRuntime::last_execution_status() != RenderGraphRuntime::EXECUTION_OK
        frame_without_saturation: u64 = elisa_render_scene_v1_last_frame_hash()
        return 242 if frame_before_saturation == frame_without_saturation
        return 243 if configure_clear_copy_graph(3) != SUCCESS
        return 244 if Application::pump() != Application::PumpStatus.Running
        return 245 if RenderGraphRuntime::last_execution_status() != RenderGraphRuntime::EXECUTION_OK or elisa_render_scene_v1_last_frame_center_differs_from_corner() == 0
        0

    def exercise_color_scale() -> i32:
        frame_before_scale: u64 = elisa_render_scene_v1_last_frame_hash()
        return 247 if frame_before_scale == 0
        return 248 if RenderGraphScaleColorTests::configure(8.1) != RenderGraphRuntime::CONFIGURE_INVALID_PLAN
        return 249 if not RenderGraphScaleColorTests::native_rejects_bad_scale()
        return 250 if RenderGraphScaleColorTests::configure(0.0) != SUCCESS
        return 251 if Application::pump() != Application::PumpStatus.Running
        return 252 if RenderGraphRuntime::last_execution_status() != RenderGraphRuntime::EXECUTION_OK
        frame_black: u64 = elisa_render_scene_v1_last_frame_hash()
        return 253 if frame_before_scale == frame_black or elisa_render_scene_v1_last_frame_center_differs_from_corner() != 0
        return 254 if configure_clear_copy_graph(3) != SUCCESS
        return 255 if Application::pump() != Application::PumpStatus.Running
        return 256 if RenderGraphRuntime::last_execution_status() != RenderGraphRuntime::EXECUTION_OK or elisa_render_scene_v1_last_frame_center_differs_from_corner() == 0
        0

    def exercise_tint_color() -> i32:
        frame_before_tint: u64 = elisa_render_scene_v1_last_frame_hash()
        return 257 if frame_before_tint == 0
        return 258 if RenderGraphTintTests::configure(8.1, 1.0, 1.0, 1.0) != RenderGraphRuntime::CONFIGURE_INVALID_PLAN
        return 259 if RenderGraphTintTests::configure(1.0, 1.0, 1.0, 1.1) != RenderGraphRuntime::CONFIGURE_INVALID_PLAN
        return 260 if not RenderGraphTintTests::native_rejects_bad_tint()
        return 261 if RenderGraphTintTests::configure(0.0, 0.0, 0.0, 1.0) != SUCCESS
        return 262 if Application::pump() != Application::PumpStatus.Running
        return 263 if RenderGraphRuntime::last_execution_status() != RenderGraphRuntime::EXECUTION_OK
        frame_tinted_black: u64 = elisa_render_scene_v1_last_frame_hash()
        return 264 if frame_before_tint == frame_tinted_black or elisa_render_scene_v1_last_frame_center_differs_from_corner() != 0
        return 265 if configure_clear_copy_graph(3) != SUCCESS
        return 266 if Application::pump() != Application::PumpStatus.Running
        return 267 if RenderGraphRuntime::last_execution_status() != RenderGraphRuntime::EXECUTION_OK or elisa_render_scene_v1_last_frame_center_differs_from_corner() == 0
        0

    def exercise_fxaa() -> i32:
        frame_before_fxaa: u64 = elisa_render_scene_v1_last_frame_hash()
        return 268 if frame_before_fxaa == 0
        return 269 if RenderGraphFxaaTests::configure(RenderGraph::Format.R11G11B10Float) != RenderGraphRuntime::CONFIGURE_INVALID_PLAN
        return 270 if not RenderGraphFxaaTests::native_rejects_unsupported_output()
        return 271 if RenderGraphFxaaTests::configure(RenderGraph::Format.Rgba16Float) != SUCCESS
        return 272 if Application::pump() != Application::PumpStatus.Running
        return 273 if RenderGraphRuntime::last_execution_status() != RenderGraphRuntime::EXECUTION_OK
        return 274 if frame_before_fxaa == elisa_render_scene_v1_last_frame_hash()
        return 275 if configure_clear_copy_graph(3) != SUCCESS
        return 276 if Application::pump() != Application::PumpStatus.Running
        return 277 if RenderGraphRuntime::last_execution_status() != RenderGraphRuntime::EXECUTION_OK or elisa_render_scene_v1_last_frame_center_differs_from_corner() == 0
        0

    def exercise_sharpen() -> i32:
        frame_before_sharpen: u64 = elisa_render_scene_v1_last_frame_hash()
        return 278 if frame_before_sharpen == 0
        return 279 if RenderGraphSharpenTests::configure(RenderGraph::Format.R11G11B10Float, 0.5) != RenderGraphRuntime::CONFIGURE_INVALID_PLAN
        return 280 if RenderGraphSharpenTests::configure(RenderGraph::Format.Rgba16Float, 1.1) != RenderGraphRuntime::CONFIGURE_INVALID_PLAN
        return 281 if not RenderGraphSharpenTests::native_rejects_bad_amount()
        return 282 if not RenderGraphSharpenTests::native_rejects_unsupported_output()
        return 283 if RenderGraphSharpenTests::configure(RenderGraph::Format.Rgba16Float, 0.5) != SUCCESS
        return 284 if Application::pump() != Application::PumpStatus.Running
        return 285 if RenderGraphRuntime::last_execution_status() != RenderGraphRuntime::EXECUTION_OK
        return 286 if frame_before_sharpen == elisa_render_scene_v1_last_frame_hash()
        return 287 if configure_clear_copy_graph(3) != SUCCESS
        return 288 if Application::pump() != Application::PumpStatus.Running
        return 289 if RenderGraphRuntime::last_execution_status() != RenderGraphRuntime::EXECUTION_OK or elisa_render_scene_v1_last_frame_center_differs_from_corner() == 0
        0

    def exercise_chromatic_aberration() -> i32:
        frame_before_aberration: u64 = elisa_render_scene_v1_last_frame_hash()
        return 290 if frame_before_aberration == 0
        return 291 if RenderGraphChromaticAberrationTests::configure(RenderGraph::Format.R11G11B10Float, 0.5) != RenderGraphRuntime::CONFIGURE_INVALID_PLAN
        return 292 if RenderGraphChromaticAberrationTests::configure(RenderGraph::Format.Rgba16Float, 8.1) != RenderGraphRuntime::CONFIGURE_INVALID_PLAN
        return 293 if not RenderGraphChromaticAberrationTests::native_rejects_bad_amount()
        return 294 if not RenderGraphChromaticAberrationTests::native_rejects_unsupported_output()
