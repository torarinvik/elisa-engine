include "../src/assets/gltf_number.elisa"

def bytes_of(codes: darray[i64]) -> darray[u8]:
    out: mutable darray[u8] = []
    for i in 0..<codes.count |out, codes|:
        out.push(codes[i].u8())
    out

# Within one ulp of the correctly rounded reference.
def close(got: f64, want: f64) -> bool:
    return got == want if want == 0.0
    gap: f64 = got - want
    size: f64 = want if want > 0.0 else want * -1.0
    (gap if gap > 0.0 else gap * -1.0) <= size * 2.3e-16

def main() -> i32:
    g10: darray[i64] = [48]
    b10: darray[u8] = bytes_of(g10)
    return 10 if not GltfNumber::valid(b10, 0, 1)
    return 11 if not close(GltfNumber::value(b10, 0, 1), 0.0)
    g12: darray[i64] = [45,48]
    b12: darray[u8] = bytes_of(g12)
    return 12 if not GltfNumber::valid(b12, 0, 2)
    return 13 if not close(GltfNumber::value(b12, 0, 2), 0.0)
