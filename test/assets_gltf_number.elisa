    b44: darray[u8] = bytes_of(g44)
    return 44 if not GltfNumber::valid(b44, 0, 12)
    return 45 if not close(GltfNumber::value(b44, 0, 12), 123.45678)
    g46: darray[i64] = [48,46,48,52,49,54,54,54,54,54,55,57,48,56,52,51,48,49,48]
    b46: darray[u8] = bytes_of(g46)
    return 46 if not GltfNumber::valid(b46, 0, 19)
    return 47 if not close(GltfNumber::value(b46, 0, 19), 0.0416666679084301)
    g48: darray[i64] = []
    b48: darray[u8] = bytes_of(g48)
    return 48 if GltfNumber::valid(b48, 0, 0)
    g49: darray[i64] = [45]
    b49: darray[u8] = bytes_of(g49)
    return 49 if GltfNumber::valid(b49, 0, 1)
    g50: darray[i64] = [48,49]
    b50: darray[u8] = bytes_of(g50)
    return 50 if GltfNumber::valid(b50, 0, 2)
    g51: darray[i64] = [49,46]
    b51: darray[u8] = bytes_of(g51)
    return 51 if GltfNumber::valid(b51, 0, 2)
    g52: darray[i64] = [49,46,101,53]
    b52: darray[u8] = bytes_of(g52)
    return 52 if GltfNumber::valid(b52, 0, 4)
    g53: darray[i64] = [46,53]
    b53: darray[u8] = bytes_of(g53)
    return 53 if GltfNumber::valid(b53, 0, 2)
    g54: darray[i64] = [43,49]
    b54: darray[u8] = bytes_of(g54)
