def asset_browser_test() -> i32:
    browser: mutable Browser = browser_new()
    id: Assets::AssetId = Assets::AssetId{high: 1, low: 2}
    return 41 if not browser_valid(&browser) or browser_selected(&browser) != 8
    added: i32 = catch browser_add(&browser, id, 0):
        ok: 0
        BrowserError.Capacity: 1
        BrowserError.InvalidAsset: 2
        BrowserError.DuplicateAsset: 3
        error failure: 4
    return 42 if added != 0 or browser_count(&browser) != 1
    return 43 if not browser_is_stale(&browser, id, 0)
    marked: i32 = catch browser_mark_loaded(&browser, id, 0):
        ok: 0
        BrowserError.UnknownAsset: 1
        BrowserError.InvalidAsset: 2
        error failure: 3
    return 44 if marked != 0 or browser_is_stale(&browser, id, 0)
    return 45 if not browser_valid(&browser) or not browser_row(&browser, 0).loaded
    duplicate: i32 = catch browser_add(&browser, id, 0):
        ok: 0
        BrowserError.DuplicateAsset: 1
        error failure: 2
    return 46 if duplicate != 1
    selected: i32 = catch browser_select(&browser, 4):
        ok: 0
        BrowserError.UnknownRow: 1
        error failure: 2
    return 47 if selected != 1 or browser_selected(&browser) != 0
    0

def inspector_number_field(target: i64, value: i64) -> Field:
    Field{target: target, kind: FieldKind.Number, value: value, minimum: -10, maximum: 10, editable: true}

def inspector_view_test() -> i32:
    model: mutable Model = model_new()
    return 29 if not model_valid(&model) or field_count(&model) != 0 or selected_index(&model) != 8
    speed: Field = inspector_number_field(10, 2)
    enabled: Field = Field{target: 11, kind: FieldKind.Toggle, value: 1, minimum: 0, maximum: 1, editable: true}
    asset: Field = Field{target: 12, kind: FieldKind.Asset, value: 4, minimum: 1, maximum: 99, editable: false}
    added: i32 = catch add_field(&model, speed):
        ok: 0
        FieldError.Capacity: 1
        FieldError.InvalidField: 2
        FieldError.DuplicateTarget: 3
        error failure: 4
    return 30 if added != 0 or not model_valid(&model) or selected_index(&model) != 0
    return 31 if catch add_field(&model, enabled):
        ok: false
        error failure: true
    return 32 if catch add_field(&model, asset):
        ok: false
        error failure: true
    return 33 if field_count(&model) != 3
    selected: i32 = catch select(&model, 1):
        ok: 0
        FieldError.UnknownTarget: 1
        error failure: 2
    return 34 if selected != 0 or selected_index(&model) != 1
    changed: i32 = catch set_value(&model, 10, 7):
        ok: 0
        FieldError.UnknownTarget: 1
        FieldError.InvalidField: 2
        FieldError.OutOfRange: 3
        error failure: 4
    return 35 if changed != 0 or not model_dirty(&model) or field_at(&model, 0).value != 7
    out_of_range: i32 = catch set_value(&model, 10, 99):
        ok: 0
        FieldError.OutOfRange: 1
        error failure: 2
    return 36 if out_of_range != 1 or field_at(&model, 0).value != 7
    immutable: i32 = catch set_value(&model, 12, 5):
        ok: 0
        FieldError.InvalidField: 1
        error failure: 2
    return 37 if immutable != 1
    duplicate: i32 = catch add_field(&model, inspector_number_field(10, 1)):
        ok: 0
        FieldError.DuplicateTarget: 1
        error failure: 2
    return 38 if duplicate != 1
    unknown: i32 = catch select(&model, 8):
        ok: 0
        FieldError.UnknownTarget: 1
        error failure: 2
    return 39 if unknown != 1
    clear_dirty(&model)
    return 40 if model_dirty(&model) or not model_valid(&model)
    0

# A two-level layout: a vertical root with a horizontal header and a vertical
# body; padding, spacing, and orientation decide every rectangle.
def layout_test() -> i32:
    layout: mutable Layout = layout_new()
    root: i64 = layout_add(&layout, -1, Orientation.Vertical, 0, 10, 4)
    header: i64 = layout_add(&layout, root, Orientation.Horizontal, 30, 2, 6)
    body: i64 = layout_add(&layout, root, Orientation.Vertical, 60, 2, 0)
    left: i64 = layout_add(&layout, header, Orientation.Vertical, 20, 0, 0)
    right: i64 = layout_add(&layout, header, Orientation.Vertical, 40, 0, 0)
    row_a: i64 = layout_add(&layout, body, Orientation.Horizontal, 25, 0, 0)
    row_b: i64 = layout_add(&layout, body, Orientation.Horizontal, 25, 0, 0)
    return 1 if root != 0 or header != 1 or body != 2 or left != 3 or right != 4 or row_a != 5 or row_b != 6
    return 2 if layout_add(&layout, 9, Orientation.Vertical, 1, 0, 0) != -1 or not layout_valid(&layout)
    layout_compute(&layout, 0, 0, 200, 100)
    root_rect: Rect = node_rect(&layout, 0)
    header_rect: Rect = node_rect(&layout, 1)
    body_rect: Rect = node_rect(&layout, 2)
    return 3 if root_rect.width != 200 or root_rect.height != 100
    return 4 if header_rect.x != 10 or header_rect.y != 10 or header_rect.width != 180 or header_rect.height != 30
    return 5 if body_rect.y != 44 or body_rect.height != 60
    left_rect: Rect = node_rect(&layout, 3)
    right_rect: Rect = node_rect(&layout, 4)
    return 6 if left_rect.x != 12 or left_rect.y != 12 or left_rect.width != 20 or left_rect.height != 26
    return 7 if right_rect.x != 38 or right_rect.width != 40
    row_a_rect: Rect = node_rect(&layout, 5)
    row_b_rect: Rect = node_rect(&layout, 6)
    return 8 if row_a_rect.x != 12 or row_a_rect.y != 46 or row_a_rect.width != 176 or row_a_rect.height != 25
    return 9 if row_b_rect.y != 71
    0

# Text line breaking: words pack greedily until a line would overflow, then a
# new line starts; a word wider than the line still occupies one line so the
# overflow is recorded rather than hidden.
def text_test() -> i32:
    run: mutable Run = run_new()
    return 10 if not run_valid(&run) or run.count != 0
    _ = run_add_word(&run, 3)
    _ = run_add_word(&run, 2)
    _ = run_add_word(&run, 4)
    return 11 if run.count != 3 or not run_valid(&run) or run_add_word(&run, 0 - 1)
    wrapped: Wrapped = wrap(&run, 6, 1)
    return 12 if wrapped.line_count != 2 or not wrapped_valid(&wrapped)
    return 13 if line_start(&wrapped, 0) != 0 or line_width(&wrapped, 0) != 6
    return 14 if line_start(&wrapped, 1) != 2 or line_width(&wrapped, 1) != 4
    return 15 if line_width(&wrapped, 2) != -1
    long_run: mutable Run = run_new()
    _ = run_add_word(&long_run, 10)
    _ = run_add_word(&long_run, 2)
    wide: Wrapped = wrap(&long_run, 6, 1)
    return 16 if wide.line_count != 2 or line_width(&wide, 0) != 10 or line_width(&wide, 1) != 2
    return 17 if wrap(&run, 0, 1).line_count != 0
    0

# One theme decides every state color; a disabled row never shows focus, and
# a host is expected to apply exactly these values.
def style_test() -> i32:
    theme: Theme = theme_default()
    return 1 if not theme_valid(&theme)
    normal: Color = theme_text_color(&theme, true, false)
    focused: Color = theme_text_color(&theme, true, true)
    disabled: Color = theme_text_color(&theme, false, true)
    return 2 if normal.r != theme.text.r or normal.b != theme.text.b
    return 3 if focused.g != theme.focus.g
    return 4 if disabled.r != theme.disabled.r
    return 5 if theme_surface_inset(&theme) != theme.padding + theme.border
    return 6 if color_valid(color_new(256, 0, 0, 255)) or color_valid(color_new(0, 0, 0, -1))
    return 7 if theme.disabled.r >= theme.text.r
    0

def main() -> i32:
    history: mutable History = history_new()
    return 1 if not history_valid(&history) or history_can_undo(&history) or history_can_redo(&history)

    pushed: bool = history_push(&history, 7, 10, 20)
    return 2 if not pushed or not history_can_undo(&history)
    undone: UndoResult = history_undo(&history)
    return 3 if not undone.applied or undone.value != 10 or history_can_undo(&history)
    redone: UndoResult = history_redo(&history)
    return 4 if not redone.applied or redone.value != 20 or history_can_redo(&history)

    branched: bool = history_push(&history, 7, 20, 30)
    return 5 if not branched or history_can_redo(&history)
    back: UndoResult = history_undo(&history)
    return 6 if not back.applied or back.value != 20
    back_again: UndoResult = history_undo(&history)
    return 7 if not back_again.applied or back_again.value != 10

    for step in 0..<16 |history|:
        filled: bool = history_push(&history, step.i64(), step.i64(), step.i64())
        return 8 if not filled
    return 9 if history.length != 16
    overflow: bool = history_push(&history, 99, 1, 2)
    return 10 if overflow or not history_valid(&history)

    reloads: mutable Reloads = reloads_new()
    return 11 if not reloads_valid(&reloads) or current_generation(&reloads, 5) != -1
    first: bool = note_asset_reload(&reloads, 5)
    return 12 if not first or current_generation(&reloads, 5) != 0 or not reloads_valid(&reloads)
    second: bool = note_asset_reload(&reloads, 5)
    return 13 if not second or current_generation(&reloads, 5) != 1
    return 14 if not is_stale(&reloads, 5, 0) or is_stale(&reloads, 5, 1)
    rejected: bool = note_asset_reload(&reloads, 0)
    return 15 if rejected

    # Code-reload policy: the gate is open only when no system is running and
    # no callback is in flight, and migration is explicit rather than guessed.
    gate: mutable Gate = gate_new()
    return 16 if not gate_valid(&gate) or not gate_quiescent(&gate) or not reload_allowed(&gate)
    gate_enter(&gate)
    return 17 if gate_quiescent(&gate) or reload_allowed(&gate)
    busy: i32 = catch reload_begin(&gate):
        ok: 0
        ReloadError.Busy: 1
        error failure: 2
    return 18 if busy != 1 or gate.reloads != 0
    gate_leave(&gate)
    return 19 if not gate_quiescent(&gate) or not reload_allowed(&gate)
    callback_begin(&gate)
    return 20 if gate_quiescent(&gate) or reload_allowed(&gate)
    callback_end(&gate)
    allowed: i32 = catch reload_begin(&gate):
        ok: 0
        ReloadError.Busy: 1
        error failure: 2
    return 21 if allowed != 0 or gate.reloads != 1

    migrated: mutable State = state_new()
    return 22 if migrated.version != 1 or not state_valid(&migrated) or current_version() != 2
    migrated.value <- 5
    step_up: i32 = catch migrate(&migrated, 2):
        ok: 0
        ReloadError.UnknownVersion: 1
        ReloadError.Downgrade: 2
        error failure: 3
    return 23 if step_up != 0 or migrated.version != 2 or migrated.value != 10 or not state_valid(&migrated)
    no_op: i32 = catch migrate(&migrated, 2):
        ok: 0
        ReloadError.UnknownVersion: 1
        error failure: 2
    return 24 if no_op != 0 or migrated.value != 10
    downgraded: i32 = catch migrate(&migrated, 1):
        ok: 0
        ReloadError.Downgrade: 1
        ReloadError.UnknownVersion: 2
        error failure: 3
    return 25 if downgraded != 1 or migrated.version != 2
    unknown: i32 = catch migrate(&migrated, 3):
        ok: 0
        ReloadError.UnknownVersion: 1
        ReloadError.Downgrade: 2
        error failure: 3
    return 26 if unknown != 1 or migrated.value != 10
    base: mutable State = State{version: 1, value: 3}
    current: State = catch migrated_to_current(&base):
        value: value
        error failure: return 27
    return 28 if current.version != 2 or current.value != 6 or not state_valid(&current)
    styled: i32 = style_test()
    return styled if styled != 0
    laid_out: i32 = layout_test()
    return laid_out if laid_out != 0
    wrapped_text: i32 = text_test()
    return wrapped_text if wrapped_text != 0
    view: i32 = inspector_view_test()
    return view if view != 0
    browser: i32 = asset_browser_test()
    return browser if browser != 0
    0
