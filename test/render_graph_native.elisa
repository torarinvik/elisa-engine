        configuration: mutable RenderGraphRuntime::Configuration = RenderGraphRuntime::Configuration()
        configuration.output_resource_id <- 4
        configuration.operation_count <- 3
        configuration.operations[0] <- RenderGraphRuntime::PassOperation{
            pass_id: 10,
            kind: RenderGraphRuntime::OperationKind.ClearColor,
            source_resource_id: 0,
            destination_resource_id: 2,
