include "../src/backend/render_graph.elisa"
include "../src/runtime/render_graph_runtime.elisa"
include "../src/runtime/application.elisa"
include "../src/runtime/render_scene.elisa"
include "render_graph_blend_native.elisa"
include "render_graph_saturation_native.elisa"
include "render_graph_scale_color_native.elisa"
include "render_graph_tint_native.elisa"
include "render_graph_fxaa_native.elisa"
include "render_graph_sharpen_native.elisa"
include "render_graph_chromatic_aberration_native.elisa"
include "render_graph_normals_from_depth_native.elisa"

module RenderGraphNativeTests:
    const SUCCESS: i32 = RenderGraphRuntime::CONFIGURE_OK
    const RETIREMENT_TARGET_DIMENSION: u32 = 1024
    const RETIREMENT_MIN_BYTES: u64 = 8 * 1024 * 1024
    const INVALID_BLEND_OPACITY: f32 = 1.01
    const TRANSPARENT_BLEND_OPACITY: f32 = 0.0
    const HALF_BLEND_OPACITY: f32 = 0.5

    @callconv(c)
    extern elisa_render_scene_v1_render_graph_test_fail_next_allocation() -> i32
    @callconv(c)
    extern elisa_render_scene_v1_render_graph_test_fail_pass(index: u32) -> i32
    @callconv(c)
    extern elisa_render_scene_v1_render_graph_test_suspend_next_frame() -> i32
    @callconv(c)
    extern elisa_render_scene_v1_render_graph_test_fallback_preserved() -> i32
    @callconv(c)
    extern elisa_render_scene_v1_last_frame_center_differs_from_corner() -> i32
    @callconv(c)
    extern elisa_render_scene_v1_last_frame_hash() -> u64
    @callconv(c)
    extern elisa_application_v1_test_set_minimized(minimized: i32) -> i32
    @callconv(c)
    extern elisa_render_scene_v1_render_graph_test_depth_clear_count() -> u64
    @callconv(c)
    extern elisa_render_scene_v1_render_graph_test_color_resolve_count() -> u64
    @callconv(c)
    extern elisa_render_scene_v1_render_graph_test_scene_depth_read_count() -> u64
    @callconv(c)
    extern elisa_render_scene_v1_render_graph_test_device_memory_usage() -> u64
    @callconv(c)
    extern elisa_render_scene_v1_render_graph_test_retirement_frame_count() -> u32
    @callconv(c)
    extern elisa_render_scene_v1_render_graph_test_wait_for_gpu() -> i32

    def primary_color(id: u32, lifetime: RenderGraph::Lifetime,
            initialized: bool) -> RenderGraph::ResourceDescriptor:
        RenderGraph::ResourceDescriptor{
            id: id,
            size_mode: RenderGraph::SizeMode.PrimaryInternal,
            width: 0,
            height: 0,
            format: RenderGraph::Format.R11G11B10Float,
            samples: 1,
            lifetime: lifetime,
            initialized: initialized,
            import_source: RenderGraph::ImportSource.SceneColor if lifetime == RenderGraph::Lifetime.Imported else RenderGraph::ImportSource.None,
        }

    def scene_depth_import(id: u32) -> RenderGraph::ResourceDescriptor:
        RenderGraph::ResourceDescriptor{
            id: id,
            size_mode: RenderGraph::SizeMode.PrimaryInternal,
            width: 0,
            height: 0,
            format: RenderGraph::Format.R32Float,
            samples: 1,
            lifetime: RenderGraph::Lifetime.Imported,
            initialized: true,
            import_source: RenderGraph::ImportSource.SceneDepth,
        }

    def configure_clear_copy_graph(output_id: u32) -> i32:
        graph: mutable RenderGraph::Graph = RenderGraph::Graph()
        _ = catch RenderGraph::add_resource(&graph, primary_color(1,
                RenderGraph::Lifetime.Imported, true)):
            ok: 0
            error failure: return 1
        _ = catch RenderGraph::add_resource(&graph, primary_color(2,
                RenderGraph::Lifetime.Transient, false)):
            ok: 0
            error failure: return 2
        _ = catch RenderGraph::add_resource(&graph, primary_color(3,
                RenderGraph::Lifetime.Transient, false)):
            ok: 0
            error failure: return 3
        _ = catch RenderGraph::add_pass(&graph, 10):
            ok: 0
            error failure: return 4
        _ = catch RenderGraph::add_pass(&graph, 20):
            ok: 0
            error failure: return 5
        _ = catch RenderGraph::add_pass(&graph, 30):
            ok: 0
            error failure: return 5
        _ = catch RenderGraph::write(&graph, 10, 2):
            ok: 0
            error failure: return 6
        _ = catch RenderGraph::read(&graph, 20, 1):
            ok: 0
            error failure: return 7
        _ = catch RenderGraph::write(&graph, 20, 3):
            ok: 0
            error failure: return 8
        _ = catch RenderGraph::read(&graph, 30, 1):
            ok: 0
            error failure: return 8
        _ = catch RenderGraph::read(&graph, 30, 3):
            ok: 0
            error failure: return 8
        _ = catch RenderGraph::write(&graph, 30, 3):
            ok: 0
            error failure: return 8
        _ = catch RenderGraph::add_dependency(&graph, 10, 20):
            ok: 0
            error failure: return 9
        _ = catch RenderGraph::add_dependency(&graph, 20, 30):
            ok: 0
            error failure: return 9
        plan: RenderGraph::Plan = catch RenderGraph::compile(&graph):
            value: value
            error failure: return 10
        return 11 if plan.transient_slot_count != 1 or plan.alias_slots[1] != plan.alias_slots[2]
        configuration: mutable RenderGraphRuntime::Configuration = RenderGraphRuntime::Configuration()
        configuration.output_resource_id <- output_id
        configuration.operation_count <- 3
        configuration.operations[0] <- RenderGraphRuntime::PassOperation{
            pass_id: 10,
            kind: RenderGraphRuntime::OperationKind.ClearColor,
            source_resource_id: 0,
            destination_resource_id: 2,
            value: RenderGraphRuntime::FULL_OPACITY,
            tint_red: 1.0,
            tint_green: 1.0,
            tint_blue: 1.0,
            tint_alpha: 1.0,
        }
        configuration.operations[1] <- RenderGraphRuntime::PassOperation{
            pass_id: 20,
            kind: RenderGraphRuntime::OperationKind.CopyColor,
            source_resource_id: 1,
            destination_resource_id: 3,
            value: RenderGraphRuntime::FULL_OPACITY,
            tint_red: 1.0,
            tint_green: 1.0,
            tint_blue: 1.0,
            tint_alpha: 1.0,
        }
        configuration.operations[2] <- RenderGraphRuntime::PassOperation{
            pass_id: 30,
            kind: RenderGraphRuntime::OperationKind.BlendColor,
            source_resource_id: 1,
            destination_resource_id: 3,
            value: RenderGraphRuntime::FULL_OPACITY,
            tint_red: 1.0,
            tint_green: 1.0,
            tint_blue: 1.0,
            tint_alpha: 1.0,
        }
        invalid_configuration: mutable RenderGraphRuntime::Configuration = configuration
        invalid_configuration.operations[1].source_resource_id <- 3
        invalid_status: i32 = RenderGraphRuntime::configure(graph, plan,
            invalid_configuration)
        return 12 if invalid_status != RenderGraphRuntime::CONFIGURE_INVALID_PLAN
        result: i32 = RenderGraphRuntime::configure(graph, plan, configuration)
        return 13 if result != RenderGraphRuntime::CONFIGURE_OK
        0

    def configure_depth_graph() -> i32:
        graph: mutable RenderGraph::Graph = RenderGraph::Graph()
        _ = catch RenderGraph::add_resource(&graph, primary_color(1,
                RenderGraph::Lifetime.Imported, true)):
            ok: 0
            error failure: return 61
        _ = catch RenderGraph::add_resource(&graph, RenderGraph::ResourceDescriptor{
                id: 2,
                size_mode: RenderGraph::SizeMode.PrimaryInternal,
                width: 0,
                height: 0,
                format: RenderGraph::Format.Depth32,
                samples: 1,
                lifetime: RenderGraph::Lifetime.Transient,
                initialized: false,
                import_source: RenderGraph::ImportSource.None,
            }):
            ok: 0
            error failure: return 62
        _ = catch RenderGraph::add_resource(&graph, RenderGraph::ResourceDescriptor{
                id: 3,
                size_mode: RenderGraph::SizeMode.PrimaryInternal,
                width: 0,
                height: 0,
                format: RenderGraph::Format.R11G11B10Float,
                samples: 4,
                lifetime: RenderGraph::Lifetime.Transient,
                initialized: false,
                import_source: RenderGraph::ImportSource.None,
            }):
            ok: 0
            error failure: return 63
        _ = catch RenderGraph::add_resource(&graph, primary_color(4,
                RenderGraph::Lifetime.Transient, false)):
            ok: 0
            error failure: return 64
        _ = catch RenderGraph::add_resource(&graph, primary_color(5,
                RenderGraph::Lifetime.Transient, false)):
            ok: 0
            error failure: return 65
        _ = catch RenderGraph::add_pass(&graph, 10):
            ok: 0
            error failure: return 65
        _ = catch RenderGraph::add_pass(&graph, 20):
            ok: 0
            error failure: return 66
        _ = catch RenderGraph::add_pass(&graph, 30):
            ok: 0
            error failure: return 67
        _ = catch RenderGraph::add_pass(&graph, 40):
            ok: 0
            error failure: return 68
        _ = catch RenderGraph::write(&graph, 10, 2):
            ok: 0
            error failure: return 69
        _ = catch RenderGraph::write(&graph, 20, 3):
            ok: 0
            error failure: return 70
        _ = catch RenderGraph::read(&graph, 30, 3):
            ok: 0
            error failure: return 71
        _ = catch RenderGraph::write(&graph, 30, 4):
            ok: 0
            error failure: return 72
        _ = catch RenderGraph::read(&graph, 40, 1):
            ok: 0
            error failure: return 73
        _ = catch RenderGraph::write(&graph, 40, 5):
            ok: 0
            error failure: return 74
        _ = catch RenderGraph::add_dependency(&graph, 10, 20):
            ok: 0
            error failure: return 75
        _ = catch RenderGraph::add_dependency(&graph, 20, 30):
            ok: 0
            error failure: return 76
        _ = catch RenderGraph::add_dependency(&graph, 30, 40):
            ok: 0
            error failure: return 77
        plan: RenderGraph::Plan = catch RenderGraph::compile(&graph):
            value: value
            error failure: return 78
        return 79 if plan.transient_slot_count != 3 or plan.alias_slots[3] != plan.alias_slots[4]
        configuration: mutable RenderGraphRuntime::Configuration = RenderGraphRuntime::Configuration()
        configuration.output_resource_id <- 4
        configuration.operation_count <- 4
        configuration.operations[0] <- RenderGraphRuntime::PassOperation{
            pass_id: 10,
            kind: RenderGraphRuntime::OperationKind.ClearDepth,
            source_resource_id: 0,
            destination_resource_id: 2,
            value: RenderGraphRuntime::FULL_OPACITY,
            tint_red: 1.0,
            tint_green: 1.0,
            tint_blue: 1.0,
            tint_alpha: 1.0,
        }
        configuration.operations[1] <- RenderGraphRuntime::PassOperation{
            pass_id: 20,
            kind: RenderGraphRuntime::OperationKind.ClearColor,
            source_resource_id: 0,
            destination_resource_id: 3,
            value: RenderGraphRuntime::FULL_OPACITY,
            tint_red: 1.0,
            tint_green: 1.0,
            tint_blue: 1.0,
            tint_alpha: 1.0,
        }
        configuration.operations[2] <- RenderGraphRuntime::PassOperation{
            pass_id: 30,
            kind: RenderGraphRuntime::OperationKind.ResolveColor,
            source_resource_id: 3,
            destination_resource_id: 4,
            value: RenderGraphRuntime::FULL_OPACITY,
            tint_red: 1.0,
            tint_green: 1.0,
            tint_blue: 1.0,
            tint_alpha: 1.0,
        }
        configuration.operations[3] <- RenderGraphRuntime::PassOperation{
            pass_id: 40,
            kind: RenderGraphRuntime::OperationKind.CopyColor,
            source_resource_id: 1,
            destination_resource_id: 5,
            value: RenderGraphRuntime::FULL_OPACITY,
            tint_red: 1.0,
            tint_green: 1.0,
            tint_blue: 1.0,
            tint_alpha: 1.0,
        }
        invalid_depth_configuration: mutable RenderGraphRuntime::Configuration = configuration
        invalid_depth_configuration.operations[1].kind <- RenderGraphRuntime::OperationKind.ClearDepth
        invalid_depth_status: i32 = RenderGraphRuntime::configure(graph, plan,
            invalid_depth_configuration)
        return 76 if invalid_depth_status != RenderGraphRuntime::CONFIGURE_NATIVE_REJECTED
        result: i32 = RenderGraphRuntime::configure(graph, plan, configuration)
        return 80 if result != RenderGraphRuntime::CONFIGURE_OK
        0

