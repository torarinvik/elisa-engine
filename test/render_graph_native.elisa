include "render_graph_native_harness.elisa"
include "render_graph_authored_scene_native.elisa"
using RenderGraphNativeHarness

module RenderGraphNativeTests:
    private:
        const SUCCESS: i32 = RenderGraphRuntime::CONFIGURE_OK
        const INVALID_BLEND_OPACITY: f32 = 1.01
        const TRANSPARENT_BLEND_OPACITY: f32 = 0.0
        const HALF_BLEND_OPACITY: f32 = 0.5
        @callconv(c)
        extern elisa_render_scene_v1_test_failed_case(group: i32, case_number: i32) -> i32

    public:
        def exercise() -> i32:
            return 1 if configure_clear_copy_graph(3) != SUCCESS
            for attempt in 0..<2:
                return 2 if Application::pump() != Application::PumpStatus.Running
            return 3 if RenderGraphRuntime::last_execution_status() != RenderGraphRuntime::EXECUTION_OK or RenderGraphRuntime::execution_count() == 0
            return 219 if RenderGraphBlendTests::configure(INVALID_BLEND_OPACITY) != RenderGraphRuntime::CONFIGURE_INVALID_PLAN
            return 230 if RenderGraphBlendTests::configure(TRANSPARENT_BLEND_OPACITY) != SUCCESS
            return 236 if not RenderGraphBlendTests::native_rejects_bad_opacity()
            return 231 if Application::pump() != Application::PumpStatus.Running
            return 232 if RenderGraphRuntime::last_execution_status() != RenderGraphRuntime::EXECUTION_OK or elisa_render_scene_v1_last_frame_center_differs_from_corner() != 0
            return 233 if RenderGraphBlendTests::configure(HALF_BLEND_OPACITY) != SUCCESS
            return 234 if Application::pump() != Application::PumpStatus.Running
            return 235 if RenderGraphRuntime::last_execution_status() != RenderGraphRuntime::EXECUTION_OK or elisa_render_scene_v1_last_frame_center_differs_from_corner() == 0
            before_suspension: u64 = RenderGraphRuntime::execution_count()
            return 36 if elisa_render_scene_v1_render_graph_test_suspend_next_frame() != SUCCESS
            return 37 if Application::pump() != Application::PumpStatus.Running
            return 38 if RenderGraphRuntime::last_execution_status() != RenderGraphRuntime::EXECUTION_SUSPENDED
            return 39 if RenderGraphRuntime::execution_count() != before_suspension
            return 40 if elisa_render_scene_v1_render_graph_test_fallback_preserved() != 1
            return 41 if Application::pump() != Application::PumpStatus.Running
            return 42 if RenderGraphRuntime::last_execution_status() != RenderGraphRuntime::EXECUTION_OK or RenderGraphRuntime::execution_count() <= before_suspension
            before_platform_suspend_frames: u64 = Application::frame_count()
            before_platform_suspend_graph_frames: u64 = RenderGraphRuntime::execution_count()
            return 49 if elisa_application_v1_test_set_minimized(1) != 0
            return 50 if Application::pump() != Application::PumpStatus.Suspended
            minimized_info: mutable Application::FrameInfo = zeroed
            return 51 if not Application::frame_info(&minimized_info)
            return 52 if not Application::saw_minimize(minimized_info) or not Application::is_minimized(minimized_info) or not Application::is_suspended(minimized_info)
            return 53 if Application::frame_count() != before_platform_suspend_frames or RenderGraphRuntime::execution_count() != before_platform_suspend_graph_frames
            return 54 if elisa_render_scene_v1_last_frame_center_differs_from_corner() == 0
            return 55 if elisa_application_v1_test_set_minimized(0) != 0
            return 56 if Application::pump() != Application::PumpStatus.Running
            restored_info: mutable Application::FrameInfo = zeroed
            return 57 if not Application::frame_info(&restored_info)
            return 58 if not Application::saw_restore(restored_info) or Application::is_minimized(restored_info) or Application::is_suspended(restored_info)
            return 59 if Application::frame_count() != before_platform_suspend_frames + 1 or RenderGraphRuntime::execution_count() <= before_platform_suspend_graph_frames
            return 60 if RenderGraphRuntime::last_execution_status() != RenderGraphRuntime::EXECUTION_OK or elisa_render_scene_v1_last_frame_center_differs_from_corner() == 0
            depth_clears_before: u64 = elisa_render_scene_v1_render_graph_test_depth_clear_count()
            resolves_before: u64 = elisa_render_scene_v1_render_graph_test_color_resolve_count()
            depth_graph_status: i32 = configure_depth_graph()
            return 81 + depth_graph_status if depth_graph_status != 0
            return 78 if Application::pump() != Application::PumpStatus.Running
            return 79 if RenderGraphRuntime::last_execution_status() != RenderGraphRuntime::EXECUTION_OK or elisa_render_scene_v1_render_graph_test_depth_clear_count() != depth_clears_before + 1 or elisa_render_scene_v1_render_graph_test_color_resolve_count() != resolves_before + 1
            return 80 if elisa_render_scene_v1_last_frame_center_differs_from_corner() != 0
            clear_output_status: i32 = configure_clear_copy_graph(2)
            return 43 if clear_output_status != SUCCESS
            return 44 if Application::pump() != Application::PumpStatus.Running
            return 45 if RenderGraphRuntime::last_execution_status() != RenderGraphRuntime::EXECUTION_OK or elisa_render_scene_v1_last_frame_center_differs_from_corner() != 0
            restore_output_status: i32 = configure_clear_copy_graph(3)
            return 46 if restore_output_status != SUCCESS
            return 47 if Application::pump() != Application::PumpStatus.Running
            return 48 if RenderGraphRuntime::last_execution_status() != RenderGraphRuntime::EXECUTION_OK or elisa_render_scene_v1_last_frame_center_differs_from_corner() == 0
            before_resize: u64 = RenderGraphRuntime::execution_count()
            resize_down: i32 = catch RenderScene::resize(320, 200):
                ok: 0
                error failure: 1
            return 14 if resize_down != SUCCESS
            small_viewport: i32 = catch RenderScene::set_primary_viewport(0, 0, 320, 200):
                ok: 0
                error failure: 1
            return 34 if small_viewport != SUCCESS
            return 20 if elisa_render_scene_v1_render_graph_test_fail_next_allocation() != SUCCESS
            count_before_allocation_failure: u64 = RenderGraphRuntime::execution_count()
            return 21 if Application::pump() != Application::PumpStatus.Running
            return 22 if RenderGraphRuntime::last_execution_status() != RenderGraphRuntime::EXECUTION_BACKEND_FAILED
            return 23 if RenderGraphRuntime::execution_count() != count_before_allocation_failure
            return 24 if elisa_render_scene_v1_render_graph_test_fallback_preserved() != 1
            return 25 if Application::pump() != Application::PumpStatus.Running
            return 26 if RenderGraphRuntime::last_execution_status() != RenderGraphRuntime::EXECUTION_OK or RenderGraphRuntime::execution_count() <= before_resize
            for attempt in 0..<2:
                return 15 if Application::pump() != Application::PumpStatus.Running
            before_restore: u64 = RenderGraphRuntime::execution_count()
            resize_restore: i32 = catch RenderScene::resize(640, 400):
                ok: 0
                error failure: 1
            return 17 if resize_restore != SUCCESS
            clear_small_viewport: i32 = catch RenderScene::clear_primary_viewport():
                ok: 0
                error failure: 1
            return 35 if clear_small_viewport != SUCCESS
            return 27 if elisa_render_scene_v1_render_graph_test_fail_pass(1) != RenderGraphRuntime::CONFIGURE_OK
            count_before_pass_failure: u64 = RenderGraphRuntime::execution_count()
            return 28 if Application::pump() != Application::PumpStatus.Running
            return 29 if RenderGraphRuntime::last_execution_status() != RenderGraphRuntime::EXECUTION_BACKEND_FAILED
            return 30 if RenderGraphRuntime::execution_count() != count_before_pass_failure
            return 31 if elisa_render_scene_v1_render_graph_test_fallback_preserved() != 1
            return 32 if Application::pump() != Application::PumpStatus.Running
            return 33 if RenderGraphRuntime::last_execution_status() != RenderGraphRuntime::EXECUTION_OK or RenderGraphRuntime::execution_count() <= count_before_pass_failure
            for attempt in 0..<2:
                return 18 if Application::pump() != Application::PumpStatus.Running
            return 19 if RenderGraphRuntime::last_execution_status() != RenderGraphRuntime::EXECUTION_OK or RenderGraphRuntime::execution_count() < before_restore
            retirement_setup: i32 = configure_retirement_graph()
            return 200 + retirement_setup if retirement_setup != 0
            memory_before: u64 = elisa_render_scene_v1_render_graph_test_device_memory_usage()
            return 201 if Application::pump() != Application::PumpStatus.Running
            return 202 if RenderGraphRuntime::last_execution_status() != RenderGraphRuntime::EXECUTION_OK
            memory_first: u64 = elisa_render_scene_v1_render_graph_test_device_memory_usage()
            return 203 if memory_first < memory_before + RETIREMENT_MIN_BYTES
            retirement_reconfigure: i32 = configure_retirement_graph()
            return 204 + retirement_reconfigure if retirement_reconfigure != 0
            return 205 if Application::pump() != Application::PumpStatus.Running
            memory_pending: u64 = elisa_render_scene_v1_render_graph_test_device_memory_usage()
            return 206 if memory_pending < memory_first + RETIREMENT_MIN_BYTES
            retirement_frames: u32 = elisa_render_scene_v1_render_graph_test_retirement_frame_count()
            for attempt in 0..<retirement_frames:
                return 207 if Application::pump() != Application::PumpStatus.Running
            return 208 if elisa_render_scene_v1_render_graph_test_wait_for_gpu() != 1
            memory_retired: u64 = elisa_render_scene_v1_render_graph_test_device_memory_usage()
            return 209 if memory_pending <= memory_retired or memory_pending - memory_retired < RETIREMENT_MIN_BYTES
            return 210 if configure_clear_copy_graph(3) != SUCCESS
            return 211 if Application::pump() != Application::PumpStatus.Running
            depth_import_setup: i32 = configure_scene_depth_graph()
            return 212 + depth_import_setup if depth_import_setup != 0
            depth_reads_before: u64 = elisa_render_scene_v1_render_graph_test_scene_depth_read_count()
            return 213 if Application::pump() != Application::PumpStatus.Running
            return 214 if RenderGraphRuntime::last_execution_status() != RenderGraphRuntime::EXECUTION_OK
            return 215 if elisa_render_scene_v1_render_graph_test_scene_depth_read_count() != depth_reads_before + 1
            return 216 if elisa_render_scene_v1_last_frame_center_differs_from_corner() == 0
            return 217 if configure_clear_copy_graph(3) != SUCCESS
            return 218 if Application::pump() != Application::PumpStatus.Running
            depth_normals_before: u64 = elisa_render_scene_v1_last_frame_hash()
            depth_normals_reads_before: u64 = elisa_render_scene_v1_render_graph_test_scene_depth_read_count()
            return 302 if RenderGraphNormalsFromDepthTests::configure(RenderGraph::Format.Rgba8) != RenderGraphRuntime::CONFIGURE_INVALID_PLAN
            return 303 if not RenderGraphNormalsFromDepthTests::rejects_output_format()
            return 304 if not RenderGraphNormalsFromDepthTests::rejects_scene_color_source()
            return 305 if RenderGraphNormalsFromDepthTests::configure(RenderGraph::Format.Rgba16Float) != SUCCESS
            return 306 if Application::pump() != Application::PumpStatus.Running
            return 307 if RenderGraphRuntime::last_execution_status() != RenderGraphRuntime::EXECUTION_OK
            return 308 if elisa_render_scene_v1_render_graph_test_scene_depth_read_count() != depth_normals_reads_before + 1
            return 309 if elisa_render_scene_v1_last_frame_hash() == depth_normals_before
            return 310 if configure_clear_copy_graph(3) != SUCCESS
            return 311 if Application::pump() != Application::PumpStatus.Running
            return 312 if RenderGraphRuntime::last_execution_status() != RenderGraphRuntime::EXECUTION_OK or elisa_render_scene_v1_last_frame_center_differs_from_corner() == 0
            saturation_status: i32 = exercise_saturation()
            return saturation_status if saturation_status != 0
            scale_status: i32 = exercise_color_scale()
            return scale_status if scale_status != 0
            tint_status: i32 = exercise_tint_color()
            return tint_status if tint_status != 0
            fxaa_status: i32 = exercise_fxaa()
            return fxaa_status if fxaa_status != 0
            sharpen_status: i32 = exercise_sharpen()
            return sharpen_status if sharpen_status != 0
            aberration_status: i32 = exercise_chromatic_aberration()
            return aberration_status if aberration_status != 0
            authored_status: i32 = RenderGraphAuthoredSceneTests::exercise()
            return elisa_render_scene_v1_test_failed_case(239, authored_status) if authored_status != 0
            0
