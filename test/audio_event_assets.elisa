include "../src/audio/event_assets.elisa"

# Asset text is built byte by byte: Elisa has no string-to-bytes view.
def put(source: mutable SoundEventAssets::Source&, byte: u8) -> void:
    _ = SoundEventAssets::append(source, byte)

def word(source: mutable SoundEventAssets::Source&, seed: bool) -> void:
    if seed:
        put(source, 115)
        put(source, 101)
        put(source, 101)
        put(source, 100)
    else:
        put(source, 101)
        put(source, 118)
        put(source, 101)
        put(source, 110)
        put(source, 116)

# Writes ` <value>` in decimal.
def field(source: mutable SoundEventAssets::Source&, value: u64) -> void:
    put(source, 32)
    digits: usize =
        for index in 0..<20 |count: usize = 1, rest: u64 = value / 10| -> count:
            count <- count + 1 if rest > 0
            rest <- rest / 10
    for index in 0..<digits |source|:
        power: u64 =
            for step in 0..<(digits - 1 - index) |scale: u64 = 1| -> scale:
                scale <- scale * 10
        put(source, 48 + (value / power % 10).u8())

def event(source: mutable SoundEventAssets::Source&, id: u64, group: u64, limit: u64, variants: u64, cooldown: u64) -> void:
    word(source, false)
    field(source, id)
    field(source, group)
    field(source, limit)
    field(source, variants)
    field(source, cooldown)

def newline(source: mutable SoundEventAssets::Source&) -> void:
    put(source, 10)

def comment(source: mutable SoundEventAssets::Source&) -> void:
    put(source, 32)
    put(source, 35)
    put(source, 32)
    put(source, 120)

# 0 ok, 1 Syntax, 2 UnknownRecord, 3 FieldCount, 4 NumberTooLarge,
# 5 Oversize, 6 InvalidDefinition, 7 DuplicateEvent, 8 Capacity,
# 10 InvalidTrigger, 11 DuplicateTrigger, 12 UnknownEvent, 13 InvalidMood,
# 14 DuplicateMood, 15 InvalidMusic, 16 DuplicateMusic, 9 other.
def load_triggers(board: mutable AudioEvents::Board&, triggers: mutable SoundEventAssets::Triggers&, source: SoundEventAssets::Source&) -> i32:
    catch SoundEventAssets::define_from(board, triggers, source):
        ok: 0
        SoundEventAssets::SoundAssetError.InvalidTrigger: 10
        SoundEventAssets::SoundAssetError.DuplicateTrigger: 11
        AudioEvents::SoundEventError.UnknownEvent: 12
        SoundEventAssets::SoundAssetError.InvalidMood: 13
        SoundEventAssets::SoundAssetError.DuplicateMood: 14
        SoundEventAssets::SoundAssetError.InvalidMusic: 15
        SoundEventAssets::SoundAssetError.DuplicateMusic: 16
        SoundEventAssets::SoundAssetError.Syntax: 1
        SoundEventAssets::SoundAssetError.UnknownRecord: 2
        SoundEventAssets::SoundAssetError.FieldCount: 3
        SoundEventAssets::SoundAssetError.NumberTooLarge: 4
        SoundEventAssets::SoundAssetError.Oversize: 5
        AudioEvents::SoundEventError.InvalidDefinition: 6
        AudioEvents::SoundEventError.DuplicateEvent: 7
        AudioEvents::SoundEventError.Capacity: 8
        error failure: 9

def load_status(board: mutable AudioEvents::Board&, source: SoundEventAssets::Source&) -> i32:
    triggers: mutable SoundEventAssets::Triggers = SoundEventAssets::Triggers()
    load_triggers(board, &triggers, source)

# 0 fired (Play or Replace), 1 held back (Duplicate or Cooling), 2 error.
def outcome(board: mutable AudioEvents::Board&, id: u32, tick: u64) -> i32:
    catch AudioEvents::trigger(board, id, tick):
        value: 1 if value.outcome == AudioEvents::Outcome.Duplicate or value.outcome == AudioEvents::Outcome.Cooling else 0
        error failure: 2

# The course's asset shape: comments, blank lines, a seed and a weighted event.
def course_asset() -> SoundEventAssets::Source:
    source: mutable SoundEventAssets::Source = SoundEventAssets::Source()
    put(&source, 35)
    newline(&source)
    newline(&source)
    word(&source, true)
    field(&source, 20260928)
    newline(&source)
    event(&source, 1, 0, 1, 2, 0)
    field(&source, 3)
    field(&source, 1)
    comment(&source)
    newline(&source)
    put(&source, 9)
    event(&source, 2, 1, 1, 1, 6)
    put(&source, 13)
    newline(&source)
    source

def accepted_test() -> i32:
    source: SoundEventAssets::Source = course_asset()
    board: mutable AudioEvents::Board = AudioEvents::Board()
    return 1 if load_status(&board, &source) != 0
    return 2 if SoundEventAssets::failing_line(&source) != 0
    return 3 if outcome(&board, 1, 10) != 0 or outcome(&board, 2, 10) != 0
    # Land has a cooldown of 6 ticks.
    return 4 if outcome(&board, 2, 16) != 1 or outcome(&board, 2, 17) != 0
    return 5 if outcome(&board, 3, 10) != 2
    0

def load_one(source: SoundEventAssets::Source&) -> i32:
    board: mutable AudioEvents::Board = AudioEvents::Board()
    load_status(&board, source)

def rejected_test() -> i32:
    unknown: mutable SoundEventAssets::Source = SoundEventAssets::Source()
    put(&unknown, 101)
    field(&unknown, 1)
    return 10 if load_one(&unknown) != 2

    short: mutable SoundEventAssets::Source = SoundEventAssets::Source()
    word(&short, false)
    field(&short, 1)
    field(&short, 0)
    return 11 if load_one(&short) != 3

    long: mutable SoundEventAssets::Source = SoundEventAssets::Source()
    event(&long, 1, 0, 1, 4, 0)
    for extra in 0..<5 |long|:
        field(&long, 1)
    return 12 if load_one(&long) != 3

    letters: mutable SoundEventAssets::Source = SoundEventAssets::Source()
    event(&letters, 1, 0, 1, 1, 0)
    put(&letters, 120)
    return 13 if load_one(&letters) != 1

    wide: mutable SoundEventAssets::Source = SoundEventAssets::Source()
    event(&wide, 4294967296, 0, 1, 1, 0)
    return 14 if load_one(&wide) != 4

    huge: mutable SoundEventAssets::Source = SoundEventAssets::Source()
    word(&huge, true)
    field(&huge, 1000000000000000000)
    return 15 if load_one(&huge) != 4

    invalid: mutable SoundEventAssets::Source = SoundEventAssets::Source()
    event(&invalid, 1, 0, 1, 5, 0)
    return 16 if load_one(&invalid) != 6

    duplicate: mutable SoundEventAssets::Source = SoundEventAssets::Source()
    event(&duplicate, 1, 0, 1, 1, 0)
    newline(&duplicate)
    event(&duplicate, 1, 0, 1, 1, 0)
    return 17 if load_one(&duplicate) != 7
    return 18 if SoundEventAssets::failing_line(&duplicate) != 2

    full: mutable SoundEventAssets::Source = SoundEventAssets::Source()
    for id in 0..<17 |full|:
        event(&full, id.u64() + 1, 0, 1, 1, 0)
        newline(&full)
    return 19 if load_one(&full) != 8
    return 20 if SoundEventAssets::failing_line(&full) != 17

    weights: mutable SoundEventAssets::Source = SoundEventAssets::Source()
    event(&weights, 1, 0, 1, 1, 0)
    field(&weights, 0)
    return 21 if load_one(&weights) != 6

    filled: mutable SoundEventAssets::Source = SoundEventAssets::Source()
    fits: bool =
        for index in 0..<SoundEventAssets::MAX_BYTES |all: bool = true, filled| -> all:
            all <- all and SoundEventAssets::append(&filled, 10)
    return 22 if not fits or SoundEventAssets::append(&filled, 10)
    return 23 if load_one(&filled) != 0
    0

# A rejected asset leaves the caller's board as it was.
def atomic_test() -> i32:
    board: mutable AudioEvents::Board = AudioEvents::Board()
    first: SoundEventAssets::Source = course_asset()
    return 30 if load_status(&board, &first) != 0
    broken: mutable SoundEventAssets::Source = SoundEventAssets::Source()
    event(&broken, 9, 0, 1, 1, 0)
    newline(&broken)
    event(&broken, 9, 0, 1, 1, 0)
    return 31 if load_status(&board, &broken) != 7
    return 32 if outcome(&board, 9, 10) != 2 or outcome(&board, 1, 10) != 0
    0

# `footstep` or `impact` in ASCII.
def trigger_word(source: mutable SoundEventAssets::Source&, impact: bool) -> void:
    if impact:
        put(source, 105)
        put(source, 109)
        put(source, 112)
        put(source, 97)
        put(source, 99)
        put(source, 116)
    else:
        put(source, 102)
        put(source, 111)
        put(source, 111)
        put(source, 116)
        put(source, 115)
        put(source, 116)
        put(source, 101)
        put(source, 112)

def footstep(source: mutable SoundEventAssets::Source&, event_id: u64, stride: u64) -> void:
    trigger_word(source, false)
    field(source, event_id)
    field(source, stride)
    newline(source)

def impact(source: mutable SoundEventAssets::Source&, event_id: u64, threshold: u64, full: u64) -> void:
    trigger_word(source, true)
    field(source, event_id)
    field(source, threshold)
    field(source, full)
    newline(source)

def trigger_status(source: SoundEventAssets::Source&) -> i32:
    board: mutable AudioEvents::Board = AudioEvents::Board()
    triggers: mutable SoundEventAssets::Triggers = SoundEventAssets::Triggers()
    load_triggers(&board, &triggers, source)

# Footstep and impact records bind movement triggers to defined events.
def trigger_test() -> i32:
    bound: mutable SoundEventAssets::Source = course_asset()
    footstep(&bound, 1, 650)
    impact(&bound, 2, 300, 2400)
    board: mutable AudioEvents::Board = AudioEvents::Board()
    triggers: mutable SoundEventAssets::Triggers = SoundEventAssets::Triggers()
    return 40 if load_triggers(&board, &triggers, &bound) != 0
    return 41 if triggers.footfalls.event != 1 or triggers.footfalls.stride_mm != 650
    return 42 if triggers.impacts.event != 2 or triggers.impacts.threshold_mm != 300 or triggers.impacts.full_mm != 2400
    return 43 if SoundEventAssets::failing_line(&bound) != 0

    early: mutable SoundEventAssets::Source = SoundEventAssets::Source()
    footstep(&early, 1, 650)
    event(&early, 1, 0, 1, 1, 0)
    return 44 if trigger_status(&early) != 12 or SoundEventAssets::failing_line(&early) != 1

    short: mutable SoundEventAssets::Source = course_asset()
    footstep(&short, 1, 99)
    return 45 if trigger_status(&short) != 10

    flat: mutable SoundEventAssets::Source = course_asset()
    impact(&flat, 2, 300, 300)
    return 46 if trigger_status(&flat) != 10

    twice: mutable SoundEventAssets::Source = course_asset()
    impact(&twice, 2, 300, 2400)
    impact(&twice, 1, 100, 200)
    return 47 if trigger_status(&twice) != 11 or SoundEventAssets::failing_line(&twice) != 7

    missing: mutable SoundEventAssets::Source = course_asset()
    trigger_word(&missing, true)
    field(&missing, 2)
    field(&missing, 300)
    return 48 if trigger_status(&missing) != 3

    # A rejected asset leaves the caller's triggers as they were.
    broken: mutable SoundEventAssets::Source = SoundEventAssets::Source()
    footstep(&broken, 1, 650)
    return 49 if load_triggers(&board, &triggers, &broken) != 12
    return 50 if triggers.footfalls.event != 1 or triggers.impacts.event != 2

    # A new asset without trigger records turns both triggers off.
    plain: SoundEventAssets::Source = course_asset()
    fresh: mutable AudioEvents::Board = AudioEvents::Board()
    return 51 if load_triggers(&fresh, &triggers, &plain) != 0
    return 52 if triggers.footfalls.event != 0 or triggers.impacts.event != 0
    0

# `mood <id> <music> <effects> <ui> <ramp>` without the newline.
def mood_fields(source: mutable SoundEventAssets::Source&, id: u64, music: u64, effects: u64, ui: u64) -> void:
    put(source, 109)
    put(source, 111)
    put(source, 111)
    put(source, 100)
    field(source, id)
    field(source, music)
    field(source, effects)
    field(source, ui)

def mood(source: mutable SoundEventAssets::Source&, id: u64, music: u64, effects: u64, ui: u64, ramp: u64) -> void:
    mood_fields(source, id, music, effects, ui)
    field(source, ramp)
    newline(source)

def moods_near(moods: AudioMoods::Moods&, id: u64, music: u64, ramp: u64) -> bool:
    value: AudioMoods::Mood = AudioMoods::get(moods, id)
    value.defined and value.music_permille == music and value.effects_permille == 300 and value.ui_permille == 1000 and value.ramp_ms == ramp

# Mood records set mix moods by id; a mood left out is full gain.
def mood_test() -> i32:
    bound: mutable SoundEventAssets::Source = course_asset()
    mood(&bound, 1, 450, 300, 1000, 250)
    mood(&bound, 2, 200, 300, 1000, 400)
    board: mutable AudioEvents::Board = AudioEvents::Board()
    triggers: mutable SoundEventAssets::Triggers = SoundEventAssets::Triggers()
    return 60 if load_triggers(&board, &triggers, &bound) != 0 or SoundEventAssets::failing_line(&bound) != 0
    return 61 if not moods_near(&triggers.moods, 1, 450, 250) or not moods_near(&triggers.moods, 2, 200, 400)
    unset: AudioMoods::Mood = AudioMoods::get(&triggers.moods, 0)
    past: AudioMoods::Mood = AudioMoods::get(&triggers.moods, 9)
    return 62 if unset.defined or unset.music_permille != 1000 or unset.ramp_ms != AudioMoods::DEFAULT_RAMP_MS or past.defined

    beyond: mutable SoundEventAssets::Source = course_asset()
    mood(&beyond, 4, 450, 300, 1000, 250)
    return 63 if trigger_status(&beyond) != 13
    loud: mutable SoundEventAssets::Source = course_asset()
    mood(&loud, 1, 1001, 300, 1000, 250)
    return 64 if trigger_status(&loud) != 13
    slow: mutable SoundEventAssets::Source = course_asset()
    mood(&slow, 1, 450, 300, 1000, 3601)
    return 65 if trigger_status(&slow) != 13

    twice: mutable SoundEventAssets::Source = course_asset()
    mood(&twice, 1, 450, 300, 1000, 250)
    mood(&twice, 1, 200, 300, 1000, 250)
    return 66 if trigger_status(&twice) != 14 or SoundEventAssets::failing_line(&twice) != 7

    short: mutable SoundEventAssets::Source = course_asset()
    mood_fields(&short, 1, 450, 300, 1000)
    return 67 if trigger_status(&short) != 3

    # A rejected asset keeps the moods; a plain one clears them.
    return 68 if load_triggers(&board, &triggers, &twice) != 14 or not moods_near(&triggers.moods, 2, 200, 400)
    plain: SoundEventAssets::Source = course_asset()
    fresh: mutable AudioEvents::Board = AudioEvents::Board()
    return 69 if load_triggers(&fresh, &triggers, &plain) != 0 or AudioMoods::defined(&triggers.moods, 1) or AudioMoods::defined(&triggers.moods, 2)
    0

# `music <cue> <fade_out_ms>` without the fade-in and newline.
def music_fields(source: mutable SoundEventAssets::Source&, id: u64, fade_out: u64) -> void:
    put(source, 109)
    put(source, 117)
    put(source, 115)
    put(source, 105)
    put(source, 99)
    field(source, id)
    field(source, fade_out)

def music(source: mutable SoundEventAssets::Source&, id: u64, fade_out: u64, fade_in: u64) -> void:
    music_fields(source, id, fade_out)
    field(source, fade_in)
    newline(source)

def cue_is(cues: AudioMusic::Cues&, id: u64, fade_out: u64, fade_in: u64) -> bool:
    value: AudioMusic::Cue = AudioMusic::get(cues, id)
    value.defined and value.fade_out_ms == fade_out and value.fade_in_ms == fade_in

# Music records set cue fades by id; a cue left out fades in the default time.
def music_test() -> i32:
    bound: mutable SoundEventAssets::Source = course_asset()
    music(&bound, 0, 800, 300)
    music(&bound, 1, 1500, 2000)
    board: mutable AudioEvents::Board = AudioEvents::Board()
    triggers: mutable SoundEventAssets::Triggers = SoundEventAssets::Triggers()
    return 70 if load_triggers(&board, &triggers, &bound) != 0 or SoundEventAssets::failing_line(&bound) != 0
    return 71 if not cue_is(&triggers.cues, 0, 800, 300) or not cue_is(&triggers.cues, 1, 1500, 2000)
    unset: AudioMusic::Cue = AudioMusic::get(&triggers.cues, 2)
    return 72 if unset.defined or unset.fade_in_ms != AudioMusic::DEFAULT_FADE_MS or AudioMusic::defined(&triggers.cues, 9)

    beyond: mutable SoundEventAssets::Source = course_asset()
    music(&beyond, 4, 800, 300)
    return 73 if trigger_status(&beyond) != 15
    slow: mutable SoundEventAssets::Source = course_asset()
    music(&slow, 1, 800, 10001)
    return 74 if trigger_status(&slow) != 15

    twice: mutable SoundEventAssets::Source = course_asset()
    music(&twice, 1, 800, 300)
    music(&twice, 1, 900, 300)
    return 75 if trigger_status(&twice) != 16 or SoundEventAssets::failing_line(&twice) != 7

    short: mutable SoundEventAssets::Source = course_asset()
    music_fields(&short, 1, 800)
    newline(&short)
    return 76 if trigger_status(&short) != 3

    # A rejected asset keeps the cues; a plain one clears them.
    return 77 if load_triggers(&board, &triggers, &twice) != 16 or not cue_is(&triggers.cues, 1, 1500, 2000)
    plain: SoundEventAssets::Source = course_asset()
    fresh: mutable AudioEvents::Board = AudioEvents::Board()
    return 78 if load_triggers(&fresh, &triggers, &plain) != 0 or AudioMusic::defined(&triggers.cues, 0) or AudioMusic::defined(&triggers.cues, 1)
    0

def main() -> i32:
    accepted: i32 = accepted_test()
    return accepted if accepted != 0
    rejected: i32 = rejected_test()
    return rejected if rejected != 0
    atomic: i32 = atomic_test()
    return atomic if atomic != 0
    triggered: i32 = trigger_test()
    return triggered if triggered != 0
    moods: i32 = mood_test()
    return moods if moods != 0
    music_test()
