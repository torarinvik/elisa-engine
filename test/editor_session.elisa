include "../src/tooling/editor_session.elisa"
using EditorSession

def main() -> i32:
    session: mutable Session = Session()
    return 1 if not session_valid(&session) or active_panel(&session) != Panel.Inspector
    panel_assets: i32 = catch select_panel(&session, Panel.Assets):
        ok: 0
        SessionError.InvalidSession: 1
        error failure: 2
    return 12 if panel_assets != 0 or active_panel(&session) != Panel.Assets
    panel_inspector: i32 = catch select_panel(&session, Panel.Inspector):
        ok: 0
        SessionError.InvalidSession: 1
        error failure: 2
    return 13 if panel_inspector != 0 or active_panel(&session) != Panel.Inspector
    field: InspectorView::Field = InspectorView::Field{target: 1, kind: InspectorView::FieldKind.Number, value: 1, minimum: 0, maximum: 10, editable: true}
    field_added: i32 = catch InspectorView::add_field(&session.inspector, field):
        ok: 0
        InspectorView::FieldError.Capacity: 1
        InspectorView::FieldError.InvalidField: 2
        InspectorView::FieldError.DuplicateTarget: 3
        error failure: 4
    return 2 if field_added != 0
    edited: i32 = catch edit_field(&session, 1, 5):
        ok: 0
        SessionError.FieldUnknown: 1
        SessionError.FieldInvalid: 2
        SessionError.FieldRange: 3
        error failure: 4
    return 3 if edited != 0 or revision(&session) != 1
    undone: i32 = catch undo_edit(&session):
        ok: 0
        SessionError.HistoryEmpty: 1
        SessionError.FieldUnknown: 2
        SessionError.FieldInvalid: 3
        SessionError.FieldRange: 4
        SessionError.HistoryApply: 5
        error failure: 6
    return 4 if undone != 0 or InspectorView::field_at(&session.inspector, 0).value != 1 or revision(&session) != 2
    redone: i32 = catch redo_edit(&session):
        ok: 0
        SessionError.HistoryEmpty: 1
        SessionError.FieldUnknown: 2
        SessionError.FieldInvalid: 3
        SessionError.FieldRange: 4
        SessionError.HistoryApply: 5
        error failure: 6
    return 5 if redone != 0 or InspectorView::field_at(&session.inspector, 0).value != 5 or revision(&session) != 3
    id: Assets::AssetId = Assets::AssetId{high: 4, low: 5}
    added: i32 = catch add_asset(&session, id, 0):
        ok: 0
        SessionError.AssetCapacity: 1
        SessionError.AssetInvalid: 2
        SessionError.AssetDuplicate: 3
        SessionError.AssetUnknown: 4
        error failure: 5
    return 6 if added != 0
    return 7 if revision(&session) != 4 or not dirty(&session)
    return 14 if selected_asset(&session) != 0
    selected: i32 = catch select_asset(&session, 0):
        ok: 0
        SessionError.AssetUnknown: 1
        error failure: 2
    return 15 if selected != 0 or selected_asset(&session) != 0
    return 16 if not asset_is_stale(&session, id, 0)
    loaded: i32 = catch mark_asset_loaded(&session, id, 0):
        ok: 0
        SessionError.AssetUnknown: 1
        SessionError.AssetInvalid: 2
        error failure: 3
    return 17 if loaded != 0 or asset_is_stale(&session, id, 0)
    invalid_generation: i32 = catch mark_asset_loaded(&session, id, -1):
        ok: 0
        SessionError.AssetUnknown: 1
        SessionError.AssetInvalid: 2
        error failure: 3
    return 18 if invalid_generation != 2
    removed: i32 = catch remove_asset(&session, id):
        ok: 0
        SessionError.AssetUnknown: 1
        error failure: 2
    return 19 if removed != 0 or AssetBrowser::browser_count(&session.assets) != 0 or selected_asset(&session) != 8 or not asset_is_stale(&session, id, 0)
    widget: UiWidgets::Widget = UiWidgets::Widget{id: 9, kind: UiWidgets::WidgetKind.Button, x: 0, y: 0, width: 8, height: 8, value: 0, minimum: 0, maximum: 0, enabled: true, visible: true}
    attached: i32 = catch attach_widget(&session, widget):
        ok: 0
        SessionError.WidgetCapacity: 1
        SessionError.WidgetInvalid: 2
        SessionError.WidgetDuplicate: 3
        error failure: 4
    return 8 if attached != 0
    return 9 if revision(&session) != 7
    return 10 if not dirty(&session)
    return 11 if not session_valid(&session)
    0
