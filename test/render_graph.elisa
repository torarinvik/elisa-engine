include "../src/backend/render_graph.elisa"

def texture(id: u32, lifetime: RenderGraph::Lifetime,
        initialized: bool) -> RenderGraph::ResourceDescriptor:
    RenderGraph::ResourceDescriptor{
        id: id,
        size_mode: RenderGraph::SizeMode.Fixed,
        width: 320,
        height: 200,
        format: RenderGraph::Format.Rgba16Float,
        samples: 1,
        lifetime: lifetime,
        initialized: initialized,
        import_source: RenderGraph::ImportSource.SceneColor if lifetime == RenderGraph::Lifetime.Imported else RenderGraph::ImportSource.None,
    }

def access_and_descriptor_tests() -> i32:
    graph: mutable RenderGraph::Graph = RenderGraph::Graph()
    _ = catch RenderGraph::add_resource(&graph, texture(1,
        RenderGraph::Lifetime.Imported, true)):
        ok: 0
        error failure: return 61
    _ = catch RenderGraph::add_pass(&graph, 10):
        ok: 0
        error failure: return 62
    _ = catch RenderGraph::read(&graph, 10, 1):
        ok: 0
        error failure: return 63
    imported_read_access: bool = catch RenderGraph::access(graph, 10, 1):
        RenderGraph::ResourceAccess.Read: true
        error failure: false
    return 64 if not imported_read_access
    return 70 if RenderGraph::access_if_known(graph, 10, 1) != RenderGraph::ResourceAccess.Read
    return 71 if RenderGraph::access_if_known(graph, 999, 1) != RenderGraph::ResourceAccess.None
    fixed_descriptor: mutable RenderGraph::ResourceDescriptor = zeroed
    return 65 if not RenderGraph::resource_descriptor_at(graph, 0, &fixed_descriptor)
    return 65 if fixed_descriptor.size_mode != RenderGraph::SizeMode.Fixed
    missing_descriptor: bool = RenderGraph::resource_descriptor_at(graph,
        RenderGraph::resource_count(graph), &fixed_descriptor)
    return 66 if missing_descriptor
    internal_color: RenderGraph::ResourceDescriptor = texture(2,
        RenderGraph::Lifetime.Imported, true)
    internal_color.size_mode <- RenderGraph::SizeMode.PrimaryInternal
    internal_color.width <- 0
    internal_color.height <- 0
    return 67 if not RenderGraph::resource_descriptor_valid(internal_color)
    internal_color.width <- 320
    return 68 if RenderGraph::resource_descriptor_valid(internal_color)
    linear_depth: mutable RenderGraph::ResourceDescriptor = texture(4,
        RenderGraph::Lifetime.Imported, true)
    linear_depth.format <- RenderGraph::Format.R32Float
    linear_depth.import_source <- RenderGraph::ImportSource.LinearDepth
    return 72 if not RenderGraph::resource_descriptor_valid(linear_depth)
    linear_depth.import_source <- RenderGraph::ImportSource.SceneColor
    return 73 if RenderGraph::resource_descriptor_valid(linear_depth)
    linear_depth.import_source <- RenderGraph::ImportSource.LinearDepth
    linear_depth.lifetime <- RenderGraph::Lifetime.Transient
    return 74 if RenderGraph::resource_descriptor_valid(linear_depth)
    fixed_descriptor.width <- 0
    return 69 if RenderGraph::resource_descriptor_valid(fixed_descriptor)
    0

def main() -> i32:
    graph: mutable RenderGraph::Graph = RenderGraph::Graph()
    _ = catch RenderGraph::add_resource(&graph, texture(1,
        RenderGraph::Lifetime.Imported, true)):
        ok: 0
        error failure: return 1
    _ = catch RenderGraph::add_resource(&graph, texture(2,
        RenderGraph::Lifetime.Transient, false)):
        ok: 0
        error failure: return 2
    _ = catch RenderGraph::add_resource(&graph, texture(3,
        RenderGraph::Lifetime.Transient, false)):
        ok: 0
        error failure: return 3
    _ = catch RenderGraph::add_pass(&graph, 10):
        ok: 0
        error failure: return 4
    _ = catch RenderGraph::add_pass(&graph, 20):
        ok: 0
        error failure: return 5
    _ = catch RenderGraph::add_pass(&graph, 30):
        ok: 0
        error failure: return 6
    _ = catch RenderGraph::add_pass(&graph, 40):
        ok: 0
        error failure: return 7
    _ = catch RenderGraph::read(&graph, 10, 1):
        ok: 0
        error failure: return 8
    _ = catch RenderGraph::write(&graph, 10, 2):
        ok: 0
        error failure: return 9
    _ = catch RenderGraph::read(&graph, 20, 2):
        ok: 0
        error failure: return 10
    _ = catch RenderGraph::write(&graph, 30, 3):
        ok: 0
        error failure: return 11
    _ = catch RenderGraph::read(&graph, 40, 3):
        ok: 0
        error failure: return 12
    _ = catch RenderGraph::add_dependency(&graph, 10, 20):
        ok: 0
        error failure: return 13
    _ = catch RenderGraph::add_dependency(&graph, 20, 30):
        ok: 0
        error failure: return 14
    _ = catch RenderGraph::add_dependency(&graph, 30, 40):
        ok: 0
        error failure: return 15
    plan: RenderGraph::Plan = catch RenderGraph::compile(&graph):
        value: value
        error failure: return 16
    return 72 if not RenderGraph::plan_matches_graph(graph, plan)
    forged_plan: mutable RenderGraph::Plan = plan
    forged_plan.pass_ids[0] <- 30
    return 73 if RenderGraph::plan_matches_graph(graph, forged_plan)
    return 17 if plan.pass_count != 4 or plan.resource_count != 3
    return 18 if plan.pass_ids[0] != 10 or plan.pass_ids[1] != 20 or plan.pass_ids[2] != 30 or plan.pass_ids[3] != 40
    return 60 if plan.resource_ids[0] != 1 or plan.resource_ids[1] != 2 or plan.resource_ids[2] != 3
    return 19 if plan.first_use[1] != 0 or plan.last_use[1] != 1 or plan.first_use[2] != 2 or plan.last_use[2] != 3
    return 20 if plan.alias_slots[1] != plan.alias_slots[2] or plan.transient_slot_count != 1 or plan.alias_slots[0] != RenderGraph::NO_TRANSIENT_ALIAS_SLOT
    extra_test_status: i32 = access_and_descriptor_tests()
    return extra_test_status if extra_test_status != 0

    duplicate_rejected: bool = catch RenderGraph::add_resource(&graph, texture(1,
        RenderGraph::Lifetime.Imported, true)):
        ok: false
        error failure: true
    return 22 if not duplicate_rejected
    duplicate_pass_rejected: bool = catch RenderGraph::add_pass(&graph, 10):
        ok: false
        error failure: true
    return 23 if not duplicate_pass_rejected
    duplicate_access_rejected: bool = catch RenderGraph::read(&graph, 10, 1):
        ok: false
        error failure: true
    return 24 if not duplicate_access_rejected

    cycle: mutable RenderGraph::Graph = RenderGraph::Graph()
    _ = catch RenderGraph::add_resource(&cycle, texture(1,
        RenderGraph::Lifetime.Imported, true)):
        ok: 0
        error failure: return 25
    _ = catch RenderGraph::add_pass(&cycle, 10):
        ok: 0
        error failure: return 26
    _ = catch RenderGraph::add_pass(&cycle, 20):
        ok: 0
        error failure: return 27
    _ = catch RenderGraph::read(&cycle, 10, 1):
        ok: 0
        error failure: return 28
    _ = catch RenderGraph::add_dependency(&cycle, 10, 20):
        ok: 0
        error failure: return 29
    _ = catch RenderGraph::add_dependency(&cycle, 20, 10):
        ok: 0
        error failure: return 30
    cycle_rejected: bool = catch RenderGraph::compile(&cycle):
        value: false
        error failure: true
    return 31 if not cycle_rejected

    read_before_write: mutable RenderGraph::Graph = RenderGraph::Graph()
    _ = catch RenderGraph::add_resource(&read_before_write, texture(2,
        RenderGraph::Lifetime.Transient, false)):
        ok: 0
        error failure: return 32
    _ = catch RenderGraph::add_pass(&read_before_write, 10):
        ok: 0
        error failure: return 33
    _ = catch RenderGraph::add_pass(&read_before_write, 20):
        ok: 0
        error failure: return 34
    _ = catch RenderGraph::read(&read_before_write, 10, 2):
        ok: 0
        error failure: return 35
    _ = catch RenderGraph::write(&read_before_write, 20, 2):
        ok: 0
        error failure: return 36
    _ = catch RenderGraph::add_dependency(&read_before_write, 10, 20):
        ok: 0
        error failure: return 37
    read_rejected: bool = catch RenderGraph::compile(&read_before_write):
        value: false
        error failure: true
    return 38 if not read_rejected

    readwrite: mutable RenderGraph::Graph = RenderGraph::Graph()
    _ = catch RenderGraph::add_resource(&readwrite, texture(1,
        RenderGraph::Lifetime.Persistent, true)):
        ok: 0
        error failure: return 38
    _ = catch RenderGraph::add_pass(&readwrite, 10):
        ok: 0
        error failure: return 39
    _ = catch RenderGraph::read(&readwrite, 10, 1):
        ok: 0
        error failure: return 40
    _ = catch RenderGraph::write(&readwrite, 10, 1):
        ok: 0
        error failure: return 41
    hazard_rejected: bool = catch RenderGraph::compile(&readwrite):
        value: false
        error failure: true
    return 43 if not hazard_rejected

    writers: mutable RenderGraph::Graph = RenderGraph::Graph()
    _ = catch RenderGraph::add_resource(&writers, texture(2,
        RenderGraph::Lifetime.Transient, false)):
        ok: 0
        error failure: return 43
    _ = catch RenderGraph::add_pass(&writers, 10):
        ok: 0
        error failure: return 44
    _ = catch RenderGraph::add_pass(&writers, 20):
        ok: 0
        error failure: return 45
    _ = catch RenderGraph::write(&writers, 10, 2):
        ok: 0
        error failure: return 46
    _ = catch RenderGraph::write(&writers, 20, 2):
        ok: 0
        error failure: return 47
    writers_rejected: bool = catch RenderGraph::compile(&writers):
        value: false
        error failure: true
    return 49 if not writers_rejected

    ordered_writers: mutable RenderGraph::Graph = RenderGraph::Graph()
    _ = catch RenderGraph::add_resource(&ordered_writers, texture(2,
        RenderGraph::Lifetime.Transient, false)):
        ok: 0
        error failure: return 50
    _ = catch RenderGraph::add_pass(&ordered_writers, 10):
        ok: 0
        error failure: return 51
    _ = catch RenderGraph::add_pass(&ordered_writers, 20):
        ok: 0
        error failure: return 52
    _ = catch RenderGraph::write(&ordered_writers, 10, 2):
        ok: 0
        error failure: return 53
    _ = catch RenderGraph::write(&ordered_writers, 20, 2):
        ok: 0
        error failure: return 54
    _ = catch RenderGraph::add_dependency(&ordered_writers, 10, 20):
        ok: 0
        error failure: return 55
    ordered_plan: RenderGraph::Plan = catch RenderGraph::compile(&ordered_writers):
        value: value
        error failure: return 56
    return 57 if ordered_plan.first_use[0] != 0 or ordered_plan.last_use[0] != 1

    capacity: mutable RenderGraph::Graph = RenderGraph::Graph()
    for index in 0..<RenderGraph::MAX_PASSES:
        _ = catch RenderGraph::add_pass(&capacity, index.u32() + 1):
            ok: 0
            error failure: return 58
    capacity_rejected: bool = catch RenderGraph::add_pass(&capacity,
        RenderGraph::MAX_PASSES.u32() + 1):
        ok: false
        error failure: true
    return 59 if not capacity_rejected
    0
