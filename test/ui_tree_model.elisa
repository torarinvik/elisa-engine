include "../src/ui/tree_model.elisa"

def main() -> i32:
    t: mutable UiTreeModel::Tree = UiTreeModel::new_tree()
    t <- UiTreeModel::add(t, 1, -1)
    t <- UiTreeModel::add(t, 2, 1)
    t <- UiTreeModel::add(t, 3, 2)
    t <- UiTreeModel::add(t, 4, 1)
    t <- UiTreeModel::add(t, 9, -1)
    return 1 if t.count != 5 or UiTreeModel::visible_count(&t) != 5
    # Unknown parents and duplicate ids are refused.
    return 2 if UiTreeModel::add(t, 5, 77).count != 5 or UiTreeModel::add(t, 3, -1).count != 5
    t <- UiTreeModel::focus(t, 3)
    return 3 if t.focus != 3
    # Collapsing the root hides its subtree and moves focus up to it.
    t <- UiTreeModel::set_open(t, 1, false)
    return 4 if UiTreeModel::visible_count(&t) != 2 or t.focus != 1
    # Hidden nodes cannot take focus.
    return 5 if UiTreeModel::focus(t, 4).focus != 1
    # Expanding again shows the subtree; focus stays where it was.
    t <- UiTreeModel::set_open(t, 1, true)
    return 6 if UiTreeModel::visible_count(&t) != 5 or t.focus != 1
    # Collapsing a middle node hides only its children.
    t <- UiTreeModel::focus(t, 3)
    t <- UiTreeModel::set_open(t, 2, false)
    return 7 if UiTreeModel::visible_count(&t) != 4 or t.focus != 2
    # Collapsing an unrelated branch leaves focus alone.
    t <- UiTreeModel::set_open(t, 9, false)
    return 8 if t.focus != 2
    # Removing a subtree drops its descendants and repairs focus to the parent.
    t <- UiTreeModel::set_open(t, 2, true)
    t <- UiTreeModel::focus(t, 3)
    t <- UiTreeModel::remove(t, 2)
    return 9 if t.count != 3 or UiTreeModel::index_of(&t, 3) >= 0 or t.focus != 1
    # Survivors keep their parents after compaction.
    return 10 if t.parent[UiTreeModel::index_of(&t, 4)] != UiTreeModel::index_of(&t, 1)
    # Removing a root that holds focus moves focus to the first remaining root;
    # removing an unrelated node leaves focus alone.
    t <- UiTreeModel::remove(t, 1)
    return 11 if t.count != 1 or t.focus != 9
    t <- UiTreeModel::add(t, 5, -1)
    t <- UiTreeModel::remove(t, 5)
    return 12 if t.focus != 9 or UiTreeModel::remove(t, 77).count != 1
    t <- UiTreeModel::remove(t, 9)
    return 13 if t.count != 0 or t.focus != -1
    return 0
