include "../src/runtime/public.elisa"

const TEST_MOUSE_LEFT: i64 = 1

def application_event(kind: Application::InputEventKind, code: i64, value: f32,
    pressed: bool, released: bool, connected: bool) -> Application::InputEvent:
    Application::InputEvent{
        kind: kind,
        device: 0,
        code: code,
        value: value,
        pressed: pressed,
        released: released,
        chord_down: false,
        connected: connected,
    }

def application_input_tests() -> i32:
    input: mutable ActionInput::Input = ActionInput::Input()
    key_a: i64 = Application::keyboard_key_code(Application::KeyboardKeyCode.A)
    left_shift: i64 = Application::keyboard_key_code(Application::KeyboardKeyCode.LeftShift)
    chord: ActionInput::Binding = ActionInput::Binding{
        action: 90,
        device: ActionInput::Device.Keyboard,
        code: key_a,
        chord_code: left_shift,
        deadzone: 0.0,
        context: ActionInput::Context.Gameplay,
        live: true,
    }
    return 65 if ActionInput::bind_checked(&input, chord) != ActionInput::BindResult.Bound
    ActionInputRuntime::apply_application_event(&input,
        application_event(Application::InputEventKind.Key, key_a, 1.0, true, false, false))
    return 66 if ActionInput::action_down(&input, 90)
    ActionInputRuntime::apply_application_event(&input,
        application_event(Application::InputEventKind.Key, left_shift, 1.0, true, false, false))
    return 67 if not ActionInput::action_down(&input, 90) or not ActionInput::action_pressed(&input, 90)

    ActionInput::begin_frame(&input)
    ActionInputRuntime::apply_application_event(&input,
        application_event(Application::InputEventKind.Key, left_shift, 0.0, false, true, false))
    return 68 if ActionInput::action_down(&input, 90) or not ActionInput::action_released(&input, 90)
    ActionInputRuntime::apply_application_event(&input,
        application_event(Application::InputEventKind.Key, key_a, 0.0, false, true, false))
    ActionInput::begin_frame(&input)
    ActionInputRuntime::apply_application_event(&input,
        application_event(Application::InputEventKind.Key, left_shift, 1.0, true, false, false))
    ActionInputRuntime::apply_application_event(&input,
        application_event(Application::InputEventKind.Key, key_a, 1.0, true, false, false))
    return 69 if not ActionInput::action_down(&input, 90) or not ActionInput::action_pressed(&input, 90)

    ActionInput::begin_frame(&input)
    ActionInputRuntime::apply_application_event(&input,
        application_event(Application::InputEventKind.FocusLost, 0, 0.0, false, true, false))
    return 70 if ActionInput::action_down(&input, 90) or not ActionInput::action_released(&input, 90)

    tick_input: mutable ActionInput::Input = ActionInput::Input()
    movement_binding: ActionInput::Binding = test_binding(96, key_a, 0.0)
    ui_binding: ActionInput::Binding = test_binding(97, key_a, 0.0)
    ui_binding.context <- ActionInput::Context.UI
    return 90 if ActionInput::bind_checked(&tick_input, movement_binding) != ActionInput::BindResult.Bound
    return 91 if ActionInput::bind_checked(&tick_input, ui_binding) != ActionInput::BindResult.Bound
    ActionInputRuntime::apply_application_event(&tick_input,
        application_event(Application::InputEventKind.Key, key_a, 1.0, true, false, false))
    # A render frame without a fixed tick must leave the edge pending.
    return 92 if not ActionInput::action_pressed(&tick_input, 96)
    # Catch-up ticks see a one-shot edge once, while held movement survives.
    return 93 if not ActionInput::action_pressed(&tick_input, 96)
    ActionInput::begin_frame(&tick_input)
    return 94 if ActionInput::action_pressed(&tick_input, 96) or not ActionInput::action_down(&tick_input, 96)
    ActionInput::begin_frame(&tick_input)
    return 95 if ActionInput::action_pressed(&tick_input, 96) or not ActionInput::action_down(&tick_input, 96)

    context_input: mutable ActionInput::Input = ActionInput::Input()
    return 96 if ActionInput::bind_checked(&context_input, movement_binding) != ActionInput::BindResult.Bound
    return 97 if ActionInput::bind_checked(&context_input, ui_binding) != ActionInput::BindResult.Bound
    ActionInputRuntime::apply_application_event(&context_input,
        application_event(Application::InputEventKind.Key, key_a, 1.0, true, false, false))
    return 98 if not ActionInput::action_pressed(&context_input, 96)
    ActionInput::set_context(&context_input, ActionInput::Context.UI)
    return 99 if ActionInput::action_down(&context_input, 96) or ActionInput::action_pressed(&context_input, 96) or ActionInput::action_released(&context_input, 96)
    return 100 if ActionInput::action_down(&context_input, 97) or ActionInput::action_pressed(&context_input, 97)

    overflow_input: mutable ActionInput::Input = ActionInput::Input()
    plain_key: ActionInput::Binding = test_binding(95, key_a, 0.0)
    return 85 if ActionInput::bind_checked(&overflow_input, plain_key) != ActionInput::BindResult.Bound
    ActionInputRuntime::apply_application_event(&overflow_input,
        application_event(Application::InputEventKind.Key, key_a, 1.0, true, false, false))
    ActionInput::begin_frame(&overflow_input)
    ActionInputRuntime::apply_application_event(&overflow_input,
        application_event(Application::InputEventKind.Overflow, 0, 0.0, false, true, false))
    return 86 if ActionInput::action_down(&overflow_input, 95) or not ActionInput::action_released(&overflow_input, 95)

    mouse: ActionInput::Binding = ActionInput::Binding{
        action: 91,
        device: ActionInput::Device.Mouse,
        code: TEST_MOUSE_LEFT,
        chord_code: 0,
        deadzone: 0.0,
        context: ActionInput::Context.Gameplay,
        live: true,
    }
    return 71 if ActionInput::bind_checked(&input, mouse) != ActionInput::BindResult.Bound
    ActionInputRuntime::apply_application_event(&input,
        application_event(Application::InputEventKind.MouseButton, TEST_MOUSE_LEFT, 1.0, true, false, false))
    return 72 if not ActionInput::action_down(&input, 91)

    gamepad: ActionInput::Binding = ActionInput::Binding{
        action: 92,
        device: ActionInput::Device.Gamepad,
        code: Application::gamepad_button_code(Application::GamepadButtonCode.South),
        chord_code: 0,
        deadzone: 0.0,
        context: ActionInput::Context.Gameplay,
        live: true,
    }
    return 73 if ActionInput::bind_checked(&input, gamepad) != ActionInput::BindResult.Bound
    ActionInputRuntime::apply_application_event(&input,
        application_event(Application::InputEventKind.GamepadConnected, 0, 1.0, true, false, true))
    ActionInputRuntime::apply_application_event(&input,
        application_event(Application::InputEventKind.GamepadButton, gamepad.code, 1.0, true, false, false))
    return 74 if not ActionInput::action_down(&input, 92)
    ActionInputRuntime::apply_application_event(&input,
        application_event(Application::InputEventKind.GamepadDisconnected, 0, 0.0, false, true, false))
    return 75 if ActionInput::action_down(&input, 92) or not ActionInput::action_released(&input, 92)

    ActionInputRuntime::apply_application_event(&input,
        application_event(Application::InputEventKind.GamepadConnected, 0, 1.0, true, false, true))
    ActionInputRuntime::apply_application_event(&input,
        application_event(Application::InputEventKind.GamepadButton, gamepad.code, 1.0, true, false, false))
    ActionInput::begin_frame(&input)
    ActionInputRuntime::apply_application_event(&input,
        application_event(Application::InputEventKind.GamepadDisconnected, 0, 0.0, false, true, true))
    return 88 if ActionInput::action_down(&input, 92) or not ActionInput::action_released(&input, 92)
    ActionInput::begin_frame(&input)
    ActionInputRuntime::apply_application_event(&input,
        application_event(Application::InputEventKind.GamepadButton, gamepad.code, 1.0, true, false, false))
    return 89 if not ActionInput::action_down(&input, 92) or not ActionInput::action_pressed(&input, 92)

    trigger_code: i64 = Application::gamepad_axis_code(Application::GamepadAxisCode.LeftTrigger)
    trigger: ActionInput::Binding = ActionInput::Binding{
        action: 94,
        device: ActionInput::Device.Gamepad,
        code: trigger_code,
        chord_code: 0,
        deadzone: 0.2,
        context: ActionInput::Context.Gameplay,
        live: true,
    }
    return 82 if ActionInput::bind_checked(&input, trigger) != ActionInput::BindResult.Bound
    ActionInputRuntime::apply_application_event(&input,
        application_event(Application::InputEventKind.GamepadConnected, 0, 1.0, true, false, true))
    ActionInputRuntime::apply_application_event(&input,
        application_event(Application::InputEventKind.GamepadAxis, trigger_code, 0.6, true, false, false))
    return 83 if not ActionInput::action_down(&input, 94) or ActionInput::action_value(&input, 94) < 0.59
    ActionInput::begin_frame(&input)
    ActionInputRuntime::apply_application_event(&input,
        application_event(Application::InputEventKind.GamepadAxis, trigger_code, 0.1, true, false, false))
    return 84 if ActionInput::action_down(&input, 94) or not ActionInput::action_released(&input, 94)

    multiple_chords: mutable ActionInput::Input = ActionInput::Input()
    shift_binding: ActionInput::Binding = chord
    shift_binding.action <- 93
    east_code: i64 = Application::keyboard_key_code(Application::KeyboardKeyCode.E)
    east_binding: ActionInput::Binding = shift_binding
    east_binding.chord_code <- east_code
    return 78 if ActionInput::bind_checked(&multiple_chords, shift_binding) != ActionInput::BindResult.Bound
    return 79 if ActionInput::bind_checked(&multiple_chords, east_binding) != ActionInput::BindResult.Bound
    ActionInputRuntime::apply_application_event(&multiple_chords,
        application_event(Application::InputEventKind.Key, key_a, 1.0, true, false, false))
    ActionInputRuntime::apply_application_event(&multiple_chords,
        application_event(Application::InputEventKind.Key, left_shift, 1.0, true, false, false))
    ActionInputRuntime::apply_application_event(&multiple_chords,
        application_event(Application::InputEventKind.Key, east_code, 1.0, true, false, false))
    ActionInput::begin_frame(&multiple_chords)
    ActionInputRuntime::apply_application_event(&multiple_chords,
        application_event(Application::InputEventKind.Key, left_shift, 0.0, false, true, false))
    return 80 if not ActionInput::action_down(&multiple_chords, 93) or ActionInput::action_released(&multiple_chords, 93)
    ActionInput::begin_frame(&multiple_chords)
    ActionInputRuntime::apply_application_event(&multiple_chords,
        application_event(Application::InputEventKind.Key, east_code, 0.0, false, true, false))
    return 81 if ActionInput::action_down(&multiple_chords, 93) or not ActionInput::action_released(&multiple_chords, 93)
    0

def test_binding(action: i64, code: i64, deadzone: f32) -> ActionInput::Binding:
    ActionInput::Binding{action: action, device: ActionInput::Device.Keyboard, code: code, chord_code: 0, deadzone: deadzone, context: ActionInput::Context.Gameplay, live: true}

def checked_binding_tests() -> i32:
    invalid_input: mutable ActionInput::Input = ActionInput::Input()
    return 40 if ActionInput::bind_checked(&invalid_input, test_binding(0, 1, 0.0)) != ActionInput::BindResult.InvalidAction
    return 41 if ActionInput::bind_checked(&invalid_input, test_binding(1, 0, 0.0)) != ActionInput::BindResult.InvalidCode
    return 42 if ActionInput::bind_checked(&invalid_input, test_binding(1, 1, 1.0)) != ActionInput::BindResult.InvalidDeadzone
    invalid_chord: ActionInput::Binding = ActionInput::Binding{
        action: 1, device: ActionInput::Device.Keyboard, code: 1, chord_code: -1,
        deadzone: 0.0, context: ActionInput::Context.Gameplay, live: true,
    }
    return 76 if ActionInput::bind_checked(&invalid_input, invalid_chord) != ActionInput::BindResult.InvalidCode
    same_key_chord: ActionInput::Binding = ActionInput::Binding{
        action: 1, device: ActionInput::Device.Keyboard, code: 1, chord_code: 1,
        deadzone: 0.0, context: ActionInput::Context.Gameplay, live: true,
    }
    return 77 if ActionInput::bind_checked(&invalid_input, same_key_chord) != ActionInput::BindResult.InvalidCode

    checked_input: mutable ActionInput::Input = ActionInput::Input()
    first: ActionInput::Binding = test_binding(1, 10, 0.0)
    return 43 if ActionInput::bind_checked(&checked_input, first) != ActionInput::BindResult.Bound
    ActionInput::apply(&checked_input, ActionInput::Event{device: ActionInput::Device.Keyboard, code: 10, value: 1.0, pressed: true, released: false, chord_down: false})
    return 44 if not ActionInput::action_down(&checked_input, 1) or not ActionInput::action_pressed(&checked_input, 1)
    return 45 if ActionInput::bind_checked(&checked_input, test_binding(1, 11, 0.0)) != ActionInput::BindResult.Bound
    return 46 if not ActionInput::action_down(&checked_input, 1) or not ActionInput::action_pressed(&checked_input, 1)
    return 47 if ActionInput::bind_checked(&checked_input, first) != ActionInput::BindResult.DuplicateBinding

    typed_input: mutable ActionInput::Input = ActionInput::Input()
    typed_action: i32 = catch ActionInput::bind(&typed_input, test_binding(0, 1, 0.0)):
        ok: 1
        ActionInput::InputError.InvalidAction: 0
        error failure: 2
    return 48 if typed_action != 0
    typed_code: i32 = catch ActionInput::bind(&typed_input, test_binding(1, 0, 0.0)):
        ok: 1
        ActionInput::InputError.InvalidCode: 0
        error failure: 2
    return 49 if typed_code != 0
    typed_deadzone: i32 = catch ActionInput::bind(&typed_input, test_binding(1, 1, 1.0)):
        ok: 1
        ActionInput::InputError.InvalidDeadzone: 0
        error failure: 2
    return 50 if typed_deadzone != 0
    _ = ActionInput::bind_checked(&typed_input, first)
    typed_duplicate: i32 = catch ActionInput::bind(&typed_input, first):
        ok: 1
        ActionInput::InputError.DuplicateBinding: 0
        error failure: 2
    return 51 if typed_duplicate != 0

    full_bindings: mutable ActionInput::Input = ActionInput::Input()
    for code in 0..<48 |full_bindings|:
        result: ActionInput::BindResult = ActionInput::bind_checked(&full_bindings, test_binding(1, 100 + code.i64(), 0.0))
        return 52 if result != ActionInput::BindResult.Bound
    return 53 if ActionInput::bind_checked(&full_bindings, test_binding(1, 148, 0.0)) != ActionInput::BindResult.Capacity
    typed_capacity: i32 = catch ActionInput::bind(&full_bindings, test_binding(1, 148, 0.0)):
        ok: 1
        ActionInput::InputError.Capacity: 0
        error failure: 2
    return 54 if typed_capacity != 0

    # Game clients can separate keyboard presets, gameplay, and menu actions
    # without exhausting distinct action state slots.
    full_actions: mutable ActionInput::Input = ActionInput::Input()
    for action in 0..<32 |full_actions|:
        result: ActionInput::BindResult = ActionInput::bind_checked(&full_actions, test_binding(1 + action.i64(), 1 + action.i64(), 0.0))
        return 55 if result != ActionInput::BindResult.Bound
    for attempt in 0..<16 |full_actions|:
        result: ActionInput::BindResult = ActionInput::bind_checked(&full_actions, test_binding(33 + attempt.i64(), 100 + attempt.i64(), 0.0))
        return 56 if result != ActionInput::BindResult.Capacity
    for code in 32..<48 |full_actions|:
        result: ActionInput::BindResult = ActionInput::bind_checked(&full_actions, test_binding(1, 100 + code.i64(), 0.0))
        return 57 if result != ActionInput::BindResult.Bound
    return 58 if ActionInput::bind_checked(&full_actions, test_binding(1, 200, 0.0)) != ActionInput::BindResult.Capacity
    0

def main() -> i32:
    checked: i32 = checked_binding_tests()
    return checked if checked != 0
    application_tests: i32 = application_input_tests()
    return application_tests if application_tests != 0
    return 59 if Application::keyboard_key_code(Application::KeyboardKeyCode.A) != 2001
    return 60 if Application::keyboard_key_code(Application::KeyboardKeyCode.ArrowDown) != 2016
    return 65 if Application::keyboard_key_code(Application::KeyboardKeyCode.V) != 2017
    return 61 if Application::gamepad_button_code(Application::GamepadButtonCode.South) != 1001
    return 62 if Application::gamepad_button_code(Application::GamepadButtonCode.DpadLeft) != 1014
    return 63 if Application::gamepad_axis_code(Application::GamepadAxisCode.LeftXNegative) != 1101
    return 64 if Application::gamepad_axis_code(Application::GamepadAxisCode.RightTrigger) != 1110
    input: mutable ActionInput::Input = ActionInput::Input()
    _ = catch ActionInput::bind(&input, ActionInput::Binding{action: 1, device: ActionInput::Device.Gamepad, code: 10, chord_code: 0, deadzone: 0.2, context: ActionInput::Context.Gameplay, live: true}):
        ok: 0
        error failure: return 1
    ActionInput::begin_frame(&input)
    ActionInput::apply(&input, ActionInput::Event{device: ActionInput::Device.Gamepad, code: 10, value: 0.1, pressed: true, released: false, chord_down: false})
    return 2 if ActionInput::action_down(&input, 1) or ActionInput::action_value(&input, 1) != 0.0
    ActionInput::apply(&input, ActionInput::Event{device: ActionInput::Device.Gamepad, code: 10, value: 0.8, pressed: true, released: false, chord_down: false})
    return 3 if not ActionInput::action_down(&input, 1) or not ActionInput::action_pressed(&input, 1) or ActionInput::action_value(&input, 1) < 0.79
    ActionInput::begin_frame(&input)
    ActionInput::apply(&input, ActionInput::Event{device: ActionInput::Device.Gamepad, code: 10, value: 0.0, pressed: false, released: true, chord_down: false})
    return 4 if not ActionInput::action_released(&input, 1) or ActionInput::action_down(&input, 1)
    axis_input: mutable ActionInput::Input = ActionInput::Input()
    _ = catch ActionInput::bind(&axis_input, ActionInput::Binding{action: 1, device: ActionInput::Device.Gamepad, code: 11, chord_code: 0, deadzone: 0.2, context: ActionInput::Context.Gameplay, live: true}):
        ok: 0
        error failure: return 31
    ActionInput::apply(&axis_input, ActionInput::Event{device: ActionInput::Device.Gamepad, code: 11, value: 0.7, pressed: true, released: false, chord_down: false})
    return 32 if not ActionInput::action_down(&axis_input, 1)
    ActionInput::begin_frame(&axis_input)
    ActionInput::apply(&axis_input, ActionInput::Event{device: ActionInput::Device.Gamepad, code: 11, value: 0.1, pressed: true, released: false, chord_down: false})
    return 33 if ActionInput::action_down(&axis_input, 1) or not ActionInput::action_released(&axis_input, 1) or ActionInput::action_value(&axis_input, 1) != 0.0
    _ = catch ActionInput::bind(&input, ActionInput::Binding{action: 3, device: ActionInput::Device.Gamepad, code: 30, chord_code: 0, deadzone: 0.0, context: ActionInput::Context.Gameplay, live: true}):
        ok: 0
        error failure: return 9
    _ = catch ActionInput::bind(&input, ActionInput::Binding{action: 3, device: ActionInput::Device.Gamepad, code: 31, chord_code: 0, deadzone: 0.0, context: ActionInput::Context.Gameplay, live: true}):
        ok: 0
        error failure: return 10
    ActionInput::begin_frame(&input)
    ActionInput::apply(&input, ActionInput::Event{device: ActionInput::Device.Gamepad, code: 30, value: 0.5, pressed: true, released: false, chord_down: false})
    return 11 if not ActionInput::action_down(&input, 3) or not ActionInput::action_pressed(&input, 3)
    ActionInput::begin_frame(&input)
    return 12 if ActionInput::action_value(&input, 3) < 0.49
    ActionInput::apply(&input, ActionInput::Event{device: ActionInput::Device.Gamepad, code: 31, value: 0.9, pressed: true, released: false, chord_down: false})
    return 13 if not ActionInput::action_down(&input, 3) or ActionInput::action_pressed(&input, 3) or ActionInput::action_value(&input, 3) < 0.89
    ActionInput::apply(&input, ActionInput::Event{device: ActionInput::Device.Gamepad, code: 30, value: 0.0, pressed: false, released: true, chord_down: false})
    return 14 if not ActionInput::action_down(&input, 3) or ActionInput::action_released(&input, 3) or ActionInput::action_value(&input, 3) < 0.89
    ActionInput::begin_frame(&input)
    ActionInput::apply(&input, ActionInput::Event{device: ActionInput::Device.Gamepad, code: 31, value: 0.0, pressed: false, released: true, chord_down: false})
    return 15 if ActionInput::action_down(&input, 3) or not ActionInput::action_released(&input, 3) or ActionInput::action_value(&input, 3) != 0.0
    _ = catch ActionInput::bind(&input, ActionInput::Binding{action: 4, device: ActionInput::Device.Gamepad, code: 40, chord_code: 0, deadzone: 0.0, context: ActionInput::Context.Gameplay, live: true}):
        ok: 0
        error failure: return 16
    _ = catch ActionInput::bind(&input, ActionInput::Binding{action: 4, device: ActionInput::Device.Gamepad, code: 41, chord_code: 0, deadzone: 0.0, context: ActionInput::Context.Gameplay, live: true}):
        ok: 0
        error failure: return 17
    ActionInput::begin_frame(&input)
    ActionInput::apply(&input, ActionInput::Event{device: ActionInput::Device.Gamepad, code: 41, value: 0.7, pressed: true, released: false, chord_down: false})
    ActionInput::apply(&input, ActionInput::Event{device: ActionInput::Device.Gamepad, code: 40, value: 0.4, pressed: true, released: false, chord_down: false})
    ActionInput::apply(&input, ActionInput::Event{device: ActionInput::Device.Gamepad, code: 41, value: 0.0, pressed: false, released: true, chord_down: false})
    return 18 if not ActionInput::action_down(&input, 4) or ActionInput::action_released(&input, 4) or ActionInput::action_value(&input, 4) < 0.39
    ActionInput::begin_frame(&input)
    ActionInput::apply(&input, ActionInput::Event{device: ActionInput::Device.Gamepad, code: 40, value: 0.0, pressed: false, released: true, chord_down: false})
    return 19 if ActionInput::action_down(&input, 4) or not ActionInput::action_released(&input, 4) or ActionInput::action_value(&input, 4) != 0.0
    _ = catch ActionInput::bind(&input, ActionInput::Binding{action: 5, device: ActionInput::Device.Gamepad, code: 50, chord_code: 0, deadzone: 0.0, context: ActionInput::Context.Gameplay, live: true}):
        ok: 0
        error failure: return 20
    _ = catch ActionInput::bind(&input, ActionInput::Binding{action: 5, device: ActionInput::Device.Keyboard, code: 51, chord_code: 0, deadzone: 0.0, context: ActionInput::Context.Gameplay, live: true}):
        ok: 0
        error failure: return 21
    ActionInput::apply(&input, ActionInput::Event{device: ActionInput::Device.Gamepad, code: 50, value: 0.6, pressed: true, released: false, chord_down: false})
    ActionInput::apply(&input, ActionInput::Event{device: ActionInput::Device.Keyboard, code: 51, value: 1.0, pressed: true, released: false, chord_down: false})
    ActionInput::set_connected(&input, ActionInput::Device.Gamepad, false)
    return 22 if not ActionInput::action_down(&input, 5) or ActionInput::action_released(&input, 5) or ActionInput::action_value(&input, 5) < 0.99
    ActionInput::set_connected(&input, ActionInput::Device.Keyboard, false)
    return 23 if ActionInput::action_down(&input, 5) or not ActionInput::action_released(&input, 5)
    ActionInput::set_connected(&input, ActionInput::Device.Keyboard, true)
    ActionInput::apply(&input, ActionInput::Event{device: ActionInput::Device.Keyboard, code: 51, value: 1.0, pressed: true, released: false, chord_down: false})
    return 24 if not ActionInput::action_down(&input, 5)
    ActionInput::clear_device_state(&input, ActionInput::Device.Keyboard)
    return 25 if ActionInput::action_down(&input, 5) or not ActionInput::action_released(&input, 5)
    ActionInput::apply(&input, ActionInput::Event{device: ActionInput::Device.Keyboard, code: 51, value: 1.0, pressed: true, released: false, chord_down: false})
    return 26 if not ActionInput::action_down(&input, 5)
    # Register and exercise eight distinct actions on one input. This is the
    # binding/state-slot capacity required by common gameplay key maps.
    _ = catch ActionInput::bind(&input, ActionInput::Binding{action: 6, device: ActionInput::Device.Keyboard, code: 60, chord_code: 0, deadzone: 0.0, context: ActionInput::Context.Gameplay, live: true}):
        ok: 0
        error failure: return 27
    _ = catch ActionInput::bind(&input, ActionInput::Binding{action: 7, device: ActionInput::Device.Keyboard, code: 70, chord_code: 0, deadzone: 0.0, context: ActionInput::Context.Gameplay, live: true}):
        ok: 0
        error failure: return 28
    _ = catch ActionInput::bind(&input, ActionInput::Binding{action: 8, device: ActionInput::Device.Keyboard, code: 80, chord_code: 0, deadzone: 0.0, context: ActionInput::Context.Gameplay, live: true}):
        ok: 0
        error failure: return 29
    ActionInput::set_context(&input, ActionInput::Context.Gameplay)
    ActionInput::apply(&input, ActionInput::Event{device: ActionInput::Device.Keyboard, code: 60, value: 1.0, pressed: true, released: false, chord_down: false})
    ActionInput::apply(&input, ActionInput::Event{device: ActionInput::Device.Keyboard, code: 70, value: 1.0, pressed: true, released: false, chord_down: false})
    ActionInput::apply(&input, ActionInput::Event{device: ActionInput::Device.Keyboard, code: 80, value: 1.0, pressed: true, released: false, chord_down: false})
    return 30 if not ActionInput::action_down(&input, 6) or not ActionInput::action_down(&input, 7) or not ActionInput::action_down(&input, 8)
    _ = catch ActionInput::bind(&input, ActionInput::Binding{action: 2, device: ActionInput::Device.Keyboard, code: 20, chord_code: 21, deadzone: 0.0, context: ActionInput::Context.UI, live: true}):
        ok: 0
        error failure: return 5
    ActionInput::set_context(&input, ActionInput::Context.UI)
    ActionInput::apply(&input, ActionInput::Event{device: ActionInput::Device.Keyboard, code: 20, value: 1.0, pressed: true, released: false, chord_down: false})
    return 6 if ActionInput::action_down(&input, 2)
    ActionInput::apply(&input, ActionInput::Event{device: ActionInput::Device.Keyboard, code: 20, value: 1.0, pressed: true, released: false, chord_down: true})
    return 7 if not ActionInput::action_down(&input, 2)
    ActionInput::set_connected(&input, ActionInput::Device.Keyboard, false)
    return 8 if not ActionInput::action_released(&input, 2)
    0
