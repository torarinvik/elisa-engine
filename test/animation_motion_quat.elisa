include "../src/animation/motion_quat.elisa"

def close(a: f64, b: f64) -> bool:
    d: f64 = a - b
    d < 0.000000001 and d > -0.000000001

# Equal as rotations: q and -q are the same.
def same(a: MotionQuat::Q, b: MotionQuat::Q) -> bool:
    d: f64 = MotionQuat::dot(a, b)
    close(d, 1.0) or close(d, -1.0)

def same_v(a: MotionQuat::V, b: MotionQuat::V) -> bool:
    close(a.x, b.x) and close(a.y, b.y) and close(a.z, b.z)

def main() -> i32:
    x: MotionQuat::V = MotionQuat::V{x: 1.0, y: 0.0, z: 0.0}
    z: MotionQuat::V = MotionQuat::V{x: 0.0, y: 0.0, z: 1.0}
    a: MotionQuat::Q = MotionQuat::identity()
    b: MotionQuat::Q = MotionQuat::axis_angle(z, 1.5707963267948966)
    return 1 if not same(MotionQuat::slerp(a, b, 0.0), a) or not same(MotionQuat::slerp(a, b, 1.0), b)
    return 2 if not same(MotionQuat::slerp(a, b, 0.5), MotionQuat::axis_angle(z, 0.7853981633974483))
    # The negated end is the same rotation, so the path must be the short one.
    nb: MotionQuat::Q = MotionQuat::Q{x: -b.x, y: -b.y, z: -b.z, w: -b.w}
    return 3 if not same(MotionQuat::slerp(a, nb, 0.25), MotionQuat::axis_angle(z, 0.39269908169872414))
    # Swing/twist recomposes and the swing carries no turn about the axis.
    q: MotionQuat::Q = MotionQuat::mul(MotionQuat::axis_angle(z, 0.3), MotionQuat::axis_angle(x, 0.7))
    split: MotionQuat::SwingTwist = MotionQuat::swing_twist(q, x)
    return 4 if not same(MotionQuat::mul(split.swing, split.twist), q)
    return 5 if not close(split.swing.x, 0.0)
    return 6 if not close(MotionQuat::hinge_angle(q, x), 0.7)
    return 7 if not close(MotionQuat::hinge_angle(MotionQuat::axis_angle(x, -2.0), x), -2.0)
    return 8 if not close(MotionQuat::hinge_angle(MotionQuat::axis_angle(x, 3.0), x), 3.0)
    # Aim maps local +Y onto the world direction and the local hinge onto
    # the world hinge after both are made perpendicular.
    y_world: MotionQuat::V = MotionQuat::vnormalize(MotionQuat::V{x: 0.3, y: -0.9, z: 0.2})
    hinge_world: MotionQuat::V = MotionQuat::V{x: 1.0, y: 0.1, z: 0.0}
    r: MotionQuat::Q = MotionQuat::aim(y_world, hinge_world, MotionQuat::V{x: 1.0, y: 0.4, z: 0.0})
    return 9 if not same_v(MotionQuat::rotate(r, MotionQuat::V{x: 0.0, y: 1.0, z: 0.0}), y_world)
    h: f64 = MotionQuat::vdot(hinge_world, y_world)
    expected: MotionQuat::V = MotionQuat::vnormalize(MotionQuat::V{x: hinge_world.x - y_world.x * h, y: hinge_world.y - y_world.y * h, z: hinge_world.z - y_world.z * h})
    return 10 if not same_v(MotionQuat::rotate(r, x), expected)
    # f32 round trip for the runtime pose.
    back: MotionQuat::Q = MotionQuat::from_geometry(MotionQuat::to_geometry(b))
    return 11 if MotionQuat::dot(back, b) < 0.999999
    # NaN and zero lengths take the fallback; a `<=` guard would divide by NaN.
    zero: f64 = 0.0
    nan: f64 = zero / zero
    return 12 if nan == nan
    nq: MotionQuat::Q = MotionQuat::normalize(MotionQuat::Q{x: nan, y: 0.0, z: 0.0, w: 1.0})
    return 13 if not (nq.x == 0.0 and nq.y == 0.0 and nq.z == 0.0 and nq.w == 1.0)
    zq: MotionQuat::Q = MotionQuat::normalize(MotionQuat::Q{x: 0.0, y: 0.0, z: 0.0, w: 0.0})
    return 14 if not (zq.w == 1.0 and zq.x == 0.0)
    nv: MotionQuat::V = MotionQuat::vnormalize(MotionQuat::V{x: 1.0, y: nan, z: 0.0})
    return 15 if not (nv.x == 0.0 and nv.y == 0.0 and nv.z == 0.0)
    ns: MotionQuat::Q = MotionQuat::slerp(a, MotionQuat::Q{x: nan, y: nan, z: nan, w: nan}, 0.5)
    return 16 if not (ns.w == 1.0 and ns.x == 0.0)
    return 17 if MotionQuatGuard::unit(1.0, nan) != 0.0 or MotionQuatGuard::unit(1.0, -2.0) != 0.0 or MotionQuatGuard::unit(3.0, 2.0) != 1.5
    return 18 if MotionQuatGuard::divides(nan) or MotionQuatGuard::divides(0.0) or not MotionQuatGuard::divides(1.0)
    # Shortest arc maps one direction onto another, including opposites.
    src_dir: MotionQuat::V = MotionQuat::vnormalize(MotionQuat::V{x: 0.2, y: 1.0, z: -0.4})
    dst_dir: MotionQuat::V = MotionQuat::vnormalize(MotionQuat::V{x: -0.7, y: 0.1, z: 0.5})
    return 19 if not same_v(MotionQuat::rotate(MotionQuat::between(src_dir, dst_dir), src_dir), dst_dir)
    flipped: MotionQuat::V = MotionQuat::V{x: -src_dir.x, y: -src_dir.y, z: -src_dir.z}
    return 20 if not same_v(MotionQuat::rotate(MotionQuat::between(src_dir, flipped), src_dir), flipped)
    return 21 if not same(MotionQuat::between(src_dir, src_dir), MotionQuat::identity())
    return 22 if not close(MotionQuat::angle(MotionQuat::axis_angle(z, 0.9)), 0.9)
    return 23 if not close(MotionQuat::angle(nb), 1.5707963267948966)
    return 0
