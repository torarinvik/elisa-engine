# Verifies oriented body-pose and inertia contracts against live Jolt bodies.
include "../src/runtime/services.elisa"

module PhysicsInertiaProbe:
    private:
        const module Tune:
            MASS: f32 = 3.0
            FIXED_STEP_SECONDS: f32 = 1.0 / 60.0
            REQUESTED_MOMENT_X: f32 = 2.0
            REQUESTED_MOMENT_Y: f32 = 4.0
            REQUESTED_MOMENT_Z: f32 = 8.0
            EXPECTED_MOMENT_X: f32 = 8.0
            EXPECTED_MOMENT_Y: f32 = 4.0
            EXPECTED_MOMENT_Z: f32 = 2.0
            PRINCIPAL_ROTATION_Z: f32 = 0.70710678118
            MOMENT_TOLERANCE: f32 = 0.0001
            DEFAULT_COLLISION_LAYER: u32 = 0
            COM_OFFSET_Y: f32 = 0.25
            EXPECTED_CUBE_INERTIA_TRACE: f32 = 0.625
            INERTIA_TRACE_TOLERANCE: f32 = 0.01

        def close(left: f32, right: f32) -> bool:
            difference: f32 = left - right
            difference >= -Tune::MOMENT_TOLERANCE and difference <= Tune::MOMENT_TOLERANCE

        def close_with_tolerance(left: f32, right: f32,
            tolerance: f32) -> bool:
            difference: f32 = left - right
            difference >= -tolerance and difference <= tolerance

        def rotation_matches(left: Geometry::Quat, right: Geometry::Quat) -> bool:
            dot: f32 = left.x * right.x + left.y * right.y + left.z * right.z + left.w * right.w
            close(dot, 1.0) or close(dot, -1.0)

        def invalid_inertia_rejected() -> bool:
            identity: Geometry::Quat = Geometry::quat_identity()
            catch PhysicsRuntime::BodyInertia(Geometry::Vec3{x: 0.0, y: 1.0, z: 1.0}, identity):
                value: false
                PhysicsRuntime::PhysicsError.InvalidArgument: true
                error failure: false

        def invalid_inertia_rotation_rejected() -> bool:
            catch PhysicsRuntime::BodyInertia(Geometry::Vec3{x: 1.0, y: 1.0, z: 1.0},
                Geometry::Quat{x: 0.0, y: 0.0, z: 0.0, w: 0.0}):
                value: false
                PhysicsRuntime::PhysicsError.InvalidArgument: true
                error failure: false

        def inertia_tensor_apply(inertia: PhysicsRuntime::BodyInertia,
            vector: Geometry::Vec3) -> Geometry::Vec3:
            moments: Geometry::Vec3 = PhysicsRuntime::body_inertia_principal_moments(inertia)
            rotation: Geometry::Quat = PhysicsRuntime::body_inertia_principal_rotation(inertia)
            principal_vector: Geometry::Vec3 = Geometry::quat_rotate(
                Geometry::quat_conjugate(rotation), vector)
            weighted_vector: Geometry::Vec3 = Geometry::Vec3{
                x: principal_vector.x * moments.x,
                y: principal_vector.y * moments.y,
                z: principal_vector.z * moments.z,
            }
            Geometry::quat_rotate(rotation, weighted_vector)

        def same_inertia_tensor(left: PhysicsRuntime::BodyInertia,
            right: PhysicsRuntime::BodyInertia) -> bool:
            x_axis: Geometry::Vec3 = Geometry::Vec3{x: 1.0, y: 0.0, z: 0.0}
            y_axis: Geometry::Vec3 = Geometry::Vec3{x: 0.0, y: 1.0, z: 0.0}
            z_axis: Geometry::Vec3 = Geometry::Vec3{x: 0.0, y: 0.0, z: 1.0}
            close(inertia_tensor_apply(left, x_axis).x, inertia_tensor_apply(right, x_axis).x) and close(inertia_tensor_apply(left, x_axis).y, inertia_tensor_apply(right, x_axis).y) and close(inertia_tensor_apply(left, x_axis).z, inertia_tensor_apply(right, x_axis).z) and close(inertia_tensor_apply(left, y_axis).x, inertia_tensor_apply(right, y_axis).x) and close(inertia_tensor_apply(left, y_axis).y, inertia_tensor_apply(right, y_axis).y) and close(inertia_tensor_apply(left, y_axis).z, inertia_tensor_apply(right, y_axis).z) and close(inertia_tensor_apply(left, z_axis).x, inertia_tensor_apply(right, z_axis).x) and close(inertia_tensor_apply(left, z_axis).y, inertia_tensor_apply(right, z_axis).y) and close(inertia_tensor_apply(left, z_axis).z, inertia_tensor_apply(right, z_axis).z)

        def inertia_trace(inertia: PhysicsRuntime::BodyInertia) -> f32:
            moments: Geometry::Vec3 = PhysicsRuntime::body_inertia_principal_moments(inertia)
            moments.x + moments.y + moments.z

    public:
        def run(session: mutable RuntimeServices::Session&) -> i32:
            body_rotation: Geometry::Quat = Geometry::Quat{
                x: 0.0, y: 0.0, z: Tune::PRINCIPAL_ROTATION_Z,
                w: Tune::PRINCIPAL_ROTATION_Z}
            body: PhysicsRuntime::BodyHandle = catch RuntimeServices::physics_body_create(
                session, PhysicsRuntime::BodyDesc{
                    kind: PhysicsRuntime::BodyKind.Dynamic,
                    shape: PhysicsRuntime::BodyShape.Box,
                    position: Geometry::Vec3{x: 0.0, y: 10.0, z: 0.0},
                    rotation: body_rotation,
                    dimensions: Geometry::Vec3{x: 0.5, y: 0.75, z: 1.0},
                    mass: Tune::MASS,
                    sensor: false,
                    collision_layer: Tune::DEFAULT_COLLISION_LAYER,
                    center_of_mass_offset: Geometry::vec3_zero(),
                }):
                value: value
                error failure: return 1
            offset_body: PhysicsRuntime::BodyHandle = catch RuntimeServices::physics_body_create(
                session, PhysicsRuntime::BodyDesc{
                    kind: PhysicsRuntime::BodyKind.Dynamic,
                    shape: PhysicsRuntime::BodyShape.Box,
                    position: Geometry::Vec3{x: 20.0, y: 10.0, z: 0.0},
                    rotation: Geometry::quat_identity(),
                    center_of_mass_offset: Geometry::Vec3{x: 0.0, y: -Tune::COM_OFFSET_Y, z: 0.0},
                    dimensions: Geometry::Vec3{x: 0.5, y: 0.5, z: 0.5},
                    mass: 1.0,
                    sensor: false,
                    collision_layer: Tune::DEFAULT_COLLISION_LAYER,
                }):
                value: value
                error failure: return 17
            offset_initial_pose: PhysicsRuntime::BodyPose = catch RuntimeServices::physics_body_pose(
                session, offset_body):
                value: value
                error failure: return 18
            return 19 if not PhysicsInertiaProbe::close(offset_initial_pose.position.x, 20.0) or not PhysicsInertiaProbe::close(offset_initial_pose.position.y, 10.0)
            initial_pose: PhysicsRuntime::BodyPose = catch RuntimeServices::physics_body_pose(
                session, body):
                value: value
                error failure: return 13
            return 14 if not PhysicsInertiaProbe::rotation_matches(
                initial_pose.rotation, body_rotation)
            inertia: PhysicsRuntime::BodyInertia = catch PhysicsRuntime::BodyInertia(
                Geometry::Vec3{x: Tune::REQUESTED_MOMENT_X,
                    y: Tune::REQUESTED_MOMENT_Y, z: Tune::REQUESTED_MOMENT_Z},
                Geometry::Quat{x: 0.0, y: 0.0, z: Tune::PRINCIPAL_ROTATION_Z,
                    w: Tune::PRINCIPAL_ROTATION_Z}):
                value: value
                error failure: return 2
            return 3 if not PhysicsInertiaProbe::invalid_inertia_rejected()
            return 11 if not PhysicsInertiaProbe::invalid_inertia_rotation_rejected()
            configured: bool = catch RuntimeServices::physics_body_set_inertia(
                session, body, inertia):
                ok: true
                error failure: false
            return 4 if not configured
            not_ready: bool = catch RuntimeServices::physics_body_inertia(session, body):
                value: false
                PhysicsRuntime::PhysicsError.BodyNotReady: true
                error failure: false
            return 5 if not not_ready
            stepped: bool = catch RuntimeServices::physics_fixed_step(session,
                Tune::FIXED_STEP_SECONDS):
                value: true
                error failure: false
            return 6 if not stepped
            stepped_pose: PhysicsRuntime::BodyPose = catch RuntimeServices::physics_body_pose(
                session, body):
                value: value
                error failure: return 15
            return 16 if not PhysicsInertiaProbe::rotation_matches(
                stepped_pose.rotation, body_rotation)
            moments: PhysicsRuntime::BodyInertia = catch RuntimeServices::physics_body_inertia(
                session, body):
                value: value
                error failure: return 7
            readback: Geometry::Vec3 = PhysicsRuntime::body_inertia_principal_moments(moments)
            return 8 if not PhysicsInertiaProbe::close(readback.x, Tune::EXPECTED_MOMENT_X) or not PhysicsInertiaProbe::close(readback.y, Tune::EXPECTED_MOMENT_Y) or not PhysicsInertiaProbe::close(readback.z, Tune::EXPECTED_MOMENT_Z)
            return 12 if not PhysicsInertiaProbe::same_inertia_tensor(inertia, moments)
            offset_inertia: PhysicsRuntime::BodyInertia = catch RuntimeServices::physics_body_inertia(
                session, offset_body):
                value: value
                error failure: return 20
            return 21 if not PhysicsInertiaProbe::close_with_tolerance(
                PhysicsInertiaProbe::inertia_trace(offset_inertia),
                Tune::EXPECTED_CUBE_INERTIA_TRACE, Tune::INERTIA_TRACE_TOLERANCE)
            late_update: bool = catch RuntimeServices::physics_body_set_inertia(
                session, body, inertia):
                ok: false
                PhysicsRuntime::PhysicsError.ConfigurationLocked: true
                error failure: false
            return 9 if not late_update
            destroyed: bool = catch RuntimeServices::physics_body_destroy(session, body):
                ok: true
                error failure: false
            return 10 if not destroyed
            offset_destroyed: bool = catch RuntimeServices::physics_body_destroy(session,
                offset_body):
                ok: true
                error failure: false
            return 22 if not offset_destroyed
            0
