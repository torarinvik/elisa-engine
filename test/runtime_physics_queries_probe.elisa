# Session-routed physics query and contact polling smoke.
module RuntimePhysicsQueriesProbe:
    private:
        def verify_filtered_shape_services(session: RuntimeServices::Session&,
            filter: PhysicsRuntime::PhysicsQueryFilter, expect_hit: bool) -> i32:
            sphere_cast_hit: PhysicsQueries::ShapeHit = catch RuntimeServices::physics_sphere_cast_filtered(session,
                Geometry::Vec3{x: 500.0, y: 3.0, z: 0.0},
                Geometry::Vec3{x: 0.0, y: -1.0, z: 0.0}, 5.0, 0.25,
                PhysicsRuntime::ALL_LAYERS, filter):
                value: value
                error failure: return 31
            return 1 if sphere_cast_hit.hit != expect_hit
            return 2 if expect_hit and sphere_cast_hit.entity == 0

            capsule_cast_hit: PhysicsQueries::ShapeHit = catch RuntimeServices::physics_capsule_cast_filtered(session,
                Geometry::Vec3{x: 500.0, y: 3.0, z: 0.0},
                Geometry::Vec3{x: 500.0, y: 4.0, z: 0.0},
                Geometry::Vec3{x: 0.0, y: -1.0, z: 0.0}, 5.0, 0.25,
                PhysicsRuntime::ALL_LAYERS, filter):
                value: value
                error failure: return 32
            return 3 if capsule_cast_hit.hit != expect_hit
            return 4 if expect_hit and capsule_cast_hit.entity == 0

            sphere_overlap_hit: PhysicsQueries::ShapeHit = catch RuntimeServices::physics_overlap_sphere_filtered(session,
                Geometry::Vec3{x: 500.0, y: 0.0, z: 0.0}, 0.75,
                PhysicsRuntime::ALL_LAYERS, filter):
                value: value
                error failure: return 33
            return 5 if sphere_overlap_hit.hit != expect_hit
            return 6 if expect_hit and sphere_overlap_hit.entity == 0

            sphere_overlaps: mutable PhysicsQueries::ShapeHitBuffer = PhysicsQueries::ShapeHitBuffer()
            sphere_overlap_count: usize = catch RuntimeServices::physics_overlap_sphere_all_filtered(session,
                Geometry::Vec3{x: 500.0, y: 0.0, z: 0.0}, 0.75,
                PhysicsRuntime::ALL_LAYERS, filter, &sphere_overlaps):
                value: value
                error failure: return 34
            return 7 if sphere_overlaps.count != sphere_overlap_count
            if expect_hit:
                return 8 if sphere_overlap_count == 0
            else:
                return 8 if sphere_overlap_count != 0

            capsule_overlap_hit: PhysicsQueries::ShapeHit = catch RuntimeServices::physics_overlap_capsule_filtered(session,
                Geometry::Vec3{x: 500.0, y: -1.0, z: 0.0},
                Geometry::Vec3{x: 500.0, y: 1.0, z: 0.0}, 0.5,
                PhysicsRuntime::ALL_LAYERS, filter):
                value: value
                error failure: return 35
            return 9 if capsule_overlap_hit.hit != expect_hit
            return 10 if expect_hit and capsule_overlap_hit.entity == 0

            capsule_overlaps: mutable PhysicsQueries::ShapeHitBuffer = PhysicsQueries::ShapeHitBuffer()
            capsule_overlap_count: usize = catch RuntimeServices::physics_overlap_capsule_all_filtered(session,
                Geometry::Vec3{x: 500.0, y: -1.0, z: 0.0},
                Geometry::Vec3{x: 500.0, y: 1.0, z: 0.0}, 0.5,
                PhysicsRuntime::ALL_LAYERS, filter, &capsule_overlaps):
                value: value
                error failure: return 36
            return 11 if capsule_overlaps.count != capsule_overlap_count
            if expect_hit:
                return 12 if capsule_overlap_count == 0
            else:
                return 12 if capsule_overlap_count != 0
            0

    public:
        def run(session: RuntimeServices::Session&) -> i32:
            query_body: PhysicsRuntime::BodyHandle = catch RuntimeServices::physics_body_create(session,
                PhysicsRuntime::BodyDesc{
                    kind: PhysicsRuntime::BodyKind.Static,
                    shape: PhysicsRuntime::BodyShape.Box,
                    position: Geometry::Vec3{x: 500.0, y: 0.0, z: 0.0},
                    rotation: Geometry::quat_identity(),
                    center_of_mass_offset: Geometry::vec3_zero(),
                    dimensions: Geometry::Vec3{x: 0.5, y: 0.5, z: 0.5},
                    mass: 0.0,
                    sensor: false,
                    collision_layer: 0,
                }):
                value: value
                error failure: return 132
            query_body_tick: u64 = catch RuntimeServices::physics_fixed_step(session,
                Runtime::fixed_step_seconds()):
                value: value
                error failure: return 139
            physics_only: PhysicsRuntime::PhysicsQueryFilter = PhysicsRuntime::PhysicsQueryFilter{
                scene_objects: false,
                scene_colliders: false,
                physics_bodies: true,
            }
            filtered_hits: mutable PhysicsRuntime::RayHitBuffer = PhysicsRuntime::RayHitBuffer()
            filtered_count: usize = catch RuntimeServices::physics_raycast_all_filtered(session,
                Geometry::Vec3{x: 500.0, y: 3.0, z: 0.0},
                Geometry::Vec3{x: 0.0, y: -1.0, z: 0.0}, 5.0,
                PhysicsRuntime::ALL_LAYERS, physics_only, &filtered_hits):
                value: value
                error failure: return 133
            return 134 + filtered_count.i32() if filtered_count != 1
            return 138 if filtered_hits.hits[0].entity == 0
            shape_filter_status: i32 = RuntimePhysicsQueriesProbe::verify_filtered_shape_services(
                session, physics_only, true)
            return 140 + shape_filter_status if shape_filter_status != 0
            no_targets: PhysicsRuntime::PhysicsQueryFilter = PhysicsRuntime::PhysicsQueryFilter{
                scene_objects: false,
                scene_colliders: false,
                physics_bodies: false,
            }
            empty_filtered_hits: mutable PhysicsRuntime::RayHitBuffer = PhysicsRuntime::RayHitBuffer()
            empty_filtered_count: usize = catch RuntimeServices::physics_raycast_all_filtered(session,
                Geometry::Vec3{x: 500.0, y: 3.0, z: 0.0},
                Geometry::Vec3{x: 0.0, y: -1.0, z: 0.0}, 5.0,
                PhysicsRuntime::ALL_LAYERS, no_targets, &empty_filtered_hits):
                value: value
                error failure: return 135
            return 136 if empty_filtered_count != 0 or empty_filtered_hits.count != 0
            empty_shape_filter_status: i32 = RuntimePhysicsQueriesProbe::verify_filtered_shape_services(
                session, no_targets, false)
            return 160 + empty_shape_filter_status if empty_shape_filter_status != 0
            query_body_destroyed: i32 = catch RuntimeServices::physics_body_destroy(session, query_body):
                ok: 0
                error failure: 1
            return 137 if query_body_destroyed != 0
            query_hit: PhysicsRuntime::RayHit = catch RuntimeServices::physics_raycast(session,
                Geometry::Vec3{x: 100.0, y: 100.0, z: 100.0},
                Geometry::Vec3{x: 0.0, y: -1.0, z: 0.0}, 1.0,
                PhysicsRuntime::ALL_LAYERS):
                value: value
                error failure: return 121
            return 121 if query_hit.hit or query_hit.entity != 0
            query_hits: mutable PhysicsRuntime::RayHitBuffer = PhysicsRuntime::RayHitBuffer()
            query_hit_count: usize = catch RuntimeServices::physics_raycast_all(session,
                Geometry::Vec3{x: 100.0, y: 100.0, z: 100.0},
                Geometry::Vec3{x: 0.0, y: -1.0, z: 0.0}, 1.0,
                PhysicsRuntime::ALL_LAYERS, &query_hits):
                value: 0
                error failure: return 124
            return 125 if query_hit_count != 0 or query_hits.count != 0
            shape_cast: PhysicsQueries::ShapeHit = catch RuntimeServices::physics_sphere_cast(session,
                Geometry::Vec3{x: 100.0, y: 100.0, z: 100.0},
                Geometry::Vec3{x: 0.0, y: -1.0, z: 0.0}, 1.0, 0.25,
                PhysicsRuntime::ALL_LAYERS):
                value: value
                error failure: return 126
            return 126 if shape_cast.hit or shape_cast.entity != 0
            capsule_cast: PhysicsQueries::ShapeHit = catch RuntimeServices::physics_capsule_cast(session,
                Geometry::Vec3{x: 100.0, y: 100.0, z: 100.0},
                Geometry::Vec3{x: 100.0, y: 101.0, z: 100.0},
                Geometry::Vec3{x: 0.0, y: -1.0, z: 0.0}, 1.0, 0.25,
                PhysicsRuntime::ALL_LAYERS):
                value: value
                error failure: return 127
            return 127 if capsule_cast.hit or capsule_cast.entity != 0
            sphere_overlap: PhysicsQueries::ShapeHit = catch RuntimeServices::physics_overlap_sphere(session,
                Geometry::Vec3{x: 100.0, y: 100.0, z: 100.0}, 0.25,
                PhysicsRuntime::ALL_LAYERS):
                value: value
                error failure: return 128
            return 128 if sphere_overlap.hit or sphere_overlap.entity != 0
            sphere_overlaps: mutable PhysicsQueries::ShapeHitBuffer = PhysicsQueries::ShapeHitBuffer()
            sphere_overlap_count: usize = catch RuntimeServices::physics_overlap_sphere_all(session,
                Geometry::Vec3{x: 100.0, y: 100.0, z: 100.0}, 0.25,
                PhysicsRuntime::ALL_LAYERS, sphere_overlaps):
                value: 0
                error failure: return 129
            return 129 if sphere_overlap_count != 0 or sphere_overlaps.count != 0
            capsule_overlap: PhysicsQueries::ShapeHit = catch RuntimeServices::physics_overlap_capsule(session,
                Geometry::Vec3{x: 100.0, y: 100.0, z: 100.0},
                Geometry::Vec3{x: 100.0, y: 101.0, z: 100.0}, 0.25,
                PhysicsRuntime::ALL_LAYERS):
                value: value
                error failure: return 130
            return 130 if capsule_overlap.hit or capsule_overlap.entity != 0
            capsule_overlaps: mutable PhysicsQueries::ShapeHitBuffer = PhysicsQueries::ShapeHitBuffer()
            capsule_overlap_count: usize = catch RuntimeServices::physics_overlap_capsule_all(session,
                Geometry::Vec3{x: 100.0, y: 100.0, z: 100.0},
                Geometry::Vec3{x: 100.0, y: 101.0, z: 100.0}, 0.25,
                PhysicsRuntime::ALL_LAYERS, capsule_overlaps):
                value: 0
                error failure: return 131
            return 131 if capsule_overlap_count != 0 or capsule_overlaps.count != 0
            query_contacts: mutable PhysicsRuntime::ContactBuffer = PhysicsRuntime::ContactBuffer()
            query_dropped: mutable u32 = 0
            query_count: usize = catch RuntimeServices::physics_poll_contacts(session,
                &query_contacts, &query_dropped):
                value: 0
                error failure: return 122
            return 123 if query_count > PhysicsRuntime::MAX_CONTACT_EVENTS or query_dropped != 0
            0
