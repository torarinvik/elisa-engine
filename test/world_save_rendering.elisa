include "../src/world/world_save.elisa"
include "../src/runtime/world_save_rendering.elisa"

def visual(mesh: u64) -> Assets::VisualAsset:
    Assets::VisualAsset{
        mesh: Assets::AssetId{high: 7, low: mesh},
        material: Assets::AssetId{high: 7, low: 90},
        local_bounds: Geometry::Bounds3{
            minimum: Geometry::Vec3{x: -1.0, y: -1.0, z: -1.0},
            maximum: Geometry::Vec3{x: 1.0, y: 1.0, z: 1.0},
        },
    }

def near(a: f32, b: f32) -> bool:
    d: f32 = a - b
    d < 0.001 and d > -0.001

def rehydrate_code(bindings: mutable WorldRendering::Bindings&, world: World::World&,
    visuals: WorldSaveRendering::KindVisuals, base: i64) -> i32:
    catch WorldSaveRendering::rehydrate(bindings, world, visuals, base):
        ok: 0
        error failure: 1

def extract_code(world: World::World&, bindings: mutable WorldRendering::Bindings&,
    snapshot: mutable RenderSnapshot::Snapshot&) -> i32:
    catch WorldRendering::extract(world, bindings, snapshot):
        ok: 0
        error failure: 1

def main() -> i32 can[Global.Read, Global.Write]:
    world: mutable World::World = catch World::World():
        value: value
        error failure: return 1
    player: World::EntityRef = catch World::world_spawn(&world, World::Actor.Player):
        value: value
        error failure: return 2
    guard: World::EntityRef = catch World::world_spawn(&world, World::Enemy.Guard):
        value: value
        error failure: return 2
    crate: World::EntityRef = catch World::world_spawn(&world, World::StaticObject.Structure):
        value: value
        error failure: return 2
    identity: Geometry::Transform = Geometry::transform_identity()
    moved: bool = catch World::world_set_transform(&world, guard, Geometry::transform_translate(identity, Geometry::Vec3{x: 7.0, y: 0.0, z: -2.0})):
        ok: true
        error failure: false
    placed: bool = catch World::world_set_transform(&world, crate, Geometry::transform_translate(identity, Geometry::Vec3{x: -3.0, y: 0.5, z: 4.0})):
        ok: true
        error failure: false
    return 3 if not moved or not placed or player.id == 0

    bytes: mutable u8[World::SaveGame::MAX_BYTES] = zeroed
    length: usize = catch World::SaveGame::save_world(&world, &bytes[0], World::SaveGame::MAX_BYTES):
        value: value
        error failure: 0
    loaded: mutable World::World = catch World::World():
        value: value
        error failure: return 4
    restored: bool = catch World::SaveGame::load_world(&loaded, &bytes[0], length):
        ok: true
        error failure: false
    return 4 if length == 0 or not restored

    visuals: WorldSaveRendering::KindVisuals = WorldSaveRendering::KindVisuals{actor: visual(1), enemy: visual(2), structure: visual(3)}
    before: mutable WorldRendering::Bindings = WorldRendering::Bindings()
    after: mutable WorldRendering::Bindings = WorldRendering::Bindings()
    return 5 if rehydrate_code(&before, &world, visuals, 100) != 0 or rehydrate_code(&after, &loaded, visuals, 100) != 0
    return 6 if WorldRendering::binding_count(&after) != 3
    # Populated bindings and a non-positive base are refused.
    return 7 if rehydrate_code(&after, &loaded, visuals, 100) == 0 or WorldRendering::binding_count(&after) != 3
    fresh: mutable WorldRendering::Bindings = WorldRendering::Bindings()
    return 8 if rehydrate_code(&fresh, &loaded, visuals, 0) == 0

    saved_view: mutable RenderSnapshot::Snapshot = RenderSnapshot::Snapshot()
    loaded_view: mutable RenderSnapshot::Snapshot = RenderSnapshot::Snapshot()
    return 9 if extract_code(&world, &before, &saved_view) != 0 or extract_code(&loaded, &after, &loaded_view) != 0
    return 10 if RenderSnapshot::snapshot_count(&loaded_view) != 3 or RenderSnapshot::snapshot_count(&saved_view) != 3
    # The loaded world presents the same render IDs, meshes and poses.
    mutable mismatch: i32 = 0
    for index in 0..<3 |mismatch, saved_view, loaded_view|:
        a: RenderSnapshot::Entry = RenderSnapshot::snapshot_entry(&saved_view, index)
        b: RenderSnapshot::Entry = RenderSnapshot::snapshot_entry(&loaded_view, index)
        same_id: bool = a.render_id == b.render_id and a.visual.mesh.low == b.visual.mesh.low
        same_pose: bool = near(a.transform.position.x, b.transform.position.x) and near(a.transform.position.y, b.transform.position.y) and near(a.transform.position.z, b.transform.position.z)
        mismatch <- mismatch + 1 if not same_id or not same_pose or b.gameplay.world_epoch != World::world_epoch(&loaded)
    return 11 if mismatch != 0
    guard_entry: RenderSnapshot::Entry = RenderSnapshot::snapshot_entry(&loaded_view, 1)
    return 12 if guard_entry.render_id != 101 or guard_entry.visual.mesh.low != 2 or not near(guard_entry.transform.position.x, 7.0)
    0
