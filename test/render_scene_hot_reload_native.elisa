# Native A10 coverage for live hot reload. A presented row names each slot's
# current generation; edited texture, mesh and material files swap at the
# frame boundary and the next presenter sync draws them, a broken import
# leaves the scene on the last good generation, and a swapped-out
# generation is unregistered at the boundary after the row lets it go.
include "../src/runtime/render_scene_hot_reload.elisa"
include "../src/runtime/render_snapshot_scene.elisa"

module RenderSceneHotReloadNativeTests:
    private:
        @callconv(c)
        extern elisa_render_scene_v1_test_snapshot_identity_matches(gameplay_epoch: i64, gameplay_id: i64,
            render_id: i64, mesh_high: u64, mesh_low: u64, material_high: u64, material_low: u64) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_snapshot_instance_resources(render_id: i64,
            vertex_count: u64, index_count: u64, red: f32, green: f32, blue: f32, alpha: f32,
            metallic: f32, roughness: f32) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_snapshot_material_texture_id(high: u64, low: u64, slot: i32,
            texture_high: u64, texture_low: u64) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_replace_cooked_file(source: cstr, destination: cstr) -> i32

        @callconv(c)
        extern elisa_render_scene_v1_test_object_count() -> u64

        const TEXTURE: i64 = 0
        const PAINT: i64 = 1
        const MESH: i64 = 2
        const EPOCH: i64 = 11
        const GAMEPLAY: i64 = 23500
        const ROW: i64 = 23501
        const BASE_COLOR: i32 = 0
        const TEXTURE_PATH: cstr = "build/cooked/hot-reload/texture.ktx2"
        const MESH_PATH: cstr = "build/cooked/hot-reload/mesh.elpk"

        def paint(red: f32) -> Material::Material:
            Material::Material{
                base_color: Assets::AssetId{high: 0, low: 0},
                normal: Assets::AssetId{high: 0, low: 0},
                metallic_roughness: Assets::AssetId{high: 0, low: 0},
                occlusion: Assets::AssetId{high: 0, low: 0},
                emissive: Assets::AssetId{high: 0, low: 0},
                clearcoat: Assets::AssetId{high: 0, low: 0},
                clearcoat_roughness: Assets::AssetId{high: 0, low: 0},
                clearcoat_normal: Assets::AssetId{high: 0, low: 0},
                base_color_factor: [red, 0.5, 0.5, 1.0],
                metallic_factor: 0.0,
                roughness_factor: 1.0,
                normal_scale: 1.0,
                occlusion_strength: 1.0,
                clearcoat_factor: 0.0,
                clearcoat_roughness_factor: 0.0,
                clearcoat_normal_scale: 1.0,
                emissive_factor: [0.0, 0.0, 0.0],
                alpha_cutoff: 0.5,
                alpha_mode: Material::AlphaMode.Opaque,
                double_sided: false,
            }

        def make() -> RenderSceneHotReload::Reloader:
            mutable kind: i64[8] = zeroed
            mutable high: u64[8] = zeroed
            mutable parent: i64[8] = [-1, -1, -1, -1, -1, -1, -1, -1]
            kind[0] <- RenderSceneHotReload::Kind::TEXTURE
            kind[1] <- RenderSceneHotReload::Kind::MATERIAL
            kind[2] <- RenderSceneHotReload::Kind::MESH
            high[0] <- 2350
            high[1] <- 2351
            high[2] <- 2352
            parent[1] <- 0
            RenderSceneHotReload::reloader(kind, high, parent, 3)

        def copy(source: cstr, destination: cstr) -> bool:
            elisa_render_scene_v1_test_replace_cooked_file(source, destination) == 1

        # Publishes the one row with each slot's current generation.
        def present(presenter: mutable RenderScene::SnapshotPresenter&,
            snapshot: mutable RenderSnapshot::Snapshot&, r: RenderSceneHotReload::Reloader&) -> bool:
            visual: Assets::VisualAsset = Assets::VisualAsset{
                mesh: RenderSceneHotReload::current(r, MESH),
                material: RenderSceneHotReload::current(r, PAINT),
                local_bounds: Geometry::Bounds3{
                    minimum: Geometry::Vec3{x: -1.0, y: -1.0, z: -1.0},
                    maximum: Geometry::Vec3{x: 1.0, y: 1.0, z: 1.0},
                },
            }
            transform: Geometry::Transform = Geometry::Transform{
                position: Geometry::Vec3{x: 0.0, y: -1000.0, z: 0.0},
                rotation: Geometry::quat_identity(),
                scale: Geometry::Vec3{x: 1.0, y: 1.0, z: 1.0},
            }
            gameplay: World::EntityRef = World::EntityRef{world_epoch: EPOCH, id: GAMEPLAY}
            RenderSnapshot::snapshot_clear(snapshot)
            return false if not RenderSnapshot::snapshot_bind(snapshot, gameplay, ROW, visual, transform)
            catch RenderSnapshotScene::sync(presenter, snapshot):
                ok: true
                error failure: false

        # The row draws mesh generation `mesh`, paint generation `paint`
        # with `vertices` vertices and base red `red`, and the paint samples
        # texture generation `texture`.
        def shows(mesh: u64, paint_low: u64, texture: u64, vertices: u64, indices: u64, red: f32) -> bool:
            identity: bool = elisa_render_scene_v1_test_snapshot_identity_matches(EPOCH, GAMEPLAY, ROW,
                2352, mesh, 2351, paint_low) != 0
            drawn: bool = elisa_render_scene_v1_test_snapshot_instance_resources(ROW, vertices, indices,
                red, 0.5, 0.5, 1.0, 0.0, 1.0) != 0
            sampled: bool = elisa_render_scene_v1_test_snapshot_material_texture_id(2351, paint_low,
                BASE_COLOR, 2350, texture) == 1
            identity and drawn and sampled

        # A frame: poll both files, swap at the boundary, then sync.
        def frame(r: mutable RenderSceneHotReload::Reloader&, presenter: mutable RenderScene::SnapshotPresenter&,
            snapshot: mutable RenderSnapshot::Snapshot&) -> i64:
            _ = RenderSceneHotReload::poll_texture(r, TEXTURE, TEXTURE_PATH)
            _ = RenderSceneHotReload::poll_mesh(r, MESH, MESH_PATH)
            swapped: i64 = RenderSceneHotReload::frame_boundary(r)
            return -1 if not present(presenter, snapshot, r)
            swapped

        def gone_material(low: u64) -> bool:
            elisa_render_scene_v1_test_snapshot_material_texture_id(2351, low, BASE_COLOR, 0, 0) == 0

        def reloads(r: mutable RenderSceneHotReload::Reloader&, presenter: mutable RenderScene::SnapshotPresenter&,
            snapshot: mutable RenderSnapshot::Snapshot&) -> i32:
            return 1 if not present(presenter, snapshot, r)
            return 2 if not shows(1, 1, 1, 3, 3, 0.25)
            return 3 if frame(r, presenter, snapshot) != 0
            # Texture edit: the texture and its material swap together.
            return 4 if not copy("build/cooked/maze_tile_etc1s.ktx2", TEXTURE_PATH)
            edit: RenderSceneHotReload::Poll = RenderSceneHotReload::poll_texture(r, TEXTURE, TEXTURE_PATH)
            return 5 if edit != RenderSceneHotReload::Poll.Staged
            return 6 if not shows(1, 1, 1, 3, 3, 0.25)
            return 7 if RenderSceneHotReload::frame_boundary(r) != 2
            return 8 if not present(presenter, snapshot, r) or not shows(1, 2, 2, 3, 3, 0.25)
            # The next boundary frees paint 1 once nothing draws it.
            return 9 if frame(r, presenter, snapshot) != 0 or not gone_material(1)
            # Mesh edit: the 24-vertex tile replaces the triangle.
            return 10 if not copy("build/cooked/maze_tile.elpk", MESH_PATH)
            return 11 if frame(r, presenter, snapshot) != 1 or not shows(2, 2, 2, 24, 36, 0.25)
            # Material edit.
            edited: Material::Material = paint(0.75)
            restaged: RenderSceneHotReload::Poll = RenderSceneHotReload::edit_material(r, PAINT, &edited)
            return 12 if restaged != RenderSceneHotReload::Poll.Staged
            return 13 if frame(r, presenter, snapshot) != 1 or not shows(2, 3, 2, 24, 36, 0.75)
            # Broken texture and mesh files keep the last good generation.
            return 14 if not copy("build/cooked/maze_tile_tex.rgba", TEXTURE_PATH)
            bad_texture: RenderSceneHotReload::Poll = RenderSceneHotReload::poll_texture(r, TEXTURE, TEXTURE_PATH)
            return 15 if bad_texture != RenderSceneHotReload::Poll.Broken
            return 16 if r.last_error_slot != TEXTURE or r.last_error == RenderSceneHotReload::ImportError::NONE
            return 17 if not copy("build/cooked/maze_tile_tex.rgba", MESH_PATH)
            bad_mesh: RenderSceneHotReload::Poll = RenderSceneHotReload::poll_mesh(r, MESH, MESH_PATH)
            return 18 if bad_mesh != RenderSceneHotReload::Poll.Broken
            return 19 if r.last_error_slot != MESH or r.last_error != RenderSceneHotReload::ImportError::LOAD_FAILED
            return 20 if frame(r, presenter, snapshot) != 0 or not shows(2, 3, 2, 24, 36, 0.75)
            return 21 if RenderSceneHotReload::errors(r) != 2
            # Fixing the files recovers.
            return 22 if not copy("build/cooked/maze_tile_tex.ktx2", TEXTURE_PATH)
            return 23 if not copy("build/cooked/render-scene-triangle.elpk", MESH_PATH)
            return 24 if frame(r, presenter, snapshot) != 3 or not shows(3, 4, 3, 3, 3, 0.75)
            return 25 if frame(r, presenter, snapshot) != 0 or not gone_material(3)
            0

    public:
        # Returns 0 or the failing case: 1-9 setup, 10-39 reloads, 40-49 cleanup.
        def exercise() -> i32:
            instances: u64 = RenderScene::instance_count()
            objects: u64 = elisa_render_scene_v1_test_object_count()
            return 1 if not copy("build/cooked/maze_tile_tex.ktx2", TEXTURE_PATH)
            return 2 if not copy("build/cooked/render-scene-triangle.elpk", MESH_PATH)
            r: mutable RenderSceneHotReload::Reloader = make()
            return 3 if RenderSceneHotReload::load_texture(&r, TEXTURE, TEXTURE_PATH) != 0
            first: Material::Material = paint(0.25)
            return 4 if RenderSceneHotReload::load_material(&r, PAINT, &first) != 0
            return 5 if RenderSceneHotReload::load_mesh(&r, MESH, MESH_PATH) != 0
            snapshot: mutable RenderSnapshot::Snapshot = RenderSnapshot::Snapshot()
            presenter: mutable RenderScene::SnapshotPresenter = RenderScene::SnapshotPresenter()
            reloaded: i32 = reloads(&r, &presenter, &snapshot)
            return 10 + reloaded if reloaded != 0
            cleared: bool = catch RenderSnapshotScene::clear(&presenter):
                ok: true
                error failure: false
            return 40 if not cleared
            return 41 if RenderSceneHotReload::unload(&r) != 0
            return 42 if RenderScene::instance_count() != instances or elisa_render_scene_v1_test_object_count() != objects
            0
