# Native gate for rebuilding physics bodies after a whole-world load.
include "../src/world/world_save.elisa"
include "../src/runtime/world_save_load.elisa"
include "../src/runtime/application.elisa"
include "../src/backend/requirements.elisa"

def near(a: f32, b: f32) -> bool:
    d: f32 = a - b
    d < 0.01 and d > -0.01

def box(kind: PhysicsRuntime::BodyKind, mass: f32) -> WorldSavePhysics::KindBody:
    WorldSavePhysics::KindBody{kind: kind, half_extents: Geometry::Vec3{x: 0.5, y: 0.5, z: 0.5}, mass: mass}

def rehydrate_code(session: RuntimeServices::Session&, world: World::World&,
    bindings: mutable WorldPhysics::Bindings&, bodies: WorldSavePhysics::KindBodies) -> i32:
    catch WorldSavePhysics::rehydrate(session, world, bindings, bodies):
        ok: 0
        WorldSavePhysics::WorldSavePhysicsError.BindingsNotEmpty: 1
        error failure: 2

def visual(mesh: u64) -> Assets::VisualAsset:
    Assets::VisualAsset{
        mesh: Assets::AssetId{high: 7, low: mesh},
        material: Assets::AssetId{high: 7, low: 90},
        local_bounds: Geometry::Bounds3{
            minimum: Geometry::Vec3{x: -1.0, y: -1.0, z: -1.0},
            maximum: Geometry::Vec3{x: 1.0, y: 1.0, z: 1.0},
        },
    }

def load_code(session: RuntimeServices::Session&, world: mutable World::World&,
    render: mutable WorldRendering::Bindings&, physics: mutable WorldPhysics::Bindings&,
    presentation: WorldSaveLoad::Presentation, bytes: u8&, length: usize) -> i32:
    catch WorldSaveLoad::load(session, world, render, physics, presentation, bytes, length):
        ok: 0
        WorldSaveLoad::WorldSaveLoadError.Rejected: 1
        error failure: 2

# A running game with its own bound crate loads the save end to end.
def load_probe(session: RuntimeServices::Session&, bytes: mutable u8&, length: usize) -> i32:
    live: mutable World::World = catch World::World():
        value: value
        error failure: return 30
    crate: World::EntityRef = catch World::world_spawn(&live, World::StaticObject.Structure):
        value: value
        error failure: return 30
    presentation: WorldSaveLoad::Presentation = WorldSaveLoad::Presentation{
        visuals: WorldSaveRendering::KindVisuals{actor: visual(1), enemy: visual(2), structure: visual(3)},
        bodies: WorldSavePhysics::KindBodies{
            actor: box(PhysicsRuntime::BodyKind.Kinematic, 1.0),
            enemy: box(PhysicsRuntime::BodyKind.Kinematic, 1.0),
            structure: box(PhysicsRuntime::BodyKind.Static, 0.0),
        },
        render_id_base: 500,
    }
    render: mutable WorldRendering::Bindings = WorldRendering::Bindings()
    physics: mutable WorldPhysics::Bindings = WorldPhysics::Bindings()
    bound: bool = catch WorldPhysics::bind(session, &live, &physics, crate, PhysicsRuntime::BodyKind.Static, Geometry::Vec3{x: 0.5, y: 0.5, z: 0.5}, 0.0):
        ok: true
        error failure: false
    drawn: bool = catch WorldRendering::bind(&render, &live, crate, 42, visual(3), Geometry::transform_identity()):
        ok: true
        error failure: false
    return 31 if not bound or not drawn
    # A body left bound to an entity despawned before the load is still torn down.
    orphan: World::EntityRef = catch World::world_spawn(&live, World::StaticObject.Structure):
        value: value
        error failure: return 31
    orphan_bound: bool = catch WorldPhysics::bind(session, &live, &physics, orphan, PhysicsRuntime::BodyKind.Static, Geometry::Vec3{x: 0.5, y: 0.5, z: 0.5}, 0.0):
        ok: true
        error failure: false
    orphan_gone: bool = catch World::world_despawn(&live, orphan):
        ok: true
        error failure: false
    return 31 if not orphan_bound or not orphan_gone
    # A corrupt save leaves the running game's world and bindings alone.
    bytes[30] <- bytes[30] ^ 1u8
    rejected: i32 = load_code(session, &live, &render, &physics, presentation, bytes, length)
    bytes[30] <- bytes[30] ^ 1u8
    return 32 if rejected != 1 or not World::world_is_live(&live, crate)
    return 33 if WorldRendering::binding_count(&render) != 1 or WorldPhysics::binding_count(&physics) != 2
    return 34 if load_code(session, &live, &render, &physics, presentation, bytes, length) != 0
    return 35 if World::world_live_count(&live) != 3 or World::world_is_live(&live, crate)
    return 36 if WorldRendering::binding_count(&render) != 3 or WorldPhysics::binding_count(&physics) != 3
    view: mutable RenderSnapshot::Snapshot = RenderSnapshot::Snapshot()
    extracted: bool = catch WorldRendering::extract(&live, &render, &view):
        ok: true
        error failure: false
    return 37 if not extracted or RenderSnapshot::snapshot_count(&view) != 3
    entry: RenderSnapshot::Entry = RenderSnapshot::snapshot_entry(&view, 1)
    return 38 if entry.render_id != 501 or not near(entry.transform.position.x, 7.0)
    guard: World::EntityRef = catch World::world_live_reference_at(&live, 1):
        value: value
        error failure: return 39
    pose: PhysicsRuntime::BodyPose = catch WorldPhysics::body_pose(session, &physics, guard):
        value: value
        error failure: return 39
    return 39 if not near(pose.position.z, -2.0)
    0

def probe(session: RuntimeServices::Session&) -> i32:
    world: mutable World::World = catch World::World():
        value: value
        error failure: return 10
    player: World::EntityRef = catch World::world_spawn(&world, World::Actor.Player):
        value: value
        error failure: return 11
    guard: World::EntityRef = catch World::world_spawn(&world, World::Enemy.Guard):
        value: value
        error failure: return 11
    crate: World::EntityRef = catch World::world_spawn(&world, World::StaticObject.Structure):
        value: value
        error failure: return 11
    identity: Geometry::Transform = Geometry::transform_identity()
    moved: bool = catch World::world_set_transform(&world, guard, Geometry::transform_translate(identity, Geometry::Vec3{x: 7.0, y: 3.0, z: -2.0})):
        ok: true
        error failure: false
    placed: bool = catch World::world_set_transform(&world, crate, Geometry::transform_translate(identity, Geometry::Vec3{x: -3.0, y: -20.0, z: 4.0})):
        ok: true
        error failure: false
    return 12 if not moved or not placed or player.id == 0
    bytes: mutable u8[World::SaveGame::MAX_BYTES] = zeroed
    length: usize = catch World::SaveGame::save_world(&world, &bytes[0], World::SaveGame::MAX_BYTES):
        value: value
        error failure: 0
    loaded: mutable World::World = catch World::World():
        value: value
        error failure: return 13
    restored: bool = catch World::SaveGame::load_world(&loaded, &bytes[0], length):
        ok: true
        error failure: false
    return 13 if length == 0 or not restored
    bodies: WorldSavePhysics::KindBodies = WorldSavePhysics::KindBodies{
        actor: box(PhysicsRuntime::BodyKind.Kinematic, 1.0),
        enemy: box(PhysicsRuntime::BodyKind.Kinematic, 1.0),
        structure: box(PhysicsRuntime::BodyKind.Static, 0.0),
    }
    bindings: mutable WorldPhysics::Bindings = WorldPhysics::Bindings()
    return 14 if rehydrate_code(session, &loaded, &bindings, bodies) != 0
    return 15 if WorldPhysics::binding_count(&bindings) != 3
    # A second pass over populated bindings is refused and adds nothing.
    return 16 if rehydrate_code(session, &loaded, &bindings, bodies) != 1 or WorldPhysics::binding_count(&bindings) != 3
    new_guard: World::EntityRef = catch World::world_live_reference_at(&loaded, 1):
        value: value
        error failure: return 17
    pose: PhysicsRuntime::BodyPose = catch WorldPhysics::body_pose(session, &bindings, new_guard):
        value: value
        error failure: return 17
    return 18 if not near(pose.position.x, 7.0) or not near(pose.position.y, 3.0) or not near(pose.position.z, -2.0)
    # Bodies of the replaced world are not linked to the loaded one.
    stale: i32 = catch WorldPhysics::body_pose(session, &bindings, guard):
        value: 0
        error failure: 19
    return 19 if stale == 0
    load_probe(session, &bytes[0], length)

def main() -> i32:
    config: Application::Config = Application::Config{
        title: "Elisa World Save Physics Smoke",
        width: 320,
        height: 200,
        hidden: true,
    }
    requirements: mutable BackendRequirements::BackendStartupRequirements = zeroed
    requirements.services[0] <- Capabilities::BackendFeature.Input
    requirements.services[1] <- Capabilities::BackendFeature.Rendering
    requirements.services[2] <- Capabilities::BackendFeature.NativeWindow
    requirements.services[3] <- Capabilities::BackendFeature.Physics
    requirements.services[4] <- Capabilities::BackendFeature.Audio
    requirements.service_count <- 5
    requirements.service_fallbacks <- Capabilities::BackendFallbackProviders{
        input: Capabilities::BackendFallbackProvider.None,
        rendering: Capabilities::BackendFallbackProvider.None,
        physics: Capabilities::BackendFallbackProvider.JoltPhysics,
        audio: Capabilities::BackendFallbackProvider.MiniaudioSilent,
        native_window: Capabilities::BackendFallbackProvider.None,
        async_upload: Capabilities::BackendFallbackProvider.None,
        callbacks: Capabilities::BackendFallbackProvider.None,
        asset_loading: Capabilities::BackendFallbackProvider.None,
    }
    requirements.allow_service_fallbacks <- true
    report: mutable BackendRequirements::BackendRequirementsReport = zeroed
    session: mutable RuntimeServices::Session = RuntimeServices::Session()
    opened: RuntimeServices::OpenStatus = RuntimeServices::open(&session,
        config, &requirements, AudioRuntime::MIN_SAMPLE_RATE_HZ,
        AudioRuntime::MIN_CHANNEL_COUNT, &report)
    if opened != RuntimeServices::OpenStatus.FallbackRequired:
        _ = RuntimeServices::shutdown(&session)
        return 1
    if report.state != Capabilities::RequirementState.Fallback:
        _ = RuntimeServices::shutdown(&session)
        return 2
    result: i32 = probe(&session)
    closed: bool = RuntimeServices::shutdown(&session)
    return result if result != 0
    return 3 if not closed
    0
