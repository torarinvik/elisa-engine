include "../src/world/hierarchy.elisa"

def main() -> i32:
    hierarchy: mutable WorldHierarchy::Hierarchy = WorldHierarchy::Hierarchy()
    root: Geometry::Transform = Geometry::transform_translate(Geometry::transform_identity(), Geometry::Vec3{x: 2.0, y: 0.0, z: 0.0})
    child: Geometry::Transform = Geometry::transform_translate(Geometry::transform_identity(), Geometry::Vec3{x: 1.0, y: 0.0, z: 0.0})
    return 1 if not WorldHierarchy::hierarchy_spawn(&hierarchy, 1, root)
    return 2 if not WorldHierarchy::hierarchy_spawn(&hierarchy, 2, child)
    return 3 if not WorldHierarchy::hierarchy_set_parent(&hierarchy, 2, 1, false)
    WorldHierarchy::hierarchy_update(&hierarchy)
    world_child: Geometry::Transform = WorldHierarchy::hierarchy_world(&hierarchy, 2)
    return 4 if world_child.position.x != 3.0
    moved: Geometry::Transform = Geometry::transform_translate(child, Geometry::Vec3{x: 9.0, y: 0.0, z: 0.0})
    return 5 if not WorldHierarchy::hierarchy_set_local(&hierarchy, 2, moved, false)
    WorldHierarchy::hierarchy_update(&hierarchy)
    halfway: Geometry::Transform = WorldHierarchy::hierarchy_sample(&hierarchy, 2, 0.5)
    return 6 if halfway.position.x < 7.49 or halfway.position.x > 7.51
    jump_target: Geometry::Transform = Geometry::transform_translate(moved, Geometry::Vec3{x: 20.0, y: 0.0, z: 0.0})
    return 7 if not WorldHierarchy::hierarchy_set_local(&hierarchy, 2, jump_target, true)
    WorldHierarchy::hierarchy_update(&hierarchy)
    jump: Geometry::Transform = WorldHierarchy::hierarchy_sample(&hierarchy, 2, 0.5)
    return 8 if jump.position.x != 32.0
    physics_pose: Geometry::Transform = Geometry::transform_translate(Geometry::transform_identity(), Geometry::Vec3{x: 42.0, y: 0.0, z: 0.0})
    return 9 if not WorldHierarchy::hierarchy_apply_physics(&hierarchy, 2, physics_pose, false)
    physics_world: Geometry::Transform = WorldHierarchy::hierarchy_world(&hierarchy, 2)
    physics_sample: Geometry::Transform = WorldHierarchy::hierarchy_sample(&hierarchy, 2, 0.5)
    return 10 if physics_world.position.x != 42.0 or physics_sample.position.x < 36.99 or physics_sample.position.x > 37.01
    return 11 if WorldHierarchy::hierarchy_set_parent(&hierarchy, 1, 2, false)
    return 12 if not WorldHierarchy::hierarchy_set_parent(&hierarchy, 2, 0, true)
    WorldHierarchy::hierarchy_update(&hierarchy)
    kept: Geometry::Transform = WorldHierarchy::hierarchy_world(&hierarchy, 2)
    return 13 if kept.position.x != 42.0
    return 14 if not WorldHierarchy::hierarchy_remove(&hierarchy, 1)
    return 15 if WorldHierarchy::hierarchy_count(&hierarchy) != 1

    deep: mutable WorldHierarchy::Hierarchy = WorldHierarchy::Hierarchy()
    step: Geometry::Transform = Geometry::transform_translate(Geometry::transform_identity(), Geometry::Vec3{x: 1.0, y: 0.0, z: 0.0})
    for index in 1..<32:
        return 16 if not WorldHierarchy::hierarchy_spawn(&deep, index.i64(), step)
        return 17 if not WorldHierarchy::hierarchy_set_parent(&deep, index.i64(), (index - 1).i64(), false)
    WorldHierarchy::hierarchy_update(&deep)
    return 18 if WorldHierarchy::hierarchy_world(&deep, 31).position.x != 31.0
    root_shift: Geometry::Transform = Geometry::transform_translate(Geometry::transform_identity(), Geometry::Vec3{x: 4.0, y: 0.0, z: 0.0})
    return 19 if not WorldHierarchy::hierarchy_set_local(&deep, 1, root_shift, false)
    WorldHierarchy::hierarchy_update(&deep)
    return 20 if WorldHierarchy::hierarchy_world(&deep, 31).position.x != 34.0

    checked: mutable WorldHierarchy::Hierarchy = WorldHierarchy::Hierarchy()
    root_pose: Geometry::Transform = Geometry::transform_identity()
    child_pose: Geometry::Transform = Geometry::transform_translate(root_pose,
        Geometry::Vec3{x: 3.0, y: 0.0, z: 0.0})
    return 21 if not WorldHierarchy::hierarchy_spawn(&checked, 1, root_pose)
    return 22 if not WorldHierarchy::hierarchy_spawn(&checked, 2, child_pose)
    return 23 if not WorldHierarchy::hierarchy_set_parent(&checked, 2, 1, false)
    WorldHierarchy::hierarchy_update(&checked)
    root_moved: Geometry::Transform = Geometry::transform_translate(root_pose,
        Geometry::Vec3{x: 5.0, y: 0.0, z: 0.0})
    return 24 if not WorldHierarchy::hierarchy_set_local(&checked, 1, root_moved, false)
    stale_child: mutable Geometry::Transform = Geometry::transform_identity()
    return 25 if WorldHierarchy::hierarchy_try_world(&checked, 2, &stale_child)
    return 26 if WorldHierarchy::hierarchy_depth(&checked, 2) != WorldHierarchy::MAX_NODES
    pending_child: mutable Geometry::Transform = Geometry::transform_identity()
    pending_depth: mutable usize = 0
    return 27 if not WorldHierarchy::hierarchy_try_target_world(
        &checked, 2, &pending_child, &pending_depth)
    return 28 if pending_depth != 1 or pending_child.position.x != 8.0
    return 29 if WorldHierarchy::hierarchy_world(&checked, 2).position.x != 3.0
    pending_sample: Geometry::Transform = WorldHierarchy::hierarchy_sample(
        &checked, 2, 0.5)
    return 30 if pending_sample.position.x != 3.0
    WorldHierarchy::hierarchy_update(&checked)
    return 31 if not WorldHierarchy::hierarchy_try_world(&checked, 2, &stale_child)
    return 32 if stale_child.position.x != 8.0
    0
