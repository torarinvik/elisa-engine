# Skeleton display and picking (plan M03) in perspective, front and side
# views: joints and bones under their projected pixels, nearest-first on
# overlaps, the joint-before-bone and lower-index tie-break on exact ties,
# misses, and invalid input.
include "../src/viewport/skeleton_overlay.elisa"

def v(x: f32, y: f32, z: f32) -> Geometry::Vec3:
    Geometry::Vec3{x: x, y: y, z: z}

def at(p: Geometry::Vec3) -> Geometry::Transform:
    Geometry::transform_translate(Geometry::transform_identity(), p)

def add(rig: mutable PoseOverride::Rig&, parent: i64, offset: Geometry::Vec3) -> i32:
    catch PoseOverride::rig_add(rig, parent, at(offset)):
        value: 0
        error failure: 1

# Rig: 0 hips (0,1,0); 1 spine (0,1.5,0); 2 leg (0.3,0.5,0); 3 a joint 0.4 m
# toward the camera from the spine joint; 4 and 5 sit exactly on the hips.
def build(rig: mutable PoseOverride::Rig&, toward: Geometry::Vec3) -> i32:
    mutable bad: i32 = 0
    bad <- bad + add(rig, -1, v(0.0, 1.0, 0.0))
    bad <- bad + add(rig, 0, v(0.0, 0.5, 0.0))
    bad <- bad + add(rig, 0, v(0.3, -0.5, 0.0))
    bad <- bad + add(rig, 1, Geometry::vec3_scale(toward, 0.4))
    bad <- bad + add(rig, 0, v(0.0, 0.0, 0.0))
    bad <- bad + add(rig, 0, v(0.0, 0.0, 0.0))
    bad

def pick_at(cam: ViewportCamera::Camera&, rig: PoseOverride::Rig&, models: darray[Geometry::Transform]&, p: Geometry::Vec3) -> SkeletonOverlay::Hit:
    s: ViewportCamera::ScreenPoint = ViewportCamera::project(cam, p)
    style: SkeletonOverlay::Style = SkeletonOverlay::default_style()
    SkeletonOverlay::pick(cam, rig, models, &style, s.x, s.y)

def hits(hit: SkeletonOverlay::Hit, kind: i64, bone: i64) -> bool:
    hit.kind == kind and hit.bone == bone

def view_case(cam: ViewportCamera::Camera&, base: i32) -> i32:
    b: ViewportCamera::Basis = ViewportCamera::basis(cam)
    # Toward the viewer along the spine joint's line of sight (parallel rays
    # in orthographic views, towards the eye in perspective).
    mutable toward: Geometry::Vec3 = Geometry::vec3_scale(b.forward, -1.0)
    if cam.projection == ViewportCamera::PERSPECTIVE:
        toward <- Geometry::vec3_normalize(Geometry::vec3_sub(b.eye, v(0.0, 1.5, 0.0)))
    mutable rig: PoseOverride::Rig = PoseOverride::Rig()
    return base + 1 if build(&rig, toward) != 0
    held: PoseOverride::Overrides = PoseOverride::overrides(&rig)
    mutable models: darray[Geometry::Transform] = []
    _ = catch PoseOverride::evaluate_rest(&rig, &held, &models):
        value: value
        error failure: return base + 2
    hips: Geometry::Vec3 = models[0].position
    spine: Geometry::Vec3 = models[1].position
    leg: Geometry::Vec3 = models[2].position
    front: Geometry::Vec3 = models[3].position
    # The spine joint is hidden behind joint 3 (same pixel, nearer): nearest wins.
    over: SkeletonOverlay::Hit = pick_at(cam, &rig, &models, spine)
    return base + 3 if not hits(over, SkeletonPickPolicy::JOINT, 3)
    # The hit distance is where the ray enters joint 3's sphere: in front of it.
    ss: ViewportCamera::ScreenPoint = ViewportCamera::project(cam, spine)
    origin: Geometry::Vec3 = ViewportCamera::ray(cam, ss.x, ss.y).origin
    reach: f32 = Geometry::vec3_length(Geometry::vec3_sub(front, origin))
    return base + 4 if over.distance > reach or over.distance < reach - 0.2
    # Hips: joints 0, 4, 5 coincide and bones 1, 2, 4, 5 end there; the lowest
    # joint index wins the exact tie, joints beat the bones.
    return base + 5 if not hits(pick_at(cam, &rig, &models, hips), SkeletonPickPolicy::JOINT, 0)
    # The leg joint alone.
    return base + 6 if not hits(pick_at(cam, &rig, &models, leg), SkeletonPickPolicy::JOINT, 2)
    # Middle of the leg bone (away from every joint).
    mid: Geometry::Vec3 = Geometry::vec3_scale(Geometry::vec3_add(hips, leg), 0.5)
    return base + 7 if not hits(pick_at(cam, &rig, &models, mid), SkeletonPickPolicy::BONE, 2)
    # Middle of the spine bone.
    smid: Geometry::Vec3 = Geometry::vec3_scale(Geometry::vec3_add(hips, spine), 0.5)
    return base + 8 if not hits(pick_at(cam, &rig, &models, smid), SkeletonPickPolicy::BONE, 1)
    # 3 pixels beside the leg bone is inside its 4-pixel capsule; 12 is outside.
    style: SkeletonOverlay::Style = SkeletonOverlay::default_style()
    sm: ViewportCamera::ScreenPoint = ViewportCamera::project(cam, mid)
    near_bone: SkeletonOverlay::Hit = SkeletonOverlay::pick(cam, &rig, &models, &style, sm.x + 3.0, sm.y)
    return base + 9 if not hits(near_bone, SkeletonPickPolicy::BONE, 2)
    far_bone: SkeletonOverlay::Hit = SkeletonOverlay::pick(cam, &rig, &models, &style, sm.x + 12.0, sm.y)
    return base + 10 if far_bone.kind != SkeletonPickPolicy::NONE
    # Empty corner: miss.
    return base + 11 if SkeletonOverlay::pick(cam, &rig, &models, &style, 1.0, 1.0).kind != SkeletonPickPolicy::NONE
    # Invalid input never picks.
    nan: f32 = 0.0 / 0.0
    return base + 12 if SkeletonOverlay::pick(cam, &rig, &models, &style, nan, sm.y).kind != SkeletonPickPolicy::NONE
    mutable short: darray[Geometry::Transform] = []
    short.push(models[0])
    return base + 13 if SkeletonOverlay::pick(cam, &rig, &short, &style, sm.x, sm.y).kind != SkeletonPickPolicy::NONE
    mutable list: ViewportDraw::List = ViewportDraw::create()
    mismatch: i32 = catch SkeletonOverlay::draw(&list, cam, &rig, &short, &style, SkeletonOverlay::nothing(), SkeletonOverlay::nothing()):
        value: 0
        SkeletonOverlay::OverlayError.ShapeMismatch: 1
        error failure: 2
    return base + 14 if mismatch != 1 or ViewportDraw::vertex_count(&list) != 0
    # Draw: every joint and every non-root bone.
    drawn: usize = catch SkeletonOverlay::draw(&list, cam, &rig, &models, &style, SkeletonOverlay::joint(2), SkeletonOverlay::bone(1)):
        value: value
        error failure: return base + 15
    return base + 16 if drawn != 6 or ViewportDraw::vertex_count(&list) == 0
    return base + 17 if list.top_lines.colors.count == 0 or list.depth_lines.colors.count != 0
    mutable solid: SkeletonOverlay::Style = SkeletonOverlay::default_style()
    solid.xray <- false
    mutable depth_list: ViewportDraw::List = ViewportDraw::create()
    _ = catch SkeletonOverlay::draw(&depth_list, cam, &rig, &models, &solid, SkeletonOverlay::nothing(), SkeletonOverlay::nothing()):
        value: value
        error failure: return base + 18
    return base + 19 if depth_list.top_lines.colors.count != 0 or depth_list.depth_lines.colors.count != list.top_lines.colors.count
    0

def colours_and_modes() -> i32:
    mutable s: SkeletonOverlay::Style = SkeletonOverlay::default_style()
    sel: SkeletonOverlay::Target = SkeletonOverlay::joint(2)
    hov: SkeletonOverlay::Target = SkeletonOverlay::joint(2)
    return 101 if SkeletonOverlay::color_for(&s, SkeletonPickPolicy::JOINT, 2, sel, hov) != s.selected_color
    return 102 if SkeletonOverlay::color_for(&s, SkeletonPickPolicy::JOINT, 2, SkeletonOverlay::nothing(), hov) != s.hover_color
    # A bone with the same index as a selected joint is not selected.
    return 103 if SkeletonOverlay::color_for(&s, SkeletonPickPolicy::BONE, 2, sel, SkeletonOverlay::nothing()) != s.bone_color
    return 104 if SkeletonOverlay::mesh_mode(&s) != SkeletonOverlay::MESH_SHADED
    s.wireframe <- true
    return 105 if SkeletonOverlay::mesh_mode(&s) != SkeletonOverlay::MESH_WIREFRAME
    s.show_mesh <- false
    return 106 if SkeletonOverlay::mesh_mode(&s) != SkeletonOverlay::MESH_HIDDEN
    # Ray primitives.
    r: Geometry::Ray3 = Geometry::Ray3{origin: v(0.0, 0.0, 0.0), direction: v(0.0, 0.0, -1.0)}
    t: f32 = SkeletonOverlay::ray_sphere(r, v(0.0, 0.0, -5.0), 1.0)
    return 107 if t < 3.999 or t > 4.001
    return 108 if SkeletonOverlay::ray_sphere(r, v(0.0, 2.0, -5.0), 1.0) >= 0.0
    return 109 if SkeletonOverlay::ray_sphere(r, v(0.0, 0.0, 5.0), 1.0) >= 0.0
    inside: f32 = SkeletonOverlay::ray_sphere(r, v(0.0, 0.0, 0.0), 1.0)
    return 110 if inside < 0.999 or inside > 1.001
    return 111 if SkeletonOverlay::ray_sphere(r, v(0.0, 0.0, -5.0), 0.0) >= 0.0
    tc: f32 = SkeletonOverlay::ray_capsule(r, v(-3.0, 0.0, -5.0), v(3.0, 0.0, -5.0), 0.5)
    return 112 if tc < 4.49 or tc > 4.51
    return 113 if SkeletonOverlay::ray_capsule(r, v(-3.0, 0.8, -5.0), v(3.0, 0.8, -5.0), 0.5) >= 0.0
    # Past the capsule's end the cap still counts.
    te: f32 = SkeletonOverlay::ray_capsule(r, v(0.3, 0.0, -5.0), v(3.0, 0.0, -5.0), 0.5)
    return 114 if te < 4.5 or te > 5.0
    return 115 if SkeletonOverlay::ray_capsule(r, v(0.6, 0.0, -5.0), v(3.0, 0.0, -5.0), 0.5) >= 0.0
    # Tie-break order.
    return 116 if not SkeletonPickPolicy::better(5, SkeletonPickPolicy::BONE, 9, 6, SkeletonPickPolicy::JOINT, 0)
    return 117 if not SkeletonPickPolicy::better(5, SkeletonPickPolicy::JOINT, 9, 5, SkeletonPickPolicy::BONE, 0)
    return 118 if SkeletonPickPolicy::better(5, SkeletonPickPolicy::JOINT, 3, 5, SkeletonPickPolicy::JOINT, 3)
    return 119 if SkeletonOverlay::code_for(0.0 / 0.0) != SkeletonPickPolicy::MAX_CODE or SkeletonOverlay::code_for(1.0) != 1000000
    0

def main() -> i32:
    persp: ViewportCamera::Camera = ViewportCamera::create(320, 240)
    r: i32 = view_case(&persp, 0)
    return r if r != 0
    mutable turned: ViewportCamera::Camera = ViewportCamera::create(640, 360)
    _ = ViewportCamera::orbit(&turned, 300, -80)
    r2: i32 = view_case(&turned, 20)
    return r2 if r2 != 0
    front: ViewportCamera::Camera = ViewportCamera::create_ortho(320, 240, ViewportCamera::FRONT)
    r3: i32 = view_case(&front, 40)
    return r3 if r3 != 0
    side: ViewportCamera::Camera = ViewportCamera::create_ortho(240, 320, ViewportCamera::SIDE)
    r4: i32 = view_case(&side, 60)
    return r4 if r4 != 0
    colours_and_modes()
