# End-to-end activation and cleanup checks for report-selected providers.
include "../src/runtime/executor.elisa"
include "./world_audio_probe.elisa"
include "./runtime_physics_queries_probe.elisa"
include "./runtime_services_audio_probe.elisa"

@callconv(c)
extern elisa_audio_v1_test_request_device_recovery() -> i32

module RuntimeServicesProbe:
    private:
        const module Systems:
            PHYSICS: usize = 0
            WORLD_SYNC: usize = 1

        affine struct TickContext:
            world: mutable World::World
            bodies: mutable WorldPhysics::Bindings
            physics_steps: mutable i64
            sync_passes: mutable i64
            failed: mutable bool

        def TickContext(world: World::World, bodies: WorldPhysics::Bindings) -> TickContext:
            TickContext{
                world: world,
                bodies: bodies,
                physics_steps: 0,
                sync_passes: 0,
                failed: false,
            }

        def dispatch_physics_system(state: mutable Executor::FrameState&,
            system: usize, context: mutable TickContext&,
            session: mutable RuntimeServices::Session&) -> void:
            state.visits[system] <- state.visits[system] + 1
            if system == Systems::PHYSICS:
                step_status: i32 = catch RuntimeServices::physics_fixed_step(session,
                    Runtime::fixed_step_seconds()):
                    value: 0
                    error failure: 1
                if step_status == 0:
                    context.physics_steps <- context.physics_steps + 1
                else:
                    context.failed <- true

            elif system == Systems::WORLD_SYNC:
                sync_status: bool = catch WorldPhysics::sync_world(session,
                    &context.world, context.bodies):
                    ok: true
                    error failure: false
                if sync_status:
                    context.sync_passes <- context.sync_passes + 1
                else:
                    context.failed <- true

        def startup_requirements() -> BackendRequirements::BackendStartupRequirements:
            requirements: mutable BackendRequirements::BackendStartupRequirements = zeroed
            requirements.services[0] <- Capabilities::BackendFeature.Input
            requirements.services[1] <- Capabilities::BackendFeature.Rendering
            requirements.services[2] <- Capabilities::BackendFeature.NativeWindow
            requirements.services[3] <- Capabilities::BackendFeature.Physics
            requirements.services[4] <- Capabilities::BackendFeature.Audio
            requirements.service_count <- 5
            requirements.service_fallbacks <- Capabilities::BackendFallbackProviders{
                input: Capabilities::BackendFallbackProvider.None,
                rendering: Capabilities::BackendFallbackProvider.None,
                physics: Capabilities::BackendFallbackProvider.JoltPhysics,
                audio: Capabilities::BackendFallbackProvider.MiniaudioSilent,
                native_window: Capabilities::BackendFallbackProvider.None,
                async_upload: Capabilities::BackendFallbackProvider.None,
                callbacks: Capabilities::BackendFallbackProvider.None,
                asset_loading: Capabilities::BackendFallbackProvider.None,
            }
            requirements.allow_service_fallbacks <- true
            requirements

        def config() -> Application::Config:
            Application::Config{
                title: "Elisa service session smoke",
                width: 320,
                height: 200,
                hidden: true,
            }

        def activation_rollback(session: mutable RuntimeServices::Session&,
            requirements: BackendRequirements::BackendStartupRequirements&) -> i32:
            report: mutable BackendRequirements::BackendRequirementsReport = zeroed
            opened: RuntimeServices::OpenStatus = RuntimeServices::open(session,
                config(), requirements, AudioRuntime::MIN_SAMPLE_RATE_HZ - 1,
                AudioRuntime::MIN_CHANNEL_COUNT, &report)
            return 21 if opened != RuntimeServices::OpenStatus.AudioConfigurationInvalid
            return 22 if report.services.state != Capabilities::RequirementState.Fallback
            return 23 if report.services.fallback_count != 2
            return 24 if RuntimeServices::physics_active(session) or RuntimeServices::audio_active(session)
            return 25 if report.state != Capabilities::RequirementState.Fallback
            closed_profile: i32 = catch Application::backend_profile():
                value: 1
                Application::BackendProfileError.NotInitialized: 0
                error failure: 2
            return 26 if closed_profile != 0
            audio_closed: i32 = catch AudioRuntime::active_voice_count():
                value: 1
                AudioRuntime::AudioError.ApplicationUnavailable: 0
                error failure: 2
            return 27 if audio_closed != 0
            0

        def caller_defined_fallback_probe() -> i32:
            requirements: mutable BackendRequirements::BackendStartupRequirements = zeroed
            requirements.services[0] <- Capabilities::BackendFeature.Callbacks
            requirements.service_count <- 1
            requirements.service_fallbacks <- Capabilities::BackendFallbackProviders{
                input: Capabilities::BackendFallbackProvider.None,
                rendering: Capabilities::BackendFallbackProvider.None,
                physics: Capabilities::BackendFallbackProvider.None,
                audio: Capabilities::BackendFallbackProvider.None,
                native_window: Capabilities::BackendFallbackProvider.None,
                async_upload: Capabilities::BackendFallbackProvider.None,
                callbacks: Capabilities::BackendFallbackProvider.CallerDefined,
                asset_loading: Capabilities::BackendFallbackProvider.None,
            }
            requirements.allow_service_fallbacks <- true
            session: mutable RuntimeServices::Session = RuntimeServices::Session()
            report: mutable BackendRequirements::BackendRequirementsReport = zeroed
            opened: RuntimeServices::OpenStatus = RuntimeServices::open(&session,
                config(), &requirements, AudioRuntime::MIN_SAMPLE_RATE_HZ,
                AudioRuntime::MIN_CHANNEL_COUNT, &report)
            return 28 if opened != RuntimeServices::OpenStatus.FallbackRequired
            return 29 if report.services.state != Capabilities::RequirementState.Fallback
            return 30 if report.services.decisions[0].resolution != Capabilities::BackendFeatureResolution.DeclaredFallback
            return 31 if report.services.decisions[0].fallback_provider != Capabilities::BackendFallbackProvider.CallerDefined
            return 32 if RuntimeServices::physics_active(session) or RuntimeServices::audio_active(session)
            return 33 if not RuntimeServices::shutdown(&session)
            0

        def check_partial_world_frame(session: mutable RuntimeServices::Session&) -> i32:
            frame: RuntimeServices::SimulationFrame = catch RuntimeServices::advance_simulation(
                session, 10000):
                value: value
                error failure: return 58
            return 59 if frame.steps != 0 or frame.tick_count != 0
            return 60 if frame.interpolation <= 0.0
            0

        def run_world_schedule_frame(session: mutable RuntimeServices::Session&,
            elapsed_micros: i64, context: mutable TickContext&,
            plan: Executor::Plan&, plan_state: mutable Executor::FrameState&) -> RuntimeServices::SimulationFrame error[RuntimeServices::RuntimeServicesError, Runtime::ClockError, Executor::ExecError]:
            frame: RuntimeServices::SimulationFrame = try RuntimeServices::advance_simulation(
                session, elapsed_micros)
            for _ in 0..<frame.steps |session, plan, plan_state, context|:
                try Executor::plan_execute_with_contexts(
                    plan, plan_state, context, session, dispatch_physics_system)
            frame

        def dispatch_first_world_ticks(session: mutable RuntimeServices::Session&,
            context: mutable TickContext&, plan: Executor::Plan&,
            plan_state: mutable Executor::FrameState&) -> i32:
            frame: RuntimeServices::SimulationFrame = catch run_world_schedule_frame(
                session, 24000, context, plan, plan_state):
                value: value
                error failure: return 61
            return 62 if frame.steps != 2 or frame.tick_count != 2
            return 82 if context.failed or context.physics_steps != 2 or context.sync_passes != 2
            return 83 if plan_state.visits[Systems::PHYSICS] != 2 or plan_state.visits[Systems::WORLD_SYNC] != 2
            0

        def dispatch_remaining_world_tick(session: mutable RuntimeServices::Session&,
            context: mutable TickContext&, plan: Executor::Plan&,
            plan_state: mutable Executor::FrameState&) -> i32:
            frame: RuntimeServices::SimulationFrame = catch run_world_schedule_frame(
                session, Runtime::fixed_step_micros(), context, plan, plan_state):
                value: value
                error failure: return 76
            return 77 if frame.steps != 1 or frame.tick_count != 3
            return 85 if context.failed or context.physics_steps != 3 or context.sync_passes != 3
            0

        def check_first_world_trace(state: Executor::FrameState&) -> i32:
            return 84 if state.length != 4 or state.trace[0] != Systems::PHYSICS.i64() or state.trace[1] != Systems::WORLD_SYNC.i64() or state.trace[2] != Systems::PHYSICS.i64() or state.trace[3] != Systems::WORLD_SYNC.i64()
            0

        def check_second_world_trace(state: Executor::FrameState&) -> i32:
            return 86 if state.length != 6 or state.trace[4] != Systems::PHYSICS.i64() or state.trace[5] != Systems::WORLD_SYNC.i64()
            0

        def check_first_world_pose(context: mutable TickContext&,
            entity: World::EntityRef, initial_pose: Geometry::Transform) -> i32:
            synced_pose: mutable Geometry::Transform = Geometry::transform_identity()
            return 69 if not World::world_try_transform(context.world, entity, &synced_pose)
            return 70 if synced_pose.position.y >= initial_pose.position.y
            return 71 if synced_pose.scale.x != initial_pose.scale.x or synced_pose.scale.z != initial_pose.scale.z
            0

        def check_second_world_pose(context: mutable TickContext&,
            entity: World::EntityRef, initial_pose: Geometry::Transform) -> i32:
            synced_pose: mutable Geometry::Transform = Geometry::transform_identity()
            return 78 if not World::world_try_transform(context.world, entity, &synced_pose)
            return 79 if synced_pose.position.y >= initial_pose.position.y
            0

        def unbind_world_body(session: mutable RuntimeServices::Session&,
            context: mutable TickContext&, entity: World::EntityRef,
            expected_count: usize, failure_code: i32, count_code: i32) -> i32:
            status: i32 = catch WorldPhysics::unbind(session, &context.bodies, entity):
                ok: 0
                error failure: 1
            return failure_code if status != 0
            return count_code if WorldPhysics::binding_count(context.bodies) != expected_count
            0

        def hierarchy_physics_probe(session: mutable RuntimeServices::Session&) -> i32:
            world: mutable World::World = catch World::World():
                value: value
                error failure: return 98
            parent: World::EntityRef = catch World::world_spawn(&world, World::Actor.Player):
                value: value
                error failure: return 99
            bridge: World::EntityRef = catch World::world_spawn(&world, World::StaticObject.Structure):
                value: value
                error failure: return 100
            child: World::EntityRef = catch World::world_spawn(&world, World::Enemy.Guard):
                value: value
                error failure: return 101
            hierarchy: mutable WorldHierarchy::Hierarchy = WorldHierarchy::Hierarchy()
            parent_initial: Geometry::Transform = Geometry::Transform{
                position: Geometry::Vec3{x: -4.0, y: 8.0, z: 0.0},
                rotation: Geometry::quat_identity(),
                scale: Geometry::Vec3{x: 1.0, y: 1.0, z: 1.0},
            }
            bridge_local: Geometry::Transform = Geometry::Transform{
                position: Geometry::Vec3{x: 2.0, y: 1.0, z: 0.0},
                rotation: Geometry::quat_identity(),
                scale: Geometry::Vec3{x: 1.0, y: 1.0, z: 1.0},
            }
            child_local: Geometry::Transform = Geometry::Transform{
                position: Geometry::Vec3{x: 2.0, y: -1.0, z: 0.0},
                rotation: Geometry::quat_identity(),
                scale: Geometry::Vec3{x: 2.0, y: 1.0, z: 0.5},
            }
            return 102 if not WorldHierarchy::hierarchy_spawn(&hierarchy, parent.id, parent_initial)
            return 103 if not WorldHierarchy::hierarchy_spawn(&hierarchy, bridge.id, bridge_local)
            return 104 if not WorldHierarchy::hierarchy_spawn(&hierarchy, child.id, child_local)
            return 105 if not WorldHierarchy::hierarchy_set_parent(&hierarchy, bridge.id, parent.id, false)
            return 106 if not WorldHierarchy::hierarchy_set_parent(&hierarchy, child.id, bridge.id, false)
            WorldHierarchy::hierarchy_update(&hierarchy)
            parent_world: Geometry::Transform = WorldHierarchy::hierarchy_world(&hierarchy, parent.id)
            child_world: Geometry::Transform = WorldHierarchy::hierarchy_world(&hierarchy, child.id)
            bindings: mutable WorldPhysics::Bindings = WorldPhysics::Bindings()
            child_bind_status: i32 = catch WorldPhysics::bind_hierarchy(session,
                world, hierarchy, &bindings, child, PhysicsRuntime::BodyKind.Dynamic,
                Geometry::Vec3{x: 0.5, y: 0.5, z: 0.5}, 1.0):
                ok: 0
                error failure: 1
            return 87 if child_bind_status != 0
            parent_bind_status: i32 = catch WorldPhysics::bind_hierarchy(session,
                world, hierarchy, &bindings, parent, PhysicsRuntime::BodyKind.Dynamic,
                Geometry::Vec3{x: 0.5, y: 0.5, z: 0.5}, 1.0):
                ok: 0
                error failure: 1
            if parent_bind_status != 0:
                _ = catch WorldPhysics::unbind(session, &bindings, child):
                    ok: 0
                    error failure: 1
                return 88
            if WorldPhysics::binding_count(bindings) != 2:
                _ = catch WorldPhysics::unbind(session, &bindings, child):
                    ok: 0
                    error failure: 1
                _ = catch WorldPhysics::unbind(session, &bindings, parent):
                    ok: 0
                    error failure: 1
                return 114

            test_status: mutable i32 = 0
            advance_status: i32 = catch WorldPhysics::advance_and_sync_hierarchy(
                session, &hierarchy, bindings, Runtime::fixed_step_micros()):
                value: 0
                error failure: 1
            test_status <- 89 if advance_status != 0
            if test_status == 0:
                parent_before: mutable Geometry::Transform = Geometry::transform_identity()
                child_before: mutable Geometry::Transform = Geometry::transform_identity()
                bridge_before: mutable Geometry::Transform = Geometry::transform_identity()
                parent_fresh: bool = WorldHierarchy::hierarchy_try_world(
                    hierarchy, parent.id, &parent_before)
                child_fresh: bool = WorldHierarchy::hierarchy_try_world(
                    hierarchy, child.id, &child_before)
                bridge_fresh: bool = WorldHierarchy::hierarchy_try_world(
                    hierarchy, bridge.id, &bridge_before)
                test_status <- 91 if not parent_fresh or not bridge_fresh or not child_fresh
                test_status <- 92 if test_status == 0 and parent_before.position.y >= parent_world.position.y
                test_status <- 93 if test_status == 0 and child_before.position.y >= child_world.position.y
                test_status <- 94 if test_status == 0 and (parent_before.scale.x != parent_world.scale.x or child_before.scale.x != child_world.scale.x or child_before.scale.z != child_world.scale.z)
                if test_status == 0:
                    WorldHierarchy::hierarchy_update(&hierarchy)
                    parent_after: Geometry::Transform = WorldHierarchy::hierarchy_world(hierarchy, parent.id)
                    bridge_after: Geometry::Transform = WorldHierarchy::hierarchy_world(hierarchy, bridge.id)
                    child_after: Geometry::Transform = WorldHierarchy::hierarchy_world(hierarchy, child.id)
                    test_status <- 96 if ElisaMath::fabsf(parent_after.position.y - parent_before.position.y) > 0.001
                    test_status <- 97 if ElisaMath::fabsf(child_after.position.y - child_before.position.y) > 0.001
                    test_status <- 98 if ElisaMath::fabsf(child_after.position.x - child_before.position.x) > 0.001
                    test_status <- 115 if ElisaMath::fabsf(bridge_after.position.x - parent_after.position.x - bridge_local.position.x) > 0.001
                    test_status <- 116 if ElisaMath::fabsf(bridge_after.position.y - parent_after.position.y - bridge_local.position.y) > 0.001
                if test_status == 0:
                    second_advance_status: i32 = catch WorldPhysics::advance_and_sync_hierarchy(
                        session, &hierarchy, bindings, Runtime::fixed_step_micros()):
                        value: 0
                        error failure: 1
                    test_status <- 117 if second_advance_status != 0
                    if test_status == 0:
                        bridge_tick_two: mutable Geometry::Transform = Geometry::transform_identity()
                        child_tick_two: mutable Geometry::Transform = Geometry::transform_identity()
                        bridge_tick_two_fresh: bool = WorldHierarchy::hierarchy_try_world(
                            hierarchy, bridge.id, &bridge_tick_two)
                        child_tick_two_fresh: bool = WorldHierarchy::hierarchy_try_world(
                            hierarchy, child.id, &child_tick_two)
                        bridge_half: Geometry::Transform = WorldHierarchy::hierarchy_sample(
                            hierarchy, bridge.id, 0.5)
                        test_status <- 118 if not bridge_tick_two_fresh or not child_tick_two_fresh
                        expected_bridge_half_y: f32 = (bridge_before.position.y + bridge_tick_two.position.y) * 0.5
                        test_status <- 119 if test_status == 0 and ElisaMath::fabsf(bridge_half.position.y - expected_bridge_half_y) > 0.001
                        WorldHierarchy::hierarchy_update(&hierarchy)
                        child_after_two: Geometry::Transform = WorldHierarchy::hierarchy_world(hierarchy, child.id)
                        test_status <- 120 if test_status == 0 and ElisaMath::fabsf(child_after_two.position.y - child_tick_two.position.y) > 0.001
                    if test_status == 0:
                        test_status <- RuntimePhysicsQueriesProbe::run(session)

            child_cleanup: i32 = catch WorldPhysics::unbind(session, &bindings, child):
                ok: 0
                error failure: 1
            parent_cleanup: i32 = catch WorldPhysics::unbind(session, &bindings, parent):
                ok: 0
                error failure: 1
            test_status <- 108 if test_status == 0 and child_cleanup != 0
            test_status <- 109 if test_status == 0 and parent_cleanup != 0
            test_status <- 112 if test_status == 0 and WorldPhysics::binding_count(bindings) != 0
            test_status

        def first_world_schedule_batch(session: mutable RuntimeServices::Session&,
            context: mutable TickContext&, physics_entity: World::EntityRef,
            initial_pose: Geometry::Transform, plan: Executor::Plan&,
            plan_state: mutable Executor::FrameState&) -> i32:
            partial_status: i32 = check_partial_world_frame(session)
            return partial_status if partial_status != 0
            tick_status: i32 = dispatch_first_world_ticks(session, context, plan,
                plan_state)
            return tick_status if tick_status != 0
            trace_status: i32 = check_first_world_trace(plan_state)
            return trace_status if trace_status != 0
            pose_status: i32 = check_first_world_pose(context, physics_entity, initial_pose)
            return pose_status if pose_status != 0
            unbind_world_body(session, context, physics_entity, 1, 72, 72)

        def second_world_schedule_batch(session: mutable RuntimeServices::Session&,
            context: mutable TickContext&, second_entity: World::EntityRef,
            second_initial_pose: Geometry::Transform, plan: Executor::Plan&,
            plan_state: mutable Executor::FrameState&) -> i32:
            tick_status: i32 = dispatch_remaining_world_tick(session, context, plan,
                plan_state)
            return tick_status if tick_status != 0
            pose_status: i32 = check_second_world_pose(context, second_entity,
                second_initial_pose)
            return pose_status if pose_status != 0
            trace_status: i32 = check_second_world_trace(plan_state)
            return trace_status if trace_status != 0
            unbind_world_body(session, context, second_entity, 0, 80, 80)

        def execute_world_schedule(session: mutable RuntimeServices::Session&,
            context: mutable TickContext&, physics_entity: World::EntityRef,
            initial_pose: Geometry::Transform, second_entity: World::EntityRef,
            second_initial_pose: Geometry::Transform) -> i32:
            systems: Schedule::System[Schedule::MAX_SYSTEMS] = zeroed
            physics_access: Schedule::System = Schedule::with_write(
                Schedule::system_empty(Systems::PHYSICS.i64()), Schedule::Resource.Bodies)
            sync_access: Schedule::System = Schedule::with_write(Schedule::with_read(
                Schedule::system_empty(Systems::WORLD_SYNC.i64()), Schedule::Resource.Bodies),
                Schedule::Resource.Transforms)
            systems[Systems::PHYSICS] <- physics_access
            systems[Systems::WORLD_SYNC] <- sync_access
            plan: Executor::Plan = catch Executor::plan_auto(systems, 2):
                value: value
                error failure: return 81
            plan_state: mutable Executor::FrameState = Executor::FrameState()

            first_status: i32 = first_world_schedule_batch(session, context,
                physics_entity, initial_pose, plan, &plan_state)
            return first_status if first_status != 0
            second_status: i32 = second_world_schedule_batch(session, context,
                second_entity, second_initial_pose, plan, &plan_state)
            return second_status if second_status != 0
            0

        def world_scheduler_probe(session: mutable RuntimeServices::Session&) -> i32:
            physics_world: mutable World::World = catch World::World():
                value: value
                error failure: return 64
            physics_entity: World::EntityRef = catch World::world_spawn(&physics_world,
                World::Actor.Player):
                value: value
                error failure: return 65
            initial_pose: Geometry::Transform = Geometry::Transform{
                position: Geometry::Vec3{x: 0.0, y: 2.0, z: 0.0},
                rotation: Geometry::quat_identity(),
                scale: Geometry::Vec3{x: 2.0, y: 1.0, z: 0.5},
            }
            initial_pose_status: i32 = catch World::world_set_transform(&physics_world,
                physics_entity, initial_pose):
                ok: 0
                error failure: 1
            return 66 if initial_pose_status != 0
            second_entity: World::EntityRef = catch World::world_spawn(&physics_world,
                World::Enemy.Guard):
                value: value
                error failure: return 73
            second_initial_pose: Geometry::Transform = Geometry::transform_translate(
                Geometry::transform_identity(), Geometry::Vec3{x: 2.0, y: 4.0, z: 0.0})
            second_pose_status: i32 = catch World::world_set_transform(&physics_world,
                second_entity, second_initial_pose):
                ok: 0
                error failure: 1
            return 74 if second_pose_status != 0
            bodies: mutable WorldPhysics::Bindings = WorldPhysics::Bindings()
            body_bind_status: i32 = catch WorldPhysics::bind(session, &physics_world,
                &bodies, physics_entity, PhysicsRuntime::BodyKind.Dynamic,
                Geometry::Vec3{x: 0.5, y: 0.5, z: 0.5}, 1.0):
                ok: 0
                error failure: 1
            return 67 if body_bind_status != 0 or WorldPhysics::binding_count(bodies) != 1
            second_bind_status: i32 = catch WorldPhysics::bind(session, &physics_world,
                &bodies, second_entity, PhysicsRuntime::BodyKind.Dynamic,
                Geometry::Vec3{x: 0.5, y: 0.5, z: 0.5}, 1.0):
                ok: 0
                error failure: 1
            return 75 if second_bind_status != 0 or WorldPhysics::binding_count(bodies) != 2
            duplicate_body_status: i32 = catch WorldPhysics::bind(session, &physics_world,
                &bodies, physics_entity, PhysicsRuntime::BodyKind.Dynamic,
                Geometry::Vec3{x: 0.5, y: 0.5, z: 0.5}, 1.0):
                ok: 0
                WorldPhysics::WorldPhysicsError.EntityAlreadyBound: 1
                error failure: 2
            return 68 if duplicate_body_status != 1

            context: mutable TickContext = TickContext(physics_world, bodies)
            schedule_status: i32 = execute_world_schedule(session, &context,
                physics_entity, initial_pose, second_entity, second_initial_pose)
            return schedule_status if schedule_status != 0
            0

    public:
        def run() -> i32:
            requirements: BackendRequirements::BackendStartupRequirements = startup_requirements()
            session: mutable RuntimeServices::Session = RuntimeServices::Session()
            rollback: i32 = activation_rollback(&session, &requirements)
            return rollback if rollback != 0
            caller_fallback: i32 = caller_defined_fallback_probe()
            return caller_fallback if caller_fallback != 0
            unavailable_device: i32 = RuntimeServicesAudioProbe::unavailable_default_device()
            return unavailable_device if unavailable_device != 0

            report: mutable BackendRequirements::BackendRequirementsReport = zeroed
            opened: RuntimeServices::OpenStatus = RuntimeServices::open(&session,
                config(), &requirements, AudioRuntime::MIN_SAMPLE_RATE_HZ,
                AudioRuntime::MIN_CHANNEL_COUNT, &report)
            return 31 if opened != RuntimeServices::OpenStatus.FallbackRequired
            return 32 if report.state != Capabilities::RequirementState.Fallback
            return 33 if report.services.fallback_count != 2
            return 34 if not RuntimeServices::physics_active(session) or not RuntimeServices::audio_active(session)
            return 118 if RuntimeServices::audio_provider(session) != Capabilities::BackendFallbackProvider.MiniaudioSilent
            occupied_report: mutable BackendRequirements::BackendRequirementsReport = zeroed
            occupied: RuntimeServices::OpenStatus = RuntimeServices::open(&session,
                config(), &requirements, AudioRuntime::MIN_SAMPLE_RATE_HZ,
                AudioRuntime::MIN_CHANNEL_COUNT, &occupied_report)
            return 49 if occupied != RuntimeServices::OpenStatus.SessionAlreadyOpen
            return 50 if not RuntimeServices::physics_active(session) or not RuntimeServices::audio_active(session)

            gain_status: i32 = catch RuntimeServices::audio_set_bus_gain(session,
                AudioRuntime::Bus.Effects, 0.75):
                ok: 0
                error failure: 1
            return 51 if gain_status != 0
            invalid_play: i32 = catch RuntimeServices::audio_play(session,
                AudioRuntime::empty_clip(), false, AudioRuntime::Bus.Effects, 1.0, 1):
                value: 0
                AudioRuntime::AudioError.InvalidHandle: 1
                error failure: 2
            return 52 if invalid_play != 1
            clip: AudioRuntime::ClipHandle = catch RuntimeServices::audio_decode_file(session,
                "test/fixtures/audio-smoke.wav"):
                value: value
                error failure: return 53
            voice: AudioRuntime::VoiceHandle = catch RuntimeServices::audio_play(session,
                clip, true, AudioRuntime::Bus.Effects, 1.0, 1):
                value: value
                error failure: return 54
            voices: usize = catch RuntimeServices::audio_active_voice_count(session):
                value: value
                error failure: return 35
            return 36 if voices != 1
            stopped_voice: i32 = catch RuntimeServices::audio_stop(session, voice):
                ok: 0
                error failure: 1
            return 55 if stopped_voice != 0
            quiet_voices: usize = catch RuntimeServices::audio_active_voice_count(session):
                value: value
                error failure: return 56
            return 57 if quiet_voices != 0

