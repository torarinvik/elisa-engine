# Native integration smoke: ordinary Elisa main builds and drives a Wicked
# scene through the public engine module. The one evidence import is test-only.
include "../src/runtime/application.elisa"
include "../src/runtime/render_scene.elisa"
include "../src/runtime/render_snapshot_scene.elisa"
include "../src/runtime/world_rendering.elisa"
include "../src/world/world.elisa"
include "../src/math/geometry.elisa"

@callconv(c)
extern elisa_render_scene_v1_last_frame_center_differs_from_corner() -> i32

@callconv(c)
extern elisa_render_scene_v1_last_frame_has_overlay_text() -> i32

@callconv(c)
extern elisa_render_scene_v1_last_frame_center_patch_hash() -> u64

@callconv(c)
extern elisa_render_scene_v1_test_arc_capacity() -> i32

@callconv(c)
extern elisa_render_scene_v1_test_snapshot_fail_after_creates(created_count: i32) -> i32

@callconv(c)
extern elisa_render_scene_v1_test_snapshot_identity_matches(gameplay_epoch: i64, gameplay_id: i64,
    render_id: i64, mesh_high: u64, mesh_low: u64, material_high: u64, material_low: u64) -> i32

@callconv(c)
extern elisa_render_scene_v1_test_object_count() -> u64

def sync_snapshot(presenter: mutable RenderScene::SnapshotPresenter&, snapshot: RenderSnapshot::Snapshot&) -> i32:
    catch RenderSnapshotScene::sync(presenter, snapshot):
        ok: 0
        error failure: 1

def set_world_pose(world: mutable World::World&, gameplay: World::EntityRef,
    transform: Geometry::Transform) -> i32:
    catch World::world_set_transform(world, gameplay, transform):
        ok: 0
        error failure: 1

def bind_world_render(bindings: mutable WorldRendering::Bindings&, world: World::World&,
    gameplay: World::EntityRef, render_id: i64, visual: Assets::VisualAsset) -> i32:
    catch WorldRendering::bind(bindings, world, gameplay, render_id, visual):
        ok: 0
        error failure: 1

def render_visual(asset_key: u64) -> Assets::VisualAsset:
    Assets::VisualAsset{
        mesh: Assets::AssetId{high: 700, low: asset_key},
        material: Assets::AssetId{high: 800, low: 1},
        local_bounds: Geometry::Bounds3{
            minimum: Geometry::Vec3{x: -1.0, y: -1.0, z: -1.0},
            maximum: Geometry::Vec3{x: 1.0, y: 1.0, z: 1.0},
        },
    }

def extract_world_render(world: World::World&, bindings: mutable WorldRendering::Bindings&,
    snapshot: mutable RenderSnapshot::Snapshot&) -> i32:
    catch WorldRendering::extract(world, bindings, snapshot):
        ok: 0
        error failure: 1

def hide_render_instance(handle: RenderScene::InstanceHandle) -> i32:
    catch RenderScene::set_visible(handle, false):
        ok: 0
        error failure: 1

def check_arc_batch_capacity(handle: RenderScene::ElectricArcHandle) -> i32:
    batch: mutable RenderScene::ElectricArcBatch = RenderScene::ElectricArcBatch()
    for index in 0..<RenderScene::MAX_ELECTRIC_ARCS:
        _ = catch RenderScene::electric_arc_batch_append(&batch, handle):
            ok: 0
            error failure: return 1
    return 1 if RenderScene::electric_arc_batch_count(batch) != RenderScene::MAX_ELECTRIC_ARCS
    overflow: i32 = catch RenderScene::electric_arc_batch_append(&batch, handle):
        ok: 0
        RenderScene::RenderSceneError.Capacity: 1
        error failure: 2
    return 0 if overflow == 1 and RenderScene::electric_arc_batch_count(batch) == RenderScene::MAX_ELECTRIC_ARCS
    2

def exercise_render_scene() -> i32:
    config: Application::Config = Application::Config{
        title: "Elisa Render Scene Smoke",
        width: 320,
        height: 200,
        hidden: true,
    }
    return 1 if Application::initialize(config) != Application::InitializeStatus.Ready

    bad_init: i32 = catch RenderScene::initialize(0, 200, 10.0):
        ok: 0
        RenderScene::RenderSceneError.InvalidValue: 1
        error failure: 2
    return 2 if bad_init != 1
    retry_init: i32 = catch RenderScene::initialize(320, 200, 10.0):
        ok: 0
        RenderScene::RenderSceneError.AlreadyInitialized: 1
        error failure: 2
    return 3 if retry_init != 0
    second_init: i32 = catch RenderScene::initialize(320, 200, 10.0):
        ok: 0
        RenderScene::RenderSceneError.AlreadyInitialized: 1
        error failure: 2
    return 4 if second_init != 1
    bad_camera_range: i32 = catch RenderScene::initialize(320, 200, 1.0e30):
        ok: 0
        RenderScene::RenderSceneError.InvalidValue: 1
        error failure: 2
    return 34 if bad_camera_range != 1

    degenerate_camera: i32 = catch RenderScene::set_camera_look_at(
        Geometry::Vec3{x: 0.0, y: 10.0, z: 0.0},
        Geometry::Vec3{x: 0.0, y: 0.0, z: 0.0},
        Geometry::Vec3{x: 0.0, y: 1.0, z: 0.0}):
        ok: 0
        RenderScene::RenderSceneError.InvalidValue: 1
        error failure: 2
    return 32 if degenerate_camera != 1
    bad_camera_magnitude: i32 = catch RenderScene::set_camera_look_at(
        Geometry::Vec3{x: 1.0e30, y: 10.0, z: 8.0},
        Geometry::Vec3{x: 0.0, y: 0.0, z: 0.0},
        Geometry::Vec3{x: 0.0, y: 1.0, z: 0.0}):
        ok: 0
        RenderScene::RenderSceneError.InvalidValue: 1
        error failure: 2
    return 37 if bad_camera_magnitude != 1
    valid_camera: i32 = catch RenderScene::set_camera_look_at(
        Geometry::Vec3{x: 0.0, y: 10.0, z: 8.0},
        Geometry::Vec3{x: 0.0, y: 0.0, z: 0.0},
        Geometry::Vec3{x: 0.0, y: 1.0, z: 0.0}):
        ok: 0
        error failure: 1
    return 33 if valid_camera != 0

    invalid_arc_width: i32 = catch RenderScene::create_electric_arc(0.0, 0.1, 7):
        value: 0
        RenderScene::RenderSceneError.InvalidValue: 1
        error failure: 2
    return 87 if invalid_arc_width != 1
    invalid_arc_amplitude: i32 = catch RenderScene::create_electric_arc(0.02, 1.0, 7):
        value: 0
        RenderScene::RenderSceneError.InvalidValue: 1
        error failure: 2
    return 88 if invalid_arc_amplitude != 1
    electric_arc: RenderScene::ElectricArcHandle = catch RenderScene::create_electric_arc(0.06, 0.15, 7):
        value: value
        error failure: return 89
    degenerate_arc: i32 = catch RenderScene::update_electric_arc(electric_arc,
        Geometry::Vec3{x: 0.0, y: 0.0, z: 0.0}, Geometry::Vec3{x: 0.0, y: 0.0, z: 0.0}, 0.1, 1.0):
        ok: 0
        RenderScene::RenderSceneError.InvalidValue: 1
        error failure: 2
    return 90 if degenerate_arc != 1
    arc_update: i32 = catch RenderScene::update_electric_arc(electric_arc,
        Geometry::Vec3{x: -2.0, y: 0.0, z: 0.0}, Geometry::Vec3{x: 2.0, y: 0.0, z: 0.0}, 0.1, 1.0):
        ok: 0
        error failure: 1
    return 91 if arc_update != 0
    return 92 if check_arc_batch_capacity(electric_arc) != 0
    arc_hidden: i32 = catch RenderScene::set_electric_arc_visible(electric_arc, false):
        ok: 0
        error failure: 1
    return 93 if arc_hidden != 0
    arc_shown: i32 = catch RenderScene::set_electric_arc_visible(electric_arc, true):
        ok: 0
        error failure: 1
    return 94 if arc_shown != 0

    hud_text: RenderScene::OverlayTextHandle = catch RenderScene::create_overlay_text(
        "LIVES  3", 16.0, 14.0, 24,
        RenderScene::Color{red: 0.92, green: 0.97, blue: 1.0, alpha: 1.0}):
        value: value
        error failure: return 76
    invalid_hud_text: i32 = catch RenderScene::create_overlay_text("bad", 0.0, 0.0, 4,
        RenderScene::Color{red: 1.0, green: 1.0, blue: 1.0, alpha: 1.0}):
        value: 0
        RenderScene::RenderSceneError.InvalidValue: 1
        error failure: 2
    return 77 if invalid_hud_text != 1
    text_update: i32 = catch RenderScene::set_overlay_text(hud_text, "LIVES  2"):
        ok: 0
        error failure: 2
    return 83 if text_update != 0
    text_hidden: i32 = catch RenderScene::set_overlay_text_visible(hud_text, false):
        ok: 0
        error failure: 2
    return 84 if text_hidden != 0
    text_shown: i32 = catch RenderScene::set_overlay_text_visible(hud_text, true):
        ok: 0
        error failure: 2
    return 85 if text_shown != 0
    text_number_update: i32 = catch RenderScene::set_overlay_text_i64(hud_text, "LIVES  ", 2):
        ok: 0
        error failure: 2
    return 86 if text_number_update != 0

    invalid_transform: Geometry::Transform = Geometry::Transform{
        position: Geometry::Vec3{x: 0.0, y: 0.0, z: 0.0},
        rotation: Geometry::quat_identity(),
        scale: Geometry::Vec3{x: 0.0, y: 1.0, z: 1.0},
    }
    invalid_create: i32 = catch RenderScene::create(RenderScene::Primitive.Box, invalid_transform,
        RenderScene::Color{red: 0.5, green: 0.5, blue: 0.5, alpha: 1.0}):
        value: 0
        RenderScene::RenderSceneError.InvalidValue: 1
        error failure: 2
    return 5 if invalid_create != 1 or RenderScene::instance_count() != 0

    huge_transform: Geometry::Transform = Geometry::Transform{
        position: Geometry::Vec3{x: 1.0e30, y: 0.0, z: 0.0},
        rotation: Geometry::quat_identity(),
        scale: Geometry::Vec3{x: 1.0, y: 1.0, z: 1.0},
    }
    huge_transform_create: i32 = catch RenderScene::create(RenderScene::Primitive.Box, huge_transform,
        RenderScene::Color{red: 0.5, green: 0.5, blue: 0.5, alpha: 1.0}):
        value: 0
        RenderScene::RenderSceneError.InvalidValue: 1
        error failure: 2
    return 35 if huge_transform_create != 1

    box_transform: Geometry::Transform = Geometry::Transform{
        position: Geometry::Vec3{x: -1.1, y: 0.0, z: 0.0},
        rotation: Geometry::quat_identity(),
        scale: Geometry::Vec3{x: 1.1, y: 0.8, z: 1.1},
    }
    box: RenderScene::InstanceHandle = catch RenderScene::create(RenderScene::Primitive.Box, box_transform,
        RenderScene::Color{red: 0.1, green: 0.45, blue: 1.0, alpha: 1.0}):
        value: value
        error failure: return 6

    sphere_transform: Geometry::Transform = Geometry::Transform{
        position: Geometry::Vec3{x: 1.1, y: 0.0, z: 0.0},
        rotation: Geometry::quat_identity(),
        scale: Geometry::Vec3{x: 0.85, y: 0.85, z: 0.85},
    }
    sphere: RenderScene::InstanceHandle = catch RenderScene::create(RenderScene::Primitive.Sphere, sphere_transform,
        RenderScene::Color{red: 0.1, green: 1.0, blue: 0.35, alpha: 1.0}):
        value: value
        error failure: return 7

    # A wide colored floor guarantees a known center pixel comes from scene
    # geometry, so the smoke checks rendered output rather than a registry.
    floor_transform: Geometry::Transform = Geometry::Transform{
        position: Geometry::Vec3{x: 0.0, y: -0.25, z: 0.0},
        rotation: Geometry::quat_identity(),
        scale: Geometry::Vec3{x: 6.0, y: 1.0, z: 6.0},
    }
    floor: RenderScene::InstanceHandle = catch RenderScene::create(RenderScene::Primitive.Plane, floor_transform,
        RenderScene::Color{red: 0.9, green: 0.05, blue: 0.3, alpha: 1.0}):
        value: value
        error failure: return 36
    return 8 if RenderScene::instance_count() != 3

    rotated: Geometry::Transform = Geometry::Transform{
        position: Geometry::Vec3{x: -0.8, y: 0.0, z: 0.2},
        rotation: Geometry::Quat{x: 0.0, y: 0.38268343, z: 0.0, w: 0.9238795},
        scale: Geometry::Vec3{x: 0.9, y: 0.9, z: 0.9},
    }
    rotated_status: i32 = catch RenderScene::update_transform(box, rotated):
        ok: 0
        error failure: 1
    return 9 if rotated_status != 0
    color_status: i32 = catch RenderScene::set_color(box,
        RenderScene::Color{red: 0.8, green: 0.2, blue: 0.5, alpha: 1.0}):
        ok: 0
        error failure: 1
    return 38 if color_status != 0
    emissive_status: i32 = catch RenderScene::set_emissive(sphere, RenderScene::Emission{
        color: Geometry::Vec3{x: 0.1, y: 0.9, z: 0.35}, strength: 4.0}):
        ok: 0
        error failure: 1
    return 58 if emissive_status != 0
    invalid_emission: i32 = catch RenderScene::set_emissive(sphere, RenderScene::Emission{
        color: Geometry::Vec3{x: 1.0, y: 0.0, z: 0.0}, strength: 65.0}):
        ok: 0
        RenderScene::RenderSceneError.InvalidValue: 1
        error failure: 2
    return 59 if invalid_emission != 1
    bloom_status: i32 = catch RenderScene::set_bloom(true, 0.8):
        ok: 0
        error failure: 1
    return 60 if bloom_status != 0
    invalid_bloom: i32 = catch RenderScene::set_bloom(true, 65.0):
        ok: 0
        RenderScene::RenderSceneError.InvalidValue: 1
        error failure: 2
    return 61 if invalid_bloom != 1
    bad_update: i32 = catch RenderScene::update_transform(box, invalid_transform):
        ok: 0
        RenderScene::RenderSceneError.InvalidValue: 1
        error failure: 2
    return 10 if bad_update != 1

    hidden: bool = catch RenderScene::set_visible(sphere, false):
        ok: true
        error failure: return 11
    return 12 if not hidden
    shown: bool = catch RenderScene::set_visible(sphere, true):
        ok: true
        error failure: return 13
    return 14 if not shown
    bad_color: i32 = catch RenderScene::set_color(box,
        RenderScene::Color{red: 1.0, green: 0.0, blue: 0.0, alpha: 2.0}):
        ok: 0
        RenderScene::RenderSceneError.InvalidValue: 1
        error failure: 2
    return 15 if bad_color != 1

    resized: i32 = catch RenderScene::resize(640, 400):
        ok: 0
        error failure: 1
    return 16 if resized != 0
    bad_resize: i32 = catch RenderScene::resize(0, 400):
        ok: 0
        RenderScene::RenderSceneError.InvalidValue: 1
        error failure: 2
    return 17 if bad_resize != 1

    return 18 if Application::pump() != Application::PumpStatus.Running
    rendered_geometry: mutable i32 = 0
    for attempt in 0..<8 |rendered_geometry|:
        break if rendered_geometry != 0
        return 19 if Application::pump() != Application::PumpStatus.Running
        rendered_geometry <- elisa_render_scene_v1_last_frame_center_differs_from_corner()
    return 20 if rendered_geometry == 0
    for attempt in 0..<4:
        return 78 if Application::pump() != Application::PumpStatus.Running
    return 79 if elisa_render_scene_v1_last_frame_has_overlay_text() == 0

    # Elisa gameplay identities and stable render IDs reconcile into persistent
    # native handles; repeated submissions update in place and removals retire.
    world: mutable World::World = catch World::World():
        value: value
        error failure: return 40
    gameplay_a: World::EntityRef = catch World::world_spawn(&world, World::Actor.Player):
        value: value
        error failure: return 40
    gameplay_b: World::EntityRef = catch World::world_spawn(&world, World::Enemy.Guard):
        value: value
        error failure: return 40
    snapshot: mutable RenderSnapshot::Snapshot = RenderSnapshot::Snapshot()
    presenter: mutable RenderScene::SnapshotPresenter = RenderScene::SnapshotPresenter()
    render_bindings: mutable WorldRendering::Bindings = WorldRendering::Bindings()
    return 41 if set_world_pose(world, gameplay_a, box_transform) != 0
    return 41 if bind_world_render(&render_bindings, world, gameplay_a, 701, render_visual(701)) != 0
    return 41 if bind_world_render(&render_bindings, world, gameplay_a, 703, render_visual(703)) != 0
    return 41 if set_world_pose(world, gameplay_b, sphere_transform) != 0
    return 41 if bind_world_render(&render_bindings, world, gameplay_b, 702, render_visual(702)) != 0
    return 42 if extract_world_render(world, &render_bindings, &snapshot) != 0
    return 43 if RenderSnapshot::snapshot_count(snapshot) != 3
    return 44 if sync_snapshot(&presenter, snapshot) != 0
    return 45 if RenderSnapshotScene::binding_count(presenter) != 3 or RenderScene::instance_count() != 6
    return 46 if extract_world_render(world, &render_bindings, &snapshot) != 0
    return 47 if sync_snapshot(&presenter, snapshot) != 0
    return 48 if RenderSnapshotScene::binding_count(presenter) != 3 or RenderScene::instance_count() != 6

    moved_transform: Geometry::Transform = Geometry::transform_translate(box_transform,
        Geometry::Vec3{x: 0.5, y: 0.0, z: 0.0})
    return 100 if set_world_pose(world, gameplay_a, moved_transform) != 0
    return 100 if bind_world_render(&render_bindings, world, gameplay_a, 701, render_visual(9701)) != 0
    return 101 if bind_world_render(&render_bindings, world, gameplay_a, 704, render_visual(704)) != 0
    return 102 if bind_world_render(&render_bindings, world, gameplay_a, 705, render_visual(705)) != 0
    return 103 if extract_world_render(world, &render_bindings, &snapshot) != 0 or RenderSnapshot::snapshot_count(snapshot) != 5
    return 104 if elisa_render_scene_v1_test_snapshot_fail_after_creates(1) != 0
    objects_before_failed_batch: u64 = elisa_render_scene_v1_test_object_count()
    failed_batch: i32 = sync_snapshot(&presenter, snapshot)
    return 105 if failed_batch != 1 or RenderSnapshotScene::binding_count(presenter) != 3 or RenderScene::instance_count() != 6 or elisa_render_scene_v1_test_object_count() != objects_before_failed_batch
    return 112 if elisa_render_scene_v1_test_snapshot_identity_matches(
        gameplay_a.world_epoch, gameplay_a.id, 701, 700, 701, 800, 1) == 0
    return 113 if elisa_render_scene_v1_test_snapshot_identity_matches(
        gameplay_a.world_epoch, gameplay_a.id, 701, 700, 9701, 800, 1) != 0
    return 106 if sync_snapshot(&presenter, snapshot) != 0
    return 107 if RenderSnapshotScene::binding_count(presenter) != 5 or RenderScene::instance_count() != 8
    return 114 if elisa_render_scene_v1_test_object_count() != objects_before_failed_batch + 2
    return 110 if elisa_render_scene_v1_test_snapshot_identity_matches(
        gameplay_a.world_epoch, gameplay_a.id, 701, 700, 9701, 800, 1) == 0
    stable_pose: Geometry::Transform = Geometry::transform_translate(moved_transform,
        Geometry::Vec3{x: 0.25, y: 0.0, z: 0.0})
    stable_pose_status: i32 = set_world_pose(world, gameplay_a, stable_pose)
    stable_update: i32 = bind_world_render(&render_bindings, world, gameplay_a, 701, render_visual(9701))
    return 108 if stable_pose_status != 0
    return 108 if stable_update != 0 or extract_world_render(world, &render_bindings, &snapshot) != 0 or sync_snapshot(&presenter, snapshot) != 0
    return 109 if RenderSnapshotScene::binding_count(presenter) != 5 or RenderScene::instance_count() != 8
    despawn_b: i32 = catch World::world_despawn(&world, gameplay_b):
        ok: 0
        error failure: 1
    return 51 if despawn_b != 0
    return 52 if extract_world_render(world, &render_bindings, &snapshot) != 0
    return 53 if sync_snapshot(&presenter, snapshot) != 0
    return 54 if RenderSnapshot::snapshot_count(snapshot) != 4 or RenderSnapshotScene::binding_count(presenter) != 4 or RenderScene::instance_count() != 7
    despawn_a: i32 = catch World::world_despawn(&world, gameplay_a):
        ok: 0
        error failure: 1
    return 55 if despawn_a != 0
    return 56 if extract_world_render(world, &render_bindings, &snapshot) != 0 or sync_snapshot(&presenter, snapshot) != 0
    return 57 if RenderSnapshotScene::binding_count(presenter) != 0 or RenderScene::instance_count() != 3
    return 111 if elisa_render_scene_v1_test_snapshot_identity_matches(
        gameplay_a.world_epoch, gameplay_a.id, 701, 700, 9701, 800, 1) != 0

    mesh_transform: Geometry::Transform = Geometry::Transform{
        position: Geometry::Vec3{x: -2.6666667, y: -0.6666667, z: 0.0},
        rotation: Geometry::quat_identity(),
        scale: Geometry::Vec3{x: 2.0, y: 2.0, z: 2.0},
    }
    rejected_traversal_mesh: i32 = catch RenderScene::create_mesh(
        "../build/cooked/render-scene-triangle.pkg", mesh_transform,
        RenderScene::Color{red: 1.0, green: 0.75, blue: 0.1, alpha: 1.0}):
        value: 0
        RenderScene::RenderSceneError.AssetLoadFailure: 1
        error failure: 2
    return 58 if rejected_traversal_mesh != 1 or RenderScene::instance_count() != 3
    rejected_absolute_mesh: i32 = catch RenderScene::create_mesh(
        "/etc/passwd", mesh_transform,
        RenderScene::Color{red: 1.0, green: 0.75, blue: 0.1, alpha: 1.0}):
        value: 0
        RenderScene::RenderSceneError.AssetLoadFailure: 1
        error failure: 2
    return 59 if rejected_absolute_mesh != 1 or RenderScene::instance_count() != 3
    rejected_escape_mesh: i32 = catch RenderScene::create_mesh(
        "build/cooked/render-scene-outside-link.pkg", mesh_transform,
        RenderScene::Color{red: 1.0, green: 0.75, blue: 0.1, alpha: 1.0}):
        value: 0
        RenderScene::RenderSceneError.AssetLoadFailure: 1
        error failure: 2
    return 60 if rejected_escape_mesh != 1 or RenderScene::instance_count() != 3
    cooked_mesh: RenderScene::InstanceHandle = catch RenderScene::create_mesh(
        "build/cooked/render-scene-triangle.pkg", mesh_transform,
        RenderScene::Color{red: 1.0, green: 0.75, blue: 0.1, alpha: 1.0}):
        value: value
        error failure: return 61
    return 62 if RenderScene::instance_count() != 4
    rejected_texture_traversal: i32 = catch RenderScene::set_texture(
        cooked_mesh, RenderScene::TextureSlot.BaseColor, "../backends/coordinate_reference.png"):
        ok: 0
        RenderScene::RenderSceneError.AssetLoadFailure: 1
        error failure: 2
    return 70 if rejected_texture_traversal != 1
    rejected_absolute_texture: i32 = catch RenderScene::set_texture(
        cooked_mesh, RenderScene::TextureSlot.BaseColor, "/etc/passwd"):
        ok: 0
        RenderScene::RenderSceneError.AssetLoadFailure: 1
        error failure: 2
    return 71 if rejected_absolute_texture != 1
    rejected_escape_texture: i32 = catch RenderScene::set_texture(
        cooked_mesh, RenderScene::TextureSlot.BaseColor,
        "build/cooked/render-scene-outside-link.pkg"):
        ok: 0
        RenderScene::RenderSceneError.AssetLoadFailure: 1
        error failure: 2
    return 74 if rejected_escape_texture != 1
    loaded_texture: i32 = catch RenderScene::set_texture(
        cooked_mesh, RenderScene::TextureSlot.BaseColor, "backends/coordinate_reference.png"):
        ok: 0
        error failure: 1
    return 72 if loaded_texture != 0
    loaded_normal: i32 = catch RenderScene::set_texture(
        cooked_mesh, RenderScene::TextureSlot.Normal, "build/cooked/render-scene-normal.png"):
        ok: 0
        error failure: 1
    return 73 if loaded_normal != 0
    cooked_emissive: i32 = catch RenderScene::set_emissive(cooked_mesh,
        RenderScene::Emission{
            color: Geometry::Vec3{x: 1.0, y: 0.75, z: 0.1}, strength: 2.0}):
        ok: 0
        error failure: 1
    return 75 if cooked_emissive != 0
    hidden_box: i32 = hide_render_instance(box)
    hidden_sphere: i32 = hide_render_instance(sphere)
    hidden_floor: i32 = hide_render_instance(floor)
    return 63 if hidden_box != 0 or hidden_sphere != 0 or hidden_floor != 0
    return 65 if Application::pump() != Application::PumpStatus.Running
    rendered_cooked_mesh: mutable i32 = 0
    for attempt in 0..<8 |rendered_cooked_mesh|:
        break if rendered_cooked_mesh != 0
        return 66 if Application::pump() != Application::PumpStatus.Running
        rendered_cooked_mesh <- elisa_render_scene_v1_last_frame_center_differs_from_corner()
    return 67 if rendered_cooked_mesh == 0
    destroyed_cooked_mesh: i32 = catch RenderScene::destroy(cooked_mesh):
        ok: 0
        error failure: 1
    return 68 if destroyed_cooked_mesh != 0 or RenderScene::instance_count() != 3
    stale_cooked_mesh: i32 = catch RenderScene::destroy(cooked_mesh):
        ok: 0
        RenderScene::RenderSceneError.UnknownHandle: 1
        error failure: 2
    return 69 if stale_cooked_mesh != 1

    _ = catch RenderScene::set_electric_arc_visible(electric_arc, false):
        ok: 0
        error failure: return 95
    for attempt in 0..<3:
        return 96 if Application::pump() != Application::PumpStatus.Running
    hidden_arc_pixels: u64 = elisa_render_scene_v1_last_frame_center_patch_hash()
    _ = catch RenderScene::set_electric_arc_visible(electric_arc, true):
        ok: 0
        error failure: return 97
    for attempt in 0..<3:
        return 98 if Application::pump() != Application::PumpStatus.Running
    visible_arc_pixels: u64 = elisa_render_scene_v1_last_frame_center_patch_hash()
    return 99 if hidden_arc_pixels == 0 or visible_arc_pixels == hidden_arc_pixels
    destroyed_electric_arc: i32 = catch RenderScene::destroy_electric_arc(electric_arc):
        ok: 0
        error failure: 1
    return 100 if destroyed_electric_arc != 0
    stale_electric_arc: i32 = catch RenderScene::update_electric_arc(electric_arc,
        Geometry::Vec3{x: -2.0, y: 0.0, z: 0.0}, Geometry::Vec3{x: 2.0, y: 0.0, z: 0.0}, 0.2, 1.0):
        ok: 0
        RenderScene::RenderSceneError.UnknownHandle: 1
        error failure: 2
    return 101 if stale_electric_arc != 1
    return 102 if elisa_render_scene_v1_test_arc_capacity() != 1

    destroyed_hud_text: i32 = catch RenderScene::destroy_overlay_text(hud_text):
        ok: 0
        error failure: 1
    return 80 if destroyed_hud_text != 0
    stale_hud_text: i32 = catch RenderScene::set_overlay_text(hud_text, "STALE"):
        ok: 0
        RenderScene::RenderSceneError.UnknownHandle: 1
        error failure: 2
    return 81 if stale_hud_text != 1

    destroyed: i32 = catch RenderScene::destroy(sphere):
        ok: 0
        error failure: 1
    return 21 if destroyed != 0
    stale: i32 = catch RenderScene::destroy(sphere):
        ok: 0
        RenderScene::RenderSceneError.UnknownHandle: 1
        error failure: 2
    return 22 if stale != 1
    stale_update: i32 = catch RenderScene::update_transform(sphere, sphere_transform):
        ok: 0
        RenderScene::RenderSceneError.UnknownHandle: 1
        error failure: 2
    return 23 if stale_update != 1

    # Explicit release clears the scene and invalidates every instance.
    shutdown_result: i32 = catch RenderScene::shutdown():
        ok: 0
        error failure: 1
    return 24 if shutdown_result != 0
    return 25 if RenderScene::is_initialized() or RenderScene::instance_count() != 0

    # Reopen the scene, then let Application shutdown invoke the registered
    # cleanup hook. This catches leaked scenes or active paths on app teardown.
    replacement_init: i32 = catch RenderScene::initialize(320, 200, 10.0):
        ok: 0
        error failure: 1
    return 26 if replacement_init != 0
    stale_text_after_scene_replacement: i32 = catch RenderScene::set_overlay_text_visible(hud_text, true):
        ok: 0
        RenderScene::RenderSceneError.UnknownHandle: 1
        error failure: 2
    return 82 if stale_text_after_scene_replacement != 1
    stale_after_scene_replacement: i32 = catch RenderScene::set_visible(sphere, true):
        ok: 0
        RenderScene::RenderSceneError.UnknownHandle: 1
        error failure: 2
    return 39 if stale_after_scene_replacement != 1
    final_handle: RenderScene::InstanceHandle = catch RenderScene::create(RenderScene::Primitive.Plane,
        Geometry::transform_identity(), RenderScene::Color{red: 0.9, green: 0.75, blue: 0.1, alpha: 1.0}):
        value: value
        error failure: return 27
    return 28 if RenderScene::instance_count() != 1
    application_shutdown: bool = Application::shutdown()
    return 29 if not application_shutdown
    return 30 if RenderScene::is_initialized() or RenderScene::instance_count() != 0
    post_shutdown: i32 = catch RenderScene::set_visible(final_handle, false):
        ok: 0
        RenderScene::RenderSceneError.NotInitialized: 1
        error failure: 2
    return 31 if post_shutdown != 1
    0

def main() -> i32:
    result: i32 = exercise_render_scene()
    shutdown_ok: bool = Application::shutdown()
    return 103 if not shutdown_ok
    result
