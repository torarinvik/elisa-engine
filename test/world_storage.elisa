include "../src/world/storage.elisa"

def main() -> i32:
    catalog: mutable WorldStorage::Catalog = WorldStorage::Catalog()
    actor: i64 = WorldStorage::catalog_spawn_actor(&catalog, 100)
    projectile: i64 = WorldStorage::catalog_spawn_projectile(&catalog, 7)
    return 1 if actor <= 0 or projectile <= actor
    actor_record: WorldStorage::Actor = WorldStorage::catalog_actor(&catalog, actor)
    projectile_record: WorldStorage::Projectile = WorldStorage::catalog_projectile(&catalog, projectile)
    return 2 if actor_record.health != 100 or projectile_record.damage != 7
    return 3 if WorldStorage::catalog_actor_count(&catalog) != 1 or WorldStorage::catalog_projectile_count(&catalog) != 1
    return 4 if not WorldStorage::catalog_destroy_actor(&catalog, actor)
    return 5 if WorldStorage::catalog_actor_count(&catalog) != 0 or WorldStorage::catalog_projectile_count(&catalog) != 1
    return 6 if not WorldStorage::catalog_destroy_projectile(&catalog, projectile)
    return 7 if WorldStorage::catalog_projectile_count(&catalog) != 0
    dense_ids: mutable i64[WorldStorage::MAX_ROWS] = zeroed
    for index in 0..<WorldStorage::MAX_ROWS:
        dense_ids[index] <- WorldStorage::catalog_spawn_actor(&catalog, 1000)
        return 8 if dense_ids[index] <= 0
    return 9 if WorldStorage::catalog_actor_count(&catalog) != WorldStorage::MAX_ROWS
    return 10 if WorldStorage::catalog_spawn_actor(&catalog, 9999) != -1
    first_dense: i64 = dense_ids[0]
    middle_dense: i64 = dense_ids[WorldStorage::MAX_ROWS / 2]
    last_dense: i64 = dense_ids[WorldStorage::MAX_ROWS - 1]
    return 11 if not WorldStorage::catalog_destroy_actor(&catalog, middle_dense)
    return 12 if WorldStorage::catalog_actor_count(&catalog) != WorldStorage::MAX_ROWS - 1
    replacement: i64 = WorldStorage::catalog_spawn_actor(&catalog, 9999)
    return 13 if replacement <= last_dense
    return 14 if WorldStorage::catalog_actor_count(&catalog) != WorldStorage::MAX_ROWS
    return 15 if WorldStorage::catalog_actor(&catalog, first_dense).health != 1000
    return 16 if WorldStorage::catalog_actor(&catalog, last_dense).health != 1000

    dynamic: mutable WorldStorage::Catalog = WorldStorage::Catalog()
    return 17 if not WorldStorage::catalog_register_type(&dynamic, 1001, 3)
    return 18 if not WorldStorage::catalog_register_type(&dynamic, 1002, 2)
    return 19 if WorldStorage::catalog_registered_type_count(&dynamic) != 2
    first_dynamic: i64 = WorldStorage::catalog_spawn_registered(&dynamic, 1001, 4, 8)
    second_dynamic: i64 = WorldStorage::catalog_spawn_registered(&dynamic, 1001, 5, 10)
    projectile_dynamic: i64 = WorldStorage::catalog_spawn_registered(&dynamic, 1002, 7, 14)
    return 20 if first_dynamic <= 0 or second_dynamic <= first_dynamic or projectile_dynamic <= second_dynamic
    return 21 if WorldStorage::catalog_registered_count(&dynamic, 1001) != 2
    record: WorldStorage::DynamicRecord = WorldStorage::catalog_registered(&dynamic, second_dynamic)
    return 22 if not record.live or record.type_id != 1001 or record.first != 5 or record.second != 10
    return 23 if WorldStorage::catalog_spawn_registered(&dynamic, 1001, 6, 12) <= 0
    return 24 if WorldStorage::catalog_spawn_registered(&dynamic, 1001, 7, 14) != -1
    return 25 if not WorldStorage::catalog_destroy_registered(&dynamic, second_dynamic)
    replacement_dynamic: i64 = WorldStorage::catalog_spawn_registered(&dynamic, 1001, 9, 18)
    return 26 if replacement_dynamic <= projectile_dynamic
    return 27 if WorldStorage::catalog_registered_count(&dynamic, 1001) != 3
    return 28 if WorldStorage::catalog_registered(&dynamic, second_dynamic).live
    return 29 if not WorldStorage::catalog_destroy_registered(&dynamic, first_dynamic)
    return 30 if WorldStorage::catalog_dynamic_count(&dynamic) != 3
    return 31 if WorldStorage::catalog_register_type(&dynamic, 1001, 1)
    return 32 if WorldStorage::catalog_register_type(&dynamic, 0, 1)
    return 33 if WorldStorage::catalog_register_type(&dynamic, 1003, 0)
    return 34 if WorldStorage::catalog_type_capacity(&dynamic, 1003) != 0

    total: mutable WorldStorage::Catalog = WorldStorage::Catalog()
    for type_index in 0..<WorldStorage::MAX_REGISTERED_TYPES:
        return 35 if not WorldStorage::catalog_register_type(&total, 2000 + type_index.i64(), WorldStorage::MAX_ROWS)
    for row in 0..<WorldStorage::MAX_DYNAMIC_ROWS:
        type_id: i64 = 2000 + (row % WorldStorage::MAX_REGISTERED_TYPES).i64()
        return 36 if WorldStorage::catalog_spawn_registered(&total, type_id, row.i64(), row.i64() * 2) <= 0
    return 37 if WorldStorage::catalog_dynamic_count(&total) != WorldStorage::MAX_DYNAMIC_ROWS
    return 38 if WorldStorage::catalog_spawn_registered(&total, 2000, 1, 2) != -1
    0
