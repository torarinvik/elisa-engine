include "../src/runtime/render_scene_image.elisa"
include "./render_scene_panel_native.elisa"

@callconv(c)
extern elisa_render_scene_v1_last_frame_has_overlay_image() -> i32

# Draws the fixture atlas's blue probe swatch (cell 63) over the image probe
# point and checks every setter, bound and stale-handle path.
module RenderSceneImageNativeTests:
    private:
        const module Fixture:
            ATLAS: cstr = "test/fixtures/glyph_atlas.png"
            MISSING: cstr = "test/fixtures/missing_atlas.png"
            ESCAPING: cstr = "../glyph_atlas.png"
            X: f32 = 40.0
            Y: f32 = 130.0
            WIDTH: f32 = 40.0
            HEIGHT: f32 = 40.0
            SWATCH_U0: f32 = 0.875
            SWATCH_V0: f32 = 0.875
            FULL: f32 = 1.0
            INVALID_COORDINATE: f32 = 20000.0

        def position_status(image: RenderScene::OverlayImageHandle, x: f32, y: f32) -> i32:
            catch RenderScene::set_overlay_image_position(image, x, y):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                RenderScene::RenderSceneError.UnknownHandle: 2
                error failure: 4

        def size_status(image: RenderScene::OverlayImageHandle, width: f32, height: f32) -> i32:
            catch RenderScene::set_overlay_image_size(image, width, height):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                RenderScene::RenderSceneError.UnknownHandle: 2
                error failure: 4

        def uv_status(image: RenderScene::OverlayImageHandle, u0: f32, v0: f32,
            u1: f32, v1: f32) -> i32:
            catch RenderScene::set_overlay_image_uv(image,
                RenderScene::OverlayImageUv{u0: u0, v0: v0, u1: u1, v1: v1}):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                RenderScene::RenderSceneError.UnknownHandle: 2
                error failure: 4

        def color_status(image: RenderScene::OverlayImageHandle, alpha: f32) -> i32:
            catch RenderScene::set_overlay_image_color(image,
                RenderScene::Color{red: 1.0, green: 1.0, blue: 1.0, alpha: alpha}):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                RenderScene::RenderSceneError.UnknownHandle: 2
                error failure: 4

        def visible_status(image: RenderScene::OverlayImageHandle, visible: bool) -> i32:
            catch RenderScene::set_overlay_image_visible(image, visible):
                ok: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                RenderScene::RenderSceneError.UnknownHandle: 2
                error failure: 4

        def exercise_image(image: RenderScene::OverlayImageHandle) -> i32:
            return 1 if position_status(image, Fixture::X, Fixture::Y) != 0
            return 2 if size_status(image, Fixture::WIDTH, Fixture::HEIGHT) != 0
            return 3 if uv_status(image, Fixture::SWATCH_U0, Fixture::SWATCH_V0,
                Fixture::FULL, Fixture::FULL) != 0
            return 4 if color_status(image, Fixture::FULL) != 0
            return 5 if visible_status(image, false) != 0
            return 6 if visible_status(image, true) != 0
            return 7 if position_status(image, Fixture::INVALID_COORDINATE, Fixture::Y) != 1
            return 8 if size_status(image, 0.0, Fixture::HEIGHT) != 1
            return 9 if uv_status(image, 0.5, 0.0, 0.25, 1.0) != 1
            return 10 if uv_status(image, 0.0, 0.0, 1.5, 1.0) != 1
            return 11 if color_status(image, 1.5) != 1
            0

    public:
        # Runs the panel smoke on the caller's panel, then the image smoke;
        # codes from 21 upward are image failures.
        def exercise_overlays(panel: RenderScene::OverlayPanelHandle) -> i32:
            panel_status: i32 = RenderScenePanelNativeTests::exercise(panel)
            return panel_status if panel_status != 0
            missing: i32 = catch RenderScene::create_overlay_image(Fixture::MISSING,
                Fixture::X, Fixture::Y, Fixture::WIDTH, Fixture::HEIGHT):
                value: 0
                RenderScene::RenderSceneError.AssetLoadFailure: 3
                error failure: 4
            return 21 if missing != 3
            escaping: i32 = catch RenderScene::create_overlay_image(Fixture::ESCAPING,
                Fixture::X, Fixture::Y, Fixture::WIDTH, Fixture::HEIGHT):
                value: 0
                RenderScene::RenderSceneError.AssetLoadFailure: 3
                error failure: 4
            return 22 if escaping != 3
            invalid_rect: i32 = catch RenderScene::create_overlay_image(Fixture::ATLAS,
                Fixture::X, Fixture::Y, 0.0, Fixture::HEIGHT):
                value: 0
                RenderScene::RenderSceneError.InvalidValue: 1
                error failure: 4
            return 23 if invalid_rect != 1
            image: RenderScene::OverlayImageHandle = catch RenderScene::create_overlay_image(
                Fixture::ATLAS, Fixture::X, Fixture::Y, Fixture::WIDTH, Fixture::HEIGHT):
                value: value
                error failure: return 24
            image_status: i32 = exercise_image(image)
            return 30 + image_status if image_status != 0
            for attempt in 0..<3:
                return 25 if Application::pump() != Application::PumpStatus.Running
            return 26 if elisa_render_scene_v1_last_frame_has_overlay_image() == 0
            return 27 if visible_status(image, false) != 0
            for attempt in 0..<3:
                return 25 if Application::pump() != Application::PumpStatus.Running
            return 28 if elisa_render_scene_v1_last_frame_has_overlay_image() != 0
            destroyed: i32 = catch RenderScene::destroy_overlay_image(image):
                ok: 0
                error failure: 1
            return 29 if destroyed != 0
            return 30 if visible_status(image, true) != 2
            0
