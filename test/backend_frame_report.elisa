include "../src/backend/frame_report.elisa"

def frame(gpu: i64) -> FrameReport::Report:
    r0: FrameReport::Report = FrameReport::Report()
    r1: FrameReport::Report = FrameReport::record(r0, 1, 800, gpu, 40, 0, 1000)
    r2: FrameReport::Report = FrameReport::record(r1, 2, 1500, gpu, 90, 4096, 2000)
    FrameReport::record(r2, 3, 300, gpu, 5, 0, 500)

def main() -> i32:
    warm: FrameReport::Budget = FrameReport::Budget{cpu_us: 3000, gpu_us: 4000, draws: 200, upload_bytes: 8192, resource_bytes: 4000}
    cold: FrameReport::Budget = FrameReport::Budget{cpu_us: 9000, gpu_us: 9000, draws: 200, upload_bytes: 1000000, resource_bytes: 4000}
    a: FrameReport::Report = frame(1000)
    return 1 if a.passes != 3 or a.cpu_us != 2600 or a.gpu_us != 3000 or a.draws != 135
    return 2 if a.upload_bytes != 4096 or a.resource_bytes != 3500 or not a.gpu_known
    return 3 if a.slowest_pass != 2 or a.slowest_cpu_us != 1500
    return 4 if FrameReport::judge(&a, &warm) != FrameReport::Verdict.Within
    return 5 if not FrameReport::gpu_measured(&a)
    # Unavailable GPU timing is labelled and never counted as zero or a failure.
    u: FrameReport::Report = frame(FrameReport::Gpu::NONE)
    return 6 if u.gpu_known or u.gpu_us != 0 or FrameReport::gpu_measured(&u)
    return 7 if FrameReport::judge(&u, &warm) != FrameReport::Verdict.Within
    # One unavailable pass poisons the GPU total but keeps the others summed.
    m0: FrameReport::Report = FrameReport::record(FrameReport::Report(), 1, 100, 500, 1, 0, 0)
    m: FrameReport::Report = FrameReport::record(m0, 2, 100, FrameReport::Gpu::NONE, 1, 0, 0)
    return 8 if m.gpu_known or m.gpu_us != 500 or m.cpu_us != 200
    # Bad probes are refused without changing the report.
    bad: FrameReport::Report = FrameReport::record(a, 9, -5, 0, 0, 0, 0)
    return 9 if bad.passes != 3 or bad.cpu_us != a.cpu_us
    worse: FrameReport::Report = FrameReport::record(a, 9, 5, -2, 0, 0, 0)
    return 10 if worse.passes != 3
    # Each budget trips in order.
    slow: FrameReport::Report = FrameReport::record(a, 4, 500, 0, 0, 0, 0)
    return 11 if FrameReport::judge(&slow, &warm) != FrameReport::Verdict.OverCpu
    gpu: FrameReport::Report = FrameReport::record(FrameReport::Report(), 1, 10, 5000, 0, 0, 0)
    return 12 if FrameReport::judge(&gpu, &warm) != FrameReport::Verdict.OverGpu
    draws: FrameReport::Report = FrameReport::record(FrameReport::Report(), 1, 10, 10, 201, 0, 0)
    return 13 if FrameReport::judge(&draws, &warm) != FrameReport::Verdict.OverDraws
    up: FrameReport::Report = FrameReport::record(FrameReport::Report(), 1, 10, 10, 1, 9000, 0)
    return 14 if FrameReport::judge(&up, &warm) != FrameReport::Verdict.OverUploads
    res: FrameReport::Report = FrameReport::record(FrameReport::Report(), 1, 10, 10, 1, 0, 4001)
    return 15 if FrameReport::judge(&res, &warm) != FrameReport::Verdict.OverResources
    # Cold frame 0 tolerates a large upload; the same frame is rejected warm.
    return 16 if FrameReport::judge_frame(&up, 0, &cold, &warm) != FrameReport::Verdict.Within
    return 17 if FrameReport::judge_frame(&up, 1, &cold, &warm) != FrameReport::Verdict.OverUploads
    # An empty report is not a measured GPU frame.
    empty: FrameReport::Report = FrameReport::Report()
    return 18 if FrameReport::gpu_measured(&empty)
    return 0
