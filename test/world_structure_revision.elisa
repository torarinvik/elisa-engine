include "../src/world/commands.elisa"

module World::StructureRevisionTest:
    def force(world: mutable World::World&, revision: i64) -> void:
        world.structure_revision <- revision

def main() -> i32:
    world: mutable World::World = catch World::World():
        value: value
        error failure: return 1
    first: World::EntityRef = catch World::world_spawn(&world, World::Actor.Player):
        value: value
        error failure: return 2
    World::StructureRevisionTest::force(&world, World::MAX_STRUCTURE_REVISION - 1)
    before: i64 = World::world_structure_revision(&world)
    commands: mutable WorldCommands::WorldBuffer = WorldCommands::WorldBuffer()
    return 3 if not WorldCommands::world_spawn(&commands, World::StaticObject.Structure)
    return 4 if not WorldCommands::world_despawn(&commands, first)
    accepted: bool = WorldCommands::commit_world(&commands, &world)
    return 5 if accepted
    return 6 if World::world_live_count(&world) != 1 or not World::world_is_live(&world, first)
    return 7 if World::world_structure_revision(&world) != before
    return 8 if WorldCommands::world_command_count(&commands) != 2
    0
