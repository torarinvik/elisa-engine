include "../src/physics/ccd2d.elisa"

def bullet() -> Physics2dCircles::Circle:
    # 5 mm bullet at 400 m/s, starting 1 m left of a 1 mm wall.
    Physics2dCircles::Circle{x_um: 0, y_um: 1000000, vx: 400000000, vy: 0, radius_um: 5000, mass_g: 10}

def main() -> i32:
    wall: Physics2dCcd::Wall = Physics2dCcd::Wall{x_um: 1000000, thickness_um: 1000, y_min_um: 0, y_max_um: 2000000}
    walls: Physics2dCcd::Wall[4] = [wall, wall, wall, wall]
    # Without CCD a 16 ms step (6.4 m of travel) tunnels straight through.
    mutable naive: Physics2dCircles::Circle = bullet()
    Physics2dCircles::integrate(&naive, 0, 16)
    return 1 if naive.x_um < 1001000
    # With CCD it stops at the wall face and bounces back.
    mutable b: Physics2dCircles::Circle = bullet()
    return 2 if not Physics2dCcd::step(&b, walls, 1, 0, 16, 500)
    return 3 if b.x_um + b.radius_um > 1000000 or b.x_um + b.radius_um < 999000
    return 4 if b.vx != 0 - 200000000
    # Moving away it keeps clear of the wall for the next steps.
    for _ in 0..<10:
        return 5 if Physics2dCcd::step(&b, walls, 1, 0, 16, 500)
    return 6 if b.x_um >= 0
    # A projectile passing over the wall top is not stopped.
    mutable high: Physics2dCircles::Circle = bullet()
    high.y_um <- 2010000
    return 7 if Physics2dCcd::step(&high, walls, 1, 0, 16, 500) or high.x_um < 6000000
    # Approaching from the right hits the far face.
    mutable back: Physics2dCircles::Circle = bullet()
    back.x_um <- 3000000
    back.vx <- 0 - 400000000
    return 8 if not Physics2dCcd::step(&back, walls, 1, 0, 16, 1000) or back.x_um - back.radius_um < 1000000 or back.vx != 400000000
    # Nearest of several walls wins.
    near: Physics2dCcd::Wall = Physics2dCcd::Wall{x_um: 500000, thickness_um: 1000, y_min_um: 0, y_max_um: 2000000}
    two: Physics2dCcd::Wall[4] = [near, wall, wall, wall]
    mutable c: Physics2dCircles::Circle = bullet()
    return 9 if not Physics2dCcd::step(&c, two, 2, 0, 16, 0) or c.x_um + c.radius_um > 500000 or c.vx != 0
    # Reproducible: the same run twice gives identical state.
    mutable r1: Physics2dCircles::Circle = bullet()
    mutable r2: Physics2dCircles::Circle = bullet()
    for _ in 0..<50:
        Physics2dCcd::step(&r1, two, 2, 9810000, 16, 700)
        Physics2dCcd::step(&r2, two, 2, 9810000, 16, 700)
    return 10 if r1.x_um != r2.x_um or r1.y_um != r2.y_um or r1.vx != r2.vx
    # A body dropped fast onto a 1 mm platform lands on it instead of falling through.
    plat: Physics2dCcd::Platform = Physics2dCcd::Platform{y_um: 0, thickness_um: 1000, x_min_um: 0 - 1000000, x_max_um: 1000000}
    plats: Physics2dCcd::Platform[4] = [plat, plat, plat, plat]
    mutable drop: Physics2dCircles::Circle = Physics2dCircles::Circle{x_um: 0, y_um: 500000, vx: 0, vy: 0 - 300000000, radius_um: 5000, mass_g: 10}
    return 11 if not Physics2dCcd::step_all(&drop, walls, 0, plats, 1, 0, 16, 500)
    return 12 if drop.y_um - drop.radius_um != 1000 or drop.vy != 150000000
    # Off the platform's end it falls past.
    mutable miss: Physics2dCircles::Circle = drop
    miss.x_um <- 2000000
    miss.y_um <- 500000
    miss.vy <- 0 - 300000000
    return 13 if Physics2dCcd::step_all(&miss, walls, 0, plats, 1, 0, 16, 500) or miss.y_um > 0
    # Rising into a ceiling hits its underside.
    ceiling: Physics2dCcd::Platform = Physics2dCcd::Platform{y_um: 3000000, thickness_um: 1000, x_min_um: 0 - 1000000, x_max_um: 1000000}
    ceils: Physics2dCcd::Platform[4] = [ceiling, plat, plat, plat]
    mutable up: Physics2dCircles::Circle = Physics2dCircles::Circle{x_um: 0, y_um: 1000000, vx: 0, vy: 300000000, radius_um: 5000, mass_g: 10}
    return 14 if not Physics2dCcd::step_all(&up, walls, 0, ceils, 1, 0, 16, 1000) or up.y_um + up.radius_um != 3000000 or up.vy != 0 - 300000000
    # A wall nearer than a platform wins.
    mutable diag: Physics2dCircles::Circle = Physics2dCircles::Circle{x_um: 0, y_um: 800000, vx: 400000000, vy: 0 - 400000000, radius_um: 5000, mass_g: 10}
    return 15 if not Physics2dCcd::step_all(&diag, two, 1, plats, 1, 0, 16, 1000) or diag.vx >= 0 or diag.vy >= 0
    # Two 5 mm bullets closing at 600 m/s, 5 m apart: one 16 ms step would
    # carry them straight through each other; the pair sweep finds contact.
    left: Physics2dCircles::Circle = Physics2dCircles::Circle{x_um: 0, y_um: 0, vx: 300000000, vy: 0, radius_um: 5000, mass_g: 10}
    right: Physics2dCircles::Circle = Physics2dCircles::Circle{x_um: 5000000, y_um: 0, vx: 0 - 300000000, vy: 0, radius_um: 5000, mass_g: 10}
    ph: Physics2dCcd::Hit = Physics2dCcd::sweep_pair(&left, &right, 16)
    # Gap 4990 mm at 9600 mm per step: t = 519.79 permille.
    return 16 if not ph.hit or ph.t_permille != 519
    # Offset by more than the combined radius they miss.
    mutable wide: Physics2dCircles::Circle = right
    wide.y_um <- 11000
    return 17 if Physics2dCcd::sweep_pair(&left, &wide, 16).hit
    # Grazing inside the radius still hits, later than head-on.
    mutable graze: Physics2dCircles::Circle = right
    graze.y_um <- 8000
    gh: Physics2dCcd::Hit = Physics2dCcd::sweep_pair(&left, &graze, 16)
    return 18 if not gh.hit or gh.t_permille <= 519
    # Separating or too far for this step: no hit.
    mutable away: Physics2dCircles::Circle = right
    away.vx <- 300000000
    return 19 if Physics2dCcd::sweep_pair(&left, &away, 16).hit
    mutable far: Physics2dCircles::Circle = right
    far.x_um <- 20000000
    return 20 if Physics2dCcd::sweep_pair(&left, &far, 16).hit
    return 0
