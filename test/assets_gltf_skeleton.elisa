    [123, 34, 110, 111, 100, 101, 115, 34, 58, 91, 123, 34, 99, 104, 105, 108, 100, 114, 101, 110, 34, 58, 91, 52, 93, 125, 93, 125]

# {"nodes":[{"children":[1]},{"children":[0]}]}
def text_cycle() -> darray[u8]:
    [123, 34, 110, 111, 100, 101, 115, 34, 58, 91, 123, 34, 99, 104, 105, 108, 100, 114, 101, 110, 34, 58, 91, 49, 93, 125, 44, 123, 34, 99, 104, 105, 108, 100, 114, 101, 110, 34, 58, 91, 48, 93, 125, 93, 125]

