include "../src/assets/glb_container.elisa"
include "../src/assets/gltf_animation_map.elisa"
include "./assets_gltf_channel_fixture.elisa"

def json_code(text: darray[u8]) -> i32:
    catch GltfJson::parse(text, 0, text.count.i64()):
        ok: 0
        GltfJson::JsonError.Malformed: 1
        GltfJson::JsonError.TooDeep: 2
        GltfJson::JsonError.TooManyNodes: 3
        GltfJson::JsonError.Truncated: 4
        error failure: 9

def doc_of(bytes: darray[u8]&, offset: i64, length: i64) -> GltfJson::Doc:
    catch GltfJson::parse(bytes, offset, length):
        value: value
        error failure: GltfJson::Doc{kind: [], start: [], stop: [], parent: [], key_start: [], key_stop: [], integer: []}

def layout_of(bytes: darray[u8]&) -> GlbContainer::Layout:
    catch GlbContainer::parse(bytes):
        value: value
        error failure: GlbContainer::Layout{total: 0, json_start: 0, json_length: 0, bin_start: -1, bin_length: -1}

def channel_of(doc: GltfJson::Doc&, bytes: darray[u8]&, animation: i64, channel: i64) -> GltfAnimationMap::ChannelBytes:
    catch GltfAnimationMap::channel_bytes(doc, bytes, animation, channel):
        value: value
        error failure: GltfAnimationMap::ChannelBytes{target_node: -9, path: -9, bin_offset: -9, byte_length: -9, count: -9, component_type: -9, components: -9}

def map_code(doc: GltfJson::Doc&, bytes: darray[u8]&, animation: i64, channel: i64) -> i32:
    catch GltfAnimationMap::channel_bytes(doc, bytes, animation, channel):
        ok: 0
        GltfAnimationMap::MapError.MissingAnimation: 1
        GltfAnimationMap::MapError.MissingChannel: 2
        error failure: 9

def patch_code(bytes: mutable darray[u8]&, layout: GlbContainer::Layout&, offset: i64, data: darray[u8]&) -> i64:
    catch GlbContainer::patch_bin(bytes, layout, offset, data):
        value: value
        error failure: -1

def checks() -> i32:
    glb: darray[u8] = fixture_glb()
    layout: GlbContainer::Layout = layout_of(glb)
    return 1 if not GlbContainer::has_bin(layout)
    doc: GltfJson::Doc = doc_of(glb, layout.json_start, layout.json_length)
    return 2 if GltfJson::node_count(doc) < 10
    expected: darray[i64] = fixture_channels()
    for c in 0..<fixture_channel_count().usize() |expected, doc, glb|:
        got: GltfAnimationMap::ChannelBytes = channel_of(doc, glb, 0, c.i64())
        base: usize = c * 6
        bad: bool = got.target_node != expected[base] or got.path != expected[base + 1] or got.bin_offset != expected[base + 2] or got.byte_length != expected[base + 3] or got.count != expected[base + 4] or got.components != expected[base + 5]
        return 10 + c.i32() if bad
    return 3 if map_code(doc, glb, 1, 0) != 1 or map_code(doc, glb, 0, fixture_channel_count()) != 2

    # Editing one channel rewrites exactly its bytes.
    edited: mutable darray[u8] = fixture_glb()
    first: GltfAnimationMap::ChannelBytes = channel_of(doc, glb, 0, 0)
    keys: mutable darray[u8] = []
    for i in 0..<first.byte_length.usize() |keys|:
        keys.push(171)
    return 4 if patch_code(&edited, layout, first.bin_offset, keys) != first.byte_length
    changed: mutable i64 = 0
    outside: mutable i64 = 0
    lo: i64 = layout.bin_start + first.bin_offset
    hi: i64 = lo + first.byte_length
    for i in 0..<glb.count |changed, outside, edited, glb, lo, hi|:
        x: u8 = edited[i]
        y: u8 = glb[i]
        differs: bool = x != y
        changed <- changed + 1 if differs else changed
        outside <- outside + 1 if differs and (i.i64() < lo or i.i64() >= hi) else outside
    return 5 if outside != 0 or changed == 0
    # The edited file still parses to the same channel map.
    again: GltfJson::Doc = doc_of(edited, layout.json_start, layout.json_length)
    second: GltfAnimationMap::ChannelBytes = channel_of(again, edited, 0, 1)
    return 6 if second.bin_offset != expected[8] or second.byte_length != expected[9]

    # JSON syntax cases.
    return 100 if json_code([123, 34, 97, 34, 58, 91, 49, 44, 50, 44, 123, 34, 98, 34, 58, 116, 114, 117, 101, 125, 93, 44, 34, 99, 34, 58, 110, 117, 108, 108, 44, 34, 100, 34, 58, 34, 120, 92, 34, 121, 34, 44, 34, 101, 34, 58, 45, 49, 46, 53, 101, 51, 125]) != 0
    return 101 if json_code([123, 34, 97, 34, 58, 49, 44, 125]) != 1
    return 102 if json_code([123, 34, 97, 34, 32, 49, 125]) != 1
    return 103 if json_code([91, 49, 32, 50, 93]) != 1
    return 104 if json_code([123, 34, 97, 34, 58, 116, 114, 117, 125]) != 1
    return 105 if json_code([123, 34, 97, 34, 58, 49, 125, 125]) != 1
    return 106 if json_code([123, 34, 97, 34, 58, 49, 125, 32, 53]) != 1
    return 107 if json_code([123, 34, 97, 34, 58, 91, 49, 44, 50]) != 4
    return 108 if json_code([34, 97, 98, 99]) != 4
    return 109 if json_code([91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93]) != 2
    return 110 if json_code([91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93]) != 0
    return 111 if json_code([52, 50, 57, 52, 57, 54, 55, 50, 57, 54]) != 0
    return 112 if json_code([123, 34, 97, 34, 58, 34, 1, 34, 125]) != 1
    0

def main() -> i32:
    status: i32 = checks()
    return status if status != 0
    0
